# vyakarana test suite
# Stdlib auto-included via cyrius.cyml. `assert` is test-scope only
# (`[test] stdlib`, 2.5.1): `cyrius test` prepends it, but editors and
# `cyrius-lsp` resolve this file with the build-scope list, so it is
# also included here — include-once makes the two a single copy.
# tests/bcyr/vyakarana.bcyr does the same for lib/bench.cyr.
#
# M0 (palette + record): token kinds exist and are sequential;
# kind_name round-trips; kind_is_valid bounds hold.
#
# M1 (shell grammar): shell dispatch is wired; tokenize_shell
# produces known tokens at known offsets for small inputs and
# holds the coverage invariant.

include "lib/assert.cyr"
include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"
include "src/theme.cyr"
include "src/lsp.cyr"
include "src/detect.cyr"
include "src/version_str.cyr"

# Coverage-invariant helper: sum of every token's len equals src_len.
# Used across M1 assertions to catch gap/overlap bugs early.
fn tb_coverage_sum(tb) {
    var n = tokenbuf_count(tb);
    var i = 0;
    var sum: i64 = 0;
    while (i < n) {
        sum = sum + tokenbuf_len(tb, i);
        i = i + 1;
    }
    return sum;
}

# Error-hole helper: count TK_ERROR tokens in a tokenbuf.
#
# The 2.3.2 sweep below asserts this is 0 for genuine source in
# every grammar that audit touched. TK_ERROR on valid syntax is
# the bug class it closed; TK_ERROR on a byte with no syntax in
# the language is correct, and the negative probes lock that in.
fn tb_error_count(tb) {
    var n = tokenbuf_count(tb);
    var i = 0;
    var e: i64 = 0;
    while (i < n) {
        if (tokenbuf_kind(tb, i) == TK_ERROR) { e = e + 1; }
        i = i + 1;
    }
    return e;
}

# Test helper: tokenize a small source string with the streaming
# API and return the populated tokenbuf. 2.0+ replaces the 1.x
# `_t_tokenize(src, lang)` synchronous entry; this wrapper
# keeps the test bodies readable while exercising the new API.
# Returns 0 if the grammar isn't loaded (same shape the old
# tokenize_source used for unknown languages).
fn _t_tokenize(src, lang) {
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    var tb = tokenbuf_new();
    tokenize_stream_feed(s, src, strlen(src));
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return tb;
}

# Content-detect a C string, mapping "no match" (0) to "(none)" so
# `assert_streq` reports a regression as a named failure instead of
# dereferencing 0 and killing the whole suite with SIGSEGV.
fn _t_detect(src) {
    var r = detect_language_from_content(src, strlen(src));
    if (r == 0) { return "(none)"; }
    return r;
}

# Kind of the token that starts at byte `off` in `tb`, or -1 if no
# token starts there (2.6.0).
fn _t_kind_at(tb, off) {
    var i = 0;
    while (i < tokenbuf_count(tb)) {
        if (tokenbuf_start(tb, i) == off) { return tokenbuf_kind(tb, i); }
        i = i + 1;
    }
    return (0 - 1);
}

# Length of the token that starts at byte `off` in `tb`, or -1 (2.7.0).
fn _t_len_at(tb, off) {
    var i = 0;
    while (i < tokenbuf_count(tb)) {
        if (tokenbuf_start(tb, i) == off) { return tokenbuf_len(tb, i); }
        i = i + 1;
    }
    return (0 - 1);
}

# 1 if two tokenbufs are identical (kind, start, len for every token).
fn _t_same_tokens(a, b) {
    if (tokenbuf_count(a) != tokenbuf_count(b)) { return 0; }
    var i = 0;
    while (i < tokenbuf_count(a)) {
        if (tokenbuf_kind(a, i) != tokenbuf_kind(b, i)) { return 0; }
        if (tokenbuf_start(a, i) != tokenbuf_start(b, i)) { return 0; }
        if (tokenbuf_len(a, i) != tokenbuf_len(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Path-detect, mapping 0 to "(none)" — same reason as `_t_detect`
# (2.6.2).
fn _t_path(path) {
    var r = detect_language(path);
    if (r == 0) { return "(none)"; }
    return r;
}

# `a` + `b` + `c` into `buf` (256 bytes, NUL-terminated); returns
# `buf` (2.6.2).
fn _t_cat3(buf, a, b, c) {
    var n = 0;
    var parts = vec_new();
    vec_push(parts, a); vec_push(parts, b); vec_push(parts, c);
    var pi = 0;
    while (pi < 3) {
        var p = vec_get(parts, pi);
        var pl = strlen(p);
        if (n + pl < 255) { memcpy(buf + n, p, pl); n = n + pl; }
        pi = pi + 1;
    }
    store8(buf + n, 0);
    return buf;
}

# 1 if detection result `got` is grammar `nm`; otherwise print what
# `what` routed to and return 0 (2.6.2).
fn _t_route_ok(what, got, nm) {
    if (got != 0) {
        if (streq(got, nm) == 1) { return 1; }
    }
    print("    misrouted: ", 15); print(what, strlen(what));
    print(" -> ", 4);
    if (got == 0) { print("(none)", 6); }
    if (got != 0) { print(got, strlen(got)); }
    print(", declared by ", 14); print(nm, strlen(nm)); print("\n", 1);
    return 0;
}

# ── Grammar-record comparison (2.9.0, ADR 0029) ──
# `_t_rec_eq(a, b, spec)` compares two records field by field. A spec
# is one byte per 8-byte field: `i` a scalar, `s` a cstr (or 0), `t` a
# 256-byte class table (or 0), `v` a Vec of cstrs, `-` runtime state
# that is not compared (the compose watermarks), and an upper-case
# letter a Vec of sub-records whose spec `_t_sub_spec` gives. The specs
# mirror the layout tables in src/grammar.cyr; the 2.9.0 test group
# holds each spec's length to its record's `*_SIZE`, so a field added
# without a spec entry fails there.
var _t_diff_off = 0;    # top-level offset of the last mismatch found

fn _t_grammar_spec() { return "svviittiiiiivvLPWiiiCFRHviiitvv"; }

fn _t_sub_spec(code) {
    if (code == 76) { return "isstt"; }   # L  LineRule
    if (code == 80) { return "issi"; }    # P  PairRule
    if (code == 87) { return "iv"; }      # W  WordsRule
    if (code == 67) { return "sss--"; }   # C  ComposeRule
    if (code == 70) { return "ss--s"; }   # F  ComposeFencedRule
    if (code == 82) { return "sss"; }     # R  ComposeRegionRule
    if (code == 72) { return "iss"; }     # H  HeredocRule
    return 0;
}

fn _t_cs_eq(a, b) {
    if ((a == 0) || (b == 0)) {
        if (a == b) { return 1; }
        return 0;
    }
    return streq(a, b);
}

fn _t_tbl_eq(a, b) {
    if ((a == 0) || (b == 0)) {
        if (a == b) { return 1; }
        return 0;
    }
    return memeq(a, b, 256);
}

# Vecs of cstrs (`code` 0) or of sub-records (`code` a spec letter).
fn _t_vec_eq(a, b, code) {
    if ((a == 0) || (b == 0)) {
        if (a == b) { return 1; }
        return 0;
    }
    if (vec_len(a) != vec_len(b)) { return 0; }
    var sub = 0;
    if (code != 0) { sub = _t_sub_spec(code); }
    var i = 0;
    while (i < vec_len(a)) {
        var same = 0;
        if (sub == 0) { same = _t_cs_eq(vec_get(a, i), vec_get(b, i)); }
        if (sub != 0) { same = _t_rec_eq(vec_get(a, i), vec_get(b, i), sub); }
        if (same == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _t_rec_eq(a, b, spec) {
    var n = strlen(spec);
    var i = 0;
    while (i < n) {
        var c = load8(spec + i);
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        var same = 1;
        if (c == 105) {                                  # i
            if (x != y) { same = 0; }
        }
        if (c == 115) { same = _t_cs_eq(x, y); }        # s
        if (c == 116) { same = _t_tbl_eq(x, y); }       # t
        if (c == 118) { same = _t_vec_eq(x, y, 0); }    # v
        if ((c >= 65) && (c <= 90)) { same = _t_vec_eq(x, y, c); }
        if (same == 0) {
            _t_diff_off = i * 8;
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

# `a` + `b` + `c` into a fresh buffer of exactly their length (2.9.0).
fn _t_cat3_alloc(a, b, c) {
    var la = strlen(a);
    var lb = strlen(b);
    var lc = strlen(c);
    var buf = alloc(la + lb + lc + 1);
    memcpy(buf, a, la);
    memcpy(buf + la, b, lb);
    memcpy(buf + la + lb, c, lc);
    store8(buf + la + lb + lc, 0);
    return buf;
}

# 1 if the grammar texts `x` and `y` both load and compare equal.
fn _t_gtext_eq(x, y) {
    var gx = _gp_parse(x, strlen(x));
    var gy = _gp_parse(y, strlen(y));
    if ((gx == 0) || (gy == 0)) { return 0 - 1; }
    return _t_rec_eq(gx, gy, _t_grammar_spec());
}

fn main() {
    alloc_init();

    test_group("token kinds exist and are sequential");
    assert_eq(TK_IDENT,        0, "TK_IDENT = 0");
    assert_eq(TK_KEYWORD,      1, "TK_KEYWORD = 1");
    assert_eq(TK_STRING,       2, "TK_STRING = 2");
    assert_eq(TK_NUMBER,       3, "TK_NUMBER = 3");
    assert_eq(TK_COMMENT,      4, "TK_COMMENT = 4");
    assert_eq(TK_OPERATOR,     5, "TK_OPERATOR = 5");
    assert_eq(TK_PUNCTUATION,  6, "TK_PUNCTUATION = 6");
    assert_eq(TK_WHITESPACE,   7, "TK_WHITESPACE = 7");
    assert_eq(TK_PREPROCESSOR, 8, "TK_PREPROCESSOR = 8");
    assert_eq(TK_ERROR,        9, "TK_ERROR = 9");
    assert_eq(TK_COUNT,       10, "TK_COUNT = 10");

    test_group("kind_name round-trips each kind");
    assert_eq(streq(kind_name(TK_IDENT),        "ident"),        1, "ident");
    assert_eq(streq(kind_name(TK_KEYWORD),      "keyword"),      1, "keyword");
    assert_eq(streq(kind_name(TK_STRING),       "string"),       1, "string");
    assert_eq(streq(kind_name(TK_NUMBER),       "number"),       1, "number");
    assert_eq(streq(kind_name(TK_COMMENT),      "comment"),      1, "comment");
    assert_eq(streq(kind_name(TK_OPERATOR),     "operator"),     1, "operator");
    assert_eq(streq(kind_name(TK_PUNCTUATION),  "punctuation"),  1, "punctuation");
    assert_eq(streq(kind_name(TK_WHITESPACE),   "whitespace"),   1, "whitespace");
    assert_eq(streq(kind_name(TK_PREPROCESSOR), "preprocessor"), 1, "preprocessor");
    assert_eq(streq(kind_name(TK_ERROR),        "error"),        1, "error");

    test_group("kind_is_valid bounds");
    assert_eq(kind_is_valid(0 - 1),       0, "negative is invalid");
    assert_eq(kind_is_valid(0),           1, "0 is valid");
    assert_eq(kind_is_valid(TK_COUNT - 1),1, "TK_COUNT-1 is valid");
    assert_eq(kind_is_valid(TK_COUNT),    0, "TK_COUNT is invalid");
    assert_eq(kind_is_valid(99),          0, "99 is invalid");

    test_group("M1 grammar registry");
    assert_eq(has_grammar("shell"),  1, "shell loaded in M1");
    assert_eq(has_grammar("nosuchlang"), 0, "fake-name grammar not loaded");
    assert_eq(has_grammar(""),    0, "empty name not loaded");

    test_group("tokenize_stream_new returns 0 for unknown languages");
    assert_eq(_t_tokenize("x", "nosuchlang"), 0, "fake-name returns 0");
    assert_eq(_t_tokenize("x", ""),           0, "empty name returns 0");

    test_group("M1 shell grammar — known-offset assertions");
    # Input: `if true; then echo hi; fi`
    # Expected tokens (in order):
    #   [kw:if @0,2] [ws @2,1] [id:true @3,4] [punc:; @7,1] [ws @8,1]
    #   [kw:then @9,4] [ws @13,1] [id:echo @14,4] [ws @18,1] [id:hi @19,2]
    #   [punc:; @21,1] [ws @22,1] [kw:fi @23,2]
    var tb1 = _t_tokenize("if true; then echo hi; fi", "shell");
    assert_neq(tb1, 0, "tokenbuf allocated");
    assert_eq(tokenbuf_count(tb1), 13, "13 tokens for the sample line");

    assert_eq(tokenbuf_kind(tb1, 0),  TK_KEYWORD,     "tok0 is keyword");
    assert_eq(tokenbuf_start(tb1, 0), 0,              "tok0 starts at 0");
    assert_eq(tokenbuf_len(tb1, 0),   2,              "tok0 len 2 (`if`)");

    assert_eq(tokenbuf_kind(tb1, 1),  TK_WHITESPACE,  "tok1 whitespace");
    assert_eq(tokenbuf_kind(tb1, 2),  TK_IDENT,       "tok2 ident (`true`)");
    assert_eq(tokenbuf_len(tb1, 2),   4,              "tok2 len 4");
    assert_eq(tokenbuf_kind(tb1, 3),  TK_PUNCTUATION, "tok3 `;`");
    assert_eq(tokenbuf_kind(tb1, 5),  TK_KEYWORD,     "tok5 `then`");
    assert_eq(tokenbuf_len(tb1, 5),   4,              "tok5 len 4");
    assert_eq(tokenbuf_kind(tb1, 12), TK_KEYWORD,     "tok12 `fi`");
    assert_eq(tokenbuf_len(tb1, 12),  2,              "tok12 len 2");

    # Coverage invariant on the same input.
    assert_eq(tb_coverage_sum(tb1), 25, "coverage sum == strlen");

    test_group("M1 shell grammar — shebang and comments");
    # `#!/bin/sh\n# comment\nx`
    var tb2 = _t_tokenize("#!/bin/sh\n# comment\nx", "shell");
    assert_neq(tb2, 0, "tokenbuf allocated");
    assert_eq(tokenbuf_kind(tb2, 0),  TK_PREPROCESSOR, "shebang is preprocessor");
    assert_eq(tokenbuf_start(tb2, 0), 0,               "shebang starts at 0");
    assert_eq(tokenbuf_len(tb2, 0),   9,               "shebang len 9 (stops at \\n)");
    assert_eq(tokenbuf_kind(tb2, 1),  TK_WHITESPACE,   "newline after shebang");
    assert_eq(tokenbuf_kind(tb2, 2),  TK_COMMENT,      "line 2 is comment");
    assert_eq(tokenbuf_len(tb2, 2),   9,               "comment len 9 (`# comment`)");
    assert_eq(tb_coverage_sum(tb2),   21,              "coverage holds");

    test_group("M1 shell grammar — strings (single and double)");
    var tb3 = _t_tokenize("x=\"a b\" y='c d'", "shell");
    assert_neq(tb3, 0, "tokenbuf allocated");
    # x =  "a b"  space  y  =  'c d'
    # 0 1  2..6  7      8  9  10..14
    assert_eq(tokenbuf_kind(tb3, 0),  TK_IDENT,   "x ident");
    assert_eq(tokenbuf_kind(tb3, 1),  TK_OPERATOR, "= operator");
    assert_eq(tokenbuf_kind(tb3, 2),  TK_STRING,  "\"a b\" string");
    assert_eq(tokenbuf_len(tb3, 2),   5,          "double-quoted string len 5");
    assert_eq(tokenbuf_kind(tb3, 6),  TK_STRING,  "'c d' string");
    assert_eq(tokenbuf_len(tb3, 6),   5,          "single-quoted string len 5");
    assert_eq(tb_coverage_sum(tb3),   15,         "coverage holds");

    test_group("M1 shell grammar — numbers (decimal, hex)");
    var tb4 = _t_tokenize("42 0xff 0b10 0o7", "shell");
    assert_neq(tb4, 0, "tokenbuf allocated");
    assert_eq(tokenbuf_kind(tb4, 0),  TK_NUMBER, "42 is number");
    assert_eq(tokenbuf_len(tb4, 0),   2,         "42 len 2");
    assert_eq(tokenbuf_kind(tb4, 2),  TK_NUMBER, "0xff is number");
    assert_eq(tokenbuf_len(tb4, 2),   4,         "0xff len 4");
    assert_eq(tokenbuf_kind(tb4, 4),  TK_NUMBER, "0b10 is number");
    assert_eq(tokenbuf_len(tb4, 4),   4,         "0b10 len 4");
    assert_eq(tokenbuf_kind(tb4, 6),  TK_NUMBER, "0o7 is number");
    assert_eq(tokenbuf_len(tb4, 6),   3,         "0o7 len 3");
    assert_eq(tb_coverage_sum(tb4),   16,        "coverage holds");

    test_group("M1 shell grammar — operators and [[ ]]");
    var tb5 = _t_tokenize("[[ a != b ]] && c || d", "shell");
    assert_neq(tb5, 0, "tokenbuf allocated");
    assert_eq(tokenbuf_kind(tb5, 0),  TK_PUNCTUATION, "[[ punctuation");
    assert_eq(tokenbuf_len(tb5, 0),   2,              "[[ len 2");
    # Find the != token (index 4: [[, ws, a, ws, !=)
    assert_eq(tokenbuf_kind(tb5, 4),  TK_OPERATOR,    "!= operator");
    assert_eq(tokenbuf_len(tb5, 4),   2,              "!= len 2");
    assert_eq(tb_coverage_sum(tb5),   22,             "coverage holds");

    test_group("M1 shell grammar — no error tokens on these inputs");
    # Every byte must land in a non-error kind for a passing grammar.
    # This would catch a regression where the recognizer priority
    # accidentally skips a common byte.
    var tb6 = _t_tokenize("if [[ $x -eq 42 ]]; then echo \"$x\"; fi", "shell");
    assert_neq(tb6, 0, "tokenbuf allocated");
    var n6 = tokenbuf_count(tb6);
    var i6 = 0;
    var errors6 = 0;
    while (i6 < n6) {
        if (tokenbuf_kind(tb6, i6) == TK_ERROR) { errors6 = errors6 + 1; }
        i6 = i6 + 1;
    }
    assert_eq(errors6, 0, "zero error tokens on common construct");
    assert_eq(tb_coverage_sum(tb6), 38, "coverage holds");

    test_group("tokenbuf internals");
    # Fresh tokenbuf is empty.
    var tb7 = tokenbuf_new();
    assert_eq(tokenbuf_count(tb7), 0, "new tokenbuf is empty");
    tokenbuf_push(tb7, TK_IDENT, 0, 3);
    tokenbuf_push(tb7, TK_WHITESPACE, 3, 1);
    assert_eq(tokenbuf_count(tb7), 2, "count after 2 pushes");
    assert_eq(tokenbuf_kind(tb7, 0),  TK_IDENT,      "slot 0 kind");
    assert_eq(tokenbuf_start(tb7, 0), 0,             "slot 0 start");
    assert_eq(tokenbuf_len(tb7, 0),   3,             "slot 0 len");
    assert_eq(tokenbuf_kind(tb7, 1),  TK_WHITESPACE, "slot 1 kind");
    assert_eq(tokenbuf_start(tb7, 1), 3,             "slot 1 start");

    test_group("M2 grammar loader — shell.cyml parses cleanly");
    var gshell = grammar_load("grammars/shell.cyml");
    assert_neq(gshell, 0, "grammar_load returned non-null");
    assert_eq(streq(grammar_name(gshell), "shell"), 1, "name is 'shell'");
    assert_eq(grammar_shebang_on(gshell),      1, "shebang default enabled");
    assert_eq(grammar_whitespace_on(gshell),   1, "whitespace default enabled");
    assert_eq(grammar_number_decimal(gshell),  1, "number_decimal enabled");
    assert_eq(grammar_number_0x(gshell),       1, "number_0x enabled");
    assert_eq(grammar_number_0b(gshell),       1, "number_0b enabled");
    assert_eq(grammar_number_0o(gshell),       1, "number_0o enabled");
    assert_eq(grammar_special_vars(gshell),    1, "special_vars enabled");

    var exts = grammar_extensions(gshell);
    assert_eq(vec_len(exts), 3, "3 extensions loaded");
    assert_eq(streq(vec_get(exts, 0), ".sh"),   1, "ext[0] == '.sh'");
    assert_eq(streq(vec_get(exts, 1), ".bash"), 1, "ext[1] == '.bash'");
    assert_eq(streq(vec_get(exts, 2), ".zsh"),  1, "ext[2] == '.zsh' (2.6.2)");

    var ops = grammar_operators(gshell);
    assert(vec_len(ops) > 0, "operators list non-empty");
    assert_eq(streq(vec_get(ops, 0), "<<<"), 1, "operators[0] == '<<<' (longest first)");

    var lrs = grammar_line_rules(gshell);
    var prs = grammar_pair_rules(gshell);
    var wrs = grammar_words_rules(gshell);
    assert_eq(vec_len(lrs), 1, "1 line rule (# comment)");
    assert_eq(vec_len(prs), 3, "3 pair rules (\", ' and `)");
    assert_eq(vec_len(wrs), 1, "1 words rule (keywords)");

    var kw = vec_get(wrs, 0);
    assert_eq(words_rule_kind(kw), TK_KEYWORD, "words rule kind is keyword");
    assert_eq(vec_len(words_rule_words(kw)), 19, "19 shell keywords");

    test_group("M2 char-class tables");
    var cc = char_class_new("A-Za-z_");
    assert_eq(char_class_match(cc, 65), 1, "A matches");   # A
    assert_eq(char_class_match(cc, 90), 1, "Z matches");   # Z
    assert_eq(char_class_match(cc, 97), 1, "a matches");   # a
    assert_eq(char_class_match(cc, 122), 1, "z matches");  # z
    assert_eq(char_class_match(cc, 95), 1, "_ matches");   # _
    assert_eq(char_class_match(cc, 48), 0, "0 does not match"); # 0
    assert_eq(char_class_match(cc, 32), 0, "space does not match");

    test_group("M2 data-driven scanner matches hand-coded on small inputs");
    # Same fixture strings as the M1 suite, now run through both
    # tokenizers; counts and first-few kinds must agree.
    var probe_inputs = vec_new();
    vec_push(probe_inputs, "if true; then echo hi; fi");
    vec_push(probe_inputs, "#!/bin/sh\n# comment\nx");
    vec_push(probe_inputs, "x=\"a b\" y='c d'");
    vec_push(probe_inputs, "42 0xff 0b10 0o7");
    vec_push(probe_inputs, "[[ a != b ]] && c || d");
    var pi = 0;
    while (pi < vec_len(probe_inputs)) {
        var inp = vec_get(probe_inputs, pi);
        var tb_hand = tokenbuf_new();
        tokenize_shell(inp, strlen(inp), tb_hand);
        var tb_data = tokenbuf_new();
        tokenize_with_grammar(gshell, inp, strlen(inp), tb_data);
        assert_eq(tokenbuf_count(tb_hand), tokenbuf_count(tb_data),
                  "handcoded/data-driven token count match");
        var tk_n = tokenbuf_count(tb_hand);
        var tk_i = 0;
        while (tk_i < tk_n) {
            assert_eq(tokenbuf_kind(tb_hand, tk_i),
                      tokenbuf_kind(tb_data, tk_i),
                      "kind match");
            assert_eq(tokenbuf_start(tb_hand, tk_i),
                      tokenbuf_start(tb_data, tk_i),
                      "start match");
            assert_eq(tokenbuf_len(tb_hand, tk_i),
                      tokenbuf_len(tb_data, tk_i),
                      "len match");
            tk_i = tk_i + 1;
        }
        pi = pi + 1;
    }

    test_group("M3 toml grammar — loads and tokenizes cleanly");
    var gtoml = grammar_load("grammars/toml.cyml");
    assert_neq(gtoml, 0, "grammar_load toml returned non-null");
    assert_eq(streq(grammar_name(gtoml), "toml"), 1, "name is 'toml'");
    assert_eq(grammar_shebang_on(gtoml),    0, "no shebang for TOML");
    assert_eq(grammar_whitespace_on(gtoml), 1, "whitespace default on");
    assert_eq(grammar_special_vars(gtoml),  0, "no shell special-vars");

    var toml_exts = grammar_extensions(gtoml);
    assert_eq(vec_len(toml_exts), 1, "1 TOML extension");
    assert_eq(streq(vec_get(toml_exts, 0), ".toml"), 1, "ext == '.toml'");

    # Dashed bare keys: `foo-bar = 1` must tokenize foo-bar as one
    # ident (not three tokens), and `1` as a number. This is the
    # ident_start / ident_cont asymmetry (`-` in cont only).
    var tb_tl1 = tokenbuf_new();
    var src_tl1 = "foo-bar = 1";
    tokenize_with_grammar(gtoml, src_tl1, strlen(src_tl1), tb_tl1);
    assert_eq(tokenbuf_count(tb_tl1), 5, "5 tokens: ident ws op ws num");
    assert_eq(tokenbuf_kind(tb_tl1, 0),  TK_IDENT,      "tok0 ident");
    assert_eq(tokenbuf_len(tb_tl1, 0),   7,             "foo-bar len 7");
    assert_eq(tokenbuf_kind(tb_tl1, 2),  TK_OPERATOR,   "tok2 = operator");
    assert_eq(tokenbuf_kind(tb_tl1, 4),  TK_NUMBER,     "tok4 number");

    # Negative number: `-42` is operator + number, not ident.
    var tb_tl2 = tokenbuf_new();
    var src_tl2 = "-42";
    tokenize_with_grammar(gtoml, src_tl2, strlen(src_tl2), tb_tl2);
    assert_eq(tokenbuf_count(tb_tl2), 2, "-42 is two tokens");
    assert_eq(tokenbuf_kind(tb_tl2, 0), TK_OPERATOR, "leading - operator");
    assert_eq(tokenbuf_kind(tb_tl2, 1), TK_NUMBER,   "42 number");

    # [[section]] punctuation.
    var tb_tl3 = tokenbuf_new();
    var src_tl3 = "[[a]]";
    tokenize_with_grammar(gtoml, src_tl3, strlen(src_tl3), tb_tl3);
    assert_eq(tokenbuf_count(tb_tl3), 3, "[[ ident ]] = 3 tokens");
    assert_eq(tokenbuf_kind(tb_tl3, 0), TK_PUNCTUATION, "[[ punct");
    assert_eq(tokenbuf_len(tb_tl3, 0),  2,              "[[ len 2");
    assert_eq(tokenbuf_kind(tb_tl3, 1), TK_IDENT,       "a ident");
    assert_eq(tokenbuf_kind(tb_tl3, 2), TK_PUNCTUATION, "]] punct");
    assert_eq(tokenbuf_len(tb_tl3, 2),  2,              "]] len 2");

    # TOML keywords.
    var tb_tl4 = tokenbuf_new();
    var src_tl4 = "x = true";
    tokenize_with_grammar(gtoml, src_tl4, strlen(src_tl4), tb_tl4);
    assert_eq(tokenbuf_kind(tb_tl4, 4), TK_KEYWORD, "true is keyword");
    assert_eq(tokenbuf_len(tb_tl4, 4),  4,          "true len 4");

    test_group("M3 json grammar — loads and tokenizes cleanly");
    var gjson = grammar_load("grammars/json.cyml");
    assert_neq(gjson, 0, "grammar_load json returned non-null");
    assert_eq(streq(grammar_name(gjson), "json"), 1, "name is 'json'");
    assert_eq(grammar_shebang_on(gjson), 0, "no shebang for JSON");

    # Structural punctuation: `{ "k": 1 }` → 7 tokens.
    var tb_j1 = tokenbuf_new();
    var src_j1 = "{\"k\":1}";
    tokenize_with_grammar(gjson, src_j1, strlen(src_j1), tb_j1);
    assert_eq(tokenbuf_count(tb_j1), 5, "{ \"k\" : 1 } with tight spacing = 5 tokens");
    assert_eq(tokenbuf_kind(tb_j1, 0), TK_PUNCTUATION, "{ punct");
    assert_eq(tokenbuf_kind(tb_j1, 1), TK_STRING,      "\"k\" string");
    assert_eq(tokenbuf_kind(tb_j1, 2), TK_PUNCTUATION, ": punct");
    assert_eq(tokenbuf_kind(tb_j1, 3), TK_NUMBER,      "1 number");
    assert_eq(tokenbuf_kind(tb_j1, 4), TK_PUNCTUATION, "} punct");

    # Keywords: true / false / null.
    var tb_j2 = tokenbuf_new();
    var src_j2 = "[true,false,null]";
    tokenize_with_grammar(gjson, src_j2, strlen(src_j2), tb_j2);
    assert_eq(tokenbuf_kind(tb_j2, 1), TK_KEYWORD, "true keyword");
    assert_eq(tokenbuf_kind(tb_j2, 3), TK_KEYWORD, "false keyword");
    assert_eq(tokenbuf_kind(tb_j2, 5), TK_KEYWORD, "null keyword");

    # Negative number: operator + number.
    var tb_j3 = tokenbuf_new();
    var src_j3 = "-42";
    tokenize_with_grammar(gjson, src_j3, strlen(src_j3), tb_j3);
    assert_eq(tokenbuf_count(tb_j3), 2, "-42 is two tokens");
    assert_eq(tokenbuf_kind(tb_j3, 0), TK_OPERATOR, "- operator");
    assert_eq(tokenbuf_kind(tb_j3, 1), TK_NUMBER,   "42 number");

    # Bare word (invalid JSON but we tokenize permissively): emit
    # as ident rather than error. The scanner has no JSON validator.
    var tb_j4 = tokenbuf_new();
    var src_j4 = "undefined";
    tokenize_with_grammar(gjson, src_j4, strlen(src_j4), tb_j4);
    assert_eq(tokenbuf_count(tb_j4), 1, "bare word is 1 token");
    assert_eq(tokenbuf_kind(tb_j4, 0), TK_IDENT, "bare undefined is ident, not error");

    test_group("M3 cyrius grammar — loads and tokenizes cleanly");
    var gcyr = grammar_load("grammars/cyrius.cyml");
    assert_neq(gcyr, 0, "grammar_load cyrius returned non-null");
    assert_eq(streq(grammar_name(gcyr), "cyrius"), 1, "name is 'cyrius'");

    # `fn` is a keyword; `foo` is an ident.
    var tb_c1 = tokenbuf_new();
    var src_c1 = "fn foo() { return 0; }";
    tokenize_with_grammar(gcyr, src_c1, strlen(src_c1), tb_c1);
    assert_eq(tokenbuf_kind(tb_c1, 0), TK_KEYWORD, "fn keyword");
    assert_eq(tokenbuf_len(tb_c1, 0),  2,          "fn len 2");
    assert_eq(tokenbuf_kind(tb_c1, 2), TK_IDENT,   "foo ident");
    # return is keyword
    var ri = 0;
    var rn = tokenbuf_count(tb_c1);
    var found_return = 0;
    while (ri < rn) {
        if (tokenbuf_kind(tb_c1, ri) == TK_KEYWORD) {
            var s = tokenbuf_start(tb_c1, ri);
            var l = tokenbuf_len(tb_c1, ri);
            if (l == 6) {
                if (memeq(src_c1 + s, "return", 6) == 1) { found_return = 1; }
            }
        }
        ri = ri + 1;
    }
    assert_eq(found_return, 1, "return is a keyword");

    # Hex literal.
    var tb_c2 = tokenbuf_new();
    var src_c2 = "0xFF";
    tokenize_with_grammar(gcyr, src_c2, strlen(src_c2), tb_c2);
    assert_eq(tokenbuf_count(tb_c2), 1,         "0xFF is one token");
    assert_eq(tokenbuf_kind(tb_c2, 0), TK_NUMBER, "0xFF number");
    assert_eq(tokenbuf_len(tb_c2, 0),  4,         "0xFF len 4");

    # `#` starts a comment to EOL (no shebang in Cyrius).
    var tb_c3 = tokenbuf_new();
    var src_c3 = "# hello\nfn x";
    tokenize_with_grammar(gcyr, src_c3, strlen(src_c3), tb_c3);
    assert_eq(tokenbuf_kind(tb_c3, 0), TK_COMMENT, "# comment (not preprocessor)");
    assert_eq(tokenbuf_len(tb_c3, 0),  7,          "# hello len 7");

    test_group("M3 rust grammar — loads and tokenizes cleanly");
    var grust = grammar_load("grammars/rust.cyml");
    assert_neq(grust, 0, "grammar_load rust returned non-null");
    assert_eq(streq(grammar_name(grust), "rust"), 1, "name is 'rust'");

    # `//` line comments, not `#`.
    var tb_r1 = tokenbuf_new();
    var src_r1 = "// hi\nfn f";
    tokenize_with_grammar(grust, src_r1, strlen(src_r1), tb_r1);
    assert_eq(tokenbuf_kind(tb_r1, 0), TK_COMMENT, "// is comment");
    assert_eq(tokenbuf_len(tb_r1, 0),  5,          "// hi len 5");

    # `=>` and `->` multi-char operators.
    var tb_r2 = tokenbuf_new();
    var src_r2 = "a => b -> c";
    tokenize_with_grammar(grust, src_r2, strlen(src_r2), tb_r2);
    assert_eq(tokenbuf_kind(tb_r2, 2), TK_OPERATOR, "=> op");
    assert_eq(tokenbuf_len(tb_r2, 2),  2,           "=> len 2");
    assert_eq(tokenbuf_kind(tb_r2, 6), TK_OPERATOR, "-> op");
    assert_eq(tokenbuf_len(tb_r2, 6),  2,           "-> len 2");

    # `::` path separator, distinct from `:` punctuation.
    var tb_r3 = tokenbuf_new();
    var src_r3 = "std::fmt";
    tokenize_with_grammar(grust, src_r3, strlen(src_r3), tb_r3);
    assert_eq(tokenbuf_count(tb_r3), 3, "3 tokens: ident :: ident");
    assert_eq(tokenbuf_kind(tb_r3, 1), TK_OPERATOR, ":: op");
    assert_eq(tokenbuf_len(tb_r3, 1),  2,           ":: len 2");

    # `#[derive(Debug)]` tokenizes as # op + [ punct + ident + ( + ident + ) + ].
    var tb_r4 = tokenbuf_new();
    var src_r4 = "#[derive]";
    tokenize_with_grammar(grust, src_r4, strlen(src_r4), tb_r4);
    assert_eq(tokenbuf_count(tb_r4), 4, "4 tokens: # [ derive ]");
    assert_eq(tokenbuf_kind(tb_r4, 0), TK_OPERATOR,    "# operator");
    assert_eq(tokenbuf_kind(tb_r4, 1), TK_PUNCTUATION, "[ punct");
    assert_eq(tokenbuf_kind(tb_r4, 2), TK_IDENT,       "derive ident");
    assert_eq(tokenbuf_kind(tb_r4, 3), TK_PUNCTUATION, "] punct");

    test_group("M3 yaml grammar — loads and tokenizes cleanly");
    var gyaml = grammar_load("grammars/yaml.cyml");
    assert_neq(gyaml, 0, "grammar_load yaml returned non-null");
    assert_eq(streq(grammar_name(gyaml), "yaml"), 1, "name is 'yaml'");

    # `key: value` — : is punctuation between idents.
    var tb_y1 = tokenbuf_new();
    var src_y1 = "foo: bar";
    tokenize_with_grammar(gyaml, src_y1, strlen(src_y1), tb_y1);
    assert_eq(tokenbuf_count(tb_y1), 4, "ident : ws ident = 4 tokens");
    assert_eq(tokenbuf_kind(tb_y1, 0), TK_IDENT,       "foo ident");
    assert_eq(tokenbuf_kind(tb_y1, 1), TK_PUNCTUATION, ": punct");
    assert_eq(tokenbuf_kind(tb_y1, 3), TK_IDENT,       "bar ident");

    # Anchor + alias: &x / *x.
    var tb_y2 = tokenbuf_new();
    var src_y2 = "a: &n 1\nb: *n";
    tokenize_with_grammar(gyaml, src_y2, strlen(src_y2), tb_y2);
    var saw_anchor = 0;
    var saw_alias = 0;
    var y2i = 0;
    var y2n = tokenbuf_count(tb_y2);
    while (y2i < y2n) {
        if (tokenbuf_kind(tb_y2, y2i) == TK_OPERATOR) {
            var l = tokenbuf_len(tb_y2, y2i);
            var s = tokenbuf_start(tb_y2, y2i);
            if ((l == 1) && (load8(src_y2 + s) == 38)) { saw_anchor = 1; }
            if ((l == 1) && (load8(src_y2 + s) == 42)) { saw_alias  = 1; }
        }
        y2i = y2i + 1;
    }
    assert_eq(saw_anchor, 1, "& anchor recognized as operator");
    assert_eq(saw_alias,  1, "* alias recognized as operator");

    # Merge-key `<<` is a 2-char operator.
    var tb_y3 = tokenbuf_new();
    var src_y3 = "<<: *x";
    tokenize_with_grammar(gyaml, src_y3, strlen(src_y3), tb_y3);
    assert_eq(tokenbuf_kind(tb_y3, 0), TK_OPERATOR, "<< operator");
    assert_eq(tokenbuf_len(tb_y3, 0),  2,           "<< len 2");

    # Keywords: true/false/null/yes/no/on/off.
    var tb_y4 = tokenbuf_new();
    var src_y4 = "a: yes\nb: no\nc: null\nd: on\ne: off";
    tokenize_with_grammar(gyaml, src_y4, strlen(src_y4), tb_y4);
    var kw_count = 0;
    var y4i = 0;
    var y4n = tokenbuf_count(tb_y4);
    while (y4i < y4n) {
        if (tokenbuf_kind(tb_y4, y4i) == TK_KEYWORD) { kw_count = kw_count + 1; }
        y4i = y4i + 1;
    }
    assert_eq(kw_count, 5, "5 yaml keywords: yes no null on off");

    test_group("M3 markdown grammar — loads and tokenizes cleanly");
    var gmd = grammar_load("grammars/markdown.cyml");
    assert_neq(gmd, 0, "grammar_load markdown returned non-null");
    assert_eq(streq(grammar_name(gmd), "markdown"), 1, "name is 'markdown'");

    # ATX heading operators: longest-first match.
    var tb_m1 = tokenbuf_new();
    var src_m1 = "# Title";
    tokenize_with_grammar(gmd, src_m1, strlen(src_m1), tb_m1);
    assert_eq(tokenbuf_kind(tb_m1, 0), TK_OPERATOR, "# heading marker");
    assert_eq(tokenbuf_len(tb_m1, 0),  1,           "# single char");

    var tb_m2 = tokenbuf_new();
    var src_m2 = "### Sub";
    tokenize_with_grammar(gmd, src_m2, strlen(src_m2), tb_m2);
    assert_eq(tokenbuf_kind(tb_m2, 0), TK_OPERATOR, "### heading 3");
    assert_eq(tokenbuf_len(tb_m2, 0),  3,           "### len 3");

    # Fenced code block (triple-backtick + language tag).
    # 1.13.2+: routed through the inner grammar named by the
    # info-string tag (ADR 0016). Tokens: open marker as
    # TK_PUNCTUATION (incl. tag + LF), inner Rust tokens,
    # close marker as TK_PUNCTUATION. See the dedicated
    # 1.13.2 group below for full coverage; here we just
    # check the shape didn't regress.
    var tb_m3 = tokenbuf_new();
    var src_m3 = "```rust\nfn x() {}\n```";
    tokenize_with_grammar(gmd, src_m3, strlen(src_m3), tb_m3);
    assert(tokenbuf_count(tb_m3) >= 3,
           "fenced block: at least open + body + close");
    assert_eq(tokenbuf_kind(tb_m3, 0), TK_PUNCTUATION,
              "fenced block: open marker is punctuation");
    var tb_m3_last = tokenbuf_count(tb_m3) - 1;
    assert_eq(tokenbuf_kind(tb_m3, tb_m3_last), TK_PUNCTUATION,
              "fenced block: close marker is punctuation");
    var sum_m3 = 0;
    var m3i = 0;
    while (m3i < tokenbuf_count(tb_m3)) {
        sum_m3 = sum_m3 + tokenbuf_len(tb_m3, m3i);
        m3i = m3i + 1;
    }
    assert_eq(sum_m3, strlen(src_m3),
              "fenced block: coverage invariant holds");

    # Inline code backticks.
    var tb_m4 = tokenbuf_new();
    var src_m4 = "use `lex()` here";
    tokenize_with_grammar(gmd, src_m4, strlen(src_m4), tb_m4);
    var saw_inline = 0;
    var m4i = 0;
    var m4n = tokenbuf_count(tb_m4);
    while (m4i < m4n) {
        if (tokenbuf_kind(tb_m4, m4i) == TK_STRING) {
            if (tokenbuf_len(tb_m4, m4i) == 7) { saw_inline = 1; }   # `lex()`
        }
        m4i = m4i + 1;
    }
    assert_eq(saw_inline, 1, "inline backtick-pair emits a string token");

    # HTML comment `<!-- ... -->`.
    var tb_m5 = tokenbuf_new();
    var src_m5 = "<!-- hi -->";
    tokenize_with_grammar(gmd, src_m5, strlen(src_m5), tb_m5);
    assert_eq(tokenbuf_count(tb_m5), 1,             "HTML comment is one token");
    assert_eq(tokenbuf_kind(tb_m5, 0), TK_COMMENT,  "HTML comment kind");

    # Emphasis: *italic* and **bold**.
    var tb_m6 = tokenbuf_new();
    var src_m6 = "**bold**";
    tokenize_with_grammar(gmd, src_m6, strlen(src_m6), tb_m6);
    assert_eq(tokenbuf_kind(tb_m6, 0), TK_OPERATOR, "** operator");
    assert_eq(tokenbuf_len(tb_m6, 0),  2,           "** len 2");
    assert_eq(tokenbuf_kind(tb_m6, 1), TK_IDENT,    "bold ident");
    assert_eq(tokenbuf_kind(tb_m6, 2), TK_OPERATOR, "closing **");

    test_group("M3 c grammar — loads and tokenizes cleanly");
    var gc = grammar_load("grammars/c.cyml");
    assert_neq(gc, 0, "grammar_load c returned non-null");
    assert_eq(streq(grammar_name(gc), "c"), 1, "name is 'c'");

    # `//` line comment, not `#`.
    var tb_cc1 = tokenbuf_new();
    var src_cc1 = "// note\nint x;";
    tokenize_with_grammar(gc, src_cc1, strlen(src_cc1), tb_cc1);
    assert_eq(tokenbuf_kind(tb_cc1, 0), TK_COMMENT, "// comment");
    assert_eq(tokenbuf_len(tb_cc1, 0),  7,          "// note len 7");
    assert_eq(tokenbuf_kind(tb_cc1, 2), TK_KEYWORD, "int keyword");

    # `->` and `++` multi-char operators.
    var tb_cc2 = tokenbuf_new();
    var src_cc2 = "p->n++";
    tokenize_with_grammar(gc, src_cc2, strlen(src_cc2), tb_cc2);
    assert_eq(tokenbuf_count(tb_cc2), 4, "p -> n ++ = 4 tokens");
    assert_eq(tokenbuf_kind(tb_cc2, 1), TK_OPERATOR, "-> op");
    assert_eq(tokenbuf_len(tb_cc2, 1),  2,           "-> len 2");
    assert_eq(tokenbuf_kind(tb_cc2, 3), TK_OPERATOR, "++ op");
    assert_eq(tokenbuf_len(tb_cc2, 3),  2,           "++ len 2");

    # Preprocessor-shaped line tokenizes as # + ident + ... (no
    # special preprocessor kind in M3).
    var tb_cc3 = tokenbuf_new();
    var src_cc3 = "#include";
    tokenize_with_grammar(gc, src_cc3, strlen(src_cc3), tb_cc3);
    assert_eq(tokenbuf_count(tb_cc3), 2, "# + include = 2 tokens");
    assert_eq(tokenbuf_kind(tb_cc3, 0), TK_OPERATOR, "# operator");
    assert_eq(tokenbuf_kind(tb_cc3, 1), TK_IDENT,    "include ident (not a C keyword)");

    # Backslash in char escape like '\0' must not error.
    var tb_cc4 = tokenbuf_new();
    var src_cc4 = "char c = '\\0';";
    tokenize_with_grammar(gc, src_cc4, strlen(src_cc4), tb_cc4);
    var cc4i = 0;
    var cc4n = tokenbuf_count(tb_cc4);
    var any_err = 0;
    while (cc4i < cc4n) {
        if (tokenbuf_kind(tb_cc4, cc4i) == TK_ERROR) { any_err = 1; }
        cc4i = cc4i + 1;
    }
    assert_eq(any_err, 0, "char-escape backslash doesn't error");

    test_group("M3 typescript grammar — loads and tokenizes cleanly");
    var gts = grammar_load("grammars/typescript.cyml");
    assert_neq(gts, 0, "grammar_load typescript returned non-null");
    assert_eq(streq(grammar_name(gts), "typescript"), 1, "name is 'typescript'");

    # Template literal `...${expr}...` as one string token.
    var tb_t1 = tokenbuf_new();
    var src_t1 = "`hi ${x} bye`";
    tokenize_with_grammar(gts, src_t1, strlen(src_t1), tb_t1);
    assert_eq(tokenbuf_count(tb_t1), 1, "template literal is one token");
    assert_eq(tokenbuf_kind(tb_t1, 0), TK_STRING, "template is string");

    # `=>` arrow, `??` nullish coalesce, `?.` optional chain.
    var tb_t2 = tokenbuf_new();
    var src_t2 = "a => b ?? c?.d";
    tokenize_with_grammar(gts, src_t2, strlen(src_t2), tb_t2);
    var saw_arrow = 0;
    var saw_coalesce = 0;
    var saw_optchain = 0;
    var t2i = 0;
    var t2n = tokenbuf_count(tb_t2);
    while (t2i < t2n) {
        if (tokenbuf_kind(tb_t2, t2i) == TK_OPERATOR) {
            var s = tokenbuf_start(tb_t2, t2i);
            var l = tokenbuf_len(tb_t2, t2i);
            if ((l == 2) && (memeq(src_t2 + s, "=>", 2) == 1)) { saw_arrow = 1; }
            if ((l == 2) && (memeq(src_t2 + s, "??", 2) == 1)) { saw_coalesce = 1; }
            if ((l == 2) && (memeq(src_t2 + s, "?.", 2) == 1)) { saw_optchain = 1; }
        }
        t2i = t2i + 1;
    }
    assert_eq(saw_arrow,    1, "=> op");
    assert_eq(saw_coalesce, 1, "?? op");
    assert_eq(saw_optchain, 1, "?. op");

    # `$` is valid in idents: `$x`, `jQuery$`.
    var tb_t3 = tokenbuf_new();
    var src_t3 = "$foo";
    tokenize_with_grammar(gts, src_t3, strlen(src_t3), tb_t3);
    assert_eq(tokenbuf_count(tb_t3), 1,          "$foo is one token");
    assert_eq(tokenbuf_kind(tb_t3, 0), TK_IDENT, "$foo ident");
    assert_eq(tokenbuf_len(tb_t3, 0),  4,        "$foo len 4");

    test_group("M3 javascript grammar — loads and tokenizes cleanly");
    var gjs = grammar_load("grammars/javascript.cyml");
    assert_neq(gjs, 0, "grammar_load javascript returned non-null");
    assert_eq(streq(grammar_name(gjs), "javascript"), 1, "name is 'javascript'");

    # JS has `function` as keyword but no `interface` / `type`.
    var tb_js1 = tokenbuf_new();
    var src_js1 = "function f() {}";
    tokenize_with_grammar(gjs, src_js1, strlen(src_js1), tb_js1);
    assert_eq(tokenbuf_kind(tb_js1, 0), TK_KEYWORD, "function keyword");
    assert_eq(tokenbuf_len(tb_js1, 0),  8,          "function len 8");

    var tb_js2 = tokenbuf_new();
    var src_js2 = "interface F";
    tokenize_with_grammar(gjs, src_js2, strlen(src_js2), tb_js2);
    assert_eq(tokenbuf_kind(tb_js2, 0), TK_IDENT, "interface is NOT a JS keyword");

    test_group("M3 python grammar — loads and tokenizes cleanly");
    var gpy = grammar_load("grammars/python.cyml");
    assert_neq(gpy, 0, "grammar_load python returned non-null");
    assert_eq(streq(grammar_name(gpy), "python"), 1, "name is 'python'");

    # Triple-quoted string as ONE token (pair rule ordering).
    var tb_py1 = tokenbuf_new();
    var src_py1 = "\"\"\"docstring here\"\"\"";
    tokenize_with_grammar(gpy, src_py1, strlen(src_py1), tb_py1);
    assert_eq(tokenbuf_count(tb_py1), 1,          "triple-quoted is one token");
    assert_eq(tokenbuf_kind(tb_py1, 0), TK_STRING, "triple-quoted is string");
    assert_eq(tokenbuf_len(tb_py1, 0), strlen(src_py1), "covers whole input");

    # Walrus := as a 2-char operator.
    var tb_py2 = tokenbuf_new();
    var src_py2 = "(x := 1)";
    tokenize_with_grammar(gpy, src_py2, strlen(src_py2), tb_py2);
    var saw_walrus = 0;
    var py2i = 0;
    var py2n = tokenbuf_count(tb_py2);
    while (py2i < py2n) {
        if (tokenbuf_kind(tb_py2, py2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_py2, py2i) == 2) {
                var s = tokenbuf_start(tb_py2, py2i);
                if (memeq(src_py2 + s, ":=", 2) == 1) { saw_walrus = 1; }
            }
        }
        py2i = py2i + 1;
    }
    assert_eq(saw_walrus, 1, ":= walrus op");

    # `//` is floor division, NOT a comment in Python.
    var tb_py3 = tokenbuf_new();
    var src_py3 = "a // b";
    tokenize_with_grammar(gpy, src_py3, strlen(src_py3), tb_py3);
    assert_eq(tokenbuf_kind(tb_py3, 2), TK_OPERATOR, "// floor-div op, not comment");
    assert_eq(tokenbuf_len(tb_py3, 2),  2,           "// len 2");

    # `#` still starts a line comment.
    var tb_py4 = tokenbuf_new();
    var src_py4 = "# py comment\nx";
    tokenize_with_grammar(gpy, src_py4, strlen(src_py4), tb_py4);
    assert_eq(tokenbuf_kind(tb_py4, 0), TK_COMMENT, "# still a comment");

    test_group("1.2.0 go grammar — loads and tokenizes cleanly");
    var ggo = grammar_load("grammars/go.cyml");
    assert_neq(ggo, 0, "grammar_load go returned non-null");
    assert_eq(streq(grammar_name(ggo), "go"), 1, "name is 'go'");

    # `package` is a reserved word.
    var tb_go1 = tokenbuf_new();
    var src_go1 = "package main";
    tokenize_with_grammar(ggo, src_go1, strlen(src_go1), tb_go1);
    assert_eq(tokenbuf_kind(tb_go1, 0), TK_KEYWORD, "package keyword");
    assert_eq(tokenbuf_len(tb_go1, 0),  7,          "package len 7");

    # `:=` short-var-decl is one operator.
    var tb_go2 = tokenbuf_new();
    var src_go2 = "x := 1";
    tokenize_with_grammar(ggo, src_go2, strlen(src_go2), tb_go2);
    var saw_walrus_go = 0;
    var go2i = 0;
    var go2n = tokenbuf_count(tb_go2);
    while (go2i < go2n) {
        if (tokenbuf_kind(tb_go2, go2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_go2, go2i) == 2) {
                var sgo = tokenbuf_start(tb_go2, go2i);
                if (memeq(src_go2 + sgo, ":=", 2) == 1) { saw_walrus_go = 1; }
            }
        }
        go2i = go2i + 1;
    }
    assert_eq(saw_walrus_go, 1, ":= short-var-decl op");

    # Block comment `/* ... */` collapses into one TK_COMMENT span.
    var tb_go3 = tokenbuf_new();
    var src_go3 = "/* go block */ x";
    tokenize_with_grammar(ggo, src_go3, strlen(src_go3), tb_go3);
    assert_eq(tokenbuf_kind(tb_go3, 0), TK_COMMENT, "/* … */ is one comment");
    assert_eq(tokenbuf_len(tb_go3, 0), 14,          "/* go block */ len 14");

    # Predeclared `len` is ident, not keyword (per ADR 0004 pattern).
    var tb_go4 = tokenbuf_new();
    var src_go4 = "len";
    tokenize_with_grammar(ggo, src_go4, strlen(src_go4), tb_go4);
    assert_eq(tokenbuf_kind(tb_go4, 0), TK_IDENT, "len is ident, not keyword");

    test_group("1.2.0 zig grammar — loads and tokenizes cleanly");
    var gzig = grammar_load("grammars/zig.cyml");
    assert_neq(gzig, 0, "grammar_load zig returned non-null");
    assert_eq(streq(grammar_name(gzig), "zig"), 1, "name is 'zig'");

    # `pub` is a reserved word.
    var tb_zig1 = tokenbuf_new();
    var src_zig1 = "pub fn main";
    tokenize_with_grammar(gzig, src_zig1, strlen(src_zig1), tb_zig1);
    assert_eq(tokenbuf_kind(tb_zig1, 0), TK_KEYWORD, "pub keyword");
    assert_eq(tokenbuf_kind(tb_zig1, 2), TK_KEYWORD, "fn keyword");

    # `@import` tokenizes as one ident (the `@` prefix).
    var tb_zig2 = tokenbuf_new();
    var src_zig2 = "@import";
    tokenize_with_grammar(gzig, src_zig2, strlen(src_zig2), tb_zig2);
    assert_eq(tokenbuf_count(tb_zig2), 1,          "@import is one token");
    assert_eq(tokenbuf_kind(tb_zig2, 0), TK_IDENT, "@import is ident");
    assert_eq(tokenbuf_len(tb_zig2, 0),  7,        "@import len 7");

    # `=>` switch arm as one operator.
    var tb_zig3 = tokenbuf_new();
    var src_zig3 = ".plus => 1";
    tokenize_with_grammar(gzig, src_zig3, strlen(src_zig3), tb_zig3);
    var saw_arrow_zig = 0;
    var zig3i = 0;
    var zig3n = tokenbuf_count(tb_zig3);
    while (zig3i < zig3n) {
        if (tokenbuf_kind(tb_zig3, zig3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_zig3, zig3i) == 2) {
                var szig = tokenbuf_start(tb_zig3, zig3i);
                if (memeq(src_zig3 + szig, "=>", 2) == 1) { saw_arrow_zig = 1; }
            }
        }
        zig3i = zig3i + 1;
    }
    assert_eq(saw_arrow_zig, 1, "=> switch-arm op");

    # `orelse` is a word-keyword (Zig spells some operators as words).
    var tb_zig4 = tokenbuf_new();
    var src_zig4 = "x orelse 0";
    tokenize_with_grammar(gzig, src_zig4, strlen(src_zig4), tb_zig4);
    assert_eq(tokenbuf_kind(tb_zig4, 2), TK_KEYWORD, "orelse keyword");
    assert_eq(tokenbuf_len(tb_zig4, 2),  6,          "orelse len 6");

    test_group("1.2.1 char_literal default — three forms + lifetime preservation");
    # Plain `'a'` collapses to one TK_STRING.
    var tb_cl1 = tokenbuf_new();
    var src_cl1 = "x = 'a'";
    tokenize_with_grammar(grust, src_cl1, strlen(src_cl1), tb_cl1);
    var saw_cl1 = 0;
    var cl1i = 0;
    var cl1n = tokenbuf_count(tb_cl1);
    while (cl1i < cl1n) {
        if (tokenbuf_kind(tb_cl1, cl1i) == TK_STRING) {
            if (tokenbuf_len(tb_cl1, cl1i) == 3) {
                if (memeq(src_cl1 + tokenbuf_start(tb_cl1, cl1i), "'a'", 3) == 1) {
                    saw_cl1 = 1;
                }
            }
        }
        cl1i = cl1i + 1;
    }
    assert_eq(saw_cl1, 1, "'a' as single TK_STRING (Rust)");

    # Backslash escape `'\n'` → 4-byte TK_STRING.
    var tb_cl2 = tokenbuf_new();
    var src_cl2 = "x = '\\n'";
    tokenize_with_grammar(ggo, src_cl2, strlen(src_cl2), tb_cl2);
    var saw_cl2 = 0;
    var cl2i = 0;
    var cl2n = tokenbuf_count(tb_cl2);
    while (cl2i < cl2n) {
        if (tokenbuf_kind(tb_cl2, cl2i) == TK_STRING) {
            if (tokenbuf_len(tb_cl2, cl2i) == 4) { saw_cl2 = 1; }
        }
        cl2i = cl2i + 1;
    }
    assert_eq(saw_cl2, 1, "'\\n' as 4-byte TK_STRING (Go)");

    # Hex escape `'\xff'` → 6-byte TK_STRING.
    var tb_cl3 = tokenbuf_new();
    var src_cl3 = "x = '\\xff'";
    tokenize_with_grammar(gc, src_cl3, strlen(src_cl3), tb_cl3);
    var saw_cl3 = 0;
    var cl3i = 0;
    var cl3n = tokenbuf_count(tb_cl3);
    while (cl3i < cl3n) {
        if (tokenbuf_kind(tb_cl3, cl3i) == TK_STRING) {
            if (tokenbuf_len(tb_cl3, cl3i) == 6) { saw_cl3 = 1; }
        }
        cl3i = cl3i + 1;
    }
    assert_eq(saw_cl3, 1, "'\\xff' as 6-byte TK_STRING (C)");

    # Rust lifetime `'a` (no closing quote) is preserved as `'` + ident.
    var tb_cl4 = tokenbuf_new();
    var src_cl4 = "&'a str";
    tokenize_with_grammar(grust, src_cl4, strlen(src_cl4), tb_cl4);
    var saw_lifetime_quote = 0;
    var saw_lifetime_ident = 0;
    var cl4i = 0;
    var cl4n = tokenbuf_count(tb_cl4);
    while (cl4i < cl4n) {
        if (tokenbuf_kind(tb_cl4, cl4i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_cl4, cl4i) == 1) {
                if (memeq(src_cl4 + tokenbuf_start(tb_cl4, cl4i), "'", 1) == 1) {
                    saw_lifetime_quote = 1;
                }
            }
        }
        if (tokenbuf_kind(tb_cl4, cl4i) == TK_IDENT) {
            if (tokenbuf_len(tb_cl4, cl4i) == 1) {
                if (memeq(src_cl4 + tokenbuf_start(tb_cl4, cl4i), "a", 1) == 1) {
                    saw_lifetime_ident = 1;
                }
            }
        }
        cl4i = cl4i + 1;
    }
    assert_eq(saw_lifetime_quote, 1, "'a lifetime: ' as operator");
    assert_eq(saw_lifetime_ident, 1, "'a lifetime: a as ident");

    test_group("1.2.2 asm_x86_64 grammar — loads and tokenizes cleanly");
    var gasm86 = grammar_load("grammars/asm_x86_64.cyml");
    assert_neq(gasm86, 0, "grammar_load asm_x86_64 returned non-null");
    assert_eq(streq(grammar_name(gasm86), "asm_x86_64"), 1, "name is 'asm_x86_64'");

    # `.global` is a recognised directive (keyword via words rule).
    var tb_a86_1 = tokenbuf_new();
    var src_a86_1 = ".global _start";
    tokenize_with_grammar(gasm86, src_a86_1, strlen(src_a86_1), tb_a86_1);
    assert_eq(tokenbuf_kind(tb_a86_1, 0), TK_KEYWORD, ".global is keyword");
    assert_eq(tokenbuf_len(tb_a86_1, 0),  7,          ".global len 7");

    # An opcode (`mov`) tokenizes as plain ident — opcodes are NOT
    # in the keyword set (per grammar header / ADR 0004 pattern).
    var tb_a86_2 = tokenbuf_new();
    var src_a86_2 = "mov rax, 1";
    tokenize_with_grammar(gasm86, src_a86_2, strlen(src_a86_2), tb_a86_2);
    assert_eq(tokenbuf_kind(tb_a86_2, 0), TK_IDENT, "mov is ident, not keyword");
    assert_eq(tokenbuf_kind(tb_a86_2, 2), TK_IDENT, "rax is ident, not keyword");

    # A char literal in an immediate operand tokenizes as one TK_STRING.
    var tb_a86_3 = tokenbuf_new();
    var src_a86_3 = "mov dil, '0'";
    tokenize_with_grammar(gasm86, src_a86_3, strlen(src_a86_3), tb_a86_3);
    var saw_a86_charlit = 0;
    var a86_3i = 0;
    var a86_3n = tokenbuf_count(tb_a86_3);
    while (a86_3i < a86_3n) {
        if (tokenbuf_kind(tb_a86_3, a86_3i) == TK_STRING) {
            if (tokenbuf_len(tb_a86_3, a86_3i) == 3) { saw_a86_charlit = 1; }
        }
        a86_3i = a86_3i + 1;
    }
    assert_eq(saw_a86_charlit, 1, "'0' tokenizes as 3-byte TK_STRING");

    # A local label `.is_digit_yes` tokenizes as one ident (the
    # leading `.` is in ident_start).
    var tb_a86_4 = tokenbuf_new();
    var src_a86_4 = ".is_digit_yes:";
    tokenize_with_grammar(gasm86, src_a86_4, strlen(src_a86_4), tb_a86_4);
    assert_eq(tokenbuf_kind(tb_a86_4, 0), TK_IDENT, "local label is ident");
    assert_eq(tokenbuf_len(tb_a86_4, 0),  13,       ".is_digit_yes len 13");

    test_group("1.2.3 asm_aarch64 grammar — loads and tokenizes cleanly");
    var gasmarm = grammar_load("grammars/asm_aarch64.cyml");
    assert_neq(gasmarm, 0, "grammar_load asm_aarch64 returned non-null");
    assert_eq(streq(grammar_name(gasmarm), "asm_aarch64"), 1, "name is 'asm_aarch64'");

    # `.global` is a recognised directive — same shape as x86.
    var tb_arm1 = tokenbuf_new();
    var src_arm1 = ".global _start";
    tokenize_with_grammar(gasmarm, src_arm1, strlen(src_arm1), tb_arm1);
    assert_eq(tokenbuf_kind(tb_arm1, 0), TK_KEYWORD, ".global is keyword");

    # Conditional branch `b.ne` tokenizes as ONE ident — the `.` is
    # in ident_cont for this grammar (vs. asm_x86_64 where it's only
    # in ident_start). Captures `b.eq`/`b.ne`/`b.lt`/etc. uniformly.
    var tb_arm2 = tokenbuf_new();
    var src_arm2 = "b.ne fail";
    tokenize_with_grammar(gasmarm, src_arm2, strlen(src_arm2), tb_arm2);
    assert_eq(tokenbuf_kind(tb_arm2, 0), TK_IDENT, "b.ne is ident");
    assert_eq(tokenbuf_len(tb_arm2, 0),  4,        "b.ne len 4 (one token)");

    # `//` line comment (NOT `#` — `#` is the immediate prefix).
    var tb_arm3 = tokenbuf_new();
    var src_arm3 = "// comment\nx";
    tokenize_with_grammar(gasmarm, src_arm3, strlen(src_arm3), tb_arm3);
    assert_eq(tokenbuf_kind(tb_arm3, 0), TK_COMMENT, "// is comment");

    # `#` immediate prefix tokenizes as a 1-byte operator (not
    # a comment marker; not part of the ident).
    var tb_arm4 = tokenbuf_new();
    var src_arm4 = "mov w0, #5";
    tokenize_with_grammar(gasmarm, src_arm4, strlen(src_arm4), tb_arm4);
    var saw_hash_op = 0;
    var arm4i = 0;
    var arm4n = tokenbuf_count(tb_arm4);
    while (arm4i < arm4n) {
        if (tokenbuf_kind(tb_arm4, arm4i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_arm4, arm4i) == 1) {
                if (memeq(src_arm4 + tokenbuf_start(tb_arm4, arm4i), "#", 1) == 1) {
                    saw_hash_op = 1;
                }
            }
        }
        arm4i = arm4i + 1;
    }
    assert_eq(saw_hash_op, 1, "# is operator (immediate prefix)");

    # Char literal `'5'` after `#` (`#'5'` immediate operand) —
    # `#` operator + `'5'` 3-byte string.
    var tb_arm5 = tokenbuf_new();
    var src_arm5 = "mov w0, #'5'";
    tokenize_with_grammar(gasmarm, src_arm5, strlen(src_arm5), tb_arm5);
    var saw_charlit_arm = 0;
    var arm5i = 0;
    var arm5n = tokenbuf_count(tb_arm5);
    while (arm5i < arm5n) {
        if (tokenbuf_kind(tb_arm5, arm5i) == TK_STRING) {
            if (tokenbuf_len(tb_arm5, arm5i) == 3) { saw_charlit_arm = 1; }
        }
        arm5i = arm5i + 1;
    }
    assert_eq(saw_charlit_arm, 1, "'5' is 3-byte TK_STRING (after #)");

    test_group("1.3.0 java grammar — loads and tokenizes cleanly");
    var gjava = grammar_load("grammars/java.cyml");
    assert_neq(gjava, 0, "grammar_load java returned non-null");
    assert_eq(streq(grammar_name(gjava), "java"), 1, "name is 'java'");

    # `class` is a keyword.
    var tb_jv1 = tokenbuf_new();
    var src_jv1 = "public class Foo";
    tokenize_with_grammar(gjava, src_jv1, strlen(src_jv1), tb_jv1);
    assert_eq(tokenbuf_kind(tb_jv1, 0), TK_KEYWORD, "public keyword");
    assert_eq(tokenbuf_kind(tb_jv1, 2), TK_KEYWORD, "class keyword");

    # `@Override` tokenizes as one ident (`@` in ident_start).
    var tb_jv2 = tokenbuf_new();
    var src_jv2 = "@Override";
    tokenize_with_grammar(gjava, src_jv2, strlen(src_jv2), tb_jv2);
    assert_eq(tokenbuf_count(tb_jv2), 1,          "@Override one token");
    assert_eq(tokenbuf_kind(tb_jv2, 0), TK_IDENT, "@Override ident");
    assert_eq(tokenbuf_len(tb_jv2, 0),  9,        "@Override len 9");

    # `->` lambda arrow.
    var tb_jv3 = tokenbuf_new();
    var src_jv3 = "x -> x + 1";
    tokenize_with_grammar(gjava, src_jv3, strlen(src_jv3), tb_jv3);
    var saw_jv_arrow = 0;
    var jv3i = 0;
    while (jv3i < tokenbuf_count(tb_jv3)) {
        if (tokenbuf_kind(tb_jv3, jv3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_jv3, jv3i) == 2) {
                var sjv = tokenbuf_start(tb_jv3, jv3i);
                if (memeq(src_jv3 + sjv, "->", 2) == 1) { saw_jv_arrow = 1; }
            }
        }
        jv3i = jv3i + 1;
    }
    assert_eq(saw_jv_arrow, 1, "-> as 2-byte op");

    test_group("1.3.0 kotlin grammar — loads and tokenizes cleanly");
    var gkt = grammar_load("grammars/kotlin.cyml");
    assert_neq(gkt, 0, "grammar_load kotlin returned non-null");
    assert_eq(streq(grammar_name(gkt), "kotlin"), 1, "name is 'kotlin'");

    # `data class` — both keywords.
    var tb_kt1 = tokenbuf_new();
    var src_kt1 = "data class Foo";
    tokenize_with_grammar(gkt, src_kt1, strlen(src_kt1), tb_kt1);
    assert_eq(tokenbuf_kind(tb_kt1, 0), TK_KEYWORD, "data keyword");
    assert_eq(tokenbuf_kind(tb_kt1, 2), TK_KEYWORD, "class keyword");

    # Elvis operator `?:` is one 2-byte op.
    var tb_kt2 = tokenbuf_new();
    var src_kt2 = "x ?: 0";
    tokenize_with_grammar(gkt, src_kt2, strlen(src_kt2), tb_kt2);
    var saw_elvis = 0;
    var kt2i = 0;
    while (kt2i < tokenbuf_count(tb_kt2)) {
        if (tokenbuf_kind(tb_kt2, kt2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_kt2, kt2i) == 2) {
                var skt = tokenbuf_start(tb_kt2, kt2i);
                if (memeq(src_kt2 + skt, "?:", 2) == 1) { saw_elvis = 1; }
            }
        }
        kt2i = kt2i + 1;
    }
    assert_eq(saw_elvis, 1, "?: Elvis op");

    test_group("1.3.0 cpp grammar — loads and tokenizes cleanly");
    var gcpp = grammar_load("grammars/cpp.cyml");
    assert_neq(gcpp, 0, "grammar_load cpp returned non-null");
    assert_eq(streq(grammar_name(gcpp), "cpp"), 1, "name is 'cpp'");

    # `namespace` is a keyword.
    var tb_cpp1 = tokenbuf_new();
    var src_cpp1 = "namespace foo {}";
    tokenize_with_grammar(gcpp, src_cpp1, strlen(src_cpp1), tb_cpp1);
    assert_eq(tokenbuf_kind(tb_cpp1, 0), TK_KEYWORD, "namespace keyword");

    # `::` scope-resolution as one 2-byte op.
    var tb_cpp2 = tokenbuf_new();
    var src_cpp2 = "std::vector";
    tokenize_with_grammar(gcpp, src_cpp2, strlen(src_cpp2), tb_cpp2);
    var saw_scope = 0;
    var cpp2i = 0;
    while (cpp2i < tokenbuf_count(tb_cpp2)) {
        if (tokenbuf_kind(tb_cpp2, cpp2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_cpp2, cpp2i) == 2) {
                var scpp = tokenbuf_start(tb_cpp2, cpp2i);
                if (memeq(src_cpp2 + scpp, "::", 2) == 1) { saw_scope = 1; }
            }
        }
        cpp2i = cpp2i + 1;
    }
    assert_eq(saw_scope, 1, ":: scope-resolution op");

    # `<=>` three-way compare (C++20) as one 3-byte op.
    var tb_cpp3 = tokenbuf_new();
    var src_cpp3 = "a <=> b";
    tokenize_with_grammar(gcpp, src_cpp3, strlen(src_cpp3), tb_cpp3);
    var saw_spaceship = 0;
    var cpp3i = 0;
    while (cpp3i < tokenbuf_count(tb_cpp3)) {
        if (tokenbuf_kind(tb_cpp3, cpp3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_cpp3, cpp3i) == 3) {
                var scpp3 = tokenbuf_start(tb_cpp3, cpp3i);
                if (memeq(src_cpp3 + scpp3, "<=>", 3) == 1) { saw_spaceship = 1; }
            }
        }
        cpp3i = cpp3i + 1;
    }
    assert_eq(saw_spaceship, 1, "<=> three-way compare op");

    test_group("1.3.0 csharp grammar — loads and tokenizes cleanly");
    var gcs = grammar_load("grammars/csharp.cyml");
    assert_neq(gcs, 0, "grammar_load csharp returned non-null");
    assert_eq(streq(grammar_name(gcs), "csharp"), 1, "name is 'csharp'");

    # `record` is a keyword.
    var tb_cs1 = tokenbuf_new();
    var src_cs1 = "public record Foo";
    tokenize_with_grammar(gcs, src_cs1, strlen(src_cs1), tb_cs1);
    assert_eq(tokenbuf_kind(tb_cs1, 0), TK_KEYWORD, "public keyword");
    assert_eq(tokenbuf_kind(tb_cs1, 2), TK_KEYWORD, "record keyword");

    # `=>` arrow as 2-byte op.
    var tb_cs2 = tokenbuf_new();
    var src_cs2 = "x => x";
    tokenize_with_grammar(gcs, src_cs2, strlen(src_cs2), tb_cs2);
    var saw_csarrow = 0;
    var cs2i = 0;
    while (cs2i < tokenbuf_count(tb_cs2)) {
        if (tokenbuf_kind(tb_cs2, cs2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_cs2, cs2i) == 2) {
                var scs = tokenbuf_start(tb_cs2, cs2i);
                if (memeq(src_cs2 + scs, "=>", 2) == 1) { saw_csarrow = 1; }
            }
        }
        cs2i = cs2i + 1;
    }
    assert_eq(saw_csarrow, 1, "=> arrow op");

    # `??=` null-coalesce-assign as one 3-byte op.
    var tb_cs3 = tokenbuf_new();
    var src_cs3 = "x ??= 0";
    tokenize_with_grammar(gcs, src_cs3, strlen(src_cs3), tb_cs3);
    var saw_nca = 0;
    var cs3i = 0;
    while (cs3i < tokenbuf_count(tb_cs3)) {
        if (tokenbuf_kind(tb_cs3, cs3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_cs3, cs3i) == 3) {
                var scs3 = tokenbuf_start(tb_cs3, cs3i);
                if (memeq(src_cs3 + scs3, "??=", 3) == 1) { saw_nca = 1; }
            }
        }
        cs3i = cs3i + 1;
    }
    assert_eq(saw_nca, 1, "??= null-coalesce-assign op");

    test_group("1.4.0 php grammar — loads and tokenizes cleanly");
    var gphp = grammar_load("grammars/php.cyml");
    assert_neq(gphp, 0, "grammar_load php returned non-null");
    assert_eq(streq(grammar_name(gphp), "php"), 1, "name is 'php'");

    # `class` is a keyword.
    var tb_php1 = tokenbuf_new();
    var src_php1 = "final class Foo";
    tokenize_with_grammar(gphp, src_php1, strlen(src_php1), tb_php1);
    assert_eq(tokenbuf_kind(tb_php1, 0), TK_KEYWORD, "final keyword");
    assert_eq(tokenbuf_kind(tb_php1, 2), TK_KEYWORD, "class keyword");

    # `$variable` tokenizes as one ident (`$` in ident_start).
    var tb_php2 = tokenbuf_new();
    var src_php2 = "$source";
    tokenize_with_grammar(gphp, src_php2, strlen(src_php2), tb_php2);
    assert_eq(tokenbuf_count(tb_php2), 1,          "$source one token");
    assert_eq(tokenbuf_kind(tb_php2, 0), TK_IDENT, "$source ident");
    assert_eq(tokenbuf_len(tb_php2, 0),  7,        "$source len 7");

    # Namespace separator `\` is an operator.
    var tb_php3 = tokenbuf_new();
    var src_php3 = "Foo\\Bar";
    tokenize_with_grammar(gphp, src_php3, strlen(src_php3), tb_php3);
    var saw_nssep = 0;
    var php3i = 0;
    while (php3i < tokenbuf_count(tb_php3)) {
        if (tokenbuf_kind(tb_php3, php3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_php3, php3i) == 1) {
                var sphp = tokenbuf_start(tb_php3, php3i);
                if (load8(src_php3 + sphp) == 92) { saw_nssep = 1; }
            }
        }
        php3i = php3i + 1;
    }
    assert_eq(saw_nssep, 1, "\\ namespace separator op");

    test_group("1.4.0 ruby grammar — loads and tokenizes cleanly");
    var grb = grammar_load("grammars/ruby.cyml");
    assert_neq(grb, 0, "grammar_load ruby returned non-null");
    assert_eq(streq(grammar_name(grb), "ruby"), 1, "name is 'ruby'");

    # `def` is a keyword.
    var tb_rb1 = tokenbuf_new();
    var src_rb1 = "def foo end";
    tokenize_with_grammar(grb, src_rb1, strlen(src_rb1), tb_rb1);
    assert_eq(tokenbuf_kind(tb_rb1, 0), TK_KEYWORD, "def keyword");
    assert_eq(tokenbuf_kind(tb_rb1, 4), TK_KEYWORD, "end keyword");

    # `=begin ... =end` block comment as one TK_COMMENT.
    var tb_rb2 = tokenbuf_new();
    var src_rb2 = "=begin\nbody\n=end";
    tokenize_with_grammar(grb, src_rb2, strlen(src_rb2), tb_rb2);
    assert_eq(tokenbuf_kind(tb_rb2, 0), TK_COMMENT, "=begin/=end is comment");
    assert_eq(tokenbuf_len(tb_rb2, 0), strlen(src_rb2), "covers whole input");

    # `@instance_var` and `$global` tokenize as one ident each.
    var tb_rb3 = tokenbuf_new();
    var src_rb3 = "@source";
    tokenize_with_grammar(grb, src_rb3, strlen(src_rb3), tb_rb3);
    assert_eq(tokenbuf_count(tb_rb3), 1,          "@source one token");
    assert_eq(tokenbuf_kind(tb_rb3, 0), TK_IDENT, "@source ident");

    test_group("1.4.0 lua grammar — loads and tokenizes cleanly");
    var glua = grammar_load("grammars/lua.cyml");
    assert_neq(glua, 0, "grammar_load lua returned non-null");
    assert_eq(streq(grammar_name(glua), "lua"), 1, "name is 'lua'");

    # `function` is a keyword; `local` is a keyword.
    var tb_lua1 = tokenbuf_new();
    var src_lua1 = "local function foo";
    tokenize_with_grammar(glua, src_lua1, strlen(src_lua1), tb_lua1);
    assert_eq(tokenbuf_kind(tb_lua1, 0), TK_KEYWORD, "local keyword");
    assert_eq(tokenbuf_kind(tb_lua1, 2), TK_KEYWORD, "function keyword");

    # `--[[ … ]]` long comment as one TK_COMMENT.
    var tb_lua2 = tokenbuf_new();
    var src_lua2 = "--[[block]]\nx";
    tokenize_with_grammar(glua, src_lua2, strlen(src_lua2), tb_lua2);
    assert_eq(tokenbuf_kind(tb_lua2, 0), TK_COMMENT, "--[[…]] long comment");
    assert_eq(tokenbuf_len(tb_lua2, 0),  11,         "long comment len 11");

    # `--` line comment now via pair-rule with end=\n; covers
    # the trailing newline. Architecture note: two pair rules
    # for comments because lua's longer prefix needs to win
    # against the shorter `--` form.
    var tb_lua3 = tokenbuf_new();
    var src_lua3 = "-- line\nx";
    tokenize_with_grammar(glua, src_lua3, strlen(src_lua3), tb_lua3);
    assert_eq(tokenbuf_kind(tb_lua3, 0), TK_COMMENT, "-- line comment");

    # `[[ … ]]` long string — uninterpreted, multi-line capable.
    var tb_lua4 = tokenbuf_new();
    var src_lua4 = "[[hello]]";
    tokenize_with_grammar(glua, src_lua4, strlen(src_lua4), tb_lua4);
    assert_eq(tokenbuf_kind(tb_lua4, 0), TK_STRING, "[[…]] long string");
    assert_eq(tokenbuf_len(tb_lua4, 0),  9,         "long string len 9");

    test_group("1.4.0 swift grammar — loads and tokenizes cleanly");
    var gswift = grammar_load("grammars/swift.cyml");
    assert_neq(gswift, 0, "grammar_load swift returned non-null");
    assert_eq(streq(grammar_name(gswift), "swift"), 1, "name is 'swift'");

    # `func` and `let` are keywords.
    var tb_sw1 = tokenbuf_new();
    var src_sw1 = "func foo() {}";
    tokenize_with_grammar(gswift, src_sw1, strlen(src_sw1), tb_sw1);
    assert_eq(tokenbuf_kind(tb_sw1, 0), TK_KEYWORD, "func keyword");

    # `"""…"""` multi-line string as one TK_STRING.
    var tb_sw2 = tokenbuf_new();
    var src_sw2 = "\"\"\"hello\"\"\"";
    tokenize_with_grammar(gswift, src_sw2, strlen(src_sw2), tb_sw2);
    assert_eq(tokenbuf_count(tb_sw2), 1,          "triple-quoted one token");
    assert_eq(tokenbuf_kind(tb_sw2, 0), TK_STRING, "triple-quoted is string");
    assert_eq(tokenbuf_len(tb_sw2, 0), strlen(src_sw2), "covers whole input");

    # `..<` half-open range op (Swift-specific, 3 bytes).
    var tb_sw3 = tokenbuf_new();
    var src_sw3 = "0..<10";
    tokenize_with_grammar(gswift, src_sw3, strlen(src_sw3), tb_sw3);
    var saw_halfopen = 0;
    var sw3i = 0;
    while (sw3i < tokenbuf_count(tb_sw3)) {
        if (tokenbuf_kind(tb_sw3, sw3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_sw3, sw3i) == 3) {
                var ssw3 = tokenbuf_start(tb_sw3, sw3i);
                if (memeq(src_sw3 + ssw3, "..<", 3) == 1) { saw_halfopen = 1; }
            }
        }
        sw3i = sw3i + 1;
    }
    assert_eq(saw_halfopen, 1, "..< half-open range op");

    test_group("1.5.0 elixir grammar — loads and tokenizes cleanly");
    var gex = grammar_load("grammars/elixir.cyml");
    assert_neq(gex, 0, "grammar_load elixir returned non-null");
    assert_eq(streq(grammar_name(gex), "elixir"), 1, "name is 'elixir'");

    # `defmodule` is a keyword.
    var tb_ex1 = tokenbuf_new();
    var src_ex1 = "defmodule Foo do end";
    tokenize_with_grammar(gex, src_ex1, strlen(src_ex1), tb_ex1);
    assert_eq(tokenbuf_kind(tb_ex1, 0), TK_KEYWORD, "defmodule keyword");

    # `|>` pipe op (2-byte).
    var tb_ex2 = tokenbuf_new();
    var src_ex2 = "x |> y";
    tokenize_with_grammar(gex, src_ex2, strlen(src_ex2), tb_ex2);
    var saw_pipe = 0;
    var ex2i = 0;
    while (ex2i < tokenbuf_count(tb_ex2)) {
        if (tokenbuf_kind(tb_ex2, ex2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_ex2, ex2i) == 2) {
                var sex = tokenbuf_start(tb_ex2, ex2i);
                if (memeq(src_ex2 + sex, "|>", 2) == 1) { saw_pipe = 1; }
            }
        }
        ex2i = ex2i + 1;
    }
    assert_eq(saw_pipe, 1, "|> pipe op");

    # `%` for struct/map literal prefix is an operator (NOT
    # modulo — Elixir uses rem/2).
    var tb_ex3 = tokenbuf_new();
    var src_ex3 = "%Foo{bar: 1}";
    tokenize_with_grammar(gex, src_ex3, strlen(src_ex3), tb_ex3);
    var saw_pct = 0;
    var ex3i = 0;
    while (ex3i < tokenbuf_count(tb_ex3)) {
        if (tokenbuf_kind(tb_ex3, ex3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_ex3, ex3i) == 1) {
                if (load8(src_ex3 + tokenbuf_start(tb_ex3, ex3i)) == 37) {
                    saw_pct = 1;
                }
            }
        }
        ex3i = ex3i + 1;
    }
    assert_eq(saw_pct, 1, "% struct/map literal prefix");

    test_group("1.5.0 ocaml grammar — loads and tokenizes cleanly");
    var gml = grammar_load("grammars/ocaml.cyml");
    assert_neq(gml, 0, "grammar_load ocaml returned non-null");
    assert_eq(streq(grammar_name(gml), "ocaml"), 1, "name is 'ocaml'");

    # `let rec` keywords.
    var tb_ml1 = tokenbuf_new();
    var src_ml1 = "let rec foo = ()";
    tokenize_with_grammar(gml, src_ml1, strlen(src_ml1), tb_ml1);
    assert_eq(tokenbuf_kind(tb_ml1, 0), TK_KEYWORD, "let keyword");
    assert_eq(tokenbuf_kind(tb_ml1, 2), TK_KEYWORD, "rec keyword");

    # `(* ... *)` block comment as one TK_COMMENT.
    var tb_ml2 = tokenbuf_new();
    var src_ml2 = "(* hi *)x";
    tokenize_with_grammar(gml, src_ml2, strlen(src_ml2), tb_ml2);
    assert_eq(tokenbuf_kind(tb_ml2, 0), TK_COMMENT, "(* ... *) comment");
    assert_eq(tokenbuf_len(tb_ml2, 0),  8,          "comment len 8");

    # `'a` type variable: `'` + ident, NOT a char literal
    # (no closing quote at offset 2). ADR 0010 lifetime
    # preservation logic in action.
    var tb_ml3 = tokenbuf_new();
    var src_ml3 = "'a list";
    tokenize_with_grammar(gml, src_ml3, strlen(src_ml3), tb_ml3);
    assert_eq(tokenbuf_kind(tb_ml3, 0), TK_OPERATOR, "'a type var: ' is operator");
    assert_eq(tokenbuf_kind(tb_ml3, 1), TK_IDENT,    "'a type var: a is ident");

    # `'a'` char literal: `'` + body + `'` collapses to TK_STRING.
    var tb_ml4 = tokenbuf_new();
    var src_ml4 = "let c = 'a'";
    tokenize_with_grammar(gml, src_ml4, strlen(src_ml4), tb_ml4);
    var saw_charlit_ml = 0;
    var ml4i = 0;
    while (ml4i < tokenbuf_count(tb_ml4)) {
        if (tokenbuf_kind(tb_ml4, ml4i) == TK_STRING) {
            if (tokenbuf_len(tb_ml4, ml4i) == 3) { saw_charlit_ml = 1; }
        }
        ml4i = ml4i + 1;
    }
    assert_eq(saw_charlit_ml, 1, "'a' char literal as 3-byte TK_STRING");

    test_group("1.5.0 haskell grammar — loads and tokenizes cleanly");
    var ghs = grammar_load("grammars/haskell.cyml");
    assert_neq(ghs, 0, "grammar_load haskell returned non-null");
    assert_eq(streq(grammar_name(ghs), "haskell"), 1, "name is 'haskell'");

    # `module` is a keyword.
    var tb_hs1 = tokenbuf_new();
    var src_hs1 = "module Foo where";
    tokenize_with_grammar(ghs, src_hs1, strlen(src_hs1), tb_hs1);
    assert_eq(tokenbuf_kind(tb_hs1, 0), TK_KEYWORD, "module keyword");
    assert_eq(tokenbuf_kind(tb_hs1, 4), TK_KEYWORD, "where keyword");

    # `{- ... -}` block comment as one TK_COMMENT.
    var tb_hs2 = tokenbuf_new();
    var src_hs2 = "{- block -}x";
    tokenize_with_grammar(ghs, src_hs2, strlen(src_hs2), tb_hs2);
    assert_eq(tokenbuf_kind(tb_hs2, 0), TK_COMMENT, "{- ... -} comment");
    assert_eq(tokenbuf_len(tb_hs2, 0),  11,         "comment len 11");

    # Prime-suffixed identifier `rest'` is one TK_IDENT (length 5).
    var tb_hs3 = tokenbuf_new();
    var src_hs3 = "let rest' = []";
    tokenize_with_grammar(ghs, src_hs3, strlen(src_hs3), tb_hs3);
    var saw_prime = 0;
    var hs3i = 0;
    while (hs3i < tokenbuf_count(tb_hs3)) {
        if (tokenbuf_kind(tb_hs3, hs3i) == TK_IDENT) {
            if (tokenbuf_len(tb_hs3, hs3i) == 5) {
                var shs = tokenbuf_start(tb_hs3, hs3i);
                if (memeq(src_hs3 + shs, "rest'", 5) == 1) { saw_prime = 1; }
            }
        }
        hs3i = hs3i + 1;
    }
    assert_eq(saw_prime, 1, "rest' is one ident (prime in ident_cont)");

    # `>>=` monadic bind as one 3-byte operator.
    var tb_hs4 = tokenbuf_new();
    var src_hs4 = "x >>= f";
    tokenize_with_grammar(ghs, src_hs4, strlen(src_hs4), tb_hs4);
    var saw_bind = 0;
    var hs4i = 0;
    while (hs4i < tokenbuf_count(tb_hs4)) {
        if (tokenbuf_kind(tb_hs4, hs4i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_hs4, hs4i) == 3) {
                var shs4 = tokenbuf_start(tb_hs4, hs4i);
                if (memeq(src_hs4 + shs4, ">>=", 3) == 1) { saw_bind = 1; }
            }
        }
        hs4i = hs4i + 1;
    }
    assert_eq(saw_bind, 1, ">>= monadic bind op");

    test_group("1.6.0 sql grammar — loads, case-insensitive keywords (ADR 0011)");
    var gsql = grammar_load("grammars/sql.cyml");
    assert_neq(gsql, 0, "grammar_load sql returned non-null");
    assert_eq(streq(grammar_name(gsql), "sql"), 1, "name is 'sql'");

    # Upper-case `SELECT` is keyword.
    var tb_sql1 = tokenbuf_new();
    var src_sql1 = "SELECT id FROM users";
    tokenize_with_grammar(gsql, src_sql1, strlen(src_sql1), tb_sql1);
    assert_eq(tokenbuf_kind(tb_sql1, 0), TK_KEYWORD, "SELECT keyword");
    assert_eq(tokenbuf_kind(tb_sql1, 4), TK_KEYWORD, "FROM keyword");

    # Lower-case `select` is also keyword (ADR 0011 case fold).
    var tb_sql2 = tokenbuf_new();
    var src_sql2 = "select id from users";
    tokenize_with_grammar(gsql, src_sql2, strlen(src_sql2), tb_sql2);
    assert_eq(tokenbuf_kind(tb_sql2, 0), TK_KEYWORD, "select keyword (lower)");
    assert_eq(tokenbuf_kind(tb_sql2, 4), TK_KEYWORD, "from keyword (lower)");

    # Mixed-case `Select` is also keyword.
    var tb_sql3 = tokenbuf_new();
    var src_sql3 = "Select id From users";
    tokenize_with_grammar(gsql, src_sql3, strlen(src_sql3), tb_sql3);
    assert_eq(tokenbuf_kind(tb_sql3, 0), TK_KEYWORD, "Select keyword (mixed)");
    assert_eq(tokenbuf_kind(tb_sql3, 4), TK_KEYWORD, "From keyword (mixed)");

    # Non-keyword ident still tokenizes as ident regardless of case.
    var tb_sql4 = tokenbuf_new();
    var src_sql4 = "MyTable";
    tokenize_with_grammar(gsql, src_sql4, strlen(src_sql4), tb_sql4);
    assert_eq(tokenbuf_kind(tb_sql4, 0), TK_IDENT, "MyTable is ident");

    # `<>` not-equal as 2-byte op.
    var tb_sql5 = tokenbuf_new();
    var src_sql5 = "a <> b";
    tokenize_with_grammar(gsql, src_sql5, strlen(src_sql5), tb_sql5);
    var saw_neq = 0;
    var sql5i = 0;
    while (sql5i < tokenbuf_count(tb_sql5)) {
        if (tokenbuf_kind(tb_sql5, sql5i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_sql5, sql5i) == 2) {
                var ssql5 = tokenbuf_start(tb_sql5, sql5i);
                if (memeq(src_sql5 + ssql5, "<>", 2) == 1) { saw_neq = 1; }
            }
        }
        sql5i = sql5i + 1;
    }
    assert_eq(saw_neq, 1, "<> not-equal op");

    test_group("1.6.0 graphql grammar — loads and tokenizes cleanly");
    var ggql = grammar_load("grammars/graphql.cyml");
    assert_neq(ggql, 0, "grammar_load graphql returned non-null");
    assert_eq(streq(grammar_name(ggql), "graphql"), 1, "name is 'graphql'");

    # `type` is a keyword.
    var tb_gql1 = tokenbuf_new();
    var src_gql1 = "type Foo {}";
    tokenize_with_grammar(ggql, src_gql1, strlen(src_gql1), tb_gql1);
    assert_eq(tokenbuf_kind(tb_gql1, 0), TK_KEYWORD, "type keyword");

    # `$variable` tokenizes as one ident (`$` in ident_start).
    var tb_gql2 = tokenbuf_new();
    var src_gql2 = "$id";
    tokenize_with_grammar(ggql, src_gql2, strlen(src_gql2), tb_gql2);
    assert_eq(tokenbuf_count(tb_gql2), 1,          "$id one token");
    assert_eq(tokenbuf_kind(tb_gql2, 0), TK_IDENT, "$id ident");
    assert_eq(tokenbuf_len(tb_gql2, 0),  3,        "$id len 3");

    # `@directive` tokenizes as one ident (`@` in ident_start).
    var tb_gql3 = tokenbuf_new();
    var src_gql3 = "@deprecated";
    tokenize_with_grammar(ggql, src_gql3, strlen(src_gql3), tb_gql3);
    assert_eq(tokenbuf_count(tb_gql3), 1,          "@deprecated one token");
    assert_eq(tokenbuf_kind(tb_gql3, 0), TK_IDENT, "@deprecated ident");

    # `"""…"""` block string as one TK_STRING.
    var tb_gql4 = tokenbuf_new();
    var src_gql4 = "\"\"\"docstring\"\"\"";
    tokenize_with_grammar(ggql, src_gql4, strlen(src_gql4), tb_gql4);
    assert_eq(tokenbuf_count(tb_gql4), 1,          "block string one token");
    assert_eq(tokenbuf_kind(tb_gql4, 0), TK_STRING, "block string is string");
    assert_eq(tokenbuf_len(tb_gql4, 0), strlen(src_gql4), "covers whole input");

    test_group("1.6.0 protobuf grammar — loads and tokenizes cleanly");
    var gpb = grammar_load("grammars/protobuf.cyml");
    assert_neq(gpb, 0, "grammar_load protobuf returned non-null");
    assert_eq(streq(grammar_name(gpb), "protobuf"), 1, "name is 'protobuf'");

    # `message` keyword.
    var tb_pb1 = tokenbuf_new();
    var src_pb1 = "message Foo {}";
    tokenize_with_grammar(gpb, src_pb1, strlen(src_pb1), tb_pb1);
    assert_eq(tokenbuf_kind(tb_pb1, 0), TK_KEYWORD, "message keyword");

    # `repeated` field label keyword.
    var tb_pb2 = tokenbuf_new();
    var src_pb2 = "repeated string tags = 6;";
    tokenize_with_grammar(gpb, src_pb2, strlen(src_pb2), tb_pb2);
    assert_eq(tokenbuf_kind(tb_pb2, 0), TK_KEYWORD, "repeated keyword");
    assert_eq(tokenbuf_kind(tb_pb2, 2), TK_KEYWORD, "string keyword (type)");

    # `int32` primitive type keyword.
    var tb_pb3 = tokenbuf_new();
    var src_pb3 = "int32 id = 1;";
    tokenize_with_grammar(gpb, src_pb3, strlen(src_pb3), tb_pb3);
    assert_eq(tokenbuf_kind(tb_pb3, 0), TK_KEYWORD, "int32 keyword");

    test_group("1.7.0 html grammar — loads and tokenizes cleanly");
    var ghtml = grammar_load("grammars/html.cyml");
    assert_neq(ghtml, 0, "grammar_load html returned non-null");
    assert_eq(streq(grammar_name(ghtml), "html"), 1, "name is 'html'");

    # `<!-- ... -->` block comment as one TK_COMMENT.
    var tb_h1 = tokenbuf_new();
    var src_h1 = "<!-- hi -->x";
    tokenize_with_grammar(ghtml, src_h1, strlen(src_h1), tb_h1);
    assert_eq(tokenbuf_kind(tb_h1, 0), TK_COMMENT, "<!-- ... --> comment");
    assert_eq(tokenbuf_len(tb_h1, 0),  11,         "comment len 11");

    # Self-closing tag `<br/>` tokenizes structurally.
    var tb_h2 = tokenbuf_new();
    var src_h2 = "<br/>";
    tokenize_with_grammar(ghtml, src_h2, strlen(src_h2), tb_h2);
    assert_eq(tokenbuf_kind(tb_h2, 0), TK_OPERATOR, "< open op");
    assert_eq(tokenbuf_kind(tb_h2, 1), TK_IDENT,    "br ident");
    assert_eq(tokenbuf_kind(tb_h2, 2), TK_OPERATOR, "/ close op");
    assert_eq(tokenbuf_kind(tb_h2, 3), TK_OPERATOR, "> close op");

    test_group("1.7.0 xml grammar — loads and tokenizes cleanly");
    var gxml = grammar_load("grammars/xml.cyml");
    assert_neq(gxml, 0, "grammar_load xml returned non-null");
    assert_eq(streq(grammar_name(gxml), "xml"), 1, "name is 'xml'");

    # `<![CDATA[ ... ]]>` is one token (the body is uninterpreted).
    var tb_x1 = tokenbuf_new();
    var src_x1 = "<![CDATA[<raw>&]]>";
    tokenize_with_grammar(gxml, src_x1, strlen(src_x1), tb_x1);
    assert_eq(tokenbuf_count(tb_x1), 1,           "CDATA one token");
    assert_eq(tokenbuf_kind(tb_x1, 0), TK_STRING, "CDATA is string");
    assert_eq(tokenbuf_len(tb_x1, 0), strlen(src_x1), "covers whole input");

    # Processing instruction `<?xml … ?>` is one token (preprocessor).
    var tb_x2 = tokenbuf_new();
    var src_x2 = "<?xml version=\"1.0\"?>";
    tokenize_with_grammar(gxml, src_x2, strlen(src_x2), tb_x2);
    assert_eq(tokenbuf_count(tb_x2), 1, "PI one token");
    assert_eq(tokenbuf_kind(tb_x2, 0), TK_PREPROCESSOR, "PI is preprocessor");

    test_group("1.7.0 css grammar — loads and tokenizes cleanly");
    var gcss = grammar_load("grammars/css.cyml");
    assert_neq(gcss, 0, "grammar_load css returned non-null");
    assert_eq(streq(grammar_name(gcss), "css"), 1, "name is 'css'");

    # `@media` is a keyword (via @ in ident_start + words rule).
    var tb_css1 = tokenbuf_new();
    var src_css1 = "@media (min-width: 768px) {}";
    tokenize_with_grammar(gcss, src_css1, strlen(src_css1), tb_css1);
    assert_eq(tokenbuf_kind(tb_css1, 0), TK_KEYWORD, "@media keyword");
    assert_eq(tokenbuf_len(tb_css1, 0),  6,          "@media len 6");

    # `#hero` id selector is one ident (`#` in ident_start).
    var tb_css2 = tokenbuf_new();
    var src_css2 = "#hero";
    tokenize_with_grammar(gcss, src_css2, strlen(src_css2), tb_css2);
    assert_eq(tokenbuf_count(tb_css2), 1,           "#hero one token");
    assert_eq(tokenbuf_kind(tb_css2, 0), TK_IDENT,  "#hero ident");

    # `--color-bg` custom property is one ident (`-` in ident_start).
    var tb_css3 = tokenbuf_new();
    var src_css3 = "--color-bg";
    tokenize_with_grammar(gcss, src_css3, strlen(src_css3), tb_css3);
    assert_eq(tokenbuf_count(tb_css3), 1,           "--color-bg one token");
    assert_eq(tokenbuf_kind(tb_css3, 0), TK_IDENT,  "--color-bg ident");
    assert_eq(tokenbuf_len(tb_css3, 0),  10,        "--color-bg len 10");

    # `::after` pseudo-element: `::` is a 2-byte op.
    var tb_c4 = tokenbuf_new();
    var src_c4 = "a::after";
    tokenize_with_grammar(gcss, src_c4, strlen(src_c4), tb_c4);
    var saw_pseudo = 0;
    var c4i = 0;
    while (c4i < tokenbuf_count(tb_c4)) {
        if (tokenbuf_kind(tb_c4, c4i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_c4, c4i) == 2) {
                var sc4 = tokenbuf_start(tb_c4, c4i);
                if (memeq(src_c4 + sc4, "::", 2) == 1) { saw_pseudo = 1; }
            }
        }
        c4i = c4i + 1;
    }
    assert_eq(saw_pseudo, 1, ":: pseudo-element op");

    test_group("1.7.0 scss grammar — loads and tokenizes cleanly");
    var gscss = grammar_load("grammars/scss.cyml");
    assert_neq(gscss, 0, "grammar_load scss returned non-null");
    assert_eq(streq(grammar_name(gscss), "scss"), 1, "name is 'scss'");

    # `$variable` is one ident (`$` in ident_start).
    var tb_s1 = tokenbuf_new();
    var src_s1 = "$color-bg";
    tokenize_with_grammar(gscss, src_s1, strlen(src_s1), tb_s1);
    assert_eq(tokenbuf_count(tb_s1), 1,           "$color-bg one token");
    assert_eq(tokenbuf_kind(tb_s1, 0), TK_IDENT,  "$color-bg ident");
    assert_eq(tokenbuf_len(tb_s1, 0),  9,         "$color-bg len 9");

    # `@mixin` is keyword (SCSS-specific at-rule).
    var tb_s2 = tokenbuf_new();
    var src_s2 = "@mixin foo() {}";
    tokenize_with_grammar(gscss, src_s2, strlen(src_s2), tb_s2);
    assert_eq(tokenbuf_kind(tb_s2, 0), TK_KEYWORD, "@mixin keyword");
    assert_eq(tokenbuf_len(tb_s2, 0),  6,          "@mixin len 6");

    # `//` line comment (SCSS-specific, not in CSS).
    var tb_s3 = tokenbuf_new();
    var src_s3 = "// comment\nx";
    tokenize_with_grammar(gscss, src_s3, strlen(src_s3), tb_s3);
    assert_eq(tokenbuf_kind(tb_s3, 0), TK_COMMENT, "// is comment");

    test_group("1.8.0 dockerfile grammar — loads, case-insensitive instructions (ADR 0011)");
    var gdf = grammar_load("grammars/dockerfile.cyml");
    assert_neq(gdf, 0, "grammar_load dockerfile returned non-null");
    assert_eq(streq(grammar_name(gdf), "dockerfile"), 1, "name is 'dockerfile'");

    # Upper-case `FROM` is keyword.
    var tb_df1 = tokenbuf_new();
    var src_df1 = "FROM alpine";
    tokenize_with_grammar(gdf, src_df1, strlen(src_df1), tb_df1);
    assert_eq(tokenbuf_kind(tb_df1, 0), TK_KEYWORD, "FROM keyword");

    # Lower-case `from` is also keyword (ADR 0011 case fold).
    var tb_df2 = tokenbuf_new();
    var src_df2 = "from alpine";
    tokenize_with_grammar(gdf, src_df2, strlen(src_df2), tb_df2);
    assert_eq(tokenbuf_kind(tb_df2, 0), TK_KEYWORD, "from keyword (lower)");

    # Mixed-case `WorkDir` is also keyword.
    var tb_df3 = tokenbuf_new();
    var src_df3 = "WorkDir /app";
    tokenize_with_grammar(gdf, src_df3, strlen(src_df3), tb_df3);
    assert_eq(tokenbuf_kind(tb_df3, 0), TK_KEYWORD, "WorkDir keyword (mixed)");

    test_group("1.8.0 makefile grammar — loads and tokenizes cleanly");
    var gmk = grammar_load("grammars/makefile.cyml");
    assert_neq(gmk, 0, "grammar_load makefile returned non-null");
    assert_eq(streq(grammar_name(gmk), "makefile"), 1, "name is 'makefile'");

    # `:=` immediate-assignment as a 2-byte op.
    var tb_mk1 = tokenbuf_new();
    var src_mk1 = "CFLAGS := -O2";
    tokenize_with_grammar(gmk, src_mk1, strlen(src_mk1), tb_mk1);
    var saw_imm = 0;
    var mk1i = 0;
    while (mk1i < tokenbuf_count(tb_mk1)) {
        if (tokenbuf_kind(tb_mk1, mk1i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_mk1, mk1i) == 2) {
                var smk1 = tokenbuf_start(tb_mk1, mk1i);
                if (memeq(src_mk1 + smk1, ":=", 2) == 1) { saw_imm = 1; }
            }
        }
        mk1i = mk1i + 1;
    }
    assert_eq(saw_imm, 1, ":= immediate-assign op");

    # `$@` automatic variable as a 2-byte op via the shared
    # `special_vars` machinery (built for shell; covers `@`,
    # `?`, `*`, `#`, `!`, `$`, `-`). Other Make auto-vars
    # (`$<`, `$^`, `$%`, `$+`, `$|`) gracefully degrade to
    # `$` op + 1-char op — coverage holds, theme can re-pair.
    # Extending the shared helper to add Make's chars would
    # risk false positives in shell, so we don't.
    var tb_mk2 = tokenbuf_new();
    var src_mk2 = "$@";
    tokenize_with_grammar(gmk, src_mk2, strlen(src_mk2), tb_mk2);
    assert_eq(tokenbuf_count(tb_mk2), 1,             "$@ one token");
    assert_eq(tokenbuf_kind(tb_mk2, 0), TK_OPERATOR, "$@ operator");
    assert_eq(tokenbuf_len(tb_mk2, 0),  2,           "$@ len 2");

    # `ifeq` is a keyword.
    var tb_mk3 = tokenbuf_new();
    var src_mk3 = "ifeq ($(FOO),bar)";
    tokenize_with_grammar(gmk, src_mk3, strlen(src_mk3), tb_mk3);
    assert_eq(tokenbuf_kind(tb_mk3, 0), TK_KEYWORD, "ifeq keyword");

    test_group("1.8.0 ini grammar — loads and tokenizes cleanly");
    var gini = grammar_load("grammars/ini.cyml");
    assert_neq(gini, 0, "grammar_load ini returned non-null");
    assert_eq(streq(grammar_name(gini), "ini"), 1, "name is 'ini'");

    # Section header `[section]` — `[` punct + ident + `]` punct.
    var tb_in1 = tokenbuf_new();
    var src_in1 = "[server]";
    tokenize_with_grammar(gini, src_in1, strlen(src_in1), tb_in1);
    assert_eq(tokenbuf_kind(tb_in1, 0), TK_PUNCTUATION, "[ punct");
    assert_eq(tokenbuf_kind(tb_in1, 1), TK_IDENT,       "section ident");
    assert_eq(tokenbuf_kind(tb_in1, 2), TK_PUNCTUATION, "] punct");

    # `;` line comment.
    var tb_in2 = tokenbuf_new();
    var src_in2 = "; classic\nx";
    tokenize_with_grammar(gini, src_in2, strlen(src_in2), tb_in2);
    assert_eq(tokenbuf_kind(tb_in2, 0), TK_COMMENT, "; line comment");

    # `#` line comment (modern form).
    var tb_in3 = tokenbuf_new();
    var src_in3 = "# modern\nx";
    tokenize_with_grammar(gini, src_in3, strlen(src_in3), tb_in3);
    assert_eq(tokenbuf_kind(tb_in3, 0), TK_COMMENT, "# line comment");

    # Nested-key section `[a.b.c]` — dots stay inside the
    # ident because `.` is in `ident_cont`. Whole `a.b.c`
    # tokenizes as one TK_IDENT of length 5; theme can split
    # by `.` for visual nesting if it wants.
    var tb_in4 = tokenbuf_new();
    var src_in4 = "[a.b.c]";
    tokenize_with_grammar(gini, src_in4, strlen(src_in4), tb_in4);
    assert_eq(tokenbuf_count(tb_in4), 3,             "[a.b.c] three tokens");
    assert_eq(tokenbuf_kind(tb_in4, 1), TK_IDENT,    "a.b.c ident");
    assert_eq(tokenbuf_len(tb_in4, 1),  5,           "a.b.c len 5");

    test_group("1.9.0 cyml grammar — loads, self-hosts, recognizes --- separator");
    var gcyml = grammar_load("grammars/cyml.cyml");
    assert_neq(gcyml, 0, "grammar_load cyml returned non-null");
    assert_eq(streq(grammar_name(gcyml), "cyml"), 1, "name is 'cyml'");

    # `[[entries]]` array-of-tables header tokenizes as `[[`
    # punct + ident + `]]` punct.
    var tb_cy1 = tokenbuf_new();
    var src_cy1 = "[[entries]]";
    tokenize_with_grammar(gcyml, src_cy1, strlen(src_cy1), tb_cy1);
    assert_eq(tokenbuf_kind(tb_cy1, 0), TK_PUNCTUATION, "[[ punct");
    assert_eq(tokenbuf_kind(tb_cy1, 1), TK_IDENT,       "entries ident");
    assert_eq(tokenbuf_kind(tb_cy1, 2), TK_PUNCTUATION, "]] punct");

    # `---` divider. 2.3.1 turns this into the start marker of a
    # compose_region rule (ADR 0019), so it is punctuation now —
    # the same kind `compose` gives `<style>` — where 1.9.0-2.3.0
    # tokenized it as a bare 3-byte operator. With nothing after
    # it the region body is empty and the marker stands alone.
    var tb_cy2 = tokenbuf_new();
    var src_cy2 = "---";
    tokenize_with_grammar(gcyml, src_cy2, strlen(src_cy2), tb_cy2);
    assert_eq(tokenbuf_count(tb_cy2), 1,                "--- one token");
    assert_eq(tokenbuf_kind(tb_cy2, 0), TK_PUNCTUATION, "--- region start marker");
    assert_eq(tokenbuf_len(tb_cy2, 0),  3,              "--- len 3");

    # Backtick inline code as TK_STRING.
    var tb_cy3 = tokenbuf_new();
    var src_cy3 = "see `cyrius deps`";
    tokenize_with_grammar(gcyml, src_cy3, strlen(src_cy3), tb_cy3);
    var saw_backtick_string = 0;
    var cy3i = 0;
    while (cy3i < tokenbuf_count(tb_cy3)) {
        if (tokenbuf_kind(tb_cy3, cy3i) == TK_STRING) {
            if (tokenbuf_len(tb_cy3, cy3i) == 13) { saw_backtick_string = 1; }
        }
        cy3i = cy3i + 1;
    }
    assert_eq(saw_backtick_string, 1, "`cyrius deps` is one string token");

    test_group("2.3.1 cyml compose_region — body routes to markdown (ADR 0019)");

    # A `#` line in the markdown body is a heading, not a TOML
    # comment. Through 2.3.0 the union rule set swallowed the whole
    # line as one TK_COMMENT; routed to markdown, `#` is a 1-byte
    # operator and the words after it stay idents.
    var tb_rgn1 = tokenbuf_new();
    var src_cr1 = "[a]\n---\n# Heading\n";
    tokenize_with_grammar(gcyml, src_cr1, strlen(src_cr1), tb_rgn1);
    var cr1_comment_len = 0;
    var cr1i = 0;
    while (cr1i < tokenbuf_count(tb_rgn1)) {
        if (tokenbuf_kind(tb_rgn1, cr1i) == TK_COMMENT) {
            cr1_comment_len = cr1_comment_len + tokenbuf_len(tb_rgn1, cr1i);
        }
        cr1i = cr1i + 1;
    }
    assert_eq(cr1_comment_len, 0, "body heading is not a comment");

    # The lookahead terminator is NOT consumed: the `[[entries]]`
    # that ends a body belongs to the TOML header after it. This is
    # the property plain `compose` (ADR 0013) cannot provide, since
    # it eats its own end marker.
    var tb_rgn2 = tokenbuf_new();
    var src_cr2 = "[a]\n---\nbody text\n[[entries]]\nn = 1\n";
    tokenize_with_grammar(gcyml, src_cr2, strlen(src_cr2), tb_rgn2);
    var cr2_saw_open = 0;
    var cr2_saw_close = 0;
    var cr2i = 0;
    while (cr2i < tokenbuf_count(tb_rgn2)) {
        if (tokenbuf_kind(tb_rgn2, cr2i) == TK_PUNCTUATION) {
            if (tokenbuf_len(tb_rgn2, cr2i) == 2) {
                var cr2s = tokenbuf_start(tb_rgn2, cr2i);
                if (memeq(src_cr2 + cr2s, "[[", 2) == 1) { cr2_saw_open = 1; }
                if (memeq(src_cr2 + cr2s, "]]", 2) == 1) { cr2_saw_close = 1; }
            }
        }
        cr2i = cr2i + 1;
    }
    assert_eq(cr2_saw_open,  1, "[[ survives the region terminator");
    assert_eq(cr2_saw_close, 1, "]] survives the region terminator");

    # Reaching EOF with no terminator is a normal ending, not a
    # failure. `compose` emits nothing at all in this case, which
    # is why every CYML file's final body went unrouted until now.
    var tb_rgn3 = tokenbuf_new();
    var src_cr3 = "[a]\n---\n# Trailing body to EOF\n";
    tokenize_with_grammar(gcyml, src_cr3, strlen(src_cr3), tb_rgn3);
    assert_eq(tb_coverage_sum(tb_rgn3), strlen(src_cr3), "EOF-terminated region covers input");
    var cr3_comment_len = 0;
    var cr3i = 0;
    while (cr3i < tokenbuf_count(tb_rgn3)) {
        if (tokenbuf_kind(tb_rgn3, cr3i) == TK_COMMENT) {
            cr3_comment_len = cr3_comment_len + tokenbuf_len(tb_rgn3, cr3i);
        }
        cr3i = cr3i + 1;
    }
    assert_eq(cr3_comment_len, 0, "EOF-terminated body is routed, not comment-swallowed");

    # A fenced block inside a body reaches markdown's compose_fenced
    # (ADR 0016) and routes on to the tagged grammar. Through 2.3.0
    # the third backtick opened a pair rule that ate the whole block
    # as one string, so `fn` never surfaced as a keyword.
    var tb_rgn4 = tokenbuf_new();
    var src_cr4 = "[a]\n---\n```cyrius\nfn f() { return 0; }\n```\n";
    tokenize_with_grammar(gcyml, src_cr4, strlen(src_cr4), tb_rgn4);
    var cr4_saw_fn_kw = 0;
    var cr4i = 0;
    while (cr4i < tokenbuf_count(tb_rgn4)) {
        if (tokenbuf_kind(tb_rgn4, cr4i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_rgn4, cr4i) == 2) {
                var cr4s = tokenbuf_start(tb_rgn4, cr4i);
                if (memeq(src_cr4 + cr4s, "fn", 2) == 1) { cr4_saw_fn_kw = 1; }
            }
        }
        cr4i = cr4i + 1;
    }
    assert_eq(cr4_saw_fn_kw, 1, "fenced cyrius block routes through to keywords");
    assert_eq(tb_coverage_sum(tb_rgn4), strlen(src_cr4), "fenced body covers input");

    test_group("2.3.1 markdown prose punctuation — quotes, apostrophes, $");

    # Quotation marks, apostrophes and `$` are ordinary prose bytes
    # in markdown, but were in neither the operator nor the
    # punctuation list through 2.3.0, so they fell through to
    # TK_ERROR. vyakarana's own README.md emitted 8 of them.
    var gmd_p = grammar_load("grammars/markdown.cyml");
    assert_neq(gmd_p, 0, "grammar_load markdown returned non-null");
    var tb_mp = tokenbuf_new();
    var src_mp = "It's \"quoted\" and costs $5.";
    tokenize_with_grammar(gmd_p, src_mp, strlen(src_mp), tb_mp);
    var mp_errors = 0;
    var mpi = 0;
    while (mpi < tokenbuf_count(tb_mp)) {
        if (tokenbuf_kind(tb_mp, mpi) == TK_ERROR) { mp_errors = mp_errors + 1; }
        mpi = mpi + 1;
    }
    assert_eq(mp_errors, 0, "markdown prose punctuation yields no error kinds");
    assert_eq(tb_coverage_sum(tb_mp), strlen(src_mp), "markdown prose covers input");

    test_group("1.9.0 llvm_ir grammar — loads and tokenizes cleanly");
    var gll = grammar_load("grammars/llvm_ir.cyml");
    assert_neq(gll, 0, "grammar_load llvm_ir returned non-null");
    assert_eq(streq(grammar_name(gll), "llvm_ir"), 1, "name is 'llvm_ir'");

    # `define` is a keyword.
    var tb_ll1 = tokenbuf_new();
    var src_ll1 = "define i32 @main()";
    tokenize_with_grammar(gll, src_ll1, strlen(src_ll1), tb_ll1);
    assert_eq(tokenbuf_kind(tb_ll1, 0), TK_KEYWORD, "define keyword");
    assert_eq(tokenbuf_kind(tb_ll1, 2), TK_KEYWORD, "i32 keyword (type)");

    # `@global` tokenizes as one ident (`@` in ident_start).
    var tb_ll2 = tokenbuf_new();
    var src_ll2 = "@global_count";
    tokenize_with_grammar(gll, src_ll2, strlen(src_ll2), tb_ll2);
    assert_eq(tokenbuf_count(tb_ll2), 1,           "@global one token");
    assert_eq(tokenbuf_kind(tb_ll2, 0), TK_IDENT,  "@global ident");
    assert_eq(tokenbuf_len(tb_ll2, 0),  13,        "@global_count len 13");

    # `%struct.Token` tokenizes as one ident (`%` in ident_start,
    # `.` in ident_cont).
    var tb_ll3 = tokenbuf_new();
    var src_ll3 = "%struct.Token";
    tokenize_with_grammar(gll, src_ll3, strlen(src_ll3), tb_ll3);
    assert_eq(tokenbuf_count(tb_ll3), 1,           "%struct.Token one token");
    assert_eq(tokenbuf_kind(tb_ll3, 0), TK_IDENT,  "%struct.Token ident");
    assert_eq(tokenbuf_len(tb_ll3, 0),  13,        "len 13");

    # `!llvm.module.flags` — metadata reference as one ident.
    var tb_ll4 = tokenbuf_new();
    var src_ll4 = "!llvm.module.flags";
    tokenize_with_grammar(gll, src_ll4, strlen(src_ll4), tb_ll4);
    assert_eq(tokenbuf_count(tb_ll4), 1,           "!metadata one token");
    assert_eq(tokenbuf_kind(tb_ll4, 0), TK_IDENT,  "!metadata ident");

    # `getelementptr inbounds` — both keywords.
    var tb_ll5 = tokenbuf_new();
    var src_ll5 = "getelementptr inbounds";
    tokenize_with_grammar(gll, src_ll5, strlen(src_ll5), tb_ll5);
    assert_eq(tokenbuf_kind(tb_ll5, 0), TK_KEYWORD, "getelementptr keyword");
    assert_eq(tokenbuf_kind(tb_ll5, 2), TK_KEYWORD, "inbounds keyword");

    test_group("1.10.0 theme-palette contract — three bundled themes");

    # Resolution: known names → tag, unknown → -1.
    assert_eq(theme_resolve("default"), THEME_DEFAULT, "default → THEME_DEFAULT");
    assert_eq(theme_resolve("dark"),    THEME_DARK,    "dark → THEME_DARK");
    assert_eq(theme_resolve("none"),    THEME_NONE,    "none → THEME_NONE");
    assert_eq(theme_resolve("nope"),    0 - 1,         "unknown → -1");
    assert_eq(theme_resolve(""),        0 - 1,         "empty → -1");

    # `default` palette: keyword is magenta, ident is unstyled.
    var dkw = theme_color(THEME_DEFAULT, TK_KEYWORD);
    assert(strlen(dkw) > 0, "default theme: keyword has a colour");
    assert_eq(memeq(dkw, "\x1b[35m", 5), 1, "default keyword = magenta");

    var did = theme_color(THEME_DEFAULT, TK_IDENT);
    assert_eq(strlen(did), 0, "default theme: ident has no colour");

    # `none` palette: every kind has empty colour.
    assert_eq(strlen(theme_color(THEME_NONE, TK_KEYWORD)),     0, "none keyword empty");
    assert_eq(strlen(theme_color(THEME_NONE, TK_STRING)),      0, "none string empty");
    assert_eq(strlen(theme_color(THEME_NONE, TK_ERROR)),       0, "none error empty");

    # `dark` palette: differs from default for at least one slot.
    var dark_kw   = theme_color(THEME_DARK, TK_KEYWORD);
    var def_kw    = theme_color(THEME_DEFAULT, TK_KEYWORD);
    assert(strlen(dark_kw) > 0, "dark theme: keyword has a colour");
    assert(streq(dark_kw, def_kw) == 0, "dark keyword differs from default");

    # Reset escape is well-formed.
    var rst = theme_reset();
    assert_eq(memeq(rst, "\x1b[0m", 4), 1, "reset = ESC[0m");

    test_group("1.11.0 LSP semantic-tokens bridge — name-based mapping");

    # Direct kind matches: keyword/comment/string/number/operator
    # are the obvious 5 (LSP and vyakarana share these names).
    assert_eq(lsp_kind_from_token_type("keyword"),  TK_KEYWORD,  "lsp keyword → TK_KEYWORD");
    assert_eq(lsp_kind_from_token_type("comment"),  TK_COMMENT,  "lsp comment → TK_COMMENT");
    assert_eq(lsp_kind_from_token_type("string"),   TK_STRING,   "lsp string → TK_STRING");
    assert_eq(lsp_kind_from_token_type("number"),   TK_NUMBER,   "lsp number → TK_NUMBER");
    assert_eq(lsp_kind_from_token_type("operator"), TK_OPERATOR, "lsp operator → TK_OPERATOR");

    # regexp collapses into TK_STRING (no separate regex kind).
    assert_eq(lsp_kind_from_token_type("regexp"), TK_STRING, "lsp regexp → TK_STRING");

    # modifier (storage class) → keyword. macro / decorator → preprocessor.
    assert_eq(lsp_kind_from_token_type("modifier"),  TK_KEYWORD,      "lsp modifier → TK_KEYWORD");
    assert_eq(lsp_kind_from_token_type("macro"),     TK_PREPROCESSOR, "lsp macro → TK_PREPROCESSOR");
    assert_eq(lsp_kind_from_token_type("decorator"), TK_PREPROCESSOR, "lsp decorator → TK_PREPROCESSOR");

    # Ident-flavoured types collapse to TK_IDENT.
    assert_eq(lsp_kind_from_token_type("function"),      TK_IDENT, "lsp function → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("method"),        TK_IDENT, "lsp method → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("variable"),      TK_IDENT, "lsp variable → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("parameter"),     TK_IDENT, "lsp parameter → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("property"),      TK_IDENT, "lsp property → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("class"),         TK_IDENT, "lsp class → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("interface"),     TK_IDENT, "lsp interface → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("struct"),        TK_IDENT, "lsp struct → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("enum"),          TK_IDENT, "lsp enum → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("enumMember"),    TK_IDENT, "lsp enumMember → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("namespace"),     TK_IDENT, "lsp namespace → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("type"),          TK_IDENT, "lsp type → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("typeParameter"), TK_IDENT, "lsp typeParameter → TK_IDENT");
    assert_eq(lsp_kind_from_token_type("event"),         TK_IDENT, "lsp event → TK_IDENT");

    # Unknown / extended-legend names → TK_IDENT (safe default).
    assert_eq(lsp_kind_from_token_type("custom_thing"), TK_IDENT, "extended legend → TK_IDENT");
    assert_eq(lsp_kind_from_token_type(""),             TK_IDENT, "empty name → TK_IDENT");

    test_group("1.11.0 LSP bridge — index-based mapping (LSP 3.17 standard legend)");

    # Index-based path covers the same surface, addressed by the
    # spec's standard-legend ordering.
    # Spec order (LSP 3.17 `SemanticTokenTypes`, + 3.18 `label`). Through
    # 2.5.1 these assertions pinned the code's own wrong table (idx 17
    # "keyword", 18 "comment", …); 2.5.2 audit P2-1.
    assert_eq(lsp_kind_from_standard_index(14), TK_PREPROCESSOR, "idx 14 (macro)");
    assert_eq(lsp_kind_from_standard_index(15), TK_KEYWORD,      "idx 15 (keyword)");
    assert_eq(lsp_kind_from_standard_index(16), TK_KEYWORD,      "idx 16 (modifier)");
    assert_eq(lsp_kind_from_standard_index(17), TK_COMMENT,      "idx 17 (comment)");
    assert_eq(lsp_kind_from_standard_index(18), TK_STRING,       "idx 18 (string)");
    assert_eq(lsp_kind_from_standard_index(19), TK_NUMBER,       "idx 19 (number)");
    assert_eq(lsp_kind_from_standard_index(20), TK_STRING,       "idx 20 (regexp)");
    assert_eq(lsp_kind_from_standard_index(21), TK_OPERATOR,     "idx 21 (operator)");
    assert_eq(lsp_kind_from_standard_index(22), TK_PREPROCESSOR, "idx 22 (decorator)");
    assert_eq(lsp_kind_from_standard_index(23), TK_IDENT,        "idx 23 (label, 3.18)");
    assert_eq(lsp_kind_from_standard_index(0),  TK_IDENT,        "idx 0 (namespace)");
    assert_eq(lsp_kind_from_standard_index(12), TK_IDENT,        "idx 12 (function)");

    # The index path must agree with the name path for every standard
    # index — the two used to disagree on nine of them.
    var lsp5_names = vec_new();
    vec_push(lsp5_names, "namespace"); vec_push(lsp5_names, "type");
    vec_push(lsp5_names, "class"); vec_push(lsp5_names, "enum");
    vec_push(lsp5_names, "interface"); vec_push(lsp5_names, "struct");
    vec_push(lsp5_names, "typeParameter"); vec_push(lsp5_names, "parameter");
    vec_push(lsp5_names, "variable"); vec_push(lsp5_names, "property");
    vec_push(lsp5_names, "enumMember"); vec_push(lsp5_names, "event");
    vec_push(lsp5_names, "function"); vec_push(lsp5_names, "method");
    vec_push(lsp5_names, "macro"); vec_push(lsp5_names, "keyword");
    vec_push(lsp5_names, "modifier"); vec_push(lsp5_names, "comment");
    vec_push(lsp5_names, "string"); vec_push(lsp5_names, "number");
    vec_push(lsp5_names, "regexp"); vec_push(lsp5_names, "operator");
    vec_push(lsp5_names, "decorator"); vec_push(lsp5_names, "label");
    var lsp5_bad = 0;
    var lsp5_i = 0;
    while (lsp5_i < vec_len(lsp5_names)) {
        if (lsp_kind_from_standard_index(lsp5_i) != lsp_kind_from_token_type(vec_get(lsp5_names, lsp5_i))) {
            lsp5_bad = lsp5_bad + 1;
        }
        lsp5_i = lsp5_i + 1;
    }
    assert_eq(lsp5_bad, 0, "standard index agrees with name mapping for all 24 types");

    # Out-of-range → TK_IDENT (servers with extended legends).
    assert_eq(lsp_kind_from_standard_index(99),       TK_IDENT, "out-of-range → TK_IDENT");
    assert_eq(lsp_kind_from_standard_index(0 - 1),    TK_IDENT, "negative → TK_IDENT");

    test_group("1.11.1 grammar composition (ADR 0013) — HTML <style>/<script>");
    var ghtml2 = grammar_load("grammars/html.cyml");
    assert_neq(ghtml2, 0, "html grammar reloads with compose rules");

    # `<style>...</style>` body routed through CSS grammar.
    # CSS treats `#FF6600` as one ident (because `#` is in CSS's
    # `ident_start`). Under HTML alone it would be `#` op +
    # `FF6600` ident — proves composition fired.
    var tb_co1 = tokenbuf_new();
    var src_co1 = "<style>.x{color:#FF6600;}</style>";
    tokenize_with_grammar(ghtml2, src_co1, strlen(src_co1), tb_co1);
    var saw_css_hex = 0;
    var co1i = 0;
    while (co1i < tokenbuf_count(tb_co1)) {
        if (tokenbuf_kind(tb_co1, co1i) == TK_IDENT) {
            if (tokenbuf_len(tb_co1, co1i) == 7) {
                var sco1 = tokenbuf_start(tb_co1, co1i);
                if (memeq(src_co1 + sco1, "#FF6600", 7) == 1) {
                    saw_css_hex = 1;
                }
            }
        }
        co1i = co1i + 1;
    }
    assert_eq(saw_css_hex, 1, "<style> body: #FF6600 is one CSS-grammar ident");

    # First and last tokens are TK_PUNCTUATION markers
    # (`<style>` len 7 and `</style>` len 8).
    assert_eq(tokenbuf_kind(tb_co1, 0), TK_PUNCTUATION, "<style> as marker");
    assert_eq(tokenbuf_len(tb_co1, 0),  7,              "<style> len 7");
    var lastc1 = tokenbuf_count(tb_co1) - 1;
    assert_eq(tokenbuf_kind(tb_co1, lastc1), TK_PUNCTUATION, "</style> as marker");
    assert_eq(tokenbuf_len(tb_co1, lastc1),  8,              "</style> len 8");

    # `<script>...</script>` body routed through JavaScript.
    # JS keywords (`const`, `function`, `return`) are TK_KEYWORD
    # under JS grammar; under HTML alone they'd be plain idents.
    var tb_co2 = tokenbuf_new();
    var src_co2 = "<script>const x=1;</script>";
    tokenize_with_grammar(ghtml2, src_co2, strlen(src_co2), tb_co2);
    var saw_js_keyword = 0;
    var co2i = 0;
    while (co2i < tokenbuf_count(tb_co2)) {
        if (tokenbuf_kind(tb_co2, co2i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_co2, co2i) == 5) {
                var sco2 = tokenbuf_start(tb_co2, co2i);
                if (memeq(src_co2 + sco2, "const", 5) == 1) {
                    saw_js_keyword = 1;
                }
            }
        }
        co2i = co2i + 1;
    }
    assert_eq(saw_js_keyword, 1, "<script> body: const is JS keyword");

    # Coverage invariant holds across compose: every input byte
    # maps into exactly one token's span.
    var sum_co1 = 0;
    var c1k = 0;
    while (c1k < tokenbuf_count(tb_co1)) {
        sum_co1 = sum_co1 + tokenbuf_len(tb_co1, c1k);
        c1k = c1k + 1;
    }
    assert_eq(sum_co1, strlen(src_co1), "compose preserves coverage invariant");

    test_group("1.11.2 content-based language detection (src/detect.cyr)");

    # Path-only API: extension-driven dispatch (the legacy shape).
    # Use assert_streq for cstr comparison; assert_eq for the
    # 0-pointer (no-match) cases.
    assert_streq(detect_language("foo.sh"),     "shell",      "path: .sh -> shell");
    assert_streq(detect_language("foo.py"),     "python",     "path: .py -> python");
    assert_streq(detect_language("foo.s"),      "asm_x86_64", "path: .s -> x86_64 (default)");
    assert_streq(detect_language("Makefile"),   "makefile",   "path: Makefile basename");
    assert_streq(detect_language("Dockerfile"), "dockerfile", "path: Dockerfile basename");
    assert_eq(detect_language("README"), 0, "path: extensionless / unknown -> 0");

    # Content sniff: shebang interp matching.
    var sb_py = "#!/usr/bin/env python3\nprint(1)\n";
    assert_streq(detect_language_from_content(sb_py, strlen(sb_py)),
                 "python", "content: env python3 shebang");

    var sb_bash = "#!/bin/bash\necho hi\n";
    assert_streq(detect_language_from_content(sb_bash, strlen(sb_bash)),
                 "shell", "content: /bin/bash shebang");

    var sb_sh = "#!/bin/sh\nls\n";
    assert_streq(detect_language_from_content(sb_sh, strlen(sb_sh)),
                 "shell", "content: /bin/sh shebang");

    var sb_node = "#!/usr/bin/env node\nconsole.log(1)\n";
    assert_streq(detect_language_from_content(sb_node, strlen(sb_node)),
                 "javascript", "content: env node shebang");

    var sb_ruby = "#!/usr/bin/ruby\nputs 'x'\n";
    assert_streq(detect_language_from_content(sb_ruby, strlen(sb_ruby)),
                 "ruby", "content: /usr/bin/ruby shebang");

    var sb_unknown = "#!/usr/bin/perl\nprint 'hi'\n";
    assert_eq(detect_language_from_content(sb_unknown, strlen(sb_unknown)),
              0, "content: unknown interp (perl) -> 0");

    # 2.5.1 — `_detect_shebang` rewritten to one pass per word (the
    # 2.3.4 version cost ~30% on detect/content-python). Answers were
    # checked equal to 2.5.0's on 400,000 generated first lines; these
    # lock the edge shapes that differential covered.
    var sb5_arg = "#!/bin/bash -e\necho\n";
    assert_streq(_t_detect(sb5_arg),
                 "shell", "content: interp argument ignored (#!/bin/bash -e)");
    var sb5_envs = "#!/usr/bin/env -S python3 -u\nx\n";
    assert_streq(_t_detect(sb5_envs),
                 "python", "content: env option skipped (env -S python3)");
    var sb5_envi = "#!/usr/bin/env -i sh\nx\n";
    assert_streq(_t_detect(sb5_envi),
                 "shell", "content: env option skipped (env -i sh)");
    var sb5_envtab = "#!/usr/bin/env\tpython3\nx\n";
    assert_streq(_t_detect(sb5_envtab),
                 "python", "content: tab separates env from interp");
    var sb5_envlf = "#!/usr/bin/env\npython3\n";
    assert_eq(detect_language_from_content(sb5_envlf, strlen(sb5_envlf)),
              0, "content: bare env never reads the next line");
    var sb5_envend = "#!/usr/bin/env -S";
    assert_eq(detect_language_from_content(sb5_envend, strlen(sb5_envend)),
              0, "content: env options running to end of input -> 0");
    var sb5_bare = "#!";
    assert_eq(detect_language_from_content(sb5_bare, strlen(sb5_bare)),
              0, "content: bare #! -> 0");
    var sb5_crlf = "#!/usr/bin/python3\r\nprint(1)\r\n";
    assert_streq(_t_detect(sb5_crlf),
                 "python", "content: CRLF first line (CR kept in word, prefix match)");
    var sb5_lua = "#!/usr/local/bin/lua5.4\nprint(1)\n";
    assert_streq(_t_detect(sb5_lua),
                 "lua", "content: versioned lua5.4");
    var sb5_php = "#!/usr/bin/php\n<?php\n";
    assert_streq(_t_detect(sb5_php),
                 "php", "content: php (shares first byte with python)");
    var sb5_chk = "#!/usr/bin/shellcheck\nx\n";
    assert_eq(detect_language_from_content(sb5_chk, strlen(sb5_chk)),
              0, "content: shellcheck is not a shell interpreter");
    # 2.5.1 fix: whitespace after `#!` (the kernel skips it). 2.3.4
    # through 2.5.0 returned 0 for both of these.
    var sb5_sp = "#! /bin/sh\nls\n";
    assert_streq(_t_detect(sb5_sp),
                 "shell", "content: space after #! (#! /bin/sh)");
    var sb5_tab = "#!\t/usr/bin/env python3\nx\n";
    assert_streq(_t_detect(sb5_tab),
                 "python", "content: tab after #! before env");
    var sb5_ws = "#!   \n";
    assert_eq(detect_language_from_content(sb5_ws, strlen(sb5_ws)),
              0, "content: #! followed only by whitespace -> 0");

    # Content sniff: `<?xml` and `<!DOCTYPE html` signatures after BOM strip.
    var sig_xml = "<?xml version=\"1.0\"?>\n<root/>\n";
    assert_streq(detect_language_from_content(sig_xml, strlen(sig_xml)),
                 "xml", "content: <?xml signature");

    var sig_html = "<!DOCTYPE html>\n<html>\n</html>\n";
    assert_streq(detect_language_from_content(sig_html, strlen(sig_html)),
                 "html", "content: <!DOCTYPE html signature");

    var sig_html_lc = "<!doctype html>\n";
    assert_streq(detect_language_from_content(sig_html_lc, strlen(sig_html_lc)),
                 "html", "content: <!doctype html (lowercase)");

    var sig_xml_doctype = "<!DOCTYPE book SYSTEM \"book.dtd\">\n";
    assert_streq(detect_language_from_content(sig_xml_doctype, strlen(sig_xml_doctype)),
                 "xml", "content: non-html doctype -> xml");

    # BOM strip — `\xEF\xBB\xBF` UTF-8 BOM before `<?xml`.
    var sig_bom_xml = alloc(64);
    store8(sig_bom_xml,     239);
    store8(sig_bom_xml + 1, 187);
    store8(sig_bom_xml + 2, 191);
    store8(sig_bom_xml + 3, 60);   # '<'
    store8(sig_bom_xml + 4, 63);   # '?'
    store8(sig_bom_xml + 5, 120);  # 'x'
    store8(sig_bom_xml + 6, 109);  # 'm'
    store8(sig_bom_xml + 7, 108);  # 'l'
    store8(sig_bom_xml + 8, 0);
    assert_streq(detect_language_from_content(sig_bom_xml, 8),
                 "xml", "content: BOM-prefixed <?xml -> xml");

    # Empty / minimal content — no shebang, no signature.
    assert_eq(detect_language_from_content("", 0),
              0, "content: empty -> 0");
    assert_eq(detect_language_from_content("hello\n", 6),
              0, "content: plain text -> 0");

    # Combined: path wins for unambiguous extensions.
    assert_streq(detect_language_combined("foo.py", "garbage", 7),
                 "python", "combined: .py wins over content");

    # Combined: extensionless file falls through to content.
    assert_streq(detect_language_combined("script", sb_py, strlen(sb_py)),
                 "python", "combined: extensionless + python shebang");

    # Combined: `.s` triggers asm flavour vote.
    var asm_x86 = ".intel_syntax noprefix\nmov rax, 1\nmov rdi, 0\nsyscall\n";
    assert_streq(detect_language_combined("foo.s", asm_x86, strlen(asm_x86)),
                 "asm_x86_64", "combined: .s + intel_syntax/rax -> x86_64");

    var asm_arm = ".arch armv8-a\nmov x0, #0\nbl exit\nldp x29, x30, [sp]\n";
    assert_streq(detect_language_combined("foo.s", asm_arm, strlen(asm_arm)),
                 "asm_aarch64", "combined: .s + .arch armv8/x0/bl/ldp -> aarch64");

    # Combined: `.s` with no signals falls back to x86_64 default.
    var asm_neutral = "; just a label\nmain:\n  ret\n";
    assert_streq(detect_language_combined("foo.s", asm_neutral, strlen(asm_neutral)),
                 "asm_x86_64", "combined: .s with no asm signals -> x86_64 default");

    # Combined: `.S` extension also triggers flavour vote.
    assert_streq(detect_language_combined("foo.S", asm_arm, strlen(asm_arm)),
                 "asm_aarch64", "combined: .S + arm signals -> aarch64");

    test_group("1.12.0 stress — pathological backtracking and nested compose");

    # 1. Unbalanced pair openers — runaway `/* …` with no `*/`,
    # runaway `"…` with no closing quote. Scanner should consume
    # to EOF and emit one big token, not loop forever.
    var st_runaway_block = "/* this never closes and contains no terminator at all just bytes";
    var tb_st1 = tokenbuf_new();
    var gc_st = registry_find_by_name("c");
    if (gc_st == 0) {
        # Bootstrap if needed (test order may not have visited c yet).
        gc_st = grammar_load("grammars/c.cyml");
        registry_add(gc_st);
    }
    tokenize_with_grammar(gc_st, st_runaway_block, strlen(st_runaway_block), tb_st1);
    assert(tokenbuf_count(tb_st1) >= 1, "runaway block comment: at least one token");
    var sum_st1 = 0;
    var st1i = 0;
    while (st1i < tokenbuf_count(tb_st1)) {
        sum_st1 = sum_st1 + tokenbuf_len(tb_st1, st1i);
        st1i = st1i + 1;
    }
    assert_eq(sum_st1, strlen(st_runaway_block), "runaway block comment: coverage holds");

    var st_runaway_str = "\"runaway string with no closing quote at all";
    var tb_st2 = tokenbuf_new();
    tokenize_with_grammar(gc_st, st_runaway_str, strlen(st_runaway_str), tb_st2);
    var sum_st2 = 0;
    var st2i = 0;
    while (st2i < tokenbuf_count(tb_st2)) {
        sum_st2 = sum_st2 + tokenbuf_len(tb_st2, st2i);
        st2i = st2i + 1;
    }
    assert_eq(sum_st2, strlen(st_runaway_str), "runaway string: coverage holds");

    # 2. Block-comment soup — overlapping `/* */ /* */` patterns
    # that have caught greedy matchers in other tokenizers.
    var st_soup = "/*/*/*/* nested-looking but really linear */ */ */ */";
    var tb_st3 = tokenbuf_new();
    tokenize_with_grammar(gc_st, st_soup, strlen(st_soup), tb_st3);
    var sum_st3 = 0;
    var st3i = 0;
    while (st3i < tokenbuf_count(tb_st3)) {
        sum_st3 = sum_st3 + tokenbuf_len(tb_st3, st3i);
        st3i = st3i + 1;
    }
    assert_eq(sum_st3, strlen(st_soup), "block-comment soup: coverage holds");

    # 3. Broken UTF-8 mid-ident. Continuation byte (0x80) without
    # a leading byte must not crash; falls through to TK_ERROR or
    # TK_OPERATOR depending on grammar but coverage still holds.
    var st_bad_utf8 = alloc(64);
    store8(st_bad_utf8,      102);   # 'f'
    store8(st_bad_utf8 + 1,  111);   # 'o'
    store8(st_bad_utf8 + 2,  111);   # 'o'
    store8(st_bad_utf8 + 3,  128);   # 0x80 — UTF-8 continuation, no lead byte
    store8(st_bad_utf8 + 4,  98);    # 'b'
    store8(st_bad_utf8 + 5,  97);    # 'a'
    store8(st_bad_utf8 + 6,  114);   # 'r'
    store8(st_bad_utf8 + 7,  0);
    var tb_st4 = tokenbuf_new();
    tokenize_with_grammar(gc_st, st_bad_utf8, 7, tb_st4);
    var sum_st4 = 0;
    var st4i = 0;
    while (st4i < tokenbuf_count(tb_st4)) {
        sum_st4 = sum_st4 + tokenbuf_len(tb_st4, st4i);
        st4i = st4i + 1;
    }
    assert_eq(sum_st4, 7, "broken UTF-8 mid-ident: coverage holds");

    # 4. Mismatched compose markers — `<style>` opener, no
    # `</style>` closer. The compose handler must fall through to
    # the regular HTML scanner for the body bytes (graceful
    # degradation). Coverage still holds.
    var st_unclosed_compose = "<style>body { color: red ;";
    var tb_st5 = tokenbuf_new();
    var ghtml_st = registry_find_by_name("html");
    if (ghtml_st == 0) {
        ghtml_st = grammar_load("grammars/html.cyml");
        registry_add(ghtml_st);
    }
    tokenize_with_grammar(ghtml_st, st_unclosed_compose, strlen(st_unclosed_compose), tb_st5);
    var sum_st5 = 0;
    var st5i = 0;
    while (st5i < tokenbuf_count(tb_st5)) {
        sum_st5 = sum_st5 + tokenbuf_len(tb_st5, st5i);
        st5i = st5i + 1;
    }
    assert_eq(sum_st5, strlen(st_unclosed_compose),
              "unclosed <style> compose: coverage holds");

    # 5. Deeply nested compose. Build "<style></style><style></style>...":
    # six adjacent compose blocks. Verifies the recursive call in
    # _ds_try_compose_rules is bounded — not a tail call but shallow
    # enough to never blow stack on real content. Coverage still
    # holds across all of it.
    var st_deep = "<style></style><style></style><style></style><style></style><style></style><style></style>";
    var tb_st6 = tokenbuf_new();
    tokenize_with_grammar(ghtml_st, st_deep, strlen(st_deep), tb_st6);
    var sum_st6 = 0;
    var st6i = 0;
    while (st6i < tokenbuf_count(tb_st6)) {
        sum_st6 = sum_st6 + tokenbuf_len(tb_st6, st6i);
        st6i = st6i + 1;
    }
    assert_eq(sum_st6, strlen(st_deep), "6× repeated compose: coverage holds");
    # Each `<style>` and `</style>` are length-7/8 punctuation
    # markers; with 6 of each we must see at least 12 marker-class
    # tokens.
    var marker_count = 0;
    var st6j = 0;
    while (st6j < tokenbuf_count(tb_st6)) {
        var tklen = tokenbuf_len(tb_st6, st6j);
        if ((tklen == 7) || (tklen == 8)) {
            if (tokenbuf_kind(tb_st6, st6j) == TK_PUNCTUATION) {
                marker_count = marker_count + 1;
            }
        }
        st6j = st6j + 1;
    }
    assert(marker_count >= 12, "6× compose: at least 12 marker tokens");

    # 6. Long single-line input — 4KB of repeated `a`'s. Tokenizer
    # must not hit any quadratic behaviour on long ident runs.
    var st_long = alloc(4096);
    var lk = 0;
    while (lk < 4000) {
        store8(st_long + lk, 97);   # 'a'
        lk = lk + 1;
    }
    store8(st_long + 4000, 0);
    var tb_st7 = tokenbuf_new();
    tokenize_with_grammar(gc_st, st_long, 4000, tb_st7);
    assert_eq(tokenbuf_count(tb_st7), 1, "4KB ident run: one token");
    assert_eq(tokenbuf_len(tb_st7, 0), 4000, "4KB ident run: span covers everything");

    test_group("1.13.2 markdown fence routing (ADR 0016)");

    var gmd2 = registry_find_by_name("markdown");
    if (gmd2 == 0) {
        gmd2 = grammar_load("grammars/markdown.cyml");
        registry_add(gmd2);
    }
    assert_neq(gmd2, 0, "markdown grammar reloads with compose_fenced");

    # Make sure rust + python grammars are resolvable so the
    # captured tags route correctly.
    var grust2 = registry_find_by_name("rust");
    if (grust2 == 0) {
        grust2 = grammar_load("grammars/rust.cyml");
        registry_add(grust2);
    }
    var gpy2 = registry_find_by_name("python");
    if (gpy2 == 0) {
        gpy2 = grammar_load("grammars/python.cyml");
        registry_add(gpy2);
    }

    # Rust fence: body should produce a TK_KEYWORD for `fn` and
    # `let` (rust-grammar specific). Coverage holds.
    var tb_f1 = tokenbuf_new();
    var src_f1 = "```rust\nfn f() { let x = 1; }\n```";
    tokenize_with_grammar(gmd2, src_f1, strlen(src_f1), tb_f1);
    var saw_fn_kw = 0;
    var f1i = 0;
    while (f1i < tokenbuf_count(tb_f1)) {
        if (tokenbuf_kind(tb_f1, f1i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_f1, f1i) == 2) { saw_fn_kw = 1; }
        }
        f1i = f1i + 1;
    }
    assert_eq(saw_fn_kw, 1, "```rust body: fn keyword present");
    assert_eq(tokenbuf_kind(tb_f1, 0), TK_PUNCTUATION,
              "```rust: open marker is punctuation");
    var f1_last = tokenbuf_count(tb_f1) - 1;
    assert_eq(tokenbuf_kind(tb_f1, f1_last), TK_PUNCTUATION,
              "```rust: close marker is punctuation");
    var sum_f1 = 0;
    var f1k = 0;
    while (f1k < tokenbuf_count(tb_f1)) {
        sum_f1 = sum_f1 + tokenbuf_len(tb_f1, f1k);
        f1k = f1k + 1;
    }
    assert_eq(sum_f1, strlen(src_f1), "```rust: coverage holds");

    # Python fence: body should produce TK_KEYWORD for `def`.
    var tb_f2 = tokenbuf_new();
    var src_f2 = "```python\ndef foo(): pass\n```";
    tokenize_with_grammar(gmd2, src_f2, strlen(src_f2), tb_f2);
    var saw_def_kw = 0;
    var f2i = 0;
    while (f2i < tokenbuf_count(tb_f2)) {
        if (tokenbuf_kind(tb_f2, f2i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_f2, f2i) == 3) { saw_def_kw = 1; }
        }
        f2i = f2i + 1;
    }
    assert_eq(saw_def_kw, 1, "```python body: def keyword present");

    # Unknown tag: body falls back to one TK_STRING.
    var tb_f3 = tokenbuf_new();
    var src_f3 = "```bogus\nplain body\n```";
    tokenize_with_grammar(gmd2, src_f3, strlen(src_f3), tb_f3);
    assert_eq(tokenbuf_count(tb_f3), 3,
              "unknown tag: open + body + close (3 tokens)");
    assert_eq(tokenbuf_kind(tb_f3, 1), TK_STRING,
              "unknown tag: body falls back to TK_STRING");
    var sum_f3 = 0;
    var f3k = 0;
    while (f3k < tokenbuf_count(tb_f3)) {
        sum_f3 = sum_f3 + tokenbuf_len(tb_f3, f3k);
        f3k = f3k + 1;
    }
    assert_eq(sum_f3, strlen(src_f3), "unknown tag: coverage holds");

    # Empty tag (info string is just LF): body falls back too.
    var tb_f4 = tokenbuf_new();
    var src_f4 = "```\nx + y\n```";
    tokenize_with_grammar(gmd2, src_f4, strlen(src_f4), tb_f4);
    assert_eq(tokenbuf_count(tb_f4), 3,
              "empty tag: open + body + close");
    assert_eq(tokenbuf_kind(tb_f4, 1), TK_STRING,
              "empty tag: body is TK_STRING");

    # Unclosed fence: compose_fenced returns 0; outer pipeline
    # tokenizes normally. Coverage still holds.
    var tb_f5 = tokenbuf_new();
    var src_f5 = "```rust\nlet x = 1;\nno closer ever\n";
    tokenize_with_grammar(gmd2, src_f5, strlen(src_f5), tb_f5);
    var sum_f5 = 0;
    var f5k = 0;
    while (f5k < tokenbuf_count(tb_f5)) {
        sum_f5 = sum_f5 + tokenbuf_len(tb_f5, f5k);
        f5k = f5k + 1;
    }
    assert_eq(sum_f5, strlen(src_f5),
              "unclosed fence: coverage holds via fall-through");

    # Tag with hyphen / digits — info-string accepts [A-Za-z0-9_+-]
    # so `c++` and `python3` etc. parse cleanly. `c++` is not a
    # registered grammar so falls back to TK_STRING; what we're
    # verifying is the tag-scanner doesn't choke on `+`.
    var tb_f6 = tokenbuf_new();
    var src_f6 = "```c++\nint x = 1;\n```";
    tokenize_with_grammar(gmd2, src_f6, strlen(src_f6), tb_f6);
    var sum_f6 = 0;
    var f6k = 0;
    while (f6k < tokenbuf_count(tb_f6)) {
        sum_f6 = sum_f6 + tokenbuf_len(tb_f6, f6k);
        f6k = f6k + 1;
    }
    assert_eq(sum_f6, strlen(src_f6), "c++ tag: coverage holds");

    test_group("2.0.0 streaming primitive — push-based API");

    # Single-chunk feed (the 1.x equivalent path).
    var s1 = tokenize_stream_new("shell");
    assert_neq(s1, 0, "stream_new returns non-null for known grammar");
    var tb_str1 = tokenbuf_new();
    var src_str1 = "echo hello";
    var fr1 = tokenize_stream_feed(s1, src_str1, strlen(src_str1));
    assert_eq(fr1, 0, "feed returns VYK_OK on single chunk");
    # 2.0.1: drain emits tokens for completed prefixes. For
    # "echo hello" the trailing "hello" ident reaches buf_len so
    # it's held back; "echo" + space commit early.
    var drained1 = tokenize_stream_drain(s1, tb_str1);
    assert(drained1 > 0,
           "2.0.1 drain: emits tokens for completed prefix");
    var fin1 = tokenize_stream_finish(s1, tb_str1);
    assert(fin1 > 0, "finish drains the remaining trailing token");
    var sum_s1 = tb_coverage_sum(tb_str1);
    assert_eq(sum_s1, strlen(src_str1),
              "single-chunk: coverage invariant holds");
    tokenize_stream_free(s1);

    # Multi-chunk feed — splitting `echo hello` across three feeds
    # must produce the same tokens as a single feed (the buffer
    # is concatenated under the hood in 2.0.0; that contract
    # holds regardless of chunking strategy).
    var s2 = tokenize_stream_new("shell");
    var tb_str2 = tokenbuf_new();
    tokenize_stream_feed(s2, "ec", 2);
    tokenize_stream_feed(s2, "ho ", 3);
    tokenize_stream_feed(s2, "hello", 5);
    tokenize_stream_finish(s2, tb_str2);
    tokenize_stream_free(s2);
    assert_eq(tokenbuf_count(tb_str2), tokenbuf_count(tb_str1),
              "multi-chunk: same token count as single-chunk");
    var sum_s2 = tb_coverage_sum(tb_str2);
    assert_eq(sum_s2, 10, "multi-chunk: coverage invariant holds");

    # Unknown grammar → stream_new returns 0.
    var s3 = tokenize_stream_new("nonesuch");
    assert_eq(s3, 0, "stream_new returns 0 for unknown grammar");

    # Empty grammar name → stream_new returns 0.
    var s4 = tokenize_stream_new("");
    assert_eq(s4, 0, "stream_new returns 0 for empty grammar name");

    # Feed-after-finish returns VYK_ERR_FINISHED (-2).
    var s5 = tokenize_stream_new("shell");
    var tb_s5 = tokenbuf_new();
    tokenize_stream_feed(s5, "x", 1);
    tokenize_stream_finish(s5, tb_s5);
    var fr5 = tokenize_stream_feed(s5, "y", 1);
    assert_eq(fr5, (0 - 2), "feed-after-finish returns VYK_ERR_FINISHED");
    tokenize_stream_free(s5);

    # Empty input — finish drains 0 tokens.
    var s6 = tokenize_stream_new("shell");
    var tb_s6 = tokenbuf_new();
    var fin6 = tokenize_stream_finish(s6, tb_s6);
    assert_eq(fin6, 0, "empty input: finish drains 0 tokens");
    assert_eq(tokenbuf_count(tb_s6), 0, "empty input: empty tokenbuf");
    tokenize_stream_free(s6);

    # Drain after finish is a no-op (already drained).
    var s7 = tokenize_stream_new("shell");
    var tb_s7 = tokenbuf_new();
    tokenize_stream_feed(s7, "echo x", 6);
    tokenize_stream_finish(s7, tb_s7);
    var second_drain = tokenize_stream_drain(s7, tb_s7);
    assert_eq(second_drain, 0,
              "drain after finish returns 0 (idempotent)");
    tokenize_stream_free(s7);

    # Chunk feed must match a one-shot feed byte-for-byte across
    # token boundaries — pick a multi-line shell snippet so chunks
    # span comments / strings / keywords.
    var src_big = "if [[ $x -eq 42 ]]; then\n  echo \"hi $x\"\nfi";
    var n_big = strlen(src_big);
    var s8 = tokenize_stream_new("shell");
    var tb_one = tokenbuf_new();
    tokenize_stream_feed(s8, src_big, n_big);
    tokenize_stream_finish(s8, tb_one);
    tokenize_stream_free(s8);

    var s9 = tokenize_stream_new("shell");
    var tb_split = tokenbuf_new();
    var split_at = 13;
    tokenize_stream_feed(s9, src_big, split_at);
    tokenize_stream_feed(s9, src_big + split_at, n_big - split_at);
    tokenize_stream_finish(s9, tb_split);
    tokenize_stream_free(s9);

    assert_eq(tokenbuf_count(tb_split), tokenbuf_count(tb_one),
              "split feed: same count as one-shot");
    var idx = 0;
    var same_kinds = 1;
    while (idx < tokenbuf_count(tb_one)) {
        if (tokenbuf_kind(tb_one, idx) != tokenbuf_kind(tb_split, idx)) {
            same_kinds = 0;
        }
        if (tokenbuf_start(tb_one, idx) != tokenbuf_start(tb_split, idx)) {
            same_kinds = 0;
        }
        if (tokenbuf_len(tb_one, idx) != tokenbuf_len(tb_split, idx)) {
            same_kinds = 0;
        }
        idx = idx + 1;
    }
    assert_eq(same_kinds, 1,
              "split feed: every (kind, start, len) matches one-shot");

    test_group("2.0.1 rolling-buffer streaming — per-feed drainage");

    # feed → drain → feed → drain → finish.  Each drain commits
    # everything except the trailing partial token; that partial
    # is re-scanned after the next feed appends more bytes.
    var sr1 = tokenize_stream_new("shell");
    var tb_sr1 = tokenbuf_new();
    tokenize_stream_feed(sr1, "echo ", 5);
    var d1 = tokenize_stream_drain(sr1, tb_sr1);
    assert(d1 > 0,
           "drain 1: at least one token committed (`echo`)");
    # Token starts must be absolute (cumulative bytes since
    # stream creation), not relative to whatever buf_ptr is
    # holding now.
    assert_eq(tokenbuf_start(tb_sr1, 0), 0,
              "first token's start is 0 (absolute)");
    tokenize_stream_feed(sr1, "hi", 2);
    tokenize_stream_finish(sr1, tb_sr1);
    var sum_r1 = tb_coverage_sum(tb_sr1);
    assert_eq(sum_r1, 7, "rolling-buffer: coverage invariant holds (5+2)");
    # Last token's absolute start must reflect prior compaction —
    # `hi` lives at absolute offset 5, not at a buffer-relative 0.
    var last_r1 = tokenbuf_count(tb_sr1) - 1;
    assert(tokenbuf_start(tb_sr1, last_r1) >= 5,
           "last token start reflects abs_offset (post-compaction)");
    tokenize_stream_free(sr1);

    # Block comment crossing a feed boundary — string-pair rules
    # must wait for the closing marker. Feeding `/* hello ` then
    # `world */` should NOT commit the open marker until the
    # close arrives.
    var sr2 = tokenize_stream_new("c");
    var tb_sr2 = tokenbuf_new();
    tokenize_stream_feed(sr2, "/* hello ", 9);
    var d2a = tokenize_stream_drain(sr2, tb_sr2);
    assert_eq(d2a, 0,
              "block comment open: no tokens committed yet");
    tokenize_stream_feed(sr2, "world */", 8);
    var d2b = tokenize_stream_drain(sr2, tb_sr2);
    assert(d2b >= 1,
           "after close arrives: comment commits");
    tokenize_stream_finish(sr2, tb_sr2);
    var sum_r2 = tb_coverage_sum(tb_sr2);
    assert_eq(sum_r2, 17,
              "cross-boundary block comment: coverage holds (9+8)");
    # The first token MUST be the comment, not three separate
    # tokens emitted prematurely.
    assert_eq(tokenbuf_kind(tb_sr2, 0), TK_COMMENT,
              "cross-boundary: token is one TK_COMMENT");
    assert_eq(tokenbuf_len(tb_sr2, 0), 17,
              "cross-boundary: comment spans the full 17 bytes");
    tokenize_stream_free(sr2);

    # Many small feeds — streaming-style. Each byte arrives in a
    # separate feed; drains in between commit whatever is now
    # complete. End result must equal a single-shot tokenize.
    var src_drip = "if [[ -d /tmp ]]; then echo ok; fi";
    var n_drip = strlen(src_drip);
    var sr3 = tokenize_stream_new("shell");
    var tb_sr3 = tokenbuf_new();
    var bi = 0;
    while (bi < n_drip) {
        tokenize_stream_feed(sr3, src_drip + bi, 1);
        tokenize_stream_drain(sr3, tb_sr3);
        bi = bi + 1;
    }
    tokenize_stream_finish(sr3, tb_sr3);
    var sum_r3 = tb_coverage_sum(tb_sr3);
    assert_eq(sum_r3, n_drip,
              "byte-at-a-time stream: coverage holds");
    tokenize_stream_free(sr3);

    # Confirm token list matches a single-shot baseline.
    var sr_base = tokenize_stream_new("shell");
    var tb_base = tokenbuf_new();
    tokenize_stream_feed(sr_base, src_drip, n_drip);
    tokenize_stream_finish(sr_base, tb_base);
    tokenize_stream_free(sr_base);
    assert_eq(tokenbuf_count(tb_sr3), tokenbuf_count(tb_base),
              "byte-at-a-time vs single-shot: same token count");
    var bk = 0;
    var byte_drip_match = 1;
    while (bk < tokenbuf_count(tb_base)) {
        if (tokenbuf_kind(tb_sr3, bk)  != tokenbuf_kind(tb_base, bk))  { byte_drip_match = 0; }
        if (tokenbuf_start(tb_sr3, bk) != tokenbuf_start(tb_base, bk)) { byte_drip_match = 0; }
        if (tokenbuf_len(tb_sr3, bk)   != tokenbuf_len(tb_base, bk))   { byte_drip_match = 0; }
        bk = bk + 1;
    }
    assert_eq(byte_drip_match, 1,
              "byte-at-a-time stream: every (kind, start, len) matches baseline");

    test_group("2.0.2 pull adapter — tokenize_stream_next");

    # Iterator pattern: feed → finish → iterate to EOF. Token
    # sequence must be identical to the push-API equivalent.
    var sp1 = tokenize_stream_new("shell");
    var src_pull = "echo hello";
    tokenize_stream_feed(sp1, src_pull, strlen(src_pull));
    tokenize_stream_finish(sp1, 0);
    var pull_count = 0;
    var pull_sum = 0;
    while (tokenize_stream_next(sp1) == 1) {
        pull_count = pull_count + 1;
        pull_sum = pull_sum + tokenize_stream_len(sp1);
    }
    assert(pull_count > 0, "pull adapter: at least one token");
    assert_eq(pull_sum, strlen(src_pull),
              "pull adapter: coverage invariant holds across iteration");

    # Compare against the push baseline.
    var sp_base = tokenize_stream_new("shell");
    var tb_pb = tokenbuf_new();
    tokenize_stream_feed(sp_base, src_pull, strlen(src_pull));
    tokenize_stream_finish(sp_base, tb_pb);
    tokenize_stream_free(sp_base);
    assert_eq(pull_count, tokenbuf_count(tb_pb),
              "pull adapter: same token count as push baseline");

    # Read the first token via accessors and verify it matches.
    var sp2 = tokenize_stream_new("shell");
    tokenize_stream_feed(sp2, src_pull, strlen(src_pull));
    tokenize_stream_finish(sp2, 0);
    tokenize_stream_next(sp2);
    assert_eq(tokenize_stream_kind(sp2), tokenbuf_kind(tb_pb, 0),
              "pull adapter: first token kind matches");
    assert_eq(tokenize_stream_start(sp2), tokenbuf_start(tb_pb, 0),
              "pull adapter: first token start matches");
    assert_eq(tokenize_stream_len(sp2), tokenbuf_len(tb_pb, 0),
              "pull adapter: first token len matches");
    tokenize_stream_free(sp2);
    tokenize_stream_free(sp1);

    # Interleaved feed + iterate (the streaming use case).
    # Push some bytes, drain through `_next` until exhausted,
    # push more, iterate again. Final tokens must match a
    # single-shot push.
    var sp_inter = tokenize_stream_new("shell");
    var ipart1 = "echo ";
    var ipart2 = "hello";
    tokenize_stream_feed(sp_inter, ipart1, strlen(ipart1));
    var inter_count_a = 0;
    while (tokenize_stream_next(sp_inter) == 1) {
        inter_count_a = inter_count_a + 1;
    }
    # After feed of "echo " in feed mode: drain commits "echo"
    # (whitespace held back as potentially-extending). next
    # returns 1 once, then 0. inter_count_a >= 0 (could be 0
    # if drain decided everything was partial — that's also
    # acceptable).
    tokenize_stream_feed(sp_inter, ipart2, strlen(ipart2));
    tokenize_stream_finish(sp_inter, 0);
    var inter_count_b = 0;
    var inter_sum = 0;
    while (tokenize_stream_next(sp_inter) == 1) {
        inter_count_b = inter_count_b + 1;
        inter_sum = inter_sum + tokenize_stream_len(sp_inter);
    }
    var total_inter = inter_count_a + inter_count_b;
    assert_eq(total_inter, tokenbuf_count(tb_pb),
              "interleaved pull: same total as push baseline");
    # Coverage requires summing both halves; compute partial sum
    # from the first batch (we lost those lens above).
    # Simpler check: re-iterate via push baseline after
    # exhaustion isn't possible; instead verify the total bytes
    # via the inter_sum + the bytes covered before mid-feed.
    # Since stream emits tokens in order with absolute offsets,
    # the last token's start + len must equal total input len.
    # `inter_sum` is the sum from the second half only —
    # combined coverage = strlen(ipart1)+strlen(ipart2)=10.
    # We don't have inter_sum_a saved, so just assert the
    # last token's end == total bytes (re-using sp_inter's
    # internal state isn't possible; we'll check via a fresh
    # stream).
    var sp_check = tokenize_stream_new("shell");
    tokenize_stream_feed(sp_check, "echo hello", 10);
    tokenize_stream_finish(sp_check, 0);
    var last_end = 0;
    while (tokenize_stream_next(sp_check) == 1) {
        last_end = tokenize_stream_start(sp_check) + tokenize_stream_len(sp_check);
    }
    assert_eq(last_end, 10,
              "pull adapter: last token's start+len equals total input");
    tokenize_stream_free(sp_check);
    tokenize_stream_free(sp_inter);

    # _next on a stream that hasn't seen any bytes returns 0.
    var sp_empty = tokenize_stream_new("shell");
    var n_empty = tokenize_stream_next(sp_empty);
    assert_eq(n_empty, 0, "pull adapter: empty stream returns 0");
    tokenize_stream_finish(sp_empty, 0);
    var n_empty_after = tokenize_stream_next(sp_empty);
    assert_eq(n_empty_after, 0,
              "pull adapter: empty stream after finish returns 0 (EOF)");
    tokenize_stream_free(sp_empty);

    # _next on null stream is safe (returns 0).
    var n_null = tokenize_stream_next(0);
    assert_eq(n_null, 0, "pull adapter: null stream returns 0");

    test_group("2.0.3 streaming optimization — pending pair-rule fast path");

    # A long block comment fed in 100 chunks across many drains.
    # Pre-2.0.3 each drain rescanned the growing partial body —
    # O(N²) total work. With pending-pair tracking the body is
    # scanned exactly once for the close marker. Functional
    # behaviour is unchanged: one TK_COMMENT spanning the full
    # span. Coverage holds.
    var sopt = tokenize_stream_new("c");
    var tb_opt = tokenbuf_new();
    tokenize_stream_feed(sopt, "/* ", 3);
    var chunk = "abcdefghij";   # 10 bytes; feed 100 times = 1000 bytes
    var ci = 0;
    while (ci < 100) {
        tokenize_stream_feed(sopt, chunk, strlen(chunk));
        tokenize_stream_drain(sopt, tb_opt);
        ci = ci + 1;
    }
    # Across all those drains, no tokens should commit (the
    # comment is still open). Pending-pair state should be set.
    assert_eq(tokenbuf_count(tb_opt), 0,
              "long open comment: nothing committed before close");
    # Now feed the close marker.
    tokenize_stream_feed(sopt, " */", 3);
    var d_opt = tokenize_stream_drain(sopt, tb_opt);
    assert(d_opt >= 1,
           "close marker arrives: pending-pair fast path emits comment");
    assert_eq(tokenbuf_kind(tb_opt, 0), TK_COMMENT,
              "fast-path emit: TK_COMMENT");
    # Token covers the full open + body + close.
    var expected_len = 3 + (100 * 10) + 3;
    assert_eq(tokenbuf_len(tb_opt, 0), expected_len,
              "fast-path emit: comment spans the full 1006 bytes");
    tokenize_stream_finish(sopt, tb_opt);
    tokenize_stream_free(sopt);

    # Close marker straddling two feeds — `*` in feed N, `/` in
    # feed N+1. The scan_resume back-off (elen-1 = 1 byte) must
    # ensure the close is found. Without the back-off this
    # would miss the close.
    var sopt2 = tokenize_stream_new("c");
    var tb_opt2 = tokenbuf_new();
    tokenize_stream_feed(sopt2, "/* hello *", 10);
    tokenize_stream_drain(sopt2, tb_opt2);
    tokenize_stream_feed(sopt2, "/", 1);
    tokenize_stream_drain(sopt2, tb_opt2);
    tokenize_stream_finish(sopt2, tb_opt2);
    var sum_opt2 = tb_coverage_sum(tb_opt2);
    assert_eq(sum_opt2, 11,
              "straddling close marker: coverage holds (10+1)");
    assert_eq(tokenbuf_kind(tb_opt2, 0), TK_COMMENT,
              "straddling close: token is one TK_COMMENT");
    assert_eq(tokenbuf_len(tb_opt2, 0), 11,
              "straddling close: comment spans the full 11 bytes");
    tokenize_stream_free(sopt2);

    # Pending state must clear after the close — subsequent
    # tokens (post-comment idents, etc.) tokenize normally.
    var sopt3 = tokenize_stream_new("c");
    var tb_opt3 = tokenbuf_new();
    tokenize_stream_feed(sopt3, "/* x */ ident", 13);
    tokenize_stream_finish(sopt3, tb_opt3);
    # Expected: TK_COMMENT + TK_WHITESPACE + TK_IDENT.
    assert(tokenbuf_count(tb_opt3) >= 3,
           "post-comment tail: at least 3 tokens (comment, ws, ident)");
    var sum_opt3 = tb_coverage_sum(tb_opt3);
    assert_eq(sum_opt3, 13, "post-comment tail: coverage holds");
    tokenize_stream_free(sopt3);

    test_group("2.1.0 PowerShell grammar — basic shapes");

    var tb_ps1 = _t_tokenize("Get-Process -Name pwsh", "powershell");
    assert_neq(tb_ps1, 0, "powershell grammar loads");
    # `Get-Process` must tokenize as ONE TK_IDENT — `-` is in
    # ident_cont specifically to capture cmdlet names.
    assert_eq(tokenbuf_kind(tb_ps1, 0), TK_IDENT,
              "Get-Process: kind = ident");
    assert_eq(tokenbuf_len(tb_ps1, 0), 11,
              "Get-Process: one 11-byte ident");

    var tb_ps2 = _t_tokenize("if ($x -eq 5) { 'yes' }", "powershell");
    # `-eq` after whitespace must tokenize as TK_OPERATOR (3 bytes).
    var saw_eq = 0;
    var ps2_i = 0;
    while (ps2_i < tokenbuf_count(tb_ps2)) {
        if (tokenbuf_kind(tb_ps2, ps2_i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_ps2, ps2_i) == 3) { saw_eq = 1; }
        }
        ps2_i = ps2_i + 1;
    }
    assert_eq(saw_eq, 1, "powershell: -eq tokenizes as 3-byte operator");

    var tb_ps3 = _t_tokenize("$args", "powershell");
    # `$args` is one ident — `$` in ident_start.
    assert_eq(tokenbuf_kind(tb_ps3, 0), TK_IDENT,
              "$args: kind = ident");
    assert_eq(tokenbuf_len(tb_ps3, 0), 5,
              "$args: 5-byte ident");

    var tb_ps4 = _t_tokenize("<# block #>", "powershell");
    # `<# ... #>` block comment.
    assert_eq(tokenbuf_count(tb_ps4), 1,
              "<# #>: one block comment token");
    assert_eq(tokenbuf_kind(tb_ps4, 0), TK_COMMENT,
              "<# #>: kind = comment");

    test_group("2.1.0 Crystal grammar — basic shapes");

    var tb_cr1 = _t_tokenize("def empty?(arr) ; arr.size == 0 ; end", "crystal");
    assert_neq(tb_cr1, 0, "crystal grammar loads");
    # `def` is keyword. `empty?` is one ident (`?` in ident_cont).
    assert_eq(tokenbuf_kind(tb_cr1, 0), TK_KEYWORD,
              "crystal def: kind = keyword");
    var saw_predicate = 0;
    var cr1_i = 0;
    while (cr1_i < tokenbuf_count(tb_cr1)) {
        if (tokenbuf_kind(tb_cr1, cr1_i) == TK_IDENT) {
            if (tokenbuf_len(tb_cr1, cr1_i) == 6) { saw_predicate = 1; }
        }
        cr1_i = cr1_i + 1;
    }
    assert_eq(saw_predicate, 1,
              "crystal: empty? is a 6-byte ident (? in ident_cont)");

    var tb_cr2 = _t_tokenize("@count = 0", "crystal");
    # `@count` is one ident — `@` in ident_start (instance var).
    assert_eq(tokenbuf_kind(tb_cr2, 0), TK_IDENT,
              "crystal @count: kind = ident");
    assert_eq(tokenbuf_len(tb_cr2, 0), 6,
              "crystal @count: 6-byte ident");

    test_group("2.1.0 Julia grammar — basic shapes");

    var tb_jl1 = _t_tokenize("function add(x::Int, y::Int) end", "julia");
    assert_neq(tb_jl1, 0, "julia grammar loads");
    assert_eq(tokenbuf_kind(tb_jl1, 0), TK_KEYWORD,
              "julia function: kind = keyword");
    # The code has two `::` type-annotation operators.
    var two_byte_ops = 0;
    var jl1_j = 0;
    while (jl1_j < tokenbuf_count(tb_jl1)) {
        if (tokenbuf_kind(tb_jl1, jl1_j) == TK_OPERATOR) {
            if (tokenbuf_len(tb_jl1, jl1_j) == 2) {
                two_byte_ops = two_byte_ops + 1;
            }
        }
        jl1_j = jl1_j + 1;
    }
    assert(two_byte_ops >= 2, "julia: at least two `::` operators");

    var tb_jl2 = _t_tokenize("@time push!(arr, 1)", "julia");
    # `@time` is one ident (macro). `push!` is one ident
    # (`!` in ident_cont).
    assert_eq(tokenbuf_kind(tb_jl2, 0), TK_IDENT,
              "julia @time: kind = ident");
    assert_eq(tokenbuf_len(tb_jl2, 0), 5,
              "julia @time: 5-byte ident");
    var saw_mutating = 0;
    var jl2_i = 0;
    while (jl2_i < tokenbuf_count(tb_jl2)) {
        if (tokenbuf_kind(tb_jl2, jl2_i) == TK_IDENT) {
            if (tokenbuf_len(tb_jl2, jl2_i) == 5) {
                # Could be @time or push! — count both.
                saw_mutating = saw_mutating + 1;
            }
        }
        jl2_i = jl2_i + 1;
    }
    assert(saw_mutating >= 2,
           "julia: both @time and push! are 5-byte idents");

    var tb_jl3 = _t_tokenize("\"\"\"multi\nline\"\"\"", "julia");
    # Triple-quoted string is one TK_STRING.
    assert_eq(tokenbuf_count(tb_jl3), 1,
              "julia triple-quote: one token");
    assert_eq(tokenbuf_kind(tb_jl3, 0), TK_STRING,
              "julia triple-quote: kind = string");

    test_group("2.1.1 Vue / Svelte SFC grammars — compose routing");

    # Vue: `<script>` body must produce a JS keyword.
    var tb_vue1 = _t_tokenize("<script>const x = 1;</script>", "vue");
    assert_neq(tb_vue1, 0, "vue grammar loads");
    var saw_const = 0;
    var v1i = 0;
    while (v1i < tokenbuf_count(tb_vue1)) {
        if (tokenbuf_kind(tb_vue1, v1i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_vue1, v1i) == 5) { saw_const = 1; }
        }
        v1i = v1i + 1;
    }
    assert_eq(saw_const, 1, "vue <script>: const is JS keyword");

    # Vue: `<style>` body produces CSS-style tokens — color hex
    # `#FF6600` is one ident in CSS (because `#` is in CSS's
    # ident_start). Without compose routing it would be `#` op
    # + `FF6600` ident.
    var tb_vue2 = _t_tokenize("<style>.x{color:#FF6600;}</style>", "vue");
    var saw_hex = 0;
    var v2i = 0;
    while (v2i < tokenbuf_count(tb_vue2)) {
        if (tokenbuf_kind(tb_vue2, v2i) == TK_IDENT) {
            if (tokenbuf_len(tb_vue2, v2i) == 7) { saw_hex = 1; }
        }
        v2i = v2i + 1;
    }
    assert_eq(saw_hex, 1, "vue <style>: #FF6600 is one CSS ident");

    # Vue: `@click` in template tokenizes as `@` op + `click`
    # ident. Outer Vue tokenizer (NOT routed through html).
    var tb_vue3 = _t_tokenize("@click", "vue");
    assert_eq(tokenbuf_kind(tb_vue3, 0), TK_OPERATOR,
              "vue @click: @ is operator");
    assert_eq(tokenbuf_len(tb_vue3, 0), 1, "vue @click: @ is 1 byte");
    assert_eq(tokenbuf_kind(tb_vue3, 1), TK_IDENT,
              "vue @click: click is ident");

    # Svelte: same script routing.
    var tb_svel1 = _t_tokenize("<script>let x = 1;</script>", "svelte");
    assert_neq(tb_svel1, 0, "svelte grammar loads");
    var saw_let = 0;
    var sv1i = 0;
    while (sv1i < tokenbuf_count(tb_svel1)) {
        if (tokenbuf_kind(tb_svel1, sv1i) == TK_KEYWORD) {
            if (tokenbuf_len(tb_svel1, sv1i) == 3) { saw_let = 1; }
        }
        sv1i = sv1i + 1;
    }
    assert_eq(saw_let, 1, "svelte <script>: let is JS keyword");

    # Svelte: `bind:value` tokenizes as ident + `:` + ident.
    var tb_svel2 = _t_tokenize("bind:value", "svelte");
    assert_eq(tokenbuf_count(tb_svel2), 3,
              "svelte bind:value: 3 tokens");
    assert_eq(tokenbuf_kind(tb_svel2, 0), TK_IDENT,
              "svelte bind:value: bind is ident");
    assert_eq(tokenbuf_kind(tb_svel2, 1), TK_PUNCTUATION,
              "svelte bind:value: : is punct");
    assert_eq(tokenbuf_kind(tb_svel2, 2), TK_IDENT,
              "svelte bind:value: value is ident");

    test_group("2.1.2 Nix grammar — basic shapes");

    var tb_nix1 = _t_tokenize("let x = 1; in x + 1", "nix");
    assert_neq(tb_nix1, 0, "nix grammar loads");
    assert_eq(tokenbuf_kind(tb_nix1, 0), TK_KEYWORD,
              "nix `let`: kind = keyword");

    # `//` is set merge, NOT comment. Must longest-match before `/`.
    var tb_nix2 = _t_tokenize("a // b", "nix");
    var saw_merge = 0;
    var n2i = 0;
    while (n2i < tokenbuf_count(tb_nix2)) {
        if (tokenbuf_kind(tb_nix2, n2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_nix2, n2i) == 2) { saw_merge = 1; }
        }
        n2i = n2i + 1;
    }
    assert_eq(saw_merge, 1, "nix `//`: 2-byte set-merge operator");

    # `++` list concat; same longest-match path.
    var tb_nix3 = _t_tokenize("[1] ++ [2]", "nix");
    var saw_concat = 0;
    var n3i = 0;
    while (n3i < tokenbuf_count(tb_nix3)) {
        if (tokenbuf_kind(tb_nix3, n3i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_nix3, n3i) == 2) { saw_concat = 1; }
        }
        n3i = n3i + 1;
    }
    assert_eq(saw_concat, 1, "nix `++`: 2-byte list-concat operator");

    # Idents with `'` (Haskell-prime) — `iter'` is one ident.
    var tb_nix4 = _t_tokenize("iter' x", "nix");
    assert_eq(tokenbuf_kind(tb_nix4, 0), TK_IDENT,
              "nix `iter'`: kind = ident");
    assert_eq(tokenbuf_len(tb_nix4, 0), 5,
              "nix `iter'`: 5-byte ident (incl. apostrophe)");

    # Idents with `-` (kebab-case) — `home-manager` is one ident.
    var tb_nix5 = _t_tokenize("home-manager", "nix");
    assert_eq(tokenbuf_count(tb_nix5), 1,
              "nix `home-manager`: one token");
    assert_eq(tokenbuf_kind(tb_nix5, 0), TK_IDENT,
              "nix `home-manager`: kind = ident");
    assert_eq(tokenbuf_len(tb_nix5, 0), 12,
              "nix `home-manager`: 12-byte ident");

    # Indented string `''…''` — one TK_STRING token spanning the
    # full thing.
    var tb_nix6 = _t_tokenize("''hello''", "nix");
    assert_eq(tokenbuf_count(tb_nix6), 1,
              "nix `''hello''`: one token");
    assert_eq(tokenbuf_kind(tb_nix6, 0), TK_STRING,
              "nix `''hello''`: kind = string");

    test_group("2.1.3 Terraform / HCL grammar — basic shapes");

    var tb_tf1 = _t_tokenize("resource \"aws_s3_bucket\" \"x\" { }", "terraform");
    assert_neq(tb_tf1, 0, "terraform grammar loads");
    # First token must be `resource` ident.
    assert_eq(tokenbuf_kind(tb_tf1, 0), TK_IDENT,
              "tf resource: first token is ident");
    assert_eq(tokenbuf_len(tb_tf1, 0), 8,
              "tf resource: 8-byte ident");

    # Kebab-case via `-` in ident_cont — `aws-s3-bucket` (a
    # hypothetical kebab variant) is one ident.
    var tb_tf2 = _t_tokenize("my-bucket-name", "terraform");
    assert_eq(tokenbuf_count(tb_tf2), 1,
              "tf my-bucket-name: one token");
    assert_eq(tokenbuf_kind(tb_tf2, 0), TK_IDENT,
              "tf my-bucket-name: kind = ident");

    # Both `#` and `//` comment markers are valid in HCL.
    var tb_tf3 = _t_tokenize("# hash comment\n// slash comment\n", "terraform");
    var comment_count = 0;
    var t3i = 0;
    while (t3i < tokenbuf_count(tb_tf3)) {
        if (tokenbuf_kind(tb_tf3, t3i) == TK_COMMENT) {
            comment_count = comment_count + 1;
        }
        t3i = t3i + 1;
    }
    assert_eq(comment_count, 2,
              "tf comments: both `#` and `//` recognised");

    # `=>` for-expression operator (longest-match before `=`).
    var tb_tf4 = _t_tokenize("[for k, v in m: k => v]", "terraform");
    var saw_tf_arrow = 0;
    var t4i = 0;
    while (t4i < tokenbuf_count(tb_tf4)) {
        if (tokenbuf_kind(tb_tf4, t4i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_tf4, t4i) == 2) { saw_tf_arrow = 1; }
        }
        t4i = t4i + 1;
    }
    assert_eq(saw_tf_arrow, 1, "tf `=>`: 2-byte arrow operator");

    # `...` variadic / spread.
    var tb_tf5 = _t_tokenize("foo(args...)", "terraform");
    var saw_spread = 0;
    var t5i = 0;
    while (t5i < tokenbuf_count(tb_tf5)) {
        if (tokenbuf_kind(tb_tf5, t5i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_tf5, t5i) == 3) { saw_spread = 1; }
        }
        t5i = t5i + 1;
    }
    assert_eq(saw_spread, 1, "tf `...`: 3-byte spread operator");

    test_group("2.1.4 pull-adapter discard + streaming heuristic fix");

    # Discard-consumed: drops tokens already iterated past via
    # `_next`. Pre-2.1.4 the staging tokenbuf grew monotonically.
    var sd1 = tokenize_stream_new("shell");
    tokenize_stream_feed(sd1, "echo hello world", 16);
    tokenize_stream_finish(sd1, 0);

    # Iterate past 3 tokens, then discard.
    tokenize_stream_next(sd1);   # echo
    tokenize_stream_next(sd1);   # ws
    tokenize_stream_next(sd1);   # hello
    var dropped = tokenize_stream_discard_consumed(sd1);
    assert_eq(dropped, 3, "discard: returns count of dropped tokens");

    # `_next` still works — picks up where iteration left off.
    var n_after = tokenize_stream_next(sd1);
    assert_eq(n_after, 1,
              "discard: _next still advances after discard");

    # The total iterated (pre + post discard) plus the trailing
    # un-iterated count should equal the baseline token count.
    var post_discard_count = 1;   # the one we just _next'd
    while (tokenize_stream_next(sd1) == 1) {
        post_discard_count = post_discard_count + 1;
    }
    # echo + ws + hello + ws + world = 5 tokens. Iterated 3
    # before discard, then 1 explicitly tested above, then
    # remainder via the loop.
    assert_eq(3 + post_discard_count, 5,
              "discard: total iteration matches baseline count");
    tokenize_stream_free(sd1);

    # Discard with no tokens consumed is a no-op.
    var sd2 = tokenize_stream_new("shell");
    tokenize_stream_feed(sd2, "echo hi", 7);
    tokenize_stream_finish(sd2, 0);
    var d_noop = tokenize_stream_discard_consumed(sd2);
    assert_eq(d_noop, 0,
              "discard: no-op when nothing iterated yet");
    tokenize_stream_free(sd2);

    # Discard on null stream is safe.
    var d_null = tokenize_stream_discard_consumed(0);
    assert_eq(d_null, 0, "discard: null stream returns 0");

    # The streaming-fuzz-caught bug: opening `"` at chunk
    # boundary should NOT commit as a 1-byte string token.
    # The trailing-complete heuristic now requires
    # `t_len >= slen + elen` for pair-rule tokens.
    var sd3 = tokenize_stream_new("c");
    var tb_sd3 = tokenbuf_new();
    var src_sd3 = "char *s = \"hello\\nworld\";";
    var n_sd3 = strlen(src_sd3);
    # Split right after the opening `"` (byte 11).
    tokenize_stream_feed(sd3, src_sd3, 11);
    tokenize_stream_drain(sd3, tb_sd3);
    tokenize_stream_feed(sd3, src_sd3 + 11, n_sd3 - 11);
    tokenize_stream_finish(sd3, tb_sd3);
    tokenize_stream_free(sd3);

    # Baseline.
    var sd3_base = tokenize_stream_new("c");
    var tb_sd3_base = tokenbuf_new();
    tokenize_stream_feed(sd3_base, src_sd3, n_sd3);
    tokenize_stream_finish(sd3_base, tb_sd3_base);
    tokenize_stream_free(sd3_base);

    assert_eq(tokenbuf_count(tb_sd3), tokenbuf_count(tb_sd3_base),
              "split-after-opening-quote: same count as baseline");

    test_group("2.2.1 compose-rule prefix buffering (FINDING-011)");

    # Compose-rule chunk-boundary recognition. A chunk that
    # ends mid-marker (`<sty` of `<style>`, ` `` ` of `` ``` ``)
    # used to commit spurious tokens because the partial marker
    # fell through to other rules. The marker window holds those
    # bytes back (2.2.1–2.7.1: a prefix-hold helper did); the next
    # drain re-scans them against the full grammar. Asserts
    # equivalence vs single-shot tokenize at the trickiest splits.
    var ch_html_src = "<style>.x{color:red;}</style>";
    var ch_html_n = strlen(ch_html_src);

    # Baseline.
    var ch_html_base = tokenize_stream_new("html");
    var ch_html_tbb = tokenbuf_new();
    tokenize_stream_feed(ch_html_base, ch_html_src, ch_html_n);
    tokenize_stream_finish(ch_html_base, ch_html_tbb);
    tokenize_stream_free(ch_html_base);

    # Split mid-`<style>`: feed1 = "<sty" (4 bytes).
    var ch_html = tokenize_stream_new("html");
    var ch_html_tb = tokenbuf_new();
    tokenize_stream_feed(ch_html, ch_html_src, 4);
    tokenize_stream_drain(ch_html, ch_html_tb);
    tokenize_stream_feed(ch_html, ch_html_src + 4, ch_html_n - 4);
    tokenize_stream_finish(ch_html, ch_html_tb);
    tokenize_stream_free(ch_html);
    assert_eq(tokenbuf_count(ch_html_tb), tokenbuf_count(ch_html_tbb),
              "html mid-`<style>` split: token count matches baseline");

    # Markdown — open and close are both `` ``` ``; a split two
    # backticks into the opener must not commit them as inline
    # code (the 2.8.0 trailing-complete marker-window guard).
    var ch_md_src = "before\n```rust\nfn x() {}\n```\nafter";
    var ch_md_n = strlen(ch_md_src);

    var ch_md_base = tokenize_stream_new("markdown");
    var ch_md_tbb = tokenbuf_new();
    tokenize_stream_feed(ch_md_base, ch_md_src, ch_md_n);
    tokenize_stream_finish(ch_md_base, ch_md_tbb);
    tokenize_stream_free(ch_md_base);

    # Split right after the second backtick (mid-marker).
    var ch_md = tokenize_stream_new("markdown");
    var ch_md_tb = tokenbuf_new();
    tokenize_stream_feed(ch_md, ch_md_src, 9);
    tokenize_stream_drain(ch_md, ch_md_tb);
    tokenize_stream_feed(ch_md, ch_md_src + 9, ch_md_n - 9);
    tokenize_stream_finish(ch_md, ch_md_tb);
    tokenize_stream_free(ch_md);
    assert_eq(tokenbuf_count(ch_md_tb), tokenbuf_count(ch_md_tbb),
              "markdown mid-fence split: token count matches baseline");

    # Split right BEFORE the closing fence (drain commits the
    # body; finish must still recognize ` ``` ` as the close).
    var ch_md2 = tokenize_stream_new("markdown");
    var ch_md_tb2 = tokenbuf_new();
    tokenize_stream_feed(ch_md2, ch_md_src, 28);
    tokenize_stream_drain(ch_md2, ch_md_tb2);
    tokenize_stream_feed(ch_md2, ch_md_src + 28, ch_md_n - 28);
    tokenize_stream_finish(ch_md2, ch_md_tb2);
    tokenize_stream_free(ch_md2);
    assert_eq(tokenbuf_count(ch_md_tb2), tokenbuf_count(ch_md_tbb),
              "markdown split-after-close-fence: token count matches");

    # Two-drain pattern (mimics streaming.fcyr): drain after
    # EACH feed before finish. Was the case that surfaced the
    # case-(b) compose-fenced bug where an emitted close looked
    # like a fresh opener.
    var ch_md3 = tokenize_stream_new("markdown");
    var ch_md_tb3 = tokenbuf_new();
    tokenize_stream_feed(ch_md3, ch_md_src, 20);
    tokenize_stream_drain(ch_md3, ch_md_tb3);
    tokenize_stream_feed(ch_md3, ch_md_src + 20, ch_md_n - 20);
    tokenize_stream_drain(ch_md3, ch_md_tb3);
    tokenize_stream_finish(ch_md3, ch_md_tb3);
    tokenize_stream_free(ch_md3);
    assert_eq(tokenbuf_count(ch_md_tb3), tokenbuf_count(ch_md_tbb),
              "markdown drain-after-each-feed: token count matches");

    test_group("2.3.2 TK_ERROR holes — valid syntax must not error");

    # A sweep of every printable ASCII byte through all 45 grammars
    # found 44 with at least one TK_ERROR hole. The corpora hid it:
    # they are single canonical samples, so a shape they happen not
    # to contain is a shape twelve minor releases of green gates
    # never proved anything about. Each probe here is the smallest
    # piece of *genuine* source that the pre-2.3.2 grammar rejected.

    # ── Backtick-delimited regions ──────────────────────────────
    var eh_sh = _t_tokenize("today=`date +%F`\n", "shell");
    assert_eq(tb_error_count(eh_sh), 0, "shell: `cmd` command substitution");

    var eh_rb = _t_tokenize("x = `ls`\n", "ruby");
    assert_eq(tb_error_count(eh_rb), 0, "ruby: `cmd` command literal");

    var eh_cr = _t_tokenize("out = `echo hi`\n", "crystal");
    assert_eq(tb_error_count(eh_cr), 0, "crystal: `cmd` command literal");

    var eh_php = _t_tokenize("<?php $out = `ls -l`;\n", "php");
    assert_eq(tb_error_count(eh_php), 0, "php: `cmd` shell_exec operator");

    var eh_mk = _t_tokenize("all:\n\t@echo `date +%F`\n", "makefile");
    assert_eq(tb_error_count(eh_mk), 0, "makefile: `cmd` in a recipe");

    var eh_dk = _t_tokenize("RUN echo `date` && echo 100%\n", "dockerfile");
    assert_eq(tb_error_count(eh_dk), 0, "dockerfile: `cmd` and % in RUN");

    # Go struct tags are the single most common raw string in the
    # language, and every one of them was a run of error tokens.
    var eh_go = _t_tokenize("type T struct { N string `json:\"n\"` }\n", "go");
    assert_eq(tb_error_count(eh_go), 0, "go: raw string struct tag");

    var eh_kt = _t_tokenize("fun `a test name`() { }\n", "kotlin");
    assert_eq(tb_error_count(eh_kt), 0, "kotlin: backtick-escaped identifier");

    var eh_sql = _t_tokenize("SELECT `c` FROM t WHERE a ~ 'x' AND b = $1; # m\n", "sql");
    assert_eq(tb_error_count(eh_sql), 0, "sql: MySQL ident, ~, $1, # comment");

    var eh_ml = _t_tokenize("let x = `Foo\nlet ( $ ) f y = f y\n", "ocaml");
    assert_eq(tb_error_count(eh_ml), 0, "ocaml: polymorphic variant and $ op");

    # ── C-family char literals, separators, continuations ───────
    var eh_cpp = _t_tokenize("int a = 1'000'000;\n#define M(x) \\\n  do { } while (0)\n", "cpp");
    assert_eq(tb_error_count(eh_cpp), 0, "cpp: digit separator + continuation");

    var eh_cs = _t_tokenize("#nullable enable\n#region H\n#if DEBUG\n#endif\n#endregion\n", "csharp");
    assert_eq(tb_error_count(eh_cs), 0, "csharp: preprocessor directives");

    var eh_java = _t_tokenize("char c = '\\u0041';\n", "java");
    assert_eq(tb_error_count(eh_java), 0, "java: \\u escape in a char literal");

    var eh_sw = _t_tokenize("#if os(iOS)\nlet `d` = 1\nlet k = \\Person.name\n#endif\n", "swift");
    assert_eq(tb_error_count(eh_sw), 0, "swift: #if, escaped ident, key path");

    var eh_zig = _t_tokenize("const q =\n    \\\\SELECT 1;\n    ;\n", "zig");
    assert_eq(tb_error_count(eh_zig), 0, "zig: \\\\ multiline string literal");

    # ── Operators that were missing outright ────────────────────
    var eh_hs = _t_tokenize("main = print $ length [1,2,3]\n", "haskell");
    assert_eq(tb_error_count(eh_hs), 0, "haskell: $ application operator");

    var eh_jl = _t_tokenize("B = A'\n", "julia");
    assert_eq(tb_error_count(eh_jl), 0, "julia: postfix adjoint operator");

    var eh_rs = _t_tokenize("fn f(x: u8) { match x { n @ 1..=5 => {}, _ => {} } }\n", "rust");
    assert_eq(tb_error_count(eh_rs), 0, "rust: @ pattern binding");

    var eh_js = _t_tokenize("class A { #n = 1; @dec m() { return this.#n; } }\n", "javascript");
    assert_eq(tb_error_count(eh_js), 0, "javascript: #private field, @decorator");

    var eh_ts = _t_tokenize("class A { #n = 1; @dec m(): number { return 1; } }\n", "typescript");
    assert_eq(tb_error_count(eh_ts), 0, "typescript: #private field, @decorator");

    var eh_gq = _t_tokenize("{ f(a: 1.5e+3, b: -1) { id } }\n", "graphql");
    assert_eq(tb_error_count(eh_gq), 0, "graphql: float exponent, negative int");

    var eh_scss = _t_tokenize("%ph { width: 50%; }\n.a { @extend %ph; }\n", "scss");
    assert_eq(tb_error_count(eh_scss), 0, "scss: placeholder selector and % unit");

    var eh_css = _t_tokenize(".w-1\\/2 { width: 50%; }\n", "css");
    assert_eq(tb_error_count(eh_css), 0, "css: escaped character in a selector");

    var eh_nix = _t_tokenize("{ p = ~/foo/bar; }\n", "nix");
    assert_eq(tb_error_count(eh_nix), 0, "nix: ~ home-relative path");

    var eh_toml = _t_tokenize("d = 2026-07-31T10:30:00Z\n", "toml");
    assert_eq(tb_error_count(eh_toml), 0, "toml: RFC 3339 datetime");

    var eh_ini = _t_tokenize("[s]\nv = %(name)s\n", "ini");
    assert_eq(tb_error_count(eh_ini), 0, "ini: %-interpolation in a value");

    var eh_ll = _t_tokenize("$c = comdat any\n", "llvm_ir");
    assert_eq(tb_error_count(eh_ll), 0, "llvm_ir: $ comdat name");

    var eh_ps = _t_tokenize("Set-Location C:\\Users\\foo\n", "powershell");
    assert_eq(tb_error_count(eh_ps), 0, "powershell: backslash in a bare path");

    var eh_ex = _t_tokenize("c = 'charlist'\n", "elixir");
    assert_eq(tb_error_count(eh_ex), 0, "elixir: single-quoted charlist");

    # ── Assembly. tests/corpus/asm_x86_64.s is `.intel_syntax
    # noprefix`, which uses no `$` at all — so AT&T immediates,
    # relocation suffixes and .macro parameters went unexercised.
    var eh_x86 = _t_tokenize("movq $60, %rax\ncall printf@PLT\n.macro m a\nmovq \\a, %rbx\n.endm\n", "asm_x86_64");
    assert_eq(tb_error_count(eh_x86), 0, "asm_x86_64: $imm, @PLT, \\macro-arg");

    var eh_a64 = _t_tokenize("adrp x1, _setjmp@GOTPAGE\n.macro m a\nmov x0, \\a\n.endm\n", "asm_aarch64");
    assert_eq(tb_error_count(eh_a64), 0, "asm_aarch64: @GOTPAGE, \\macro-arg");

    var eh_x86c = _t_tokenize("// preprocessed .S comment with a `tick`\nnop\n", "asm_x86_64");
    assert_eq(tb_error_count(eh_x86c), 0, "asm_x86_64: // comment in a .S file");

    # ── Free-text formats. Markup bodies and unquoted scalars are
    # arbitrary characters, so no printable byte may error.
    var eh_html = _t_tokenize("<p>50% off &mdash; $5 &amp; a|b ~ c ^ d `e`</p>\n", "html");
    assert_eq(tb_error_count(eh_html), 0, "html: arbitrary text content");

    var eh_xml = _t_tokenize("<n>a * b + c @ d ~ e $ f</n>\n", "xml");
    assert_eq(tb_error_count(eh_xml), 0, "xml: arbitrary character data");

    var eh_vue = _t_tokenize("<template><p>$5 ~ 50% | x</p></template>\n", "vue");
    assert_eq(tb_error_count(eh_vue), 0, "vue: arbitrary template text");

    var eh_svlt = _t_tokenize("<p>a | b ~ c ^ d</p>\n", "svelte");
    assert_eq(tb_error_count(eh_svlt), 0, "svelte: arbitrary markup text");

    var eh_yaml = _t_tokenize("cmd: $HOME/bin\nnote: use `x` here\n", "yaml");
    assert_eq(tb_error_count(eh_yaml), 0, "yaml: $ and backtick in plain scalars");

    # ── UTF-8 identifiers and scalars. Nine grammars never set
    # `unicode_ident`, so each byte of a non-ASCII identifier
    # became its own TK_ERROR — the non-ASCII half of the same
    # bug class. ADR 0009 established the flag back in 1.1.0.
    var eh_ujs = _t_tokenize("const café = 1;\n", "javascript");
    assert_eq(tb_error_count(eh_ujs), 0, "javascript: non-ASCII identifier");

    var eh_uts = _t_tokenize("const café: number = 1;\n", "typescript");
    assert_eq(tb_error_count(eh_uts), 0, "typescript: non-ASCII identifier");

    var eh_upy = _t_tokenize("café = 1\n", "python");
    assert_eq(tb_error_count(eh_upy), 0, "python: PEP 3131 identifier");

    var eh_urs = _t_tokenize("let café = 1;\n", "rust");
    assert_eq(tb_error_count(eh_urs), 0, "rust: non-ASCII identifier");

    var eh_ush = _t_tokenize("echo café\n", "shell");
    assert_eq(tb_error_count(eh_ush), 0, "shell: UTF-8 in an unquoted word");

    var eh_uyml = _t_tokenize("key: valué\n", "yaml");
    assert_eq(tb_error_count(eh_uyml), 0, "yaml: UTF-8 in a plain scalar");

    # ── Negative probes. TK_ERROR is the CORRECT answer for a byte
    # with no syntax in the language, and the audit deliberately
    # left those alone — python, lua, json, c, protobuf, terraform
    # and cyrius came through it unchanged. Lock that half in too,
    # so a later "just add every byte" fix cannot quietly pass.
    var eh_njson = _t_tokenize("{\"a\": 1} $\n", "json");
    assert(tb_error_count(eh_njson) > 0, "json: $ is genuinely invalid");

    var eh_nlua = _t_tokenize("local x = 1 $ 2\n", "lua");
    assert(tb_error_count(eh_nlua) > 0, "lua: $ is genuinely invalid");

    var eh_npy = _t_tokenize("x = 1 ` 2\n", "python");
    assert(tb_error_count(eh_npy) > 0, "python: backtick died with Python 2");

    var eh_nc = _t_tokenize("int x = 1 ` 2;\n", "c");
    assert(tb_error_count(eh_nc) > 0, "c: backtick is not C syntax");

    var eh_ncy = _t_tokenize("var x = 1 ` 2;\n", "cyrius");
    assert(tb_error_count(eh_ncy) > 0, "cyrius: backtick is not Cyrius syntax");

    test_group("2.3.5 OpenQASM grammar — basic shapes");

    # `OPENQASM 2.0;` — the version header every file opens with.
    # `OPENQASM` is a reserved word; `2.0` splits into number + `.` +
    # number because the scanner has no float support (shared gap
    # with css / scss / protobuf / java — see the grammar header).
    var tb_qa1 = _t_tokenize("OPENQASM 2.0;", "openqasm");
    assert_neq(tb_qa1, 0, "openqasm grammar loads");
    assert_eq(tokenbuf_kind(tb_qa1, 0), TK_KEYWORD,
              "qasm header: OPENQASM is a keyword");
    assert_eq(tokenbuf_len(tb_qa1, 0), 8,
              "qasm header: 8-byte keyword");

    # `measure q -> c;` — `->` must win over bare `-` (longest match).
    var tb_qa2 = _t_tokenize("measure q -> c;", "openqasm");
    var saw_qa_arrow = 0;
    var qa2i = 0;
    while (qa2i < tokenbuf_count(tb_qa2)) {
        if (tokenbuf_kind(tb_qa2, qa2i) == TK_OPERATOR) {
            if (tokenbuf_len(tb_qa2, qa2i) == 2) { saw_qa_arrow = 1; }
        }
        qa2i = qa2i + 1;
    }
    assert_eq(saw_qa_arrow, 1, "qasm measure: `->` is one 2-byte operator");

    # Standard-library gate names are `ident`, NOT `keyword` — they
    # come from qelib1.inc and are redefinable via `gate`. Same call
    # as ADR 0004 for shell built-ins.
    var tb_qa3 = _t_tokenize("h", "openqasm");
    assert_eq(tokenbuf_count(tb_qa3), 1, "qasm gate name: one token");
    assert_eq(tokenbuf_kind(tb_qa3, 0), TK_IDENT,
              "qasm gate name `h` is ident, not keyword (ADR 0004)");

    # `gate` itself IS reserved.
    var tb_qa4 = _t_tokenize("gate", "openqasm");
    assert_eq(tokenbuf_kind(tb_qa4, 0), TK_KEYWORD,
              "qasm `gate` is a keyword");

    # `include "qelib1.inc";` — double-quoted string is one span.
    var tb_qa5 = _t_tokenize("include \"qelib1.inc\";", "openqasm");
    var saw_qa_str = 0;
    var qa5i = 0;
    while (qa5i < tokenbuf_count(tb_qa5)) {
        if (tokenbuf_kind(tb_qa5, qa5i) == TK_STRING) {
            if (tokenbuf_len(tb_qa5, qa5i) == 12) { saw_qa_str = 1; }
        }
        qa5i = qa5i + 1;
    }
    assert_eq(saw_qa_str, 1, "qasm include: string is one 12-byte span");

    # `//` line comments, and no error kinds anywhere in the sample
    # shapes above (the zero-error bar this grammar was added for).
    var tb_qa6 = _t_tokenize("// note\nqreg q[3];\n", "openqasm");
    var qa_err = 0;
    var qa_comment = 0;
    var qa6i = 0;
    while (qa6i < tokenbuf_count(tb_qa6)) {
        if (tokenbuf_kind(tb_qa6, qa6i) == TK_ERROR)   { qa_err = qa_err + 1; }
        if (tokenbuf_kind(tb_qa6, qa6i) == TK_COMMENT) { qa_comment = qa_comment + 1; }
        qa6i = qa6i + 1;
    }
    assert_eq(qa_comment, 1, "qasm `//` line comment recognised");
    assert_eq(qa_err, 0, "qasm qreg declaration: zero error tokens");

    # OpenQASM 3 keywords resolve too (`qubit`, `ctrl`).
    var tb_qa7 = _t_tokenize("qubit", "openqasm");
    assert_eq(tokenbuf_kind(tb_qa7, 0), TK_KEYWORD,
              "qasm 3.x `qubit` is a keyword");

    test_group("version string shape");
    # VYK_VERSION lives in src/version_str.cyr (auto-generated by
    # scripts/version-bump.sh). Asserting shape, not value, so the
    # test doesn't drift on every bump.
    assert(strlen(VYK_VERSION) > 4, "version string is longer than 4 chars");
    assert_eq(memeq(VYK_VERSION, "vyk ", 4), 1, "version string starts with 'vyk '");

    test_group("2.6.0 shell — word-start comments, escapes, positional params");
    # `#` opens a comment only at the start of a word (ADR 0022). Offsets
    # below index into sh6_src.
    #            0         1         2         3         4
    #            0123456789012345678901234567890123456789012345678
    var sh6_src = "n=${#v} b=${p##*/} a#b #c\necho \\\" \\# $1 $0;#d\n";
    var sh6_tb = _t_tokenize(sh6_src, "shell");
    assert_eq(_t_kind_at(sh6_tb, 4),  TK_OPERATOR, "`${#v}`: the # is an operator, not a comment");
    assert_eq(_t_kind_at(sh6_tb, 5),  TK_IDENT,    "`${#v}`: v is an ident after it");
    assert_eq(_t_kind_at(sh6_tb, 13), TK_OPERATOR, "`${p##*/}`: first # is an operator");
    assert_eq(_t_kind_at(sh6_tb, 14), TK_OPERATOR, "`${p##*/}`: second # is an operator");
    assert_eq(_t_kind_at(sh6_tb, 20), TK_OPERATOR, "`a#b`: the # is an operator");
    assert_eq(_t_kind_at(sh6_tb, 23), TK_COMMENT,  "` #c`: # after a space is a comment");
    assert_eq(_t_kind_at(sh6_tb, 31), TK_OPERATOR, "`\\\"` is one escape operator");
    assert_eq(_t_kind_at(sh6_tb, 34), TK_OPERATOR, "`\\#` is one escape operator (no comment)");
    # ...and the escaped byte is consumed with the backslash: no token
    # may START at the `"` or the `#` (on 2.5.2 the `"` opened a string).
    assert_eq(_t_kind_at(sh6_tb, 32), (0 - 1), "`\\\"`: the quote is part of the escape, not a string opener");
    assert_eq(_t_kind_at(sh6_tb, 35), (0 - 1), "`\\#`: the # is part of the escape, not a comment opener");
    assert_eq(_t_kind_at(sh6_tb, 37), TK_OPERATOR, "`$1` is one special-var operator");
    assert_eq(_t_kind_at(sh6_tb, 40), TK_OPERATOR, "`$0` is one special-var operator");
    assert_eq(_t_kind_at(sh6_tb, 43), TK_COMMENT,  "`;#d`: # after ; is a comment");
    # Here-documents (ADR 0023). Offsets index into hd6_src:
    #   0  "cat <<EOF > o\n"           opener; body at 14
    #   14 "it's # x\nEOF\n"           body + terminator = one string (12 bytes)
    #   27 "y=$((1 << n))\n"           arithmetic shift, not a heredoc
    #   41 "c <<'Q' <<-T\n"            two openers on one line
    #   54 "q\nQ\n"                    Q's body + terminator
    #   58 "\tt\n\tT\n"                T's body + tab-indented terminator
    #   64 "r <<< x\n"                 here-string, not a heredoc
    #   72 "d <<NOEND\nn # c\n"         no terminator: code, and `# c` a comment
    var hd6_src = "cat <<EOF > o\nit's # x\nEOF\ny=$((1 << n))\nc <<'Q' <<-T\nq\nQ\n\tt\n\tT\nr <<< x\nd <<NOEND\nn # c\n";
    var hd6_tb = _t_tokenize(hd6_src, "shell");
    assert_eq(_t_kind_at(hd6_tb, 4),  TK_OPERATOR, "heredoc opener `<<` stays an operator");
    assert_eq(_t_kind_at(hd6_tb, 6),  TK_IDENT,    "bare delimiter stays its own token");
    assert_eq(_t_kind_at(hd6_tb, 10), TK_OPERATOR, "rest of the opener line tokenizes as code (`>`)");
    assert_eq(_t_kind_at(hd6_tb, 14), TK_STRING,   "heredoc body starts a string at the next line");
    assert_eq(_t_kind_at(hd6_tb, 19), (0 - 1),     "the body's `#` is inside the string, not a comment");
    assert_eq(_t_kind_at(hd6_tb, 23), (0 - 1),     "the terminator is part of the body token");
    assert_eq(_t_kind_at(hd6_tb, 34), TK_OPERATOR, "`$((1 << n))`: the `<<` is a shift");
    assert_eq(_t_kind_at(hd6_tb, 37), TK_IDENT,    "`$((1 << n))`: n is code, not a delimiter");
    assert_eq(_t_kind_at(hd6_tb, 54), TK_STRING,   "first heredoc of a line: body Q");
    assert_eq(_t_kind_at(hd6_tb, 58), TK_STRING,   "second heredoc of the line: body T (after Q's)");
    assert_eq(_t_kind_at(hd6_tb, 61), (0 - 1),     "`<<-T`: the tab-indented terminator closes it");
    assert_eq(_t_kind_at(hd6_tb, 66), TK_OPERATOR, "`<<<` is a here-string operator");
    assert_eq(_t_kind_at(hd6_tb, 82), TK_IDENT,    "unterminated `<<NOEND`: next line is code");
    assert_eq(_t_kind_at(hd6_tb, 84), TK_COMMENT,  "unterminated `<<NOEND`: its `# c` is a comment");
    var hd6_ws = 0;
    var hd6_i = 0;
    while (hd6_i < tokenbuf_count(hd6_tb)) {
        if (tokenbuf_start(hd6_tb, hd6_i) == 14) { hd6_ws = tokenbuf_len(hd6_tb, hd6_i); }
        hd6_i = hd6_i + 1;
    }
    assert_eq(hd6_ws, 12, "body + terminator span exactly `it's # x\\nEOF` (12 bytes)");

    var sh6_m1 = tokenbuf_new();
    tokenize_shell(sh6_src, strlen(sh6_src), sh6_m1);
    assert_eq(_t_same_tokens(sh6_m1, sh6_tb), 1, "M1 oracle == M2 grammar on the 2.6.0 shapes");

    test_group("2.5.2 grammar invariants — no shadowed operator / punctuation");
    # The scanner returns the FIRST list entry that matches, so an entry
    # listed before a longer entry it prefixes makes the longer one
    # unreachable. 2.5.2's audit found ten (php `==` before `===`,
    # crystal / ruby compound assignments, julia `>>>`, powershell
    # `-isnot`). Checked over every loaded grammar so a new grammar
    # cannot reintroduce it. An operator also shadows any longer
    # punctuation entry it prefixes (operators are tried first).
    var ord5_names = vec_new();
    list_languages_into(ord5_names);
    var ord5_bad = 0;
    var ord5_gi = 0;
    while (ord5_gi < vec_len(ord5_names)) {
        var ord5_g = registry_find_by_name(vec_get(ord5_names, ord5_gi));
        var ord5_lists = vec_new();
        vec_push(ord5_lists, grammar_operators(ord5_g));
        vec_push(ord5_lists, grammar_punctuation(ord5_g));
        var ord5_li = 0;
        while (ord5_li < 2) {
            var ord5_v = vec_get(ord5_lists, ord5_li);
            var ord5_a = 0;
            while (ord5_a < vec_len(ord5_v)) {
                var ord5_sa = vec_get(ord5_v, ord5_a);
                var ord5_la = strlen(ord5_sa);
                # Later entries of the same list, then (for operators)
                # every punctuation entry.
                var ord5_scan = vec_new();
                var ord5_b = ord5_a + 1;
                while (ord5_b < vec_len(ord5_v)) { vec_push(ord5_scan, vec_get(ord5_v, ord5_b)); ord5_b = ord5_b + 1; }
                if (ord5_li == 0) {
                    var ord5_pv = grammar_punctuation(ord5_g);
                    var ord5_pi = 0;
                    while (ord5_pi < vec_len(ord5_pv)) { vec_push(ord5_scan, vec_get(ord5_pv, ord5_pi)); ord5_pi = ord5_pi + 1; }
                }
                var ord5_k = 0;
                while (ord5_k < vec_len(ord5_scan)) {
                    var ord5_sb = vec_get(ord5_scan, ord5_k);
                    if (strlen(ord5_sb) > ord5_la) {
                        if (memeq(ord5_sb, ord5_sa, ord5_la) == 1) {
                            ord5_bad = ord5_bad + 1;
                            print("    shadowed: ", 14);
                            print(vec_get(ord5_names, ord5_gi), strlen(vec_get(ord5_names, ord5_gi)));
                            print(" ", 1); print(ord5_sa, ord5_la);
                            print(" before ", 8); print(ord5_sb, strlen(ord5_sb));
                            print("\n", 1);
                        }
                    }
                    ord5_k = ord5_k + 1;
                }
                ord5_a = ord5_a + 1;
            }
            ord5_li = ord5_li + 1;
        }
        ord5_gi = ord5_gi + 1;
    }
    assert_eq(ord5_bad, 0, "no grammar lists a prefix before a longer operator / punctuation entry");
    assert_eq(vec_len(ord5_names), 46, "all 46 bundled grammars loaded (none rejected by 2.5.2 validation)");

    test_group("2.6.2 detection matches grammar declarations (ADR 0025)");
    # Every `extensions`, `filenames` and `shebangs` entry of every
    # loaded grammar routes to that grammar. Through 2.6.1 the arrays
    # were documentation only: `.hh`, `.csx`, `.phtml`, `.properties`,
    # `.asm` and `pwsh` were declared and never routed. The reverse
    # direction — every route in src/detect.cyr is declared — is
    # scripts/check-detect.sh, run by smoke.
    var dd6_names = vec_new();
    list_languages_into(dd6_names);
    var dd6_buf = alloc(256);
    var dd6_arm = "\t.arch armv8-a\n\tldp x0, x1, [sp]\n\tb.eq 1f\n";
    var dd6_bad = 0;
    var dd6_ext_n = 0;
    var dd6_fn_n = 0;
    var dd6_sb_n = 0;
    var dd6_gi = 0;
    while (dd6_gi < vec_len(dd6_names)) {
        var dd6_nm = vec_get(dd6_names, dd6_gi);
        var dd6_g = registry_find_by_name(dd6_nm);
        var dd6_ev = grammar_extensions(dd6_g);
        var dd6_i = 0;
        while (dd6_i < vec_len(dd6_ev)) {
            var dd6_p = _t_cat3(dd6_buf, "src.d/x", vec_get(dd6_ev, dd6_i), "");
            var dd6_got = detect_language(dd6_p);
            # `.s` / `.S` are shared; ARM content votes them to aarch64
            # (ADR 0015).
            if (streq(dd6_nm, "asm_aarch64") == 1) {
                dd6_got = detect_language_combined(dd6_p, dd6_arm, strlen(dd6_arm));
            }
            if (_t_route_ok(dd6_p, dd6_got, dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_ext_n = dd6_ext_n + 1;
            dd6_i = dd6_i + 1;
        }
        var dd6_fv = grammar_filenames(dd6_g);
        dd6_i = 0;
        while (dd6_i < vec_len(dd6_fv)) {
            var dd6_f = vec_get(dd6_fv, dd6_i);
            # Bare, in a directory, as a suffix, and as `<name>.<x>`.
            if (_t_route_ok(dd6_f, detect_language(dd6_f), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            var dd6_fp = _t_cat3(dd6_buf, "ci/", dd6_f, "");
            if (_t_route_ok(dd6_fp, detect_language(dd6_fp), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_fp = _t_cat3(dd6_buf, "ci/app.", dd6_f, "");
            if (_t_route_ok(dd6_fp, detect_language(dd6_fp), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_fp = _t_cat3(dd6_buf, "ci/", dd6_f, ".dev");
            if (_t_route_ok(dd6_fp, detect_language(dd6_fp), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_fn_n = dd6_fn_n + 1;
            dd6_i = dd6_i + 1;
        }
        var dd6_sv = grammar_shebangs(dd6_g);
        if (vec_len(dd6_sv) > 0) {
            # A shebang that routes here must also tokenize as one.
            if (grammar_shebang_on(dd6_g) != 1) {
                print("    shebang = false but shebangs listed: ", 41);
                print(dd6_nm, strlen(dd6_nm)); print("\n", 1);
                dd6_bad = dd6_bad + 1;
            }
        }
        dd6_i = 0;
        while (dd6_i < vec_len(dd6_sv)) {
            var dd6_s = vec_get(dd6_sv, dd6_i);
            # `env` form, absolute path with an argument, and a
            # versioned name (`python3`, `sh5`).
            var dd6_c = _t_cat3(dd6_buf, "#!/usr/bin/env ", dd6_s, "\n");
            if (_t_route_ok(dd6_c, detect_language_from_content(dd6_c, strlen(dd6_c)), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_c = _t_cat3(dd6_buf, "#!/usr/local/bin/", dd6_s, " -x\n");
            if (_t_route_ok(dd6_c, detect_language_from_content(dd6_c, strlen(dd6_c)), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_c = _t_cat3(dd6_buf, "#!/bin/", dd6_s, "5\n");
            if (_t_route_ok(dd6_c, detect_language_from_content(dd6_c, strlen(dd6_c)), dd6_nm) == 0) { dd6_bad = dd6_bad + 1; }
            dd6_sb_n = dd6_sb_n + 1;
            dd6_i = dd6_i + 1;
        }
        dd6_gi = dd6_gi + 1;
    }
    assert_eq(dd6_bad, 0, "every declared extension / filename / shebang routes to its grammar");
    assert(dd6_ext_n >= 78, "checked every extension (78 declared in 2.6.2)");
    assert_eq(dd6_fn_n, 5, "checked all 5 filenames (Dockerfile, Containerfile, 3 makefiles)");
    assert(dd6_sb_n >= 12, "checked every shebang interpreter (12 declared in 2.6.2)");

    # The 2.6.2 routing changes, by name.
    assert_streq(_t_path("a.hh"),           "cpp",        "2.6.2: .hh -> cpp");
    assert_streq(_t_path("a.csx"),          "csharp",     "2.6.2: .csx -> csharp");
    assert_streq(_t_path("a.phtml"),        "php",        "2.6.2: .phtml -> php");
    assert_streq(_t_path("a.properties"),   "ini",        "2.6.2: .properties -> ini");
    assert_streq(_t_path("rules.mk"),       "makefile",   "2.6.2: .mk -> makefile");
    assert_streq(_t_path("Dockerfile.dev"), "dockerfile", "2.6.2: Dockerfile.dev -> dockerfile");
    assert_streq(_t_path("x/Makefile.am"),  "makefile",   "2.6.2: Makefile.am -> makefile");
    assert_streq(_t_path("x/Makefile.py"),  "python",     "an extension still beats a filename prefix");
    assert_eq(detect_language("a.asm"), 0, "2.6.2: .asm is not routed (NASM `;` comments; ADR 0025)");
    assert_eq(detect_language("x/NotDockerfile.dev"), 0, "filename prefix is basename-anchored");
    assert_eq(detect_language("Dockerfile."), 0, "`<name>.` needs something after the dot");
    assert_streq(_t_path("a.cyml"),         "cyml",       ".cyml is cyml's alone (dropped from cyrius)");
    assert_streq(_t_detect("#!/usr/bin/env pwsh\n"),   "powershell", "2.6.2: pwsh shebang -> powershell");
    assert_streq(_t_detect("#!/usr/bin/env julia\n"),  "julia",      "2.6.2: julia shebang -> julia");
    var dd6_js = _t_tokenize("#!/usr/bin/env node\nx;\n", "javascript");
    assert_eq(tokenbuf_kind(dd6_js, 0), TK_PREPROCESSOR, "2.6.2: a node shebang is one preprocessor token");
    assert_eq(tokenbuf_len(dd6_js, 0), 19, "  ... spanning the line");
    var dd6_php = _t_tokenize("#!/usr/bin/env php\n<?php echo 1;\n", "php");
    assert_eq(tokenbuf_kind(dd6_php, 0), TK_PREPROCESSOR, "2.6.2: a php shebang is a shebang, not a # comment");

    test_group("2.6.x audit — shell scanner and heredoc streaming");
    # `\r` in shell.cyml's `start_after` was decoded as the letter `r`,
    # so any `#` after an `r` opened a comment: `${dir##*/}`, `${var#p}`.
    var au6_a = _t_tokenize("b=${dir##*/}; v=${var#p}\n", "shell");
    assert_eq(_t_kind_at(au6_a, 7), TK_OPERATOR, "${dir##*/}: # after r is code, not a comment");
    assert_eq(_t_kind_at(au6_a, 21), TK_OPERATOR, "${var#p}: # after r is code");
    var au6_cr = _t_tokenize("a\r#c\n", "shell");
    assert_eq(_t_kind_at(au6_cr, 2), TK_COMMENT, "# after a CR starts a comment (CR is a word boundary)");
    # A grammar escaping a letter is rejected, not silently mis-decoded;
    # punctuation escapes still mean the byte.
    var au6_g1 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"\\e\"\n";
    assert_eq(_gp_parse(au6_g1, strlen(au6_g1)), 0, "a \\e escape in a grammar string rejects the grammar");
    var au6_g2 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"\\$\"\n";
    assert_neq(_gp_parse(au6_g2, strlen(au6_g2)), 0, "a \\$ escape still loads (the byte itself)");
    # `((` inside quotes is not arithmetic; `-` joins a delimiter.
    var au6_q = _t_tokenize("sed 's/((a)/' <<EOF\nit's\nEOF\necho z\n", "shell");
    assert_eq(_t_kind_at(au6_q, 20), TK_STRING, "`((` inside quotes does not hide a heredoc");
    var au6_d = _t_tokenize("cat <<END-OF-DATA\nit's\nEND-OF-DATA\necho z\n", "shell");
    assert_eq(_t_kind_at(au6_d, 18), TK_STRING, "<<END-OF-DATA is a heredoc");
    assert_eq(_t_kind_at(au6_d, 34), TK_WHITESPACE, "  ... and the apostrophe in its body opens no string");
    var au6_ar = _t_tokenize("y=$((1 << n))\necho a\nn\n", "shell");
    assert_eq(_t_kind_at(au6_ar, 14), TK_IDENT, "an arithmetic << is a shift, not a heredoc");
    # The 1 MiB heredoc hold is enforced while the watch is armed: 2.6.1
    # held until VYK_STREAM_CAP (16 MiB) and then failed every feed.
    var au6_s = tokenize_stream_new("shell");
    var au6_tb = tokenbuf_new();
    var au6_line = "line of body text # not a comment\n";
    var au6_ll = strlen(au6_line);
    var au6_chunk = alloc(4096);
    var au6_cl = 0;
    while (au6_cl + au6_ll <= 4096) { memcpy(au6_chunk + au6_cl, au6_line, au6_ll); au6_cl = au6_cl + au6_ll; }
    var au6_fed = 0;
    var au6_bad = 0;
    var au6_max = 0;
    tokenize_stream_feed(au6_s, "cat <<EOF\n", 10);
    au6_fed = 10;
    while (au6_fed < 1300000) {
        if (tokenize_stream_feed(au6_s, au6_chunk, au6_cl) != 0) { au6_bad = au6_bad + 1; }
        au6_fed = au6_fed + au6_cl;
        tokenize_stream_drain(au6_s, au6_tb);
        if (load64(au6_s + 8) > au6_max) { au6_max = load64(au6_s + 8); }
    }
    tokenize_stream_finish(au6_s, au6_tb);
    assert_eq(au6_bad, 0, "a 1.3 MB unterminated heredoc streams without a feed error");
    assert(au6_max <= VYK_HEREDOC_HOLD_MAX + 8192, "  ... and the held buffer stays within the 1 MiB bound");
    var au6_end = tokenbuf_start(au6_tb, tokenbuf_count(au6_tb) - 1) + tokenbuf_len(au6_tb, tokenbuf_count(au6_tb) - 1);
    assert_eq(au6_end, au6_fed, "  ... and the tokens still cover every byte");

    test_group("2.7.0 number literals — float, separator, datetime (ADR 0026)");
    var nl7_py = _t_tokenize("x = 1.5e-3 + 1_000 + 0x_FF + 1.max + 2j\n", "python");
    assert_eq(_t_kind_at(nl7_py, 4), TK_NUMBER, "python 1.5e-3 is a number");
    assert_eq(_t_len_at(nl7_py, 4), 6, "  ... one token, exponent and sign included");
    assert_eq(_t_len_at(nl7_py, 13), 5, "python 1_000 is one number");
    assert_eq(_t_len_at(nl7_py, 21), 5, "python 0x_FF: the separator works in hex");
    assert_eq(_t_len_at(nl7_py, 29), 1, "1.max: a dot not followed by a digit stays a dot");
    assert_eq(_t_len_at(nl7_py, 37), 1, "2j: the suffix stays an identifier");
    var nl7_rs = _t_tokenize("let r = 0..10; t.0.1; 1_000u32; 2.5e10_f64;\n", "rust");
    assert_eq(_t_len_at(nl7_rs, 8), 1, "rust 0..10 stays a range");
    assert_eq(_t_len_at(nl7_rs, 17), 3, "rust t.0.1 lexes 0.1 as one float, as rustc does");
    assert_eq(_t_len_at(nl7_rs, 22), 5, "rust 1_000u32: number then suffix");
    assert_eq(_t_len_at(nl7_rs, 32), 6, "rust 2.5e10_f64: the `_f` is no separator");
    var nl7_cpp = _t_tokenize("int x = 1'000'000; char c = 'a';\n", "cpp");
    assert_eq(_t_len_at(nl7_cpp, 8), 9, "c++ 1'000'000 is one number");
    assert_eq(_t_kind_at(nl7_cpp, 28), TK_STRING, "  ... and 'a' is still a char literal");
    var nl7_c = _t_tokenize("x = 1.; y = 1_000;\n", "c");
    assert_eq(_t_len_at(nl7_c, 4), 1, "c 1. (trailing dot) is not a float (needs a digit)");
    assert_eq(_t_len_at(nl7_c, 12), 1, "c has no `_` separator");
    var nl7_toml = _t_tokenize("d = 1979-05-27T07:32:00Z\ne = 1979-05-27 07:32:00\nt = 07:32:00.5\n", "toml");
    assert_eq(_t_len_at(nl7_toml, 4), 20, "toml offset datetime is one token");
    assert_eq(_t_len_at(nl7_toml, 29), 19, "toml space-separated local datetime is one token");
    assert_eq(_t_len_at(nl7_toml, 53), 10, "toml local time with fraction is one token");
    var nl7_yaml = _t_tokenize("t: 10:30\n", "yaml");
    assert_eq(_t_len_at(nl7_yaml, 3), 2, "yaml 10:30 (no seconds) is not a time");
    var nl7_json = _t_tokenize("[-1.5E+10, 1e]", "json");
    assert_eq(_t_len_at(nl7_json, 2), 7, "json 1.5E+10 is one number");
    assert_eq(_t_len_at(nl7_json, 11), 1, "json 1e (no exponent digit) stays 1");
    var nl7_sh = _t_tokenize("echo 1.5\n", "shell");
    assert_eq(_t_len_at(nl7_sh, 5), 1, "shell does not opt in: 1.5 stays split");
    # A separator must be one non-digit byte.
    var nl7_g1 = "[grammar]\nname = \"x\"\n[defaults]\nnumber_decimal = true\nnumber_separator = \"ab\"\n";
    assert_eq(_gp_parse(nl7_g1, strlen(nl7_g1)), 0, "a two-byte number_separator rejects the grammar");
    var nl7_g2 = "[grammar]\nname = \"x\"\n[defaults]\nnumber_decimal = true\nnumber_separator = \"1\"\n";
    assert_eq(_gp_parse(nl7_g2, strlen(nl7_g2)), 0, "a digit number_separator rejects the grammar");

    test_group("2.7.1 grammar polish (ADR 0027)");
    var gp7_php = _t_tokenize("<?php\n#[Route(\"/x\")]\nfunction f() {} # c\n", "php");
    assert_eq(_t_kind_at(gp7_php, 6), TK_PUNCTUATION, "php #[ opens an attribute, not a comment");
    assert_eq(_t_len_at(gp7_php, 6), 2, "  ... as one `#[` token");
    assert_eq(_t_kind_at(gp7_php, 37), TK_COMMENT, "php # c is still a comment");
    var gp7_rb = _t_tokenize("@@count += 1\n", "ruby");
    assert_eq(_t_len_at(gp7_rb, 0), 7, "ruby @@count is one ident");
    var gp7_cr = _t_tokenize("@@count += 1\n", "crystal");
    assert_eq(_t_len_at(gp7_cr, 0), 7, "crystal @@count is one ident");
    var gp7_mk = _t_tokenize("a:\n\tcc $< $^ $% $+ $| $$x\n", "makefile");
    assert_eq(_t_len_at(gp7_mk, 7), 2, "makefile $< is one operator");
    assert_eq(_t_len_at(gp7_mk, 10), 2, "makefile $^");
    assert_eq(_t_len_at(gp7_mk, 13), 2, "makefile $%");
    assert_eq(_t_len_at(gp7_mk, 16), 2, "makefile $+");
    assert_eq(_t_len_at(gp7_mk, 19), 2, "makefile $|");
    assert_eq(_t_len_at(gp7_mk, 22), 2, "makefile $$");
    var gp7_css = _t_tokenize("a { width: calc(100% - 10px); margin: -2px; -webkit-x: --y; }\n", "css");
    assert_eq(_t_kind_at(gp7_css, 21), TK_OPERATOR, "css `100% - 10px`: the `-` is an operator");
    assert_eq(_t_kind_at(gp7_css, 38), TK_OPERATOR, "css -2px: `-` then a number");
    assert_eq(_t_kind_at(gp7_css, 39), TK_NUMBER, "  ... and the 2 is a number");
    assert_eq(_t_len_at(gp7_css, 44), 9, "css -webkit-x is still one ident");
    assert_eq(_t_len_at(gp7_css, 55), 3, "css --y is still one ident");
    var gp7_rs = _t_tokenize("let a = b'\\n'; let r = r\"C:\\\"; let s = b\"hi\";\n", "rust");
    assert_eq(_t_kind_at(gp7_rs, 8), TK_STRING, "rust b'\\n' is one string token");
    assert_eq(_t_len_at(gp7_rs, 8), 5, "  ... prefix included");
    assert_eq(_t_len_at(gp7_rs, 23), 6, "rust r\"C:\\\" is raw: it ends at its quote");
    assert_eq(_t_len_at(gp7_rs, 39), 5, "rust b\"hi\" is one string token");
    var gp7_py = _t_tokenize("x = f\"{a}\" + rb'\\d' + R\"x\" + ab\"q\"\n", "python");
    assert_eq(_t_len_at(gp7_py, 4), 6, "python f\"{a}\" is one string token");
    assert_eq(_t_len_at(gp7_py, 13), 6, "python rb'\\d' is one string token");
    assert_eq(_t_len_at(gp7_py, 22), 4, "python R\"x\" (upper case prefix)");
    assert_eq(_t_kind_at(gp7_py, 29), TK_IDENT, "python ab\"q\": `ab` is no prefix");
    var gp7_cy = _t_tokenize("#ifdef X\nfn f() {} # c\n    #endif\n# note\n", "cyrius");
    assert_eq(_t_kind_at(gp7_cy, 0), TK_PREPROCESSOR, "cyrius #ifdef is a directive");
    assert_eq(_t_len_at(gp7_cy, 0), 8, "  ... to the end of its line");
    assert_eq(_t_kind_at(gp7_cy, 19), TK_COMMENT, "cyrius # c is still a comment");
    assert_eq(_t_kind_at(gp7_cy, 27), TK_PREPROCESSOR, "cyrius indented #endif is a directive");
    assert_eq(_t_kind_at(gp7_cy, 34), TK_COMMENT, "cyrius # note is a comment");
    # A first cut matched `#` + any lowercase letter; cyim's render tests
    # caught `x #c` coming back as a directive.
    var gp7_cy2 = _t_tokenize("x #c\n#iffy\n#ifdef X\n", "cyrius");
    assert_eq(_t_kind_at(gp7_cy2, 2), TK_COMMENT, "cyrius `x #c` is a comment, not a directive");
    assert_eq(_t_kind_at(gp7_cy2, 5), TK_COMMENT, "cyrius `#iffy` is a comment (`#if` is a whole word)");
    assert_eq(_t_kind_at(gp7_cy2, 11), TK_PREPROCESSOR, "  ... and `#ifdef X` a directive");
    var gp7_c = _t_tokenize("w = L\"wide\"; c = u8'x'; L = 1;\n", "c");
    assert_eq(_t_len_at(gp7_c, 4), 7, "c L\"wide\" is one string token");
    assert_eq(_t_len_at(gp7_c, 17), 5, "c u8'x' is one string token");
    assert_eq(_t_kind_at(gp7_c, 24), TK_IDENT, "c `L = 1`: L alone stays an ident");
    var gp7_sh = _t_tokenize("cat <<\"E\"OF\nit's\nEOF\ncat <<''\nb's\n\ned f <<!\nq's\n!\n", "shell");
    assert_eq(_t_len_at(gp7_sh, 12), 8, "shell <<\"E\"OF ends at EOF (quote removal)");
    assert_eq(_t_len_at(gp7_sh, 30), 4, "shell <<'' ends at an empty line");
    assert_eq(_t_len_at(gp7_sh, 44), 5, "shell <<! ends at a line `!`");
    # Grammar validation: a two-byte heredoc indent, an escape on a line
    # rule, a followed_by on a pair rule, a non-identifier prefix.
    var gp7_b1 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"string\"\nmatch = \"heredoc\"\nstart = \"<<\"\nindent = \"-=\"\n";
    assert_eq(_gp_parse(gp7_b1, strlen(gp7_b1)), 0, "a two-byte heredoc indent rejects the grammar");
    var gp7_b2 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\nescape = \"\\\\\"\n";
    assert_eq(_gp_parse(gp7_b2, strlen(gp7_b2)), 0, "an escape on a line rule rejects the grammar");
    var gp7_b3 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nfollowed_by = \"a\"\n";
    assert_eq(_gp_parse(gp7_b3, strlen(gp7_b3)), 0, "followed_by on a pair rule rejects the grammar");
    var gp7_b4 = "[grammar]\nname = \"x\"\n[defaults]\nident_start = \"a-z\"\nident_cont = \"a-z\"\nstring_prefixes = [\"@\"]\n";
    assert_eq(_gp_parse(gp7_b4, strlen(gp7_b4)), 0, "a non-identifier string prefix rejects the grammar");
    # No list in any grammar repeats an entry, and no word is in two words
    # rules (haskell `/=`, llvm `uwtable`, swift `import` / `associatedtype`
    # were, through 2.7.0).
    var gp7_names = vec_new();
    list_languages_into(gp7_names);
    var gp7_dups = 0;
    var gp7_gi = 0;
    while (gp7_gi < vec_len(gp7_names)) {
        var gp7_g = registry_find_by_name(vec_get(gp7_names, gp7_gi));
        var gp7_lists = vec_new();
        vec_push(gp7_lists, grammar_operators(gp7_g));
        vec_push(gp7_lists, grammar_punctuation(gp7_g));
        var gp7_words = vec_new();
        var gp7_wr = grammar_words_rules(gp7_g);
        var gp7_wi = 0;
        while (gp7_wi < vec_len(gp7_wr)) {
            var gp7_wl = words_rule_words(vec_get(gp7_wr, gp7_wi));
            var gp7_wk = 0;
            while (gp7_wk < vec_len(gp7_wl)) { vec_push(gp7_words, vec_get(gp7_wl, gp7_wk)); gp7_wk = gp7_wk + 1; }
            gp7_wi = gp7_wi + 1;
        }
        vec_push(gp7_lists, gp7_words);
        var gp7_li = 0;
        while (gp7_li < vec_len(gp7_lists)) {
            var gp7_v = vec_get(gp7_lists, gp7_li);
            var gp7_a = 0;
            while (gp7_a < vec_len(gp7_v)) {
                var gp7_bi = gp7_a + 1;
                while (gp7_bi < vec_len(gp7_v)) {
                    if (streq(vec_get(gp7_v, gp7_a), vec_get(gp7_v, gp7_bi)) == 1) {
                        gp7_dups = gp7_dups + 1;
                        print("    duplicate: ", 15); print(vec_get(gp7_names, gp7_gi), strlen(vec_get(gp7_names, gp7_gi)));
                        print(" ", 1); print(vec_get(gp7_v, gp7_a), strlen(vec_get(gp7_v, gp7_a))); print("\n", 1);
                    }
                    gp7_bi = gp7_bi + 1;
                }
                gp7_a = gp7_a + 1;
            }
            gp7_li = gp7_li + 1;
        }
        gp7_gi = gp7_gi + 1;
    }
    assert_eq(gp7_dups, 0, "no grammar repeats an operator, punctuation or keyword entry");

    test_group("2.9.0 compacted grammar blobs (ADR 0029)");
    # scripts/embed-grammars.sh drops comments and every blank outside a
    # string from each blob. Each blob must parse to the same grammar
    # record as its source file — every field, every rule, every class
    # table. This also fails on a stale blob (a grammar edited without
    # re-running the script).
    var cb9_spec = _t_grammar_spec();
    assert_eq(strlen(cb9_spec) * 8, GRAMMAR_SIZE, "the comparison spec covers the whole grammar record");
    assert_eq(strlen(_t_sub_spec(76)) * 8, LINE_RULE_SIZE, "  ... and the line rule");
    assert_eq(strlen(_t_sub_spec(80)) * 8, PAIR_RULE_SIZE, "  ... the pair rule");
    assert_eq(strlen(_t_sub_spec(87)) * 8, WORDS_RULE_SIZE, "  ... the words rule");
    assert_eq(strlen(_t_sub_spec(67)) * 8, COMPOSE_RULE_SIZE, "  ... the compose rule");
    assert_eq(strlen(_t_sub_spec(70)) * 8, COMPOSE_FENCED_RULE_SIZE, "  ... the compose-fenced rule");
    assert_eq(strlen(_t_sub_spec(82)) * 8, COMPOSE_REGION_RULE_SIZE, "  ... the compose-region rule");
    assert_eq(strlen(_t_sub_spec(72)) * 8, HEREDOC_RULE_SIZE, "  ... the heredoc rule");
    # The comparison must be able to fail: one-field changes deep in a
    # rule are told apart, comments and blanks are not.
    var cb9_a = "[grammar]\nname = \"cmp\"\nextensions = [\".cmp\"]\n[defaults]\nident_start = \"a-z\"\nident_cont = \"a-z0-9\"\noperators = [\"==\", \"=\"]\n";
    var cb9_c = "[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\"if\", \"else\"]\n[[rules]]\nkind = \"string\"\nmatch = \"heredoc\"\nstart = \"<<\"\nindent = \"-\"\n";
    var cb9_line = "[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\nnot_followed_by = \"[\"\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n";
    var cb9_base = _t_cat3_alloc(cb9_a, cb9_line, cb9_c);
    var cb9_cmt = "# a comment\n[grammar]   # trailing \"quote\n\nname=\"cmp\"\n  extensions = [ \".cmp\" ,]\n[defaults]\n\tident_start = \"a-z\"\nident_cont=\"a-z0-9\"\noperators = [\n  \"==\",   # eq\n  \"=\",\n]\n";
    assert_eq(_t_gtext_eq(cb9_base, cb9_base), 1, "a grammar compares equal to itself");
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_cmt, cb9_line, cb9_c)), 1, "comments and blanks do not change the record");
    var cb9_l2 = "[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\nnot_followed_by = \"{\"\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n";
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_a, cb9_l2, cb9_c)), 0, "a line rule's not_followed_by class is compared");
    var cb9_l3 = "[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\nnot_followed_by = \"[\"\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"`\"\n";
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_a, cb9_l3, cb9_c)), 0, "a pair rule's escape byte is compared");
    var cb9_c2 = "[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\"if\", \"elsif\"]\n[[rules]]\nkind = \"string\"\nmatch = \"heredoc\"\nstart = \"<<\"\nindent = \"-\"\n";
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_a, cb9_line, cb9_c2)), 0, "a words rule's entries are compared");
    var cb9_c3 = "[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\"if\", \"else\"]\n[[rules]]\nkind = \"string\"\nmatch = \"heredoc\"\nstart = \"<<\"\nindent = \"~\"\n";
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_a, cb9_line, cb9_c3)), 0, "a heredoc rule's indent is compared");
    var cb9_a2 = "[grammar]\nname = \"cmp\"\nextensions = [\".cmp\"]\n[defaults]\nident_start = \"a-z\"\nident_cont = \"a-z0-9\"\noperators = [\"=\", \"==\"]\n";
    assert_eq(_t_gtext_eq(cb9_base, _t_cat3_alloc(cb9_a2, cb9_line, cb9_c)), 0, "operator order is compared");
    # Every blob against the file it was made from. The loop walks the
    # blobs (`_grammar_blob_path`), not the grammars that loaded: built
    # from loaded names, it could not see a blob that two names shared
    # (`zz-a` / `zz_a`, one symbol — 2.9.1 audit, reviewer C), and each
    # blob's grammar must be the one registered under its name.
    var cb9_names = vec_new();
    list_languages_into(cb9_names);
    var cb9_buf = alloc(GRAMMAR_FILE_CAP);
    var cb9_bad = 0;
    var cb9_src = 0;
    var cb9_blobs = 0;
    var cb9_gi = 0;
    while (cb9_gi < _grammar_blob_count()) {
        var cb9_path = _grammar_blob_path(cb9_gi);
        var cb9_nm = cb9_path;
        var cb9_blob = _grammar_blob_data(cb9_path);
        var cb9_n = file_read_all(cb9_path, cb9_buf, GRAMMAR_FILE_CAP - 1);
        var cb9_ok = 0;
        _t_diff_off = 0 - 1;
        if ((cb9_blob != 0) && (cb9_n > 0)) {
            store8(cb9_buf + cb9_n, 0);
            var cb9_gf = _gp_parse(cb9_buf, cb9_n);
            var cb9_gb = _gp_parse(cb9_blob, strlen(cb9_blob));
            if ((cb9_gf != 0) && (cb9_gb != 0)) { cb9_ok = _t_rec_eq(cb9_gf, cb9_gb, cb9_spec); }
            if (cb9_ok == 1) {
                var cb9_reg = registry_find_by_name(grammar_name(cb9_gf));
                if (cb9_reg == 0) { cb9_ok = 0; }
                if (cb9_reg != 0) { cb9_ok = _t_rec_eq(cb9_reg, cb9_gf, cb9_spec); }
            }
            cb9_src = cb9_src + cb9_n;
            cb9_blobs = cb9_blobs + strlen(cb9_blob);
        }
        if (cb9_ok == 0) {
            cb9_bad = cb9_bad + 1;
            print("    blob differs from its source: ", 34); print(cb9_nm, strlen(cb9_nm));
            print(" (field +", 9); print_num(_t_diff_off); print(")\n", 2);
        }
        cb9_gi = cb9_gi + 1;
    }
    assert_eq(cb9_bad, 0, "every blob parses to its source file's record, and that grammar is the one registered");
    assert_eq(vec_len(cb9_names), _grammar_blob_count(), "every blob belongs to a loaded grammar");
    assert(cb9_blobs * 2 < cb9_src, "the blobs are under half their sources (comments stripped)");

    test_group("2.9.1 closeout audit");
    # A held heredoc whose delimiter quote removal rewrote lives in the
    # scratch slot, not the buffer; the terminator watch takes an offset
    # into the buffer. Through 2.9.0 the body step passed the slot's
    # address minus the buffer's — the watch read outside its buffer and
    # never fired, or faulted (reviewer A, F1).
    var au9_s = tokenize_stream_new("shell");
    var au9_tb = tokenbuf_new();
    var au9_a = "cat <<\"E\"OF <<\"E\"OF\nx\nEOF\n";
    tokenize_stream_feed(au9_s, au9_a, strlen(au9_a));
    tokenize_stream_drain(au9_s, au9_tb);
    # The bad offset showed two ways, by heap layout: above the buffer, a
    # mode-1 watch reading outside it; below, no watch at all (the drain
    # refuses a negative offset), so every later drain re-scanned —
    # quadratic (reviewer B, F2). The watch now compares against the
    # stream's own copy of the decoded delimiter: mode 1, offset -1.
    assert_eq(load64(au9_s + 104), 1, "a held heredoc with a rewritten delimiter gets the terminator watch");
    assert_eq(load64(au9_s + 112), 0 - 1, "  ... against the stream's copy of the delimiter, not an offset");
    tokenize_stream_feed(au9_s, "EOF\n", 4);
    tokenize_stream_finish(au9_s, au9_tb);
    var au9_one = _t_tokenize("cat <<\"E\"OF <<\"E\"OF\nx\nEOF\nEOF\n", "shell");
    assert_eq(_t_same_tokens(au9_tb, au9_one), 1, "  ... and the stream matches one feed");
    tokenize_stream_free(au9_s);
    # Two consumer grammars whose compose_region rules route into each
    # other recursed once per region: `--- ` x 20,000 overflowed the
    # stack (reviewer C, P2-1). Nesting now stops at DS_MAX_DEPTH.
    var cy9_a = "[grammar]\nname = \"au9cya\"\n[defaults]\nwhitespace = true\nident_start = \"a-z\"\nident_cont = \"a-z\"\n[[rules]]\nmatch = \"compose_region\"\nstart = \"---\"\nend_before = \"\\n[[\"\ninner = \"au9cyb\"\n";
    var cy9_b = "[grammar]\nname = \"au9cyb\"\n[defaults]\nwhitespace = true\nident_start = \"a-z\"\nident_cont = \"a-z\"\n[[rules]]\nmatch = \"compose_region\"\nstart = \"---\"\nend_before = \"\\n[[\"\ninner = \"au9cya\"\n";
    var cy9_ga = _gp_parse(cy9_a, strlen(cy9_a));
    var cy9_gb = _gp_parse(cy9_b, strlen(cy9_b));
    assert_neq(cy9_ga, 0, "two grammars composing into each other load (only self-composition is refused)");
    registry_add(cy9_ga);
    registry_add(cy9_gb);
    var cy9_n = 20000 * 4;
    var cy9_src = alloc(cy9_n + 1);
    var cy9_i = 0;
    while (cy9_i < 20000) { memcpy(cy9_src + cy9_i * 4, "--- ", 4); cy9_i = cy9_i + 1; }
    store8(cy9_src + cy9_n, 0);
    var cy9_tb = tokenbuf_new();
    tokenize_with_grammar(cy9_ga, cy9_src, cy9_n, cy9_tb);
    assert_eq(tb_coverage_sum(cy9_tb), cy9_n, "  ... and 20,000 nested regions tokenize, covered, without exhausting the stack");
    assert(DS_MAX_DEPTH >= 8, "  ... the cap leaves room for real nesting (cyml > markdown > html > css)");
    # A fenced code block in a list item or a blockquote closes at its own
    # indented / quoted closer. Through 2.9.0 the closer had to be in
    # column 0, so the fence below ran to the python fence and took its
    # opener as the close, pairing every later fence one off (2.9.1).
    var fe9_tb = _t_tokenize("1. Build:\n   ```sh\n   make all\n   ```\n2. Then.\n\n```python\nx = 1\n```\n", "markdown");
    assert_eq(_t_len_at(fe9_tb, 13), 6, "markdown: an indented fence opener");
    assert_eq(_t_len_at(fe9_tb, 22), 4, "  ... its body is tokenized (`make`), not one string to the next fence");
    assert_eq(_t_kind_at(fe9_tb, 34), TK_PUNCTUATION, "  ... and it closes at its own indented closer");
    assert_eq(_t_len_at(fe9_tb, 48), 10, "  ... so the next fence's opener is an opener");
    assert_eq(_t_kind_at(fe9_tb, 58), TK_IDENT, "  ... and its body is python");
    var fe9_bq = _t_tokenize("> ```c\n> a\n> ```\n\n```\n", "markdown");
    assert_eq(_t_kind_at(fe9_bq, 13), TK_PUNCTUATION, "markdown: a blockquoted fence closes at `> ````");
    assert_eq(tb_error_count(fe9_bq), 0, "  ... with no error tokens (the c grammar read the quoted backticks)");
    var fe9_c0 = _t_tokenize("```\na\n    ```\nb\n```\n", "markdown");
    assert_eq(_t_kind_at(fe9_c0, 10), TK_PUNCTUATION, "markdown: an indented closer closes a column-0 fence too (CommonMark allows 0-3)");
    # Fence tags resolve by name, then by extension or interpreter (2.9.1):
    # `sh` / `bash` were 3,140 of one machine's 7,607 tagged fences.
    var fe9_sh = _t_tokenize("```bash\necho hi\n```\n", "markdown");
    assert_eq(_t_len_at(fe9_sh, 8), 4, "markdown: ```bash routes to shell (by interpreter)");
    var fe9_py = _t_tokenize("```Python\nx = 1\n```\n", "markdown");
    assert_eq(_t_kind_at(fe9_py, 10), TK_IDENT, "markdown: ```Python routes to python (case ignored)");
    assert_eq(registry_find_fence_tag("sh"), registry_find_by_name("shell"), "fence tag `sh` -> shell (extension)");
    assert_eq(registry_find_fence_tag("cyr"), registry_find_by_name("cyrius"), "fence tag `cyr` -> cyrius (extension)");
    assert_eq(registry_find_fence_tag("node"), registry_find_by_name("javascript"), "fence tag `node` -> javascript (interpreter)");
    assert_eq(registry_find_fence_tag("text"), 0, "fence tag `text` -> no grammar");
    var fe9_tx = _t_tokenize("```text\nplain\n```\n", "markdown");
    assert_eq(_t_len_at(fe9_tx, 8), 6, "  ... and its body stays one string");
    # `end_indent` belongs to compose_fenced rules, and is not empty.
    var fe9_g1 = "[grammar]\nname = \"x\"\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nend_indent = \" \"\n";
    assert_eq(_gp_parse(fe9_g1, strlen(fe9_g1)), 0, "end_indent on a pair rule rejects the grammar");
    var fe9_g2 = "[grammar]\nname = \"x\"\n[[rules]]\nmatch = \"compose_fenced\"\nstart = \"~~~\"\nend = \"~~~\"\nend_indent = \"\"\n";
    assert_eq(_gp_parse(fe9_g2, strlen(fe9_g2)), 0, "an empty end_indent rejects the grammar");
    # compose_region with no `end_before` runs to EOF (ADR 0019); 2.5.2's
    # validation rejected it (reviewer C, P3-3).
    var eb9_g = "[grammar]\nname = \"au9reg\"\n[defaults]\nwhitespace = true\n[[rules]]\nmatch = \"compose_region\"\nstart = \"---\"\ninner = \"json\"\n";
    var eb9_gr = _gp_parse(eb9_g, strlen(eb9_g));
    assert_neq(eb9_gr, 0, "compose_region without end_before loads");
    registry_add(eb9_gr);
    var eb9_src = "--- [1, 2]\n{\"a\": true}\n";
    var eb9_one = _t_tokenize(eb9_src, "au9reg");
    assert_eq(_t_kind_at(eb9_one, 4), TK_PUNCTUATION, "  ... its body is the inner grammar's to EOF");
    assert_eq(tb_coverage_sum(eb9_one), strlen(eb9_src), "  ... covered");
    var eb9_s = tokenize_stream_new("au9reg");
    var eb9_tb = tokenbuf_new();
    var eb9_i = 0;
    while (eb9_i < strlen(eb9_src)) {
        tokenize_stream_feed(eb9_s, eb9_src + eb9_i, 1);
        tokenize_stream_drain(eb9_s, eb9_tb);
        eb9_i = eb9_i + 1;
    }
    tokenize_stream_finish(eb9_s, eb9_tb);
    assert_eq(_t_same_tokens(eb9_tb, eb9_one), 1, "  ... and streamed a byte at a time it matches one feed (the until-finish hold)");
    tokenize_stream_free(eb9_s);
    # Keys that were accepted and then did nothing are refused (reviewer C, P3-4).
    var vl9_a = "[grammar]\nname = \"x\"\n[defaults]\nnumber_decimal = true\nnumber_separator = \"\\n\"\n";
    assert_eq(_gp_parse(vl9_a, strlen(vl9_a)), 0, "a line-break number_separator rejects the grammar");
    var vl9_b = "[grammar]\nname = \"x\"\n[defaults]\nnumber_decimal = true\nnumber_separator = \"a\"\n";
    assert_eq(_gp_parse(vl9_b, strlen(vl9_b)), 0, "a letter number_separator rejects the grammar");
    var vl9_c = "[grammar]\nname = \"x\"\n[defaults]\nnumber_decimal = true\nnumber_separator = \"_\"\n";
    assert_neq(_gp_parse(vl9_c, strlen(vl9_c)), 0, "  ... `_` still loads");
    var vl9_d = "[grammar]\nname = \"x\"\n[defaults]\nnumber_float = true\n";
    assert_eq(_gp_parse(vl9_d, strlen(vl9_d)), 0, "number_float without number_decimal rejects the grammar");
    var vl9_e = "[grammar]\nname = \"x\"\n[defaults]\nident_start = \"a-w\"\nident_cont = \"a-z\"\nident_lead = \"x\"\n";
    assert_eq(_gp_parse(vl9_e, strlen(vl9_e)), 0, "an ident_lead byte outside ident_start rejects the grammar");
    # SCSS: a lone `$` is an operator, not an error (reviewer A, F3).
    var sc9_tb = _t_tokenize("a{b:$ c}", "scss");
    assert_eq(_t_kind_at(sc9_tb, 4), TK_OPERATOR, "scss: a lone `$` is an operator");
    assert_eq(tb_error_count(sc9_tb), 0, "  ... no error token");
    # A heredoc delimiter over 255 bytes that needs no rewriting is a
    # heredoc again (2.7.1 regression; reviewer A, F2).
    var hd9_n = 6 + 300 + 1 + 5 + 300 + 8;
    var hd9_src = alloc(hd9_n + 1);
    memcpy(hd9_src, "cat <<", 6);
    var hd9_i = 0;
    while (hd9_i < 300) { store8(hd9_src + 6 + hd9_i, 65); store8(hd9_src + 312 + hd9_i, 65); hd9_i = hd9_i + 1; }
    memcpy(hd9_src + 306, "\nbody\n", 6);
    memcpy(hd9_src + 612, "\necho z\n", 8);
    store8(hd9_src + hd9_n, 0);
    var hd9_tb = _t_tokenize(hd9_src, "shell");
    assert_eq(_t_kind_at(hd9_tb, 307), TK_STRING, "shell: a 300-byte heredoc delimiter opens a heredoc");
    assert_eq(_t_len_at(hd9_tb, 307), 305, "  ... body and terminator are one string");
    # Nix floats (ADR 0026, opted in 2.9.1).
    var nx9_tb = _t_tokenize("x = 1.5;\n", "nix");
    assert_eq(_t_len_at(nx9_tb, 4), 3, "nix: `1.5` is one number");
    # The filename rule (ADR 0025, 2.9.1): a variant must start with a
    # letter and not end in a tool's suffix; an ending must be anchored.
    assert_streq(_t_path("/usr/share/man/man5/Dockerfile.5.gz"), "(none)", "2.9.1: Dockerfile.5.gz (a man page) is not a dockerfile");
    assert_streq(_t_path("Makefile.rej"), "(none)", "2.9.1: Makefile.rej is not a makefile");
    assert_streq(_t_path("x/Dockerfile.dockerignore"), "(none)", "2.9.1: Dockerfile.dockerignore is not a dockerfile");
    assert_streq(_t_path("CMakeFiles/Makefile.cmake"), "(none)", "2.9.1: Makefile.cmake is CMake's, not make's");
    assert_streq(_t_path("notaMakefile"), "(none)", "2.9.1: a filename ending is anchored (notaMakefile)");
    assert_streq(_t_path("x/Makefile.in.in"), "makefile", "2.9.1: Makefile.in.in -> makefile");
    assert_streq(_t_path("Makefile.orig"), "makefile", "2.9.1: Makefile.orig -> makefile");
    assert_streq(_t_path("ci/prod-Dockerfile"), "dockerfile", "2.9.1: prod-Dockerfile -> dockerfile");
    assert_streq(_t_path("GNUmakefile"), "makefile", "2.9.1: GNUmakefile -> makefile");
    # The 8 MiB compose hold is enforced (reviewer B: nothing exercised
    # it). An unclosed `<style>` fed in 64 KB chunks: no feed error, the
    # held buffer stays within the bound, every byte covered.
    var cb91_s = tokenize_stream_new("html");
    var cb91_tb = tokenbuf_new();
    var cb91_line = "a { color: red; }\n";
    var cb91_ll = strlen(cb91_line);
    var cb91_chunk = alloc(65536);
    var cb91_cl = 0;
    while (cb91_cl + cb91_ll <= 65536) { memcpy(cb91_chunk + cb91_cl, cb91_line, cb91_ll); cb91_cl = cb91_cl + cb91_ll; }
    var cb91_fed = 8;
    var cb91_bad = 0;
    var cb91_max = 0;
    tokenize_stream_feed(cb91_s, "<style>\n", 8);
    while (cb91_fed < 9437184) {
        if (tokenize_stream_feed(cb91_s, cb91_chunk, cb91_cl) != 0) { cb91_bad = cb91_bad + 1; }
        cb91_fed = cb91_fed + cb91_cl;
        tokenize_stream_drain(cb91_s, cb91_tb);
        if (load64(cb91_s + 8) > cb91_max) { cb91_max = load64(cb91_s + 8); }
    }
    tokenize_stream_finish(cb91_s, cb91_tb);
    assert_eq(cb91_bad, 0, "a 9 MB unclosed <style> streams without a feed error");
    assert(cb91_max <= VYK_COMPOSE_HOLD_MAX + 65536, "  ... and the held buffer stays within the 8 MiB bound");
    assert_eq(tb_coverage_sum(cb91_tb), cb91_fed, "  ... and the tokens cover every byte");
    tokenize_stream_free(cb91_s);

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
