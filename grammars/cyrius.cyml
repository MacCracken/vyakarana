# cyrius — Cyrius tokenizer grammar
#
# Rule scheme per ADR 0005. Cyrius is C-like syntactically: line
# comments with `#`, double-quoted strings, C-family operators, and
# a small reserved-word set. Corpus is the vidya reference sample.
#
# Scope: covers what vidya's `content/lexing_and_parsing/cyrius.cyr`
# uses. Known future gaps (ADR candidates when they come up):
#   - Char literals are ON since 2.5.2 (`char_literal = true`).
#     Cyrius has them — `'"'`, `'\n'`, `'\''`, `'A'` all compile —
#     and real code uses them (`str_builder_putc(sb, '"')`,
#     `!= '/'`). This note used to say single quotes were
#     "comment-only in practice"; with char literals off, `'"'`
#     emitted TK_ERROR and opened a string that ran on to the next
#     `"`. vidya's `language/features.cyml` and agnosys code both hit
#     it. A `'` with no closing quote at the right offset still
#     falls through to the operator step, so stray apostrophes are
#     no worse than before. See ADR 0010.
#   - Type annotations (`x: i64`) tokenize as ident `:` ident with
#     ident_cont covering `i64` — no special handling needed.

[grammar]
name = "cyrius"
# `.cyml` belongs to the cyml grammar; it was listed here too until
# 2.6.2, when the arrays became checked declarations (ADR 0025).
extensions = [".cyr"]

[defaults]
shebang = false
whitespace = true

# Standard C-like identifier class.
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_separator = "_"    # `1_000` (ADR 0026)

# No shell-style $X variable expansion.
special_vars = false

# `'C'` / `'\C'` / `'\xHH'` / longer escapes as one string token
# (ADR 0010). See the header note.
char_literal = true

# Operators in longest-match order.
operators = [
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "+=", "-=", "*=", "/=", "%=",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^", "<", ">",
]

# Punctuation, longest-match.
punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Directives and attributes — `#ifdef X`, `#endif`, `#derive(Eq)`,
# `#must_use`, `#host_only` … — one line rule per word, each at a line
# start (or after blanks: most are indented) and ending at a non-ident
# byte, so `x #c` and `# text` stay comments. The set is every
# line-start `#word` in the cyrius toolchain and the local Cyrius
# sources (2.7.1, ADR 0027); through 2.7.0 every directive line was a
# comment.
[[rules]]
kind = "preprocessor"
match = "line"
start = "#ifdef"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#ifndef"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#ifplat"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#if"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#elif"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#elseif"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#else"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#endif"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#define"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#derive"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#deprecated"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#must_use"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#inline"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#host_only"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#pure"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#naked"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"

[[rules]]
kind = "preprocessor"
match = "line"
start = "#io"
start_after = " \t\n\r"
not_followed_by = "A-Za-z0-9_"


[[rules]]
kind = "comment"
match = "line"
start = "#"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    "fn", "var",
    "if", "else",
    "while", "for", "break", "continue",
    "return",
    "include",
    "enum", "struct",
    "true", "false",
]
