# ocaml — OCaml tokenizer grammar
#
# Rule scheme per ADR 0005. OCaml's surface differs from the
# C-family on several axes:
#   - `(* … *)` block comments. Nestable per spec; the pair-rule
#     scanner closes at the first `*)`, so after a nested comment
#     the rest of the outer one tokenizes as code — known gap.
#   - No line comments. `//` and `#` are not comment markers.
#   - `'a` type variables AND `'c'` char literals share the same
#     opening byte. The char_literal helper's lifetime-preservation
#     logic ([ADR 0010](../docs/adr/0010-char-literal-default.md))
#     handles the disambiguation: `'a` (no closing `'` at offset
#     2) falls through to operator + ident; `'a'` matches the
#     char-literal shape.
#   - Rich operator surface: `|>` (pipe), `<-` (mutable assign),
#     `:=` (ref assign), `->` (function arrow), `::` (list cons),
#     `;;` (toplevel terminator), `[|…|]` (array literal), `**`
#     (power). `::` / `;;` are operators since 2.5.2.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship an OCaml reference sample yet. The local
# `tests/corpus/concept.ml` mirrors the lexer+parser theme used
# elsewhere, exercising algebraic data types (`type expr = | Num
# | Unary | BinOp`), pattern matching with guards, mutable
# references, and the OCaml keyword set. Replace with a vidya
# snapshot when one ships.
#
# Known gaps (not triggered by the stand-in):
#   - Quoted strings `{|…|}` and `{tag|…|tag}`. Not in the
#     stand-in. Variable-length-delimiter form — same scanner-
#     shape gap as Lua's `[==[…]==]`, Ruby/PHP heredocs, Swift
#     raw strings.
#   - `1_000_000` and floats (`1.5`, `1e5`) are one number since
#     2.7.0 (ADR 0026); OCaml's trailing-dot float `1.` still splits.

[grammar]
name = "ocaml"
extensions = [".ml", ".mli"]

[defaults]
shebang = false
whitespace = true

ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_separator = "_"    # `1_000` (ADR 0026)

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order. OCaml-specific: `|>` (pipe),
# `<-` (mutable record-field assignment), `:=` (ref assignment),
# `->` (function arrow), `::` (list cons), `;;` (toplevel
# terminator), `**` (power),
# `@@` (function application without precedence), `@` (list
# concat). `<>` is structural inequality (not equal).
operators = [
    # `::` (list cons) and `;;` (toplevel terminator) are core
    # OCaml; through 2.5.1 neither was listed and both split into
    # two punctuation bytes (2.5.2 audit P3-a).
    "::", ";;",
    "<<=", ">>=",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=", "<>",
    "->", "<-", ":=", "|>", "@@", "**",
    "+=", "-=", "*=", "/=",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?", "@", "#",
    # `'` is the type-variable prefix (`'a`, `'b`, `'_weak`).
    # The char_literal helper yields when there's no closing
    # quote at the right offset, so the leading `'` falls
    # through here as a 1-byte operator and the body
    # tokenizes as a regular ident on the next iteration —
    # same fall-through pattern as Rust lifetimes (ADR 0010).
    "'",
    # Backtick opens a polymorphic-variant tag (`` `Foo ``). `$`
    # is a legal OCaml operator character — user-defined operators
    # may be built from any of `! $ % & * + - . / : < = > ? @ ^ | ~`.
    "`", "$",
]

# Punctuation. `;` is statement separator; `;;` (toplevel
# terminator) and `::` (list cons) match as 2-byte operators
# above, which run before punctuation.
punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# `(* … *)` block comments. Non-nestable in this implementation;
# the spec allows nesting but the pair-rule scanner closes at the
# first `*)` (see grammar header).
[[rules]]
kind = "comment"
match = "pair"
start = "(*"
end = "*)"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / definition
    "module", "open", "include", "struct", "sig",
    "functor", "begin", "end",
    # Type-related
    "type", "of", "and",
    # Declaration heads
    "let", "rec", "in", "fun", "function",
    # Pattern matching / control flow
    "match", "with", "when",
    "if", "then", "else",
    "while", "do", "done", "for", "to", "downto",
    # Exception handling
    "try", "raise", "exception",
    # Boolean / comparison words
    "true", "false",
    "as", "or", "not",
    # Object-oriented
    "class", "object", "method", "inherit",
    "initializer", "val", "mutable", "private",
    "virtual", "constraint",
    # Misc
    "lazy", "assert", "external", "ref",
    "land", "lor", "lxor", "lnot", "lsl", "lsr", "asr",
    "mod",
]
