# terraform — Terraform / HCL tokenizer grammar
#
# Rule scheme per ADR 0005. Named `terraform` because that's the
# primary consumer (`.tf` / `.tfvars` files), but the language
# itself is **HCL** (HashiCorp Configuration Language) and the
# same grammar covers Packer, Vault, Nomad, Consul, and any
# other HashiCorp-stack tool that consumes `.hcl` config.
#
# Tokenizer surface:
#
#   - `#` line comments (canonical Terraform style).
#   - `//` line comments (also valid).
#   - `/* ... */` block comments.
#   - Strings: `"..."` with `\` escapes and `${expr}`
#     interpolation. Heredocs (`<<EOT … EOT` and `<<-EOT … EOT`)
#     not modeled — variable terminator, same scanner-shape gap
#     as Lua / Ruby / PHP.
#   - Numbers: integers and decimals. No hex / binary / octal.
#   - Identifiers: `[A-Za-z_][A-Za-z0-9_-]*`. `-` in
#     `ident_cont` for kebab-case names that show up in
#     resource types (`aws_s3_bucket`, `azurerm_role_assignment`)
#     and names (`my-bucket`).
#   - Block syntax: `resource "type" "name" { ... }`. The
#     identifiers and quoted strings tokenize naturally;
#     no special "block-header" token kind needed.
#   - Operators: standard arithmetic + ternary (`?` / `:`),
#     equality, comparison, logical, splat (`*`), variadic
#     (`...`), arrow (`=>`).
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# `tests/corpus/concept.tf` exercises resource blocks, variables,
# locals, outputs, dynamic blocks, functions, conditionals,
# both comment forms, attribute/block distinction.
#
# Known gaps:
#   - **Heredocs** `<<EOT ... EOT` / `<<-EOT ... EOT` — variable
#     terminator. Not modeled; the body tokenizes as ordinary
#     code (would be flagged in tests/corpus/concept.tf if used).
#   - **String interpolation** `${expr}` — body tokenizes as part
#     of the surrounding string. Same trade-off as JS template
#     literals.
#   - **Splat shorthand** `aws_instance.web.*.id` — splat `*`
#     tokenizes as a 1-byte operator amidst the dotted access.
#     Coverage holds; theme can re-pair.

[grammar]
name = "terraform"
extensions = [".tf", ".tfvars", ".hcl"]

[defaults]
shebang = false
whitespace = true

# `-` in ident_cont — kebab-case names in resource definitions.
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_-"

number_decimal = true
number_0x      = false
number_0b      = false
number_0o      = false

special_vars = false
unicode_ident = true
char_literal  = false

# Operators in longest-match order. HCL-specific: `=>` for
# for-expressions, `...` for variadic / spread.
operators = [
    "==", "!=", "<=", ">=",
    "&&", "||",
    "=>",
    "...",
    "=", "+", "-", "*", "/", "%",
    "<", ">", "!",
    "?",
    "$",
]

punctuation = [
    "(", ")", "[", "]", "{", "}",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Block comment `/* ... */`. Pair rules run at scanner step 3,
# AFTER line rules at step 2. Line rule for `//` checks the
# full 2-byte marker, so `/*` doesn't match `//` and falls
# through to this pair rule.
[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


# Line comment `//`. The 2-byte marker means `/*` won't match
# (different second byte). No pair-vs-line collision because
# the line scanner checks the full marker length.
[[rules]]
kind = "comment"
match = "line"
start = "//"


# Line comment `#`. Canonical Terraform style.
[[rules]]
kind = "comment"
match = "line"
start = "#"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    "true", "false", "null",
    "if", "else", "endif",
    "for", "endfor", "in",
]
