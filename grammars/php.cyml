# php — PHP tokenizer grammar
#
# Rule scheme per ADR 0005. C-family at the token level — close in
# shape to java.cyml + cpp.cyml. The `<?php` open tag and `?>`
# close tag tokenize as `<` operator + `?` operator + `php` ident
# (and `?` op + `>` op for the close), which is structurally
# correct but not semantically distinguished. Themes that want
# to colour the open tag specially can post-process by token
# text.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a PHP reference sample yet. The local
# `tests/corpus/concept.php` mirrors the lexer+parser theme used
# elsewhere, exercising `enum`, `readonly` classes, `match`
# expressions, the namespace + use surface, and the PHP keyword
# set. Replace with a vidya snapshot when one ships.
#
# `$` in ident_start: PHP variables are `$name`, so `$` joins
# `ident_start` (same pragmatic call as Rust's `$`-macros and
# Zig's `@`-builtins). `$this`, `$source`, `$this->pos`
# etc. tokenize as a single ident; the `->` arrow is a separate
# 2-byte operator.
#
# Known gaps (not triggered by the stand-in):
#   - (Not a gap since 2.9.5: heredocs and nowdocs, `<<<EOT … EOT;`,
#     are one string per body, ADR 0030; the `<<<` itself tokenizes as
#     `<<` `<`, as before.)
#   - `1_000_000` (PHP 7.4) and floats are one number since 2.7.0
#     (ADR 0026).
#   - String interpolation (`"$x"` and `"{$x}"`) stays inside
#     the string-pair span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).

[grammar]
name = "php"
extensions = [".php", ".phtml"]
shebangs = ["php"]

[defaults]
# `#!/usr/bin/env php` routes here; the line is one shebang token
# (it read as a `#` comment through 2.6.1).
shebang = true
whitespace = true

ident_start = "A-Za-z_$"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = false
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_lead_dot = true    # `.5` (ADR 0026, 2.9.7)
number_trail_dot = true   # `1.`, `1.e5`; `1..2` and `1.max` stay split (2.9.7)
number_separator = "_"    # `1_000` (ADR 0026)

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order — every multi-byte entry sits
# ahead of its own prefix (true since 2.5.2; see `===` below), and
# the scanner takes the first entry that matches. PHP-specific:
# `->` (member access), `=>` (array key/value, match arms), `::` (scope
# resolution), `??` / `??=` (null-coalesce), `?->` (null-safe
# member access, PHP 8), `<=>` (spaceship, PHP 7), `**` (power),
# `**=` (power-assign), plus the standard C-family set.
operators = [
    "<<=", ">>=", "<=>",
    "??=", "**=",
    "?->",
    "<<", ">>",
    "&&", "||",
    # `===` / `!==` must precede `==` / `!=`: the scanner takes the
    # FIRST entry that matches, so the shorter pair made the strict
    # forms unreachable — `$a === $b` came out `==` + `=` through
    # 2.5.1 (2.5.2 audit P2-7).
    "===", "!==",
    "==", "!=", "<=", ">=",
    "->", "=>", "::", "??", "**",
    "+=", "-=", "*=", "/=", "%=", ".=",
    "&=", "|=", "^=",
    "++", "--",
    "=", "+", "-", "*", "/", "%", ".",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
    "@",
    # `\` is PHP's namespace separator (`Vyakarana\Concept`,
    # `\RuntimeException`). The string-pair rule's `escape =
    # "\\"` consumes `\<C>` inside string spans, so `\` outside
    # strings cleanly tokenizes as a 1-byte operator.
    "\\",
]

punctuation = [
    "#[",
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":",
]


# ── Rules ──────────────────────────────────────────────────────────

# Heredocs and nowdocs (ADR 0023, 0030; 2.9.5): `<<<EOT`, `<<<"EOT"`,
# `<<<'EOT'`. Since PHP 7.3 the terminator may be indented and followed
# by code (`EOT;`, `EOT)`): the string ends after it.
[[rules]]
kind = "string"
match = "heredoc"
start = "<<<"
indent_by = "blanks"
indent_always = true
term_rest = true
delim = "ident"


# PHP supports both `//` and `#` line comments. `#` is also a
# comment in PHP (since forever) but is the immediate prefix in
# ARM — different grammars own that byte differently.
[[rules]]
kind = "comment"
match = "line"
start = "//"


[[rules]]
kind = "comment"
match = "line"
start = "#"
# PHP 8 attributes `#[Route("/x")]` are code, not comments (2.7.1,
# ADR 0027): `#[` is punctuation, then ordinary tokens to its `]`.
not_followed_by = "["


# Block comments `/* … */`. Same shape as C/Java/C++.
[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / namespace
    "namespace", "use", "as",
    # Type-declaration heads
    "class", "interface", "trait", "enum",
    "extends", "implements",
    # Modifiers / visibility
    "public", "private", "protected",
    "static", "final", "abstract", "readonly",
    # Declaration heads
    "function", "fn", "const", "var",
    "global",
    # Control flow
    "if", "elseif", "else", "while", "do", "for", "foreach",
    "switch", "case", "default", "match",
    "break", "continue", "return", "yield",
    "try", "catch", "finally", "throw",
    "goto",
    # Object-oriented
    "new", "this", "self", "parent", "instanceof", "clone",
    # Reserved literals
    "true", "false", "null",
    # Type hints / declarations
    "void", "bool", "int", "float", "string", "array",
    "object", "callable", "iterable", "mixed", "never",
    # Misc reserved
    "echo", "print", "require", "require_once", "include",
    "include_once", "declare", "endif", "endforeach",
    "endwhile", "endfor", "endswitch",
    "and", "or", "xor", "not",
    "list", "isset", "unset", "empty",
]

# Backtick operator — PHP's `` `ls -l` `` is shell_exec() by another
# spelling.
[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"
escape = "\\"

