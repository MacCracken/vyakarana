# toml — TOML tokenizer grammar
#
# Rule scheme per ADR 0005: narrow [[rules]] + configured default
# scanner. TOML is the simplest possible test for M3's "new grammar
# = new .cyml file" promise — structurally close to our own grammar
# file format.
#
# Scope: keys, strings ("..." / '...' with escape-in-double-only),
# line comments, decimal/hex/oct/bin numbers, `=` / `.` operators,
# `[...]` / `[[...]]` / `{...}` / `,` punctuation, true/false/inf/nan
# keywords.
#
# Multi-line strings: vidya's `concept.toml` files use `content =
# '''…'''` for embedded prose blocks, so the triple-quoted forms
# are scoped IN. `"""…"""` (basic, escape-aware) and `'''…'''`
# (literal, no escapes) are ordered before the single-quoted rules
# below — the pair-matcher takes the first rule whose start string
# matches, so the longer prefix has to come first. See
# [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md).
#
# Out of scope (still no corpus):
#   - Float literals (`3.14`)
#   - Date/datetime literals (`1979-05-27T07:32:00Z`)
# Both remain ADR candidates if a future corpus needs them.

[grammar]
name = "toml"
extensions = [".toml"]

[defaults]
# No shebang; TOML isn't an executable format.
shebang = false

# Whitespace runs (space, tab, \n, \r) emit as TK_WHITESPACE.
whitespace = true

# Bare keys: letters/underscore to start, letters/digits/underscore/
# hyphen to continue. Putting `-` in ident_cont but not ident_start
# lets `foo-bar` be one ident while `-42` still tokenizes as
# `operator(-) + number(42)`.
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_-"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true

# No shell-style $X variable syntax.
special_vars = false

# TOML has only a few structural operators. `=` is assignment,
# `.` separates dotted keys (pkg.name = 1), `+` and `-` prefix signed
# numbers (`-42`, `+inf`). Without `+`/`-` here, signed number
# literals fall through to TK_ERROR.
operators = [
    "=",
    ".",
    "+", "-",
]

# Punctuation, longest-match order. `[[` / `]]` for array-of-tables;
# `[` / `]` for single tables; `{` / `}` / `,` for inline tables.
punctuation = [
    "[[", "]]",
    "[", "]", "{", "}", ",",
    # `:` separates the time fields of an RFC 3339 datetime —
    # `d = 2026-07-31T10:30:00Z`. TOML is otherwise strict enough
    # that every other unlisted byte really is invalid, so `:` is
    # the one genuine hole in this grammar.
    ":",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "#"


[[rules]]
kind = "string"
match = "pair"
start = "\"\"\""
end = "\"\"\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'''"
end = "'''"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"


[[rules]]
kind = "keyword"
match = "words"
words = [
    "true", "false", "inf", "nan",
]
