# shell — bash / sh / zsh / dash tokenizer grammar
#
# Comments here are parsed on every grammar load — keep them short;
# rationale lives in the ADRs.
#
# Regression bar: on tests/corpus/shell.sh, tokens are byte-identical to
# the hand-coded oracle src/grammars/shell.cyr (smoke checks it). Not
# equivalent in general: backticks, UTF-8 words and heredocs are handled
# here only.
#
# `#` opens a comment only at word start (ADR 0022); heredocs are one
# string token (ADR 0023). Both 2.6.0.

[grammar]
name = "shell"
extensions = [".sh", ".bash"]
shebangs = ["sh", "bash", "zsh", "dash"]

[defaults]
# Emit `#!` on line 0, column 0 as TK_PREPROCESSOR (to EOL).
shebang = true

# Whitespace runs (space, tab, \n, \r) emit as TK_WHITESPACE.
whitespace = true

# Identifiers: [A-Za-z_][A-Za-z0-9_]*; keywords via the words rule.
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_"

# Unquoted words carry arbitrary UTF-8 — `echo café`. ADR 0009.
unicode_ident = true

# Numbers: decimal, plus 0x / 0b / 0o prefixes.
number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true

# `$X`, X in #?@!*$- or 0-9, is one 2-byte operator (digits since 2.6.0).
special_vars = true

# Operators in longest-match order. The scanner tries them in this
# sequence for each position; first match wins.
operators = [
    "<<<",
    "&&", "||", "==", "!=", "=~", "<=", ">=", ">>", "<<", "<>",
    "++", "--", "+=", "-=", "*=", "/=", "%=", "->",
    "=", "|", "&", "<", ">", "+", "-", "*", "/", "%", "!", "~",
    # Escapes outside quotes, ahead of the bare `\` (2.6.0).
    "\\\\", "\\\"", "\\'", "\\`", "\\$", "\\#", "\\ ",
    "?", "@", "^", "\\",
    # `#` not at word start: `${#v}`, `${x#p}`, `a#b` (ADR 0022).
    "#",
]

# Punctuation, longest-match order.
punctuation = [
    "[[", "]]", "((", "))", ";;",
    "(", ")", "{", "}", "[", "]", ";", ":", ",", ".",
]


# ── Rules ── (dispatch order: docs/architecture/002)


[[rules]]
kind = "comment"
match = "line"
start = "#"
start_after = " \t\n\r;&|()<>"


# Here-documents (ADR 0023): `<<EOF` `<<'EOF'` `<<-EOF` …; body through
# terminator = one string. Not in shell.cyr.
[[rules]]
kind = "string"
match = "heredoc"
start = "<<"
indent = "-"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"


[[rules]]
kind = "keyword"
match = "words"
words = [
    "if", "then", "else", "elif", "fi",
    "for", "while", "until", "do", "done",
    "case", "esac", "in",
    "function", "return",
    "break", "continue",
    "select", "time",
]

# Command substitution `` `cmd` `` as one string (as julia.cyml).
[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"
escape = "\\"

