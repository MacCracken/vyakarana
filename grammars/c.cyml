# c — C tokenizer grammar
#
# Rule scheme per ADR 0005. C is close to Rust at the token level:
# `//` line comments, double-quoted strings, C-family operators, a
# slightly-larger reserved-word set including type keywords.
#
# Corpus: tests/corpus/c.c (vidya-backed).
#
# Block comments `/* ... */` are recognised via a `match = "pair"`
# rule below. C's block comments are non-nestable, so the simple
# greedy match matches the spec. Triggered by `vidya/content/<topic>/c.c`
# files that lead with a `/* Vidya — … */` header.
#
# Known gaps for future ADRs (not triggered by the vidya sample):
#   - Preprocessor directives (`#include`, `#define`, `#ifdef`) are
#     tokenized as `#` op + keyword-or-ident + ... rather than a
#     unified `preprocessor` kind. `<stdio.h>` becomes
#     `<` + ident + `.` + ident + `>`. Coverage and no-error bars
#     hold. A unified `preprocessor` kind would need an ADR and a
#     token-kind decision; deliberately still open, and not blocking
#     any consumer — see CHANGELOG 2.3.4 §Notes.

[grammar]
name = "c"
extensions = [".c", ".h"]

[defaults]
shebang = false
whitespace = true

ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = false
number_0o      = false

special_vars = false

# UTF-8 in `/* … */` and `//` comment text → one ident instead of
# per-byte errors. See ADR 0009.
unicode_ident = true

# `'C'` / `'\C'` / `'\xHH'` tokenize as a single TK_STRING
# instead of fragmenting into op/body/op. See ADR 0010.
char_literal = true

# Operators in longest-match order. C-specific: `->` (struct deref),
# `++` / `--` (increment), compound assignment, `&&`/`||`,
# comparison, bit shifts, `?` for ternary, `'` for char-lit (splits
# into 3 tokens — see grammar header). `#` for preprocessor.
operators = [
    "<<=", ">>=",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "++", "--",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=",
    "->",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?", "'", "\\",
    "#",
]

# Punctuation, longest-match.
punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "//"


# Block comments `/* … */`. C's block comments are non-nestable
# (unlike Rust's), so the simple greedy match — close at the first
# `*/` — matches the spec. No escape: `\` inside a comment is just
# a backslash byte, not an escape.
[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Control flow
    "if", "else", "while", "for", "do", "switch", "case", "default",
    "break", "continue", "return", "goto",
    # Type-declaration
    "typedef", "struct", "union", "enum",
    # Storage-class / qualifiers
    "auto", "register", "static", "extern", "const", "volatile",
    "inline", "restrict",
    # Primitive types
    "void", "char", "short", "int", "long",
    "float", "double", "signed", "unsigned",
    "_Bool", "_Complex",
    # Operator-like keywords
    "sizeof",
]
