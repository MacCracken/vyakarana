# rust — Rust tokenizer grammar
#
# Rule scheme per ADR 0005. Rust uses `//` line comments (not `#`),
# which frees `#` to tokenize as an operator for attribute prefix
# (`#[derive(...)]` → `#` op, `[` punct, ident, `]` punct).
#
# Scope: covers what vidya's content/lexing_and_parsing/rust.rs
# exercises.
#
# Macro metavariables: `$` is in `ident_start` so `$expr`, `$tok`,
# `$crate`, etc. tokenize as a single `ident`. The bare `$` that
# leads `$( ... )*` repetition tokenizes as a length-1 ident. See
# [ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md).
#
# Known gaps for future ADRs (not triggered by the vidya sample):
#   - Nested block comments: `/* a /* b */ c */` closes at the first
#     `*/` (the rule below says why).
#   - (Not a gap since 2.9.5: raw strings with hashes, `r#"..."#`,
#     `br##"..."##`, are one string token — ADR 0030. `r"..."`, `b"..."`,
#     `br"..."`, `c"..."` and byte chars `b'x'` are since 2.7.1, ADR 0027.)
#   - (Not a gap since 2.9.7: suffixes `42u32`, `42_u32`, `3.14_f64` and
#     the trailing-dot `1.` join the number, ADR 0026.) Floats and
#     `1_000` are one number since 2.7.0; `t.0.1` lexes `0.1` as one
#     float, exactly as rustc does.

[grammar]
name = "rust"
extensions = [".rs"]

[defaults]
shebang = false
whitespace = true

ident_start = "A-Za-z_$"
ident_cont  = "A-Za-z0-9_"

# Non-ASCII identifiers, stable since Rust 1.53 (RFC 2457).
# ADR 0009.
unicode_ident = true

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_trail_dot = true   # `1.`, `1.e5`; `1..2` and `1.max` stay split (2.9.7)
# Type suffixes join the literal: `1u32`, `1_u32`, `2.5f64` (2.9.7).
number_suffixes = ["u8", "u16", "u32", "u64", "u128", "usize", "i8", "i16", "i32", "i64", "i128", "isize", "f32", "f64"]
number_separator = "_"    # `1_000` (ADR 0026)
# `b"…"` / `b'\n'` / `c"…"` join their prefix; `r"…"` raw strings end at
# their quote with no escapes. `r#"…"#` is still split (2.7.1, ADR 0027).
string_prefixes = ["b", "c"]
raw_string_prefixes = ["r", "br", "cr"]

special_vars = false

# `'C'` / `'\C'` / `'\xHH'` (and 2/3/4-byte UTF-8 bodies) tokenize
# as a single TK_STRING. Lifetimes like `'a` / `'static` / `'_`
# still work — they fall through this step (no closing quote at
# the right offset) and tokenize as `'` operator + ident. See
# ADR 0010.
char_literal = true

# Operators in longest-match order. Rust-specific: `=>` (match arm),
# `->` (return-type arrow), `::` (path separator), `..=` and `..`
# (range), `?` (try), `&&`/`||` (logical), bit shifts, plus the
# standard set. `'` is an operator so lifetimes like `'_` tokenize
# as operator + ident (see grammar header).
operators = [
    "..=",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "=>", "->", "::", "..",
    "+=", "-=", "*=", "/=", "%=",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?", "'",
    "#",
    # `@` binds a pattern to a name in a match arm (`n @ 1..=5`)
    # and is the conventional internal-rule sigil inside
    # `macro_rules!` bodies (`(@impl $x:expr)`).
    "@",
]

# Punctuation, longest-match.
punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Raw strings with hashes — `r#"…"#`, `br##"…"##`, `cr#"…"#` — end at a
# quote followed by as many `#` as opened them, with no escapes (ADR
# 0030, 2.9.5). `r"…"` with no hashes is the raw prefix above; `r#type`
# (a raw identifier) has no quote, so it is not one.
[[rules]]
kind = "string"
match = "heredoc"
body = "inline"
start = "r"
repeat = "#"
open = "\""
close = "\""

[[rules]]
kind = "string"
match = "heredoc"
body = "inline"
start = "br"
repeat = "#"
open = "\""
close = "\""

[[rules]]
kind = "string"
match = "heredoc"
body = "inline"
start = "cr"
repeat = "#"
open = "\""
close = "\""


[[rules]]
kind = "comment"
match = "line"
start = "//"


# Block comments `/* … */`, doc comments `/** … */` and `/*! … */`
# among them (2.9.3). Rust's nest; the pair rule closes at the first
# `*/`, so after a nested comment the rest of the outer one tokenizes as
# code — the limit swift, haskell, ocaml and julia document too.
[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    "fn", "let", "mut", "const", "static",
    "if", "else", "while", "for", "loop", "match",
    "return", "break", "continue",
    "use", "mod", "pub",
    "struct", "enum", "trait", "impl",
    "as", "in", "where",
    "self", "Self", "super", "crate",
    "async", "await", "move",
    "dyn", "ref", "type", "extern", "unsafe",
    "true", "false",
]
