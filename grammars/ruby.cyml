# ruby — Ruby tokenizer grammar
#
# Rule scheme per ADR 0005. Ruby is its own thing at the token
# level — `#` line comments, `=begin`/`=end` block comments,
# symbols (`:foo`), instance/class variables (`@foo`, `@@foo`),
# globals (`$foo`), `?` as both ternary and a unary operator-
# turning-into-method-name, and a long list of keywords.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a Ruby reference sample yet. The local
# `tests/corpus/concept.rb` mirrors the lexer+parser theme used
# elsewhere, exercising `module`/`class`/`def`/`end` blocks,
# `Struct.new`, symbols, `=begin`/`=end` block comments, regex
# `/\s/`, string interpolation `#{…}`, and the Ruby keyword set.
# Replace with a vidya snapshot when one ships.
#
# Sigil handling:
#   - `@` and `$` in `ident_start` so `@source`, `@@count`,
#     `$PROGRAM_NAME`, etc. tokenize as a single ident. Same call
#     as PHP for `$` and Java for `@`.
#   - `:` for symbols stays as punctuation; `:foo` tokenizes as
#     `:` + ident (theme reassembles).
#
# Block comments `=begin` / `=end`:
# Pair rule below. **Caveat: Ruby requires these to be in
# column 0 to be valid; the scanner has no column-state, so a
# `=begin` mid-line would be matched too.** The vidya / stand-in
# corpora always put them at column 0; if a real corpus surfaces
# the mid-line ambiguity, this becomes a future ADR (line-start-
# only pair rule).
#
# Known gaps (not triggered by the stand-in):
#   - Heredocs (`<<~END … END`). Variable-length terminator.
#     Same scanner-shape gap as PHP heredocs and Lua `[==[…]==]`
#     — track collectively.
#   - Regex literals `/.../` are context-sensitive (vs. division)
#     in Ruby. Today `/` is the slash operator; a regex inside
#     a method call like `=~ /foo/` tokenizes as op + ident +
#     op, which is a known gap. JS/TS share this gap; reopens if
#     a real corpus needs distinguishing.
#   - `?C` character literal (deprecated post-1.9 but still
#     valid). Tokenizes as `?` op + `C` ident. Cosmetic.
#   - Numeric underscores (`1_000_000`) and `_` as ignored
#     argument: tokenize as ident; cosmetic.

[grammar]
name = "ruby"
extensions = [".rb"]

[defaults]
shebang = true
whitespace = true

# `@` for instance / class vars, `$` for globals.
ident_start = "A-Za-z_@$"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order. Ruby-specific: `**=` (power
# assign), `<=>` (spaceship), `===` (case equality), `=~` /
# `!~` (regex match / no-match), `..` / `...` (range / exclusive
# range), `&.` (safe navigation, Ruby 2.3+), `=>` (hash rocket /
# rescue), `->` (lambda), `**` (power / double-splat), plus the
# standard C-family set.
operators = [
    "<<=", ">>=", "<=>",
    "**=", "===",
    "...",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "=~", "!~",
    "->", "=>", "..", "**",
    "&.",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=", "||=", "&&=",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
    # `\` shows up as line-continuation and inside regex bodies
    # (`/\s/`). The string-pair `escape = "\\"` consumes `\<C>`
    # inside string spans; outside strings, treat as operator
    # so `=~ /\s/` doesn't fall to the error fallback.
    "\\",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# `=begin` / `=end` block comments. Caveat: Ruby requires them
# at column 0 (see grammar header). The pair rule matches them
# anywhere; corpora that respect the spec tokenize correctly.
# Ordered before `#` line comments so a `#` inside a `=begin`
# block is consumed as comment text.
[[rules]]
kind = "comment"
match = "pair"
start = "=begin"
end = "=end"


[[rules]]
kind = "comment"
match = "line"
start = "#"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Definition
    "module", "class", "def", "end", "begin",
    # Control flow
    "if", "elsif", "else", "unless", "case", "when", "then",
    "while", "until", "for", "in", "do",
    "break", "next", "redo", "retry", "return",
    "yield",
    # Exception handling
    "rescue", "ensure", "raise", "throw", "catch",
    # Object-oriented
    "self", "super",
    # Logical (Ruby spells some operators as words)
    "and", "or", "not",
    # Reserved literals
    "true", "false", "nil",
    # Definition / introspection
    "defined?",
    # Loading
    "require", "require_relative", "load", "autoload",
    # Misc
    "alias", "undef", "lambda", "proc",
    "__method__", "__FILE__", "__LINE__", "__dir__", "__ENCODING__",
    "BEGIN", "END",
]

# Command literal `` `ls` `` — runs the string in a subshell and
# returns stdout. Same shape as Ruby's `%x{}`. TK_STRING per the
# julia.cyml precedent.
[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"
escape = "\\"

