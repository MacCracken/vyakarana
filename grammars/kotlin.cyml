# kotlin — Kotlin tokenizer grammar
#
# Rule scheme per ADR 0005. JVM-language sibling of java.cyml,
# tuned for Kotlin's syntactic surface.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a Kotlin reference sample yet. The local
# `tests/corpus/concept.kt` mirrors the lexer+parser theme used
# elsewhere, exercising data classes, sealed interfaces, when
# expressions, lambdas, string templates, char literals, the `to`
# infix function, and the Kotlin keyword set. Replace with a
# vidya snapshot when one ships.
#
# Annotations: `@` is in `ident_start` so `@Override`,
# `@JvmStatic`, `@file:JvmName`, etc. tokenize as a single ident.
# Same call as java.cyml.
#
# Identifier dollar: `$` is in `ident_start` so `$variable`
# string interpolation references can be tokenized as part of an
# ident — though string interpolation itself stays inside the
# string-pair span (consistent with [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md)
# for shell). A consumer wanting to colour interpolation breaks
# does it post-tokenization.
#
# Known gaps (not triggered by the stand-in):
#   - Triple-quoted raw strings `"""…"""`. Not in the stand-in.
#     Add a pair rule ahead of the regular string rule when a
#     corpus needs them — see [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)
#     for the same shape in TOML.
#   - Numeric suffixes (`42L`, `1.5f`, `1_000_000`). Same story
#     as java.cyml — cosmetic; coverage holds.

[grammar]
name = "kotlin"
extensions = [".kt", ".kts"]

[defaults]
shebang = false
whitespace = true

ident_start = "A-Za-z_$@"
ident_cont  = "A-Za-z0-9_$"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = false

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order. Kotlin-specific: `?:` (Elvis),
# `?.` (safe-call), `!!` (not-null assert), `..` (range), `->`
# (lambda / when arms), `::` (callable reference), `===` / `!==`
# (referential equality), plus the standard C-family set.
operators = [
    "===", "!==",
    "<<=", ">>=",
    ">>>",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "->", "::", "?:", "?.", "..",
    "!!",
    "+=", "-=", "*=", "/=", "%=",
    "++", "--",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
    # `'` / `\` fallbacks for char-literal escape forms
    # `char_literal` does not model (`'\u0041'`).
    "'", "\\",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "//"


[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / package / imports
    "package", "import",
    # Type declarations
    "class", "interface", "object", "enum", "data",
    "sealed", "annotation", "companion",
    # Modifiers / visibility
    "public", "internal", "private", "protected",
    "open", "final", "abstract", "override", "lateinit",
    "inline", "noinline", "crossinline", "external",
    "tailrec", "operator", "infix", "suspend",
    "vararg", "reified", "const",
    # Declaration heads
    "fun", "val", "var", "typealias",
    # Control flow
    "if", "else", "when", "while", "do", "for",
    "break", "continue", "return", "throw",
    "try", "catch", "finally",
    # Object-oriented
    "this", "super", "is",
    # Reserved literals
    "true", "false", "null",
    # Type-system / range / membership infix words
    "in", "out", "as",
    "by", "where",
]

# Backtick-escaped identifier — `` `object` ``, and the test-naming
# idiom ``fun `returns 404 when missing`()``. Emitted as TK_IDENT
# because the delimited text names something.
[[rules]]
kind = "ident"
match = "pair"
start = "`"
end = "`"

