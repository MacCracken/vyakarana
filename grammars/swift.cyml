# swift — Swift tokenizer grammar
#
# Rule scheme per ADR 0005. Close in shape to kotlin.cyml — both
# are mobile-first JVM-or-LLVM-flavoured languages with
# expression-oriented control flow, optionals, and string
# interpolation.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a Swift reference sample yet. The local
# `tests/corpus/concept.swift` mirrors the lexer+parser theme used
# elsewhere, exercising `enum` cases with associated values,
# `indirect enum`, `final class`, optionals (`peek() ->
# Character?`), `guard`, multi-line strings (`"""…"""`), and the
# Swift keyword set.
#
# Multi-line strings: `"""…"""` pair rule is declared **before**
# the regular `"…"` rule so the longer prefix wins (per
# [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md) for
# TOML).
#
# Attributes (`@available`, `@objc`, `@MainActor`): `@` is in
# `ident_start`, so each tokenizes as one ident.
#
# Known gaps (not triggered by the stand-in):
#   - String interpolation `\(expr)` stays inside the string-pair
#     span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).
#     Theme can post-process.
#   - Extended delimiters `#"…"#`, `##"…"##`, `#"""…"""#` are one
#     string since 2.9.5 (ADR 0030), but their `\#"` escape is not
#     read: `#"\#"#"#` closes at the first `"#`.
#   - Nestable block comments (Swift's `/* */` is technically
#     nestable per the spec; the pair rule closes at the first
#     `*/`, so after a nested comment the rest of the outer one
#     tokenizes as code).

[grammar]
name = "swift"
extensions = [".swift"]

[defaults]
shebang = false
whitespace = true

# `@` for attributes (`@available`, `@objc`, `@MainActor`).
# `$` for compiler-generated names (`$0`, `$1`, etc. — closure
# shorthand parameters).
ident_start = "A-Za-z_$@"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_separator = "_"    # `1_000` (ADR 0026)
# Tuple indexes: `t.0.1` is `t . 0 . 1`, as Swift's own lexer reads it —
# a number right after a lone `.` takes no fraction (2.9.3). `0.0...1.5`
# keeps its floats: a `.` that ends `...` is not lone.
number_tuple_index = true

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order. Swift-specific: `..<` (range
# excluding upper bound), `...` (closed range), `??` (nil-
# coalesce), `?.` (optional chain), `->` (return-type arrow),
# `&+` / `&-` / `&*` (overflow-checked arithmetic), `===` / `!==`
# (identity), plus the standard C-family set.
operators = [
    "===", "!==",
    "<<=", ">>=",
    "..<", "...",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "->", "??", "?.",
    "&+", "&-", "&*",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=",
    "++", "--",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
    # `#` leads compile-time directives and macros — `#if os(iOS)`,
    # `#available`, `#selector`, `#Preview`, `#warning` — and the
    # raw-string delimiter `#"..."#`. `\` opens a key path
    # (`\Person.name`, `\.self`). `'` is not Swift syntax but is
    # kept as a fallback so unmodelled escape forms cannot error.
    "#", "\\", "'",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Extended string delimiters — `#"…"#`, `##"…"##`, multi-line
# `#"""…"""#` — end at a quote followed by as many `#` as opened them
# (ADR 0030, 2.9.5). The `"""` form first, so it wins at its opener.
[[rules]]
kind = "string"
match = "heredoc"
body = "inline"
repeat = "#"
open = "\"\"\""
close = "\"\"\""

[[rules]]
kind = "string"
match = "heredoc"
body = "inline"
repeat = "#"
open = "\""
close = "\""


[[rules]]
kind = "comment"
match = "line"
start = "//"


[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


# Multi-line string `"""…"""`. Declared BEFORE the single-quoted
# rule so the longer prefix wins.
[[rules]]
kind = "string"
match = "pair"
start = "\"\"\""
end = "\"\"\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / imports
    "import", "module",
    # Type-declaration heads
    "class", "struct", "enum", "protocol", "extension",
    "actor", "associatedtype", "typealias",
    "indirect",
    # Modifiers / visibility
    "public", "private", "fileprivate", "internal",
    "open", "final", "static", "lazy", "weak", "unowned",
    "mutating", "nonmutating", "convenience", "required",
    "override", "dynamic", "infix", "prefix", "postfix",
    # Declaration heads
    "func", "let", "var", "init", "deinit", "subscript",
    "operator",
    # Control flow
    "if", "else", "guard", "switch", "case", "default",
    "while", "repeat", "for", "in",
    "break", "continue", "return", "fallthrough", "yield",
    "throw", "throws", "rethrows", "try", "do", "catch",
    "defer",
    # Async / await
    "async", "await",
    # Object / value
    "self", "Self", "super", "is", "as", "where",
    # Reserved literals
    "true", "false", "nil",
    # Type / generics
    "any", "some", "Any", "Type",
    "inout",
]

# Backtick-escaped identifier — ``let `default` = 1`` lets a reserved
# word be used as a name. TK_IDENT: the delimited text is a name.
[[rules]]
kind = "ident"
match = "pair"
start = "`"
end = "`"

