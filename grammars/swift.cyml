# swift — Swift tokenizer grammar
#
# Rule scheme per ADR 0005. Close in shape to kotlin.cyml — both
# are mobile-first JVM-or-LLVM-flavoured languages with
# expression-oriented control flow, optionals, and string
# interpolation.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a Swift reference sample yet. The local
# `tests/corpus/concept.swift` mirrors the lexer+parser theme used
# elsewhere, exercising `enum` cases with associated values,
# `indirect enum`, `final class`, optionals (`peek() ->
# Character?`), `guard`, multi-line strings (`"""…"""`), and the
# Swift keyword set.
#
# Multi-line strings: `"""…"""` pair rule is declared **before**
# the regular `"…"` rule so the longer prefix wins (per
# [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md) for
# TOML).
#
# Known gaps (not triggered by the stand-in):
#   - String interpolation `\(expr)` stays inside the string-pair
#     span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).
#     Theme can post-process.
#   - Raw strings `#"…"#`, `##"…"##` (variable-length delimiter).
#     Same scanner-shape gap as Lua's `[==[…]==]`, Ruby's
#     heredocs, PHP's heredocs — track collectively.
#   - Nestable block comments (Swift's `/* */` is technically
#     nestable per the spec; the pair rule closes at the first
#     `*/`). Same gap as Rust.
#   - Attribute syntax (`@available`, `@objc`). `@` is in
#     `ident_start` so `@available` tokenizes as one ident.

[grammar]
name = "swift"
extensions = [".swift"]

[defaults]
shebang = false
whitespace = true

# `@` for attributes (`@available`, `@objc`, `@MainActor`).
# `$` for compiler-generated names (`$0`, `$1`, etc. — closure
# shorthand parameters).
ident_start = "A-Za-z_$@"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true

special_vars = false
unicode_ident = true
char_literal  = true

# Operators in longest-match order. Swift-specific: `..<` (range
# excluding upper bound), `...` (closed range), `??` (nil-
# coalesce), `?.` (optional chain), `->` (return-type arrow),
# `&+` / `&-` / `&*` (overflow-checked arithmetic), `===` / `!==`
# (identity), plus the standard C-family set.
operators = [
    "===", "!==",
    "<<=", ">>=",
    "..<", "...",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "->", "??", "?.",
    "&+", "&-", "&*",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=",
    "++", "--",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "//"


[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


# Multi-line string `"""…"""`. Declared BEFORE the single-quoted
# rule so the longer prefix wins.
[[rules]]
kind = "string"
match = "pair"
start = "\"\"\""
end = "\"\"\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / imports
    "import", "module",
    # Type-declaration heads
    "class", "struct", "enum", "protocol", "extension",
    "actor", "associatedtype", "typealias",
    "indirect",
    # Modifiers / visibility
    "public", "private", "fileprivate", "internal",
    "open", "final", "static", "lazy", "weak", "unowned",
    "mutating", "nonmutating", "convenience", "required",
    "override", "dynamic", "infix", "prefix", "postfix",
    # Declaration heads
    "func", "let", "var", "init", "deinit", "subscript",
    "operator",
    # Control flow
    "if", "else", "guard", "switch", "case", "default",
    "while", "repeat", "for", "in",
    "break", "continue", "return", "fallthrough", "yield",
    "throw", "throws", "rethrows", "try", "do", "catch",
    "defer",
    # Async / await
    "async", "await",
    # Object / value
    "self", "Self", "super", "is", "as", "where",
    # Reserved literals
    "true", "false", "nil",
    # Type / generics
    "any", "some", "Any", "Type",
    "inout",
    # Misc
    "import", "associatedtype",
]
