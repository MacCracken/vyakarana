# csharp — C# tokenizer grammar
#
# Rule scheme per ADR 0005. C-family at the token level — close
# in shape to java.cyml + cpp.cyml.
#
# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):
# vidya doesn't ship a C# reference sample yet. The local
# `tests/corpus/concept.cs` mirrors the lexer+parser theme used
# elsewhere, exercising `record` types, switch expressions, file-
# scoped namespaces, range indexers (`source[start.._pos]`),
# string interpolation (`$"..."`, five sites — e.g. line 78), char
# literals (`'+'`, `'\0'`), and the C# keyword set. Replace with
# a vidya snapshot when one ships.
#
# Attributes: `[Attribute]` syntax is ordinary punctuation `[` +
# ident + `]`. No `@` prefix needed (C# uses `@` only for verbatim
# strings `@"..."` and identifier escapes `@class`).
#
# Verbatim strings `@"..."` and interpolated strings `$"..."`,
# `$@"..."` / `@$"..."` are one string token with their prefix since
# 2.9.6 — symbol-shaped string prefixes (ADR 0027): `$` a plain one,
# the `@` forms raw, so a verbatim `@"C:\"` ends at its quote. Elsewhere
# `@` (`@class`) and `$` stay operators.
#
# Known gaps (not triggered by the stand-in):
#   - A verbatim string's doubled quote (`@"say ""hi"""`) comes back as
#     adjacent string tokens, as SQL's `''` does — the same bytes, all
#     string. An interpolation hole holding a quote (`$"{(a ? "x" : "y")}"`)
#     ends the string early (holes are not re-tokenized, ADR 0003).
#   - Raw string literals `"""…"""` (C# 11+): the `"""` pair rule is not
#     declared; they tokenize as strings split at each `""`.
#   - (Not a gap since 2.9.7: numeric suffixes, `42L`, `1.5m`, join the
#     number; floats and `1_000_000` are one since 2.7.0, ADR 0026.)
#   - Pattern-matching in switch expressions: `is`, `not`, `and`,
#     `or` patterns. Only `is` is in the keyword list; `not` /
#     `and` / `or` are contextual and tokenize as plain idents.
#     The structure is consumer-side parsing.

[grammar]
name = "csharp"
extensions = [".cs", ".csx"]

[defaults]
shebang = false
whitespace = true

ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = false
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_lead_dot = true    # `.5` (ADR 0026, 2.9.7)
# Type suffixes join the literal: `10UL`, `1.5f`, `2.5m` (2.9.7).
number_suffixes = ["u", "U", "l", "L", "ul", "uL", "Ul", "UL", "lu", "lU", "Lu", "LU", "f", "F", "d", "D", "m", "M"]
number_separator = "_"    # `1_000` (ADR 0026)

special_vars = false
unicode_ident = true
# `$"…"` interpolated (escapes as usual); `@"…"`, `$@"…"`, `@$"…"`
# verbatim — no backslash escapes (2.9.6, ADR 0027).
string_prefixes = ["$"]
raw_string_prefixes = ["@", "$@", "@$"]
char_literal  = true

# Operators in longest-match order. C#-specific: `??=` /
# `??` (null-coalesce assign / value), `?.` (null-conditional),
# `=>` (lambda / expression body / switch arms), `..` (range),
# plus the standard C-family set.
operators = [
    "<<=", ">>=",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "??=", "??", "?.",
    "=>", "..",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=",
    "++", "--",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?",
    "@", "$",
    # `#` leads a preprocessor directive — `#if DEBUG`, `#region`,
    # `#nullable enable`, `#pragma warning`. `'` / `\` are
    # fallbacks for a `'` that doesn't close a char literal and for
    # C#'s `\uXXXX` identifier escapes. (`'\u0041'` itself is one
    # char-literal token since 2.5.2.)
    "#", "'", "\\",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "//"


# Block comments `/* … */`. Non-nestable per the C# spec.
[[rules]]
kind = "comment"
match = "pair"
start = "/*"
end = "*/"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Module / namespace / using
    "namespace", "using",
    # Type-declaration heads
    "class", "struct", "interface", "enum", "record",
    "delegate",
    # Modifiers / visibility
    "public", "private", "protected", "internal",
    "static", "readonly", "const", "sealed", "partial",
    "abstract", "virtual", "override", "extern",
    "unsafe", "fixed", "volatile", "async",
    # Storage / declaration
    "var", "void", "ref", "out", "in", "params",
    # Control flow
    "if", "else", "while", "do", "for", "foreach",
    "switch", "case", "default",
    "break", "continue", "return", "yield", "goto",
    # Exceptions / disposal
    "try", "catch", "finally", "throw",
    # Object-oriented
    "new", "this", "base", "is", "as",
    "operator", "implicit", "explicit",
    # Async / iterators
    "await",
    # Type system / reflection
    "typeof", "sizeof", "nameof", "checked", "unchecked",
    "stackalloc", "lock",
    # Primitive types
    "bool", "byte", "sbyte", "short", "ushort",
    "int", "uint", "long", "ulong", "float", "double",
    "decimal", "string", "char", "object", "dynamic",
    "nint", "nuint",
    # Reserved literals
    "true", "false", "null",
    # Pattern keywords (some are contextual, but lexically these
    # appear in pattern position as recognised words)
    "when", "with", "where", "select", "from", "let", "into",
    "join", "on", "equals", "by", "group", "orderby",
    "ascending", "descending",
    # Misc reserved
    "global",
]
