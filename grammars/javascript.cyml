# javascript — JavaScript tokenizer grammar
#
# Rule scheme per ADR 0005. JavaScript is TypeScript minus the
# type-declaration layer (interface / type / enum / namespace /
# visibility modifiers). Shares the defaults: same ident class,
# same operators, same three string types. The differences from
# typescript.cyml are the keyword list and the `#!` line: javascript
# routes `node` scripts and reads a leading `#!` as one token (2.6.2).
#
# Corpus: tests/corpus/concept.js (hand-rolled stand-in per
# ADR 0006 — vidya doesn't yet ship a JS reference sample).
#
# Known gaps (same as typescript.cyml):
#   - Template literal interpolation `${expr}` — flat string.
#   - Regex literals `/pat/flags` — not handled; `\` is an operator
#     so escapes inside regex don't error, but regex isn't a
#     distinguished token.
#   - JSX — a separate grammar, not this one.

[grammar]
name = "javascript"
extensions = [".js", ".mjs", ".cjs"]
shebangs = ["node"]

[defaults]
# `#!/usr/bin/env node` routes here, and ES2023 makes a leading `#!`
# line a comment, so it is one token rather than operator soup
# (`#` `!` `/` `usr` …, 2.6.1 and earlier).
shebang = true
whitespace = true

ident_start = "A-Za-z_$"
ident_cont  = "A-Za-z0-9_$"

# JS identifiers admit non-ASCII (ID_Start / ID_Continue) —
# `const café = 1` is valid. Without this, each UTF-8 byte
# outside a string or comment became its own TK_ERROR. ADR 0009.
unicode_ident = true

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_separator = "_"    # `1_000` (ADR 0026)

special_vars = false

# Operators: identical to typescript.cyml.
operators = [
    "===", "!==", "...", "**=",
    "&&=", "||=", "??=",
    "**", "??", "?.",
    "<<=", ">>=", ">>>",
    "<<", ">>",
    "&&", "||",
    "==", "!=", "<=", ">=",
    "++", "--",
    "+=", "-=", "*=", "/=", "%=",
    "&=", "|=", "^=",
    "=>",
    "=", "+", "-", "*", "/", "%",
    "!", "~", "&", "|", "^",
    "<", ">",
    "?", "\\",
    # `#` declares and reads a private class field (`#count`,
    # `this.#count`, `#x in obj`) and opens a hashbang line. `@`
    # prefixes a decorator (`@component`).
    "#", "@",
]

punctuation = [
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

[[rules]]
kind = "comment"
match = "line"
start = "//"


[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"
escape = "\\"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Declarations
    "let", "const", "var", "function", "class",
    # Module
    "import", "export", "from", "as",
    # Control flow
    "if", "else", "while", "for", "do",
    "switch", "case", "default", "break", "continue",
    "return", "throw", "try", "catch", "finally",
    # OO / inheritance
    "extends",
    "new", "this", "super",
    # Modifiers / async
    "static",
    "async", "await", "yield",
    # Operator-keywords
    "typeof", "instanceof", "in", "of", "void", "delete",
    # Literals
    "true", "false", "null", "undefined",
]
