# cyml — CYML tokenizer grammar (vyakarana's own format)
#
# Rule scheme per ADR 0005. CYML is the format vyakarana itself
# uses for grammar files (`grammars/*.cyml`), yukti's config
# (`yukti.cyml`), and vidya's content corpus
# (`vidya/content/<topic>/*.cyml`). Self-hosting payoff: 1.9.0
# is the first release where vyakarana can colour its own
# grammar files with its own grammar.
#
# The format is a TOML-shaped header optionally followed by
# `---`-delimited markdown bodies, repeating:
#
#   [package]                    | TOML header
#   name = "vyakarana"           |
#                                |
#   [[entries]]                  |
#   name = "x"                   |
#   ---                          | 3-byte separator
#   Free-form markdown text      | Body (between separators)
#   with `inline code` and       |
#   **bold** etc.                |
#   ---                          |
#   [[entries]]                  | Next header block...
#
# Bodies are routed to the markdown grammar with a
# `compose_region` rule (2.3.1, [ADR 0019](../docs/adr/0019-compose-region-rule.md)).
# The header keeps this file's own TOML-shaped rules.
#
# Why `compose_region` and not the `compose` of ADR 0013: CYML's
# body has no closing delimiter. It runs from `---` until the
# next TOML header line or end of file, so the routing needs a
# terminator that is *not* consumed (the `[[entries]]` belongs to
# the header that follows) and it needs EOF to count as a normal
# ending (the last body in every file terminates that way).
# `compose` consumes its `end` and emits nothing at all when the
# marker is absent, so it could express neither.
#
# 1.9.0 through 2.3.0 shipped a single union rule set instead,
# and it mis-typed exactly what a CYML body is for: `#` headings
# came back as TOML comments, and a ``` fence opened a backtick
# pair rule that swallowed the whole code block into one string.
# The bundled corpus had neither shape, so the gates stayed green
# across nine minor releases (1.9 through 2.3).
#
# Stand-in corpus: NOT a stand-in! `tests/corpus/dependencies.cyml`
# is a real vidya snapshot from
# `vidya/content/cyrius/dependencies.cyml` (233 lines). First
# bundled grammar where vidya already shipped a sample for the
# language.
#
# Known gaps:
#   - Multi-line TOML strings `"""…"""` / `'''…'''` are handled
#     since 2.5.2 (the ADR 0008 rules toml uses) — this used to be a
#     "not in the sample" gap, and vidya's field notes hit it hard.
#   - The body ends at a line starting `[[` (`end_before = "\n[["`).
#     Through 2.5.1 it was `\n[`, so ANY body line starting `[` — a
#     link, a reference definition, `[base, base+size)` in prose —
#     ended the body and handed the rest to the TOML header rules,
#     where a prose apostrophe opened a `'` string running to the
#     next `'` (vidya `types.cyml`: ~14 KB mis-lexed). Across 35
#     real CYML files a body was followed by `[[` 663 times and by a
#     single-bracket `[table]` header 0 times, while 21 body lines
#     began with `[`. Trade-off, documented: a single-bracket
#     `[table]` header directly after a body now reads as body text
#     until the next `[[`. A line-anchored header match would need
#     scanner support. 2.5.2 audit P2-9.
#   - Setext-heading underlines `===` (markdown-body level).
#     The `---` separator would also match a setext underline,
#     but the convention is that `---` lives between header
#     and body, not within body markdown. If a real corpus
#     surfaces a setext in body, the divider becomes ambiguous.

[grammar]
name = "cyml"
extensions = [".cyml"]

[defaults]
shebang = false
whitespace = true

# Section / key names use letters / underscore; `-` and `.` in
# `ident_cont` for things like `cfi-startproc`-style or
# `auth.providers.github` nested keys (TOML allows them).
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_.-"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true
number_float   = true      # `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026)
number_datetime = true     # `1979-05-27T07:32:00Z` as one number (ADR 0026)

special_vars = false
unicode_ident = true
char_literal  = false

# Operators in longest-match order. `---` never fires: the
# compose_region rule below (step 0c) claims every `---` before
# the operator step runs — unreachable but harmless. `**` (markdown
# bold) dates from the 1.9.0–2.3.0 union rule set, when this
# grammar also scanned the bodies; bodies route to the markdown
# grammar since 2.3.1, so here it can only match in header text.
operators = [
    "---",
    "**",
    "==", "!=", "<=", ">=",
    "=", "+", "-", "*", "/", "%",
    "<", ">",
    "&", "|", "^", "~",
    "!", "?",
    "@",
]

# Punctuation. `[[` and `]]` need to come before `[` and `]` in
# the longest-match order — they're matched in declaration order.
punctuation = [
    "[[", "]]",
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Markdown body. Opens at `---` and runs to the next line starting
# `[[` or EOF, whichever comes first (see Known gaps for why not
# `[`). `end_before` is a lookahead: the `\n[[` stays behind so
# `[[entries]]` tokenizes as the TOML it is. Runs at scanner step
# 0c, ahead of the `#` line rule below — which is the whole point,
# since a body's `# Heading` is markdown, not a TOML comment.
#
# `---` inside a header comment or string is safe: the scanner
# advances token-by-token, so the cursor never lands inside one.
[[rules]]
match = "compose_region"
start = "---"
end_before = "\n[["
inner = "markdown"


[[rules]]
kind = "comment"
match = "line"
start = "#"


# Multi-line TOML strings, ahead of the single-quote rules (first
# match wins). Same rules ADR 0008 gave toml. Since 2.5.2: vidya's
# `field_notes` documents carry their bodies in `content = """…"""`
# (148 of them in gotchas.cyml alone), and without these rules the
# opener split into `""` + `"…`, every quote inside flipped string
# parity, and seven vidya files exited 1 (2.5.2 audit P2-8).
[[rules]]
kind = "string"
match = "pair"
start = "\"\"\""
end = "\"\"\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'''"
end = "'''"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"


# Backtick span `…`, no escape. Dates from the union rule set,
# when it served inline code in bodies; bodies route to the
# markdown grammar since 2.3.1, so this now only fires on a
# backtick in header text (not valid TOML outside a string).
[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Literal values (TOML)
    "true", "false", "inf", "nan",
]
