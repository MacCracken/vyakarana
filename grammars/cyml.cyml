# cyml — CYML tokenizer grammar (vyakarana's own format)
#
# Rule scheme per ADR 0005. CYML is the format vyakarana itself
# uses for grammar files (`grammars/*.cyml`), yukti's config
# (`yukti.cyml`), and vidya's content corpus
# (`vidya/content/<topic>/*.cyml`). Self-hosting payoff: 1.9.0
# is the first release where vyakarana can colour its own
# grammar files with its own grammar.
#
# The format is a TOML-shaped header optionally followed by
# `---`-delimited markdown bodies, repeating:
#
#   [package]                    | TOML header
#   name = "vyakarana"           |
#                                |
#   [[entries]]                  |
#   name = "x"                   |
#   ---                          | 3-byte separator
#   Free-form markdown text      | Body (between separators)
#   with `inline code` and       |
#   **bold** etc.                |
#   ---                          |
#   [[entries]]                  | Next header block...
#
# Bodies are routed to the markdown grammar with a
# `compose_region` rule (2.3.1, [ADR 0019](../docs/adr/0019-compose-region-rule.md)).
# The header keeps this file's own TOML-shaped rules.
#
# Why `compose_region` and not the `compose` of ADR 0013: CYML's
# body has no closing delimiter. It runs from `---` until the
# next TOML header line or end of file, so the routing needs a
# terminator that is *not* consumed (the `[[entries]]` belongs to
# the header that follows) and it needs EOF to count as a normal
# ending (the last body in every file terminates that way).
# `compose` consumes its `end` and emits nothing at all when the
# marker is absent, so it could express neither.
#
# 1.9.0 through 2.3.0 shipped a single union rule set instead,
# and it mis-typed exactly what a CYML body is for: `#` headings
# came back as TOML comments, and a ``` fence opened a backtick
# pair rule that swallowed the whole code block into one string.
# The bundled corpus had neither shape, so the gates stayed green
# across twelve minor releases.
#
# Stand-in corpus: NOT a stand-in! `tests/corpus/dependencies.cyml`
# is a real vidya snapshot from
# `vidya/content/cyrius/dependencies.cyml` (233 lines). First
# bundled grammar where vidya already shipped a sample for the
# language.
#
# Known gaps:
#   - Multi-line TOML strings `"""…"""`. Not in the sample.
#     If a real CYML uses them, add the same pair rule
#     [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)
#     introduced for TOML.
#   - A body line beginning with `[` ends the region early —
#     `end_before` is a literal `\n[`, not a line-anchored TOML
#     header match. In practice that means a markdown link-
#     reference definition (`[1]: https://…`) at column 0 hands
#     the rest of the body back to the header rules. Same class
#     of documented literal-prefix limit as html's `<script>`
#     vs `<script type="module">` (ADR 0013 §When to revisit).
#     Indented or inline `[` is unaffected.
#   - Setext-heading underlines `===` (markdown-body level).
#     The `---` separator would also match a setext underline,
#     but the convention is that `---` lives between header
#     and body, not within body markdown. If a real corpus
#     surfaces a setext in body, the divider becomes ambiguous.

[grammar]
name = "cyml"
extensions = [".cyml"]

[defaults]
shebang = false
whitespace = true

# Section / key names use letters / underscore; `-` and `.` in
# `ident_cont` for things like `cfi-startproc`-style or
# `auth.providers.github` nested keys (TOML allows them).
ident_start = "A-Za-z_"
ident_cont  = "A-Za-z0-9_.-"

number_decimal = true
number_0x      = true
number_0b      = true
number_0o      = true

special_vars = false
unicode_ident = true
char_literal  = false

# Operators in longest-match order. CYML-specific: `---` (3-byte
# separator between TOML header and markdown body), `**` (markdown
# bold marker — body level), plus the standard TOML / markdown
# punctuation surface.
operators = [
    "---",
    "**",
    "==", "!=", "<=", ">=",
    "=", "+", "-", "*", "/", "%",
    "<", ">",
    "&", "|", "^", "~",
    "!", "?",
    "@",
]

# Punctuation. `[[` and `[` need to come before `[` in the
# longest-match order — they're matched in declaration order.
punctuation = [
    "[[", "]]",
    "(", ")", "{", "}", "[", "]",
    ";", ",", ":", ".",
]


# ── Rules ──────────────────────────────────────────────────────────

# Markdown body. Opens at `---` and runs to the next TOML header
# line or EOF, whichever comes first. `end_before` is a lookahead:
# the `\n[` stays behind so `[[entries]]` tokenizes as the TOML it
# is. Runs at scanner step 0c, ahead of the `#` line rule below —
# which is the whole point, since a body's `# Heading` is markdown,
# not a TOML comment.
#
# `---` inside a header comment or string is safe: the scanner
# advances token-by-token, so the cursor never lands inside one.
[[rules]]
match = "compose_region"
start = "---"
end_before = "\n["
inner = "markdown"


[[rules]]
kind = "comment"
match = "line"
start = "#"


[[rules]]
kind = "string"
match = "pair"
start = "\""
end = "\""
escape = "\\"


[[rules]]
kind = "string"
match = "pair"
start = "'"
end = "'"


# Markdown inline code: `…`. Backticks are common in CYML
# bodies (referring to commands, file paths, identifiers).
# Pair rule with no escape — backtick spans don't have
# embedded escape handling.
[[rules]]
kind = "string"
match = "pair"
start = "`"
end = "`"


[[rules]]
kind = "keyword"
match = "words"
words = [
    # Literal values (TOML)
    "true", "false", "inf", "nan",
]
