    return "[grammar]\nname=\"typescript\"\nextensions=[\".ts\"]\n[defaults]\nshebang=false\nwhitespace=true\nident_start=\"A-Za-z_$\"\nident_cont=\"A-Za-z0-9_$\"\nunicode_ident=true\nnumber_decimal=true\nnumber_0x=true\nnumber_0b=true\nnumber_0o=true\nnumber_float=true\nnumber_separator=\"_\"\nspecial_vars=false\noperators=[\n\"===\",\"!==\",\"...\",\"**=\",\n\"&&=\",\"||=\",\"??=\",\n\"**\",\"??\",\"?.\",\n\"<<=\",\">>=\",\">>>\",\n\"<<\",\">>\",\n\"&&\",\"||\",\n\"==\",\"!=\",\"<=\",\">=\",\n\"++\",\"--\",\n\"+=\",\"-=\",\"*=\",\"/=\",\"%=\",\n\"&=\",\"|=\",\"^=\",\n\"=>\",\n\"=\",\"+\",\"-\",\"*\",\"/\",\"%\",\n\"!\",\"~\",\"&\",\"|\",\"^\",\n\"<\",\">\",\n\"?\",\"\\\\\",\n\"#\",\"@\",\n]\npunctuation=[\n\"(\",\")\",\"{\",\"}\",\"[\",\"]\",\n\";\",\",\",\":\",\".\",\n]\n[[rules]]\nkind=\"comment\"\nmatch=\"line\"\nstart=\"//\"\n[[rules]]\nkind=\"comment\"\nmatch=\"pair\"\nstart=\"/*\"\nend=\"*/\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"`\"\nend=\"`\"\nescape=\"\\\\\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"\\\"\"\nend=\"\\\"\"\nescape=\"\\\\\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"'\"\nend=\"'\"\nescape=\"\\\\\"\n[[rules]]\nkind=\"keyword\"\nmatch=\"words\"\nwords=[\n\"let\",\"const\",\"var\",\"function\",\"class\",\n\"interface\",\"type\",\"enum\",\"namespace\",\n\"import\",\"export\",\"from\",\"as\",\n\"if\",\"else\",\"while\",\"for\",\"do\",\n\"switch\",\"case\",\"default\",\"break\",\"continue\",\n\"return\",\"throw\",\"try\",\"catch\",\"finally\",\n\"extends\",\"implements\",\n\"new\",\"this\",\"super\",\n\"public\",\"private\",\"protected\",\n\"static\",\"readonly\",\"abstract\",\"declare\",\n\"async\",\"await\",\"yield\",\n\"typeof\",\"instanceof\",\"in\",\"of\",\"void\",\"delete\",\n\"true\",\"false\",\"null\",\"undefined\",\n]\n";
}

fn _grammar_blob_vue() {
    return "[grammar]\nname=\"vue\"\nextensions=[\".vue\"]\n[defaults]\nshebang=false\nwhitespace=true\nident_start=\"A-Za-z_\"\nident_cont=\"A-Za-z0-9_-\"\nnumber_decimal=true\nnumber_0x=false\nnumber_0b=false\nnumber_0o=false\nspecial_vars=false\nunicode_ident=true\nchar_literal=false\noperators=[\n\"<\",\">\",\"=\",\"/\",\n\"&\",\"!\",\"?\",\n\"@\",\n\"#\",\n\"+\",\"-\",\"*\",\"%\",\n\"$\",\"\\\\\",\"^\",\"`\",\"|\",\"~\",\n]\npunctuation=[\n\"(\",\")\",\"[\",\"]\",\"{\",\"}\",\n\";\",\",\",\":\",\".\",\n]\n[[rules]]\nmatch=\"compose\"\nstart=\"<script>\"\nend=\"</script>\"\ninner=\"javascript\"\n[[rules]]\nmatch=\"compose\"\nstart=\"<style>\"\nend=\"</style>\"\ninner=\"css\"\n[[rules]]\nkind=\"comment\"\nmatch=\"pair\"\nstart=\"<!--\"\nend=\"-->\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"\\\"\"\nend=\"\\\"\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"'\"\nend=\"'\"\n";
}

fn _grammar_blob_xml() {
    return "[grammar]\nname=\"xml\"\nextensions=[\".xml\",\".xsl\",\".xsd\",\".svg\"]\n[defaults]\nshebang=false\nwhitespace=true\nident_start=\"A-Za-z_\"\nident_cont=\"A-Za-z0-9_-\"\nnumber_decimal=true\nnumber_0x=false\nnumber_0b=false\nnumber_0o=false\nspecial_vars=false\nunicode_ident=true\nchar_literal=false\noperators=[\n\"<\",\">\",\"=\",\"/\",\n\"&\",\"!\",\"?\",\n\"#\",\n\"-\",\n\"$\",\"%\",\"*\",\"+\",\"@\",\"\\\\\",\"^\",\"`\",\"|\",\"~\",\n]\npunctuation=[\n\"(\",\")\",\"[\",\"]\",\"{\",\"}\",\n\";\",\",\",\":\",\".\",\n]\n[[rules]]\nkind=\"comment\"\nmatch=\"pair\"\nstart=\"<!--\"\nend=\"-->\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"<![CDATA[\"\nend=\"]]>\"\n[[rules]]\nkind=\"preprocessor\"\nmatch=\"pair\"\nstart=\"<?\"\nend=\"?>\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"\\\"\"\nend=\"\\\"\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"'\"\nend=\"'\"\n";
}

fn _grammar_blob_yaml() {
    return "[grammar]\nname=\"yaml\"\nextensions=[\".yaml\",\".yml\"]\n[defaults]\nshebang=false\nwhitespace=true\nident_start=\"A-Za-z_\"\nident_cont=\"A-Za-z0-9_-\"\nunicode_ident=true\nnumber_decimal=true\nnumber_0x=true\nnumber_0b=true\nnumber_0o=true\nnumber_float=true\nnumber_datetime=true\nspecial_vars=false\noperators=[\n\"<<\",\n\"&\",\"*\",\"-\",\"+\",\"?\",\"!\",\"|\",\"<\",\">\",\n\"=\",\"/\",\"%\",\"@\",\"~\",\"^\",\n\"$\",\"\\\\\",\"`\",\n]\npunctuation=[\n\"[\",\"]\",\"{\",\"}\",\"(\",\")\",\n\",\",\":\",\";\",\".\",\n]\n[[rules]]\nkind=\"comment\"\nmatch=\"line\"\nstart=\"#\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"\\\"\"\nend=\"\\\"\"\nescape=\"\\\\\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"'\"\nend=\"'\"\n[[rules]]\nkind=\"keyword\"\nmatch=\"words\"\nwords=[\n\"true\",\"false\",\"null\",\"yes\",\"no\",\"on\",\"off\",\n]\n";
}

fn _grammar_blob_zig() {
    return "[grammar]\nname=\"zig\"\nextensions=[\".zig\"]\n[defaults]\nshebang=false\nwhitespace=true\nident_start=\"A-Za-z_@\"\nident_cont=\"A-Za-z0-9_\"\nnumber_decimal=true\nnumber_0x=true\nnumber_0b=true\nnumber_0o=true\nnumber_float=true\nnumber_separator=\"_\"\nspecial_vars=false\nunicode_ident=true\nchar_literal=true\noperators=[\n\"<<=\",\">>=\",\n\"+%=\",\"-%=\",\"*%=\",\n\"+|=\",\"-|=\",\"*|=\",\n\"<<\",\">>\",\n\"&&\",\"||\",\n\"==\",\"!=\",\"<=\",\">=\",\n\"=>\",\"->\",\n\"++\",\"**\",\"..\",\n\"+%\",\"-%\",\"*%\",\n\"+|\",\"-|\",\"*|\",\n\"+=\",\"-=\",\"*=\",\"/=\",\"%=\",\n\"&=\",\"|=\",\"^=\",\n\"=\",\"+\",\"-\",\"*\",\"/\",\"%\",\n\"!\",\"~\",\"&\",\"|\",\"^\",\n\"<\",\">\",\n\"?\",\"'\",\n]\npunctuation=[\n\"(\",\")\",\"{\",\"}\",\"[\",\"]\",\n\";\",\",\",\":\",\".\",\n]\n[[rules]]\nkind=\"comment\"\nmatch=\"line\"\nstart=\"//\"\n[[rules]]\nkind=\"string\"\nmatch=\"pair\"\nstart=\"\\\"\"\nend=\"\\\"\"\nescape=\"\\\\\"\n[[rules]]\nkind=\"keyword\"\nmatch=\"words\"\nwords=[\n\"const\",\"var\",\"fn\",\"pub\",\"extern\",\"export\",\"inline\",\n\"noinline\",\"comptime\",\"threadlocal\",\"packed\",\n\"if\",\"else\",\"switch\",\"while\",\"for\",\"break\",\"continue\",\n\"return\",\"defer\",\"errdefer\",\n\"try\",\"catch\",\"orelse\",\"error\",\"unreachable\",\n\"struct\",\"union\",\"enum\",\"opaque\",\n\"async\",\"await\",\"suspend\",\"resume\",\"nosuspend\",\n\"linksection\",\"callconv\",\"align\",\"allowzero\",\"volatile\",\n\"noalias\",\n\"test\",\"usingnamespace\",\"asm\",\n\"true\",\"false\",\"null\",\"undefined\",\n\"and\",\"or\",\n\"anytype\",\"anyframe\",\n]\n[[rules]]\nkind=\"string\"\nmatch=\"line\"\nstart=\"\\\\\\\\\"\n";
}

# Returns pointer to the blob's content (cstr) for the given path, or
# 0 if no blob matches. Path is the same string bootstrap_grammars
# passes to grammar_load() — "grammars/<name>.cyml".
fn _grammar_blob_data(path) {
    if (streq(path, "grammars/asm_aarch64.cyml")) { return _grammar_blob_asm_aarch64(); }
    if (streq(path, "grammars/asm_x86_64.cyml")) { return _grammar_blob_asm_x86_64(); }
    if (streq(path, "grammars/c.cyml")) { return _grammar_blob_c(); }
    if (streq(path, "grammars/cpp.cyml")) { return _grammar_blob_cpp(); }
    if (streq(path, "grammars/crystal.cyml")) { return _grammar_blob_crystal(); }
    if (streq(path, "grammars/csharp.cyml")) { return _grammar_blob_csharp(); }
    if (streq(path, "grammars/css.cyml")) { return _grammar_blob_css(); }
    if (streq(path, "grammars/cyml.cyml")) { return _grammar_blob_cyml(); }
    if (streq(path, "grammars/cyrius.cyml")) { return _grammar_blob_cyrius(); }
    if (streq(path, "grammars/dockerfile.cyml")) { return _grammar_blob_dockerfile(); }
    if (streq(path, "grammars/elixir.cyml")) { return _grammar_blob_elixir(); }
    if (streq(path, "grammars/go.cyml")) { return _grammar_blob_go(); }
    if (streq(path, "grammars/graphql.cyml")) { return _grammar_blob_graphql(); }
    if (streq(path, "grammars/haskell.cyml")) { return _grammar_blob_haskell(); }
    if (streq(path, "grammars/html.cyml")) { return _grammar_blob_html(); }
    if (streq(path, "grammars/ini.cyml")) { return _grammar_blob_ini(); }
    if (streq(path, "grammars/java.cyml")) { return _grammar_blob_java(); }
    if (streq(path, "grammars/javascript.cyml")) { return _grammar_blob_javascript(); }
    if (streq(path, "grammars/json.cyml")) { return _grammar_blob_json(); }
    if (streq(path, "grammars/julia.cyml")) { return _grammar_blob_julia(); }
    if (streq(path, "grammars/kotlin.cyml")) { return _grammar_blob_kotlin(); }
    if (streq(path, "grammars/llvm_ir.cyml")) { return _grammar_blob_llvm_ir(); }
    if (streq(path, "grammars/lua.cyml")) { return _grammar_blob_lua(); }
    if (streq(path, "grammars/makefile.cyml")) { return _grammar_blob_makefile(); }
    if (streq(path, "grammars/markdown.cyml")) { return _grammar_blob_markdown(); }
    if (streq(path, "grammars/nix.cyml")) { return _grammar_blob_nix(); }
    if (streq(path, "grammars/ocaml.cyml")) { return _grammar_blob_ocaml(); }
    if (streq(path, "grammars/openqasm.cyml")) { return _grammar_blob_openqasm(); }
    if (streq(path, "grammars/php.cyml")) { return _grammar_blob_php(); }
    if (streq(path, "grammars/powershell.cyml")) { return _grammar_blob_powershell(); }
    if (streq(path, "grammars/protobuf.cyml")) { return _grammar_blob_protobuf(); }
    if (streq(path, "grammars/python.cyml")) { return _grammar_blob_python(); }
    if (streq(path, "grammars/ruby.cyml")) { return _grammar_blob_ruby(); }
    if (streq(path, "grammars/rust.cyml")) { return _grammar_blob_rust(); }
    if (streq(path, "grammars/scss.cyml")) { return _grammar_blob_scss(); }
    if (streq(path, "grammars/shell.cyml")) { return _grammar_blob_shell(); }
    if (streq(path, "grammars/sql.cyml")) { return _grammar_blob_sql(); }
    if (streq(path, "grammars/svelte.cyml")) { return _grammar_blob_svelte(); }
    if (streq(path, "grammars/swift.cyml")) { return _grammar_blob_swift(); }
    if (streq(path, "grammars/terraform.cyml")) { return _grammar_blob_terraform(); }
    if (streq(path, "grammars/toml.cyml")) { return _grammar_blob_toml(); }
    if (streq(path, "grammars/typescript.cyml")) { return _grammar_blob_typescript(); }
    if (streq(path, "grammars/vue.cyml")) { return _grammar_blob_vue(); }
    if (streq(path, "grammars/xml.cyml")) { return _grammar_blob_xml(); }
    if (streq(path, "grammars/yaml.cyml")) { return _grammar_blob_yaml(); }
    if (streq(path, "grammars/zig.cyml")) { return _grammar_blob_zig(); }
    return 0;
}

# Number of embedded grammars — a self-test hook: tests/vyakarana.tcyr
# and fuzz/grammar_load.fcyr check it against the grammars that load.
fn _grammar_blob_count() {
    return 46;
}

# The path of blob `i` (0 <= i < _grammar_blob_count()), or 0, so a test
# can walk the blobs themselves rather than the grammars that loaded.
