# --- grammar.cyr ---

# vyakarana — grammar record + CYML loader + registry
#
# Loaded grammars drive the data-driven scanner in
# src/grammars/default_scanner.cyr (see ADR 0005). This module owns:
#   - Grammar record layout and accessors
#   - A minimal TOML-ish parser (purpose-built for the grammar files
#     in grammars/*.cyml — not a general CYML/TOML implementation)
#   - A tiny registry so `tokenize_stream_new` / `has_grammar` can
#     look up "shell" and find its loaded grammar.
#
# File cap per grammar: 32KB (plenty; the largest bundled grammar
# source is ~7KB, llvm_ir.cyml, and every compacted blob is under 3KB).

# grammar_blobs.cyr is generated by scripts/embed-grammars.sh.
# It supplies _grammar_blob_data(path) used in grammar_load below.

var GRAMMAR_FILE_CAP = 32768;

# ── Grammar record ──────────────────────────
# Layout (offsets in bytes):
#    0  name                cstr ptr
#    8  extensions          Vec<cstr>   path suffixes that route here (ADR 0025)
#   16  shebangs            Vec<cstr>   interpreters that route here (ADR 0025)
#   24  shebang_on          i64  (0/1)
#   32  whitespace_on       i64
#   40  ident_start_tbl     ptr to 256-byte char-class lookup
#   48  ident_cont_tbl      ptr to 256-byte char-class lookup
#   56  number_decimal      i64
#   64  number_0x           i64
#   72  number_0b           i64
#   80  number_0o           i64
#   88  special_vars        i64
#   96  operators           Vec<cstr>   longest-first ordering
#  104  punctuation         Vec<cstr>   longest-first ordering
#  112  line_rules          Vec<LineRule>
#  120  pair_rules          Vec<PairRule>
#  128  words_rules         Vec<WordsRule>
#  136  unicode_ident_on    i64  (0/1) — bytes ≥0x80 join ident runs
#  144  char_literal_on     i64  (0/1) — `'C'` / `'\C'` / `'\xHH'` as one TK_STRING
#  152  case_insensitive_kw i64  (0/1) — keyword lookup folds A-Z to a-z
#  160  compose_rules       Vec<ComposeRule> — embedded-grammar routing
#  168  compose_fenced_rules Vec<ComposeFencedRule> — captured-tag routing (ADR 0016)
#  176  compose_region_rules Vec<ComposeRegionRule> — open-ended region routing (ADR 0019)
#  184  heredoc_rules       Vec<HeredocRule> — here-documents (ADR 0023, 2.6.0)
#  192  filenames           Vec<cstr>   basenames that route here (ADR 0025, 2.6.2)
#  200  number_float        i64  (0/1) — `1.5`, `1e5`, `2.5e-3` as one number (ADR 0026, 2.7.0)
#  208  number_separator    i64  digit separator byte (`_`, `'`), 0 = none, -1 = invalid (ADR 0026)
#  216  number_datetime     i64  (0/1) — RFC 3339 dates / times as one number (ADR 0026)
#  224  ident_lead_tbl      ptr to char-class, or 0 — bytes that start an ident only
#                           before an ident byte: css `-` (ADR 0027, 2.7.1)
#  232  string_prefixes     Vec<cstr> — idents that join a following string / char (ADR 0027)
#  240  raw_string_prefixes Vec<cstr> — the same, with the string's escape off (ADR 0027)
#  248  number_tuple_index  i64  (0/1) — a number right after a lone `.` takes no
#                           fraction: Swift `t.0.1` is `t . 0 . 1` (ADR 0026, 2.9.3)
#  -----
#  256 bytes total
#
# `extensions`, `filenames` and `shebangs` declare what
# `src/detect.cyr` routes to this grammar. Detection does not read
# them — it is compiled — but tests/vyakarana.tcyr and
# scripts/check-detect.sh hold the two equal in both directions.
# (Fence-tag lookup does read `extensions` and `shebangs`:
# `registry_find_fence_tag`, 2.9.1.)

var GRAMMAR_SIZE = 256;

fn grammar_new() {
    var g = alloc(GRAMMAR_SIZE);
    var i = 0;
    while (i < GRAMMAR_SIZE) {
        store8(g + i, 0);
        i = i + 1;
    }
    store64(g + 8,   vec_new());   # extensions
    store64(g + 16,  vec_new());   # shebangs
    store64(g + 96,  vec_new());   # operators
    store64(g + 104, vec_new());   # punctuation
    store64(g + 112, vec_new());   # line_rules
    store64(g + 120, vec_new());   # pair_rules
    store64(g + 128, vec_new());   # words_rules
    store64(g + 160, vec_new());   # compose_rules
    store64(g + 168, vec_new());   # compose_fenced_rules
    store64(g + 176, vec_new());   # compose_region_rules
    store64(g + 184, vec_new());   # heredoc_rules (2.6.0)
    store64(g + 192, vec_new());   # filenames (2.6.2)
    store64(g + 232, vec_new());   # string_prefixes (2.7.1)
    store64(g + 240, vec_new());   # raw_string_prefixes (2.7.1)
    return g;
}

fn grammar_name(g)           { return load64(g); }
fn grammar_extensions(g)     { return load64(g + 8); }
fn grammar_shebangs(g)       { return load64(g + 16); }
fn grammar_shebang_on(g)     { return load64(g + 24); }
fn grammar_whitespace_on(g)  { return load64(g + 32); }
fn grammar_ident_start(g)    { return load64(g + 40); }
fn grammar_ident_cont(g)     { return load64(g + 48); }
fn grammar_number_decimal(g) { return load64(g + 56); }
fn grammar_number_0x(g)      { return load64(g + 64); }
fn grammar_number_0b(g)      { return load64(g + 72); }
fn grammar_number_0o(g)      { return load64(g + 80); }
fn grammar_special_vars(g)   { return load64(g + 88); }
fn grammar_operators(g)      { return load64(g + 96); }
fn grammar_punctuation(g)    { return load64(g + 104); }
fn grammar_line_rules(g)     { return load64(g + 112); }
fn grammar_pair_rules(g)     { return load64(g + 120); }
fn grammar_words_rules(g)    { return load64(g + 128); }
fn grammar_unicode_ident(g)  { return load64(g + 136); }
fn grammar_char_literal(g)   { return load64(g + 144); }
fn grammar_case_insensitive_kw(g) { return load64(g + 152); }
fn grammar_compose_rules(g)        { return load64(g + 160); }
fn grammar_compose_fenced_rules(g) { return load64(g + 168); }
fn grammar_compose_region_rules(g) { return load64(g + 176); }
fn grammar_heredoc_rules(g)        { return load64(g + 184); }
fn grammar_filenames(g)            { return load64(g + 192); }
fn grammar_number_float(g)         { return load64(g + 200); }
fn grammar_number_sep(g)           { return load64(g + 208); }
fn grammar_number_datetime(g)      { return load64(g + 216); }
fn grammar_ident_lead(g)           { return load64(g + 224); }
fn grammar_string_prefixes(g)      { return load64(g + 232); }
fn grammar_raw_string_prefixes(g)  { return load64(g + 240); }
fn grammar_number_tuple_index(g)   { return load64(g + 248); }

# Here-document rule (ADR 0023): `start` opens it (`<<`); an optional
# one-byte `indent` marker right after the start (`-` for `<<-`) lets
# the terminator line be indented by tabs. The body plus terminator is
# one `kind` token (string).
var HEREDOC_RULE_SIZE = 24;
fn heredoc_rule_new(kind, start, indent) {
    var r = alloc(HEREDOC_RULE_SIZE);
    if (r == 0) { return 0; }
    store64(r,      kind);
    store64(r + 8,  start);
    store64(r + 16, indent);
    return r;
}
fn heredoc_rule_kind(r)   { return load64(r); }
fn heredoc_rule_start(r)  { return load64(r + 8); }
fn heredoc_rule_indent(r) { return load64(r + 16); }

# ── Rule sub-records ────────────────────────

# start_after @ 16 (2.6.0, ADR 0022); followed_by @ 24, not_followed_by @ 32
# (2.7.1, ADR 0027).
var LINE_RULE_SIZE = 40;
fn line_rule_new(kind, start) {
    var r = alloc(LINE_RULE_SIZE);
    store64(r,     kind);
    store64(r + 8, start);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0);
    return r;
}
fn line_rule_kind(r)  { return load64(r); }
fn line_rule_start(r) { return load64(r + 8); }
# `start_after` (ADR 0022): a cstr of bytes, or 0. When set, the start
# marker counts only at the start of input or right after one of these
# bytes — shell's `#` begins a comment only at the start of a word.
fn line_rule_after(r) { return load64(r + 16); }
# `followed_by` / `not_followed_by` (ADR 0027, 2.7.1): 256-byte char-class
# tables, or 0. The marker counts only when the byte after it is (is
# not) in the class — Cyrius's `#ifdef` is a directive and `# x` a
# comment; PHP 8's `#[Attr]` is not a comment. At the end of input
# there is no next byte: `followed_by` fails, `not_followed_by` holds.
fn line_rule_followed(r)     { return load64(r + 24); }
fn line_rule_not_followed(r) { return load64(r + 32); }

var PAIR_RULE_SIZE = 32;
fn pair_rule_new(kind, start, end, escape_byte) {
    var r = alloc(PAIR_RULE_SIZE);
    store64(r,      kind);
    store64(r + 8,  start);
    store64(r + 16, end);
    store64(r + 24, escape_byte);
    return r;
}
fn pair_rule_kind(r)   { return load64(r); }
fn pair_rule_start(r)  { return load64(r + 8); }
fn pair_rule_end(r)    { return load64(r + 16); }
fn pair_rule_escape(r) { return load64(r + 24); }

var WORDS_RULE_SIZE = 16;
fn words_rule_new(kind, words_vec) {
    var r = alloc(WORDS_RULE_SIZE);
    store64(r,     kind);
    store64(r + 8, words_vec);
    return r;
}
fn words_rule_kind(r)  { return load64(r); }
fn words_rule_words(r) { return load64(r + 8); }

# Compose rule — routes bytes between `start` and `end` markers
# through a different grammar (looked up by name). See ADR 0013.
var COMPOSE_RULE_SIZE = 40;   # +16 in 2.5.2: no-closer watermark (gen @ 24, from @ 32)
fn compose_rule_new(start, end, inner_name) {
    var r = alloc(COMPOSE_RULE_SIZE);
    store64(r,      start);
    store64(r + 8,  end);
    store64(r + 16, inner_name);
    store64(r + 24, 0);
    store64(r + 32, 0);
    return r;
}
fn compose_rule_start(r) { return load64(r); }
fn compose_rule_end(r)   { return load64(r + 8); }
fn compose_rule_inner(r) { return load64(r + 16); }

# Compose-fenced rule — same shape as ComposeRule minus the
# `inner` field. The inner grammar is captured per-fence-
# instance from the bytes between `start` and the next newline
# (the "info string" in CommonMark terms). See ADR 0016.
# +16 in 2.5.2: no-closer watermark (gen @ 16, from @ 24). +8 in 2.9.1:
# `end_indent` @ 32, a cstr of the bytes that may precede the end marker
# on its line (markdown: space, tab, `>`), or 0 for column 0 only.
var COMPOSE_FENCED_RULE_SIZE = 40;
fn compose_fenced_rule_new(start, end) {
    var r = alloc(COMPOSE_FENCED_RULE_SIZE);
    store64(r,     start);
    store64(r + 8, end);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0);
    return r;
}
fn compose_fenced_rule_start(r) { return load64(r); }
fn compose_fenced_rule_end(r)   { return load64(r + 8); }
fn compose_fenced_rule_end_indent(r) { return load64(r + 32); }

# Compose-region rule — routes an OPEN-ENDED region through
# another grammar. Differs from ComposeRule (ADR 0013) in the two
# ways CYML needs and `compose` cannot express (see ADR 0019):
#
#   1. `end_before` is a LOOKAHEAD terminator. The region stops
#      just before it and the marker bytes are left for the outer
#      grammar. `compose` consumes its `end`, which would eat the
#      `[[entries]]` that begins CYML's next TOML header.
#   2. Reaching EOF without the terminator is SUCCESS, not
#      failure — the region simply runs to the end of input.
#      `compose` bails and emits nothing, so CYML's final body
#      (always EOF-terminated) got no routing at all.
#
# An empty `end_before` means "always run to EOF".
var COMPOSE_REGION_RULE_SIZE = 24;
fn compose_region_rule_new(start, end_before, inner_name) {
    var r = alloc(COMPOSE_REGION_RULE_SIZE);
    store64(r,      start);
    store64(r + 8,  end_before);
    store64(r + 16, inner_name);
    return r;
}
fn compose_region_rule_start(r)      { return load64(r); }
fn compose_region_rule_end_before(r) { return load64(r + 8); }
fn compose_region_rule_inner(r)      { return load64(r + 16); }

# ── Char-class lookup tables ────────────────
# A 256-byte table indexed by byte; value is 0 or 1. Built from a
# char-class spec like "A-Za-z_" or "0-9". The spec syntax is a small
# deliberate subset: `X-Y` is a range; any other single char is that
# literal byte; concatenation is disjunction.

fn char_class_new(spec) {
    var tbl = alloc(256);
    var i = 0;
    while (i < 256) { store8(tbl + i, 0); i = i + 1; }
    if (spec == 0) { return tbl; }
    var n = strlen(spec);
    var p = 0;
    while (p < n) {
        var c = load8(spec + p);
        # Range `X-Y`
        if (p + 2 < n) {
            if (load8(spec + p + 1) == 45) {  # `-`
                var lo = c;
                var hi = load8(spec + p + 2);
                var b = lo;
                while (b <= hi) {
                    store8(tbl + b, 1);
                    b = b + 1;
                }
                p = p + 3;
                continue;
            }
        }
        store8(tbl + c, 1);
        p = p + 1;
    }
    return tbl;
}

fn char_class_match(tbl, byte) {
    return load8(tbl + byte);
}

# ── CYML parser ─────────────────────────────
# Grammar files are a deliberately small TOML dialect:
#   - `[section]` header
#   - `[[rules]]` entry marker
#   - `key = value` lines (value is "string", true/false, or ["a","b"])
#   - `#` line comments
#   - arrays may span lines
#
# Whitespace is liberal. Escape sequences inside strings: `\\`, `\"`,
# `\n`, `\t`, `\r`; a `\` before other punctuation is that byte, and
# before any other letter or digit it rejects the grammar
# (`_gp_bad_escape`). That's enough for grammar files; we don't need
# the full TOML escape set.

fn _gp_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

# Skip spaces and tabs (not newlines) at buf[pos].
fn _gp_skip_hspace(buf, len, pos) {
    while (pos < len) {
        var b = load8(buf + pos);
        if (_gp_is_space(b) == 0) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# Skip spaces, tabs, newlines, and `#` line-comments.
fn _gp_skip_ws_and_comments(buf, len, pos) {
    while (pos < len) {
        var b = load8(buf + pos);
        if (_gp_is_space(b) == 1) { pos = pos + 1; continue; }
        if (b == 10) { pos = pos + 1; continue; }
        if (b == 35) {  # `#` comment to EOL
            while (pos < len) {
                if (load8(buf + pos) == 10) { pos = pos + 1; break; }
                pos = pos + 1;
            }
            continue;
        }
        return pos;
    }
    return pos;
}

# Advance past end-of-line (consumes the `\n`).
fn _gp_skip_to_eol(buf, len, pos) {
    while (pos < len) {
        if (load8(buf + pos) == 10) { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}

# Escapes `_gp_parse_string` could not decode in the current
# `_gp_parse` — a backslash before a letter or digit other than n / t
# / r. Counted, and the grammar rejected, because the old behaviour
# (drop the backslash, keep the letter) turned shell's `start_after`
# `\r` into the letter `r`: every `#` after an `r` opened a comment,
# `${dir##*/}` included (2.6.0; 2.6.x audit). A backslash before
# punctuation (`\$`, `\.`) still means that byte.
var _gp_bad_escape = 0;

# Parse a quoted string starting at buf[pos] (first byte must be `"`).
# Writes the resulting cstr to *out_ptr and returns the position just
# past the closing `"`. Handles \\, \", \n, \t, \r escapes.
fn _gp_parse_string(buf, len, pos, out_ptr) {
    if (load8(buf + pos) != 34) { store64(out_ptr, 0); return pos; }
    pos = pos + 1;
    # First pass: compute the decoded length so we can allocate once.
    var p = pos;
    var dlen = 0;
    while (p < len) {
        var b = load8(buf + p);
        if (b == 34) { break; }
        if (b == 92) {   # `\`
            if (p + 1 >= len) { break; }
            p = p + 2;
            dlen = dlen + 1;
        } else {
            p = p + 1;
            dlen = dlen + 1;
        }
    }
    var s = alloc(dlen + 1);
    var q = pos;
    var di = 0;
    while (q < len) {
        var b = load8(buf + q);
        if (b == 34) { q = q + 1; break; }
        if (b == 92) {
            if (q + 1 >= len) { q = len; break; }
            var esc = load8(buf + q + 1);
            var out = esc;
            if (esc == 110) { out = 10; }   # \n
            if (esc == 116) { out = 9; }    # \t
            if (esc == 114) { out = 13; }   # \r (2.6.x audit)
            # \\ and \" pass through as the next byte itself.
            if (out == esc) {
                if (((esc >= 48) && (esc <= 57)) || ((esc >= 65) && (esc <= 90)) || ((esc >= 97) && (esc <= 122))) {
                    _gp_bad_escape = _gp_bad_escape + 1;
                }
            }
            store8(s + di, out);
            di = di + 1;
            q = q + 2;
        } else {
            store8(s + di, b);
            di = di + 1;
            q = q + 1;
        }
    }
    store8(s + di, 0);
    store64(out_ptr, s);
    return q;
}

# Scratch out-parameter slots for the parse helpers: +0 / +8 are
# `_gp_apply_kv`'s string and bool results, +16 is the array parser's
# element. Each value is read back the moment it is written, and no
# helper re-enters another while holding one, so one 24-byte block
# serves every grammar. Through 2.6.1 every key took two fresh 8-byte
# allocations and every array element one, never freed: 55,688 of the
# 305,944 bytes `bootstrap_grammars` allocated (2.6.x audit).
var _gp_slots = 0;

fn _gp_slot(off) {
    if (_gp_slots == 0) { _gp_slots = alloc(24); }
    if (_gp_slots == 0) { return 0; }
    store64(_gp_slots + off, 0);
    return _gp_slots + off;
}

# Parse an array literal starting at buf[pos] (first byte must be `[`).
# Pushes each element (as a cstr) into out_vec. Returns position past `]`.
fn _gp_parse_string_array(buf, len, pos, out_vec) {
    if (load8(buf + pos) != 91) { return pos; }
    pos = pos + 1;
    while (pos < len) {
        pos = _gp_skip_ws_and_comments(buf, len, pos);
        if (pos >= len) { return pos; }
        var b = load8(buf + pos);
        if (b == 93) { return pos + 1; }    # `]`
        if (b == 44) { pos = pos + 1; continue; }  # `,`
        if (b == 34) {
            var out_slot = _gp_slot(16);
            if (out_slot == 0) { return len; }
            pos = _gp_parse_string(buf, len, pos, out_slot);
            var sptr = load64(out_slot);
            if (sptr != 0) { vec_push(out_vec, sptr); }
            continue;
        }
        # Unknown token — advance to avoid infinite loop.
        pos = pos + 1;
    }
    return pos;
}

# Parse a bare word (letters / digits / underscore / hyphen) at buf[pos].
# Returns length.
fn _gp_read_word(buf, len, pos) {
    var p = pos;
    while (p < len) {
        var b = load8(buf + p);
        var ok = 0;
        if ((b >= 48) && (b <= 57))  { ok = 1; }   # 0-9
        if ((b >= 65) && (b <= 90))  { ok = 1; }   # A-Z
        if ((b >= 97) && (b <= 122)) { ok = 1; }   # a-z
        if (b == 95) { ok = 1; }                   # _
        if (b == 45) { ok = 1; }                   # -
        if (ok == 0) { return p - pos; }
        p = p + 1;
    }
    return p - pos;
}

# Parse a bool literal (`true` / `false`) at buf[pos]. Returns 1/0;
# writes the parsed value to *out_val. Returns the advanced position.
fn _gp_parse_bool(buf, len, pos, out_val) {
    if ((pos + 4 <= len) && (memeq(buf + pos, "true", 4) == 1)) {
        store64(out_val, 1);
        return pos + 4;
    }
    if ((pos + 5 <= len) && (memeq(buf + pos, "false", 5) == 1)) {
        store64(out_val, 0);
        return pos + 5;
    }
    store64(out_val, 0);
    return pos;
}

# Streq-for-slice: does the byte span at buf[pos..pos+slen) equal cstr?
fn _gp_slice_eq(buf, pos, slen, cstr) {
    var clen = strlen(cstr);
    if (slen != clen) { return 0; }
    return memeq(buf + pos, cstr, clen);
}

# Apply a key=value pair to the grammar based on (section, key).
# value_start / value_len slice into buf and point at the raw RHS
# (still quoted / bracketed / bare). Returns 0.
fn _gp_apply_kv(g, current_rule, section, buf, len, key_pos, key_len, value_pos) {
    # Normalize section into an i64 code:
    #   1 = [grammar]
    #   2 = [defaults]
    #   3 = [[rules]]
    # (passed in as `section`; we just branch on it.)
    var out_str_slot = _gp_slot(0);
    var out_bool_slot = _gp_slot(8);
    if (out_bool_slot == 0) { return 0; }

    if (section == 1) {   # [grammar]
        if (_gp_slice_eq(buf, key_pos, key_len, "name") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "extensions") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_extensions(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "shebangs") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_shebangs(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "filenames") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_filenames(g));
            return 0;
        }
        return 0;
    }

    if (section == 2) {   # [defaults]
        if (_gp_slice_eq(buf, key_pos, key_len, "shebang") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 24, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "whitespace") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 32, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "ident_start") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g + 40, char_class_new(load64(out_str_slot)));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "ident_cont") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g + 48, char_class_new(load64(out_str_slot)));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_decimal") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 56, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0x") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 64, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0b") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 72, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0o") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 80, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_float") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 200, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_tuple_index") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 248, load64(out_bool_slot));
            return 0;
        }
        # One byte that is not a digit; anything else rejects the grammar
        # (`_gp_validate`), rather than splitting numbers on a guess.
        if (_gp_slice_eq(buf, key_pos, key_len, "number_separator") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var nsv = load64(out_str_slot);
            store64(g + 208, (0 - 1));
            if (nsv != 0) {
                if (strlen(nsv) == 0) { store64(g + 208, 0); }
                if (strlen(nsv) == 1) {
                    # Printable ASCII punctuation only (2.9.1): a blank or a
                    # line break joined `1\n2\n3` into one number, a letter
                    # ran numbers into identifiers (reviewer C).
                    var nsb = load8(nsv);
                    var nsok = 1;
                    if (_ds_is_digit(nsb) == 1) { nsok = 0; }
                    if ((nsb <= 32) || (nsb >= 127)) { nsok = 0; }
                    if (((nsb | 32) >= 97) && ((nsb | 32) <= 122)) { nsok = 0; }
                    if (nsok == 1) { store64(g + 208, nsb); }
                }
            }
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "ident_lead") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var ils = load64(out_str_slot);
            if (_gp_nonempty(ils) == 1) { store64(g + 224, char_class_new(ils)); }
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "string_prefixes") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_string_prefixes(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "raw_string_prefixes") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_raw_string_prefixes(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_datetime") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 216, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "special_vars") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 88, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "unicode_ident") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 136, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "char_literal") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 144, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "case_insensitive_keywords") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 152, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "operators") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_operators(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "punctuation") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_punctuation(g));
            return 0;
        }
        return 0;
    }

    if (section == 3) {   # [[rules]] — populate current_rule slots
        # current_rule layout: kind @ 0, match_type @ 8, start @ 16,
        # end @ 24, escape_byte @ 32, words @ 40 (Vec) or inner @ 40
        # (cstr), slot-40 tag @ 48 (1 words / 2 inner), kind-given
        # flag @ 56 (those two exist only for `_gp_close_rule`'s
        # validation, 2.5.2), start_after @ 64 (cstr, line rules only;
        # ADR 0022, 2.6.0), indent @ 72 (cstr, heredoc rules only;
        # ADR 0023, 2.6.0), followed_by @ 80 / not_followed_by @ 88
        # (char-class tables, line rules only; ADR 0027, 2.7.1).
        if (_gp_slice_eq(buf, key_pos, key_len, "kind") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var kname = load64(out_str_slot);
            store64(current_rule, _gp_kind_from_name(kname));
            store64(current_rule + 56, 1);      # kind given
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "match") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var mname = load64(out_str_slot);
            var mt = 0;
            if (streq(mname, "line")    == 1) { mt = 1; }
            if (streq(mname, "pair")    == 1) { mt = 2; }
            if (streq(mname, "words")   == 1) { mt = 3; }
            if (streq(mname, "compose") == 1)        { mt = 4; }
            if (streq(mname, "compose_fenced") == 1) { mt = 5; }
            if (streq(mname, "compose_region") == 1) { mt = 6; }
            if (streq(mname, "heredoc") == 1)        { mt = 7; }   # ADR 0023
            store64(current_rule + 8, mt);
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "start") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 16, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "end") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 24, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "end_before") == 1) {
            # compose_region's lookahead terminator. Shares slot 24
            # with `end` — a rule declares one or the other, and
            # only mt==6 reads it as non-consuming. See ADR 0019.
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 24, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "indent") == 1) {
            # Heredoc rules only (ADR 0023): the byte after `start` that
            # allows a tab-indented terminator (`-` for shell's `<<-`).
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 72, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "end_indent") == 1) {
            # compose_fenced rules only (2.9.1): bytes that may precede
            # the end marker on its line.
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 96, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "followed_by") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var fbs = load64(out_str_slot);
            store64(current_rule + 80, 1);                     # given, even if empty
            if (_gp_nonempty(fbs) == 1) { store64(current_rule + 80, char_class_new(fbs)); }
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "not_followed_by") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var nfs = load64(out_str_slot);
            store64(current_rule + 88, 1);
            if (_gp_nonempty(nfs) == 1) { store64(current_rule + 88, char_class_new(nfs)); }
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "start_after") == 1) {
            # Line rules only (ADR 0022); `_gp_close_rule` rejects it
            # on any other match type.
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 64, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "escape") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var es = load64(out_str_slot);
            var eb = 0;
            if (es != 0) {
                if (strlen(es) > 0) { eb = load8(es); }
            }
            store64(current_rule + 32, eb);
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "words") == 1) {
            var v = vec_new();
            _gp_parse_string_array(buf, len, value_pos, v);
            store64(current_rule + 40, v);
            store64(current_rule + 48, 1);      # slot 40 = words Vec
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "inner") == 1) {
            # Compose-rule inner-grammar name (slot 40 doubles as
            # words-vec for type=words OR inner-name cstr for
            # type=compose; they're mutually exclusive by mt).
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 40, load64(out_str_slot));
            store64(current_rule + 48, 2);      # slot 40 = inner cstr
            return 0;
        }
        return 0;
    }
    return 0;
}

# Map a kind name cstr (e.g. "keyword") to a TK_* constant.
fn _gp_kind_from_name(name) {
    if (name == 0) { return TK_ERROR; }
    if (streq(name, "ident") == 1)        { return TK_IDENT; }
    if (streq(name, "keyword") == 1)      { return TK_KEYWORD; }
    if (streq(name, "string") == 1)       { return TK_STRING; }
    if (streq(name, "number") == 1)       { return TK_NUMBER; }
    if (streq(name, "comment") == 1)      { return TK_COMMENT; }
    if (streq(name, "operator") == 1)     { return TK_OPERATOR; }
    if (streq(name, "punctuation") == 1)  { return TK_PUNCTUATION; }
    if (streq(name, "whitespace") == 1)   { return TK_WHITESPACE; }
    if (streq(name, "preprocessor") == 1) { return TK_PREPROCESSOR; }
    if (streq(name, "error") == 1)        { return TK_ERROR; }
    return TK_ERROR;
}

# A non-empty cstr (`0` and `""` both count as missing).
fn _gp_nonempty(cs) {
    if (cs == 0) { return 0; }
    if (load8(cs) == 0) { return 0; }
    return 1;
}

# Finalize the in-progress rule (accumulator) into the appropriate
# typed vec on the grammar. Returns 1 if the rule is INVALID (and
# pushes nothing), 0 if it was accepted.
#
# Through 2.5.1 nothing was checked here, and an incomplete rule
# loaded fine and crashed the scanner later: a `pair` with no `end`,
# a `words` rule with no `words`, a `compose` with no `inner` (NULL
# into the registry lookup), `words` + `inner` in one rule (slot 40
# read as the wrong type), an empty `start` (every line a comment, or
# a zero-length token), an unknown `match` (rule silently dropped).
# No bundled grammar has any of these, but `grammar_load` also reads
# `.cyml` files from disk, and a malformed grammar must fail loudly
# rather than mis-tokenize or take the host down. 2.5.2 audit P2-4.
fn _gp_close_rule(g, rule_acc) {
    if (rule_acc == 0) { return 0; }
    var kind = load64(rule_acc);
    var mt   = load64(rule_acc + 8);
    var start = load64(rule_acc + 16);
    var endp  = load64(rule_acc + 24);
    var esc   = load64(rule_acc + 32);
    var words = load64(rule_acc + 40);
    var slot40 = load64(rule_acc + 48);
    var kind_given = load64(rule_acc + 56);
    var after = load64(rule_acc + 64);
    if ((after != 0) && (mt != 1)) { return 1; }          # start_after: line rules only
    if ((after != 0) && (_gp_nonempty(after) == 0)) { return 1; }
    var indent = load64(rule_acc + 72);
    var fby = load64(rule_acc + 80);
    var nfby = load64(rule_acc + 88);
    var eind = load64(rule_acc + 96);
    if ((eind != 0) && (mt != 5)) { return 1; }           # end_indent: compose_fenced only
    if ((eind != 0) && (_gp_nonempty(eind) == 0)) { return 1; }
    if ((mt < 1) || (mt > 7)) { return 1; }               # unknown `match`
    if ((indent != 0) && (mt != 7)) { return 1; }         # indent: heredoc rules only
    if ((indent != 0) && (_gp_nonempty(indent) == 0)) { return 1; }
    # One byte: the scanner compares only the first, so `indent = "-="`
    # silently meant `-` (2.6.x audit, fixed 2.7.1).
    if ((indent != 0) && (strlen(indent) != 1)) { return 1; }
    # `escape` means something only to a pair rule; on a line or heredoc
    # rule it was accepted and ignored (2.6.x audit, fixed 2.7.1).
    if ((esc != 0) && (mt != 2)) { return 1; }
    # followed_by / not_followed_by: line rules only, and not empty
    # (an empty class would never — or always — match). 1 = given empty.
    if (((fby != 0) || (nfby != 0)) && (mt != 1)) { return 1; }
    if ((fby == 1) || (nfby == 1)) { return 1; }
    if ((mt == 7) && (endp != 0)) { return 1; }           # a heredoc's end is its delimiter
    if ((mt != 3) && (_gp_nonempty(start) == 0)) { return 1; }   # all but `words` need `start`
    if (((mt <= 3) || (mt == 7)) && (kind_given == 0)) { return 1; }   # line / pair / words / heredoc need `kind`
    # pair / compose / compose_fenced need an `end`. compose_region's
    # `end_before` may be absent or empty — its region then runs to EOF
    # (ADR 0019); the 2.5.2 validation required it, which left that
    # documented case, and the drain's until-finish hold, unreachable
    # (2.9.1 audit, reviewer C).
    if (((mt == 2) || (mt == 4) || (mt == 5)) && (_gp_nonempty(endp) == 0)) {
        return 1;                                         # `end`
    }
    if ((mt == 3) && ((slot40 != 1) || (words == 0))) { return 1; }
    if (((mt == 4) || (mt == 6)) && ((slot40 != 2) || (_gp_nonempty(words) == 0))) {
        return 1;                                         # `inner` grammar name
    }
    if ((mt != 3) && (mt != 4) && (mt != 6) && (slot40 != 0)) { return 1; }
    if (mt == 1) {
        var lr = line_rule_new(kind, start);
        store64(lr + 16, after);
        store64(lr + 24, fby);
        store64(lr + 32, nfby);
        vec_push(grammar_line_rules(g), lr);
        return 0;
    }
    if (mt == 2) {
        vec_push(grammar_pair_rules(g), pair_rule_new(kind, start, endp, esc));
        return 0;
    }
    if (mt == 3) {
        vec_push(grammar_words_rules(g), words_rule_new(kind, words));
        return 0;
    }
    if (mt == 4) {
        # Compose: slot 40 holds the inner-grammar name cstr
        # (overlaying words for the words-rule case; mt
        # disambiguates).
        var inner = words;
        vec_push(grammar_compose_rules(g), compose_rule_new(start, endp, inner));
        return 0;
    }
    if (mt == 5) {
        # Compose-fenced: no `inner` — captured per-instance from
        # the input bytes between `start` and the next newline.
        # See ADR 0016.
        var fr = compose_fenced_rule_new(start, endp);
        store64(fr + 32, eind);
        vec_push(grammar_compose_fenced_rules(g), fr);
        return 0;
    }
    if (mt == 7) {
        vec_push(grammar_heredoc_rules(g), heredoc_rule_new(kind, start, indent));
        return 0;
    }
    if (mt == 6) {
        # Compose-region: `end_before` shares slot 24 with `end`
        # (a rule declares one or the other, never both), and the
        # inner-grammar name rides slot 40 exactly as for mt==4.
        # See ADR 0019.
        var region_inner = words;
        vec_push(grammar_compose_region_rules(g),
          compose_region_rule_new(start, endp, region_inner));
        return 0;
    }
    return 0;
}

# Accumulator slots: 0 kind, 8 match, 16 start, 24 end / end_before,
# 32 escape, 40 words / inner, 48 slot-40 tag, 56 kind given,
# 64 start_after, 72 indent, 80 followed_by, 88 not_followed_by,
# 96 end_indent (2.9.1).
fn _gp_new_rule_acc() {
    var r = alloc(104);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 104) { store8(r + i, 0); i = i + 1; }
    return r;
}

# Grammar-level checks once every key is read. Returns 1 if the
# grammar is unusable (2.5.2 audit P2-4): the scanner reads
# `ident_cont` whenever `ident_start` matches and reads both tables
# for any byte >= 0x80 under `unicode_ident`, so a half-declared or
# undeclared ident scanner crashed on the first identifier — or, for
# `unicode_ident`, on the first non-ASCII byte of untrusted input. An
# empty operator / punctuation entry matched everywhere at length 0
# and starved every entry after it. A compose rule whose `inner` is
# the grammar itself recursed without bound.
fn _gp_validate(g) {
    if (grammar_number_sep(g) < 0) { return 1; }
    # Keys that would be accepted and then do nothing (2.9.1 audit,
    # reviewer C): a float or datetime shape without decimal numbers, a
    # tuple index without floats (2.9.3), a lead byte that `ident_start`
    # does not hold.
    if ((grammar_number_decimal(g) == 0) && (grammar_number_float(g) == 1)) { return 1; }
    if ((grammar_number_float(g) == 0) && (grammar_number_tuple_index(g) == 1)) { return 1; }
    if ((grammar_number_decimal(g) == 0) && (grammar_number_datetime(g) == 1)) { return 1; }
    var st = grammar_ident_start(g);
    var ct = grammar_ident_cont(g);
    var lt = grammar_ident_lead(g);
    if (lt != 0) {
        var lb = 0;
        while (lb < 256) {
            if (char_class_match(lt, lb) == 1) {
                if (st == 0) { return 1; }
                if (char_class_match(st, lb) == 0) { return 1; }
            }
            lb = lb + 1;
        }
    }
    # A string prefix is matched as a whole identifier (ADR 0027): one that
    # is not identifier-shaped could never match, so reject it.
    var pv = vec_new();
    vec_push(pv, grammar_string_prefixes(g));
    vec_push(pv, grammar_raw_string_prefixes(g));
    var pvi = 0;
    while (pvi < 2) {
        var plist = vec_get(pv, pvi);
        var pk = 0;
        while (pk < vec_len(plist)) {
            var pw = vec_get(plist, pk);
            if (_gp_nonempty(pw) == 0) { return 1; }
            if ((st == 0) || (ct == 0)) { return 1; }
            if (char_class_match(st, load8(pw)) == 0) { return 1; }
            var pc = 1;
            while (pc < strlen(pw)) {
                if (char_class_match(ct, load8(pw + pc)) == 0) { return 1; }
                pc = pc + 1;
            }
            pk = pk + 1;
        }
        pvi = pvi + 1;
    }
    if ((st == 0) && (ct != 0)) { return 1; }
    if ((st != 0) && (ct == 0)) { return 1; }
    if ((grammar_unicode_ident(g) == 1) && (st == 0)) { return 1; }
    var lists = vec_new();
    vec_push(lists, grammar_operators(g));
    vec_push(lists, grammar_punctuation(g));
    var li = 0;
    while (li < 2) {
        var lv = vec_get(lists, li);
        var k = 0;
        while (k < vec_len(lv)) {
            if (_gp_nonempty(vec_get(lv, k)) == 0) { return 1; }
            k = k + 1;
        }
        li = li + 1;
    }
    var gname = grammar_name(g);
    if (gname != 0) {
        var cr = grammar_compose_rules(g);
        var ci = 0;
        while (ci < vec_len(cr)) {
            if (streq(compose_rule_inner(vec_get(cr, ci)), gname) == 1) { return 1; }
            ci = ci + 1;
        }
        var rr = grammar_compose_region_rules(g);
        var ri = 0;
        while (ri < vec_len(rr)) {
            if (streq(compose_region_rule_inner(vec_get(rr, ri)), gname) == 1) { return 1; }
            ri = ri + 1;
        }
    }
    return 0;
}

# Main parse loop.
fn _gp_parse(buf, len) {
    var g = grammar_new();
    var invalid = 0;      # count of rules `_gp_close_rule` rejected
    _gp_bad_escape = 0;
    var section = 0;      # 0=unset, 1=grammar, 2=defaults, 3=rules
    var current_rule = 0;
    var pos = 0;

    while (pos < len) {
        pos = _gp_skip_ws_and_comments(buf, len, pos);
        if (pos >= len) { break; }
        var b = load8(buf + pos);

        if (b == 91) {    # `[`
            # Either `[[rules]]` or `[section]`
            if ((pos + 1 < len) && (load8(buf + pos + 1) == 91)) {
                # Close previous rule if any
                if (current_rule != 0) { invalid = invalid + _gp_close_rule(g, current_rule); }
                # Expect `[[rules]]`
                pos = pos + 2;
                var wlen = _gp_read_word(buf, len, pos);
                # Ignore the actual word — all `[[...]]` markers start
                # a rule entry in vyakarana grammar files today.
                pos = pos + wlen;
                if ((pos + 1 < len) && (load8(buf + pos) == 93) && (load8(buf + pos + 1) == 93)) {
                    pos = pos + 2;
                }
                pos = _gp_skip_to_eol(buf, len, pos);
                section = 3;
                current_rule = _gp_new_rule_acc();
                continue;
            }
            # `[section]`
            pos = pos + 1;
            var sp = pos;
            var slen = _gp_read_word(buf, len, pos);
            pos = pos + slen;
            if ((pos < len) && (load8(buf + pos) == 93)) { pos = pos + 1; }
            pos = _gp_skip_to_eol(buf, len, pos);
            # An unknown `[section]` reads as no section, so its keys are
            # ignored. Through 2.5.1 it kept the PREVIOUS section, and
            # `[meta] kind = "keyword"` after a rule overwrote that
            # rule's kind (2.5.2 audit P3-j).
            section = 0;
            if (_gp_slice_eq(buf, sp, slen, "grammar")  == 1) { section = 1; }
            if (_gp_slice_eq(buf, sp, slen, "defaults") == 1) { section = 2; }
            continue;
        }

        # Must be a key = value line
        var key_pos = pos;
        var key_len = _gp_read_word(buf, len, pos);
        if (key_len == 0) {
            # Not a word — skip this byte to avoid looping.
            pos = pos + 1;
            continue;
        }
        pos = pos + key_len;
        pos = _gp_skip_hspace(buf, len, pos);
        if ((pos < len) && (load8(buf + pos) == 61)) {   # `=`
            pos = pos + 1;
            pos = _gp_skip_hspace(buf, len, pos);
            _gp_apply_kv(g, current_rule, section, buf, len, key_pos, key_len, pos);
            # Advance past the value. For strings the parse already
            # consumes; for arrays/bools too. We just advance to EOL
            # (arrays may already span lines, but the parser consumed
            # them; the trailing characters on this line, if any, are
            # whitespace/comment).
            pos = _gp_skip_to_eol_past_array(buf, len, pos);
            continue;
        }
        pos = _gp_skip_to_eol(buf, len, pos);
    }

    if (current_rule != 0) { invalid = invalid + _gp_close_rule(g, current_rule); }
    if (invalid > 0) { return 0; }
    if (_gp_bad_escape > 0) { return 0; }
    if (_gp_validate(g) == 1) { return 0; }
    return g;
}

# Advance past the value starting at buf[pos], honoring array
# bracket depth and quoted strings. Leaves pos just past the final
# `\n` after the value.
fn _gp_skip_to_eol_past_array(buf, len, pos) {
    var depth = 0;
    var in_str = 0;
    while (pos < len) {
        var b = load8(buf + pos);
        if (in_str == 1) {
            if (b == 92) {                  # backslash
                if (pos + 1 < len) { pos = pos + 2; continue; }
                pos = pos + 1;
                continue;
            }
            if (b == 34) { in_str = 0; pos = pos + 1; continue; }
            pos = pos + 1;
            continue;
        }
        if (b == 34) { in_str = 1; pos = pos + 1; continue; }
        # A `#` outside a string starts a comment: skip to its LF
        # without reading quotes or brackets in it. Through 2.5.1 a
        # trailing comment holding an unbalanced `"` swallowed the
        # following keys, and one holding `[` swallowed the rest of
        # the file — silently (2.5.2 audit P3-j). The LF itself is
        # left for the depth check below.
        if (b == 35) {
            while ((pos < len) && (load8(buf + pos) != 10)) { pos = pos + 1; }
            continue;
        }
        if (b == 91) { depth = depth + 1; pos = pos + 1; continue; }
        if (b == 93) {
            if (depth > 0) { depth = depth - 1; pos = pos + 1; continue; }
            pos = pos + 1;
            continue;
        }
        if ((b == 10) && (depth == 0)) { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}

# ── Public load API ─────────────────────────

# Load a grammar by file path. Returns a grammar handle, or 0 on an
# I/O error or a grammar the parser rejects (`_gp_parse`: an invalid
# rule, an unknown escape, a failed `_gp_validate` check).
#
# Lookup order:
#   1. Embedded blob registry (src/grammar_blobs.cyr, generated by
#      scripts/embed-grammars.sh and bundled into dist/vyakarana.cyr).
#      This is what bootstrap_grammars() hits at runtime — lets the
#      dist bundle be self-contained, no grammars/ dir needed
#      downstream. See [ADR 0014].
#   2. Filesystem read at `path`, for a path that is NOT a bundled
#      grammar (a consumer's own `.cyml`). A bundled path always
#      resolves to its blob, so editing `grammars/foo.cyml` has no
#      effect until `scripts/embed-grammars.sh` re-runs. (This comment,
#      ADR 0014 and the embed script used to promise "edit a .cyml,
#      re-run vyk without regenerating" — never true: the blob wins,
#      and `vyk grammars/foo.cyml` tokenizes that file as CYML source
#      rather than loading it as a grammar. 2.5.2 audit.)
fn grammar_load(path) {
    var blob = _grammar_blob_data(path);
    if (blob != 0) {
        # The blob is parsed in place. The parser never writes to its
        # input — string values are decoded into fresh allocations —
        # and the literal is NUL-terminated, which covers the one
        # read at `buf[len]` a value at EOF makes. Through 2.5.1 this
        # copied every blob into a fresh 32 KiB buffer on the stated
        # grounds that "the parser writes NUL terminators in place";
        # it does not, and the copies cost ~1.5 MB of never-freed heap
        # at bootstrap (46 x 32 KiB). 2.5.2 audit P3.
        # Refuse a blob that doesn't fit rather than clamping it.
        # FINDING-007 (2026-05-09 audit) added a clamp here to stop
        # the copy overflowing `buf`; that fixed the memory safety
        # but left the behaviour silent — a >32KB grammar would be
        # cut mid-rule and parsed as if complete, yielding a
        # tokenizer that is subtly wrong rather than absent. 2.3.4
        # makes it loud: return 0, which `bootstrap_grammars` turns
        # into "language not registered" and the CLI reports as
        # `no grammar matched`. Today's largest blob is 2,774 B
        # (llvm_ir; blobs are compacted since 2.9.0, ADR 0029 — its
        # source is 7,120 B) against a 32,768 B cap, so this is unreachable —
        # it exists so that growing past the cap fails visibly
        # instead of corrupting output. Same reasoning as the
        # VYK_SRC_CAP guard in `src/main.cyr` (2.3.4).
        var bn = strlen(blob);
        if (bn > GRAMMAR_FILE_CAP - 1) { return 0; }
        return _gp_parse(blob, bn);
    }
    var buf = alloc(GRAMMAR_FILE_CAP);
    if (buf == 0) { return 0; }
    var n = file_read_all(path, buf, GRAMMAR_FILE_CAP - 1);
    if (n <= 0) { return 0; }
    # `file_read_all` stops once it has filled `maxlen`, so a read
    # of exactly the cap cannot be distinguished from a truncated
    # one. Refuse both — parsing a half-read grammar file silently
    # produces a wrong tokenizer. (Dev-workflow path only; the
    # bundled grammars come through the blob branch above.)
    if (n >= GRAMMAR_FILE_CAP - 1) { return 0; }
    store8(buf + n, 0);
    return _gp_parse(buf, n);
}

# ── Registry ────────────────────────────────
# A flat vec of grammar handles. `registry_init` is idempotent so
# `bootstrap_grammars` can call it lazily.

var _registry = 0;

fn registry_init() {
    if (_registry == 0) { _registry = vec_new(); }
    return _registry;
}

fn registry_add(g) {
    registry_init();
    vec_push(_registry, g);
    return 0;
}

# A 0 name finds nothing. Through 2.5.1 it reached `streq(gn, 0)`
# and segfaulted, so `has_grammar(0)` and `tokenize_stream_new(0)`
# crashed — and `detect_language()` returns 0 for an unknown path,
# making `tokenize_stream_new(detect_language(path))` the natural
# call that took the host down. 2.5.2 audit P2-3.
fn registry_find_by_name(name) {
    if (name == 0) { return 0; }
    registry_init();
    var n = vec_len(_registry);
    var i = 0;
    while (i < n) {
        var g = vec_get(_registry, i);
        var gn = grammar_name(g);
        if (gn != 0) {
            if (streq(gn, name) == 1) { return g; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 if cstr `a` is the `bl` bytes at `b`, ignoring ASCII case.
fn _reg_ieq(a, b, bl) {
    if (strlen(a) != bl) { return 0; }
    var i = 0;
    while (i < bl) {
        var x = load8(a + i);
        var y = load8(b + i);
        if ((x >= 65) && (x <= 90)) { x = x + 32; }
        if ((y >= 65) && (y <= 90)) { y = y + 32; }
        if (x != y) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The grammar a code-fence tag names (2.9.1, ADR 0016): the grammar of
# that name; else, ignoring ASCII case, the first grammar in registry
# order whose name is the tag, whose `extensions` hold `.tag`, or whose
# `shebangs` hold the tag — `Python`, `sh`, `bash`, `cyr`, `js`, `node`.
# Through 2.9.0 only an exact name resolved: 3,679 of the 7,607 tagged
# fences in one machine's 7,770 markdown files (`sh` and `bash` alone
# 3,140) came back as one plain string.
fn registry_find_fence_tag(tag) {
    if (tag == 0) { return 0; }
    var g = registry_find_by_name(tag);
    if (g != 0) { return g; }
    var tl = strlen(tag);
    if (tl == 0) { return 0; }
    registry_init();
    var n = vec_len(_registry);
    var pass = 0;
    while (pass < 3) {
        var i = 0;
        while (i < n) {
            var gg = vec_get(_registry, i);
            if ((pass == 0) && (grammar_name(gg) != 0)) {
                if (_reg_ieq(grammar_name(gg), tag, tl) == 1) { return gg; }
            }
            var v = 0;
            if (pass == 1) { v = grammar_extensions(gg); }
            if (pass == 2) { v = grammar_shebangs(gg); }
            var e = 0;
            while ((v != 0) && (e < vec_len(v))) {
                var w = vec_get(v, e);
                if (pass == 1) {
                    if ((load8(w) == 46) && (_reg_ieq(w + 1, tag, tl) == 1)) { return gg; }
                }
                if (pass == 2) {
                    if (_reg_ieq(w, tag, tl) == 1) { return gg; }
                }
                e = e + 1;
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return 0;
}

fn list_languages_into(out_vec) {
    registry_init();
    var n = vec_len(_registry);
    var i = 0;
    while (i < n) {
        var g = vec_get(_registry, i);
        var gn = grammar_name(g);
        if (gn != 0) { vec_push(out_vec, gn); }
        i = i + 1;
    }
    return 0;
}

# --- default_scanner.cyr ---

# vyakarana — data-driven default scanner
#
# Consumes a loaded grammar record (see src/grammar.cyr) and tokenizes
# source bytes into a tokenbuf. Scanner dispatch follows ADR 0005:
#
#   H. queued here-document bodies (ADR 0023), at the
#      line start after their opener line            → kind, 1 per body
#   0. [[rules]] match="compose" (ADR 0013)           → recursive
#      (start marker + inner-grammar body + end marker)
#   0b. [[rules]] match="compose_fenced" (ADR 0016)   → recursive
#      (inner grammar captured per-fence from the info string)
#   0c. [[rules]] match="compose_region" (ADR 0019)   → recursive
#      (start marker + inner-grammar body; ends BEFORE an
#       unconsumed lookahead terminator, or at EOF)
#   1. shebang (#! on line 0, column 0)              → preprocessor
#   2. [[rules]] match="line"                         → kind
#   3. [[rules]] match="pair"                         → kind
#   4. defaults.special_vars ($X, X = #?@!*$-)        → operator, 2 bytes
#   5. defaults.special_vars lone $                   → operator, 1 byte
#   6. defaults.ident_start/ident_cont                → ident, or keyword
#      via [[rules]] match="words" lookup, or — with a declared
#      string prefix (ADR 0027) — one string: prefix + literal
#   7. defaults.number_decimal/_0x/_0b/_0o            → number
#      (shaped by number_float / _separator / _datetime /
#       _tuple_index, ADR 0026)
#   7b. defaults.char_literal `'C'`/`'\C'`/`'\xHH'`   → string
#   7c. [[rules]] match="heredoc" opener (ADR 0023)   → consumes nothing;
#      queues the body for step H on the next line
#   8. defaults.operators (first match, longest-first) → operator
#   9. defaults.punctuation (first match, longest-first) → punctuation
#  10. defaults.whitespace (run)                      → whitespace
#  11. fallthrough                                    → error (1 byte)
#
# Coverage invariant holds at every step — the main loop advances by
# `len` on each iteration and a fallback error emits 1 byte when no
# rule matched.
#
# Known optimization, not taken: the operators / punctuation lists
# are scanned linearly longest-first; a trie or length-indexed
# bucket scan would cut the per-token constant. Deliberately still
# open — the tokenize rows in `docs/development/performance.md` are
# dominated by streaming call overhead, not this scan, so it is not
# the profitable lever yet. (This used to say "an easy speedup at
# M5 benchmark time"; M5 landed in 2.0.0-2.0.2, so that framing
# was stale — the work was never the milestone's.)

# ── Scanner helpers (mirror the hand-coded shell.cyr shape) ─────────

fn _ds_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

fn _ds_is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn _ds_is_hex_digit(b) {
    if (_ds_is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }
    if ((b >= 65) && (b <= 70))  { return 1; }
    return 0;
}

fn _ds_is_bin_digit(b) {
    if (b == 48) { return 1; }
    if (b == 49) { return 1; }
    return 0;
}

fn _ds_is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }
    return 1;
}

# Since 2.6.0 the digits too: `$0`..`$9` are positional parameters,
# and splitting them into `$` + number broke `$1x` style words apart
# differently from every other `$X`. Shared by every special_vars
# grammar (shell, makefile — where `$1` is make's `$(1)`).
fn _ds_is_special_var_char(b) {
    if ((b >= 48) && (b <= 57)) { return 1; }   # 0-9
    if (b == 35) { return 1; }   # #
    if (b == 63) { return 1; }   # ?
    if (b == 64) { return 1; }   # @
    if (b == 33) { return 1; }   # !
    if (b == 42) { return 1; }   # *
    if (b == 36) { return 1; }   # $
    if (b == 45) { return 1; }   # -
    return 0;
}

# ── Per-rule try-match functions ────────────
# Each returns a length > 0 if it matched at src[i], else 0.

fn _ds_try_shebang(g, src, src_len, i) {
    if (grammar_shebang_on(g) == 0) { return 0; }
    if (i != 0) { return 0; }
    if (src_len < 2) { return 0; }
    if (load8(src) != 35) { return 0; }      # #
    if (load8(src + 1) != 33) { return 0; }  # !
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Is `b` one of the bytes of cstr `set`?
fn _ds_byte_in(set, b) {
    var k = 0;
    var c = load8(set);
    while (c != 0) {
        if (c == b) { return 1; }
        k = k + 1;
        c = load8(set + k);
    }
    return 0;
}

# Try each [[rules]] match="line" in order. Returns kind packed into
# high 8 bits and len in low 56 bits — 0 if none matched. (This is
# the cheapest multi-return I could find without tuples.)
# `prev0` is the byte before `src[0]` — the streaming drain's last
# committed byte — or -1 when `src` starts the input. A rule with
# `start_after` (ADR 0022) matches only at input start or right after
# one of its bytes: shell's `#` opens a comment only at the start of a
# word, so `${#arr[@]}`, `${x#p}` and `a#b` are not comments. Through
# 2.5.2 the `#` rule fired anywhere and swallowed the rest of the line.
fn _ds_try_line_rules(g, src, src_len, i, prev0) {
    var rules = grammar_line_rules(g);
    var n = vec_len(rules);
    var b0 = load8(src + i);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var marker = line_rule_start(r);
        # First byte inline — it fails almost everywhere, and cyrius has
        # 17 `#word` rules (2.7.1) — then the full marker, then the
        # `start_after` boundary only on a match.
        var boundary_ok = 0;
        var mlen = 0;
        if (load8(marker) == b0) { mlen = strlen(marker); }
        if ((mlen > 0) && (i + mlen <= src_len) && (memeq(src + i, marker, mlen) == 1)) {
            boundary_ok = 1;
            var after = line_rule_after(r);
            if (after != 0) {
                var pb = prev0;
                if (i > 0) { pb = load8(src + i - 1); }
                if (pb >= 0) { boundary_ok = _ds_byte_in(after, pb); }
            }
        }
        # The byte after the marker (ADR 0027): none at the end of input.
        if (boundary_ok == 1) {
            var fb = line_rule_followed(r);
            var nfb = line_rule_not_followed(r);
            if ((fb != 0) || (nfb != 0)) {
                var nb = (0 - 1);
                if (i + mlen < src_len) { nb = load8(src + i + mlen); }
                if (fb != 0) {
                    if (nb < 0) { boundary_ok = 0; }
                    if ((nb >= 0) && (char_class_match(fb, nb) == 0)) { boundary_ok = 0; }
                }
                if ((nfb != 0) && (nb >= 0)) {
                    if (char_class_match(nfb, nb) == 1) { boundary_ok = 0; }
                }
            }
        }
        if (boundary_ok == 1) {
            var j = i;
            while (j < src_len) {
                if (load8(src + j) == 10) { break; }
                j = j + 1;
            }
            var len = j - i;
            return (line_rule_kind(r) << 56) | len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# ── Per-call scanner state (2.5.2) ─────────────────────────────────
# `_ds_cur_gen` names the `tokenize_with_grammar` call in progress:
# every call takes a fresh number on entry and restores its caller's
# on exit, so a compose body tokenized recursively has its own. The
# no-closer watermarks below are trusted only when stamped with the
# CURRENT generation — never across calls, where the same buffer
# pointer can hold different bytes (the streaming drain re-scans one
# rolling buffer that compacts between calls).
var _ds_gen_counter = 0;
var _ds_cur_gen = 0;
var _ds_depth = 0;
var _ds_inner_pool = 0;
var _ds_nolf_gen = 0;
var _ds_nolf_from = 0;

# Compose nesting cap (2.9.1). Two grammars whose compose_region rules
# route into each other (a consumer's own `.cyml`; `_gp_validate` only
# refuses a grammar composing itself) recursed once per region —
# `--- ` x 20,000 (80 KB) overflowed the stack (2.9.1 audit, reviewer C).
# Past this depth a body degrades to one string span, as for a missing
# inner grammar. The bundled grammars nest three deep at most (cyml →
# markdown → html → css).
var DS_MAX_DEPTH = 32;

# Scratch tokenbuf for a compose body's inner tokens at the current
# nesting depth, emptied for reuse; 0 if it cannot be allocated, or
# when the body would nest past DS_MAX_DEPTH — every caller then emits
# the body as one string span.
# Each compose match used to allocate a fresh one, and the bump
# allocator never frees: `<style>a</style>` x 65,000 (1 MB) took
# 57.8 MB of heap (2.5.2 audit P3-e). Safe to reuse because every
# caller copies the inner tokens out before returning, and a nested
# call runs one depth deeper, on its own slot.
fn _ds_inner_tb() {
    if (_ds_depth >= DS_MAX_DEPTH) { return 0; }
    if (_ds_inner_pool == 0) {
        _ds_inner_pool = vec_new();
        if (_ds_inner_pool == 0) { return 0; }
    }
    while (vec_len(_ds_inner_pool) <= _ds_depth) {
        var t = tokenbuf_new();
        if (t == 0) { return 0; }
        vec_push(_ds_inner_pool, t);
    }
    var itb = vec_get(_ds_inner_pool, _ds_depth);
    _tokenbuf_reset(itb);
    return itb;
}

# Try each [[rules]] match="compose" at the cursor.
#
# A compose rule routes the body between `start` and `end`
# markers through a *different* grammar (looked up by name in
# the registry). When matched:
#   - emits `start` bytes as one TK_PUNCTUATION token,
#   - tokenizes the body via the inner grammar (recursively),
#     adjusting offsets so they're absolute in the outer src,
#   - emits `end` bytes as one TK_PUNCTUATION token,
#   - returns the total bytes consumed.
#
# When the inner grammar isn't found in the registry (e.g.
# bootstrap order, or the embedded language was never bundled),
# the body falls back to one TK_STRING token — coverage holds.
#
# Unlike the pair / line / words rule helpers, this one writes
# directly to `tb` and returns the advance length. Returns 0
# when no compose rule matched at this cursor.
#
# Recursion: `tokenize_with_grammar` itself runs compose-rule
# step (step 0 below), so embedded grammars that themselves
# have compose rules nest correctly, up to DS_MAX_DEPTH (2.9.1).
#
# See ADR 0013 for the design.
fn _ds_try_compose_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = compose_rule_end(r);
            var elen = strlen(endp);
            var body_start = i + slen;
            # A search from an earlier body already found no closer
            # anywhere after it in this buffer, so none exists after
            # this one either. Through 2.5.1 every opener re-scanned
            # to EOF: `<style>` x 150k with no `</style>` (1 MiB html)
            # ran past 300 s (2.5.2 audit P2-5).
            if ((load64(r + 24) == _ds_cur_gen) && (body_start >= load64(r + 32))) {
                _ds_cp_hold(i, 3, endp, 0);
                return 0;
            }
            var j = body_start;
            while (j < src_len) {
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    # Found end marker. Emit start, body, end.
                    tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
                    var body_len = j - body_start;
                    if (body_len > 0) {
                        var inner_name = compose_rule_inner(r);
                        var inner_g = registry_find_by_name(inner_name);
                        var inner_tb = 0;
                        if (inner_g != 0) { inner_tb = _ds_inner_tb(); }
                        if (inner_tb != 0) {
                            # Inner grammar found — tokenize body
                            # in the depth's scratch buf, copy with
                            # shifted offsets.
                            tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                var ik = tokenbuf_kind(inner_tb, k);
                                var is = tokenbuf_start(inner_tb, k);
                                var il = tokenbuf_len(inner_tb, k);
                                tokenbuf_push(tb, ik, is + body_start, il);
                                k = k + 1;
                            }
                        } else {
                            # Inner grammar missing (or no scratch
                            # tokenbuf — out of memory; was a NULL
                            # write through 2.5.1) — graceful degrade:
                            # body is one string span.
                            tokenbuf_push(tb, TK_STRING, body_start, body_len);
                        }
                    }
                    tokenbuf_push(tb, TK_PUNCTUATION, j, elen);
                    _ds_grp_add(i, j + elen);
                    return slen + body_len + elen;
                }
                j = j + 1;
            }
            # End marker not found. Record it for this call, then hand
            # the opener back to the normal pipeline. NOTE: this
            # returns from the whole compose step — later compose
            # rules are not tried at this cursor. The comment here
            # used to say "fall through (next compose rule …)"; it
            # never did, and it only matters for two rules whose
            # starts share a prefix (no bundled grammar).
            store64(r + 24, _ds_cur_gen);
            store64(r + 32, body_start);
            _ds_cp_hold(i, 3, endp, 0);
            return 0;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="compose_region" at the cursor.
#
# Same routing as `compose`, with the two differences CYML needs
# (ADR 0019). `end_before` is a LOOKAHEAD terminator: the region
# stops just before it and those bytes are left for the outer
# grammar, so the `[[entries]]` that opens CYML's next TOML header
# survives as TOML. And running out of input is success, not
# failure — the region simply ends at EOF, which is how every
# CYML file's last body terminates.
#
# Emits the start marker plus the routed body. There is no end
# token: the terminator was never ours to consume.
fn _ds_try_compose_region_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_region_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_region_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endb = compose_region_rule_end_before(r);
            var elen = 0;
            if (endb != 0) { elen = strlen(endb); }
            var body_start = i + slen;
            # Scan for the terminator. Falling off the end is the
            # EOF case, and body_end is already correct for it.
            var body_end = src_len;
            var found = 0;
            if (elen > 0) {
                var j = body_start;
                while ((j < src_len) && (found == 0)) {
                    if ((j + elen <= src_len) && (memeq(src + j, endb, elen) == 1)) {
                        body_end = j;
                        found = 1;
                    }
                    j = j + 1;
                }
            }
            # Running into the buffer's end is not the EOF case until the
            # stream finishes: hold it (2.8.0).
            if (found == 0) {
                if (elen > 0) { _ds_cp_hold(i, 3, endb, 0); }
                if (elen == 0) { _ds_cp_hold(i, 4, 0, 0); }
            }
            if (found == 1) { _ds_grp_add(i, body_end); }
            tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
            var body_len = body_end - body_start;
            if (body_len > 0) {
                var inner_name = compose_region_rule_inner(r);
                var inner_g = registry_find_by_name(inner_name);
                var rinner_tb = 0;
                if (inner_g != 0) { rinner_tb = _ds_inner_tb(); }
                if (rinner_tb != 0) {
                    var inner_tb = rinner_tb;
                    tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                    var k = 0;
                    var nk = tokenbuf_count(inner_tb);
                    while (k < nk) {
                        var ik = tokenbuf_kind(inner_tb, k);
                        var is = tokenbuf_start(inner_tb, k);
                        var il = tokenbuf_len(inner_tb, k);
                        tokenbuf_push(tb, ik, is + body_start, il);
                        k = k + 1;
                    }
                } else {
                    # Inner grammar missing (or out of memory) — same
                    # graceful degrade as `compose`: one string span.
                    tokenbuf_push(tb, TK_STRING, body_start, body_len);
                }
            }
            return slen + body_len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# True if `b` is a tag-character (alphanumeric / `+` / `-` / `_`).
# CommonMark info-string is liberal but for grammar-name lookup
# we only care about the closed set [A-Za-z0-9_+-].
fn _ds_is_tag_byte(b) {
    if ((b >= 65) && (b <= 90))  { return 1; }     # A-Z
    if ((b >= 97) && (b <= 122)) { return 1; }     # a-z
    if ((b >= 48) && (b <= 57))  { return 1; }     # 0-9
    if (b == 95) { return 1; }                     # _
    if (b == 43) { return 1; }                     # +
    if (b == 45) { return 1; }                     # -
    return 0;
}

# Walk forward from `start` while bytes are tag-characters.
# Returns the offset just past the last tag byte (or `start` if
# none). Bounded by `src_len`.
fn _ds_scan_tag(src, src_len, start) {
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        # Read ONCE per iteration and advance only if the byte was
        # a tag byte. The previous shape incremented `p` in the
        # first `if` and then re-read `load8(src + p)` in the
        # second WITHOUT re-testing `p < src_len`, so a tag running
        # to the end of the buffer read `src[src_len]` — one byte
        # past the caller's allocation.
        #
        # `vyk` hid it: the CLI NUL-terminates at `buf[n]`, so the
        # stray byte was its own terminator. `tokenize_with_grammar`
        # is public surface though, and a consumer handing over an
        # exactly-sized buffer whose last page ends at src_len takes
        # a SIGSEGV. `_ds_scan_to_lf` below looks like the same
        # pattern but is safe — it increments last, so the loop
        # condition catches `p == src_len` before the next read.
        if (_ds_is_tag_byte(load8(src + p)) == 0) { done = 1; }
        if (done == 0) { p = p + 1; }
    }
    return p;
}

# Walk forward from `start` until LF or end-of-buffer. Returns
# the LF offset, or `src_len` if no LF before EOF.
#
# Watermarked per scanner call (2.5.2 audit P2-5): once a scan from
# `start` reaches EOF with no LF, any later `start` must too. Without
# it, a final line full of fence openers re-scanned to EOF per opener.
fn _ds_scan_to_lf(src, src_len, start) {
    if ((_ds_nolf_gen == _ds_cur_gen) && (start >= _ds_nolf_from)) {
        return src_len;
    }
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        if (load8(src + p) == 10) { done = 1; }
        if (load8(src + p) != 10) { p = p + 1; }
    }
    if (p >= src_len) {
        _ds_nolf_gen = _ds_cur_gen;
        _ds_nolf_from = start;
    }
    return p;
}

# Find the closing fence — earliest offset in [body_start, src_len)
# where the end marker starts a line (body_start counts: it follows the
# open line's LF), or follows a run of the rule's `end_indent` bytes
# from the line start. Returns the offset, or (0 - 1) if no match.
#
# markdown's `end_indent` is space, tab and `>` (2.9.1): a fence in a
# list item (`   ```sh` … `   ````) or a blockquote (`> ```c` … `> ````)
# closes at its own closer. Through 2.9.0 the closer had to be in column
# 0, so such a fence ran on to the next column-0 fence and took its
# opener as the close, pairing every later fence in the document one
# off. The candidates depend only on position — a line start plus such
# a run — never on the opener, so the no-closer watermark's subset
# argument still holds.
fn _ds_find_fenced_close(src, src_len, body_start, endp, elen, ind) {
    var j = body_start;
    var at_start = 1;
    while (j + elen <= src_len) {
        if (at_start == 1) {
            if (memeq(src + j, endp, elen) == 1) { return j; }
        }
        var b = load8(src + j);
        if (b == 10) { at_start = 1; }
        if (b != 10) {
            if (ind == 0) { at_start = 0; }
            if (ind != 0) {
                if (_ds_byte_in(ind, b) == 0) { at_start = 0; }
            }
        }
        j = j + 1;
    }
    return 0 - 1;
}

# Try each [[rules]] match="compose_fenced" at the cursor. Same
# shape as compose, but the inner grammar is captured per-fence
# from the bytes between `start` and the next newline (the
# "info string" in CommonMark terms; we take the first
# tag-character run as the language tag).
#
# Layout of a fence we recognize:
#
#     <start><tag><info-tail>\n<body>\n<end>
#
#   <start>      literal, e.g. "```"
#   <tag>        [A-Za-z0-9_+-]+ (captured language identifier)
#   <info-tail>  ignored bytes up to first \n
#   <body>       routed through grammar named by <tag>
#                (`registry_find_fence_tag`: a name, an extension,
#                or an interpreter — 2.9.1)
#   <end>        literal, e.g. "```"; matches at start-of-line,
#                or after the rule's `end_indent` bytes (2.9.1)
#
# Pipeline placement: same step 0 region as compose, executed
# before the regular pair / line / words steps so the outer
# grammar's tokenizer doesn't eat the fence markers byte-by-byte.
# See ADR 0016.
fn _ds_try_compose_fenced_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_fenced_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    var result = 0;
    while ((r_i < n) && (result == 0)) {
        var r = vec_get(rules, r_i);
        var start = compose_fenced_rule_start(r);
        var slen = strlen(start);
        var match_here = 0;
        if (i + slen <= src_len) {
            if (memeq(src + i, start, slen) == 1) { match_here = 1; }
        }
        if (match_here == 1) {
            var tag_start = i + slen;
            var tag_end = _ds_scan_tag(src, src_len, tag_start);
            var nl_pos  = _ds_scan_to_lf(src, src_len, tag_end);
            if (nl_pos >= src_len) { _ds_cp_hold(i, 2, 0, 0); }

            if (nl_pos < src_len) {
                # Real fence: has a closing LF on the open line.
                var body_start = nl_pos + 1;
                var endp = compose_fenced_rule_end(r);
                var elen = strlen(endp);
                # Same no-closer watermark as `compose` (2.5.2 audit
                # P2-5): every body starts just after an LF, so a later
                # body's line-start candidates are a subset of an
                # earlier failed body's. `x```a` lines x 175k (1 MiB
                # markdown) took 282 s through 2.5.1.
                var close_pos = (0 - 1);
                var fen_known_none = 0;
                if ((load64(r + 16) == _ds_cur_gen) && (body_start >= load64(r + 24))) {
                    fen_known_none = 1;
                }
                if (fen_known_none == 0) {
                    close_pos = _ds_find_fenced_close(src, src_len,
                      body_start, endp, elen,
                      compose_fenced_rule_end_indent(r));
                    if (close_pos < 0) {
                        store64(r + 16, _ds_cur_gen);
                        store64(r + 24, body_start);
                    }
                }
                if (close_pos < 0) {
                    var flead = compose_fenced_rule_end_indent(r);
                    if (flead == 0) { flead = 1; }
                    _ds_cp_hold(i, 3, endp, flead);
                }
                if (close_pos >= 0) {
                    # Resolve inner grammar from captured tag.
                    var tag_len = tag_end - tag_start;
                    var inner_g = 0;
                    if (tag_len > 0) {
                        var tag_buf = alloc(tag_len + 1);
                        var tk = 0;
                        if (tag_buf == 0) { tk = tag_len; }   # OOM: no lookup (2.5.2)
                        while (tk < tag_len) {
                            store8(tag_buf + tk,
                              load8(src + tag_start + tk));
                            tk = tk + 1;
                        }
                        if (tag_buf != 0) {
                            store8(tag_buf + tag_len, 0);
                            inner_g = registry_find_fence_tag(tag_buf);
                        }
                    }

                    # Emit: open-marker (incl. info + LF), body,
                    # close-marker.
                    var open_len = body_start - i;
                    tokenbuf_push(tb, TK_PUNCTUATION, i, open_len);

                    var body_len = close_pos - body_start;
                    if (body_len > 0) {
                        var finner_tb = 0;
                        if (inner_g != 0) { finner_tb = _ds_inner_tb(); }
                        if (finner_tb == 0) { inner_g = 0; }   # OOM degrade
                        if (inner_g != 0) {
                            var inner_tb = finner_tb;
                            tokenize_with_grammar(inner_g,
                              src + body_start,
                              body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                tokenbuf_push(tb,
                                  tokenbuf_kind(inner_tb, k),
                                  tokenbuf_start(inner_tb, k) + body_start,
                                  tokenbuf_len(inner_tb, k));
                                k = k + 1;
                            }
                        }
                        if (inner_g == 0) {
                            # No tag, or tag didn't resolve.
                            tokenbuf_push(tb, TK_STRING,
                              body_start, body_len);
                        }
                    }

                    tokenbuf_push(tb, TK_PUNCTUATION, close_pos, elen);
                    _ds_grp_add(i, close_pos + elen);
                    result = open_len + body_len + elen;
                }
            }
        }
        if (result == 0) { r_i = r_i + 1; }
    }
    return result;
}

# 1 if `src[i..i+n)` is one of the cstrs in `v`.
fn _ds_in_word_list(v, src, i, n) {
    var k = 0;
    while (k < vec_len(v)) {
        var w = vec_get(v, k);
        if (strlen(w) == n) {
            if (memeq(src + i, w, n) == 1) { return 1; }
        }
        k = k + 1;
    }
    return 0;
}

# A string prefix (ADR 0027): when the identifier src[i..i+ilen) is one
# of the grammar's `string_prefixes` / `raw_string_prefixes` and a
# string — or, for a plain prefix, a char literal — starts right after
# it, the length of prefix + literal as ONE string token; else 0.
# `f"{x}"`, `rb'\d'`, Rust `b'\n'` / `r"C:\"`, C `L"wide"`. Through 2.7.0
# the prefix was an identifier before the string.
fn _ds_prefixed_string(g, src, src_len, i, ilen) {
    if (i + ilen >= src_len) { return 0; }
    var q = load8(src + i + ilen);
    if ((q != 34) && (q != 39) && (q != 96)) { return 0; }      # " ' `
    var raw = _ds_in_word_list(grammar_raw_string_prefixes(g), src, i, ilen);
    var plain = 0;
    if (raw == 0) { plain = _ds_in_word_list(grammar_string_prefixes(g), src, i, ilen); }
    if ((raw == 0) && (plain == 0)) { return 0; }
    var packed = _ds_try_pair_rules_x(g, src, src_len, i + ilen, raw);
    if (packed != 0) {
        if ((packed >> 56) == TK_STRING) { return ilen + (packed & 0x00FFFFFFFFFFFFFF); }
    }
    if ((plain == 1) && (grammar_char_literal(g) == 1)) {
        var cl = _ds_try_char_literal(g, src, src_len, i + ilen);
        if (cl > 0) { return ilen + cl; }
    }
    return 0;
}

# `ident_lead` check (ADR 0027): the byte after a lead byte must be able
# to both start and continue an identifier — `--x`, `-webkit`, not `-2`
# or `-$x` — or be a non-ASCII byte under `unicode_ident`.
fn _ds_ident_lead_ok(g, src, src_len, i) {
    if (i + 1 >= src_len) { return 0; }
    var nb = load8(src + i + 1);
    if ((nb >= 128) && (grammar_unicode_ident(g) == 1)) { return 1; }
    var st = grammar_ident_start(g);
    var ct = grammar_ident_cont(g);
    if ((st == 0) || (ct == 0)) { return 0; }
    if ((char_class_match(st, nb) == 1) && (char_class_match(ct, nb) == 1)) { return 1; }
    return 0;
}

# Try each [[rules]] match="pair". Returns packed (kind << 56) | len.
fn _ds_try_pair_rules(g, src, src_len, i) {
    return _ds_try_pair_rules_x(g, src, src_len, i, 0);
}

# The end marker of the last pair this scan ran to the end of the
# buffer, stamped with the scan's generation (2.8.0).
var _ds_pair_eof_gen = 0;
var _ds_pair_eof_end = 0;
var _ds_pair_eof_esc = 0;   # that string's escape byte, 0 = none (2.9.1)

# As `_ds_try_pair_rules`; `noesc` = 1 ignores the rule's escape byte
# (a raw-string prefix, ADR 0027: Rust's `r"C:\"` ends at its quote).
fn _ds_try_pair_rules_x(g, src, src_len, i, noesc) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = pair_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = pair_rule_end(r);
            var elen = strlen(endp);
            var esc = pair_rule_escape(r);
            if (noesc == 1) { esc = 0; }
            var j = i + slen;
            while (j < src_len) {
                var b = load8(src + j);
                if ((esc != 0) && (b == esc)) {
                    j = j + 2;
                    continue;
                }
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    var len = j - i + elen;
                    return (pair_rule_kind(r) << 56) | len;
                }
                j = j + 1;
            }
            # Unterminated — consume to EOF. Noted for the end-of-scan
            # heredoc hold (2.8.0): that string's close is what it waits for.
            var len_eof = src_len - i;
            _ds_pair_eof_gen = _ds_cur_gen;
            _ds_pair_eof_end = endp;
            _ds_pair_eof_esc = esc;
            return (pair_rule_kind(r) << 56) | len_eof;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Longest char literal `_ds_try_char_literal` accepts, quotes
# included: `'\u{10FFFF}'` / `'\U0001F600'` are 12 bytes. The
# streaming drain's marker window (`_stream_max_marker`) holds back
# at least this many bytes for a char_literal grammar, so a literal
# split by a feed boundary is never committed half-seen.
var DS_CHAR_LITERAL_MAX = 12;

# Char literal at the cursor when `[defaults] char_literal = true`.
# Recognises:
#   'C'       → 3 bytes  (any non-`\`, non-`'` byte)
#   '\…'      → 4..12 bytes: `\` plus the escaped byte, then up to
#               the closing quote within DS_CHAR_LITERAL_MAX — so
#               `'\n'`, `'\''`, `'\\'`, `'\xHH'`, `'\033'` (octal),
#               `'\uHHHH'`, `'\UHHHHHHHH'` and `'\u{H…H}'`. Escape
#               digits are not validated; the closing quote is trusted.
#               A newline or a second `\` before the quote means no
#               literal. (Through 2.5.1 only `'\C'` and `'\xHH'` were
#               accepted: C's ubiquitous `'\033'` split into
#               operators + a number, and Rust's `'\u{2026}'` emitted
#               TK_ERROR. 2.5.2 audit P3-c; recorded as ADR 0024.)
#   '<UTF-8>' → 4/5/6 bytes for 2/3/4-byte UTF-8 leading byte ranges
#
# Returns the matched length, or 0 if no shape fits. A 0 return lets
# the leading `'` fall through to the operator step — that's how
# Rust lifetimes (`'a`, `'static`, `'_`) keep working: no closing
# quote at the right offset means "not a char literal."
#
# See ADR 0010.
fn _ds_try_char_literal(g, src, src_len, i) {
    if (grammar_char_literal(g) == 0) { return 0; }
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != 39) { return 0; }   # opening `'`

    var b1 = load8(src + i + 1);
    if (b1 == 39) { return 0; }                # `''` — never valid
    if (b1 == 92) {                            # `\` escape forms
        # src[i+2] is the escaped byte — always part of the escape, so
        # `'\''` and `'\\'` close at i+3. Search on from there.
        var j = i + 3;
        var lim = i + DS_CHAR_LITERAL_MAX;
        var found = 0;
        while ((j < src_len) && (j < lim) && (found == 0)) {
            var c = load8(src + j);
            if (c == 39) { found = j - i + 1; }
            if ((c == 10) || (c == 13) || (c == 92)) { j = lim; }
            if (found == 0) { j = j + 1; }
        }
        return found;
    }

    # `'C'` — 3-byte ASCII body
    if (load8(src + i + 2) == 39) { return 3; }

    # UTF-8 multi-byte body. Leading-byte ranges per RFC 3629:
    #   0xC2..0xDF → 2-byte sequence (4 bytes total incl. quotes)
    #   0xE0..0xEF → 3-byte sequence (5 bytes total)
    #   0xF0..0xF4 → 4-byte sequence (6 bytes total)
    if (b1 >= 194) {
        if (b1 < 224) {
            if (i + 3 < src_len) {
                if (load8(src + i + 3) == 39) { return 4; }
            }
            return 0;
        }
        if (b1 < 240) {
            if (i + 4 < src_len) {
                if (load8(src + i + 4) == 39) { return 5; }
            }
            return 0;
        }
        if (b1 < 245) {
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
    }
    return 0;
}

# Exact-match longest-first list (operators or punctuation). Returns
# the matched length, or 0 if nothing matched.
# The first-byte test runs before `strlen` / `memeq`: nearly every entry
# fails on its first byte, and each call cost more than the comparison
# (2.6.0 — shell's eight new escape / `#` entries made the per-token
# scan measurably slower before this). Equivalent to the plain loop
# because empty entries are rejected at load (2.5.2), and the main loop
# only calls this with `i < src_len`.
fn _ds_try_exact_list(list_vec, src, src_len, i) {
    var n = vec_len(list_vec);
    var b0 = load8(src + i);
    var li = 0;
    while (li < n) {
        var s = vec_get(list_vec, li);
        if (load8(s) == b0) {
            var slen = strlen(s);
            if ((i + slen <= src_len) && (memeq(src + i, s, slen) == 1)) {
                return slen;
            }
        }
        li = li + 1;
    }
    return 0;
}

# Identifier run. Caller has already confirmed the first byte is in
# ident_start (or is a UTF-8 byte ≥0x80 with unicode_ident=true).
# Returns len.
#
# When `unicode_ident = true`, any byte ≥0x80 is also accepted as
# ident-cont so multi-byte UTF-8 sequences (em-dashes, smart
# quotes, accented letters) coalesce into a single TK_IDENT instead
# of fragmenting into per-byte TK_ERROR tokens. See
# [ADR 0009](../../docs/adr/0009-unicode-ident-default.md).
fn _ds_scan_ident(g, src, src_len, i) {
    var cont_tbl = grammar_ident_cont(g);
    var unicode_on = grammar_unicode_ident(g);
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        var ok = char_class_match(cont_tbl, b);
        if ((ok == 0) && (unicode_on == 1) && (b >= 128)) { ok = 1; }
        if (ok == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Case-fold A-Z (0x41–0x5A) to a-z (0x61–0x7A). Other bytes
# pass through unchanged. Used by `_ds_lookup_keyword` when
# `[defaults] case_insensitive_keywords = true`. See ADR 0011.
fn _ds_to_lower(b) {
    if (b >= 65) {
        if (b <= 90) {
            return b + 32;
        }
    }
    return b;
}

# Compare an ident span against a keyword string with optional
# case folding. Returns 1 on match, 0 otherwise. Same byte-by-
# byte cost as `memeq` plus one branch per byte; no allocation.
fn _ds_word_match(src, start, w, wlen, fold) {
    if (fold == 0) {
        return memeq(src + start, w, wlen);
    }
    var i = 0;
    while (i < wlen) {
        var a = _ds_to_lower(load8(src + start + i));
        var b = _ds_to_lower(load8(w + i));
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# If the byte span [start, start+len) matches a word in any words
# rule, returns that rule's kind (an i64). Returns -1 when no match.
# No out-param, no per-call allocation — this runs once per ident
# in the hot path and ADR 0002 forbids per-token allocation.
#
# When `[defaults] case_insensitive_keywords = true`, the match
# folds A-Z to a-z on both sides. ADR 0011 — needed by SQL
# (and PostgreSQL/Oracle/T-SQL dialects) where `SELECT` /
# `select` / `Select` are the same reserved word.
fn _ds_lookup_keyword(g, src, start, len) {
    var rules = grammar_words_rules(g);
    var n = vec_len(rules);
    var fold = grammar_case_insensitive_kw(g);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var words = words_rule_words(r);
        var wn = vec_len(words);
        var w_i = 0;
        while (w_i < wn) {
            var w = vec_get(words, w_i);
            var wlen = strlen(w);
            if (wlen == len) {
                if (_ds_word_match(src, start, w, wlen, fold) == 1) {
                    return words_rule_kind(r);
                }
            }
            w_i = w_i + 1;
        }
        r_i = r_i + 1;
    }
    return 0 - 1;
}

# 1 if the byte before `src[i]` is a lone `.` — not the end of `..`,
# `...` or `..<`. `prev0` / `prev1` are the two bytes before `src[0]`
# (the drain's last committed bytes), -1 where there are none.
fn _ds_after_lone_dot(src, i, prev0, prev1) {
    var b1 = prev0;
    var b2 = prev1;
    if (i >= 1) {
        b1 = load8(src + i - 1);
        b2 = prev0;
    }
    if (i >= 2) { b2 = load8(src + i - 2); }
    if (b1 != 46) { return 0; }
    if (b2 == 46) { return 0; }
    return 1;
}

# Number with optional 0x/0b/0o prefix. Returns length; 0 if not a
# number. Caller has already checked is_digit on src[i]. `prev0` /
# `prev1` as for `_ds_after_lone_dot`.
fn _ds_scan_number(g, src, src_len, i, prev0, prev1) {
    var sep = grammar_number_sep(g);
    if (load8(src + i) == 48) {                # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((grammar_number_0x(g) == 1) && ((p == 120) || (p == 88))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 16) - i;
            }
            if ((grammar_number_0b(g) == 1) && ((p == 98) || (p == 66))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 2) - i;
            }
            if ((grammar_number_0o(g) == 1) && ((p == 111) || (p == 79))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 8) - i;
            }
        }
    }
    if (grammar_number_decimal(g) == 0) { return 0; }
    if (grammar_number_datetime(g) == 1) {
        var dt = _ds_scan_datetime(src, src_len, i);
        if (dt > 0) { return dt; }
    }
    var j = _ds_digit_run(src, src_len, i + 1, sep, 10);
    if (grammar_number_float(g) == 1) {
        # Fraction: `.` then a digit. A digit is required — `1..2` (a
        # range), `1.max()` and `t.0.x` stay split — so a trailing-dot
        # `1.` and a leading-dot `.5` are not floats (ADR 0026). Under
        # `number_tuple_index` a number right after a lone `.` takes
        # none, as Swift's lexer reads `t.0.1` (2.9.3); its exponent is
        # unchanged.
        var frac_ok = 1;
        if (grammar_number_tuple_index(g) == 1) {
            if (_ds_after_lone_dot(src, i, prev0, prev1) == 1) { frac_ok = 0; }
        }
        if ((frac_ok == 1) && (j + 1 < src_len)) {
            if ((load8(src + j) == 46) && (_ds_is_digit(load8(src + j + 1)) == 1)) {
                j = _ds_digit_run(src, src_len, j + 2, sep, 10);
            }
        }
        # Exponent: `e` / `E`, an optional sign, then a digit.
        if (j < src_len) {
            var eb = load8(src + j);
            if ((eb == 101) || (eb == 69)) {
                var k = j + 1;
                if (k < src_len) {
                    if ((load8(src + k) == 43) || (load8(src + k) == 45)) { k = k + 1; }
                }
                if (k < src_len) {
                    if (_ds_is_digit(load8(src + k)) == 1) {
                        j = _ds_digit_run(src, src_len, k + 1, sep, 10);
                    }
                }
            }
        }
    }
    return j - i;
}

# Offset just past the run of base-`base` digits starting at `j`. With a
# digit separator `sep` (`[defaults] number_separator`, ADR 0026), a
# `sep` byte joins the run only when a digit follows it: `1_000` is one
# number, `1_u32` is `1` + `_u32`, `1__0` is `1` + `__0`.
fn _ds_digit_run(src, src_len, j, sep, base) {
    while (j < src_len) {
        var b = load8(src + j);
        var ok = 0;
        if (base == 10) { ok = _ds_is_digit(b); }
        if (base == 16) { ok = _ds_is_hex_digit(b); }
        if (base == 2) { ok = _ds_is_bin_digit(b); }
        if (base == 8) { ok = _ds_is_oct_digit(b); }
        if ((ok == 0) && (sep > 0) && (b == sep) && (j + 1 < src_len)) {
            var nb = load8(src + j + 1);
            if (base == 10) { ok = _ds_is_digit(nb); }
            if (base == 16) { ok = _ds_is_hex_digit(nb); }
            if (base == 2) { ok = _ds_is_bin_digit(nb); }
            if (base == 8) { ok = _ds_is_oct_digit(nb); }
        }
        if (ok == 0) { return j; }
        j = j + 1;
    }
    return src_len;
}

# 1 if src[p..p+n) is n ASCII digits (all inside the buffer).
fn _ds_digits_at(src, src_len, p, n) {
    if (p + n > src_len) { return 0; }
    var k = 0;
    while (k < n) {
        if (_ds_is_digit(load8(src + p + k)) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# Length of the `HH:MM` time at `p`, extended by `:SS`, `.fraction` and
# an offset (`Z` / `z` / `+HH:MM` / `-HH:MM`) when present; 0 if there
# is no `HH:MM` there. TOML 1.1 and YAML make the seconds optional.
fn _ds_scan_time(src, src_len, p) {
    if (_ds_digits_at(src, src_len, p, 2) == 0) { return 0; }
    if (p + 5 > src_len) { return 0; }
    if (load8(src + p + 2) != 58) { return 0; }   # :
    if (_ds_digits_at(src, src_len, p + 3, 2) == 0) { return 0; }
    var q = p + 5;
    if ((q + 3 <= src_len) && (load8(src + q) == 58) && (_ds_digits_at(src, src_len, q + 1, 2) == 1)) {
        q = q + 3;
        if ((q + 1 < src_len) && (load8(src + q) == 46) && (_ds_is_digit(load8(src + q + 1)) == 1)) {
            q = _ds_digit_run(src, src_len, q + 2, 0, 10);
        }
    }
    if (q < src_len) {
        var z = load8(src + q);
        if ((z == 90) || (z == 122)) { return q + 1 - p; }   # Z z
        if ((z == 43) || (z == 45)) {                        # + -
            if ((_ds_digits_at(src, src_len, q + 1, 2) == 1) && (q + 6 <= src_len)) {
                if ((load8(src + q + 3) == 58) && (_ds_digits_at(src, src_len, q + 4, 2) == 1)) {
                    return q + 6 - p;
                }
            }
        }
    }
    return q - p;
}

# RFC 3339 / TOML date-times as one token (`[defaults] number_datetime`,
# ADR 0026): `1979-05-27`, `1979-05-27T07:32:00Z`, `1979-05-27 07:32:00`
# (TOML allows the space), `07:32:00.999` (a local time needs its
# seconds, so `1:20` and `10:30` in prose are not times). 0 if src[i]
# starts none of them; the caller then scans a plain number.
fn _ds_scan_datetime(src, src_len, i) {
    if ((_ds_digits_at(src, src_len, i, 4) == 1) && (i + 10 <= src_len)) {
        if ((load8(src + i + 4) == 45) && (load8(src + i + 7) == 45)) {
            if ((_ds_digits_at(src, src_len, i + 5, 2) == 1) && (_ds_digits_at(src, src_len, i + 8, 2) == 1)) {
                var p = i + 10;
                if (p < src_len) {
                    var tb = load8(src + p);
                    if ((tb == 84) || (tb == 116) || (tb == 32)) {   # T t space
                        var tl = _ds_scan_time(src, src_len, p + 1);
                        if (tl > 0) { return p + 1 + tl - i; }
                    }
                }
                return p - i;
            }
        }
    }
    if ((_ds_digits_at(src, src_len, i, 2) == 1) && (i + 8 <= src_len)) {
        if ((load8(src + i + 2) == 58) && (load8(src + i + 5) == 58)) {
            if ((_ds_digits_at(src, src_len, i + 3, 2) == 1) && (_ds_digits_at(src, src_len, i + 6, 2) == 1)) {
                return _ds_scan_time(src, src_len, i);
            }
        }
    }
    return 0;
}

# Whitespace run.
fn _ds_scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (_ds_is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# ── Here-documents (ADR 0023, 2.6.0) ───────────────────────────────
# A heredoc body is non-local: `cat <<EOF` opens it, the body starts on
# the NEXT line, and a line holding exactly the delimiter ends it. The
# scanner queues each opener whose terminator line exists (up to
# DS_HEREDOC_QUEUE per line), tokenizes the rest of the opener line as
# usual — the `<<` itself stays an operator, the delimiter its own
# token — and at the next top-level line break emits each queued body
# plus its terminator as one `kind` token.
var DS_HEREDOC_QUEUE = 4;
var _ds_hd_pool = 0;

# Lowest `<<` offset in the outer scan whose heredoc was not resolved —
# delimiter valid, but no terminator line yet, or one with no LF after
# it yet. Read (and reset) by the streaming drain, which then commits
# nothing from there on until more input arrives (or finish). -1: none.
var _ds_hd_hold_from = (0 - 1);
# When the hold at `_ds_hd_hold_from` is a plain "terminator line not
# arrived yet" (opener line complete, delimiter known), its details, so
# the drain can watch only NEW lines for the terminator instead of
# re-tokenizing the whole held buffer every feed. 0 = no fast path (the
# hold is an undecided opener, or a terminator missing only its LF).
var _ds_hd_hold_fast = 0;
var _ds_hd_hold_dpos = 0;
var _ds_hd_hold_dlen = 0;
var _ds_hd_hold_ind = 0;
var _ds_hd_hold_body = 0;
# With _ds_hd_hold_dpos = -1: the delimiter's bytes, which quote removal
# rewrote into the scratch slot (valid until this depth's next scan; the
# drain copies them at once). 2.9.1.
var _ds_hd_hold_dptr = 0;
var _ds_hd_hold_marker = 0;   # with _ds_hd_hold_fast = 3: the close to wait for (2.8.0)
var _ds_hd_hold_esc = 0;      #   and its escape byte: an escaped close is no close (2.9.1)

# Through 2.7.1 the scanner reported only the last depth-1 heredoc GROUP
# fully emitted — the opener line's first `<<` through the end of its
# last body token. Every token in it is final (the opener line ended,
# each terminator line has its LF), so the drain commits the group whole
# instead of letting its tail-of-buffer checks split it: a 1-byte body
# (`cat <<E\nE`) sat inside shell's 3-byte marker window and was held
# while its opener line committed — the next drain read the body as code
# (2.6.x audit P2-2).
# Groups (2.8.0): every depth-1 run of tokens that is final as a unit —
# a heredoc opener line through its last body, a compose region from
# its start marker through its end (or up to its `end_before`). The
# drain commits a group whole: none of its tail-of-buffer checks may
# split one, because the next scan would start inside it and read the
# rest with the wrong grammar. Collected only for a drain's scan
# (`_ds_grp_collect`, one-shot like `_ds_buf_prev`), as (from, to)
# pairs in input order.
var _ds_grp_collect = 0;
var _ds_grp_active = 0;
var _ds_grp_buf = 0;
var _ds_grp_cap = 0;
var _ds_grp_n = 0;

fn _ds_grp_add(from, to) {
    if ((_ds_grp_active == 0) || (_ds_depth != 1)) { return 0; }
    if (_ds_grp_n >= _ds_grp_cap) {
        var nc = _ds_grp_cap * 2;
        if (nc < 64) { nc = 64; }
        var nb = alloc(nc * 16);
        if (nb == 0) { return 0; }
        var k = 0;
        while (k < _ds_grp_n * 16) { store8(nb + k, load8(_ds_grp_buf + k)); k = k + 1; }
        _ds_grp_buf = nb;
        _ds_grp_cap = nc;
    }
    store64(_ds_grp_buf + _ds_grp_n * 16, from);
    store64(_ds_grp_buf + _ds_grp_n * 16 + 8, to);
    _ds_grp_n = _ds_grp_n + 1;
    return 0;
}

# Compose hold (2.8.0): the lowest depth-1 compose opener this scan could
# not resolve — a `compose` or `compose_fenced` start with no close in
# the buffer (the scanner then tokenizes it as outer text, but more
# input may close it), or a `compose_region` running into the buffer's
# end. The drain commits nothing from there until it resolves, with a
# watch on `_ds_cp_hold_marker`: mode 2 waits for a line break, 3 for
# the marker (a cstr) anywhere in the new bytes, 4 for finish. Through
# 2.7.1 the drain guessed at this from outside (`prefix_hold`), and the
# compose grammars were not chunk-invariant: cyml failed at 90 % of
# split offsets.
var _ds_cp_hold_from = (0 - 1);
var _ds_cp_hold_mode = 0;
var _ds_cp_hold_marker = 0;
# Where a mode-3 marker counts (2.9.1): 0 anywhere (`</style>`, a cyml
# region's `\n[[`); 1 only at a line start; else a cstr of the bytes
# that may come between the line start and it (a fence's `end_indent`).
# Through 2.9.0 a fence's watch fired on every mid-line "```" and
# re-scanned the whole held fence each time: 1 MB of `s = "```" + x`
# lines in 4 KB chunks took 36 s (2.9.1 audit, reviewer B, F3).
var _ds_cp_hold_lead = 0;

fn _ds_cp_hold(i, mode, marker, lead) {
    if (_ds_depth != 1) { return 0; }
    if ((_ds_cp_hold_from < 0) || (i < _ds_cp_hold_from)) {
        _ds_cp_hold_from = i;
        _ds_cp_hold_mode = mode;
        _ds_cp_hold_marker = marker;
        _ds_cp_hold_lead = lead;
    }
    return 0;
}

# Terminator lookup (2.8.0). Through 2.7.1 each search walked the lines
# after the opener, under a per-call budget of 4 bytes per input byte
# plus 64 KiB (N distinct unterminated openers would otherwise be
# O(N^2)), with a one-entry cache of the last failed delimiter. The
# budget scaled with the BUFFER, so a stream that had compacted earlier
# bytes away gave up sooner than a single feed and a later heredoc came
# back as code (2.6.x audit). Now the first search in a scan indexes
# every line of the buffer once — content (exact, and after leading
# tabs for `<<-`, one trailing CR dropped) hashed into buckets of line
# numbers in input order — and a search is a walk of one bucket from a
# forward-only cursor: searches within a scan never move backwards
# (each opener searches from its line's end, each body from where the
# previous one ended). Linear, no budget, the same verdict however the
# input is chunked.
var _ds_hdi_pool = 0;

# Decoded-delimiter scratch for the current depth: one 256-byte slot
# per queue entry plus one for an opener the full queue cannot take.
# Only a delimiter that quote removal rewrote (`"E"OF`, `E\OF`) lives
# here; a plain or singly-quoted one points into `src`.
var DS_HD_DELIM_MAX = 255;
var _ds_hd_dpool = 0;

# 1 if queue entry `e`'s delimiter lies inside src[0..src_len) — the
# drain's terminator watch takes it as an offset into its buffer. A
# delimiter that quote removal rewrote (`<<"E"OF`, `<<E\OF`) lives in
# the per-depth scratch slot instead, a separate allocation; the opener
# path already gated its fast path on that (`dcontig`), the body step
# did not, and handed the drain a heap address minus `src` as an offset:
# the watch then compared new lines against bytes outside its buffer —
# never firing, or faulting (2.9.1 audit, reviewers A and B). Such a
# delimiter is now reported as offset -1 plus its address
# (`_ds_hd_hold_dptr`), and the drain watches a copy of it.
fn _ds_hd_in_src(e, src, src_len) {
    var d = load64(e);
    if (d < src) { return 0; }
    if (d + load64(e + 8) > src + src_len) { return 0; }
    return 1;
}

fn _ds_hd_dscratch() {
    if (_ds_hd_dpool == 0) {
        _ds_hd_dpool = vec_new();
        if (_ds_hd_dpool == 0) { return 0; }
    }
    while (vec_len(_ds_hd_dpool) <= _ds_depth) {
        var d = alloc((DS_HEREDOC_QUEUE + 1) * 256);
        if (d == 0) { return 0; }
        vec_push(_ds_hd_dpool, d);
    }
    return vec_get(_ds_hd_dpool, _ds_depth);
}

# `_ds_hd_parse_delim` results.
var _ds_hdd_ptr = 0;      # delimiter bytes (into src, or a scratch slot)
var _ds_hdd_len = 0;
var _ds_hdd_end = 0;      # src offset just past the word
var _ds_hdd_pos = (0 - 1);  # src offset of the bytes when contiguous, else -1

# The heredoc delimiter at src[p] as bash reads it: a word of bare
# bytes, `'…'` and `"…"` segments and `\X` escapes, ended by a blank,
# a newline or one of `;&|()<>`, the quotes removed — `EOF`, `'EOF'`,
# `\EOF`, `"E"OF` and `E\OF` all mean `EOF`; `''` is the empty
# delimiter (its terminator is an empty line); `!` and `END-OF-DATA`
# are words. Through 2.7.0 a delimiter was one quoted run or a bare
# `[A-Za-z_][A-Za-z0-9_.-]*`, so the mixed forms read as `E` and `<<!`
# / `<<''` were no heredoc at all. A bare word may not start with a
# digit (`1 << 2` outside `((`…`))` stays a shift). Returns 0 with the
# word in `_ds_hdd_*`, 1 if the buffer ends inside it (undecided), 2
# if there is no delimiter here.
fn _ds_hd_parse_delim(src, src_len, p, slot) {
    var start = p;
    var n = 0;
    var segs = 0;
    var first = (0 - 1);      # src offset of the first delimiter byte
    var contig = 1;           # every byte so far at src[first + its index]
    var quoted = 0;
    var go = 1;
    var rc = 0;
    while ((go == 1) && (p < src_len)) {
        var b = load8(src + p);
        var bare = 1;
        if ((b == 32) || (b == 9) || (b == 10) || (b == 13)) { go = 0; bare = 0; }
        if ((b == 59) || (b == 38) || (b == 124) || (b == 40) || (b == 41) || (b == 60) || (b == 62) || (b == 96)) {
            go = 0;
            bare = 0;
        }
        if ((go == 1) && ((b == 39) || (b == 34))) {
            bare = 0;
            quoted = 1;
            segs = segs + 1;
            var q = p + 1;
            var closed = 0;
            while ((q < src_len) && (closed == 0)) {
                var c = load8(src + q);
                if (c == 10) { closed = 2; }
                if ((closed == 0) && (c == b)) { closed = 1; }
                if ((closed == 0) && (b == 34) && (c == 92) && (q + 1 < src_len)) {
                    var e = load8(src + q + 1);
                    if ((e == 34) || (e == 92) || (e == 36) || (e == 96)) {
                        q = q + 1;
                        c = e;
                    }
                }
                if (closed == 0) {
                    if (first < 0) { first = q; }
                    if (first + n != q) { contig = 0; }
                    if (n < DS_HD_DELIM_MAX) { store8(slot + n, c); }
                    n = n + 1;
                    q = q + 1;
                }
            }
            if (closed == 0) { return 1; }            # quote still open
            if (closed == 2) { return 2; }            # a newline inside it
            p = q + 1;
        }
        if ((go == 1) && (b == 92)) {
            bare = 0;
            segs = segs + 1;
            if (p + 1 >= src_len) { return 1; }
            var x = load8(src + p + 1);
            if (x == 10) { go = 0; }
            if (x != 10) {
                if (first < 0) { first = p + 1; }
                if (first + n != p + 1) { contig = 0; }
                if (n < DS_HD_DELIM_MAX) { store8(slot + n, x); }
                n = n + 1;
                p = p + 2;
            }
        }
        if ((go == 1) && (bare == 1)) {
            if ((n == 0) && (quoted == 0) && (b >= 48) && (b <= 57)) { return 2; }
            if ((n == 0) || (load8(src + p - 1) == 39) || (load8(src + p - 1) == 34)) { segs = segs + 1; }
            if (first < 0) { first = p; }
            if (first + n != p) { contig = 0; }
            if (n < DS_HD_DELIM_MAX) { store8(slot + n, b); }
            n = n + 1;
            p = p + 1;
        }
    }
    if ((n == 0) && (quoted == 0)) { return 2; }
    # Only a delimiter quote removal rewrote needs the slot, so only it is
    # capped. Through 2.9.0 every delimiter was (contiguity was judged by
    # comparing against the capped slot): a 300-byte `<<AAA…` stopped
    # being a heredoc in 2.7.1 (2.9.1 audit, reviewer A, F2).
    if ((n > DS_HD_DELIM_MAX) && (contig == 0)) { return 2; }
    _ds_hdd_len = n;
    _ds_hdd_end = p;
    _ds_hdd_ptr = slot;
    _ds_hdd_pos = (0 - 1);
    # The common forms keep pointing into `src` (the drain's terminator
    # watch needs an offset): the decoded bytes are one contiguous run.
    if ((first >= 0) && (contig == 1)) {
        _ds_hdd_ptr = src + first;
        _ds_hdd_pos = first;
    }
    if (n == 0) {
        _ds_hdd_ptr = src + start;
        _ds_hdd_pos = start;
    }
    if (p >= src_len) { rc = 1; }
    return rc;
}

# Queue buffer for the current nesting depth (entries of 40 bytes:
# delim ptr, delim len, indent flag, kind, opener offset), allocated
# once per depth.
fn _ds_hd_queue() {
    if (_ds_hd_pool == 0) {
        _ds_hd_pool = vec_new();
        if (_ds_hd_pool == 0) { return 0; }
    }
    while (vec_len(_ds_hd_pool) <= _ds_depth) {
        var q = alloc(DS_HEREDOC_QUEUE * 40);
        if (q == 0) { return 0; }
        vec_push(_ds_hd_pool, q);
    }
    return vec_get(_ds_hd_pool, _ds_depth);
}

# Offset just past the delimiter on the first line at or after `from`
# that is exactly `dptr[0..dlen)` — after leading tabs when `ind` is 1,
# ignoring one trailing CR — or -1 if no such line exists. Linear: for
# the drain's terminator watch, which only ever searches new lines.
fn _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind) {
    var ls = from;
    var found = (0 - 1);
    while ((ls < src_len) && (found == (0 - 1))) {
        var p = ls;
        if (ind == 1) {
            while ((p < src_len) && (load8(src + p) == 9)) { p = p + 1; }
        }
        var le = _ds_scan_to_lf(src, src_len, p);
        var ce = le;
        if ((ce > p) && (load8(src + ce - 1) == 13)) { ce = ce - 1; }
        if ((ce - p == dlen) && (memeq(src + p, dptr, dlen) == 1)) { found = p + dlen; }
        ls = le + 1;
    }
    return found;
}

# FNV-1a over src[p..p+n).
fn _ds_hdi_hash(src, p, n) {
    var h = 0xcbf29ce484222325;
    var k = 0;
    while (k < n) {
        h = (h ^ load8(src + p + k)) * 0x100000001b3;
        k = k + 1;
    }
    return h;
}

# The line index for the current depth (struct, 160 bytes):
#    0 gen          8 src         16 lcap (lines)  24 n (lines)
#   32 B (buckets, a power of 2)   40 ebcap (hb / hc)   48 last_from
#   56 ls  u32[lcap] line start         64 last line's end (LF or src_len)
#   72 tb  u32[tcap] after leading tabs 80 nx  u32[ecap] next line, exact bucket (+1; 0 = end)
#   88 tnx u32[tcap] next line, tab-stripped bucket
#   96 hb / 104 thb  u32 bucket heads   112 hc / 120 thc u32 cursors
#  128 ecap (nx)   136 tcap (tb / tnx)   144 tbcap (thb / thc)
#  152 ready: bit 0 the exact half, bit 1 the tab-stripped half
# A line's end is the next line's start less one, so it is not stored,
# and each half — `<<` lookups use the exact one, `<<-` the other — is
# built on its first lookup in the scan: 16 bytes a line for `<<`, 20
# for `<<-`, 32 for both (2.9.4; 36 for either through 2.9.3, 52 in
# 2.8.0). A 1 MiB newline flood after one `cat <<EOF` peaks at 23 MB
# (43 through 2.9.3), after `<<-EOF` at 27.
fn _ds_hdi_get() {
    if (_ds_hdi_pool == 0) {
        _ds_hdi_pool = vec_new();
        if (_ds_hdi_pool == 0) { return 0; }
    }
    while (vec_len(_ds_hdi_pool) <= _ds_depth) {
        var x = alloc(160);
        if (x == 0) { return 0; }
        var z = 0;
        while (z < 160) { store8(x + z, 0); z = z + 1; }
        vec_push(_ds_hdi_pool, x);
    }
    return vec_get(_ds_hdi_pool, _ds_depth);
}

# Line k's end: its LF, or the end of the buffer.
fn _ds_hdi_le(x, k) {
    if (k + 1 < load64(x + 24)) { return load32(load64(x + 56) + (k + 1) * 4) - 1; }
    return load64(x + 64);
}

# Content [cs, ce) of line k for the exact (ind 0) or tab-stripped key.
fn _ds_hdi_ce(src, x, k, cs) {
    var le = _ds_hdi_le(x, k);
    if ((le > cs) && (load8(src + le - 1) == 13)) { le = le - 1; }
    return le;
}

# Capacity at or above `n` lines from `cap`: doubling from 64.
fn _ds_hdi_grow(cap, n) {
    if (cap < 64) { cap = 64; }
    while (cap < n) { cap = cap * 2; }
    return cap;
}

# Index the line starts of src[0..src_len) for this scan; neither half
# is built yet. 0 on allocation failure (the caller then falls back to
# the linear search).
fn _ds_hdi_build(x, src, src_len) {
    var n = 0;
    var p = 0;
    while (p < src_len) {
        n = n + 1;
        p = _ds_scan_to_lf(src, src_len, p) + 1;
    }
    if (n > load64(x + 16)) {
        var cap = _ds_hdi_grow(load64(x + 16), n);
        var a = alloc(cap * 4);
        if (a == 0) { return 0; }
        store64(x + 56, a);
        store64(x + 16, cap);
    }
    # Buckets: the next power of two at or above the line count (load
    # factor <= 1; 2.8.0 used 1/2).
    var b = 16;
    while (b < n) { b = b * 2; }
    var lsa = load64(x + 56);
    var li = 0;
    var le = 0;
    p = 0;
    while (p < src_len) {
        le = _ds_scan_to_lf(src, src_len, p);
        store32(lsa + li * 4, p);
        li = li + 1;
        p = le + 1;
    }
    store64(x + 24, n);
    store64(x + 32, b);
    store64(x + 48, 0);
    store64(x + 64, le);
    store64(x + 152, 0);
    return 1;
}

# Build the exact (ind 0) or tab-stripped (ind 1) half of the index if
# this scan has not yet: bucket chains of line numbers in input order
# over each line's content, and for ind 1 where each line's tabs end.
# 0 on allocation failure.
fn _ds_hdi_half(x, src, ind) {
    var bit = 1 + ind;
    if ((load64(x + 152) & bit) != 0) { return 1; }
    var n = load64(x + 24);
    var b = load64(x + 32);
    # Slots: line-cap, bucket-cap, chain, heads, cursors.
    var lc = 128;
    var bc = 40;
    var nxk = 80;
    var hk = 96;
    var ck = 112;
    if (ind == 1) {
        lc = 136;
        bc = 144;
        nxk = 88;
        hk = 104;
        ck = 120;
    }
    if (n > load64(x + lc)) {
        var cap = _ds_hdi_grow(load64(x + lc), n);
        var na = alloc(cap * 4);
        if (na == 0) { return 0; }
        store64(x + nxk, na);
        if (ind == 1) {
            var ta = alloc(cap * 4);
            if (ta == 0) { return 0; }
            store64(x + 72, ta);
        }
        store64(x + lc, cap);
    }
    if (b > load64(x + bc)) {
        var ha = alloc(b * 4);
        if (ha == 0) { return 0; }
        var ca = alloc(b * 4);
        if (ca == 0) { return 0; }
        store64(x + hk, ha);
        store64(x + ck, ca);
        store64(x + bc, b);
    }
    var heads = load64(x + hk);
    var curs = load64(x + ck);
    var nxa = load64(x + nxk);
    var lsa = load64(x + 56);
    var tba = load64(x + 72);
    var zi = 0;
    while (zi < b) {
        store32(heads + zi * 4, 0);
        store32(curs + zi * 4, 0);
        zi = zi + 1;
    }
    # Insert last line first, so each bucket chain runs in input order.
    var r = n - 1;
    while (r >= 0) {
        var cs = load32(lsa + r * 4);
        if (ind == 1) {
            var le = _ds_hdi_le(x, r);
            while ((cs < le) && (load8(src + cs) == 9)) { cs = cs + 1; }
            store32(tba + r * 4, cs);
        }
        var ce = _ds_hdi_ce(src, x, r, cs);
        var h = _ds_hdi_hash(src, cs, ce - cs) & (b - 1);
        store32(nxa + r * 4, load32(heads + h * 4));
        store32(heads + h * 4, r + 1);
        r = r - 1;
    }
    store64(x + 152, load64(x + 152) | bit);
    return 1;
}

# Offset just past the delimiter on the first line at or after `from`
# whose content is exactly `dptr[0..dlen)` (after leading tabs when
# `ind` is 1, one trailing CR ignored), or -1. Uses the scan's line
# index (built on first use); see the note above `_ds_hdi_pool`.
fn _ds_hd_find_term(src, src_len, from, dptr, dlen, ind) {
    var x = _ds_hdi_get();
    if (x == 0) { return _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind); }
    if ((load64(x) != _ds_cur_gen) || (load64(x + 8) != src)) {
        if (_ds_hdi_build(x, src, src_len) == 0) {
            store64(x, 0);
            return _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind);
        }
        store64(x, _ds_cur_gen);
        store64(x + 8, src);
    }
    if (_ds_hdi_half(x, src, ind) == 0) {
        return _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind);
    }
    var b = load64(x + 32);
    var h = _ds_hdi_hash(dptr, 0, dlen) & (b - 1);
    var heads = load64(x + 96);
    var curs = load64(x + 112);
    var nxt = load64(x + 80);
    if (ind == 1) {
        heads = load64(x + 104);
        curs = load64(x + 120);
        nxt = load64(x + 88);
    }
    var lsa = load64(x + 56);
    var k = load32(curs + h * 4);
    if ((k == 0) || (from < load64(x + 48))) { k = load32(heads + h * 4); }
    if (from > load64(x + 48)) { store64(x + 48, from); }
    while ((k != 0) && (load32(lsa + (k - 1) * 4) < from)) { k = load32(nxt + (k - 1) * 4); }
    if (from >= load64(x + 48)) { store32(curs + h * 4, k); }
    var found = (0 - 1);
    while ((k != 0) && (found < 0)) {
        var cs = load32(lsa + (k - 1) * 4);
        if (ind == 1) { cs = load32(load64(x + 72) + (k - 1) * 4); }
        var ce = _ds_hdi_ce(src, x, k - 1, cs);
        if ((ce - cs == dlen) && (memeq(src + cs, dptr, dlen) == 1)) { found = cs + dlen; }
        if (found < 0) { k = load32(nxt + (k - 1) * 4); }
    }
    return found;
}

# Arithmetic `((` … `))` state for the opener check — inside it `<<`
# is always a shift, never a heredoc. Through 2.6.1 `_ds_hd_in_arith`
# re-counted `((` against `))` from the line start at every `<<`: O(line)
# per opener (a 100 KB line of `x<<y` took 10 s), it counted parens
# inside quotes (`sed 's/((a)/' <<EOF` lost its heredoc), and once a
# streaming drain had committed the `((` it scanned only to the buffer
# start, so `$(( 1 << n ))` became a heredoc at some splits (2.6.x
# audit). `tokenize_with_grammar` now keeps the count as it pushes
# operator / punctuation tokens — greedy adjacent-pair matching as
# before, strings and comments skipped, reset at every line break —
# and passes the verdict in. At the end of a depth-1 scan it reports a
# hold from the outermost still-open `((` (see `_ds_hd_hold_from`), so
# a drain never commits into one: the next buffer always starts with
# the `((` in view, or at a point where none is open.

# One-entry cache for the line break after a delimiter: every opener on
# one line ends at the same LF, and re-scanning to it per opener was the
# other O(line)-per-opener cost.
var _ds_hd_lf_gen = 0;
var _ds_hd_lf_src = 0;
var _ds_hd_lf_from = 0;
var _ds_hd_lf_at = 0;

fn _ds_hd_lf_after(src, src_len, from) {
    if ((_ds_hd_lf_gen == _ds_cur_gen) && (_ds_hd_lf_src == src)) {
        if ((from >= _ds_hd_lf_from) && (from <= _ds_hd_lf_at)) { return _ds_hd_lf_at; }
    }
    var lf = _ds_scan_to_lf(src, src_len, from);
    _ds_hd_lf_gen = _ds_cur_gen;
    _ds_hd_lf_src = src;
    _ds_hd_lf_from = from;
    _ds_hd_lf_at = lf;
    return lf;
}

# At src[i]: if a heredoc rule's opener starts here (and is not the
# start of a longer run of its last byte — `<<<` is a here-string),
# parse the delimiter and, when its terminator line exists, queue it.
# Returns the new queue length. Consumes nothing: the `<<` is tokenized
# by the operator step exactly as before 2.6.0.
fn _ds_heredoc_open(g, src, src_len, i, hdq, hd_n, in_arith) {
    var rules = grammar_heredoc_rules(g);
    var n = vec_len(rules);
    var res = hd_n;
    var r_i = 0;
    var decided = 0;
    while ((r_i < n) && (decided == 0)) {
        var r = vec_get(rules, r_i);
        var st = heredoc_rule_start(r);
        var sl = strlen(st);
        var opens = 0;
        # `undecided`: the buffer ends before the opener can be judged —
        # `<<` at the very end, blanks up to the end, a quoted delimiter
        # whose closing quote has not arrived. A streaming drain must not
        # commit past it: the next feed may make it a heredoc, and once
        # the `<<` is committed the body would be re-scanned as code.
        var undecided = 0;
        var fast_ok = 0;
        var f_dpos = 0;
        var f_dptr = 0;
        var f_dlen = 0;
        var f_ind = 0;
        var f_body = 0;
        if ((i + sl <= src_len) && (memeq(src + i, st, sl) == 1)) {
            if (i + sl == src_len) { undecided = 1; }
            if (i + sl < src_len) {
                if (load8(src + i + sl) != load8(st + sl - 1)) { opens = 1; }
            }
        }
        if ((opens == 1) || (undecided == 1)) {
            if (in_arith == 1) {
                opens = 0;
                undecided = 0;
                decided = 1;
            }
        }
        if (opens == 1) {
            decided = 1;
            var p = i + sl;
            var ind = 0;
            var im = heredoc_rule_indent(r);
            if ((im != 0) && (load8(src + p) == load8(im))) { ind = 1; p = p + 1; }
            while ((p < src_len) && ((load8(src + p) == 32) || (load8(src + p) == 9))) { p = p + 1; }
            if (p >= src_len) { undecided = 1; }
            var ds = (0 - 1);
            var dl = 0;
            var dend = 0;
            var dptr = 0;
            var dcontig = 0;
            if (p < src_len) {
                var dslot = _ds_hd_dscratch();
                if (dslot != 0) {
                    var qslot = res;
                    if (qslot > DS_HEREDOC_QUEUE) { qslot = DS_HEREDOC_QUEUE; }
                    var dst = _ds_hd_parse_delim(src, src_len, p, dslot + qslot * 256);
                    if (dst == 1) { undecided = 1; }
                    if (dst != 2) {
                        dptr = _ds_hdd_ptr;
                        dl = _ds_hdd_len;
                        dend = _ds_hdd_end;
                        ds = 0;
                        if (_ds_hdd_pos >= 0) {
                            ds = _ds_hdd_pos;
                            dcontig = 1;
                        }
                    }
                }
            }
            if (ds >= 0) {
                var lf = _ds_hd_lf_after(src, src_len, dend);
                var term = (0 - 1);
                if (lf < src_len) {
                    term = _ds_hd_find_term(src, src_len, lf + 1, dptr, dl, ind);
                }
                # Resolved = terminator line present AND its line break
                # seen; only then can a streaming drain commit past `<<`.
                var complete = 0;
                if ((term >= 0) && (term < src_len)) {
                    var tb0 = load8(src + term);
                    if (tb0 == 10) { complete = 1; }
                    if ((tb0 == 13) && (term + 1 < src_len)) {
                        if (load8(src + term + 1) == 10) { complete = 1; }
                    }
                }
                if ((term >= 0) && (res < DS_HEREDOC_QUEUE) && (hdq != 0)) {
                    var e = hdq + res * 40;
                    store64(e,      dptr);
                    store64(e + 8,  dl);
                    store64(e + 16, ind);
                    store64(e + 24, heredoc_rule_kind(r));
                    store64(e + 32, i);
                    res = res + 1;
                }
                if (complete == 0) {
                    undecided = 1;
                    if ((term < 0) && (lf < src_len)) {
                        fast_ok = 1;
                        f_dpos = ds;
                        if (dcontig == 0) { f_dpos = (0 - 1); }
                        f_dptr = dptr;
                        f_dlen = dl;
                        f_ind = ind;
                        f_body = lf + 1;
                    }
                }
            }
        }
        if ((undecided == 1) && (_ds_depth == 1)) {
            decided = 1;
            # Heredocs opened on one line take their bodies in order, so
            # they hold as a unit: from the line's FIRST queued opener.
            # Holding from this one alone let `cat <<'Q' <<-T` commit
            # `<<'Q'`, and the next drain read Q's body as T's.
            var hfrom = i;
            if ((res > 0) && (hdq != 0)) {
                var q0pos = load64(hdq + 32);
                if (q0pos < hfrom) { hfrom = q0pos; }
            }
            if ((_ds_hd_hold_from < 0) || (hfrom < _ds_hd_hold_from)) {
                _ds_hd_hold_from = hfrom;
                _ds_hd_hold_fast = fast_ok;
                _ds_hd_hold_dpos = f_dpos;
                _ds_hd_hold_dptr = f_dptr;
                _ds_hd_hold_dlen = f_dlen;
                _ds_hd_hold_ind = f_ind;
                _ds_hd_hold_body = f_body;
            }
        }
        r_i = r_i + 1;
    }
    return res;
}

# ── Entry point ─────────────────────────────

# Set by the streaming drain (src/tokenize.cyr) when the buffer it is
# about to scan does NOT start at stream offset 0. Read and cleared on
# entry, so it covers this one call — not compose bodies tokenized
# recursively inside it. A shebang is a property of a file's first
# line; after the rolling buffer compacts, the buffer's offset 0 is
# just wherever the last commit stopped, and a `#!...` comment line
# landing there came back TK_PREPROCESSOR where a single feed gives
# TK_COMMENT (python / shell / ruby; 2.5.2 audit P2-6).
var _ds_not_file_start = 0;

# Also set by the drain for a mid-stream buffer: the byte just before
# `src[0]` (its last committed byte), for `start_after` boundaries
# (ADR 0022), and the one before that, for `number_tuple_index` (2.9.3).
# -1 means there is none. One-shot, like the flag above, so compose
# bodies tokenized inside see their own start.
var _ds_buf_prev = (0 - 1);
var _ds_buf_prev2 = (0 - 1);

fn tokenize_with_grammar(g, src, src_len, tb) {
    var not_file_start = _ds_not_file_start;
    _ds_not_file_start = 0;
    var prev0 = _ds_buf_prev;
    _ds_buf_prev = (0 - 1);
    var prev1 = _ds_buf_prev2;
    _ds_buf_prev2 = (0 - 1);
    var grp_on = _ds_grp_collect;
    _ds_grp_collect = 0;
    _ds_gen_counter = _ds_gen_counter + 1;
    var saved_gen = _ds_cur_gen;
    _ds_cur_gen = _ds_gen_counter;
    _ds_depth = _ds_depth + 1;
    if (_ds_depth == 1) {
        _ds_grp_active = grp_on;
        _ds_grp_n = 0;
    }
    var hd_rules = vec_len(grammar_heredoc_rules(g));
    var hdq = 0;
    # First byte of the (single, in practice) heredoc start marker, so the
    # per-token opener check is one compare; -1 = several rules, always
    # check.
    var hd_b0 = (0 - 1);
    if (hd_rules > 0) {
        hdq = _ds_hd_queue();
        if (hd_rules == 1) { hd_b0 = load8(heredoc_rule_start(vec_get(grammar_heredoc_rules(g), 0))); }
    }
    var hd_n = 0;
    # Arithmetic state for the opener check (grammars with heredoc rules
    # only): open `((` on this line, the offset of the outermost, and the
    # last unpaired paren byte (`ar_pend`, at `ar_pend_at`) so `(` `(`
    # split over two tokens still pairs.
    var ar_depth = 0;
    var ar_open = (0 - 1);
    var ar_pend = 0;
    var ar_pend_at = (0 - 2);
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var kind = TK_ERROR;
        var len  = 0;

        # H. Queued here-document bodies (ADR 0023) start right after the
        # first top-level line break following their opener. Each body,
        # with its terminator line, is one token; a whitespace token for
        # the line break between consecutive bodies.
        if ((hd_n > 0) && (i > 0) && (load8(src + i - 1) == 10)) {
            var cur = i;
            var qi = 0;
            var hd_stop = 0;
            # Not every queued body may be emittable from this buffer: the
            # opener's own check searched from ITS line's end, but bodies
            # run in order from here — after a string spanning lines, after
            # an earlier body. Then (and when a terminator's line break has
            # not arrived) the group is unresolved and the drain must hold
            # from the line's first opener, or it commits the opener line
            # and the next drain reads the body as code (2.6.x audit P2-1).
            var h_hold = 0;
            var h_fast = 0;
            var h_dpos = 0;
            var h_dptr = 0;
            var h_dlen = 0;
            var h_ind = 0;
            var h_body = 0;
            while ((qi < hd_n) && (hd_stop == 0)) {
                var e = hdq + qi * 40;
                var te = _ds_hd_find_term(src, src_len, cur, load64(e), load64(e + 8), load64(e + 16));
                if (te < 0) {
                    hd_stop = 1;
                    h_hold = 1;
                    if (te == (0 - 1)) {
                        h_fast = 1;
                        h_dpos = load64(e) - src;
                        if (_ds_hd_in_src(e, src, src_len) == 0) { h_dpos = (0 - 1); }
                        h_dptr = load64(e);
                        h_dlen = load64(e + 8);
                        h_ind = load64(e + 16);
                        h_body = cur;
                    }
                }
                if (te >= 0) {
                    # An empty `<<''` body ends at once (its terminator is
                    # the empty line): no token — a zero-length one broke
                    # the coverage contract (2.9.1 audit, reviewer B, F6).
                    if (te > cur) { tokenbuf_push(tb, load64(e + 24), cur, te - cur); }
                    var tdone = 0;
                    if (te < src_len) {
                        if (load8(src + te) == 10) { tdone = 1; }
                        if ((load8(src + te) == 13) && (te + 1 < src_len)) {
                            if (load8(src + te + 1) == 10) { tdone = 1; }
                        }
                    }
                    if (tdone == 0) {
                        h_hold = 1;
                        h_fast = 1;
                        h_dpos = load64(e) - src;
                        if (_ds_hd_in_src(e, src, src_len) == 0) { h_dpos = (0 - 1); }
                        h_dptr = load64(e);
                        h_dlen = load64(e + 8);
                        h_ind = load64(e + 16);
                        h_body = cur;
                    }
                    cur = te;
                    if (qi + 1 < hd_n) {
                        var lf2 = _ds_scan_to_lf(src, src_len, cur);
                        if (lf2 >= src_len) {
                            hd_stop = 1;
                            if (h_hold == 0) { h_hold = 1; }
                        }
                        if (lf2 < src_len) {
                            tokenbuf_push(tb, TK_WHITESPACE, cur, lf2 + 1 - cur);
                            cur = lf2 + 1;
                        }
                    }
                    qi = qi + 1;
                }
            }
            if (_ds_depth == 1) {
                var g_from = load64(hdq + 32);
                if (h_hold == 1) {
                    if ((_ds_hd_hold_from < 0) || (g_from < _ds_hd_hold_from)) {
                        _ds_hd_hold_from = g_from;
                        _ds_hd_hold_fast = h_fast;
                        _ds_hd_hold_dpos = h_dpos;
                        _ds_hd_hold_dptr = h_dptr;
                        _ds_hd_hold_dlen = h_dlen;
                        _ds_hd_hold_ind = h_ind;
                        _ds_hd_hold_body = h_body;
                    }
                }
                if (h_hold == 0) { _ds_grp_add(g_from, cur); }
            }
            hd_n = 0;
            ar_depth = 0;
            ar_open = (0 - 1);
            ar_pend = 0;
            i = cur;
            continue;
        }

        # 0. Compose rules (ADR 0013). Push their own tokens
        # (start marker + recursively-tokenized body + end
        # marker) and advance the cursor by the matched length.
        # Runs before any other step because compose markers
        # like `<style>` would otherwise be eaten by the outer
        # grammar's normal `<` op + `style` ident + `>` op
        # tokenization.
        var clen = _ds_try_compose_rules(g, src, src_len, i, tb);
        if (clen > 0) {
            i = i + clen;
            continue;
        }

        # 0b. Compose-fenced rules (ADR 0016). Same shape but the
        # inner grammar is captured per-fence from the bytes
        # between the start marker and the next LF (the
        # CommonMark "info string"). Markdown's ` ```rust ` →
        # rust grammar; ` ```python ` → python.
        var cflen = _ds_try_compose_fenced_rules(g, src, src_len, i, tb);
        if (cflen > 0) {
            i = i + cflen;
            continue;
        }

        # 0c. Compose-region rules (ADR 0019). Open-ended regions:
        # the body runs to a lookahead terminator (left unconsumed)
        # or to EOF. CYML's `---` opens a markdown body that ends
        # before the next TOML header, or at end of input.
        var crlen = _ds_try_compose_region_rules(g, src, src_len, i, tb);
        if (crlen > 0) {
            i = i + crlen;
            continue;
        }

        # 1. Shebang — only where the buffer starts the file.
        if ((len == 0) && (not_file_start == 0)) {
            len = _ds_try_shebang(g, src, src_len, i);
            if (len > 0) { kind = TK_PREPROCESSOR; }
        }

        # 2. Line rules
        if (len == 0) {
            var packed = _ds_try_line_rules(g, src, src_len, i, prev0);
            if (packed != 0) {
                kind = packed >> 56;
                len  = packed & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 3. Pair rules
        if (len == 0) {
            var packed2 = _ds_try_pair_rules(g, src, src_len, i);
            if (packed2 != 0) {
                kind = packed2 >> 56;
                len  = packed2 & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 4. Special var `$X`
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                if (i + 1 < src_len) {
                    if (_ds_is_special_var_char(load8(src + i + 1)) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 5. Lone `$` as operator (only if special_vars is on; otherwise
        # `$` will be caught by the operators list or fall through).
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 6. Identifier / keyword. With `unicode_ident = true`, any
        # byte ≥0x80 also enters the ident scan (see ADR 0009).
        if (len == 0) {
            var start_tbl = grammar_ident_start(g);
            var ident_ok = 0;
            if ((start_tbl != 0) && (char_class_match(start_tbl, b) == 1)) {
                ident_ok = 1;
            }
            if ((ident_ok == 0) && (grammar_unicode_ident(g) == 1) && (b >= 128)) {
                ident_ok = 1;
            }
            # `ident_lead` (ADR 0027): css's `-` starts `-webkit-x` and
            # `--var`, but alone (`100% - 10px`) or before a digit
            # (`-2px`) it is the operator.
            var lead_tbl = grammar_ident_lead(g);
            if ((ident_ok == 1) && (lead_tbl != 0)) {
                if (char_class_match(lead_tbl, b) == 1) {
                    if (_ds_ident_lead_ok(g, src, src_len, i) == 0) { ident_ok = 0; }
                }
            }
            if (ident_ok == 1) {
                len = _ds_scan_ident(g, src, src_len, i);
                var pre_len = _ds_prefixed_string(g, src, src_len, i, len);
                if (pre_len > 0) {
                    kind = TK_STRING;
                    len = pre_len;
                }
                if (pre_len == 0) {
                    var kw_kind = _ds_lookup_keyword(g, src, i, len);
                    if (kw_kind >= 0) {
                        kind = kw_kind;
                    } else {
                        kind = TK_IDENT;
                    }
                }
            }
        }

        # 7. Number
        if (len == 0) {
            if (_ds_is_digit(b) == 1) {
                var nlen = _ds_scan_number(g, src, src_len, i, prev0, prev1);
                if (nlen > 0) {
                    kind = TK_NUMBER;
                    len = nlen;
                }
            }
        }

        # 7b. Char literal. Runs only when `[defaults] char_literal
        # = true`; before the operator step so the leading `'`
        # doesn't fall through to a 1-char operator. Rust-style
        # lifetimes (no closing quote at the right offset) still
        # tokenize as `'` + ident via steps 8 + 6 on subsequent
        # cursor positions. See ADR 0010.
        if (len == 0) {
            var clen = _ds_try_char_literal(g, src, src_len, i);
            if (clen > 0) {
                kind = TK_STRING;
                len = clen;
            }
        }

        # 7c. Here-document opener (ADR 0023): queue the body, consume
        # nothing — the `<<` is still the operator step's token.
        if ((len == 0) && (hd_rules > 0)) {
            if ((hd_b0 < 0) || (b == hd_b0)) {
                var in_ar = 0;
                if (ar_depth > 0) { in_ar = 1; }
                hd_n = _ds_heredoc_open(g, src, src_len, i, hdq, hd_n, in_ar);
            }
        }

        # 8. Operator (first match in a longest-first list: a test holds
        #    every grammar to that order, 2.5.2)
        if (len == 0) {
            var olen = _ds_try_exact_list(grammar_operators(g), src, src_len, i);
            if (olen > 0) {
                kind = TK_OPERATOR;
                len = olen;
            }
        }

        # 9. Punctuation (first match, the same order)
        if (len == 0) {
            var plen = _ds_try_exact_list(grammar_punctuation(g), src, src_len, i);
            if (plen > 0) {
                kind = TK_PUNCTUATION;
                len = plen;
            }
        }

        # 10. Whitespace
        if (len == 0) {
            if ((grammar_whitespace_on(g) == 1) && (_ds_is_space(b) == 1)) {
                kind = TK_WHITESPACE;
                len = _ds_scan_whitespace(src, src_len, i);
                # With a heredoc queued, the run stops after its first LF —
                # the body begins on the very next byte (ADR 0023).
                if (hd_n > 0) {
                    var wl = 0;
                    var wdone = 0;
                    while ((wl < len) && (wdone == 0)) {
                        if (load8(src + i + wl) == 10) { wdone = 1; }
                        wl = wl + 1;
                    }
                    if (wdone == 1) { len = wl; }
                }
            }
        }

        # 11. Fallback — keep coverage invariant by advancing 1 byte.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        # Arithmetic state (see `_ds_hd_lf_after`'s header). Parens only
        # ever sit in operator / punctuation tokens; a line break in any
        # token ends the line.
        if (hd_rules > 0) {
            if ((kind == TK_OPERATOR) || (kind == TK_PUNCTUATION)) {
                var ak = 0;
                while (ak < len) {
                    var ab = load8(src + i + ak);
                    var ap = i + ak;
                    var apaired = 0;
                    if ((ab == 40) || (ab == 41)) {
                        if ((ar_pend == ab) && (ar_pend_at == ap - 1)) {
                            apaired = 1;
                            if (ab == 40) {
                                if (ar_depth == 0) { ar_open = ap - 1; }
                                ar_depth = ar_depth + 1;
                            }
                            if (ab == 41) {
                                if (ar_depth > 0) { ar_depth = ar_depth - 1; }
                                if (ar_depth == 0) { ar_open = (0 - 1); }
                            }
                            ar_pend = 0;
                        }
                        if (apaired == 0) {
                            ar_pend = ab;
                            ar_pend_at = ap;
                        }
                    }
                    if ((ab != 40) && (ab != 41)) { ar_pend = 0; }
                    ak = ak + 1;
                }
            }
            if ((kind != TK_OPERATOR) && (kind != TK_PUNCTUATION)) {
                ar_pend = 0;
                if ((ar_depth > 0) && (_ds_index_byte(src, i, i + len, 10) >= 0)) {
                    ar_depth = 0;
                    ar_open = (0 - 1);
                }
            }
        }
        i = i + len;
    }
    # Bodies still queued at the end: the line break that starts them
    # never came (`cat <<EOF "a` with the string still open). Same as an
    # unemittable group in the H step — hold from the line's first opener.
    # When what keeps the line open is a string still running at the end,
    # the drain waits for that string's close marker (`_ds_hd_hold_fast`
    # = 3) rather than re-scanning at every line break inside it (2.8.0).
    if ((hd_n > 0) && (_ds_depth == 1) && (hdq != 0)) {
        var q_from = load64(hdq + 32);
        if ((_ds_hd_hold_from < 0) || (q_from < _ds_hd_hold_from)) {
            _ds_hd_hold_from = q_from;
            _ds_hd_hold_fast = 0;
            var qn = tokenbuf_count(tb);
            if (qn > 0) {
                if ((tokenbuf_start(tb, qn - 1) + tokenbuf_len(tb, qn - 1) == src_len) &&
                  (_ds_pair_eof_gen == _ds_cur_gen) && (_ds_pair_eof_end != 0)) {
                    _ds_hd_hold_fast = 3;
                    _ds_hd_hold_marker = _ds_pair_eof_end;
                    _ds_hd_hold_esc = _ds_pair_eof_esc;
                }
            }
        }
    }
    # The buffer ends inside an arithmetic `((` opened on its last line:
    # hold from it, so the next drain still sees the `((` (2.6.x audit P1-2).
    if ((hd_rules > 0) && (_ds_depth == 1) && (ar_depth > 0) && (ar_open >= 0)) {
        if ((_ds_hd_hold_from < 0) || (ar_open < _ds_hd_hold_from)) {
            _ds_hd_hold_from = ar_open;
            _ds_hd_hold_fast = 0;
        }
    }
    if (_ds_depth == 1) { _ds_grp_active = 0; }
    _ds_depth = _ds_depth - 1;
    _ds_cur_gen = saved_gen;
    return tokenbuf_count(tb);
}

# Offset of the first byte == `b` in src[from..to), or -1.
fn _ds_index_byte(src, from, to, b) {
    var p = from;
    while (p < to) {
        if (load8(src + p) == b) { return p; }
        p = p + 1;
    }
    return (0 - 1);
}

# --- shell.cyr ---

# vyakarana — shell grammar (M1, hand-coded)
#
# Tokenizes bash/sh scripts end-to-end. Zero `error` tokens on the
# vidya shell sample is the pass bar (tests/corpus/shell.sh).
#
# Dispatch table (first match wins, all advance `i` by the token's len):
#   1. `#!` on column 0 of line 0       → preprocessor (shebang)
#   2. `#` at the start of a word        → comment to end of line
#      (input start, or right after space / tab / LF / CR / `;` `&`
#      `|` `(` `)` `<` `>` — 2.6.0, mirroring shell.cyml's
#      `start_after`, ADR 0022). A `#` elsewhere (`${#v}`, `${x#p}`,
#      `a#b`) falls through to step 10 as a 1-byte operator.
#   3. `"..."` (backslash escape aware)  → string
#   4. `'...'` (no escapes)              → string
#   5. `$X` where X is #?@!*$- or 0-9     → operator, length 2
#      (shell special variable refs; prevents `$#` starting a comment;
#      digits since 2.6.0)
#   6. `$`                               → operator, length 1
#   7. identifier start [A-Za-z_]        → keyword-lookup, else ident
#   8. digit                             → number (decimal, hex, bin, oct)
#   9a. `<<<`                            → operator
#   9b. 2-char operators                 → operator
#   9c. 2-char punctuation [[ ]] (( )) ;; → punctuation
#  10. single-char operators, `#`, and `\X` escapes outside quotes
#      (`\\` `\"` `\'` `` \` `` `\$` `\#` `\ ` as one 2-byte operator, 2.6.0)
#  11. single-char punctuation ( ) { } [ ] ; : , .
#  12. whitespace run                    → single whitespace token
#  13. anything else                     → error token, length 1
#
# (Numbered to match the step comments in `tokenize_shell`; through
# 2.6.1 this table said 9 / 10 / 11 for steps the code numbers 9a–9c /
# 10 / 11, and sent `#` to the wrong one.)
#
# Inside strings, expansions (`${...}`, `$(...)`) are NOT re-tokenized —
# the entire quoted run is one `string` token. This keeps M1 simple and
# matches the convention most terminal highlighters follow; M2's CYML
# loader can add nested-rule support if a grammar calls for it.

# ── Byte-category predicates ────────────────

fn is_space(b) {
    if (b == 32) { return 1; }  # space
    if (b == 9)  { return 1; }  # tab
    if (b == 10) { return 1; }  # newline
    if (b == 13) { return 1; }  # CR
    return 0;
}

fn is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn is_hex_digit(b) {
    if (is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }  # a-f
    if ((b >= 65) && (b <= 70))  { return 1; }  # A-F
    return 0;
}

fn is_bin_digit(b) {
    if (b == 48) { return 1; }  # 0
    if (b == 49) { return 1; }  # 1
    return 0;
}

fn is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }   # 0-7
    return 1;
}

fn is_alpha(b) {
    if ((b >= 97) && (b <= 122)) { return 1; }  # a-z
    if ((b >= 65) && (b <= 90))  { return 1; }  # A-Z
    return 0;
}

fn is_ident_start(b) {
    if (is_alpha(b) == 1) { return 1; }
    if (b == 95) { return 1; }  # _
    return 0;
}

fn is_ident_cont(b) {
    if (is_ident_start(b) == 1) { return 1; }
    if (is_digit(b) == 1) { return 1; }
    return 0;
}

# Shell special-variable char: `$X` where X is one of these emits as a
# 2-char operator, so the `$#` sequence doesn't start a comment.
fn is_shell_special_var(b) {
    if ((b >= 48) && (b <= 57)) { return 1; }  # 0-9 (2.6.0)
    if (b == 35) { return 1; }  # #
    if (b == 63) { return 1; }  # ?
    if (b == 64) { return 1; }  # @
    if (b == 33) { return 1; }  # !
    if (b == 42) { return 1; }  # *
    if (b == 36) { return 1; }  # $
    if (b == 45) { return 1; }  # -
    return 0;
}

# ── Keyword lookup ──────────────────────────
# Length-keyed if-ladder. The keyword set follows design-spec §3
# and ADR 0004 — core reserved words only; builtins like
# `local`/`declare` are left as `ident` so theme authors can style
# them distinctly via token-text rules.

fn is_shell_keyword(src, start, len) {
    if (len == 2) {
        if (memeq(src + start, "if", 2) == 1) { return 1; }
        if (memeq(src + start, "fi", 2) == 1) { return 1; }
        if (memeq(src + start, "do", 2) == 1) { return 1; }
        if (memeq(src + start, "in", 2) == 1) { return 1; }
        return 0;
    }
    if (len == 3) {
        if (memeq(src + start, "for", 3) == 1) { return 1; }
        return 0;
    }
    if (len == 4) {
        if (memeq(src + start, "then", 4) == 1) { return 1; }
        if (memeq(src + start, "else", 4) == 1) { return 1; }
        if (memeq(src + start, "elif", 4) == 1) { return 1; }
        if (memeq(src + start, "done", 4) == 1) { return 1; }
        if (memeq(src + start, "case", 4) == 1) { return 1; }
        if (memeq(src + start, "esac", 4) == 1) { return 1; }
        if (memeq(src + start, "time", 4) == 1) { return 1; }
        return 0;
    }
    if (len == 5) {
        if (memeq(src + start, "while", 5) == 1) { return 1; }
        if (memeq(src + start, "until", 5) == 1) { return 1; }
        if (memeq(src + start, "break", 5) == 1) { return 1; }
        return 0;
    }
    if (len == 6) {
        if (memeq(src + start, "return", 6) == 1) { return 1; }
        if (memeq(src + start, "select", 6) == 1) { return 1; }
        return 0;
    }
    if (len == 8) {
        if (memeq(src + start, "function", 8) == 1) { return 1; }
        if (memeq(src + start, "continue", 8) == 1) { return 1; }
        return 0;
    }
    return 0;
}

# ── Scanners (each returns the token length in bytes) ───────────────
# All scanners guarantee len >= 1 so the main loop always advances.

# Scan from current `#` (or `#!`) to end-of-line, NOT including the
# newline. The newline is picked up on the next iteration as whitespace.
fn _scan_to_eol(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Double-quoted string: opening `"` at i; find closing `"` honoring
# backslash escapes. Unterminated → consume to EOF (a design-spec
# coverage-invariant safety net; the vidya sample won't hit this).
fn _scan_string_double(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        if (b == 92) {                # backslash → skip next char
            j = j + 2;
        } else {
            if (b == 34) { return j - i + 1; }   # closing "
            j = j + 1;
        }
    }
    return src_len - i;
}

# Single-quoted string: no escapes; closing `'` ends it.
fn _scan_string_single(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        if (load8(src + j) == 39) { return j - i + 1; }
        j = j + 1;
    }
    return src_len - i;
}

# Identifier run (caller has already confirmed is_ident_start at i).
fn _scan_ident(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        if (is_ident_cont(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Number: decimal, or 0x.../0b.../0o... prefix. Caller confirmed
# is_digit(src[i]). Does NOT handle floats — the shell corpus is
# integers only, and bash itself doesn't have float arithmetic in
# the language proper.
fn _scan_number(src, src_len, i) {
    # Check for prefix
    if (load8(src + i) == 48) {                  # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((p == 120) || (p == 88)) {       # 0x / 0X
                var j = i + 2;
                while (j < src_len) {
                    if (is_hex_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((p == 98) || (p == 66)) {        # 0b / 0B
                var j = i + 2;
                while (j < src_len) {
                    if (is_bin_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((p == 111) || (p == 79)) {       # 0o / 0O
                var j = i + 2;
                while (j < src_len) {
                    if (is_oct_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
        }
    }
    var j = i + 1;
    while (j < src_len) {
        if (is_digit(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Whitespace run.
fn _scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Peek two-byte sequence match; safe past src_len.
fn _peek2_eq(src, src_len, i, c0, c1) {
    if (i + 1 >= src_len) { return 0; }
    if (load8(src + i) != c0) { return 0; }
    if (load8(src + i + 1) != c1) { return 0; }
    return 1;
}

# Peek three-byte sequence match.
fn _peek3_eq(src, src_len, i, c0, c1, c2) {
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != c0) { return 0; }
    if (load8(src + i + 1) != c1) { return 0; }
    if (load8(src + i + 2) != c2) { return 0; }
    return 1;
}

# Bytes after which a `#` starts a comment: bash's metacharacters plus
# CR. Same set as shell.cyml's comment-rule `start_after` (2.6.0).
fn _sh_word_break(b) {
    if ((b == 32) || (b == 9) || (b == 10) || (b == 13)) { return 1; }
    if ((b == 59) || (b == 38) || (b == 124)) { return 1; }   # ; & |
    if ((b == 40) || (b == 41)) { return 1; }                 # ( )
    if ((b == 60) || (b == 62)) { return 1; }                 # < >
    return 0;
}

# Bytes a backslash escapes into one 2-byte operator outside quotes:
# `\\` `\"` `\'` `` \` `` `\$` `\#` `\ ` (2.6.0, as shell.cyml).
fn _sh_escapable(b) {
    if ((b == 92) || (b == 34) || (b == 39) || (b == 96)) { return 1; }
    if ((b == 36) || (b == 35) || (b == 32)) { return 1; }
    return 0;
}

# ── Entry point ─────────────────────────────
#
# `src`      — source bytes (pointer; caller owns the buffer)
# `src_len`  — byte length
# `tb`       — tokenbuf to push into (created by caller via tokenbuf_new)
#
# Returns the number of tokens pushed.
#
# Coverage invariant: every byte of [0, src_len) is covered by exactly
# one token. The main loop never advances zero bytes.
fn tokenize_shell(src, src_len, tb) {
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var len = 0;
        var kind = TK_ERROR;

        # 1. Shebang on line 0, column 0
        if (i == 0) {
            if (_peek2_eq(src, src_len, 0, 35, 33) == 1) {   # #!
                kind = TK_PREPROCESSOR;
                len = _scan_to_eol(src, src_len, i);
            }
        }

        # 2. Comment (# to EOL) — only at the start of a word.
        if (len == 0) {
            if (b == 35) {    # #
                if ((i == 0) || (_sh_word_break(load8(src + i - 1)) == 1)) {
                    kind = TK_COMMENT;
                    len = _scan_to_eol(src, src_len, i);
                }
            }
        }

        # 3. Double-quoted string
        if (len == 0) {
            if (b == 34) {    # "
                kind = TK_STRING;
                len = _scan_string_double(src, src_len, i);
            }
        }

        # 4. Single-quoted string
        if (len == 0) {
            if (b == 39) {    # '
                kind = TK_STRING;
                len = _scan_string_single(src, src_len, i);
            }
        }

        # 5. `$X` for shell special-variable X
        if (len == 0) {
            if (b == 36) {    # $
                if (i + 1 < src_len) {
                    var nxt = load8(src + i + 1);
                    if (is_shell_special_var(nxt) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 6. Lone `$`
        if (len == 0) {
            if (b == 36) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 7. Identifier / keyword
        if (len == 0) {
            if (is_ident_start(b) == 1) {
                len = _scan_ident(src, src_len, i);
                if (is_shell_keyword(src, i, len) == 1) {
                    kind = TK_KEYWORD;
                } else {
                    kind = TK_IDENT;
                }
            }
        }

        # 8. Number
        if (len == 0) {
            if (is_digit(b) == 1) {
                kind = TK_NUMBER;
                len = _scan_number(src, src_len, i);
            }
        }

        # 9a. 3-char operator: <<<
        if (len == 0) {
            if (_peek3_eq(src, src_len, i, 60, 60, 60) == 1) {
                kind = TK_OPERATOR;
                len = 3;
            }
        }

        # 9b. 2-char operators
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 38, 38) == 1) { kind = TK_OPERATOR; len = 2; }  # &&
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 124, 124) == 1) { kind = TK_OPERATOR; len = 2; }  # ||
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 61, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # ==
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 33, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # !=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 61, 126) == 1) { kind = TK_OPERATOR; len = 2; }  # =~
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # <=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 62, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # >=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 62, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # >>
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 60) == 1) { kind = TK_OPERATOR; len = 2; }  # <<
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # <>
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 43, 43) == 1) { kind = TK_OPERATOR; len = 2; }  # ++
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 45) == 1) { kind = TK_OPERATOR; len = 2; }  # --
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 43, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # +=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # -=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 42, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # *=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 47, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # /=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 37, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # %=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # ->
        }

        # 9c. 2-char punctuation
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 91, 91) == 1) { kind = TK_PUNCTUATION; len = 2; }  # [[
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 93, 93) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ]]
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 40, 40) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ((
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 41, 41) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ))
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 59, 59) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ;;
        }

        # 10. Single-char operators
        if (len == 0) {
            if (b == 61) { kind = TK_OPERATOR; len = 1; }   # =
        }
        if (len == 0) {
            if (b == 124) { kind = TK_OPERATOR; len = 1; }  # |
        }
        if (len == 0) {
            if (b == 38) { kind = TK_OPERATOR; len = 1; }   # &
        }
        if (len == 0) {
            if (b == 60) { kind = TK_OPERATOR; len = 1; }   # <
        }
        if (len == 0) {
            if (b == 62) { kind = TK_OPERATOR; len = 1; }   # >
        }
        if (len == 0) {
            if (b == 43) { kind = TK_OPERATOR; len = 1; }   # +
        }
        if (len == 0) {
            if (b == 45) { kind = TK_OPERATOR; len = 1; }   # -
        }
        if (len == 0) {
            if (b == 42) { kind = TK_OPERATOR; len = 1; }   # *
        }
        if (len == 0) {
            if (b == 47) { kind = TK_OPERATOR; len = 1; }   # /
        }
        if (len == 0) {
            if (b == 37) { kind = TK_OPERATOR; len = 1; }   # %
        }
        if (len == 0) {
            if (b == 33) { kind = TK_OPERATOR; len = 1; }   # !
        }
        if (len == 0) {
            if (b == 126) { kind = TK_OPERATOR; len = 1; }  # ~
        }
        if (len == 0) {
            if (b == 63) { kind = TK_OPERATOR; len = 1; }   # ?
        }
        if (len == 0) {
            if (b == 64) { kind = TK_OPERATOR; len = 1; }   # @
        }
        if (len == 0) {
            if (b == 94) { kind = TK_OPERATOR; len = 1; }   # ^
        }
        if (len == 0) {
            if (b == 92) {                                    # \
                kind = TK_OPERATOR;
                len = 1;
                if (i + 1 < src_len) {
                    if (_sh_escapable(load8(src + i + 1)) == 1) { len = 2; }
                }
            }
        }
        if (len == 0) {
            if (b == 35) { kind = TK_OPERATOR; len = 1; }   # # mid-word (2.6.0)
        }

        # 11. Single-char punctuation
        if (len == 0) {
            if (b == 40) { kind = TK_PUNCTUATION; len = 1; }   # (
        }
        if (len == 0) {
            if (b == 41) { kind = TK_PUNCTUATION; len = 1; }   # )
        }
        if (len == 0) {
            if (b == 123) { kind = TK_PUNCTUATION; len = 1; }  # {
        }
        if (len == 0) {
            if (b == 125) { kind = TK_PUNCTUATION; len = 1; }  # }
        }
        if (len == 0) {
            if (b == 91) { kind = TK_PUNCTUATION; len = 1; }   # [
        }
        if (len == 0) {
            if (b == 93) { kind = TK_PUNCTUATION; len = 1; }   # ]
        }
        if (len == 0) {
            if (b == 59) { kind = TK_PUNCTUATION; len = 1; }   # ;
        }
        if (len == 0) {
            if (b == 58) { kind = TK_PUNCTUATION; len = 1; }   # :
        }
        if (len == 0) {
            if (b == 44) { kind = TK_PUNCTUATION; len = 1; }   # ,
        }
        if (len == 0) {
            if (b == 46) { kind = TK_PUNCTUATION; len = 1; }   # .
        }

        # 12. Whitespace
        if (len == 0) {
            if (is_space(b) == 1) {
                kind = TK_WHITESPACE;
                len = _scan_whitespace(src, src_len, i);
            }
        }

        # 13. Fallback — unrecognized byte. Emit error of length 1 so
        # the coverage invariant still holds.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        i = i + len;
    }
    return tokenbuf_count(tb);
}

# --- tokenize.cyr ---

# vyakarana — public tokenizer entry (streaming, 2.0+)
#
# 2.0.0 broke the 1.x `tokenize_source(src, lang)` synchronous
# entry. The new contract is push-based: the consumer creates a
# stream tied to a grammar, feeds chunks of bytes, and drains
# tokens as they're available.
#
# 2.0.1 implementation: rolling-buffer streaming via the
# rescan-and-commit pattern. Each drain re-runs the existing
# scanner over the current buffer, commits every token whose
# extent is fully present (those whose end < buf_len plus any
# trailing pair-rule token whose close marker is at its tail),
# and compacts the buffer by sliding unconsumed bytes to offset
# 0. abs_offset tracks how many bytes have already been
# committed so token starts emit absolute. finish() lifts the
# "drop trailing partial" rule and commits everything to EOF.
#
# Cost: O(buf_len) scan per drain. For many small chunks that's
# O(N²) total work over an N-byte stream — accept for 2.0.1's
# minimal-state-machine implementation. The watches since (2.0.3's
# pending pair, 2.6.0's heredoc watch, 2.8.0's run and compose
# watches — ADR 0028) skip that re-scan while the buffer's tail is
# still waiting; a resumable scanner was considered there and
# rejected.
#
# The pull adapter (`tokenize_stream_next` + the `_kind` / `_start`
# / `_len` accessors) shipped in 2.0.2 and lives at the bottom of
# this file; `tokenize_stream_discard_consumed` joined it in 2.1.4.
#
# Stream layout (heap-allocated; opaque to callers):
#
#    0  buf_ptr     ptr to growable byte buffer
#    8  buf_len     i64 — bytes written so far (relative to buf_ptr[0])
#   16  buf_cap     i64 — current allocation size
#   24  grammar     ptr to grammar record (looked up at _new)
#   32  finished    i64  (0 / 1) — set by tokenize_stream_finish
#   40  cursor      i64 — buffer-relative position of next byte to scan
#                          (always 0 in 2.0.1 because compaction follows
#                          every commit, but kept distinct for clarity)
#   48  abs_offset  i64 — absolute offset of buf_ptr[0] in the original
#                          stream. Increments by `consumed` after each
#                          drain compaction. Tokens emit with
#                          start = abs_offset + relative_start.
#   56  staging_tb  ptr — internal tokenbuf used by the pull adapter
#                          (`tokenize_stream_next`). Drains land here
#                          when the consumer iterates instead of
#                          providing an out_tb to drain/finish.
#   64  next_idx    i64 — pull-adapter cursor: index of the *current*
#                          staging token + 1 (i.e., the next one to
#                          return). After advance(), use _kind / _start
#                          / _len to read the just-advanced-to token.
#   72  pending_idx i64 — index of the open pair rule whose close we're
#                          waiting for. `-1` when no pending pair. After
#                          a drain detects a trailing partial pair, this
#                          is set; subsequent drains skip directly to
#                          the close-marker scan instead of re-running
#                          the full scanner over the open-pair body.
#                          See 2.0.3 §Pending pair-rule tracking.
#   80  scan_resume i64 — buffer offset to resume close-marker scanning
#                          from. Advances each drain so we never re-
#                          scan body bytes already known not to contain
#                          the close marker — drops O(N²) → O(N) for
#                          big-partial cases.
#   88  scratch_tb  ptr — the drain's scan tokenbuf, reused (2.5.2)
#   96  last_byte   i64 — last committed byte, -1 = none; the
#                          `start_after` boundary at the buffer start
#                          (ADR 0022, 2.6.0)
#  104  watch_mode  i64 — heredoc hold watch (ADR 0023): 0 off,
#                          1 terminator search, 2 next line break
#                          (2.6.0; mode 2 in 2.6.2)
#  112  watch_dpos  i64 —   mode 1: delimiter offset in buf
#  120  watch_dlen  i64 —   mode 1: delimiter length
#  128  watch_ind   i64 —   mode 1: tab-stripped (`<<-`) terminator
#  136  watch_from  i64 —   where the next search resumes in buf
#  144  hold_start  i64 —   the held region's start in buf, for the
#                          VYK_HEREDOC_HOLD_MAX bound (2.6.2)
#  152  run_class   i64 — run watch (2.8.0): 0 off, else the class of
#                          the long token at the buffer's tail
#                          (`_stream_run_cont`)
#  160  run_from    i64 —   where the run watch resumes in buf
#  168  pend_raw    i64 — 1 when the pending pair string has a raw prefix
#                          (`r"…"`, ADR 0027): its close scan ignores
#                          escapes (2.8.0)
#  176  watch_scan  i64 —   mode 1: how far the line at +136 has been
#                          searched for its LF (2.8.0)
#  184  hold_max    i64 —   the held region's bound: VYK_HEREDOC_HOLD_MAX
#                          or VYK_COMPOSE_HOLD_MAX (2.8.0; modes 3 / 4
#                          and +112 as a marker cstr are compose holds)
#  192  watch_dcopy ptr —   mode 1: a copy of a delimiter quote removal
#                          rewrote, when +112 is -1 (2.9.1)
#  200  watch_lead  i64 —   mode 3: where the marker counts — 0 anywhere,
#                          1 at a line start, else a cstr of the bytes
#                          allowed before it on its line (2.9.1)
#  208  watch_esc   i64 —   mode 3: escape byte; an escaped marker is no
#                          close (2.9.1)
#  216  last_byte2  i64 — the committed byte before last_byte, -1 = none;
#                          `number_tuple_index` looks two bytes back
#                          (ADR 0026, 2.9.3)
#   -----
#  224 bytes total (STREAM_REC_SIZE). This table stopped at offset 80
#  — "88 bytes total" — from 2.5.2 until the 2.6.x audit.
#
# Bundled into `dist/vyakarana.cyr`. Public symbols — this list is
# what CLAUDE.md's frozen-API rule points at, so keep it accurate:
#
#   push API      tokenize_stream_new
#                 tokenize_stream_feed
#                 tokenize_stream_drain
#                 tokenize_stream_finish
#                 tokenize_stream_free
#   pull adapter  tokenize_stream_next        (2.0.2)
#                 tokenize_stream_kind
#                 tokenize_stream_start
#                 tokenize_stream_len
#                 tokenize_stream_discard_consumed  (2.1.4)
#   registry      has_grammar
#                 list_languages_into
#                 bootstrap_grammars
#
# Removed in 2.0.0 (no compat shim):
#   tokenize_source
#
# NOT public, but still present: `tokenize_source_handcoded` — the
# `vyk --handcoded` regression oracle. It is defined at the bottom
# of this file and ships in the bundle, so listing it as "removed"
# (as this header did through 2.3.4) was simply wrong; consumer DCE
# builds strip it.
#
# See `docs/adr/0017-streaming-api.md` for the design rationale
# and the migration recipe for 1.x consumers.

# Initial buffer allocation; grows as needed.
var VYK_STREAM_INIT_CAP = 4096;
# Hard upper bound on the *live* (unconsumed) buffer at any one
# point. 2.0.1's rolling buffer compacts after every drain, so
# the cap effectively bounds the longest in-progress span (block
# comment, multi-line string, fence body) rather than the total
# input size. Total input can exceed this freely. One byte of the cap
# is the NUL terminator the drain writes, so the largest live window
# — and the largest single feed into an empty stream — is
# `VYK_STREAM_CAP - 1` bytes (a feed of exactly the cap returns
# VYK_ERR_OVERFLOW; 2.5.2 audit, documentation only).
var VYK_STREAM_CAP = 16777216;

# Hard ceiling on a stream's TOTAL input, distinct from the live-
# window cap above. `Token.start` / `Token.len` are u32 (ADR 0002's
# 12-byte layout), but `abs_offset` is an i64 that accumulates over
# every byte ever fed. Past 2^32 the `store32` in `tokenbuf_push`
# wraps silently: a token at absolute offset 4294967301 reads back
# as 5, so a consumer indexing `src[start .. start+len)` gets
# unrelated bytes and the coverage invariant stops holding with no
# error anywhere.
#
# FINDING-005 (2026-04-23 audit) rated this LOW as "theoretical",
# correctly — back then the only entry point was `tokenize_source`,
# bounded by VYK_SRC_CAP at 1 MiB. 2.0.0 replaced it with this
# streaming API, whose own header advertises "Total input can
# exceed this freely", and the LOW rating was never revisited.
# Widening Token is a layout change (ADR + minor bump), so 2.3.4
# does the patch-safe half: refuse the input rather than corrupt
# the output. See CHANGELOG 2.3.4.
var VYK_OFFSET_CAP = 4294967295;

# Largest region a single unresolved compose opener may pin.
#
# While a compose opener is held with no end marker in the buffer,
# the drain commits nothing and the rolling buffer cannot compact —
# the live window degenerates from "longest in-progress span" to
# "everything since the opener". Two consequences, both measured in
# the 2.3.4 audit: cost grows superlinearly, and VYK_STREAM_CAP
# turns into a TOTAL-INPUT ceiling, so an unterminated `<style>`
# eventually makes every `tokenize_stream_feed` return
# VYK_ERR_OVERFLOW forever. That directly contradicts this file's
# own "Total input can exceed this freely".
#
# Holding is semantically required — `_ds_try_compose_rules` refuses
# to half-consume a compose rule whose end marker has not arrived,
# so a `<style>` body cannot route to the css grammar until
# `</style>` does. So bound it instead of removing it: past this
# many bytes, stop holding and commit the bytes as that drain's scan
# read them — with the OUTER grammar for a `compose` or
# `compose_fenced` opener whose end has not arrived; a still-running
# `compose_region` is read with its inner grammar to the buffer's
# end. Coverage and the zero-error bar still hold; what is lost is
# agreement with a single feed from there on. (This said "give up on
# compose routing … with the OUTER grammar" for every rule type until
# 2.9.1.)
#
# 8 MiB is deliberately generous: every real embedded stylesheet or
# fenced block is orders of magnitude smaller, so this only fires on
# input that is malformed or adversarial — exactly the case that
# used to wedge the stream permanently.
var VYK_COMPOSE_HOLD_MAX = 8388608;

# Bound on how far a streaming drain holds back commits behind an
# unresolved here-document group (ADR 0023) — from its line's first
# `<<WORD` to the buffer's end, while a terminator line has not
# arrived. Past it the bytes commit as ordinary code, so only a group
# longer than this, split across feeds, can tokenize differently from
# a single feed. (Measured from the group's first opener, not from the
# body still open: `cat <<A <<B` with a 1.0 MB body for A and 120 KB
# for B trips it — this comment said "a heredoc body" until 2.9.1.) Enforced on both the
# full-scan path and the watch (through 2.6.1 the watch skipped it, and
# an armed hold grew to VYK_STREAM_CAP, after which every feed failed).
# Smaller than the compose bound because a mode-2 watch still re-scans
# the held bytes at each new line break.
var VYK_HEREDOC_HOLD_MAX = 1048576;

# Layout in the table at the top of this file.
var STREAM_REC_SIZE = 224;

# Error codes returned by tokenize_stream_feed.
var VYK_OK            = 0;
var VYK_ERR_OVERFLOW  = (0 - 1);   # cap exceeded
var VYK_ERR_FINISHED  = (0 - 2);   # feed after finish

var _grammars_bootstrapped = 0;

# Load every bundled grammar on first use. Idempotent.
fn bootstrap_grammars() {
    if (_grammars_bootstrapped == 1) { return 0; }
    _grammars_bootstrapped = 1;
    var gs = grammar_load("grammars/shell.cyml");
    if (gs != 0) { registry_add(gs); }
    var gt = grammar_load("grammars/toml.cyml");
    if (gt != 0) { registry_add(gt); }
    var gj = grammar_load("grammars/json.cyml");
    if (gj != 0) { registry_add(gj); }
    var gc = grammar_load("grammars/cyrius.cyml");
    if (gc != 0) { registry_add(gc); }
    var gr = grammar_load("grammars/rust.cyml");
    if (gr != 0) { registry_add(gr); }
    var gy = grammar_load("grammars/yaml.cyml");
    if (gy != 0) { registry_add(gy); }
    var gm = grammar_load("grammars/markdown.cyml");
    if (gm != 0) { registry_add(gm); }
    var gcc = grammar_load("grammars/c.cyml");
    if (gcc != 0) { registry_add(gcc); }
    var gts = grammar_load("grammars/typescript.cyml");
    if (gts != 0) { registry_add(gts); }
    var gjs = grammar_load("grammars/javascript.cyml");
    if (gjs != 0) { registry_add(gjs); }
    var gpy = grammar_load("grammars/python.cyml");
    if (gpy != 0) { registry_add(gpy); }
    var ggo = grammar_load("grammars/go.cyml");
    if (ggo != 0) { registry_add(ggo); }
    var gzig = grammar_load("grammars/zig.cyml");
    if (gzig != 0) { registry_add(gzig); }
    var gasm86 = grammar_load("grammars/asm_x86_64.cyml");
    if (gasm86 != 0) { registry_add(gasm86); }
    var gasmarm = grammar_load("grammars/asm_aarch64.cyml");
    if (gasmarm != 0) { registry_add(gasmarm); }
    var gjava = grammar_load("grammars/java.cyml");
    if (gjava != 0) { registry_add(gjava); }
    var gkt = grammar_load("grammars/kotlin.cyml");
    if (gkt != 0) { registry_add(gkt); }
    var gcpp = grammar_load("grammars/cpp.cyml");
    if (gcpp != 0) { registry_add(gcpp); }
    var gcs = grammar_load("grammars/csharp.cyml");
    if (gcs != 0) { registry_add(gcs); }
    var gphp = grammar_load("grammars/php.cyml");
    if (gphp != 0) { registry_add(gphp); }
    var grb = grammar_load("grammars/ruby.cyml");
    if (grb != 0) { registry_add(grb); }
    var glua = grammar_load("grammars/lua.cyml");
    if (glua != 0) { registry_add(glua); }
    var gswift = grammar_load("grammars/swift.cyml");
    if (gswift != 0) { registry_add(gswift); }
    var gex = grammar_load("grammars/elixir.cyml");
    if (gex != 0) { registry_add(gex); }
    var gml = grammar_load("grammars/ocaml.cyml");
    if (gml != 0) { registry_add(gml); }
    var ghs = grammar_load("grammars/haskell.cyml");
    if (ghs != 0) { registry_add(ghs); }
    var gsql = grammar_load("grammars/sql.cyml");
    if (gsql != 0) { registry_add(gsql); }
    var ggql = grammar_load("grammars/graphql.cyml");
    if (ggql != 0) { registry_add(ggql); }
    var gpb = grammar_load("grammars/protobuf.cyml");
    if (gpb != 0) { registry_add(gpb); }
    var ghtml = grammar_load("grammars/html.cyml");
    if (ghtml != 0) { registry_add(ghtml); }
    var gxml = grammar_load("grammars/xml.cyml");
    if (gxml != 0) { registry_add(gxml); }
    var gcss = grammar_load("grammars/css.cyml");
    if (gcss != 0) { registry_add(gcss); }
    var gscss = grammar_load("grammars/scss.cyml");
    if (gscss != 0) { registry_add(gscss); }
    var gdf = grammar_load("grammars/dockerfile.cyml");
    if (gdf != 0) { registry_add(gdf); }
    var gmk = grammar_load("grammars/makefile.cyml");
    if (gmk != 0) { registry_add(gmk); }
    var gini = grammar_load("grammars/ini.cyml");
    if (gini != 0) { registry_add(gini); }
    var gcyml = grammar_load("grammars/cyml.cyml");
    if (gcyml != 0) { registry_add(gcyml); }
    var gll = grammar_load("grammars/llvm_ir.cyml");
    if (gll != 0) { registry_add(gll); }
    var gps = grammar_load("grammars/powershell.cyml");
    if (gps != 0) { registry_add(gps); }
    var gcr = grammar_load("grammars/crystal.cyml");
    if (gcr != 0) { registry_add(gcr); }
