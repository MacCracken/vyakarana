# --- token.cyr ---

# vyakarana — token kind palette + Token record
#
# The ten-kind palette is a stable contract. Grammar authors and theme
# palettes both depend on the set; do not add a kind without a design
# review and a CHANGELOG entry.
#
# Token layout (kind: u8, start: u32, len: u32 — 12 bytes) is
# load-bearing for downstream consumers (owl M3b). Pre-1.0 changes
# must be CHANGELOG-flagged.

# ── Token kinds ─────────────────────────────
var TK_IDENT        = 0;
var TK_KEYWORD      = 1;
var TK_STRING       = 2;
var TK_NUMBER       = 3;
var TK_COMMENT      = 4;
var TK_OPERATOR     = 5;
var TK_PUNCTUATION  = 6;
var TK_WHITESPACE   = 7;
var TK_PREPROCESSOR = 8;
var TK_ERROR        = 9;

var TK_COUNT = 10;

# Kind → name. Parallel to the TK_* constants.
# M2+ grammars reference these names; M0 just exposes them via vyk.
fn kind_name(kind) {
    if (kind == TK_IDENT)        { return "ident"; }
    if (kind == TK_KEYWORD)      { return "keyword"; }
    if (kind == TK_STRING)       { return "string"; }
    if (kind == TK_NUMBER)       { return "number"; }
    if (kind == TK_COMMENT)      { return "comment"; }
    if (kind == TK_OPERATOR)     { return "operator"; }
    if (kind == TK_PUNCTUATION)  { return "punctuation"; }
    if (kind == TK_WHITESPACE)   { return "whitespace"; }
    if (kind == TK_PREPROCESSOR) { return "preprocessor"; }
    if (kind == TK_ERROR)        { return "error"; }
    return "<invalid>";
}

# Coverage check helper — exported in `[lib] modules` so downstream
# consumers can validate `kind` values they receive from
# `tokenize_source`.
fn kind_is_valid(kind) {
    if (kind < 0) { return 0; }
    if (kind >= TK_COUNT) { return 0; }
    return 1;
}

# ── Token record ────────────────────────────
#
# Layout: (kind: u8 @ 0, start: u32 @ 4, len: u32 @ 8) — 12 bytes.
# Bytes 1..3 are padding so start is 4-byte aligned.
# See design-spec §4. This layout is the consumer contract for owl M3b
# and subsequent consumers; do not shuffle fields without a CHANGELOG
# entry and a minor-version bump.
var TOKEN_SIZE = 12;

# ── tokenbuf — contiguous growable array of 12-byte Token records ───
#
# Design-spec §6 requires "no allocations per token." Stdlib Vec stores
# 8-byte slots, which doesn't fit the 12-byte Token layout, so this is
# a purpose-built buffer: three i64 fields (data_ptr, count, byte_cap)
# at the handle, 12 bytes per record in `data`.
#
# Accessors (tokenbuf_kind/start/len) are the shape owl M3b imports.
# Keep the surface stable — the internal growth policy can evolve.

var _TB_INIT_CAP = 64;   # initial record capacity (768 bytes)

fn tokenbuf_new() {
    var tb = alloc(24);
    var bytes = _TB_INIT_CAP * TOKEN_SIZE;
    var data = alloc(bytes);
    store64(tb, data);
    store64(tb + 8, 0);        # count
    store64(tb + 16, bytes);   # byte_cap
    return tb;
}

fn tokenbuf_count(tb) {
    return load64(tb + 8);
}

fn _tokenbuf_grow(tb) {
    var old_data = load64(tb);
    var old_bytes = load64(tb + 16);
    var new_bytes = old_bytes * 2;
    var new_data = alloc(new_bytes);
    var i = 0;
    while (i < old_bytes) {
        store8(new_data + i, load8(old_data + i));
        i = i + 1;
    }
    store64(tb, new_data);
    store64(tb + 16, new_bytes);
    return 0;
}

fn tokenbuf_push(tb, kind, start, len) {
    var count = load64(tb + 8);
    var byte_cap = load64(tb + 16);
    var used = count * TOKEN_SIZE;
    if (used >= byte_cap) {
        _tokenbuf_grow(tb);
    }
    var data = load64(tb);
    var slot = data + count * TOKEN_SIZE;
    store8(slot, kind);
    store32(slot + 4, start);
    store32(slot + 8, len);
    store64(tb + 8, count + 1);
    return 0;
}

# Accessors by index (bounds-unchecked — caller must compare to
# tokenbuf_count). Kept small so the hot path stays inline-friendly
# for the streaming-tokenizer work scheduled for 2.0.0 (see
# `docs/development/roadmap.md`).
fn _tokenbuf_slot(tb, i) {
    var data = load64(tb);
    return data + i * TOKEN_SIZE;
}

fn tokenbuf_kind(tb, i) {
    return load8(_tokenbuf_slot(tb, i));
}

fn tokenbuf_start(tb, i) {
    return load32(_tokenbuf_slot(tb, i) + 4);
}

fn tokenbuf_len(tb, i) {
    return load32(_tokenbuf_slot(tb, i) + 8);
}

# --- grammar_blobs.cyr ---

# vyakarana — embedded grammar blobs (auto-generated)
#
# AUTO-GENERATED by scripts/embed-grammars.sh — do not edit.
# Regenerate after editing any grammars/*.cyml file.
# Gitignored; produced fresh on each build / distlib step.
#
# Source: 38 grammars in grammars/*.cyml.
# Used by src/grammar.cyr's grammar_load() — checks blob lookup first,
# falls back to file_read_all() if no blob matches the path. Lets
# dist/vyakarana.cyr be a single self-contained bundle (cyrius deps
# vendors only the bundle file, not the grammars/ dir).
#
# Uses streq() from lib/string.cyr — auto-included via cyrius.cyml's
# [deps] stdlib (`string`).

fn _grammar_blob_asm_aarch64() {
    return "# asm_aarch64 — AArch64 (ARM 64-bit) assembly tokenizer grammar\n#\n# Rule scheme per ADR 0005. Same tokenizer shape as\n# `asm_x86_64.cyml` but tuned for ARM GAS conventions:\n#\n#   - Line comments are `//` (NOT `#` — `#` is the immediate-\n#     operand prefix in ARM, e.g. `mov w0, #5`).\n#   - Block comments `/* … */` follow the same shape as C.\n#   - `.` is in BOTH `ident_start` and `ident_cont` so that ARM\n#     conditional branches (`b.eq`, `b.ne`, `b.lt`, …) tokenize\n#     as a single `ident`. Same trick captures GAS directives\n#     (`.global`, `.section`) and local labels (`.is_digit_yes`).\n#     Bare `.` (current-address marker) still tokenizes as a\n#     length-1 ident — `_ds_scan_ident` returns 1 when the next\n#     byte is whitespace.\n#\n# Dispatch: `.s` and `.S` are shared with `asm_x86_64`; the\n# hardcoded `detect_language` in `src/main.cyr` defaults `.s`\n# to `asm_x86_64`. ARM users invoke `vyk --language=asm_aarch64\n# file.s`. A future content-based detection pass (1.13.0 in the\n# roadmap) could sniff `.arch`/`.cpu` directives or\n# ARM-specific register names and route automatically.\n#\n# Opcodes (`mov`, `bl`, `stp`, `ldp`, `ldrb`, `cmp`, `b.eq`,\n# `ret`, …) and registers (`x0`-`x30`, `w0`-`w30`, `sp`, `pc`,\n# `lr`, `xzr`, `wzr`, …) tokenize as `TK_IDENT`, NOT\n# `TK_KEYWORD`. ARM aarch64 has ~500 instructions plus SIMD/SVE\n# extensions — the keyword-list approach doesn't scale, and per\n# [ADR 0004](../docs/adr/0004-shell-builtins-as-ident.md) the\n# right place to colour opcodes-vs-other-idents is the theme\n# renderer's secondary palette.\n#\n# Known gaps (not triggered by the vidya sample):\n#   - Float literals (`1.5`). Asm rarely uses these inline; the\n#     `.float 1.5` directive form would tokenize as\n#     `keyword(.float)` + `number(1)` + `ident(.5)`. Same\n#     limitation as `asm_x86_64`.\n#   - `;` instruction-separator syntax (rare on ARM). Today\n#     tokenizes as punctuation.\n\n[grammar]\nname = \"asm_aarch64\"\nextensions = [\".s\", \".S\", \".asm\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `.` in both ident_start and ident_cont: captures `b.ne`,\n# `.global`, `.is_digit_yes`, and bare `.` uniformly.\nident_start = \"A-Za-z_.\"\nident_cont  = \"A-Za-z0-9_.\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\n\n# UTF-8 in `//` and `/* */` comment text → one ident instead of\n# per-byte errors. ADR 0009.\nunicode_ident = true\n\n# Char literals `'5'`, `'A'`, `'\\n'` (used as immediate operand\n# bodies after `#`). ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. ARM-specific: `#` immediate\n# prefix, `!` write-back addressing mode, plus standard\n# expression operators for symbol arithmetic.\noperators = [\n    \"==\", \"!=\",\n    \"<<\", \">>\",\n    \"<=\", \">=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"<\", \">\",\n    \"#\", \"!\",\n]\n\n# Punctuation. `{` `}` for register lists (LDM / STM / TBX),\n# `[` `]` for memory access, `:` for label terminator.\npunctuation = [\n    \"(\", \")\", \"[\", \"]\", \"{\", \"}\",\n    \";\", \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# ARM GAS line comments. Note `#` is the immediate prefix, not\n# a comment marker — handled as an operator above.\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. Non-nestable, simple greedy match —\n# same shape as the C grammar's rule introduced in ADR 0009.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # GAS section / linkage (shared with asm_x86_64)\n    \".section\", \".text\", \".data\", \".bss\", \".rodata\",\n    \".global\", \".globl\", \".local\", \".extern\", \".weak\",\n    # ARM-specific architecture / mode directives\n    \".arch\", \".cpu\", \".fpu\", \".arm\", \".thumb\", \".code\",\n    \".thumb_func\", \".req\", \".unreq\",\n    # Data emit (shared with asm_x86_64)\n    \".byte\", \".word\", \".short\", \".long\", \".int\", \".quad\",\n    \".ascii\", \".asciz\", \".string\", \".float\", \".double\",\n    \".skip\", \".zero\", \".fill\", \".space\",\n    # Alignment / layout\n    \".align\", \".balign\", \".p2align\", \".org\",\n    # Symbol manipulation\n    \".set\", \".equ\", \".equiv\", \".size\", \".type\",\n    # Conditional / macro\n    \".if\", \".ifdef\", \".ifndef\", \".else\", \".elseif\", \".endif\",\n    \".macro\", \".endm\", \".include\",\n    # Debug / DWARF\n    \".file\", \".loc\",\n    \".cfi_startproc\", \".cfi_endproc\", \".cfi_def_cfa\",\n    \".cfi_offset\", \".cfi_restore\",\n]\n";
}

fn _grammar_blob_asm_x86_64() {
    return "# asm_x86_64 — x86_64 assembly tokenizer grammar (GAS / AT&T-or-Intel)\n#\n# Rule scheme per ADR 0005. Asm is structurally simple at the token\n# level (line comments, identifiers, numbers, registers, char/string\n# literals) but visually dense — a tokenizer's job here is to give\n# theme renderers enough kinds to colour opcodes vs. registers vs.\n# directives vs. labels.\n#\n# Scope: covers what vidya's content/lexing_and_parsing/asm_x86_64.s\n# exercises (`.intel_syntax noprefix` declared, GAS line comments\n# `#`, char literals `'0'`/`'9'`/`'a'`/etc., decimal numbers, the\n# common `.section` / `.text` / `.global` / `.ascii` / `.skip`\n# directive set, opcodes and registers as plain idents).\n#\n# Directives as idents: `.` is in `ident_start` so `.intel_syntax`,\n# `.global`, `.is_digit_yes` (local label), and even bare `.`\n# (current-address marker) all tokenize as a single ident. The\n# `[[rules]] match = \"words\"` keyword list then promotes the\n# *known* directives to `TK_KEYWORD`; everything else (local\n# labels, anonymous markers) stays `TK_IDENT`. Same call as\n# [ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md) for\n# Rust `$` and Zig's `@`.\n#\n# Opcodes (`mov`, `call`, `jne`, `xor`, `syscall`, `ret`, `cmp`,\n# `lea`, `movzx`, …) tokenize as `TK_IDENT`, NOT `TK_KEYWORD`.\n# x86_64 has ~1000 instructions plus SSE/AVX/AVX-512 extensions —\n# the keyword list approach doesn't scale, and per\n# [ADR 0004](../docs/adr/0004-shell-builtins-as-ident.md) the\n# right place to colour opcodes-vs-other-idents is the theme\n# renderer's secondary palette (token-text rule), not the\n# tokenizer.\n#\n# Registers (`rax`, `rdi`, `eax`, `dil`, `r8`, `xmm0`, …) — same\n# story. `TK_IDENT`; theme handles the colouring.\n#\n# Known gaps (not triggered by the vidya sample):\n#   - Float literals (`1.5`). With `.` in ident_start, `1.5`\n#     tokenizes as `number(1)` + `ident(.5)`. Asm samples typically\n#     use `.float 1.5` directive form anyway; if a corpus emerges\n#     that needs raw `1.5`, the fix is grammar-specific.\n#   - AT&T-syntax operand sigils (`%rax`, `$0x10`). The canonical\n#     sample uses Intel syntax (`mov rax, 1`); AT&T-flavoured asm\n#     would need `%` and `$` either as `special_vars` or in\n#     ident_start. Punted to a future ADR if a real AT&T corpus\n#     surfaces.\n#   - `;` line comments (NASM/MASM convention). GAS uses `#`,\n#     which is what vidya's sample uses; if a NASM corpus shows\n#     up, switch the line-comment rule.\n\n[grammar]\nname = \"asm_x86_64\"\nextensions = [\".s\", \".S\", \".asm\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `.` in ident_start so `.text`, `.global`, `.is_digit_yes` (local\n# label), and bare `.` (current-address) all tokenize as ident.\nident_start = \"A-Za-z_.\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\n\n# UTF-8 in `#` comment text → one ident instead of per-byte\n# errors. Matches ADR 0009 pattern.\nunicode_ident = true\n\n# Char literals `'0'`, `'a'`, etc. — common in asm immediates and\n# operand fields. ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. Asm uses these mostly inside\n# expressions (`input_len = . - input`, `[rdi + 8]`,\n# `dword ptr [rdi + 16 + 8]`).\noperators = [\n    \"==\", \"!=\",\n    \"<<\", \">>\",\n    \"<=\", \">=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"<\", \">\",\n]\n\n# Punctuation, longest-match. `:` is the label terminator.\npunctuation = [\n    \"(\", \")\", \"[\", \"]\", \"{\", \"}\",\n    \";\", \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# GAS line comments. NASM-style `;` could be added in a fork.\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n# Known GAS directives. Promoted from ident → keyword via the\n# words-rule lookup. See header for why opcodes/registers are\n# deliberately NOT here.\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Section / linkage\n    \".section\", \".text\", \".data\", \".bss\", \".rodata\",\n    \".global\", \".globl\", \".local\", \".extern\", \".weak\",\n    # Syntax / format\n    \".intel_syntax\", \".att_syntax\",\n    \".code16\", \".code32\", \".code64\",\n    # Data emit\n    \".byte\", \".word\", \".short\", \".long\", \".int\", \".quad\",\n    \".ascii\", \".asciz\", \".string\", \".float\", \".double\",\n    \".skip\", \".zero\", \".fill\", \".space\",\n    # Alignment / layout\n    \".align\", \".balign\", \".p2align\", \".org\",\n    # Symbol manipulation\n    \".set\", \".equ\", \".equiv\", \".size\", \".type\",\n    # Conditional / macro\n    \".if\", \".ifdef\", \".ifndef\", \".else\", \".elseif\", \".endif\",\n    \".macro\", \".endm\", \".include\",\n    # Debug / DWARF\n    \".file\", \".loc\",\n    \".cfi_startproc\", \".cfi_endproc\", \".cfi_def_cfa\",\n    \".cfi_offset\", \".cfi_restore\",\n]\n";
}

fn _grammar_blob_c() {
    return "# c — C tokenizer grammar\n#\n# Rule scheme per ADR 0005. C is close to Rust at the token level:\n# `//` line comments, double-quoted strings, C-family operators, a\n# slightly-larger reserved-word set including type keywords.\n#\n# Corpus: tests/corpus/c.c (vidya-backed).\n#\n# Block comments `/* ... */` are recognised via a `match = \"pair\"`\n# rule below. C's block comments are non-nestable, so the simple\n# greedy match matches the spec. Triggered by `vidya/content/<topic>/c.c`\n# files that lead with a `/* Vidya — … */` header.\n#\n# Known gaps for future ADRs (not triggered by the vidya sample):\n#   - Char literals `'x'` split into three operator tokens. Same\n#     pattern as Rust; promoting to an ADR for a `char_literal`\n#     default with small lookahead is the likely fix.\n#   - Preprocessor directives (`#include`, `#define`, `#ifdef`) are\n#     tokenized as `#` op + keyword-or-ident + ... rather than a\n#     unified `preprocessor` kind. `<stdio.h>` becomes\n#     `<` + ident + `.` + ident + `>`. Coverage and no-error bars\n#     hold; a principled preprocessor mode is ADR-worthy later.\n\n[grammar]\nname = \"c\"\nextensions = [\".c\", \".h\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\n\n# UTF-8 in `/* … */` and `//` comment text → one ident instead of\n# per-byte errors. See ADR 0009.\nunicode_ident = true\n\n# `'C'` / `'\\C'` / `'\\xHH'` tokenize as a single TK_STRING\n# instead of fragmenting into op/body/op. See ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. C-specific: `->` (struct deref),\n# `++` / `--` (increment), compound assignment, `&&`/`||`,\n# comparison, bit shifts, `?` for ternary, `'` for char-lit (splits\n# into 3 tokens — see grammar header). `#` for preprocessor.\noperators = [\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"++\", \"--\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"->\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"'\", \"\\\\\",\n    \"#\",\n]\n\n# Punctuation, longest-match.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. C's block comments are non-nestable\n# (unlike Rust's), so the simple greedy match — close at the first\n# `*/` — matches the spec. No escape: `\\` inside a comment is just\n# a backslash byte, not an escape.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Control flow\n    \"if\", \"else\", \"while\", \"for\", \"do\", \"switch\", \"case\", \"default\",\n    \"break\", \"continue\", \"return\", \"goto\",\n    # Type-declaration\n    \"typedef\", \"struct\", \"union\", \"enum\",\n    # Storage-class / qualifiers\n    \"auto\", \"register\", \"static\", \"extern\", \"const\", \"volatile\",\n    \"inline\", \"restrict\",\n    # Primitive types\n    \"void\", \"char\", \"short\", \"int\", \"long\",\n    \"float\", \"double\", \"signed\", \"unsigned\",\n    \"_Bool\", \"_Complex\",\n    # Operator-like keywords\n    \"sizeof\",\n]\n";
}

fn _grammar_blob_cpp() {
    return "# cpp — C++ tokenizer grammar\n#\n# Rule scheme per ADR 0005. Close in shape to c.cyml plus C++-only\n# tokens (`::`, `->`, `<>` template brackets via standard\n# operators, `nullptr`, namespaces, lambdas, ranges). A C++ grammar\n# was the most likely 1.3.0 entry to surface scanner ADR work\n# (templates, generics, namespace `::`); in practice the existing\n# operator and identifier machinery handles all of it without new\n# scanner defaults — `<` and `>` already tokenize as operators\n# (greedy comparison shape; consumers parse the template-vs-shift\n# disambiguation), `::` is a 2-char operator, and `auto` /\n# `template` / `typename` are plain keywords.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a C++ reference sample yet. The local\n# `tests/corpus/concept.cpp` mirrors the lexer+parser theme used\n# elsewhere, exercising namespace declarations, `enum class`,\n# `std::unique_ptr`, lambdas, range-for, char literals (`'+'`,\n# `'\\0'`), block comments, raw string is NOT exercised.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Raw string literals `R\"delim(…)delim\"`. Not in the\n#     stand-in. C++11+; would need a custom rule shape since the\n#     delimiter is variable-length.\n#   - User-defined literal suffixes (`42_km`, `\"x\"sv`). The\n#     suffix tokenizes as ident after the number/string —\n#     cosmetic; coverage holds.\n#   - Numeric digit separators (`1'000'000` in C++14+). The\n#     apostrophe digit-separator looks like char-literal context;\n#     could be confused with `char_literal`. Not in the stand-in;\n#     if it appears in a real corpus, add a `digit_sep` flag.\n#   - Preprocessor directives (`#include`, `#define`, `#ifdef`):\n#     same shape as C. Tokenize as `#` op + ident; coverage holds.\n#   - Trigraphs / digraphs (`<:`, `:>`, `??=`): obsolete; no\n#     real-world C++ uses them.\n\n[grammar]\nname = \"cpp\"\nextensions = [\".cpp\", \".cc\", \".cxx\", \".hpp\", \".hh\", \".hxx\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. C++-specific: `::` (scope\n# resolution), `->*` and `.*` (member-pointer access), `<=>`\n# (three-way compare, C++20), `...` (parameter pack), `->`\n# (trailing return / lambda body), plus the standard C-family\n# set including compound assignment.\noperators = [\n    \"<<=\", \">>=\", \"<=>\",\n    \"->*\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"::\", \"->\", \".*\", \"...\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n    \"#\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. C++ inherits C's non-nestable shape.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Storage / linkage\n    \"auto\", \"register\", \"static\", \"extern\", \"thread_local\",\n    \"mutable\", \"constexpr\", \"consteval\", \"constinit\",\n    \"inline\", \"explicit\", \"friend\", \"virtual\",\n    # CV-qualifiers\n    \"const\", \"volatile\", \"restrict\",\n    # Type-declaration heads\n    \"class\", \"struct\", \"union\", \"enum\", \"namespace\",\n    \"typename\", \"template\", \"using\", \"typedef\",\n    \"concept\", \"requires\",\n    # Control flow\n    \"if\", \"else\", \"while\", \"do\", \"for\", \"switch\", \"case\",\n    \"default\", \"break\", \"continue\", \"return\", \"goto\",\n    # Exception handling\n    \"try\", \"catch\", \"throw\", \"noexcept\",\n    # Object / casts\n    \"new\", \"delete\", \"this\", \"operator\",\n    \"static_cast\", \"dynamic_cast\", \"const_cast\", \"reinterpret_cast\",\n    \"sizeof\", \"alignof\", \"alignas\", \"decltype\",\n    \"typeid\",\n    # Primitive types + void\n    \"void\", \"bool\", \"char\", \"wchar_t\", \"char8_t\", \"char16_t\",\n    \"char32_t\", \"short\", \"int\", \"long\", \"signed\", \"unsigned\",\n    \"float\", \"double\",\n    # Reserved literals\n    \"true\", \"false\", \"nullptr\",\n    # Co_-suite (C++20 coroutines)\n    \"co_await\", \"co_yield\", \"co_return\",\n    # Module syntax (C++20)\n    \"module\", \"import\", \"export\",\n    # Misc reserved\n    \"and\", \"or\", \"not\", \"xor\",\n    \"bitand\", \"bitor\", \"compl\", \"not_eq\",\n    \"and_eq\", \"or_eq\", \"xor_eq\",\n    \"static_assert\",\n]\n";
}

fn _grammar_blob_csharp() {
    return "# csharp — C# tokenizer grammar\n#\n# Rule scheme per ADR 0005. C-family at the token level — close\n# in shape to java.cyml + cpp.cyml.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a C# reference sample yet. The local\n# `tests/corpus/concept.cs` mirrors the lexer+parser theme used\n# elsewhere, exercising `record` types, switch expressions, file-\n# scoped namespaces, range indexers (`source[start.._pos]`),\n# string interpolation (`$\"...\"`) is NOT exercised yet, char\n# literals (`'+'`, `'\\0'`), and the C# keyword set. Replace with\n# a vidya snapshot when one ships.\n#\n# Attributes: `[Attribute]` syntax is ordinary punctuation `[` +\n# ident + `]`. No `@` prefix needed (C# uses `@` only for verbatim\n# strings `@\"...\"` and identifier escapes `@class`).\n#\n# Verbatim strings `@\"...\"` and interpolated strings `$\"...\"`:\n# both are NOT specially recognised by this grammar. `@` and `$`\n# are not in `ident_start`, so `@\"text\"` tokenizes as `@` op +\n# `\"text\"` string, and `$\"text\"` tokenizes as `$` op + `\"text\"`\n# string. Coverage holds. If a corpus needs unified tokens, add\n# pair rules with the prefix as part of the start string —\n# similar to TOML's [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md).\n# Adding `$` to operators below so it doesn't fall to the error\n# fallback.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Verbatim strings `@\"…\"` and raw strings `\"\"\"…\"\"\"` (C# 11+).\n#     `@` and `$` prefixes tokenize as separate operators;\n#     regular `\"…\"` rule absorbs the body. Cosmetic; coverage\n#     holds.\n#   - Numeric suffixes (`42L`, `1.5f`, `1_000_000`). Same shape\n#     as java.cyml — cosmetic; coverage holds.\n#   - Pattern-matching in switch expressions: `is`, `not`, `and`,\n#     `or` patterns. Tokenize as keywords; the structure is\n#     consumer-side parsing.\n\n[grammar]\nname = \"csharp\"\nextensions = [\".cs\", \".csx\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. C#-specific: `??=` /\n# `??` (null-coalesce assign / value), `?.` (null-conditional),\n# `=>` (lambda / expression body / switch arms), `..` (range),\n# plus the standard C-family set.\noperators = [\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"??=\", \"??\", \"?.\",\n    \"=>\", \"..\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n    \"@\", \"$\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. Non-nestable per the C# spec.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / namespace / using\n    \"namespace\", \"using\",\n    # Type-declaration heads\n    \"class\", \"struct\", \"interface\", \"enum\", \"record\",\n    \"delegate\",\n    # Modifiers / visibility\n    \"public\", \"private\", \"protected\", \"internal\",\n    \"static\", \"readonly\", \"const\", \"sealed\", \"partial\",\n    \"abstract\", \"virtual\", \"override\", \"extern\",\n    \"unsafe\", \"fixed\", \"volatile\", \"async\",\n    # Storage / declaration\n    \"var\", \"void\", \"ref\", \"out\", \"in\", \"params\",\n    # Control flow\n    \"if\", \"else\", \"while\", \"do\", \"for\", \"foreach\",\n    \"switch\", \"case\", \"default\",\n    \"break\", \"continue\", \"return\", \"yield\", \"goto\",\n    # Exceptions / disposal\n    \"try\", \"catch\", \"finally\", \"throw\",\n    # Object-oriented\n    \"new\", \"this\", \"base\", \"is\", \"as\",\n    \"operator\", \"implicit\", \"explicit\",\n    # Async / iterators\n    \"await\",\n    # Type system / reflection\n    \"typeof\", \"sizeof\", \"nameof\", \"checked\", \"unchecked\",\n    \"stackalloc\", \"lock\",\n    # Primitive types\n    \"bool\", \"byte\", \"sbyte\", \"short\", \"ushort\",\n    \"int\", \"uint\", \"long\", \"ulong\", \"float\", \"double\",\n    \"decimal\", \"string\", \"char\", \"object\", \"dynamic\",\n    \"nint\", \"nuint\",\n    # Reserved literals\n    \"true\", \"false\", \"null\",\n    # Pattern keywords (some are contextual, but lexically these\n    # appear in pattern position as recognised words)\n    \"when\", \"with\", \"where\", \"select\", \"from\", \"let\", \"into\",\n    \"join\", \"on\", \"equals\", \"by\", \"group\", \"orderby\",\n    \"ascending\", \"descending\",\n    # Misc reserved\n    \"global\",\n]\n";
}

fn _grammar_blob_css() {
    return "# css — CSS tokenizer grammar (CSS3+)\n#\n# Rule scheme per ADR 0005. CSS at the token level:\n#   - `/* … */` block comments only (CSS has no line-comment\n#     form; SCSS/Sass adds `//`).\n#   - `\"…\"` and `'…'` strings (string values, font names,\n#     attribute selectors).\n#   - `#` for id selectors and hex colors (`#ff6600`).\n#   - `.` for class selectors (`.title`).\n#   - `@` for at-rules (`@media`, `@import`, `@keyframes`).\n#   - `:` for pseudo-classes (`:hover`) and `::` for pseudo-\n#     elements (`::after`).\n#   - Numeric units (`16px`, `1.5rem`, `0.05em`) tokenize as\n#     `number` + `ident` — cosmetic; coverage holds.\n#   - Hyphenated property names (`text-underline-offset`,\n#     `padding-block`) — `-` in `ident_cont` so the whole name\n#     is one ident.\n#   - CSS custom properties `--color-bg`. Need `-` in\n#     `ident_start` AND `ident_cont` so `--color-bg` (which\n#     starts with `-`) tokenizes as one ident.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a CSS reference sample yet. The local\n# `tests/corpus/concept.css` exercises CSS3+: at-rules,\n# custom properties, nested `calc()`, media queries,\n# pseudo-classes and pseudo-elements, attribute selectors with\n# match operators, `@keyframes` blocks, grid/flex, and\n# logical properties. Replace with a vidya snapshot when one\n# ships.\n#\n# `@` and `#` in `ident_start` so at-rules (`@media`,\n# `@keyframes`, `@supports`, `@container`) tokenize as a\n# single ident, then promoted to keyword via the words rule.\n# Hex colors (`#ff6600`) and id selectors (`#hero`) also\n# become single idents — themes can secondary-palette by\n# token-text shape if they want different colours.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Float numbers (`1.5`, `0.25`). The number scanner stops\n#     at `.`; `1.5rem` becomes `number(1) + .(punct) +\n#     number(5) + ident(rem)`. Cosmetic; very common in CSS.\n#     Same gap as java.cyml. A future `number_float` default\n#     would close this across all C-family grammars.\n#   - URL functions `url(...)` body parsing. `url` is just an\n#     ident; the `(...)` body tokenizes as nested\n#     punctuation + string.\n\n[grammar]\nname = \"css\"\nextensions = [\".css\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for at-rules, `#` for id selectors / hex colors,\n# `-` for custom properties (`--color-bg`).\nident_start = \"A-Za-z_@#-\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. CSS-specific: `::` for\n# pseudo-elements (declared before `:` ... wait, `:` is\n# punctuation; `::` is in operators because it's a multi-byte\n# token), `>`/`+`/`~` for combinators, `^=` / `$=` / `*=` /\n# `~=` / `|=` for attribute matchers, `*` for universal\n# selector / multiply.\noperators = [\n    \"^=\", \"$=\", \"*=\", \"~=\", \"|=\",\n    \"::\",\n    \"+\", \"-\", \"*\", \"/\",\n    \"<\", \">\",\n    \"&\", \"|\", \"~\",\n    \"!\", \"?\",\n    \"=\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `/* … */` block comments. CSS has no line-comment form\n# (SCSS adds `//`; that's a separate grammar).\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n# At-rules tokenize as ident (because `@` is in `ident_start`),\n# then promoted to keyword via this words list. The set covers\n# the standard at-rule vocabulary.\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"@charset\",\n    \"@import\",\n    \"@namespace\",\n    \"@media\",\n    \"@supports\",\n    \"@document\",\n    \"@page\",\n    \"@font-face\",\n    \"@keyframes\",\n    \"@viewport\",\n    \"@counter-style\",\n    \"@font-feature-values\",\n    \"@property\",\n    \"@layer\",\n    \"@container\",\n    \"@scope\",\n    \"@starting-style\",\n    # Logical / conditional combinators\n    \"from\", \"to\",\n    # Common values that act keyword-y\n    \"important\", \"inherit\", \"initial\", \"unset\", \"revert\",\n]\n";
}

fn _grammar_blob_cyml() {
    return "# cyml — CYML tokenizer grammar (vyakarana's own format)\n#\n# Rule scheme per ADR 0005. CYML is the format vyakarana itself\n# uses for grammar files (`grammars/*.cyml`), yukti's config\n# (`yukti.cyml`), and vidya's content corpus\n# (`vidya/content/<topic>/*.cyml`). Self-hosting payoff: 1.9.0\n# is the first release where vyakarana can colour its own\n# grammar files with its own grammar.\n#\n# The format is a TOML-shaped header optionally followed by\n# `---`-delimited markdown bodies, repeating:\n#\n#   [package]                    | TOML header\n#   name = \"vyakarana\"           |\n#                                |\n#   [[entries]]                  |\n#   name = \"x\"                   |\n#   ---                          | 3-byte separator\n#   Free-form markdown text      | Body (between separators)\n#   with `inline code` and       |\n#   **bold** etc.                |\n#   ---                          |\n#   [[entries]]                  | Next header block...\n#\n# A proper grammar would route header bytes to TOML and body\n# bytes to Markdown via grammar composition (1.11.0). For 1.9.0\n# we tokenize both halves with a single rule set tuned for the\n# union: TOML's strings + section headers + assignments, plus\n# backtick inline code, `**`/`*`/`_` emphasis, and the `---`\n# separator. Coverage holds; downstream consumers that want\n# distinct colouring per half can switch by tracking which side\n# of the most recent `---` they're on.\n#\n# Stand-in corpus: NOT a stand-in! `tests/corpus/dependencies.cyml`\n# is a real vidya snapshot from\n# `vidya/content/cyrius/dependencies.cyml` (233 lines). First\n# bundled grammar where vidya already shipped a sample for the\n# language.\n#\n# Known gaps (not triggered by the corpus):\n#   - Multi-line TOML strings `\"\"\"…\"\"\"`. Not in the sample.\n#     If a real CYML uses them, add the same pair rule\n#     [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)\n#     introduced for TOML.\n#   - Markdown-style code fences ``` ``` ```. Tokenize as three\n#     ` operators; cosmetic.\n#   - Setext-heading underlines `===` (markdown-body level).\n#     The `---` separator would also match a setext underline,\n#     but the convention is that `---` lives between header\n#     and body, not within body markdown. If a real corpus\n#     surfaces a setext in body, the divider becomes ambiguous.\n\n[grammar]\nname = \"cyml\"\nextensions = [\".cyml\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Section / key names use letters / underscore; `-` and `.` in\n# `ident_cont` for things like `cfi-startproc`-style or\n# `auth.providers.github` nested keys (TOML allows them).\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_.-\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. CYML-specific: `---` (3-byte\n# separator between TOML header and markdown body), `**` (markdown\n# bold marker — body level), plus the standard TOML / markdown\n# punctuation surface.\noperators = [\n    \"---\",\n    \"**\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"<\", \">\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"!\", \"?\",\n    \"@\",\n]\n\n# Punctuation. `[[` and `[` need to come before `[` in the\n# longest-match order — they're matched in declaration order.\npunctuation = [\n    \"[[\", \"]]\",\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n# Markdown inline code: `…`. Backticks are common in CYML\n# bodies (referring to commands, file paths, identifiers).\n# Pair rule with no escape — backtick spans don't have\n# embedded escape handling.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"`\"\nend = \"`\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Literal values (TOML)\n    \"true\", \"false\", \"inf\", \"nan\",\n]\n";
}

fn _grammar_blob_cyrius() {
    return "# cyrius — Cyrius tokenizer grammar\n#\n# Rule scheme per ADR 0005. Cyrius is C-like syntactically: line\n# comments with `#`, double-quoted strings, C-family operators, and\n# a small reserved-word set. Corpus is the vidya reference sample.\n#\n# Scope: covers what vidya's `content/lexing_and_parsing/cyrius.cyr`\n# uses. Known future gaps (ADR candidates when they come up):\n#   - `#ifdef` / `#endif` preprocessor directives. The vidya sample\n#     doesn't have them; `lib/args.cyr` in the cyrius toolchain does.\n#     Today `#ifdef CYRIUS_TARGET_MACOS` tokenizes as one `comment`\n#     to EOL, which is lossy but keeps the coverage invariant.\n#   - Char / byte literals. Cyrius uses integer constants (`load8(p)\n#     == 35` rather than `== '#'`), so single quotes are comment-only\n#     in practice. No `'...'` pair rule — keeps the scanner from\n#     eating apostrophes that appear outside strings.\n#   - Type annotations (`x: i64`) tokenize as ident `:` ident with\n#     ident_cont covering `i64` — no special handling needed.\n\n[grammar]\nname = \"cyrius\"\nextensions = [\".cyr\", \".cyml\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Standard C-like identifier class.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\n# No shell-style $X variable expansion.\nspecial_vars = false\n\n# Operators in longest-match order.\noperators = [\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\", \"<\", \">\",\n]\n\n# Punctuation, longest-match.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"fn\", \"var\",\n    \"if\", \"else\",\n    \"while\", \"for\", \"break\", \"continue\",\n    \"return\",\n    \"include\",\n    \"enum\", \"struct\",\n    \"true\", \"false\",\n]\n";
}

fn _grammar_blob_dockerfile() {
    return "# dockerfile — Dockerfile tokenizer grammar\n#\n# Rule scheme per ADR 0005. Dockerfile is line-oriented with a\n# fixed instruction-head vocabulary (FROM, RUN, COPY, etc.).\n# Per spec, instruction heads are **case-insensitive** —\n# `FROM`, `from`, and `From` are all the same instruction.\n# This grammar uses [ADR 0011](../docs/adr/0011-case-insensitive-keywords-default.md)'s\n# `case_insensitive_keywords` flag (same as SQL since 1.6.0)\n# so the canonical UPPER list matches all case variants.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Dockerfile reference sample yet. The\n# local `tests/corpus/Dockerfile` is a multi-stage build with\n# the modern `# syntax=docker/dockerfile:1.7` directive,\n# build-args, distroless runtime, JSON-form CMD/ENTRYPOINT,\n# OCI labels, healthcheck, and intentional case-mixing on the\n# instruction heads (UPPER / lower / Mixed) to exercise ADR\n# 0011. Replace with a vidya snapshot when one ships.\n#\n# Variable expansion (`${VAR}`, `$VAR`): `$` and `@` are not\n# in `ident_start`. `$VAR` tokenizes as `$` op + `VAR` ident.\n# Coverage holds; theme can re-pair. (Unlike shell, Dockerfile\n# does not have a `special_vars` rule — Dockerfile's `$VAR`\n# is statically bound at build time, no runtime expansion\n# semantics.)\n#\n# Filename dispatch: Dockerfile uses no extension. `detect_language`\n# in `src/main.cyr` matches the literal name `Dockerfile` (and\n# common variants like `Containerfile`, `*.Dockerfile`,\n# `Dockerfile.*`). Users with non-standard names pass\n# `--language=dockerfile` explicitly.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Heredoc syntax (`COPY <<EOT`, etc.). Variable-length\n#     terminator — same scanner-shape gap as Lua's `[==[…]==]`,\n#     Ruby/PHP heredocs, Swift raw strings.\n#   - Parser directives `# syntax=…` and `# escape=…` are\n#     plain `#` line comments at this layer; theme can re-pair\n#     by token text.\n\n[grammar]\nname = \"dockerfile\"\nextensions = []\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_.-\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# ADR 0011: Dockerfile instruction heads are case-insensitive\n# (Dockerfile reference, \"Format\" section).\ncase_insensitive_keywords = true\n\noperators = [\n    \"=\", \"+\", \"-\", \"*\", \"/\",\n    \"<\", \">\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"!\", \"?\", \"@\", \"$\", \"#\",\n    \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n# Instruction heads. Per the Dockerfile reference, all\n# instructions are case-insensitive — declared here in\n# canonical UPPER form, matched case-folded via ADR 0011.\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Metadata / build args\n    \"FROM\", \"ARG\", \"LABEL\", \"MAINTAINER\",\n    # File-system / build steps\n    \"WORKDIR\", \"COPY\", \"ADD\", \"RUN\",\n    # Runtime configuration\n    \"USER\", \"ENV\", \"EXPOSE\", \"VOLUME\",\n    \"CMD\", \"ENTRYPOINT\", \"STOPSIGNAL\", \"HEALTHCHECK\",\n    \"SHELL\",\n    # Build modifiers\n    \"ONBUILD\",\n    # `AS` for `FROM x AS name`; `--from=` is operator + ident\n    \"AS\",\n]\n";
}

fn _grammar_blob_elixir() {
    return "# elixir — Elixir tokenizer grammar\n#\n# Rule scheme per ADR 0005. Elixir's token surface differs from\n# the C-family: `do … end` keyword bookends instead of `{ }`,\n# atoms `:foo`, sigils `~r/.../` for regex, the pipe operator\n# `|>`, and module attributes `@moduledoc` / `@doc`. No char\n# literals — Elixir uses `?a` for character codes (tokenizes as\n# `?` operator + ident; cosmetic).\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an Elixir reference sample yet. The local\n# `tests/corpus/concept.ex` mirrors the lexer+parser theme used\n# elsewhere, exercising `defmodule`, `@moduledoc` heredocs,\n# pattern-matching function clauses with `when` guards, the\n# pipe `|>`, and the Elixir keyword set. Replace with a vidya\n# snapshot when one ships.\n#\n# `@` in ident_start so `@moduledoc`, `@doc`, `@kinds`, etc.\n# tokenize as a single ident — same call as Java/Kotlin\n# annotations and Zig's `@`-builtins.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Sigils `~r/.../`, `~w()`, `~s\"…\"`. The `~` is currently\n#     in operators; sigil bodies tokenize as op + ident +\n#     pair-string + ident-flags. Cosmetic; coverage holds.\n#   - Heredoc strings `\"\"\"…\"\"\"` would benefit from a pair rule\n#     ahead of `\"…\"` (same shape as TOML\n#     [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)).\n#     Added below.\n#   - String interpolation `#{expr}` stays inside the string-\n#     pair span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).\n#   - Atoms `:foo` tokenize as `:` punctuation + `foo` ident.\n#     Cosmetic; theme can post-process.\n#   - Numeric underscores (`1_000_000`) — number scanner stops\n#     at `_`, yielding `number + ident`. Cosmetic.\n\n[grammar]\nname = \"elixir\"\nextensions = [\".ex\", \".exs\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for module attributes.\nident_start = \"A-Za-z_@\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. Elixir-specific: `|>` (pipe),\n# `<-` (generator / receive), `->` (anonymous fn / case clause),\n# `=>` (map key/value), `::` (type spec), `<>` (string concat),\n# `++` / `--` (list concat / subtract), `..` (range), `|` (cons /\n# alternative), `&&` / `||` / `!` (short-circuit), `&&&` / `|||`\n# (bitwise), `===` / `!==` (strict equality), `=~` (regex\n# match), plus the standard set. `~` for sigils.\noperators = [\n    \"<<<\", \">>>\",\n    \"===\", \"!==\",\n    \"<<=\", \">>=\",\n    \"&&&\", \"|||\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"->\", \"<-\", \"=>\", \"::\", \"<>\",\n    \"++\", \"--\", \"..\",\n    \"=~\",\n    \"|>\",\n    \"+=\", \"-=\", \"*=\", \"/=\",\n    # `%` is Elixir's map / struct literal prefix (`%{key: v}`,\n    # `%Token{kind: …}`). It is NOT a modulo operator — Elixir\n    # uses `rem/2` and `Integer.mod/2`. Listed here so the byte\n    # is classified as an operator rather than falling to the\n    # error fallback.\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"@\",\n]\n\n# Punctuation. `|` shows up in pattern matching (`[h | t]`,\n# `case … |`) — but it's an operator above for `||` precedence.\n# Single `|` falls out naturally.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n# Heredoc strings `\"\"\"…\"\"\"` (Elixir module/doc strings). Ordered\n# before `\"…\"` so the longer prefix wins.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\\\"\\\"\"\nend = \"\\\"\\\"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / definition heads\n    \"defmodule\", \"defprotocol\", \"defimpl\", \"defstruct\",\n    \"defexception\", \"defguard\", \"defmacro\", \"defmacrop\",\n    \"def\", \"defp\",\n    \"alias\", \"import\", \"use\", \"require\",\n    # Block heads\n    \"do\", \"end\", \"fn\", \"after\", \"rescue\",\n    \"catch\", \"else\", \"raise\", \"throw\",\n    # Control flow / pattern\n    \"if\", \"unless\", \"case\", \"cond\", \"when\",\n    \"with\", \"for\", \"receive\",\n    \"true\", \"false\", \"nil\",\n    # Logical-as-words (Elixir spells these too)\n    \"and\", \"or\", \"not\", \"in\",\n    # Misc\n    \"quote\", \"unquote\", \"unquote_splicing\",\n]\n";
}

fn _grammar_blob_go() {
    return "# go — Go tokenizer grammar\n#\n# Rule scheme per ADR 0005. Close in shape to rust.cyml — the same\n# data-driven scanner with a Go-specific `[defaults]` and rule list.\n#\n# Scope: covers what vidya's content/lexing_and_parsing/go.go\n# exercises (line comments, double-quoted strings, the standard\n# operator set including `:=`, `<-`, `...`, plus the 25 reserved\n# words).\n#\n# Block comments `/* … */` are recognised via a `match = \"pair\"`\n# rule below. Go's block comments are non-nestable (Go spec §3.4),\n# so the same simple greedy match used in C works.\n#\n# Known gaps for future ADRs (not triggered by the vidya sample):\n#   - Raw strings `` `…` `` (backtick-delimited, no escapes,\n#     embedded newlines allowed). The canonical sample has zero.\n#     Trivial follow-on: a third `[[rules]] match = \"pair\"` with\n#     `start = end = \"`\"`, no escape.\n#   - Rune literals `'x'`. Same pattern as Rust / C — splits into\n#     op/body/op. Cosmetic; coverage holds.\n#   - Type literals with explicit underscores in numbers\n#     (`1_000_000`). Today's number scanner stops at the `_`,\n#     yielding `number + ident`. Cosmetic; coverage holds.\n#   - Predeclared identifiers (`true`, `false`, `nil`, `iota`,\n#     `len`, `cap`, `make`, `new`, `append`, `panic`, …) tokenize\n#     as `ident`, not `keyword`. Same call as ADR 0004 for shell\n#     built-ins: keyword means *reserved*, and these are\n#     shadowable in Go (you can write `len := 5`).\n\n[grammar]\nname = \"go\"\nextensions = [\".go\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# UTF-8 in `/* … */` and `//` comment text → one ident instead of\n# per-byte errors. Same call as ADR 0009.\nunicode_ident = true\n\n# Rune literals `'C'` / `'\\C'` tokenize as a single TK_STRING.\n# See ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. Go-specific: `:=` (short var\n# decl), `<-` (channel send/recv), `...` (variadic / spread),\n# `&^` and `&^=` (bit-clear), `++` / `--` (statement-only but at\n# the token level just operators), plus the standard C-family set.\noperators = [\n    \"<<=\", \">>=\", \"&^=\",\n    \"<<\", \">>\", \"&^\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \":=\", \"<-\", \"...\",\n    \"++\", \"--\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"'\",\n]\n\n# Punctuation, longest-match.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. Non-nestable per Go spec §3.4 — simple\n# greedy match. Ordered after `//` (which is itself ordered ahead\n# of any `/`-operator step in the scanner pipeline).\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Declarations\n    \"package\", \"import\", \"func\", \"var\", \"const\", \"type\",\n    # Composite-type keywords\n    \"struct\", \"interface\", \"map\", \"chan\",\n    # Control flow\n    \"if\", \"else\", \"for\", \"switch\", \"case\", \"default\",\n    \"select\", \"range\",\n    \"return\", \"break\", \"continue\", \"goto\", \"fallthrough\",\n    # Concurrency / cleanup\n    \"go\", \"defer\",\n]\n";
}

fn _grammar_blob_graphql() {
    return "# graphql — GraphQL tokenizer grammar (SDL + queries)\n#\n# Rule scheme per ADR 0005. GraphQL's surface is small:\n#   - `#` line comments.\n#   - `\"\"\"…\"\"\"` block strings (description docstrings); fall\n#     back to `\"…\"` for inline strings.\n#   - `$variable` references in operations and field arguments.\n#   - Directives `@deprecated`, `@include`, etc.\n#   - Reserved words (case-sensitive in GraphQL): `type`,\n#     `interface`, `union`, `enum`, `scalar`, `input`,\n#     `query`, `mutation`, `subscription`, `fragment`, `on`,\n#     `implements`, `extend`, `directive`, `schema`,\n#     `repeatable`, `true`/`false`/`null`.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a GraphQL reference sample yet. The local\n# `tests/corpus/concept.graphql` is a small SDL schema (User /\n# Post / Comment) plus a few executable operations exercising\n# directives, default args, list/non-null types, and the\n# `\"\"\"…\"\"\"` docstring shape. Replace with a vidya snapshot\n# when one ships.\n#\n# `$` in `ident_start` so `$id`, `$input`, `$first` etc.\n# tokenize as a single ident. Same call as PHP / Ruby / Swift.\n#\n# `@` in `ident_start` so `@deprecated`, `@include`,\n# `@skip`, `@requires(fields: …)` etc. tokenize as a single\n# ident. Same call as Java / Kotlin / Zig.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Float / scientific notation (`3.14`, `1.5e3`). Not in the\n#     stand-in.\n#   - Custom directive bodies are tokenized as ident + arg\n#     list; renderers can re-pair the directive form by token\n#     text.\n\n[grammar]\nname = \"graphql\"\nextensions = [\".graphql\", \".gql\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_$@\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. GraphQL has very few:\n# `=` for default values, `!` for non-null type marker, `|` for\n# union members, `&` for interface intersection (rare),\n# `...` for spread/fragment.\noperators = [\n    \"...\",\n    \"=\",\n    \"!\", \"|\", \"&\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n# Block strings `\"\"\"…\"\"\"` (descriptions). Ordered before the\n# regular `\"…\"` rule so the longer prefix wins (architecture\n# note 003).\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\\\"\\\"\"\nend = \"\\\"\\\"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Type-system declarations\n    \"schema\", \"scalar\", \"type\", \"interface\", \"union\",\n    \"enum\", \"input\", \"directive\",\n    # Modifiers\n    \"implements\", \"extend\", \"repeatable\",\n    # Operation heads\n    \"query\", \"mutation\", \"subscription\", \"fragment\",\n    \"on\",\n    # Reserved literals\n    \"true\", \"false\", \"null\",\n]\n";
}

fn _grammar_blob_haskell() {
    return "# haskell — Haskell tokenizer grammar\n#\n# Rule scheme per ADR 0005. Haskell's surface mixes:\n#   - `--` line comments (no prefix collision with any pair rule\n#     in this grammar, so the standard line-rule shape works —\n#     unlike Lua where `--[[` shared the prefix; see\n#     [architecture note 003](../docs/architecture/003-pair-rule-ordering.md)).\n#   - `{- … -}` block comments. Nestable per spec; the pair-rule\n#     scanner closes at the first `-}` — same documented gap as\n#     Rust and OCaml.\n#   - Rich symbol-operator surface (`>>=`, `<$>`, `<*>`, `<>`,\n#     `<-`, `->`, `=>`, `::`, `..`, `++`, `:`, `\\`, `||`, `&&`,\n#     and arbitrary user-defined operators using punctuation\n#     chars). The standard set covers everything in\n#     `tests/corpus/concept.hs`; user-defined exotic operators\n#     would surface as multi-byte token runs in a real corpus.\n#   - Char literals `'a'`, `'\\n'` (handled by `char_literal`,\n#     ADR 0010). Haskell does NOT use leading-`'` for type\n#     variables (those are lowercase idents like `a`, `b`), so\n#     the lifetime-preservation logic is unnecessary — every\n#     `'…'` in real Haskell is a char literal.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Haskell reference sample yet. The local\n# `tests/corpus/concept.hs` mirrors the lexer+parser theme used\n# elsewhere, exercising `data` algebraic-data-type declarations,\n# `deriving` clauses, type-class constraints, `do`-notation in\n# `IO ()`, guards, the `where` clause, and the Haskell keyword\n# set. Replace with a vidya snapshot when one ships.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Layout-sensitive parsing (where/let/do off-side rule).\n#     Tokenization is unaffected — the layout rule is a parser-\n#     level concern that consumers handle.\n#   - Pragmas `{-# LANGUAGE … #-}`. Treated as block comments\n#     today (the `{-` opener wins). Themes that want to colour\n#     pragmas distinctly can post-process by token text.\n#   - Multi-line strings `\"\"\"…\"\"\"` (not Haskell syntax).\n#   - User-defined operators with arbitrary punctuation chars\n#     (e.g. `<|>`, `>=>`). Most common ones (`<$>`, `<*>`,\n#     `<>`, `<|>`, `>=>`, `>>=`, `>>`, `<<`) are in the operator\n#     list below; rarer ones may fragment.\n\n[grammar]\nname = \"haskell\"\nextensions = [\".hs\", \".lhs\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\n# `'` is in `ident_cont` (but NOT `ident_start`) so prime-\n# suffixed names like `rest'`, `x'`, `f''` tokenize as a single\n# ident. Standalone `'` at a cursor position still routes to\n# step 7b (char_literal) since char_literal runs before\n# operator. Char literals like `'a'` work uniformly.\nident_cont  = \"A-Za-z0-9_'\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Haskell-specific: `>>=` /\n# `>>` / `=<<` / `>=>` / `<=<` (monadic bind / sequence /\n# fish), `<$>` / `<*>` / `<|>` (Functor / Applicative /\n# Alternative), `<>` (Monoid append), `<-` (do-bind), `->`\n# (function arrow), `=>` (type-class constraint), `::` (type\n# annotation), `..` (range), `++` (list append), `:` (list\n# cons), `\\` (lambda head — `\\x -> …`), `@` (as-pattern),\n# `|` (guard / case alt).\noperators = [\n    \"=<<\", \">=>\", \"<=<\",\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"<$>\", \"<*>\", \"<|>\", \"<>\",\n    \"&&\", \"||\",\n    \"==\", \"/=\", \"<=\", \">=\",\n    \"->\", \"<-\", \"=>\", \"::\", \"..\",\n    \"++\", \"**\",\n    \"+=\", \"-=\", \"*=\", \"/=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"@\", \"#\", \":\",\n    # `\\` heads lambdas (`\\x -> x + 1`). Without this it would\n    # fall to error; the string-pair `escape = \"\\\\\"` consumes\n    # `\\<C>` inside string spans, so `\\` outside strings is\n    # safely an operator.\n    \"\\\\\",\n    # `` ` `` is Haskell's infix-function marker\n    # (`` a `div` b ``, `` xs `elem` ys ``). Treated as a 1-byte\n    # operator. Themes can re-pair adjacent backticks if they\n    # want to colour the wrapped name distinctly.\n    \"`\",\n]\n\n# Punctuation. `,` for tuples, `;` for explicit semis,\n# `( ) [ ]` for grouping, `{ }` for explicit-layout blocks.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `{- … -}` block comments. Pair rule. Nestable in spec — closes\n# at first `-}` per architecture note 003 (same gap as Rust).\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"{-\"\nend = \"-}\"\n\n\n# `--` line comment. No prefix collision with any pair rule\n# (unlike Lua), so the line-rule shape is fine.\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"--\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / declaration heads\n    \"module\", \"import\", \"where\",\n    \"data\", \"type\", \"newtype\", \"class\", \"instance\",\n    \"deriving\",\n    # Definition / scope\n    \"let\", \"in\",\n    # Pattern matching / control flow\n    \"case\", \"of\",\n    \"if\", \"then\", \"else\",\n    # Do-notation\n    \"do\",\n    # Reserved\n    \"default\",\n    \"infix\", \"infixl\", \"infixr\",\n    \"foreign\",\n    # Boolean (not strictly reserved but conventional)\n    \"True\", \"False\",\n    # Bottom\n    \"undefined\", \"error\",\n]\n";
}

fn _grammar_blob_html() {
    return "# html — HTML tokenizer grammar\n#\n# Rule scheme per ADR 0005. HTML at the token level is fairly\n# small:\n#   - `<!-- … -->` block comments (4-byte / 3-byte pair).\n#   - `\"…\"` and `'…'` strings (attribute values).\n#   - `<` / `>` / `=` / `/` as operators (tag delimiters,\n#     attribute assignment, self-closing slash).\n#   - Tag names tokenize as plain `ident` — no keyword list,\n#     because HTML5 has hundreds of valid element names plus\n#     custom elements (`<my-component>`). Themes can colour\n#     tags by token text. Same call as ADR 0004 for shell\n#     built-ins.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an HTML reference sample yet. The local\n# `tests/corpus/concept.html` exercises HTML5 doctype, semantic\n# elements (`<header>`, `<main>`, `<article>`, `<aside>`,\n# `<footer>`), boolean attributes (`disabled`, `checked`),\n# entity references (`&mdash;`, `&lt;`, `&gt;`, `&amp;`,\n# `&copy;`), `data-*` attributes, embedded `<style>` and\n# `<script>` blocks, and the `<!-- … -->` comment shape.\n# Replace with a vidya snapshot when one ships.\n#\n# Embedded `<script>` and `<style>` blocks tokenize as plain\n# HTML — body content is just a sequence of idents, operators,\n# strings, etc. **Grammar composition** for routing inner\n# content through JS / CSS grammars is scheduled for 1.11.0.\n#\n# Known gaps (not triggered by the stand-in):\n#   - DOCTYPE declarations (`<!DOCTYPE …>`). The stand-in\n#     uses lowercase `<!doctype html>`; both tokenize as\n#     `<` op + `!` op + ident + ident + `>` op. Coverage\n#     holds; theme can re-pair.\n#   - Conditional comments (`<!--[if IE]>…<![endif]-->`,\n#     IE-specific). Not in the stand-in.\n#   - Numeric character references (`&#8212;`). Tokenize as\n#     `&` op + `#` op + number + `;` punct. Coverage holds.\n\n[grammar]\nname = \"html\"\nextensions = [\".html\", \".htm\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Tag names and attribute names use ASCII letters plus `-`\n# (custom-element style, `data-*`, `aria-*`). We keep `-` in\n# `ident_cont` only — `-` at the start of an attribute would\n# be a syntax error anyway.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. HTML uses very few:\n# `<` / `>` for tag delimiters, `=` for attribute assignment,\n# `/` for self-closing slash, `&` and `;` for entity references\n# (handled with `&` operator + ident + `;` punctuation),\n# `!` for `<!doctype` / `<!--`.\noperators = [\n    \"<\", \">\", \"=\", \"/\",\n    \"&\", \"!\", \"?\",\n    # `#` shows up in embedded CSS hex colors (`#FF6600`),\n    # numeric character references (`&#8212;`), and `id`-style\n    # URL fragments. Listed as a 1-byte op so embedded content\n    # tokenizes cleanly until grammar composition (1.11.0) routes\n    # `<style>` / `<script>` bodies to their own grammars.\n    \"#\",\n]\n\npunctuation = [\n    \"(\", \")\", \"[\", \"]\", \"{\", \"}\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `<style>` and `<script>` blocks route their bodies through\n# the css and javascript grammars respectively (ADR 0013 —\n# grammar composition, 1.11.1+). Compose rules MUST be\n# declared first; they run at scanner pipeline step 0, ahead\n# of every other rule type, so the outer HTML scanner doesn't\n# eat the start markers byte-by-byte.\n#\n# Markers themselves emit as `TK_PUNCTUATION` (single tokens\n# the length of the start/end string). Themes that want to\n# render `<style>` as a multi-token shape can post-process by\n# token text.\n#\n# Note: this matches the literal `<style>` / `<script>`\n# strings without attributes. A real HTML page often has\n# `<script type=\"module\">` etc.; the compose rule's start is\n# a fixed prefix, so attribute-bearing forms fall back to\n# normal HTML tokenization (the body is structural, not\n# routed). A future extension could add a regex-y attribute\n# tolerance — until then, this is a documented limitation.\n[[rules]]\nmatch = \"compose\"\nstart = \"<style>\"\nend = \"</style>\"\ninner = \"css\"\n\n\n[[rules]]\nmatch = \"compose\"\nstart = \"<script>\"\nend = \"</script>\"\ninner = \"javascript\"\n\n\n# `<!-- … -->` block comment. 4-byte start, 3-byte end —\n# multi-byte pair shape, no scanner code needed.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"<!--\"\nend = \"-->\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n";
}

fn _grammar_blob_ini() {
    return "# ini — INI / .conf tokenizer grammar\n#\n# Rule scheme per ADR 0005. INI is one of the simplest formats\n# in the bundled set:\n#   - `;` and `#` line comments (both common; some tools use\n#     only one).\n#   - `[section]` headers — `[` + ident + `]` punctuation.\n#   - `key = value` lines — `=` operator, value can be\n#     unquoted or `\"...\"`/`'...'` quoted.\n#   - No real keywords. `true`/`false`/`null`/`yes`/`no`/`on`/\n#     `off` sometimes carry semantics, but it varies by parser\n#     dialect; we don't promote them.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an INI reference sample yet. The local\n# `tests/corpus/concept.ini` covers section headers (including\n# the `[a.b.c]` nested-key convention), both `;` and `#`\n# comment forms, quoted and unquoted values, comma-separated\n# value lists, and URL-style values. Replace with a vidya\n# snapshot when one ships.\n#\n# Many INI dialects (and `.conf` formats) share this shape:\n# .gitconfig, .editorconfig, systemd unit files, php.ini, the\n# pip / setuptools config families, and most desktop-app\n# config files. This grammar is intentionally permissive\n# rather than dialect-specific.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Multi-line values via line-continuation (`\\` at end of\n#     line). Tokenizes as `\\` operator + newline + content.\n#     Cosmetic; coverage holds.\n#   - `KEY[]` repeated-key array syntax (PHP-style ini).\n#     Tokenizes as ident + `[` + `]`. Cosmetic.\n\n[grammar]\nname = \"ini\"\nextensions = [\".ini\", \".conf\", \".cfg\", \".properties\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Section names and keys can have dots, dashes, and slashes\n# in some dialects; keep `_`/`-`/`.` in `ident_cont` so\n# `[auth.providers.github]` and `max-age` are single idents.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_.-/\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\noperators = [\n    \"=\", \":\", \"+\", \"-\", \"*\", \"/\",\n    \"<\", \">\",\n    \"&\", \"|\", \"@\",\n    \"!\", \"?\", \"#\", \"$\",\n    \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `;` line comment (classic INI form). Must come BEFORE the\n# `;` punctuation listing has any effect — the line-rule step\n# (step 2) fires before punctuation (step 9). For grammars\n# where `;` is also a statement terminator, the grammar would\n# need to choose; here we choose comment.\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \";\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n";
}

fn _grammar_blob_java() {
    return "# java — Java tokenizer grammar\n#\n# Rule scheme per ADR 0005. C-family at the token level — close in\n# shape to typescript.cyml + cpp.cyml.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Java reference sample yet. The local\n# `tests/corpus/concept.java` mirrors the lexer+parser theme used\n# by every vidya `lexing_and_parsing/` sample, exercising\n# annotations (`@Override`), generics (`List<String>`), `sealed\n# interface` / `record` / `switch` expressions, char literals\n# (`'+'`, `'\\0'`, `'\\n'`), block comments, and the Java keyword\n# set. Replace the stand-in with a vidya snapshot when one ships.\n#\n# Annotations: `@` is in `ident_start` so `@Override`,\n# `@Deprecated`, `@SuppressWarnings`, etc. tokenize as a single\n# ident — same pragmatic move as Zig's `@`-builtins (1.2.0) and\n# Rust's `$`-macros ([ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md)).\n#\n# Identifier dollar: `$` is also in `ident_start` since Java\n# permits `$` in identifiers (compiler-generated names use it for\n# inner classes, lambdas, etc.).\n#\n# Known gaps (not triggered by the stand-in):\n#   - Text blocks (`\"\"\"…\"\"\"`, since Java 13). Not in the\n#     stand-in. If a future corpus uses them, add a pair rule\n#     ordered before the regular `\"…\"` rule (same shape as\n#     [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)\n#     for TOML).\n#   - Numeric literal suffixes (`42L`, `3.14f`) and underscores\n#     (`1_000_000`). Tokenize as number + ident or fragment at the\n#     `_` — cosmetic; coverage holds.\n#   - Float literals (`3.14`). The number scanner stops at `.`;\n#     `3.14` becomes `number(3) + .(operator) + number(14)`.\n#     Cosmetic; coverage holds.\n\n[grammar]\nname = \"java\"\nextensions = [\".java\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for annotations, `$` for compiler-generated / lambda names.\nident_start = \"A-Za-z_$@\"\nident_cont  = \"A-Za-z0-9_$\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Java-specific: `->` (lambdas),\n# `::` (method reference), `>>>` (unsigned right shift), `>>>=`,\n# plus the standard C-family set including compound assignment.\noperators = [\n    \">>>=\",\n    \"<<=\", \">>=\",\n    \">>>\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"->\", \"::\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n]\n\n# Punctuation. `:` (label / ternary / switch arms) and `;`\n# (statement terminator) join the standard C-family set.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Block comments `/* … */`. Non-nestable in Java per JLS §3.7;\n# same simple greedy match as ADR 0009's C grammar.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / package / imports\n    \"package\", \"import\",\n    # Type declarations\n    \"class\", \"interface\", \"enum\", \"record\", \"sealed\",\n    \"permits\", \"extends\", \"implements\", \"non-sealed\",\n    # Modifiers\n    \"public\", \"protected\", \"private\", \"static\", \"final\",\n    \"abstract\", \"synchronized\", \"native\", \"strictfp\",\n    \"transient\", \"volatile\", \"default\",\n    # Control flow\n    \"if\", \"else\", \"while\", \"do\", \"for\", \"switch\", \"case\",\n    \"break\", \"continue\", \"return\", \"yield\",\n    \"try\", \"catch\", \"finally\", \"throw\", \"throws\",\n    # Object-oriented\n    \"new\", \"this\", \"super\", \"instanceof\",\n    # Primitive types + void\n    \"void\", \"boolean\", \"byte\", \"short\", \"int\", \"long\",\n    \"float\", \"double\", \"char\",\n    # Reserved literals\n    \"true\", \"false\", \"null\",\n    # Misc reserved\n    \"var\", \"assert\", \"goto\", \"const\",\n]\n";
}

fn _grammar_blob_javascript() {
    return "# javascript — JavaScript tokenizer grammar\n#\n# Rule scheme per ADR 0005. JavaScript is TypeScript minus the\n# type-declaration layer (interface / type / enum / namespace /\n# visibility modifiers). Shares the defaults: same ident class,\n# same operators, same three string types. The only real\n# difference from typescript.cyml is the keyword list.\n#\n# Corpus: tests/corpus/concept.js (hand-rolled stand-in per\n# ADR 0006 — vidya doesn't yet ship a JS reference sample).\n#\n# Known gaps (same as typescript.cyml):\n#   - Template literal interpolation `${expr}` — flat string.\n#   - Regex literals `/pat/flags` — not handled; `\\` is an operator\n#     so escapes inside regex don't error, but regex isn't a\n#     distinguished token.\n#   - JSX — a separate grammar, not this one.\n\n[grammar]\nname = \"javascript\"\nextensions = [\".js\", \".mjs\", \".cjs\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_$\"\nident_cont  = \"A-Za-z0-9_$\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# Operators: identical to typescript.cyml.\noperators = [\n    \"===\", \"!==\", \"...\", \"**=\",\n    \"&&=\", \"||=\", \"??=\",\n    \"**\", \"??\", \"?.\",\n    \"<<=\", \">>=\", \">>>\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"++\", \"--\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"=>\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"`\"\nend = \"`\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Declarations\n    \"let\", \"const\", \"var\", \"function\", \"class\",\n    # Module\n    \"import\", \"export\", \"from\", \"as\",\n    # Control flow\n    \"if\", \"else\", \"while\", \"for\", \"do\",\n    \"switch\", \"case\", \"default\", \"break\", \"continue\",\n    \"return\", \"throw\", \"try\", \"catch\", \"finally\",\n    # OO / inheritance\n    \"extends\",\n    \"new\", \"this\", \"super\",\n    # Modifiers / async\n    \"static\",\n    \"async\", \"await\", \"yield\",\n    # Operator-keywords\n    \"typeof\", \"instanceof\", \"in\", \"of\", \"void\", \"delete\",\n    # Literals\n    \"true\", \"false\", \"null\", \"undefined\",\n]\n";
}

fn _grammar_blob_json() {
    return "# json — JSON tokenizer grammar\n#\n# Rule scheme per ADR 0005. JSON is nearly a subset of TOML at the\n# token level: double-quoted strings, decimal numbers, structural\n# punctuation, and the keywords true/false/null.\n#\n# Corpus: tests/corpus/concept.json is a hand-rolled stand-in\n# (see ADR 0006 — vidya doesn't yet ship a JSON reference sample).\n#\n# Scope: valid JSON tokens plus pragmatic permissiveness. vyakarana\n# is a tokenizer, not a validator; bare words outside true/false/null\n# tokenize as TK_IDENT rather than TK_ERROR. A JSON parser layered\n# on top is free to reject.\n#\n# Out of scope (first pass):\n#   - Number exponent form (`1e5`, `1.5e-3`). Current default scanner\n#     handles leading-digit runs + 0x/0b/0o prefixes; no `.`/`e`.\n#     Falls back to multi-token (number + . + number + e + ...).\n#     Not an error, but an ADR candidate when a future corpus shows\n#     it matters.\n#   - Unicode escapes inside strings (`\\uNNNN`) — passed through as\n#     part of the string token (bytes preserved, no decoding).\n\n[grammar]\nname = \"json\"\nextensions = [\".json\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Bare-word scanner exists just to turn `true`/`false`/`null` into\n# keyword tokens (via the [[rules]] words lookup below). Strict JSON\n# forbids bare words elsewhere; our grammar emits TK_IDENT for them,\n# letting a downstream parser validate.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\n\n# `+`/`-` for signed numbers (JSON allows `-`; `+` is non-standard\n# but cheap to include and keeps output sensible on slightly-loose\n# inputs).\noperators = [\n    \"+\", \"-\",\n]\n\n# JSON's structural punctuation.\npunctuation = [\n    \"{\", \"}\", \"[\", \"]\", \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n# JSON has no comments and only double-quoted strings.\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"true\", \"false\", \"null\",\n]\n";
}

fn _grammar_blob_kotlin() {
    return "# kotlin — Kotlin tokenizer grammar\n#\n# Rule scheme per ADR 0005. JVM-language sibling of java.cyml,\n# tuned for Kotlin's syntactic surface.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Kotlin reference sample yet. The local\n# `tests/corpus/concept.kt` mirrors the lexer+parser theme used\n# elsewhere, exercising data classes, sealed interfaces, when\n# expressions, lambdas, string templates, char literals, the `to`\n# infix function, and the Kotlin keyword set. Replace with a\n# vidya snapshot when one ships.\n#\n# Annotations: `@` is in `ident_start` so `@Override`,\n# `@JvmStatic`, `@file:JvmName`, etc. tokenize as a single ident.\n# Same call as java.cyml.\n#\n# Identifier dollar: `$` is in `ident_start` so `$variable`\n# string interpolation references can be tokenized as part of an\n# ident — though string interpolation itself stays inside the\n# string-pair span (consistent with [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md)\n# for shell). A consumer wanting to colour interpolation breaks\n# does it post-tokenization.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Triple-quoted raw strings `\"\"\"…\"\"\"`. Not in the stand-in.\n#     Add a pair rule ahead of the regular string rule when a\n#     corpus needs them — see [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md)\n#     for the same shape in TOML.\n#   - Backtick-quoted identifiers (`` `class` ``) — used to\n#     reference Java reserved words from Kotlin. Could be added\n#     as a pair rule emitting `ident` if a corpus surfaces them.\n#   - Numeric suffixes (`42L`, `1.5f`, `1_000_000`). Same story\n#     as java.cyml — cosmetic; coverage holds.\n\n[grammar]\nname = \"kotlin\"\nextensions = [\".kt\", \".kts\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_$@\"\nident_cont  = \"A-Za-z0-9_$\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Kotlin-specific: `?:` (Elvis),\n# `?.` (safe-call), `!!` (not-null assert), `..` (range), `->`\n# (lambda / when arms), `::` (callable reference), `===` / `!==`\n# (referential equality), plus the standard C-family set.\noperators = [\n    \"===\", \"!==\",\n    \"<<=\", \">>=\",\n    \">>>\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"->\", \"::\", \"?:\", \"?.\", \"..\",\n    \"!!\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / package / imports\n    \"package\", \"import\",\n    # Type declarations\n    \"class\", \"interface\", \"object\", \"enum\", \"data\",\n    \"sealed\", \"annotation\", \"companion\",\n    # Modifiers / visibility\n    \"public\", \"internal\", \"private\", \"protected\",\n    \"open\", \"final\", \"abstract\", \"override\", \"lateinit\",\n    \"inline\", \"noinline\", \"crossinline\", \"external\",\n    \"tailrec\", \"operator\", \"infix\", \"suspend\",\n    \"vararg\", \"reified\", \"const\",\n    # Declaration heads\n    \"fun\", \"val\", \"var\", \"typealias\",\n    # Control flow\n    \"if\", \"else\", \"when\", \"while\", \"do\", \"for\",\n    \"break\", \"continue\", \"return\", \"throw\",\n    \"try\", \"catch\", \"finally\",\n    # Object-oriented\n    \"this\", \"super\", \"is\",\n    # Reserved literals\n    \"true\", \"false\", \"null\",\n    # Type-system / range / membership infix words\n    \"in\", \"out\", \"as\",\n    \"by\", \"where\",\n]\n";
}

fn _grammar_blob_llvm_ir() {
    return "# llvm_ir — LLVM-IR (textual) tokenizer grammar\n#\n# Rule scheme per ADR 0005. LLVM-IR's textual form has a few\n# distinctive sigils:\n#   - `;` line comments.\n#   - `@global` / `@function` — module-level names.\n#   - `%local` / `%struct` — function-local virtual registers\n#     and struct type names.\n#   - `!metadata` — metadata references (`!llvm.module.flags`,\n#     numeric `!0`, named `!\"…\"`).\n#   - `#0`/`#1`/etc. — function-attribute group references.\n#\n# `@`/`%`/`!` in `ident_start` so each sigil + name form\n# tokenizes as a single ident — same pattern used for Java\n# annotations (1.3.0), Zig builtins (1.2.0), Rust macros\n# ([ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md)),\n# Elixir module attributes (1.5.0), and PHP variables (1.4.0).\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an LLVM-IR sample yet. The local\n# `tests/corpus/concept.ll` covers the textual-IR surface that\n# typically appears in compiler-output debugging:\n# `target datalayout`/`target triple`/`source_filename`,\n# named struct types, globals (private/internal/dso_local),\n# function definitions with attributes, basic-block labels\n# (`entry:`/`grow:`/`store:`), the common instruction set\n# (`alloca` not used here but `malloc`/`load`/`store`/`getelementptr`/\n# `bitcast`/`shl`/`mul`/`select`/`icmp`/`br`/`ret`/`call`/`tail call`),\n# attribute groups, and module-level `!metadata` blocks.\n# Replace with a vidya snapshot when one ships.\n#\n# `#0` etc. for attribute groups: `#` is in operators (not\n# ident_start) so `#0` tokenizes as `#` op + `0` number. That's\n# correct: the `#` is a sigil, the number is the group index.\n# Theme can re-pair if it wants the unified `#0` form.\n#\n# Known gaps (not triggered by the stand-in):\n#   - `c\"…\\00\"` C-string syntax with `\\xx` byte escapes — body\n#     of the string contains bytes the regular `\"…\"` pair rule\n#     handles uniformly via the `\\\\` escape.\n#   - Aggregate constants `<{ … }>` (packed structs). The\n#     `<{` and `}>` aren't in operators; would tokenize as\n#     `<` op + `{` punct + body + `}` punct + `>` op. Cosmetic.\n#   - Vector types `<4 x i32>` use `<` `x` `>`. Tokenizes as\n#     op + ident + ident + op + op. Cosmetic.\n\n[grammar]\nname = \"llvm_ir\"\nextensions = [\".ll\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for global / function names, `%` for locals, `!` for\n# metadata. `.` permitted mid-ident for names like\n# `llvm.module.flags` and `.str.empty`.\nident_start = \"A-Za-z_@%!.\"\nident_cont  = \"A-Za-z0-9_.\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. LLVM-IR has very few real\n# operators outside of mnemonics — most \"operations\" are\n# instruction names that tokenize as ident (then promoted to\n# keyword via the words rule below).\noperators = [\n    \"==\", \"!=\",\n    \"=\", \"+\", \"-\", \"*\",\n    \"<\", \">\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"?\", \"#\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \";\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module-level declaration heads\n    \"target\", \"datalayout\", \"triple\", \"source_filename\",\n    \"module\", \"asm\",\n    # Linkage / visibility / DLL storage / preemption\n    \"private\", \"internal\", \"available_externally\",\n    \"linkonce\", \"weak\", \"common\", \"appending\",\n    \"extern_weak\", \"linkonce_odr\", \"weak_odr\", \"external\",\n    \"dso_local\", \"dso_preemptable\",\n    \"default\", \"hidden\", \"protected\",\n    \"dllimport\", \"dllexport\",\n    \"thread_local\",\n    \"unnamed_addr\", \"local_unnamed_addr\",\n    # Storage attributes\n    \"constant\", \"global\", \"alias\", \"ifunc\",\n    # Function definition heads\n    \"declare\", \"define\",\n    # Calling conventions\n    \"ccc\", \"fastcc\", \"coldcc\",\n    \"anyregcc\", \"preserve_mostcc\", \"preserve_allcc\",\n    # Parameter attributes\n    \"zeroext\", \"signext\", \"inreg\", \"byval\", \"byref\",\n    \"preallocated\", \"inalloca\", \"sret\",\n    \"elementtype\", \"align\", \"noalias\", \"nocapture\",\n    \"nofree\", \"nonnull\", \"dereferenceable\", \"noundef\",\n    \"returned\", \"swiftself\", \"swiftasync\", \"swifterror\",\n    \"immarg\", \"writeonly\", \"readonly\", \"readnone\",\n    \"alignstack\", \"noimplicitfloat\", \"uwtable\",\n    \"willreturn\", \"norecurse\", \"nounwind\", \"nosanitize\",\n    # Function attributes\n    \"alwaysinline\", \"argmemonly\", \"allocsize\",\n    \"builtin\", \"cold\", \"convergent\",\n    \"hot\", \"inaccessiblememonly\", \"inlinehint\",\n    \"jumptable\", \"minsize\", \"naked\", \"noduplicate\",\n    \"noinline\", \"noredzone\", \"noreturn\",\n    \"optimize\", \"optsize\", \"speculatable\",\n    \"ssp\", \"sspreq\", \"sspstrong\",\n    \"strictfp\", \"uwtable\",\n    # Types (frequent enough to keyword)\n    \"void\", \"ptr\", \"label\", \"token\", \"metadata\",\n    \"i1\", \"i8\", \"i16\", \"i32\", \"i64\", \"i128\",\n    \"half\", \"float\", \"double\", \"fp128\",\n    \"x86_fp80\", \"ppc_fp128\", \"x86_mmx\",\n    \"type\",\n    # Instructions — terminator\n    \"ret\", \"br\", \"switch\", \"indirectbr\",\n    \"invoke\", \"callbr\", \"resume\", \"catchswitch\",\n    \"catchret\", \"cleanupret\", \"unreachable\",\n    # Instructions — unary / binary\n    \"fneg\",\n    \"add\", \"fadd\", \"sub\", \"fsub\", \"mul\", \"fmul\",\n    \"udiv\", \"sdiv\", \"fdiv\", \"urem\", \"srem\", \"frem\",\n    \"shl\", \"lshr\", \"ashr\",\n    \"and\", \"or\", \"xor\",\n    # Instructions — vector / aggregate\n    \"extractelement\", \"insertelement\", \"shufflevector\",\n    \"extractvalue\", \"insertvalue\",\n    # Instructions — memory access\n    \"alloca\", \"load\", \"store\",\n    \"fence\", \"cmpxchg\", \"atomicrmw\",\n    \"getelementptr\", \"inbounds\",\n    # Instructions — casts\n    \"trunc\", \"zext\", \"sext\",\n    \"fptrunc\", \"fpext\", \"fptoui\", \"fptosi\", \"uitofp\", \"sitofp\",\n    \"ptrtoint\", \"inttoptr\", \"bitcast\", \"addrspacecast\",\n    # Instructions — other\n    \"icmp\", \"fcmp\", \"phi\", \"select\", \"freeze\",\n    \"call\", \"tail\", \"musttail\", \"notail\",\n    \"va_arg\", \"landingpad\", \"catchpad\", \"cleanuppad\",\n    # Comparison predicates\n    \"eq\", \"ne\", \"ugt\", \"uge\", \"ult\", \"ule\",\n    \"sgt\", \"sge\", \"slt\", \"sle\",\n    \"oeq\", \"ogt\", \"oge\", \"olt\", \"ole\", \"one\", \"ord\",\n    \"ueq\", \"une\", \"uno\",\n    # Atomic ordering\n    \"acquire\", \"release\", \"acq_rel\", \"seq_cst\",\n    \"monotonic\", \"unordered\", \"syncscope\",\n    \"atomic\", \"volatile\",\n    # Boolean / null literals\n    \"true\", \"false\", \"null\", \"undef\", \"poison\", \"none\",\n    \"zeroinitializer\",\n]\n";
}

fn _grammar_blob_lua() {
    return "# lua — Lua tokenizer grammar\n#\n# Rule scheme per ADR 0005. Lua is the smallest grammar in this\n# batch — a handful of operators (`..`, `~=`, `//`, `<=`, `>=`,\n# `==`, `<<`, `>>`), about 22 reserved words, line comments via\n# `--`, and long-bracket forms `[[…]]` (string) / `--[[…]]`\n# (comment).\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Lua reference sample yet. The local\n# `tests/corpus/concept.lua` mirrors the lexer+parser theme used\n# elsewhere, exercising metatables, `local function`, `--[[ … ]]`\n# block comments, table constructors, and the Lua keyword set.\n# Replace with a vidya snapshot when one ships.\n#\n# Long-bracket forms:\n#   - `[[ … ]]` long string (no escapes, embedded newlines OK)\n#     → matched by a `match = \"pair\"` rule below.\n#   - `--[[ … ]]` long comment → matched by another pair rule\n#     below, ordered ahead of the `--` line-comment rule so the\n#     longer prefix wins (per [architecture note 003](../docs/architecture/003-pair-rule-ordering.md)).\n#\n# Variable-padded forms `[==[ … ]==]` / `--[==[ … ]==]` are NOT\n# supported — variable-length terminators require a new scanner\n# shape. Documented as a 1.x.x backlog item alongside Ruby\n# heredocs, PHP heredocs, and a few other variable-delimiter\n# forms; collectively forces a future ADR if a real corpus\n# surfaces one.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Variable-padded long brackets (see above).\n#   - Lua 5.3+ integer-division `//` IS in operators below.\n#   - Lua bitwise operators (`&`, `|`, `~`, `<<`, `>>`) IS in\n#     operators below; Lua 5.3+.\n\n[grammar]\nname = \"lua\"\nextensions = [\".lua\"]\n\n[defaults]\nshebang = true\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Lua-specific: `..` (string\n# concat), `~=` (not equal), `//` (floor / integer division,\n# Lua 5.3+), `<<` / `>>` (bit shifts), `~` as both bit-not\n# (unary) and bit-xor (binary), `=` is assignment, `==` is\n# equality.\noperators = [\n    \"<<\", \">>\",\n    \"==\", \"~=\", \"<=\", \">=\",\n    \"..\", \"//\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\", \"^\",\n    \"&\", \"|\", \"~\",\n    \"#\",\n    \"<\", \">\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# Lua comments. Both forms are expressed as pair rules so they\n# share a single dispatch step (pipeline step 3) — the line-rule\n# step (step 2) would match the `--` prefix greedily and never\n# let the longer `--[[` form win. Pair-rules iterate in\n# declaration order; the longer prefix MUST come first\n# (architecture note 003).\n#\n# Long comment `--[[ … ]]`.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"--[[\"\nend = \"]]\"\n\n\n# Line comment `-- … \\n`. The trailing newline is part of the\n# comment span (a slight cosmetic difference vs. the line-rule\n# shape, but coverage holds and themes don't care).\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"--\"\nend = \"\\n\"\n\n\n# `[[ … ]]` long string. No escape — Lua long strings are\n# uninterpreted.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"[[\"\nend = \"]]\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Definition / scope\n    \"function\", \"local\", \"return\", \"end\",\n    # Control flow\n    \"if\", \"then\", \"else\", \"elseif\", \"while\", \"do\",\n    \"for\", \"in\", \"repeat\", \"until\", \"break\", \"goto\",\n    # Logical (Lua spells these as words)\n    \"and\", \"or\", \"not\",\n    # Reserved literals\n    \"true\", \"false\", \"nil\",\n]\n";
}

fn _grammar_blob_makefile() {
    return "# makefile — GNU Make tokenizer grammar\n#\n# Rule scheme per ADR 0005. Makefile's surface:\n#   - `#` line comments.\n#   - Variable assignments: `=` (lazy), `:=` (immediate), `?=`\n#     (conditional), `+=` (append), `!=` (shell expansion in\n#     GNU 4.0+).\n#   - Automatic variables: `$@`, `$<`, `$^`, `$?`, `$*`, `$%`,\n#     `$+`, `$|`. The shell-style `special_vars = true` flag\n#     (1.0.0) handles all of these as 2-byte operators.\n#   - Function calls: `$(name args)` and `${name args}`.\n#   - Wildcards: `%` in pattern rules (`%.o: %.c`).\n#   - Conditional / include directives: `ifeq`, `ifneq`,\n#     `ifdef`, `ifndef`, `else`, `endif`, `include`,\n#     `-include`, `define`, `endef`, `export`, `unexport`,\n#     `override`, `vpath`.\n#   - `.PHONY:` is a special target — `.PHONY` tokenizes as\n#     `.` + `PHONY`; theme can re-pair.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Makefile reference sample yet. The\n# local `tests/corpus/Makefile` exercises every assignment\n# form, automatic variables, GNU function calls (`$(wildcard)`,\n# `$(shell)`, `$(notdir)`, `$(MAKE)`), pattern rules,\n# conditional flag blocks (`ifeq`/`ifdef`/`ifndef`), `.PHONY`,\n# and a small build graph. Replace with a vidya snapshot when\n# one ships.\n#\n# Tab-sensitive recipes: GNU make requires recipe lines to\n# start with a tab (or the rule won't fire). At the byte level\n# tabs are just whitespace; this grammar doesn't (and can't)\n# enforce the column-0-tab rule. Documented for grammar\n# authors who might be tempted to add layout-sensitive\n# tokenization.\n#\n# Filename dispatch: standard names are `Makefile`, `makefile`,\n# `GNUmakefile`. `detect_language` matches them by basename\n# suffix.\n#\n# Known gaps (not triggered by the stand-in):\n#   - `define VAR …` … `endef` multi-line variable bodies\n#     tokenize as `define` keyword + ident + arbitrary content\n#     up to `endef`. Bodies are not wrapped as a string-pair\n#     token because the body can include any byte.\n#   - Recipe lines (after a tab) are arbitrary shell text. No\n#     attempt is made to route them to the shell grammar.\n#     Grammar composition (1.11.0) covers this class of\n#     concern.\n\n[grammar]\nname = \"makefile\"\nextensions = []\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\n# `special_vars = true` reuses the shell rule type to match\n# 2-byte automatic variables: `$@`, `$<`, `$^`, `$?`, `$*`,\n# `$%`, `$+`, `$|`. Bare `$` falls out as a 1-byte operator\n# (then `$(name)` tokenizes as `$` + `(` + ident + `)`).\nspecial_vars = true\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. Make-specific assignment\n# forms `:=`, `?=`, `+=`, `!=` (latter only in GNU 4.0+).\noperators = [\n    \":=\", \"?=\", \"+=\", \"!=\",\n    \"=\",\n    \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"<\", \">\",\n    \"&\", \"|\", \"^\", \"~\",\n    \"@\", \"?\", \"!\",\n    \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Conditional directives\n    \"ifeq\", \"ifneq\", \"ifdef\", \"ifndef\",\n    \"else\", \"endif\",\n    # Include / load\n    \"include\", \"sinclude\",\n    # Definition\n    \"define\", \"endef\",\n    # Exporting\n    \"export\", \"unexport\",\n    # Override / private\n    \"override\", \"private\",\n    # Search paths\n    \"vpath\",\n    # Recursive / extra\n    \"undefine\", \"load\",\n]\n";
}

fn _grammar_blob_markdown() {
    return "# markdown — Markdown tokenizer grammar\n#\n# Rule scheme per ADR 0005. Markdown is the first grammar that's\n# really about structural prose rather than a programming language.\n# The tokenization is pragmatic: structural markers are operators,\n# inline / fenced code are pair-rule strings, prose is ident runs.\n#\n# Corpus: tests/corpus/concept.md is a hand-rolled stand-in (ADR 0006).\n#\n# Pair-rule ordering matters: `` ``` `` (fenced code, 3 bytes) must\n# come before `` ` `` (inline code, 1 byte) or the scanner will match\n# the single-backtick first and bail on the next backtick.\n#\n# Known gaps for future ADRs (cosmetic; coverage holds):\n#   - Setext heading underlines (`===`, `---`) are tokenized as three\n#     separate `=` / `-` operators. A theme can't color them\n#     distinctly from a horizontal rule or plain emphasis.\n#   - Tables don't get a distinguished kind — pipes are operators,\n#     dashes are operators.\n#   - Prose tokenizes as ident runs, not a distinguished `prose`\n#     kind (our 10-kind palette doesn't have one).\n#   - Snake_case prose words (rare) fragment because `_` is an\n#     emphasis marker here, not an ident char. URL paths like\n#     `https://x.y/z` fragment into many tokens; `[text](url)` is\n#     the idiomatic Markdown link anyway.\n\n[grammar]\nname = \"markdown\"\nextensions = [\".md\", \".markdown\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# Prose words only — `_` is an emphasis marker in Markdown, not an\n# identifier character. Snake_case fragments; this is the cost of\n# keeping `_italic_` distinguishable from a plain word.\nident_start = \"A-Za-z\"\nident_cont  = \"A-Za-z0-9\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\n\n# UTF-8 in prose (em-dashes, smart quotes, accented characters)\n# coalesces into one ident instead of per-byte errors. See ADR 0009.\nunicode_ident = true\n\n# Operators in longest-match order. ATX-heading prefixes (1–6 `#`s),\n# setext-heading underlines (`===`/`---`), emphasis (`**`/`__`/\n# `*`/`_`), strikethrough (`~~`), horizontal rules, blockquote `>`,\n# list bullets (`-` / `+`), plus the long tail of punctuation that\n# turns up in prose without a dedicated role.\noperators = [\n    \"######\", \"#####\", \"####\", \"###\", \"##\", \"#\",\n    \"===\", \"---\", \"***\", \"___\",\n    \"**\", \"__\", \"~~\",\n    \"=\", \"*\", \"_\", \"~\", \"-\", \"+\", \"/\", \"\\\\\",\n    \"<\", \">\", \"|\", \":\", \"@\", \"%\", \"^\", \"&\", \"?\", \"!\",\n]\n\n# Structural punctuation for links, images, and inline groups.\npunctuation = [\n    \"[\", \"]\", \"(\", \")\", \"{\", \"}\",\n    \",\", \";\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# Fenced code (`` ``` ... ``` ``) must match before inline code so\n# the 3-byte start wins the longest-match.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"```\"\nend = \"```\"\n\n\n# Inline code `` `...` ``.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"`\"\nend = \"`\"\n\n\n# HTML comments `<!-- ... -->` — rare but valid in Markdown.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"<!--\"\nend = \"-->\"\n\n\n# Markdown has no bare-word keywords (true/false/null mean nothing\n# here), but `[[rules]]` expects at least one words rule for a grammar\n# that wants keyword promotion. We leave the set empty — every ident\n# stays an ident.\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = []\n";
}

fn _grammar_blob_ocaml() {
    return "# ocaml — OCaml tokenizer grammar\n#\n# Rule scheme per ADR 0005. OCaml's surface differs from the\n# C-family on several axes:\n#   - `(* … *)` block comments. Nestable per spec; the pair-rule\n#     scanner is greedy so nested forms close at the first `*)`\n#     — same documented gap as Rust.\n#   - No line comments. `//` and `#` are not comment markers.\n#   - `'a` type variables AND `'c'` char literals share the same\n#     opening byte. The char_literal helper's lifetime-preservation\n#     logic ([ADR 0010](../docs/adr/0010-char-literal-default.md))\n#     handles the disambiguation: `'a` (no closing `'` at offset\n#     2) falls through to operator + ident; `'a'` matches the\n#     char-literal shape.\n#   - Rich operator surface: `|>` (pipe), `<-` (mutable assign),\n#     `:=` (ref assign), `->` (function arrow), `;;` (REPL\n#     terminator), `[|…|]` (array literal), `**` (power).\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an OCaml reference sample yet. The local\n# `tests/corpus/concept.ml` mirrors the lexer+parser theme used\n# elsewhere, exercising algebraic data types (`type expr = | Num\n# | Unary | BinOp`), pattern matching with guards, mutable\n# references, and the OCaml keyword set. Replace with a vidya\n# snapshot when one ships.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Quoted strings `{|…|}` and `{tag|…|tag}`. Not in the\n#     stand-in. Variable-length-delimiter form — same scanner-\n#     shape gap as Lua's `[==[…]==]`, Ruby/PHP heredocs, Swift\n#     raw strings.\n#   - Polymorphic variants `` `Foo `` (backtick prefix). Not\n#     in the stand-in. Treated as backtick + ident if a corpus\n#     surfaces them (need to add `` ` `` as operator).\n#   - Numeric underscores (`1_000_000`) — number scanner stops\n#     at `_`; cosmetic.\n\n[grammar]\nname = \"ocaml\"\nextensions = [\".ml\", \".mli\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. OCaml-specific: `|>` (pipe),\n# `<-` (mutable record-field assignment), `:=` (ref assignment),\n# `->` (function arrow), `;;` (REPL terminator), `**` (power),\n# `@@` (function application without precedence), `@` (list\n# concat). `<>` is structural inequality (not equal).\noperators = [\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\", \"<>\",\n    \"->\", \"<-\", \":=\", \"|>\", \"@@\", \"**\",\n    \"+=\", \"-=\", \"*=\", \"/=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"@\", \"#\",\n    # `'` is the type-variable prefix (`'a`, `'b`, `'_weak`).\n    # The char_literal helper yields when there's no closing\n    # quote at the right offset, so the leading `'` falls\n    # through here as a 1-byte operator and the body\n    # tokenizes as a regular ident on the next iteration —\n    # same fall-through pattern as Rust lifetimes (ADR 0010).\n    \"'\",\n]\n\n# Punctuation. `;` is statement separator; `;;` (REPL terminator)\n# is matched as 2-byte operator above. `::` not used in OCaml.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `(* … *)` block comments. Non-nestable in this implementation;\n# the spec allows nesting but the pair-rule scanner closes at the\n# first `*)`. Same gap as Rust.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"(*\"\nend = \"*)\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / definition\n    \"module\", \"open\", \"include\", \"struct\", \"sig\",\n    \"functor\", \"begin\", \"end\",\n    # Type-related\n    \"type\", \"of\", \"and\",\n    # Declaration heads\n    \"let\", \"rec\", \"in\", \"fun\", \"function\",\n    # Pattern matching / control flow\n    \"match\", \"with\", \"when\",\n    \"if\", \"then\", \"else\",\n    \"while\", \"do\", \"done\", \"for\", \"to\", \"downto\",\n    # Exception handling\n    \"try\", \"raise\", \"exception\",\n    # Boolean / comparison words\n    \"true\", \"false\",\n    \"as\", \"or\", \"not\",\n    # Object-oriented\n    \"class\", \"object\", \"method\", \"inherit\",\n    \"initializer\", \"val\", \"mutable\", \"private\",\n    \"virtual\", \"constraint\",\n    # Misc\n    \"lazy\", \"assert\", \"external\", \"ref\",\n    \"land\", \"lor\", \"lxor\", \"lnot\", \"lsl\", \"lsr\", \"asr\",\n    \"mod\",\n]\n";
}

fn _grammar_blob_php() {
    return "# php — PHP tokenizer grammar\n#\n# Rule scheme per ADR 0005. C-family at the token level — close in\n# shape to java.cyml + cpp.cyml. The `<?php` open tag and `?>`\n# close tag tokenize as `<` operator + `?` operator + `php` ident\n# (and `?` op + `>` op for the close), which is structurally\n# correct but not semantically distinguished. Themes that want\n# to colour the open tag specially can post-process by token\n# text.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a PHP reference sample yet. The local\n# `tests/corpus/concept.php` mirrors the lexer+parser theme used\n# elsewhere, exercising `enum`, `readonly` classes, `match`\n# expressions, the namespace + use surface, and the PHP keyword\n# set. Replace with a vidya snapshot when one ships.\n#\n# `$` in ident_start: PHP variables are `$name`, so `$` joins\n# `ident_start` (same pragmatic call as Rust's `$`-macros and\n# Zig's `@`-builtins). `$this`, `$source`, `$this->pos`\n# etc. tokenize as a single ident; the `->` arrow is a separate\n# 2-byte operator.\n#\n# Known gaps (not triggered by the stand-in):\n#   - `#[Attribute]` syntax (PHP 8). Today `#` is in operators,\n#     so `#[Foo]` tokenizes as `#` + `[` + `Foo` + `]` —\n#     coverage holds. A future ADR could promote `#[…]` to a\n#     unified attribute token if a corpus needs it.\n#   - Heredocs / nowdocs (`<<<EOT … EOT;`). Variable-length\n#     terminator. Same scanner-shape gap as Lua's `[==[…]==]`\n#     and Ruby's heredocs — track collectively.\n#   - Numeric literal underscores (`1_000_000`) — tokenize as\n#     number + ident; cosmetic.\n#   - String interpolation (`\"$x\"` and `\"{$x}\"`) stays inside\n#     the string-pair span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).\n\n[grammar]\nname = \"php\"\nextensions = [\".php\", \".phtml\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_$\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. PHP-specific: `->` (member\n# access), `=>` (array key/value, match arms), `::` (scope\n# resolution), `??` / `??=` (null-coalesce), `?->` (null-safe\n# member access, PHP 8), `<=>` (spaceship, PHP 7), `**` (power),\n# `**=` (power-assign), plus the standard C-family set.\noperators = [\n    \"<<=\", \">>=\", \"<=>\",\n    \"??=\", \"**=\",\n    \"?->\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"===\", \"!==\",\n    \"->\", \"=>\", \"::\", \"??\", \"**\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\", \".=\",\n    \"&=\", \"|=\", \"^=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\", \".\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n    \"#\",\n    \"@\",\n    # `\\` is PHP's namespace separator (`Vyakarana\\Concept`,\n    # `\\RuntimeException`). The string-pair rule's `escape =\n    # \"\\\\\"` consumes `\\<C>` inside string spans, so `\\` outside\n    # strings cleanly tokenizes as a 1-byte operator.\n    \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# PHP supports both `//` and `#` line comments. `#` is also a\n# comment in PHP (since forever) but is the immediate prefix in\n# ARM — different grammars own that byte differently.\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n# Block comments `/* … */`. Same shape as C/Java/C++.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / namespace\n    \"namespace\", \"use\", \"as\",\n    # Type-declaration heads\n    \"class\", \"interface\", \"trait\", \"enum\",\n    \"extends\", \"implements\",\n    # Modifiers / visibility\n    \"public\", \"private\", \"protected\",\n    \"static\", \"final\", \"abstract\", \"readonly\",\n    # Declaration heads\n    \"function\", \"fn\", \"const\", \"var\",\n    \"global\",\n    # Control flow\n    \"if\", \"elseif\", \"else\", \"while\", \"do\", \"for\", \"foreach\",\n    \"switch\", \"case\", \"default\", \"match\",\n    \"break\", \"continue\", \"return\", \"yield\",\n    \"try\", \"catch\", \"finally\", \"throw\",\n    \"goto\",\n    # Object-oriented\n    \"new\", \"this\", \"self\", \"parent\", \"instanceof\", \"clone\",\n    # Reserved literals\n    \"true\", \"false\", \"null\",\n    # Type hints / declarations\n    \"void\", \"bool\", \"int\", \"float\", \"string\", \"array\",\n    \"object\", \"callable\", \"iterable\", \"mixed\", \"never\",\n    # Misc reserved\n    \"echo\", \"print\", \"require\", \"require_once\", \"include\",\n    \"include_once\", \"declare\", \"endif\", \"endforeach\",\n    \"endwhile\", \"endfor\", \"endswitch\",\n    \"and\", \"or\", \"xor\", \"not\",\n    \"list\", \"isset\", \"unset\", \"empty\",\n]\n";
}

fn _grammar_blob_protobuf() {
    return "# protobuf — Protocol Buffers tokenizer grammar (proto3 + proto2)\n#\n# Rule scheme per ADR 0005. Mechanical C-family at the token\n# level: `//` and `/* */` comments, double-quoted strings,\n# decimal numbers, semicolons as statement terminators, and a\n# fixed keyword set covering proto2/proto3 declarations.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Protobuf reference sample yet. The local\n# `tests/corpus/concept.proto` exercises proto3 SDL: messages\n# (with nested types and `oneof` blocks), enums, services,\n# rpc methods (including server streaming), maps, repeated\n# fields, and the standard `import` / `option` / `package` /\n# `syntax` heads.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Custom options bodies `option (foo) = { … };` parse\n#     mostly fine — `(`, `)`, `{`, `}` all in punctuation; the\n#     option body is just nested key/value pairs that tokenize\n#     as ident + `=` + value.\n#   - Numeric literal suffixes (`1.5e3`). Same number-scanner\n#     limitation as java.cyml; cosmetic.\n#   - Reserved field tag ranges `reserved 100 to 199;` — the\n#     `reserved` keyword is in the keyword list; `to` is not\n#     (it's an Elixir/SQL keyword but not Protobuf). Adding to\n#     the keyword set if a real corpus needs it.\n\n[grammar]\nname = \"protobuf\"\nextensions = [\".proto\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# Operators in longest-match order. Protobuf has very few:\n# `=` for field-tag assignment, `<` / `>` for map<K,V> /\n# message-set syntax, `[` / `]` for option attachments\n# (handled as punctuation), `.` for fully-qualified names\n# (`google.protobuf.Timestamp`).\noperators = [\n    \"=\", \"+\", \"-\",\n    \"<\", \">\",\n    \"?\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # File-level declarations\n    \"syntax\", \"package\", \"import\", \"option\", \"weak\", \"public\",\n    # Type-system heads\n    \"message\", \"enum\", \"service\", \"rpc\", \"extend\",\n    \"oneof\", \"map\", \"reserved\", \"extensions\",\n    \"stream\", \"returns\",\n    # Field labels (proto2 explicit; proto3 keeps a few)\n    \"optional\", \"required\", \"repeated\",\n    \"group\",\n    # Primitive types\n    \"double\", \"float\",\n    \"int32\", \"int64\", \"uint32\", \"uint64\",\n    \"sint32\", \"sint64\", \"fixed32\", \"fixed64\",\n    \"sfixed32\", \"sfixed64\",\n    \"bool\", \"string\", \"bytes\",\n    # Reserved literals\n    \"true\", \"false\",\n    # Misc\n    \"to\", \"max\",\n]\n";
}

fn _grammar_blob_python() {
    return "# python — Python tokenizer grammar\n#\n# Rule scheme per ADR 0005.\n#\n# Corpus: tests/corpus/python.py (vidya-backed).\n#\n# Scope note on indent / dedent:\n#   Python's block structure is defined by indentation, and a\n#   semantic tokenizer would emit INDENT / DEDENT tokens at line\n#   starts. vyakarana's palette has no such kinds and the scanner\n#   has no line-start state — indentation tokenizes as plain\n#   `whitespace`. This is correct at the byte / coverage level;\n#   zero error tokens and coverage invariant both hold on the\n#   vidya sample. A Python parser consuming our tokens would need\n#   to post-process whitespace runs at line starts. A future ADR\n#   could add INDENT / DEDENT rule types if a consumer demands it.\n#\n# Known cosmetic gaps (not errors):\n#   - F-string prefix: `f\"...\"` tokenizes as ident(f) + string(\"...\"),\n#     not a unified fstring token. Same pattern for r/b/rb/fr prefixes.\n#   - F-string interpolation `{expr}` stays inside the string span\n#     (not re-tokenized), consistent with ADR 0003.\n\n[grammar]\nname = \"python\"\nextensions = [\".py\"]\n\n[defaults]\nshebang = true\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# Operators in longest-match order. Python-specific: `:=` (walrus),\n# `//` (floor division — MUST be in operators, not line comment,\n# because Python uses `#` for line comments), `**` (power and\n# kwargs), `@` (decorator), `->` (return annotation).\noperators = [\n    \"//=\", \"**=\",\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \":=\", \"->\", \"//\", \"**\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"@\", \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# Line comments. Python is `#` just like shell / cyrius / toml /\n# yaml. Unlike C / Rust / JS, `//` is NOT a comment — it's floor\n# division (see operators above).\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n# Triple-quoted strings MUST come before single-quoted pair rules,\n# so the 3-byte start marker wins the longest match.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\\\"\\\"\"\nend = \"\\\"\\\"\\\"\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'''\"\nend = \"'''\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Literals\n    \"True\", \"False\", \"None\",\n    # Boolean / logical\n    \"and\", \"or\", \"not\",\n    # Membership / identity\n    \"in\", \"is\",\n    # Control flow\n    \"if\", \"elif\", \"else\",\n    \"while\", \"for\", \"break\", \"continue\",\n    \"pass\", \"return\", \"yield\",\n    \"try\", \"except\", \"finally\", \"raise\",\n    \"with\", \"as\",\n    # Declarations\n    \"def\", \"class\", \"lambda\",\n    \"global\", \"nonlocal\",\n    # Imports\n    \"import\", \"from\",\n    # Async\n    \"async\", \"await\",\n    # Misc reserved\n    \"del\", \"assert\",\n    # Soft keywords (3.10+ pattern matching — not strictly reserved\n    # but conventionally used as keywords in match/case context)\n    \"match\", \"case\",\n]\n";
}

fn _grammar_blob_ruby() {
    return "# ruby — Ruby tokenizer grammar\n#\n# Rule scheme per ADR 0005. Ruby is its own thing at the token\n# level — `#` line comments, `=begin`/`=end` block comments,\n# symbols (`:foo`), instance/class variables (`@foo`, `@@foo`),\n# globals (`$foo`), `?` as both ternary and a unary operator-\n# turning-into-method-name, and a long list of keywords.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Ruby reference sample yet. The local\n# `tests/corpus/concept.rb` mirrors the lexer+parser theme used\n# elsewhere, exercising `module`/`class`/`def`/`end` blocks,\n# `Struct.new`, symbols, `=begin`/`=end` block comments, regex\n# `/\\s/`, string interpolation `#{…}`, and the Ruby keyword set.\n# Replace with a vidya snapshot when one ships.\n#\n# Sigil handling:\n#   - `@` and `$` in `ident_start` so `@source`, `@@count`,\n#     `$PROGRAM_NAME`, etc. tokenize as a single ident. Same call\n#     as PHP for `$` and Java for `@`.\n#   - `:` for symbols stays as punctuation; `:foo` tokenizes as\n#     `:` + ident (theme reassembles).\n#\n# Block comments `=begin` / `=end`:\n# Pair rule below. **Caveat: Ruby requires these to be in\n# column 0 to be valid; the scanner has no column-state, so a\n# `=begin` mid-line would be matched too.** The vidya / stand-in\n# corpora always put them at column 0; if a real corpus surfaces\n# the mid-line ambiguity, this becomes a future ADR (line-start-\n# only pair rule).\n#\n# Known gaps (not triggered by the stand-in):\n#   - Heredocs (`<<~END … END`). Variable-length terminator.\n#     Same scanner-shape gap as PHP heredocs and Lua `[==[…]==]`\n#     — track collectively.\n#   - Regex literals `/.../` are context-sensitive (vs. division)\n#     in Ruby. Today `/` is the slash operator; a regex inside\n#     a method call like `=~ /foo/` tokenizes as op + ident +\n#     op, which is a known gap. JS/TS share this gap; reopens if\n#     a real corpus needs distinguishing.\n#   - `?C` character literal (deprecated post-1.9 but still\n#     valid). Tokenizes as `?` op + `C` ident. Cosmetic.\n#   - Numeric underscores (`1_000_000`) and `_` as ignored\n#     argument: tokenize as ident; cosmetic.\n\n[grammar]\nname = \"ruby\"\nextensions = [\".rb\"]\n\n[defaults]\nshebang = true\nwhitespace = true\n\n# `@` for instance / class vars, `$` for globals.\nident_start = \"A-Za-z_@$\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Ruby-specific: `**=` (power\n# assign), `<=>` (spaceship), `===` (case equality), `=~` /\n# `!~` (regex match / no-match), `..` / `...` (range / exclusive\n# range), `&.` (safe navigation, Ruby 2.3+), `=>` (hash rocket /\n# rescue), `->` (lambda), `**` (power / double-splat), plus the\n# standard C-family set.\noperators = [\n    \"<<=\", \">>=\", \"<=>\",\n    \"**=\", \"===\",\n    \"...\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"=~\", \"!~\",\n    \"->\", \"=>\", \"..\", \"**\",\n    \"&.\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\", \"||=\", \"&&=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n    # `\\` shows up as line-continuation and inside regex bodies\n    # (`/\\s/`). The string-pair `escape = \"\\\\\"` consumes `\\<C>`\n    # inside string spans; outside strings, treat as operator\n    # so `=~ /\\s/` doesn't fall to the error fallback.\n    \"\\\\\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `=begin` / `=end` block comments. Caveat: Ruby requires them\n# at column 0 (see grammar header). The pair rule matches them\n# anywhere; corpora that respect the spec tokenize correctly.\n# Ordered before `#` line comments so a `#` inside a `=begin`\n# block is consumed as comment text.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"=begin\"\nend = \"=end\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Definition\n    \"module\", \"class\", \"def\", \"end\", \"begin\",\n    # Control flow\n    \"if\", \"elsif\", \"else\", \"unless\", \"case\", \"when\", \"then\",\n    \"while\", \"until\", \"for\", \"in\", \"do\",\n    \"break\", \"next\", \"redo\", \"retry\", \"return\",\n    \"yield\",\n    # Exception handling\n    \"rescue\", \"ensure\", \"raise\", \"throw\", \"catch\",\n    # Object-oriented\n    \"self\", \"super\",\n    # Logical (Ruby spells some operators as words)\n    \"and\", \"or\", \"not\",\n    # Reserved literals\n    \"true\", \"false\", \"nil\",\n    # Definition / introspection\n    \"defined?\",\n    # Loading\n    \"require\", \"require_relative\", \"load\", \"autoload\",\n    # Misc\n    \"alias\", \"undef\", \"lambda\", \"proc\",\n    \"__method__\", \"__FILE__\", \"__LINE__\", \"__dir__\", \"__ENCODING__\",\n    \"BEGIN\", \"END\",\n]\n";
}

fn _grammar_blob_rust() {
    return "# rust — Rust tokenizer grammar\n#\n# Rule scheme per ADR 0005. Rust uses `//` line comments (not `#`),\n# which frees `#` to tokenize as an operator for attribute prefix\n# (`#[derive(...)]` → `#` op, `[` punct, ident, `]` punct).\n#\n# Scope: covers what vidya's content/lexing_and_parsing/rust.rs\n# exercises.\n#\n# Macro metavariables: `$` is in `ident_start` so `$expr`, `$tok`,\n# `$crate`, etc. tokenize as a single `ident`. The bare `$` that\n# leads `$( ... )*` repetition tokenizes as a length-1 ident. See\n# [ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md).\n#\n# Known gaps for future ADRs (not triggered by the vidya sample):\n#   - Block comments `/* ... */` (Rust's are nestable).\n#   - Raw strings `r\"...\"`, `r#\"...\"#`, `r##\"...\"##`, etc.\n#   - Byte strings `b\"...\"`, byte chars `b'x'`.\n#   - Char literals `'x'`, `'+'`, etc. Currently `'` is a 1-byte\n#     operator; a char literal splits into three tokens (op + body\n#     + op) instead of a single `string` token. The vidya sample has\n#     16 char literals + 1 lifetime (`'_`) — all tokenize correctly\n#     in the coverage-and-no-errors sense, but a theme can't\n#     distinguish `'+'` from three standalone `'+` `'` operators.\n#     Distinguishing char-literals from lifetimes cleanly requires\n#     2-3 char lookahead; a `char_literal = true` default + lookahead\n#     in the scanner is the likely fix, promoted to an ADR once C\n#     shows the same pattern.\n#   - Numeric literal suffixes (`42_u32`, `3.14_f64`) and floats.\n#     Integer literals with `_` separators tokenize as ident inside\n#     a number... actually no: ident_start excludes digits, so `42u32`\n#     would scan as number(42) + ident(u32). Good enough for now.\n\n[grammar]\nname = \"rust\"\nextensions = [\".rs\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_$\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# `'C'` / `'\\C'` / `'\\xHH'` (and 2/3/4-byte UTF-8 bodies) tokenize\n# as a single TK_STRING. Lifetimes like `'a` / `'static` / `'_`\n# still work — they fall through this step (no closing quote at\n# the right offset) and tokenize as `'` operator + ident. See\n# ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. Rust-specific: `=>` (match arm),\n# `->` (return-type arrow), `::` (path separator), `..=` and `..`\n# (range), `?` (try), `&&`/`||` (logical), bit shifts, plus the\n# standard set. `'` is an operator so lifetimes like `'_` tokenize\n# as operator + ident (see grammar header).\noperators = [\n    \"..=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"=>\", \"->\", \"::\", \"..\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"'\",\n    \"#\",\n]\n\n# Punctuation, longest-match.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"fn\", \"let\", \"mut\", \"const\", \"static\",\n    \"if\", \"else\", \"while\", \"for\", \"loop\", \"match\",\n    \"return\", \"break\", \"continue\",\n    \"use\", \"mod\", \"pub\",\n    \"struct\", \"enum\", \"trait\", \"impl\",\n    \"as\", \"in\", \"where\",\n    \"self\", \"Self\", \"super\", \"crate\",\n    \"async\", \"await\", \"move\",\n    \"dyn\", \"ref\", \"type\", \"extern\", \"unsafe\",\n    \"true\", \"false\",\n]\n";
}

fn _grammar_blob_scss() {
    return "# scss — SCSS / Sass tokenizer grammar\n#\n# Rule scheme per ADR 0005. SCSS is a strict superset of CSS:\n# everything css.cyml does, plus four additions:\n#   - `//` line comments (CSS itself has only `/* */`).\n#   - `$variable` syntax — `$` in `ident_start`.\n#   - More at-rules (`@mixin`, `@include`, `@function`,\n#     `@return`, `@if`, `@else`, `@each`, `@for`, `@while`,\n#     `@use`, `@forward`, `@extend`, `@error`, `@warn`,\n#     `@debug`, `@content`).\n#   - String interpolation `#{…}` stays inside the string-pair\n#     span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an SCSS reference sample yet. The local\n# `tests/corpus/concept.scss` exercises variables, mixins,\n# functions, the `&` parent selector, nested rules, `@each`\n# loops with interpolation, and the modern `@use` / `@forward`\n# module system. Replace with a vidya snapshot when one\n# ships.\n#\n# LESS deferred. LESS uses `@variable` (collides with CSS\n# at-rules at the token level) and has declining adoption;\n# most LESS files tokenize OK with the css.cyml grammar\n# anyway. If a real LESS corpus surfaces, fork from this\n# grammar with `@`-as-variable and adjusted at-rule keywords.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Float numbers (same gap as css.cyml).\n#   - Sass placeholder selectors `%placeholder`. The `%`\n#     would need to be in `ident_start` or operators. Cosmetic;\n#     not in the stand-in.\n\n[grammar]\nname = \"scss\"\nextensions = [\".scss\", \".sass\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for at-rules, `#` for ids / hex colors / interpolation\n# (`#{…}`), `$` for variables, `-` for custom properties.\nident_start = \"A-Za-z_@#$-\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\noperators = [\n    \"^=\", \"$=\", \"*=\", \"~=\", \"|=\",\n    \"::\",\n    \"+\", \"-\", \"*\", \"/\",\n    \"<\", \">\",\n    \"&\", \"|\", \"~\",\n    \"!\", \"?\",\n    \"=\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# `//` line comment (SCSS-only, NOT in CSS proper).\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n# CSS at-rules + SCSS additions. The at-rule (`@whatever`)\n# tokenizes as one ident via `ident_start` containing `@`,\n# then this list promotes the known names to `TK_KEYWORD`.\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # CSS at-rules (shared with css.cyml)\n    \"@charset\", \"@import\", \"@namespace\",\n    \"@media\", \"@supports\", \"@document\", \"@page\",\n    \"@font-face\", \"@keyframes\", \"@viewport\",\n    \"@counter-style\", \"@font-feature-values\", \"@property\",\n    \"@layer\", \"@container\", \"@scope\", \"@starting-style\",\n    # SCSS / Sass-specific at-rules\n    \"@mixin\", \"@include\", \"@function\", \"@return\",\n    \"@if\", \"@else\", \"@each\", \"@for\", \"@while\",\n    \"@use\", \"@forward\", \"@extend\",\n    \"@error\", \"@warn\", \"@debug\",\n    \"@content\", \"@at-root\",\n    # Common values\n    \"from\", \"to\",\n    \"important\", \"inherit\", \"initial\", \"unset\", \"revert\",\n    # SCSS pseudo-keywords (control-flow words)\n    \"in\", \"through\", \"not\", \"and\", \"or\",\n    \"true\", \"false\", \"null\",\n]\n";
}

fn _grammar_blob_shell() {
    return "# shell — bash / sh / zsh / dash tokenizer grammar\n#\n# Rule scheme per ADR 0005: narrow [[rules]] (line / pair / words)\n# plus a [defaults] table that parameterizes the built-in scanner\n# (shebang / ident / number / operator / punctuation / whitespace /\n# special-var).\n#\n# Regression bar: tokens produced from this file must be byte-\n# identical to the hand-coded tokenize_shell in src/grammars/shell.cyr\n# on tests/corpus/shell.sh. The diff check lives in scripts/smoke.sh.\n\n[grammar]\nname = \"shell\"\nextensions = [\".sh\", \".bash\"]\nshebangs = [\"sh\", \"bash\", \"zsh\", \"dash\"]\n\n[defaults]\n# Emit `#!` on line 0, column 0 as TK_PREPROCESSOR (to EOL).\nshebang = true\n\n# Whitespace runs (space, tab, \\n, \\r) emit as TK_WHITESPACE.\nwhitespace = true\n\n# Identifiers: [A-Za-z_] followed by [A-Za-z0-9_]*.\n# The char-class syntax is a small subset — ranges A-Z, a-z, 0-9 and\n# individual characters, joined. Runs are emitted as TK_IDENT unless\n# they match a keyword (see the [[rules]] match = \"words\" below),\n# in which case TK_KEYWORD.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\n# Numbers: decimal, plus 0x / 0b / 0o prefixes.\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\n# `$X` where X is #/?/@/!/*/$/- emits as a 2-char TK_OPERATOR so\n# that e.g. `$#` doesn't start a comment. Bare `$` is a 1-char op.\nspecial_vars = true\n\n# Operators in longest-match order. The scanner tries them in this\n# sequence for each position; first match wins.\noperators = [\n    \"<<<\",\n    \"&&\", \"||\", \"==\", \"!=\", \"=~\", \"<=\", \">=\", \">>\", \"<<\", \"<>\",\n    \"++\", \"--\", \"+=\", \"-=\", \"*=\", \"/=\", \"%=\", \"->\",\n    \"=\", \"|\", \"&\", \"<\", \">\", \"+\", \"-\", \"*\", \"/\", \"%\", \"!\", \"~\",\n    \"?\", \"@\", \"^\", \"\\\\\",\n]\n\n# Punctuation, longest-match order.\npunctuation = [\n    \"[[\", \"]]\", \"((\", \"))\", \";;\",\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\", \";\", \":\", \",\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n# Rule priority (applied before defaults.ident/number/operator/etc.):\n#   1. line-comment rule\n#   2. pair rules (strings)\n#   3. words rules (keyword list — applied over an identifier run)\n# See ADR 0005 for the full scanner dispatch order.\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"if\", \"then\", \"else\", \"elif\", \"fi\",\n    \"for\", \"while\", \"until\", \"do\", \"done\",\n    \"case\", \"esac\", \"in\",\n    \"function\", \"return\",\n    \"break\", \"continue\",\n    \"select\", \"time\",\n]\n";
}

fn _grammar_blob_sql() {
    return "# sql — SQL tokenizer grammar (dialect-neutral)\n#\n# Rule scheme per ADR 0005. SQL is the first bundled grammar to\n# enable `case_insensitive_keywords = true` (see\n# [ADR 0011](../docs/adr/0011-case-insensitive-keywords-default.md)).\n# `SELECT`, `select`, `Select`, `sElEcT` all match the canonical\n# (upper-case) keyword list — same byte-equality cost as the\n# other 25 grammars when the flag is on, just with an A–Z to a–z\n# fold on each comparison.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a SQL reference sample yet. The local\n# `tests/corpus/concept.sql` is dialect-neutral (ANSI SQL:1992\n# core surface) — no PostgreSQL/MySQL/SQLite-specific extensions\n# beyond what's necessary to exercise CTEs, window functions,\n# CASE expressions, and the case-insensitive keyword path.\n#\n# Dialect notes (not exhaustive):\n#   - PostgreSQL adds `RETURNING`, `LATERAL`, dollar-quoted\n#     strings (`$tag$ … $tag$`), and a wider type vocabulary.\n#     Could be a fork (`grammars/postgresql.cyml`) if real PG\n#     corpora surface enough delta.\n#   - MySQL accepts backtick-quoted identifiers (`` `id` ``)\n#     and `#` line comments alongside `--`. Add to a\n#     `grammars/mysql.cyml` fork if needed.\n#   - SQLite is closest to ANSI but adds `PRAGMA` directives;\n#     fork as needed.\n#   - T-SQL has `BEGIN`/`END` blocks and `GO` batch separators\n#     plus `[]`-quoted identifiers; fork as needed.\n#\n# Known gaps (not triggered by the stand-in):\n#   - Dollar-quoted strings (PostgreSQL `$$ … $$`, `$tag$ … $tag$`).\n#     Variable-length-delimiter form — same scanner-shape gap\n#     as Lua's `[==[…]==]`, Ruby/PHP heredocs, Swift raw strings.\n#   - Backtick identifiers (MySQL): not in the ANSI baseline.\n#   - Numeric literal suffixes / scientific notation\n#     (`1.5e3`): same number-scanner limitation as java.cyml.\n\n[grammar]\nname = \"sql\"\nextensions = [\".sql\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\n# ADR 0011: SQL keywords are case-insensitive per spec.\ncase_insensitive_keywords = true\n\n# Operators in longest-match order. SQL-specific: `<>` (not\n# equal, ANSI-preferred over `!=`), `||` (string concat), `::`\n# (PostgreSQL cast), plus the standard comparison and\n# arithmetic set.\noperators = [\n    \"<<=\", \">>=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\", \"<>\",\n    \"::\",\n    \"+=\", \"-=\", \"*=\", \"/=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"@\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"--\"\n\n\n# `/* … */` block comments. Non-nestable in ANSI; same simple\n# greedy match as ADR 0009's C grammar.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n# Single-quoted string literals. SQL escape for embedded quote\n# is doubling (`'it''s'`), not backslash; the pair-rule scanner\n# closes at the first `'`, so `'it''s'` tokenizes as\n# `'it'` + `'s'` (two strings). Cosmetic gap; coverage holds.\n# A future ADR could add a `paired_escape` rule shape for the\n# doubling form.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n# Double-quoted identifiers (ANSI SQL:1992). The body is an\n# identifier per spec, but at the token level we tokenize the\n# whole `\"…\"` span as a `TK_STRING` — themes that want to\n# colour it as ident can do so via token-text inspection.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # DDL\n    \"CREATE\", \"ALTER\", \"DROP\", \"TRUNCATE\", \"RENAME\",\n    \"TABLE\", \"VIEW\", \"INDEX\", \"TRIGGER\", \"FUNCTION\",\n    \"PROCEDURE\", \"DATABASE\", \"SCHEMA\", \"SEQUENCE\",\n    \"DOMAIN\", \"TYPE\",\n    # DML\n    \"SELECT\", \"INSERT\", \"UPDATE\", \"DELETE\", \"MERGE\",\n    \"VALUES\", \"INTO\", \"FROM\", \"WHERE\", \"GROUP\", \"BY\",\n    \"HAVING\", \"ORDER\", \"ASC\", \"DESC\", \"NULLS\", \"FIRST\",\n    \"LAST\", \"LIMIT\", \"OFFSET\", \"FETCH\", \"ROWS\", \"ROW\",\n    \"ONLY\",\n    # Set ops\n    \"UNION\", \"INTERSECT\", \"EXCEPT\", \"ALL\", \"DISTINCT\",\n    # Joins\n    \"JOIN\", \"INNER\", \"LEFT\", \"RIGHT\", \"FULL\", \"OUTER\",\n    \"CROSS\", \"NATURAL\", \"ON\", \"USING\",\n    # CTE / window\n    \"WITH\", \"RECURSIVE\", \"OVER\", \"PARTITION\", \"WINDOW\",\n    \"RANGE\", \"UNBOUNDED\", \"PRECEDING\", \"FOLLOWING\",\n    \"CURRENT\",\n    # Constraints\n    \"PRIMARY\", \"KEY\", \"FOREIGN\", \"REFERENCES\", \"UNIQUE\",\n    \"CHECK\", \"DEFAULT\", \"CONSTRAINT\", \"CASCADE\", \"RESTRICT\",\n    \"NO\", \"ACTION\", \"SET\", \"NULL\", \"MATCH\",\n    # CASE\n    \"CASE\", \"WHEN\", \"THEN\", \"ELSE\", \"END\",\n    # Boolean / set membership\n    \"AND\", \"OR\", \"NOT\", \"IN\", \"EXISTS\", \"BETWEEN\",\n    \"LIKE\", \"ILIKE\", \"IS\", \"ANY\", \"SOME\",\n    # Transactions\n    \"BEGIN\", \"COMMIT\", \"ROLLBACK\", \"SAVEPOINT\",\n    \"TRANSACTION\", \"ISOLATION\", \"LEVEL\", \"READ\", \"WRITE\",\n    \"DEFERRABLE\", \"INITIALLY\", \"DEFERRED\", \"IMMEDIATE\",\n    # Privileges\n    \"GRANT\", \"REVOKE\", \"PRIVILEGES\", \"TO\", \"PUBLIC\",\n    # Expressions\n    \"AS\", \"CAST\", \"COALESCE\", \"NULLIF\", \"GREATEST\", \"LEAST\",\n    # Types (case-insensitive — same path)\n    \"INT\", \"INTEGER\", \"SMALLINT\", \"BIGINT\", \"DECIMAL\",\n    \"NUMERIC\", \"REAL\", \"DOUBLE\", \"PRECISION\", \"FLOAT\",\n    \"BOOLEAN\", \"BIT\", \"BYTE\",\n    \"CHAR\", \"CHARACTER\", \"VARCHAR\", \"TEXT\", \"BLOB\", \"CLOB\",\n    \"DATE\", \"TIME\", \"TIMESTAMP\", \"INTERVAL\",\n    # Boolean / null literals (case-insensitive)\n    \"TRUE\", \"FALSE\", \"UNKNOWN\",\n    # Pseudo-functions / current\n    \"CURRENT_DATE\", \"CURRENT_TIME\", \"CURRENT_TIMESTAMP\",\n    \"CURRENT_USER\", \"SESSION_USER\",\n    # Misc reserved\n    \"IF\", \"ELSEIF\", \"WHILE\", \"LOOP\", \"RETURN\", \"RETURNS\",\n    \"DECLARE\", \"EXECUTE\",\n]\n";
}

fn _grammar_blob_swift() {
    return "# swift — Swift tokenizer grammar\n#\n# Rule scheme per ADR 0005. Close in shape to kotlin.cyml — both\n# are mobile-first JVM-or-LLVM-flavoured languages with\n# expression-oriented control flow, optionals, and string\n# interpolation.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship a Swift reference sample yet. The local\n# `tests/corpus/concept.swift` mirrors the lexer+parser theme used\n# elsewhere, exercising `enum` cases with associated values,\n# `indirect enum`, `final class`, optionals (`peek() ->\n# Character?`), `guard`, multi-line strings (`\"\"\"…\"\"\"`), and the\n# Swift keyword set.\n#\n# Multi-line strings: `\"\"\"…\"\"\"` pair rule is declared **before**\n# the regular `\"…\"` rule so the longer prefix wins (per\n# [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md) for\n# TOML).\n#\n# Known gaps (not triggered by the stand-in):\n#   - String interpolation `\\(expr)` stays inside the string-pair\n#     span per [ADR 0003](../docs/adr/0003-string-expansion-not-retokenized.md).\n#     Theme can post-process.\n#   - Raw strings `#\"…\"#`, `##\"…\"##` (variable-length delimiter).\n#     Same scanner-shape gap as Lua's `[==[…]==]`, Ruby's\n#     heredocs, PHP's heredocs — track collectively.\n#   - Nestable block comments (Swift's `/* */` is technically\n#     nestable per the spec; the pair rule closes at the first\n#     `*/`). Same gap as Rust.\n#   - Attribute syntax (`@available`, `@objc`). `@` is in\n#     `ident_start` so `@available` tokenizes as one ident.\n\n[grammar]\nname = \"swift\"\nextensions = [\".swift\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` for attributes (`@available`, `@objc`, `@MainActor`).\n# `$` for compiler-generated names (`$0`, `$1`, etc. — closure\n# shorthand parameters).\nident_start = \"A-Za-z_$@\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = true\n\n# Operators in longest-match order. Swift-specific: `..<` (range\n# excluding upper bound), `...` (closed range), `??` (nil-\n# coalesce), `?.` (optional chain), `->` (return-type arrow),\n# `&+` / `&-` / `&*` (overflow-checked arithmetic), `===` / `!==`\n# (identity), plus the standard C-family set.\noperators = [\n    \"===\", \"!==\",\n    \"<<=\", \">>=\",\n    \"..<\", \"...\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"->\", \"??\", \"?.\",\n    \"&+\", \"&-\", \"&*\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"++\", \"--\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\",\n]\n\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"/*\"\nend = \"*/\"\n\n\n# Multi-line string `\"\"\"…\"\"\"`. Declared BEFORE the single-quoted\n# rule so the longer prefix wins.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\\\"\\\"\"\nend = \"\\\"\\\"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Module / imports\n    \"import\", \"module\",\n    # Type-declaration heads\n    \"class\", \"struct\", \"enum\", \"protocol\", \"extension\",\n    \"actor\", \"associatedtype\", \"typealias\",\n    \"indirect\",\n    # Modifiers / visibility\n    \"public\", \"private\", \"fileprivate\", \"internal\",\n    \"open\", \"final\", \"static\", \"lazy\", \"weak\", \"unowned\",\n    \"mutating\", \"nonmutating\", \"convenience\", \"required\",\n    \"override\", \"dynamic\", \"infix\", \"prefix\", \"postfix\",\n    # Declaration heads\n    \"func\", \"let\", \"var\", \"init\", \"deinit\", \"subscript\",\n    \"operator\",\n    # Control flow\n    \"if\", \"else\", \"guard\", \"switch\", \"case\", \"default\",\n    \"while\", \"repeat\", \"for\", \"in\",\n    \"break\", \"continue\", \"return\", \"fallthrough\", \"yield\",\n    \"throw\", \"throws\", \"rethrows\", \"try\", \"do\", \"catch\",\n    \"defer\",\n    # Async / await\n    \"async\", \"await\",\n    # Object / value\n    \"self\", \"Self\", \"super\", \"is\", \"as\", \"where\",\n    # Reserved literals\n    \"true\", \"false\", \"nil\",\n    # Type / generics\n    \"any\", \"some\", \"Any\", \"Type\",\n    \"inout\",\n    # Misc\n    \"import\", \"associatedtype\",\n]\n";
}

fn _grammar_blob_toml() {
    return "# toml — TOML tokenizer grammar\n#\n# Rule scheme per ADR 0005: narrow [[rules]] + configured default\n# scanner. TOML is the simplest possible test for M3's \"new grammar\n# = new .cyml file\" promise — structurally close to our own grammar\n# file format.\n#\n# Scope: keys, strings (\"...\" / '...' with escape-in-double-only),\n# line comments, decimal/hex/oct/bin numbers, `=` / `.` operators,\n# `[...]` / `[[...]]` / `{...}` / `,` punctuation, true/false/inf/nan\n# keywords.\n#\n# Multi-line strings: vidya's `concept.toml` files use `content =\n# '''…'''` for embedded prose blocks, so the triple-quoted forms\n# are scoped IN. `\"\"\"…\"\"\"` (basic, escape-aware) and `'''…'''`\n# (literal, no escapes) are ordered before the single-quoted rules\n# below — the pair-matcher takes the first rule whose start string\n# matches, so the longer prefix has to come first. See\n# [ADR 0008](../docs/adr/0008-toml-triple-quoted-strings.md).\n#\n# Out of scope (still no corpus):\n#   - Float literals (`3.14`)\n#   - Date/datetime literals (`1979-05-27T07:32:00Z`)\n# Both remain ADR candidates if a future corpus needs them.\n\n[grammar]\nname = \"toml\"\nextensions = [\".toml\"]\n\n[defaults]\n# No shebang; TOML isn't an executable format.\nshebang = false\n\n# Whitespace runs (space, tab, \\n, \\r) emit as TK_WHITESPACE.\nwhitespace = true\n\n# Bare keys: letters/underscore to start, letters/digits/underscore/\n# hyphen to continue. Putting `-` in ident_cont but not ident_start\n# lets `foo-bar` be one ident while `-42` still tokenizes as\n# `operator(-) + number(42)`.\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\n# No shell-style $X variable syntax.\nspecial_vars = false\n\n# TOML has only a few structural operators. `=` is assignment,\n# `.` separates dotted keys (pkg.name = 1), `+` and `-` prefix signed\n# numbers (`-42`, `+inf`). Without `+`/`-` here, signed number\n# literals fall through to TK_ERROR.\noperators = [\n    \"=\",\n    \".\",\n    \"+\", \"-\",\n]\n\n# Punctuation, longest-match order. `[[` / `]]` for array-of-tables;\n# `[` / `]` for single tables; `{` / `}` / `,` for inline tables.\npunctuation = [\n    \"[[\", \"]]\",\n    \"[\", \"]\", \"{\", \"}\", \",\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\\\"\\\"\"\nend = \"\\\"\\\"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'''\"\nend = \"'''\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"true\", \"false\", \"inf\", \"nan\",\n]\n";
}

fn _grammar_blob_typescript() {
    return "# typescript — TypeScript tokenizer grammar\n#\n# Rule scheme per ADR 0005. TypeScript is JavaScript syntax plus a\n# type-annotation layer; at the token level they're near-identical\n# (see also grammars/javascript.cyml — same defaults, smaller\n# keyword list).\n#\n# Corpus: tests/corpus/typescript.ts (vidya-backed).\n#\n# Known gaps for future ADRs (not all triggered by the vidya sample):\n#   - Template literal interpolation `${expr}`. The whole `` `...` ``\n#     span is one `string` token; the interpolation payload is\n#     inside that span and not re-tokenized. Same approach as ADR\n#     0003 for shell `\"$(...)\"`.\n#   - Regex literals `/pat/flags`. Context-sensitive vs. division.\n#     The vidya sample has zero regex; not blocking.\n#   - JSX / TSX elements (`.tsx`). Not included in extension mapping;\n#     a JSX rule set is a future grammar, not this one.\n\n[grammar]\nname = \"typescript\"\nextensions = [\".ts\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `$` is a valid identifier character (jQuery-style `$` binding,\n# `$foo` for compiler-generated names, etc.).\nident_start = \"A-Za-z_$\"\nident_cont  = \"A-Za-z0-9_$\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# Operators in longest-match order. TS-specific: `=>` (arrow\n# functions), `??` (nullish coalesce), `?.` (optional chain),\n# `...` (spread/rest), `**` (exponent), plus the standard JS set.\noperators = [\n    \"===\", \"!==\", \"...\", \"**=\",\n    \"&&=\", \"||=\", \"??=\",\n    \"**\", \"??\", \"?.\",\n    \"<<=\", \">>=\", \">>>\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"++\", \"--\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"=>\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"\\\\\",\n]\n\n# Punctuation.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n# Template literals `` `...` ``. Backslash-aware.\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"`\"\nend = \"`\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Declarations\n    \"let\", \"const\", \"var\", \"function\", \"class\",\n    \"interface\", \"type\", \"enum\", \"namespace\",\n    # Module\n    \"import\", \"export\", \"from\", \"as\",\n    # Control flow\n    \"if\", \"else\", \"while\", \"for\", \"do\",\n    \"switch\", \"case\", \"default\", \"break\", \"continue\",\n    \"return\", \"throw\", \"try\", \"catch\", \"finally\",\n    # OO / inheritance\n    \"extends\", \"implements\",\n    \"new\", \"this\", \"super\",\n    # Modifiers\n    \"public\", \"private\", \"protected\",\n    \"static\", \"readonly\", \"abstract\", \"declare\",\n    \"async\", \"await\", \"yield\",\n    # Operator-keywords\n    \"typeof\", \"instanceof\", \"in\", \"of\", \"void\", \"delete\",\n    # Literals\n    \"true\", \"false\", \"null\", \"undefined\",\n]\n";
}

fn _grammar_blob_xml() {
    return "# xml — XML tokenizer grammar\n#\n# Rule scheme per ADR 0005. XML at the token level is a\n# stricter cousin of HTML, with three additional shapes:\n#   - `<?xml … ?>` and other processing instructions (`<?…?>`).\n#   - `<![CDATA[ … ]]>` data sections — body is uninterpreted.\n#   - `<!DOCTYPE …>` declarations.\n#\n# The pair-rule scanner handles each via a `match = \"pair\"`\n# entry. Element tags, attributes, entity references, and\n# strings are all the same shape as html.cyml.\n#\n# Stand-in corpus per [ADR 0006](../docs/adr/0006-standin-corpus-policy.md):\n# vidya doesn't ship an XML reference sample yet. The local\n# `tests/corpus/concept.xml` exercises the prolog, namespaces\n# (with `:` separator and `xmlns:` attribute prefix), CDATA\n# sections, processing instructions, self-closing elements,\n# and entity references. Replace with a vidya snapshot when\n# one ships.\n#\n# Namespace separator `:`: tokenizes as punctuation. `xmlns:meta`\n# becomes `xmlns` + `:` + `meta`. Coverage holds; theme can\n# re-pair if needed.\n#\n# Known gaps (not triggered by the stand-in):\n#   - DTDs (`<!ELEMENT …>`, `<!ATTLIST …>`). Rare in modern\n#     XML; would need a few more pair rules. Defer.\n#   - XML Schema / XSLT specific keywords. The grammar treats\n#     them as plain idents. Themes can secondary-palette by\n#     token text.\n\n[grammar]\nname = \"xml\"\nextensions = [\".xml\", \".xsl\", \".xsd\", \".svg\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `-` and `:` permitted in identifiers. `:` is the namespace\n# separator (`xmlns:meta`); putting it in `ident_cont` would\n# coalesce `xmlns:meta` into one ident, which is fine for\n# tokenization but loses the namespace boundary for themes.\n# Keeping `:` as punctuation; `-` in `ident_cont` for the\n# common attribute / element naming style (e.g.\n# `<some-element>`, `data-x` attribute analog).\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = false\nnumber_0b      = false\nnumber_0o      = false\n\nspecial_vars = false\nunicode_ident = true\nchar_literal  = false\n\noperators = [\n    \"<\", \">\", \"=\", \"/\",\n    \"&\", \"!\", \"?\",\n    \"#\",\n    # `-` shows up inside element/attribute text (dates,\n    # ISO-8601 timestamps `2026-05-08T09:00:00Z`, hyphenated\n    # IDs). It IS in `ident_cont` so mid-ident hyphens stay\n    # part of the ident; bare `-` between numbers falls\n    # through here.\n    \"-\",\n]\n\npunctuation = [\n    \"(\", \")\", \"[\", \"]\", \"{\", \"}\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n# Comments. 4-byte / 3-byte pair, same shape as HTML.\n[[rules]]\nkind = \"comment\"\nmatch = \"pair\"\nstart = \"<!--\"\nend = \"-->\"\n\n\n# CDATA sections — body is uninterpreted (no tag parsing, no\n# entity references). Standard XML literal-text shape. The\n# closing token is `]]>` (3 bytes).\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"<![CDATA[\"\nend = \"]]>\"\n\n\n# Processing instructions (`<?xml …?>`, `<?xml-stylesheet …?>`,\n# user-defined PIs). Body is also uninterpreted at this layer.\n[[rules]]\nkind = \"preprocessor\"\nmatch = \"pair\"\nstart = \"<?\"\nend = \"?>\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n";
}

fn _grammar_blob_yaml() {
    return "# yaml — YAML tokenizer grammar\n#\n# Rule scheme per ADR 0005. YAML is like TOML with a different\n# key-value separator (`:` instead of `=`) and a prefix-sigil list\n# style (`-`, `&`, `*`, `!`).\n#\n# Corpus: tests/corpus/concept.yaml is a hand-rolled stand-in\n# (see ADR 0006 — vidya doesn't yet ship a YAML reference sample).\n#\n# Scope: block and flow style for key/list/map, quoted and plain\n# scalars, anchors and aliases, basic tag markers.\n#\n# Out of scope (first pass — ADR-candidates when needed):\n#   - Literal `|` and folded `>` multi-line block scalars. The\n#     grammar tokenizes `|` / `>` as operators, then the indented\n#     content lines tokenize as ordinary plain scalars / idents.\n#     Semantically it's one big scalar; we fragment it — coverage\n#     invariant still holds, no errors.\n#   - Document separators `---` / `...`. Our scanner sees `---` as\n#     operator + operator + operator (three dashes). Fine for\n#     coverage; a theme can't distinguish doc-break from three\n#     minus signs.\n#   - Tags `!!str` / `!foo`. Emitted as operator(!) + operator(!) +\n#     ident, or operator(!) + ident.\n#   - Floats (`3.14`) split into number + . + number.\n\n[grammar]\nname = \"yaml\"\nextensions = [\".yaml\", \".yml\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# YAML plain scalars look like bare words. Ident_cont includes `-`\n# so `my-key` is one token (common YAML convention).\nident_start = \"A-Za-z_\"\nident_cont  = \"A-Za-z0-9_-\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# YAML sigils:\n#   `&name` anchor, `*name` alias, `-` list-item, `?` explicit key,\n#   `!` tag marker, `|` literal block scalar, `>` folded block scalar,\n#   `<<` merge key.\n# Also the long tail of punctuation that plain scalars may contain —\n# YAML accepts most ASCII inside unquoted values, so tokenizing them\n# as operator/punctuation (rather than hitting TK_ERROR) keeps the\n# grammar permissive.\noperators = [\n    \"<<\",\n    \"&\", \"*\", \"-\", \"+\", \"?\", \"!\", \"|\", \"<\", \">\",\n    \"=\", \"/\", \"%\", \"@\", \"~\", \"^\",\n]\n\n# YAML's structural punctuation. Flow style mirrors JSON; the rest\n# are characters common in unquoted plain-scalar text.\npunctuation = [\n    \"[\", \"]\", \"{\", \"}\", \"(\", \")\",\n    \",\", \":\", \";\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"#\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"'\"\nend = \"'\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    \"true\", \"false\", \"null\", \"yes\", \"no\", \"on\", \"off\",\n]\n";
}

fn _grammar_blob_zig() {
    return "# zig — Zig tokenizer grammar\n#\n# Rule scheme per ADR 0005. Close in shape to rust.cyml + go.cyml —\n# C-family operator set with Zig-specific additions.\n#\n# Scope: covers what vidya's content/lexing_and_parsing/zig.zig\n# exercises (line / `///` doc comments, double-quoted strings, the\n# standard operator set, plus a subset of Zig's reserved-word\n# table sufficient for the corpus).\n#\n# Builtins: `@` is in `ident_start` so `@import`, `@as`,\n# `@divTrunc`, `@TypeOf`, etc. tokenize as a single `ident`. The\n# bare `@` doesn't appear standalone in legal Zig — adding it to\n# ident_start is the same pragmatic move as `$` for Rust macros\n# (see ADR 0007).\n#\n# Doc comments: Zig uses `///` for top-level docs and `//!` for\n# container docs. Both start with `//`, so the existing line-comment\n# rule consumes them. Theme renderers wanting to distinguish doc vs\n# regular comments can post-process the comment-token text.\n#\n# Known gaps for future ADRs (not triggered by the vidya sample):\n#   - Char literals `'x'`. Same pattern as C / Rust / Go. The\n#     canonical sample has 13 simple-ASCII char literals (`'+'`,\n#     `'0'`, `' '`, …) and they all tokenize as op + ident/op + op.\n#     Zero `error` kinds; coverage holds. Will close out together\n#     with the C/Rust char-literal ADR.\n#   - Multi-line strings (lines starting with `\\\\`). Not present\n#     in the canonical sample. Distinct from C-style strings; would\n#     need a new line-rule shape that consumes from `\\\\` to end of\n#     line.\n#   - Builtins as a distinct kind. `@import` tokenizes as `ident`,\n#     not `keyword`. Same call as ADR 0004 — themes can apply a\n#     secondary palette via the `@` prefix.\n\n[grammar]\nname = \"zig\"\nextensions = [\".zig\"]\n\n[defaults]\nshebang = false\nwhitespace = true\n\n# `@` is in ident_start (Zig builtins). `_` is the conventional\n# discard / unused-binding name and behaves like an ident.\nident_start = \"A-Za-z_@\"\nident_cont  = \"A-Za-z0-9_\"\n\nnumber_decimal = true\nnumber_0x      = true\nnumber_0b      = true\nnumber_0o      = true\n\nspecial_vars = false\n\n# UTF-8 in `//` comment text → one ident instead of per-byte\n# errors. Same call as ADR 0009.\nunicode_ident = true\n\n# Char literals `'C'` / `'\\C'` tokenize as a single TK_STRING.\n# See ADR 0010.\nchar_literal = true\n\n# Operators in longest-match order. Zig-specific: `=>` (switch\n# arms), `**` (pointer-to-pointer / array repetition), `++`\n# (concatenation), `..` (range), saturating `+|` `-|` `*|`,\n# wrapping `+%` `-%` `*%`, plus the standard C-family comparison /\n# bitwise / assignment set.\noperators = [\n    \"<<=\", \">>=\",\n    \"+%=\", \"-%=\", \"*%=\",\n    \"+|=\", \"-|=\", \"*|=\",\n    \"<<\", \">>\",\n    \"&&\", \"||\",\n    \"==\", \"!=\", \"<=\", \">=\",\n    \"=>\", \"->\",\n    \"++\", \"**\", \"..\",\n    \"+%\", \"-%\", \"*%\",\n    \"+|\", \"-|\", \"*|\",\n    \"+=\", \"-=\", \"*=\", \"/=\", \"%=\",\n    \"&=\", \"|=\", \"^=\",\n    \"=\", \"+\", \"-\", \"*\", \"/\", \"%\",\n    \"!\", \"~\", \"&\", \"|\", \"^\",\n    \"<\", \">\",\n    \"?\", \"'\",\n]\n\n# Punctuation, longest-match.\npunctuation = [\n    \"(\", \")\", \"{\", \"}\", \"[\", \"]\",\n    \";\", \",\", \":\", \".\",\n]\n\n\n# ── Rules ──────────────────────────────────────────────────────────\n\n[[rules]]\nkind = \"comment\"\nmatch = \"line\"\nstart = \"//\"\n\n\n[[rules]]\nkind = \"string\"\nmatch = \"pair\"\nstart = \"\\\"\"\nend = \"\\\"\"\nescape = \"\\\\\"\n\n\n[[rules]]\nkind = \"keyword\"\nmatch = \"words\"\nwords = [\n    # Declarations\n    \"const\", \"var\", \"fn\", \"pub\", \"extern\", \"export\", \"inline\",\n    \"noinline\", \"comptime\", \"threadlocal\", \"packed\",\n    # Control flow\n    \"if\", \"else\", \"switch\", \"while\", \"for\", \"break\", \"continue\",\n    \"return\", \"defer\", \"errdefer\",\n    # Error / optional handling\n    \"try\", \"catch\", \"orelse\", \"error\", \"unreachable\",\n    # Composite types\n    \"struct\", \"union\", \"enum\", \"opaque\",\n    # Async (kept for completeness; pre-0.11 era keywords)\n    \"async\", \"await\", \"suspend\", \"resume\", \"nosuspend\",\n    # Linkage / layout\n    \"linksection\", \"callconv\", \"align\", \"allowzero\", \"volatile\",\n    \"noalias\",\n    # Misc\n    \"test\", \"usingnamespace\", \"asm\",\n    # Boolean / null / undefined literals\n    \"true\", \"false\", \"null\", \"undefined\",\n    # Logical (Zig spells these as words, not symbols)\n    \"and\", \"or\",\n    # Type-flavoured keywords\n    \"anytype\", \"anyframe\",\n]\n";
}

# Returns pointer to the blob's content (cstr) for the given path, or
# 0 if no blob matches. Path is the same string bootstrap_grammars
# passes to grammar_load() — "grammars/<name>.cyml".
fn _grammar_blob_data(path) {
    if (streq(path, "grammars/asm_aarch64.cyml")) { return _grammar_blob_asm_aarch64(); }
    if (streq(path, "grammars/asm_x86_64.cyml")) { return _grammar_blob_asm_x86_64(); }
    if (streq(path, "grammars/c.cyml")) { return _grammar_blob_c(); }
    if (streq(path, "grammars/cpp.cyml")) { return _grammar_blob_cpp(); }
    if (streq(path, "grammars/csharp.cyml")) { return _grammar_blob_csharp(); }
    if (streq(path, "grammars/css.cyml")) { return _grammar_blob_css(); }
    if (streq(path, "grammars/cyml.cyml")) { return _grammar_blob_cyml(); }
    if (streq(path, "grammars/cyrius.cyml")) { return _grammar_blob_cyrius(); }
    if (streq(path, "grammars/dockerfile.cyml")) { return _grammar_blob_dockerfile(); }
    if (streq(path, "grammars/elixir.cyml")) { return _grammar_blob_elixir(); }
    if (streq(path, "grammars/go.cyml")) { return _grammar_blob_go(); }
    if (streq(path, "grammars/graphql.cyml")) { return _grammar_blob_graphql(); }
    if (streq(path, "grammars/haskell.cyml")) { return _grammar_blob_haskell(); }
    if (streq(path, "grammars/html.cyml")) { return _grammar_blob_html(); }
    if (streq(path, "grammars/ini.cyml")) { return _grammar_blob_ini(); }
    if (streq(path, "grammars/java.cyml")) { return _grammar_blob_java(); }
    if (streq(path, "grammars/javascript.cyml")) { return _grammar_blob_javascript(); }
    if (streq(path, "grammars/json.cyml")) { return _grammar_blob_json(); }
    if (streq(path, "grammars/kotlin.cyml")) { return _grammar_blob_kotlin(); }
    if (streq(path, "grammars/llvm_ir.cyml")) { return _grammar_blob_llvm_ir(); }
    if (streq(path, "grammars/lua.cyml")) { return _grammar_blob_lua(); }
    if (streq(path, "grammars/makefile.cyml")) { return _grammar_blob_makefile(); }
    if (streq(path, "grammars/markdown.cyml")) { return _grammar_blob_markdown(); }
    if (streq(path, "grammars/ocaml.cyml")) { return _grammar_blob_ocaml(); }
    if (streq(path, "grammars/php.cyml")) { return _grammar_blob_php(); }
    if (streq(path, "grammars/protobuf.cyml")) { return _grammar_blob_protobuf(); }
    if (streq(path, "grammars/python.cyml")) { return _grammar_blob_python(); }
    if (streq(path, "grammars/ruby.cyml")) { return _grammar_blob_ruby(); }
    if (streq(path, "grammars/rust.cyml")) { return _grammar_blob_rust(); }
    if (streq(path, "grammars/scss.cyml")) { return _grammar_blob_scss(); }
    if (streq(path, "grammars/shell.cyml")) { return _grammar_blob_shell(); }
    if (streq(path, "grammars/sql.cyml")) { return _grammar_blob_sql(); }
    if (streq(path, "grammars/swift.cyml")) { return _grammar_blob_swift(); }
    if (streq(path, "grammars/toml.cyml")) { return _grammar_blob_toml(); }
    if (streq(path, "grammars/typescript.cyml")) { return _grammar_blob_typescript(); }
    if (streq(path, "grammars/xml.cyml")) { return _grammar_blob_xml(); }
    if (streq(path, "grammars/yaml.cyml")) { return _grammar_blob_yaml(); }
    if (streq(path, "grammars/zig.cyml")) { return _grammar_blob_zig(); }
    return 0;
}

# Number of embedded grammars. Mostly a self-test hook — bootstrap
# expects this to match grammars/*.cyml at build time.
fn _grammar_blob_count() {
    return 38;
}

# --- grammar.cyr ---

# vyakarana — grammar record + CYML loader + registry
#
# Loaded grammars drive the data-driven scanner in
# src/grammars/default_scanner.cyr (see ADR 0005). This module owns:
#   - Grammar record layout and accessors
#   - A minimal TOML-ish parser (purpose-built for the grammar files
#     in grammars/*.cyml — not a general CYML/TOML implementation)
#   - A tiny registry so tokenize_source can look up "shell" and
#     find its loaded grammar.
#
# File cap per grammar: 32KB (plenty; shell.cyml is ~2KB).

# grammar_blobs.cyr is generated by scripts/embed-grammars.sh.
# It supplies _grammar_blob_data(path) used in grammar_load below.

var GRAMMAR_FILE_CAP = 32768;

# ── Grammar record ──────────────────────────
# Layout (offsets in bytes):
#    0  name                cstr ptr
#    8  extensions          Vec<cstr>
#   16  shebangs            Vec<cstr>
#   24  shebang_on          i64  (0/1)
#   32  whitespace_on       i64
#   40  ident_start_tbl     ptr to 256-byte char-class lookup
#   48  ident_cont_tbl      ptr to 256-byte char-class lookup
#   56  number_decimal      i64
#   64  number_0x           i64
#   72  number_0b           i64
#   80  number_0o           i64
#   88  special_vars        i64
#   96  operators           Vec<cstr>   longest-first ordering
#  104  punctuation         Vec<cstr>   longest-first ordering
#  112  line_rules          Vec<LineRule>
#  120  pair_rules          Vec<PairRule>
#  128  words_rules         Vec<WordsRule>
#  136  unicode_ident_on    i64  (0/1) — bytes ≥0x80 join ident runs
#  144  char_literal_on     i64  (0/1) — `'C'` / `'\C'` / `'\xHH'` as one TK_STRING
#  152  case_insensitive_kw i64  (0/1) — keyword lookup folds A-Z to a-z
#  160  compose_rules       Vec<ComposeRule> — embedded-grammar routing
#  -----
#  168 bytes total

var GRAMMAR_SIZE = 168;

fn grammar_new() {
    var g = alloc(GRAMMAR_SIZE);
    var i = 0;
    while (i < GRAMMAR_SIZE) {
        store8(g + i, 0);
        i = i + 1;
    }
    store64(g + 8,   vec_new());   # extensions
    store64(g + 16,  vec_new());   # shebangs
    store64(g + 96,  vec_new());   # operators
    store64(g + 104, vec_new());   # punctuation
    store64(g + 112, vec_new());   # line_rules
    store64(g + 120, vec_new());   # pair_rules
    store64(g + 128, vec_new());   # words_rules
    store64(g + 160, vec_new());   # compose_rules
    return g;
}

fn grammar_name(g)           { return load64(g); }
fn grammar_extensions(g)     { return load64(g + 8); }
fn grammar_shebangs(g)       { return load64(g + 16); }
fn grammar_shebang_on(g)     { return load64(g + 24); }
fn grammar_whitespace_on(g)  { return load64(g + 32); }
fn grammar_ident_start(g)    { return load64(g + 40); }
fn grammar_ident_cont(g)     { return load64(g + 48); }
fn grammar_number_decimal(g) { return load64(g + 56); }
fn grammar_number_0x(g)      { return load64(g + 64); }
fn grammar_number_0b(g)      { return load64(g + 72); }
fn grammar_number_0o(g)      { return load64(g + 80); }
fn grammar_special_vars(g)   { return load64(g + 88); }
fn grammar_operators(g)      { return load64(g + 96); }
fn grammar_punctuation(g)    { return load64(g + 104); }
fn grammar_line_rules(g)     { return load64(g + 112); }
fn grammar_pair_rules(g)     { return load64(g + 120); }
fn grammar_words_rules(g)    { return load64(g + 128); }
fn grammar_unicode_ident(g)  { return load64(g + 136); }
fn grammar_char_literal(g)   { return load64(g + 144); }
fn grammar_case_insensitive_kw(g) { return load64(g + 152); }
fn grammar_compose_rules(g)       { return load64(g + 160); }

# ── Rule sub-records ────────────────────────

var LINE_RULE_SIZE = 16;
fn line_rule_new(kind, start) {
    var r = alloc(LINE_RULE_SIZE);
    store64(r,     kind);
    store64(r + 8, start);
    return r;
}
fn line_rule_kind(r)  { return load64(r); }
fn line_rule_start(r) { return load64(r + 8); }

var PAIR_RULE_SIZE = 32;
fn pair_rule_new(kind, start, end, escape_byte) {
    var r = alloc(PAIR_RULE_SIZE);
    store64(r,      kind);
    store64(r + 8,  start);
    store64(r + 16, end);
    store64(r + 24, escape_byte);
    return r;
}
fn pair_rule_kind(r)   { return load64(r); }
fn pair_rule_start(r)  { return load64(r + 8); }
fn pair_rule_end(r)    { return load64(r + 16); }
fn pair_rule_escape(r) { return load64(r + 24); }

var WORDS_RULE_SIZE = 16;
fn words_rule_new(kind, words_vec) {
    var r = alloc(WORDS_RULE_SIZE);
    store64(r,     kind);
    store64(r + 8, words_vec);
    return r;
}
fn words_rule_kind(r)  { return load64(r); }
fn words_rule_words(r) { return load64(r + 8); }

# Compose rule — routes bytes between `start` and `end` markers
# through a different grammar (looked up by name). See ADR 0013.
var COMPOSE_RULE_SIZE = 24;
fn compose_rule_new(start, end, inner_name) {
    var r = alloc(COMPOSE_RULE_SIZE);
    store64(r,      start);
    store64(r + 8,  end);
    store64(r + 16, inner_name);
    return r;
}
fn compose_rule_start(r) { return load64(r); }
fn compose_rule_end(r)   { return load64(r + 8); }
fn compose_rule_inner(r) { return load64(r + 16); }

# ── Char-class lookup tables ────────────────
# A 256-byte table indexed by byte; value is 0 or 1. Built from a
# char-class spec like "A-Za-z_" or "0-9". The spec syntax is a small
# deliberate subset: `X-Y` is a range; any other single char is that
# literal byte; concatenation is disjunction.

fn char_class_new(spec) {
    var tbl = alloc(256);
    var i = 0;
    while (i < 256) { store8(tbl + i, 0); i = i + 1; }
    if (spec == 0) { return tbl; }
    var n = strlen(spec);
    var p = 0;
    while (p < n) {
        var c = load8(spec + p);
        # Range `X-Y`
        if (p + 2 < n) {
            if (load8(spec + p + 1) == 45) {  # `-`
                var lo = c;
                var hi = load8(spec + p + 2);
                var b = lo;
                while (b <= hi) {
                    store8(tbl + b, 1);
                    b = b + 1;
                }
                p = p + 3;
                continue;
            }
        }
        store8(tbl + c, 1);
        p = p + 1;
    }
    return tbl;
}

fn char_class_match(tbl, byte) {
    return load8(tbl + byte);
}

# ── CYML parser ─────────────────────────────
# Grammar files are a deliberately small TOML dialect:
#   - `[section]` header
#   - `[[rules]]` entry marker
#   - `key = value` lines (value is "string", true/false, or ["a","b"])
#   - `#` line comments
#   - arrays may span lines
#
# Whitespace is liberal. Escape sequences inside strings: `\\`, `\"`,
# `\n`, `\t`. That's enough for grammar files; we don't need the
# full TOML escape set.

fn _gp_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

# Skip spaces and tabs (not newlines) at buf[pos].
fn _gp_skip_hspace(buf, len, pos) {
    while (pos < len) {
        var b = load8(buf + pos);
        if (_gp_is_space(b) == 0) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# Skip spaces, tabs, newlines, and `#` line-comments.
fn _gp_skip_ws_and_comments(buf, len, pos) {
    while (pos < len) {
        var b = load8(buf + pos);
        if (_gp_is_space(b) == 1) { pos = pos + 1; continue; }
        if (b == 10) { pos = pos + 1; continue; }
        if (b == 35) {  # `#` comment to EOL
            while (pos < len) {
                if (load8(buf + pos) == 10) { pos = pos + 1; break; }
                pos = pos + 1;
            }
            continue;
        }
        return pos;
    }
    return pos;
}

# Advance past end-of-line (consumes the `\n`).
fn _gp_skip_to_eol(buf, len, pos) {
    while (pos < len) {
        if (load8(buf + pos) == 10) { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}

# Parse a quoted string starting at buf[pos] (first byte must be `"`).
# Writes the resulting cstr to *out_ptr and returns the position just
# past the closing `"`. Handles \\, \", \n, \t escapes.
fn _gp_parse_string(buf, len, pos, out_ptr) {
    if (load8(buf + pos) != 34) { store64(out_ptr, 0); return pos; }
    pos = pos + 1;
    # First pass: compute the decoded length so we can allocate once.
    var p = pos;
    var dlen = 0;
    while (p < len) {
        var b = load8(buf + p);
        if (b == 34) { break; }
        if (b == 92) {   # `\`
            if (p + 1 >= len) { break; }
            p = p + 2;
            dlen = dlen + 1;
        } else {
            p = p + 1;
            dlen = dlen + 1;
        }
    }
    var s = alloc(dlen + 1);
    var q = pos;
    var di = 0;
    while (q < len) {
        var b = load8(buf + q);
        if (b == 34) { q = q + 1; break; }
        if (b == 92) {
            if (q + 1 >= len) { q = len; break; }
            var esc = load8(buf + q + 1);
            var out = esc;
            if (esc == 110) { out = 10; }   # \n
            if (esc == 116) { out = 9; }    # \t
            # \\ and \" pass through as the next byte itself.
            store8(s + di, out);
            di = di + 1;
            q = q + 2;
        } else {
            store8(s + di, b);
            di = di + 1;
            q = q + 1;
        }
    }
    store8(s + di, 0);
    store64(out_ptr, s);
    return q;
}

# Parse an array literal starting at buf[pos] (first byte must be `[`).
# Pushes each element (as a cstr) into out_vec. Returns position past `]`.
fn _gp_parse_string_array(buf, len, pos, out_vec) {
    if (load8(buf + pos) != 91) { return pos; }
    pos = pos + 1;
    while (pos < len) {
        pos = _gp_skip_ws_and_comments(buf, len, pos);
        if (pos >= len) { return pos; }
        var b = load8(buf + pos);
        if (b == 93) { return pos + 1; }    # `]`
        if (b == 44) { pos = pos + 1; continue; }  # `,`
        if (b == 34) {
            var out_slot = alloc(8);
            store64(out_slot, 0);
            pos = _gp_parse_string(buf, len, pos, out_slot);
            var sptr = load64(out_slot);
            if (sptr != 0) { vec_push(out_vec, sptr); }
            continue;
        }
        # Unknown token — advance to avoid infinite loop.
        pos = pos + 1;
    }
    return pos;
}

# Parse a bare word (letters / digits / underscore / hyphen) at buf[pos].
# Returns length.
fn _gp_read_word(buf, len, pos) {
    var p = pos;
    while (p < len) {
        var b = load8(buf + p);
        var ok = 0;
        if ((b >= 48) && (b <= 57))  { ok = 1; }   # 0-9
        if ((b >= 65) && (b <= 90))  { ok = 1; }   # A-Z
        if ((b >= 97) && (b <= 122)) { ok = 1; }   # a-z
        if (b == 95) { ok = 1; }                   # _
        if (b == 45) { ok = 1; }                   # -
        if (ok == 0) { return p - pos; }
        p = p + 1;
    }
    return p - pos;
}

# Parse a bool literal (`true` / `false`) at buf[pos]. Returns 1/0;
# writes the parsed value to *out_val. Returns the advanced position.
fn _gp_parse_bool(buf, len, pos, out_val) {
    if ((pos + 4 <= len) && (memeq(buf + pos, "true", 4) == 1)) {
        store64(out_val, 1);
        return pos + 4;
    }
    if ((pos + 5 <= len) && (memeq(buf + pos, "false", 5) == 1)) {
        store64(out_val, 0);
        return pos + 5;
    }
    store64(out_val, 0);
    return pos;
}

# Streq-for-slice: does the byte span at buf[pos..pos+slen) equal cstr?
fn _gp_slice_eq(buf, pos, slen, cstr) {
    var clen = strlen(cstr);
    if (slen != clen) { return 0; }
    return memeq(buf + pos, cstr, clen);
}

# Apply a key=value pair to the grammar based on (section, key).
# value_start / value_len slice into buf and point at the raw RHS
# (still quoted / bracketed / bare). Returns 0.
fn _gp_apply_kv(g, current_rule, section, buf, len, key_pos, key_len, value_pos) {
    # Normalize section into an i64 code:
    #   1 = [grammar]
    #   2 = [defaults]
    #   3 = [[rules]]
    # (passed in as `section`; we just branch on it.)
    var out_str_slot = alloc(8); store64(out_str_slot, 0);
    var out_bool_slot = alloc(8); store64(out_bool_slot, 0);

    if (section == 1) {   # [grammar]
        if (_gp_slice_eq(buf, key_pos, key_len, "name") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "extensions") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_extensions(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "shebangs") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_shebangs(g));
            return 0;
        }
        return 0;
    }

    if (section == 2) {   # [defaults]
        if (_gp_slice_eq(buf, key_pos, key_len, "shebang") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 24, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "whitespace") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 32, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "ident_start") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g + 40, char_class_new(load64(out_str_slot)));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "ident_cont") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(g + 48, char_class_new(load64(out_str_slot)));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_decimal") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 56, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0x") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 64, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0b") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 72, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "number_0o") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 80, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "special_vars") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 88, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "unicode_ident") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 136, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "char_literal") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 144, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "case_insensitive_keywords") == 1) {
            _gp_parse_bool(buf, len, value_pos, out_bool_slot);
            store64(g + 152, load64(out_bool_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "operators") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_operators(g));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "punctuation") == 1) {
            _gp_parse_string_array(buf, len, value_pos, grammar_punctuation(g));
            return 0;
        }
        return 0;
    }

    if (section == 3) {   # [[rules]] — populate current_rule slots
        # current_rule layout: kind @ 0, match_type @ 8, start @ 16,
        # end @ 24, escape_byte @ 32, words @ 40 (Vec).
        if (_gp_slice_eq(buf, key_pos, key_len, "kind") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var kname = load64(out_str_slot);
            store64(current_rule, _gp_kind_from_name(kname));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "match") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var mname = load64(out_str_slot);
            var mt = 0;
            if (streq(mname, "line")    == 1) { mt = 1; }
            if (streq(mname, "pair")    == 1) { mt = 2; }
            if (streq(mname, "words")   == 1) { mt = 3; }
            if (streq(mname, "compose") == 1) { mt = 4; }
            store64(current_rule + 8, mt);
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "start") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 16, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "end") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 24, load64(out_str_slot));
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "escape") == 1) {
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            var es = load64(out_str_slot);
            var eb = 0;
            if (es != 0) {
                if (strlen(es) > 0) { eb = load8(es); }
            }
            store64(current_rule + 32, eb);
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "words") == 1) {
            var v = vec_new();
            _gp_parse_string_array(buf, len, value_pos, v);
            store64(current_rule + 40, v);
            return 0;
        }
        if (_gp_slice_eq(buf, key_pos, key_len, "inner") == 1) {
            # Compose-rule inner-grammar name (slot 40 doubles as
            # words-vec for type=words OR inner-name cstr for
            # type=compose; they're mutually exclusive by mt).
            _gp_parse_string(buf, len, value_pos, out_str_slot);
            store64(current_rule + 40, load64(out_str_slot));
            return 0;
        }
        return 0;
    }
    return 0;
}

# Map a kind name cstr (e.g. "keyword") to a TK_* constant.
fn _gp_kind_from_name(name) {
    if (name == 0) { return TK_ERROR; }
    if (streq(name, "ident") == 1)        { return TK_IDENT; }
    if (streq(name, "keyword") == 1)      { return TK_KEYWORD; }
    if (streq(name, "string") == 1)       { return TK_STRING; }
    if (streq(name, "number") == 1)       { return TK_NUMBER; }
    if (streq(name, "comment") == 1)      { return TK_COMMENT; }
    if (streq(name, "operator") == 1)     { return TK_OPERATOR; }
    if (streq(name, "punctuation") == 1)  { return TK_PUNCTUATION; }
    if (streq(name, "whitespace") == 1)   { return TK_WHITESPACE; }
    if (streq(name, "preprocessor") == 1) { return TK_PREPROCESSOR; }
    if (streq(name, "error") == 1)        { return TK_ERROR; }
    return TK_ERROR;
}

# Finalize the in-progress rule (accumulator) into the appropriate
# typed vec on the grammar.
fn _gp_close_rule(g, rule_acc) {
    if (rule_acc == 0) { return 0; }
    var kind = load64(rule_acc);
    var mt   = load64(rule_acc + 8);
    var start = load64(rule_acc + 16);
    var endp  = load64(rule_acc + 24);
    var esc   = load64(rule_acc + 32);
    var words = load64(rule_acc + 40);
    if (mt == 1) {
        vec_push(grammar_line_rules(g), line_rule_new(kind, start));
        return 0;
    }
    if (mt == 2) {
        vec_push(grammar_pair_rules(g), pair_rule_new(kind, start, endp, esc));
        return 0;
    }
    if (mt == 3) {
        vec_push(grammar_words_rules(g), words_rule_new(kind, words));
        return 0;
    }
    if (mt == 4) {
        # Compose: slot 40 holds the inner-grammar name cstr
        # (overlaying words for the words-rule case; mt
        # disambiguates).
        var inner = words;
        vec_push(grammar_compose_rules(g), compose_rule_new(start, endp, inner));
        return 0;
    }
    return 0;
}

fn _gp_new_rule_acc() {
    var r = alloc(48);
    var i = 0;
    while (i < 48) { store8(r + i, 0); i = i + 1; }
    return r;
}

# Main parse loop.
fn _gp_parse(buf, len) {
    var g = grammar_new();
    var section = 0;      # 0=unset, 1=grammar, 2=defaults, 3=rules
    var current_rule = 0;
    var pos = 0;

    while (pos < len) {
        pos = _gp_skip_ws_and_comments(buf, len, pos);
        if (pos >= len) { break; }
        var b = load8(buf + pos);

        if (b == 91) {    # `[`
            # Either `[[rules]]` or `[section]`
            if ((pos + 1 < len) && (load8(buf + pos + 1) == 91)) {
                # Close previous rule if any
                if (current_rule != 0) { _gp_close_rule(g, current_rule); }
                # Expect `[[rules]]`
                pos = pos + 2;
                var wlen = _gp_read_word(buf, len, pos);
                # Ignore the actual word — all `[[...]]` markers start
                # a rule entry in vyakarana grammar files today.
                pos = pos + wlen;
                if ((pos + 1 < len) && (load8(buf + pos) == 93) && (load8(buf + pos + 1) == 93)) {
                    pos = pos + 2;
                }
                pos = _gp_skip_to_eol(buf, len, pos);
                section = 3;
                current_rule = _gp_new_rule_acc();
                continue;
            }
            # `[section]`
            pos = pos + 1;
            var sp = pos;
            var slen = _gp_read_word(buf, len, pos);
            pos = pos + slen;
            if ((pos < len) && (load8(buf + pos) == 93)) { pos = pos + 1; }
            pos = _gp_skip_to_eol(buf, len, pos);
            if (_gp_slice_eq(buf, sp, slen, "grammar")  == 1) { section = 1; }
            if (_gp_slice_eq(buf, sp, slen, "defaults") == 1) { section = 2; }
            continue;
        }

        # Must be a key = value line
        var key_pos = pos;
        var key_len = _gp_read_word(buf, len, pos);
        if (key_len == 0) {
            # Not a word — skip this byte to avoid looping.
            pos = pos + 1;
            continue;
        }
        pos = pos + key_len;
        pos = _gp_skip_hspace(buf, len, pos);
        if ((pos < len) && (load8(buf + pos) == 61)) {   # `=`
            pos = pos + 1;
            pos = _gp_skip_hspace(buf, len, pos);
            _gp_apply_kv(g, current_rule, section, buf, len, key_pos, key_len, pos);
            # Advance past the value. For strings the parse already
            # consumes; for arrays/bools too. We just advance to EOL
            # (arrays may already span lines, but the parser consumed
            # them; the trailing characters on this line, if any, are
            # whitespace/comment).
            pos = _gp_skip_to_eol_past_array(buf, len, pos);
            continue;
        }
        pos = _gp_skip_to_eol(buf, len, pos);
    }

    if (current_rule != 0) { _gp_close_rule(g, current_rule); }
    return g;
}

# Advance past the value starting at buf[pos], honoring array
# bracket depth and quoted strings. Leaves pos just past the final
# `\n` after the value.
fn _gp_skip_to_eol_past_array(buf, len, pos) {
    var depth = 0;
    var in_str = 0;
    while (pos < len) {
        var b = load8(buf + pos);
        if (in_str == 1) {
            if (b == 92) {                  # backslash
                if (pos + 1 < len) { pos = pos + 2; continue; }
                pos = pos + 1;
                continue;
            }
            if (b == 34) { in_str = 0; pos = pos + 1; continue; }
            pos = pos + 1;
            continue;
        }
        if (b == 34) { in_str = 1; pos = pos + 1; continue; }
        if (b == 91) { depth = depth + 1; pos = pos + 1; continue; }
        if (b == 93) {
            if (depth > 0) { depth = depth - 1; pos = pos + 1; continue; }
            pos = pos + 1;
            continue;
        }
        if ((b == 10) && (depth == 0)) { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}

# ── Public load API ─────────────────────────

# Load a grammar by file path. Returns a grammar handle or 0 on
# I/O error.
#
# Lookup order:
#   1. Embedded blob registry (src/grammar_blobs.cyr, generated by
#      scripts/embed-grammars.sh and bundled into dist/vyakarana.cyr).
#      This is what bootstrap_grammars() hits at runtime — lets the
#      dist bundle be self-contained, no grammars/ dir needed
#      downstream. See [ADR 0014].
#   2. Filesystem read at `path`. Used by `vyk grammars/foo.cyml` for
#      grammar-author dev workflow (edit a .cyml, re-run vyk without
#      regenerating the blob file).
fn grammar_load(path) {
    var buf = alloc(GRAMMAR_FILE_CAP);
    var blob = _grammar_blob_data(path);
    if (blob != 0) {
        # The CYML parser writes NUL terminators in-place to make
        # cstrs out of slices, so we can't hand it the literal —
        # copy into a writable buffer first. Same buffer shape as
        # the file path so the parser sees identical input.
        var bn = strlen(blob);
        var i = 0;
        while (i < bn) {
            store8(buf + i, load8(blob + i));
            i = i + 1;
        }
        store8(buf + bn, 0);
        return _gp_parse(buf, bn);
    }
    var n = file_read_all(path, buf, GRAMMAR_FILE_CAP - 1);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    return _gp_parse(buf, n);
}

# ── Registry ────────────────────────────────
# A flat vec of grammar handles. `registry_init` is idempotent so
# tokenize_source can call it lazily.

var _registry = 0;

fn registry_init() {
    if (_registry == 0) { _registry = vec_new(); }
    return _registry;
}

fn registry_add(g) {
    registry_init();
    vec_push(_registry, g);
    return 0;
}

fn registry_find_by_name(name) {
    registry_init();
    var n = vec_len(_registry);
    var i = 0;
    while (i < n) {
        var g = vec_get(_registry, i);
        var gn = grammar_name(g);
        if (gn != 0) {
            if (streq(gn, name) == 1) { return g; }
        }
        i = i + 1;
    }
    return 0;
}

fn list_languages_into(out_vec) {
    registry_init();
    var n = vec_len(_registry);
    var i = 0;
    while (i < n) {
        var g = vec_get(_registry, i);
        var gn = grammar_name(g);
        if (gn != 0) { vec_push(out_vec, gn); }
        i = i + 1;
    }
    return 0;
}

# --- default_scanner.cyr ---

# vyakarana — data-driven default scanner
#
# Consumes a loaded grammar record (see src/grammar.cyr) and tokenizes
# source bytes into a tokenbuf. Scanner dispatch follows ADR 0005:
#
#   0. [[rules]] match="compose" (ADR 0013)           → recursive
#      (start marker + inner-grammar body + end marker)
#   1. shebang (#! on line 0, column 0)              → preprocessor
#   2. [[rules]] match="line"                         → kind
#   3. [[rules]] match="pair"                         → kind
#   4. defaults.special_vars ($X, X = #?@!*$-)        → operator, 2 bytes
#   5. defaults.special_vars lone $                   → operator, 1 byte
#   6. defaults.ident_start/ident_cont                → ident, or keyword
#      via [[rules]] match="words" lookup
#   7. defaults.number_decimal/_0x/_0b/_0o            → number
#   7b. defaults.char_literal `'C'`/`'\C'`/`'\xHH'`   → string
#   8. defaults.operators (longest match)             → operator
#   9. defaults.punctuation (longest match)           → punctuation
#  10. defaults.whitespace (run)                      → whitespace
#  11. fallthrough                                    → error (1 byte)
#
# Coverage invariant holds at every step — the main loop advances by
# `len` on each iteration and a fallback error emits 1 byte when no
# rule matched.
#
# Perf notes for later: the operators / punctuation lists are scanned
# linearly longest-first; a trie or length-indexed bucket scan is an
# easy speedup at M5 benchmark time.


# ── Scanner helpers (mirror the hand-coded shell.cyr shape) ─────────

fn _ds_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

fn _ds_is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn _ds_is_hex_digit(b) {
    if (_ds_is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }
    if ((b >= 65) && (b <= 70))  { return 1; }
    return 0;
}

fn _ds_is_bin_digit(b) {
    if (b == 48) { return 1; }
    if (b == 49) { return 1; }
    return 0;
}

fn _ds_is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }
    return 1;
}

fn _ds_is_special_var_char(b) {
    if (b == 35) { return 1; }   # #
    if (b == 63) { return 1; }   # ?
    if (b == 64) { return 1; }   # @
    if (b == 33) { return 1; }   # !
    if (b == 42) { return 1; }   # *
    if (b == 36) { return 1; }   # $
    if (b == 45) { return 1; }   # -
    return 0;
}

# ── Per-rule try-match functions ────────────
# Each returns a length > 0 if it matched at src[i], else 0.

fn _ds_try_shebang(g, src, src_len, i) {
    if (grammar_shebang_on(g) == 0) { return 0; }
    if (i != 0) { return 0; }
    if (src_len < 2) { return 0; }
    if (load8(src) != 35) { return 0; }      # #
    if (load8(src + 1) != 33) { return 0; }  # !
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Try each [[rules]] match="line" in order. Returns kind packed into
# high 8 bits and len in low 56 bits — 0 if none matched. (This is
# the cheapest multi-return I could find without tuples.)
fn _ds_try_line_rules(g, src, src_len, i) {
    var rules = grammar_line_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var marker = line_rule_start(r);
        var mlen = strlen(marker);
        if ((i + mlen <= src_len) && (memeq(src + i, marker, mlen) == 1)) {
            var j = i;
            while (j < src_len) {
                if (load8(src + j) == 10) { break; }
                j = j + 1;
            }
            var len = j - i;
            return (line_rule_kind(r) << 56) | len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="compose" at the cursor.
#
# A compose rule routes the body between `start` and `end`
# markers through a *different* grammar (looked up by name in
# the registry). When matched:
#   - emits `start` bytes as one TK_PUNCTUATION token,
#   - tokenizes the body via the inner grammar (recursively),
#     adjusting offsets so they're absolute in the outer src,
#   - emits `end` bytes as one TK_PUNCTUATION token,
#   - returns the total bytes consumed.
#
# When the inner grammar isn't found in the registry (e.g.
# bootstrap order, or the embedded language was never bundled),
# the body falls back to one TK_STRING token — coverage holds.
#
# Unlike the pair / line / words rule helpers, this one writes
# directly to `tb` and returns the advance length. Returns 0
# when no compose rule matched at this cursor.
#
# Recursion: `tokenize_with_grammar` itself runs compose-rule
# step (step 0 below), so embedded grammars that themselves
# have compose rules nest correctly. Real-world depth is ≤2
# (HTML <script> with a JS template literal containing CSS, say).
#
# See ADR 0013 for the design.
fn _ds_try_compose_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = compose_rule_end(r);
            var elen = strlen(endp);
            var body_start = i + slen;
            var j = body_start;
            while (j < src_len) {
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    # Found end marker. Emit start, body, end.
                    tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
                    var body_len = j - body_start;
                    if (body_len > 0) {
                        var inner_name = compose_rule_inner(r);
                        var inner_g = registry_find_by_name(inner_name);
                        if (inner_g != 0) {
                            # Inner grammar found — tokenize body
                            # in a fresh buf, copy with shifted
                            # offsets.
                            var inner_tb = tokenbuf_new();
                            tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                var ik = tokenbuf_kind(inner_tb, k);
                                var is = tokenbuf_start(inner_tb, k);
                                var il = tokenbuf_len(inner_tb, k);
                                tokenbuf_push(tb, ik, is + body_start, il);
                                k = k + 1;
                            }
                        } else {
                            # Inner grammar missing — graceful
                            # degrade: body is one string span.
                            tokenbuf_push(tb, TK_STRING, body_start, body_len);
                        }
                    }
                    tokenbuf_push(tb, TK_PUNCTUATION, j, elen);
                    return slen + body_len + elen;
                }
                j = j + 1;
            }
            # End marker not found — fall through (next compose
            # rule, or normal pipeline). Don't half-consume.
            return 0;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="pair". Returns packed (kind << 56) | len.
fn _ds_try_pair_rules(g, src, src_len, i) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = pair_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = pair_rule_end(r);
            var elen = strlen(endp);
            var esc = pair_rule_escape(r);
            var j = i + slen;
            while (j < src_len) {
                var b = load8(src + j);
                if ((esc != 0) && (b == esc)) {
                    j = j + 2;
                    continue;
                }
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    var len = j - i + elen;
                    return (pair_rule_kind(r) << 56) | len;
                }
                j = j + 1;
            }
            # Unterminated — consume to EOF.
            var len_eof = src_len - i;
            return (pair_rule_kind(r) << 56) | len_eof;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Char literal at the cursor when `[defaults] char_literal = true`.
# Recognises four shapes:
#   'C'      → 3 bytes  (any non-`\`, non-`'` byte)
#   '\C'     → 4 bytes  (any single-byte escape — \n, \0, \\, \', etc.)
#   '\xHH'   → 6 bytes  (hex escape; we don't validate the hex digits
#                        — the scanner trusts the closing quote)
#   '<UTF-8>'→ 4/5/6 bytes for 2/3/4-byte UTF-8 leading byte ranges
#
# Returns the matched length, or 0 if no shape fits. A 0 return lets
# the leading `'` fall through to the operator step — that's how
# Rust lifetimes (`'a`, `'static`, `'_`) keep working: no closing
# quote at the right offset means "not a char literal."
#
# See ADR 0010.
fn _ds_try_char_literal(g, src, src_len, i) {
    if (grammar_char_literal(g) == 0) { return 0; }
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != 39) { return 0; }   # opening `'`

    var b1 = load8(src + i + 1);
    if (b1 == 39) { return 0; }                # `''` — never valid
    if (b1 == 92) {                            # `\` escape forms
        if (i + 3 >= src_len) { return 0; }
        # `'\xHH'` — 6 bytes
        if (load8(src + i + 2) == 120) {       # `x`
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
        # `'\C'` — 4 bytes
        if (load8(src + i + 3) == 39) { return 4; }
        return 0;
    }

    # `'C'` — 3-byte ASCII body
    if (load8(src + i + 2) == 39) { return 3; }

    # UTF-8 multi-byte body. Leading-byte ranges per RFC 3629:
    #   0xC2..0xDF → 2-byte sequence (4 bytes total incl. quotes)
    #   0xE0..0xEF → 3-byte sequence (5 bytes total)
    #   0xF0..0xF4 → 4-byte sequence (6 bytes total)
    if (b1 >= 194) {
        if (b1 < 224) {
            if (i + 3 < src_len) {
                if (load8(src + i + 3) == 39) { return 4; }
            }
            return 0;
        }
        if (b1 < 240) {
            if (i + 4 < src_len) {
                if (load8(src + i + 4) == 39) { return 5; }
            }
            return 0;
        }
        if (b1 < 245) {
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
    }
    return 0;
}

# Exact-match longest-first list (operators or punctuation). Returns
# the matched length, or 0 if nothing matched.
fn _ds_try_exact_list(list_vec, src, src_len, i) {
    var n = vec_len(list_vec);
    var li = 0;
    while (li < n) {
        var s = vec_get(list_vec, li);
        var slen = strlen(s);
        if ((i + slen <= src_len) && (memeq(src + i, s, slen) == 1)) {
            return slen;
        }
        li = li + 1;
    }
    return 0;
}

# Identifier run. Caller has already confirmed the first byte is in
# ident_start (or is a UTF-8 byte ≥0x80 with unicode_ident=true).
# Returns len.
#
# When `unicode_ident = true`, any byte ≥0x80 is also accepted as
# ident-cont so multi-byte UTF-8 sequences (em-dashes, smart
# quotes, accented letters) coalesce into a single TK_IDENT instead
# of fragmenting into per-byte TK_ERROR tokens. See
# [ADR 0009](../docs/adr/0009-unicode-ident-default.md).
fn _ds_scan_ident(g, src, src_len, i) {
    var cont_tbl = grammar_ident_cont(g);
    var unicode_on = grammar_unicode_ident(g);
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        var ok = char_class_match(cont_tbl, b);
        if ((ok == 0) && (unicode_on == 1) && (b >= 128)) { ok = 1; }
        if (ok == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Case-fold A-Z (0x41–0x5A) to a-z (0x61–0x7A). Other bytes
# pass through unchanged. Used by `_ds_lookup_keyword` when
# `[defaults] case_insensitive_keywords = true`. See ADR 0011.
fn _ds_to_lower(b) {
    if (b >= 65) {
        if (b <= 90) {
            return b + 32;
        }
    }
    return b;
}

# Compare an ident span against a keyword string with optional
# case folding. Returns 1 on match, 0 otherwise. Same byte-by-
# byte cost as `memeq` plus one branch per byte; no allocation.
fn _ds_word_match(src, start, w, wlen, fold) {
    if (fold == 0) {
        return memeq(src + start, w, wlen);
    }
    var i = 0;
    while (i < wlen) {
        var a = _ds_to_lower(load8(src + start + i));
        var b = _ds_to_lower(load8(w + i));
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# If the byte span [start, start+len) matches a word in any words
# rule, returns that rule's kind (an i64). Returns -1 when no match.
# No out-param, no per-call allocation — this runs once per ident
# in the hot path and ADR 0002 forbids per-token allocation.
#
# When `[defaults] case_insensitive_keywords = true`, the match
# folds A-Z to a-z on both sides. ADR 0011 — needed by SQL
# (and PostgreSQL/Oracle/T-SQL dialects) where `SELECT` /
# `select` / `Select` are the same reserved word.
fn _ds_lookup_keyword(g, src, start, len) {
    var rules = grammar_words_rules(g);
    var n = vec_len(rules);
    var fold = grammar_case_insensitive_kw(g);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var words = words_rule_words(r);
        var wn = vec_len(words);
        var w_i = 0;
        while (w_i < wn) {
            var w = vec_get(words, w_i);
            var wlen = strlen(w);
            if (wlen == len) {
                if (_ds_word_match(src, start, w, wlen, fold) == 1) {
                    return words_rule_kind(r);
                }
            }
            w_i = w_i + 1;
        }
        r_i = r_i + 1;
    }
    return 0 - 1;
}

# Number with optional 0x/0b/0o prefix. Returns length; 0 if not a
# number. Caller has already checked is_digit on src[i].
fn _ds_scan_number(g, src, src_len, i) {
    if (load8(src + i) == 48) {                # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((grammar_number_0x(g) == 1) && ((p == 120) || (p == 88))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_hex_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((grammar_number_0b(g) == 1) && ((p == 98) || (p == 66))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_bin_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((grammar_number_0o(g) == 1) && ((p == 111) || (p == 79))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_oct_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
        }
    }
    if (grammar_number_decimal(g) == 0) { return 0; }
    var j = i + 1;
    while (j < src_len) {
        if (_ds_is_digit(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Whitespace run.
fn _ds_scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (_ds_is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# ── Entry point ─────────────────────────────

fn tokenize_with_grammar(g, src, src_len, tb) {
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var kind = TK_ERROR;
        var len  = 0;

        # 0. Compose rules (ADR 0013). Push their own tokens
        # (start marker + recursively-tokenized body + end
        # marker) and advance the cursor by the matched length.
        # Runs before any other step because compose markers
        # like `<style>` would otherwise be eaten by the outer
        # grammar's normal `<` op + `style` ident + `>` op
        # tokenization.
        var clen = _ds_try_compose_rules(g, src, src_len, i, tb);
        if (clen > 0) {
            i = i + clen;
            continue;
        }

        # 1. Shebang
        if (len == 0) {
            len = _ds_try_shebang(g, src, src_len, i);
            if (len > 0) { kind = TK_PREPROCESSOR; }
        }

        # 2. Line rules
        if (len == 0) {
            var packed = _ds_try_line_rules(g, src, src_len, i);
            if (packed != 0) {
                kind = packed >> 56;
                len  = packed & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 3. Pair rules
        if (len == 0) {
            var packed2 = _ds_try_pair_rules(g, src, src_len, i);
            if (packed2 != 0) {
                kind = packed2 >> 56;
                len  = packed2 & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 4. Special var `$X`
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                if (i + 1 < src_len) {
                    if (_ds_is_special_var_char(load8(src + i + 1)) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 5. Lone `$` as operator (only if special_vars is on; otherwise
        # `$` will be caught by the operators list or fall through).
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 6. Identifier / keyword. With `unicode_ident = true`, any
        # byte ≥0x80 also enters the ident scan (see ADR 0009).
        if (len == 0) {
            var start_tbl = grammar_ident_start(g);
            var ident_ok = 0;
            if ((start_tbl != 0) && (char_class_match(start_tbl, b) == 1)) {
                ident_ok = 1;
            }
            if ((ident_ok == 0) && (grammar_unicode_ident(g) == 1) && (b >= 128)) {
                ident_ok = 1;
            }
            if (ident_ok == 1) {
                len = _ds_scan_ident(g, src, src_len, i);
                var kw_kind = _ds_lookup_keyword(g, src, i, len);
                if (kw_kind >= 0) {
                    kind = kw_kind;
                } else {
                    kind = TK_IDENT;
                }
            }
        }

        # 7. Number
        if (len == 0) {
            if (_ds_is_digit(b) == 1) {
                var nlen = _ds_scan_number(g, src, src_len, i);
                if (nlen > 0) {
                    kind = TK_NUMBER;
                    len = nlen;
                }
            }
        }

        # 7b. Char literal. Runs only when `[defaults] char_literal
        # = true`; before the operator step so the leading `'`
        # doesn't fall through to a 1-char operator. Rust-style
        # lifetimes (no closing quote at the right offset) still
        # tokenize as `'` + ident via steps 8 + 6 on subsequent
        # cursor positions. See ADR 0010.
        if (len == 0) {
            var clen = _ds_try_char_literal(g, src, src_len, i);
            if (clen > 0) {
                kind = TK_STRING;
                len = clen;
            }
        }

        # 8. Operator (longest match)
        if (len == 0) {
            var olen = _ds_try_exact_list(grammar_operators(g), src, src_len, i);
            if (olen > 0) {
                kind = TK_OPERATOR;
                len = olen;
            }
        }

        # 9. Punctuation (longest match)
        if (len == 0) {
            var plen = _ds_try_exact_list(grammar_punctuation(g), src, src_len, i);
            if (plen > 0) {
                kind = TK_PUNCTUATION;
                len = plen;
            }
        }

        # 10. Whitespace
        if (len == 0) {
            if ((grammar_whitespace_on(g) == 1) && (_ds_is_space(b) == 1)) {
                kind = TK_WHITESPACE;
                len = _ds_scan_whitespace(src, src_len, i);
            }
        }

        # 11. Fallback — keep coverage invariant by advancing 1 byte.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        i = i + len;
    }
    return tokenbuf_count(tb);
}

# --- shell.cyr ---

# vyakarana — shell grammar (M1, hand-coded)
#
# Tokenizes bash/sh scripts end-to-end. Zero `error` tokens on the
# vidya shell sample is the pass bar (tests/corpus/shell.sh).
#
# Dispatch table (first match wins, all advance `i` by the token's len):
#   1. `#!` on column 0 of line 0       → preprocessor (shebang)
#   2. `#` (not shebang)                 → comment to end of line
#   3. `"..."` (backslash escape aware)  → string
#   4. `'...'` (no escapes)              → string
#   5. `$X` where X is #?@!*$-0..9       → operator, length 2
#      (shell special variable refs; prevents `$#` starting a comment)
#   6. `$`                               → operator, length 1
#   7. identifier start [A-Za-z_]        → keyword-lookup, else ident
#   8. digit                             → number (decimal, hex, bin, oct)
#   9. multi-char operators (longest-match: <<< then 2-char then 1-char)
#  10. multi-char punctuation [[ ]] (( )) ;;
#  11. single-char punctuation ( ) { } [ ] ; : , .
#  12. whitespace run                    → single whitespace token
#  13. anything else                     → error token, length 1
#
# Inside strings, expansions (`${...}`, `$(...)`) are NOT re-tokenized —
# the entire quoted run is one `string` token. This keeps M1 simple and
# matches the convention most terminal highlighters follow; M2's CYML
# loader can add nested-rule support if a grammar calls for it.


# ── Byte-category predicates ────────────────

fn is_space(b) {
    if (b == 32) { return 1; }  # space
    if (b == 9)  { return 1; }  # tab
    if (b == 10) { return 1; }  # newline
    if (b == 13) { return 1; }  # CR
    return 0;
}

fn is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn is_hex_digit(b) {
    if (is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }  # a-f
    if ((b >= 65) && (b <= 70))  { return 1; }  # A-F
    return 0;
}

fn is_bin_digit(b) {
    if (b == 48) { return 1; }  # 0
    if (b == 49) { return 1; }  # 1
    return 0;
}

fn is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }   # 0-7
    return 1;
}

fn is_alpha(b) {
    if ((b >= 97) && (b <= 122)) { return 1; }  # a-z
    if ((b >= 65) && (b <= 90))  { return 1; }  # A-Z
    return 0;
}

fn is_ident_start(b) {
    if (is_alpha(b) == 1) { return 1; }
    if (b == 95) { return 1; }  # _
    return 0;
}

fn is_ident_cont(b) {
    if (is_ident_start(b) == 1) { return 1; }
    if (is_digit(b) == 1) { return 1; }
    return 0;
}

# Shell special-variable char: `$X` where X is one of these emits as a
# 2-char operator, so the `$#` sequence doesn't start a comment.
fn is_shell_special_var(b) {
    if (b == 35) { return 1; }  # #
    if (b == 63) { return 1; }  # ?
    if (b == 64) { return 1; }  # @
    if (b == 33) { return 1; }  # !
    if (b == 42) { return 1; }  # *
    if (b == 36) { return 1; }  # $
    if (b == 45) { return 1; }  # -
    return 0;
}

# ── Keyword lookup ──────────────────────────
# Length-keyed if-ladder. The keyword set follows design-spec §3
# and ADR 0004 — core reserved words only; builtins like
# `local`/`declare` are left as `ident` so theme authors can style
# them distinctly via token-text rules.

fn is_shell_keyword(src, start, len) {
    if (len == 2) {
        if (memeq(src + start, "if", 2) == 1) { return 1; }
        if (memeq(src + start, "fi", 2) == 1) { return 1; }
        if (memeq(src + start, "do", 2) == 1) { return 1; }
        if (memeq(src + start, "in", 2) == 1) { return 1; }
        return 0;
    }
    if (len == 3) {
        if (memeq(src + start, "for", 3) == 1) { return 1; }
        return 0;
    }
    if (len == 4) {
        if (memeq(src + start, "then", 4) == 1) { return 1; }
        if (memeq(src + start, "else", 4) == 1) { return 1; }
        if (memeq(src + start, "elif", 4) == 1) { return 1; }
        if (memeq(src + start, "done", 4) == 1) { return 1; }
        if (memeq(src + start, "case", 4) == 1) { return 1; }
        if (memeq(src + start, "esac", 4) == 1) { return 1; }
        if (memeq(src + start, "time", 4) == 1) { return 1; }
        return 0;
    }
    if (len == 5) {
        if (memeq(src + start, "while", 5) == 1) { return 1; }
        if (memeq(src + start, "until", 5) == 1) { return 1; }
        if (memeq(src + start, "break", 5) == 1) { return 1; }
        return 0;
    }
    if (len == 6) {
        if (memeq(src + start, "return", 6) == 1) { return 1; }
        if (memeq(src + start, "select", 6) == 1) { return 1; }
        return 0;
    }
    if (len == 8) {
        if (memeq(src + start, "function", 8) == 1) { return 1; }
        if (memeq(src + start, "continue", 8) == 1) { return 1; }
        return 0;
    }
    return 0;
}

# ── Scanners (each returns the token length in bytes) ───────────────
# All scanners guarantee len >= 1 so the main loop always advances.

# Scan from current `#` (or `#!`) to end-of-line, NOT including the
# newline. The newline is picked up on the next iteration as whitespace.
fn _scan_to_eol(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Double-quoted string: opening `"` at i; find closing `"` honoring
# backslash escapes. Unterminated → consume to EOF (a design-spec
# coverage-invariant safety net; the vidya sample won't hit this).
fn _scan_string_double(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        if (b == 92) {                # backslash → skip next char
            j = j + 2;
        } else {
            if (b == 34) { return j - i + 1; }   # closing "
            j = j + 1;
        }
    }
    return src_len - i;
}

# Single-quoted string: no escapes; closing `'` ends it.
fn _scan_string_single(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        if (load8(src + j) == 39) { return j - i + 1; }
        j = j + 1;
    }
    return src_len - i;
}

# Identifier run (caller has already confirmed is_ident_start at i).
fn _scan_ident(src, src_len, i) {
    var j = i + 1;
    while (j < src_len) {
        if (is_ident_cont(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Number: decimal, or 0x.../0b.../0o... prefix. Caller confirmed
# is_digit(src[i]). Does NOT handle floats — the shell corpus is
# integers only, and bash itself doesn't have float arithmetic in
# the language proper.
fn _scan_number(src, src_len, i) {
    # Check for prefix
    if (load8(src + i) == 48) {                  # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((p == 120) || (p == 88)) {       # 0x / 0X
                var j = i + 2;
                while (j < src_len) {
                    if (is_hex_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((p == 98) || (p == 66)) {        # 0b / 0B
                var j = i + 2;
                while (j < src_len) {
                    if (is_bin_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((p == 111) || (p == 79)) {       # 0o / 0O
                var j = i + 2;
                while (j < src_len) {
                    if (is_oct_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
        }
    }
    var j = i + 1;
    while (j < src_len) {
        if (is_digit(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Whitespace run.
fn _scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Peek two-byte sequence match; safe past src_len.
fn _peek2_eq(src, src_len, i, c0, c1) {
    if (i + 1 >= src_len) { return 0; }
    if (load8(src + i) != c0) { return 0; }
    if (load8(src + i + 1) != c1) { return 0; }
    return 1;
}

# Peek three-byte sequence match.
fn _peek3_eq(src, src_len, i, c0, c1, c2) {
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != c0) { return 0; }
    if (load8(src + i + 1) != c1) { return 0; }
    if (load8(src + i + 2) != c2) { return 0; }
    return 1;
}

# ── Entry point ─────────────────────────────
#
# `src`      — source bytes (pointer; caller owns the buffer)
# `src_len`  — byte length
# `tb`       — tokenbuf to push into (created by caller via tokenbuf_new)
#
# Returns the number of tokens pushed.
#
# Coverage invariant: every byte of [0, src_len) is covered by exactly
# one token. The main loop never advances zero bytes.
fn tokenize_shell(src, src_len, tb) {
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var len = 0;
        var kind = TK_ERROR;

        # 1. Shebang on line 0, column 0
        if (i == 0) {
            if (_peek2_eq(src, src_len, 0, 35, 33) == 1) {   # #!
                kind = TK_PREPROCESSOR;
                len = _scan_to_eol(src, src_len, i);
            }
        }

        # 2. Comment (# to EOL), but not if we just handled a shebang
        if (len == 0) {
            if (b == 35) {    # #
                kind = TK_COMMENT;
                len = _scan_to_eol(src, src_len, i);
            }
        }

        # 3. Double-quoted string
        if (len == 0) {
            if (b == 34) {    # "
                kind = TK_STRING;
                len = _scan_string_double(src, src_len, i);
            }
        }

        # 4. Single-quoted string
        if (len == 0) {
            if (b == 39) {    # '
                kind = TK_STRING;
                len = _scan_string_single(src, src_len, i);
            }
        }

        # 5. `$X` for shell special-variable X
        if (len == 0) {
            if (b == 36) {    # $
                if (i + 1 < src_len) {
                    var nxt = load8(src + i + 1);
                    if (is_shell_special_var(nxt) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 6. Lone `$`
        if (len == 0) {
            if (b == 36) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 7. Identifier / keyword
        if (len == 0) {
            if (is_ident_start(b) == 1) {
                len = _scan_ident(src, src_len, i);
                if (is_shell_keyword(src, i, len) == 1) {
                    kind = TK_KEYWORD;
                } else {
                    kind = TK_IDENT;
                }
            }
        }

        # 8. Number
        if (len == 0) {
            if (is_digit(b) == 1) {
                kind = TK_NUMBER;
                len = _scan_number(src, src_len, i);
            }
        }

        # 9a. 3-char operator: <<<
        if (len == 0) {
            if (_peek3_eq(src, src_len, i, 60, 60, 60) == 1) {
                kind = TK_OPERATOR;
                len = 3;
            }
        }

        # 9b. 2-char operators
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 38, 38) == 1) { kind = TK_OPERATOR; len = 2; }  # &&
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 124, 124) == 1) { kind = TK_OPERATOR; len = 2; }  # ||
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 61, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # ==
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 33, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # !=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 61, 126) == 1) { kind = TK_OPERATOR; len = 2; }  # =~
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # <=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 62, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # >=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 62, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # >>
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 60) == 1) { kind = TK_OPERATOR; len = 2; }  # <<
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 60, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # <>
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 43, 43) == 1) { kind = TK_OPERATOR; len = 2; }  # ++
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 45) == 1) { kind = TK_OPERATOR; len = 2; }  # --
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 43, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # +=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # -=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 42, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # *=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 47, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # /=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 37, 61) == 1) { kind = TK_OPERATOR; len = 2; }  # %=
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 45, 62) == 1) { kind = TK_OPERATOR; len = 2; }  # ->
        }

        # 9c. 2-char punctuation
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 91, 91) == 1) { kind = TK_PUNCTUATION; len = 2; }  # [[
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 93, 93) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ]]
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 40, 40) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ((
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 41, 41) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ))
        }
        if (len == 0) {
            if (_peek2_eq(src, src_len, i, 59, 59) == 1) { kind = TK_PUNCTUATION; len = 2; }  # ;;
        }

        # 10. Single-char operators
        if (len == 0) {
            if (b == 61) { kind = TK_OPERATOR; len = 1; }   # =
        }
        if (len == 0) {
            if (b == 124) { kind = TK_OPERATOR; len = 1; }  # |
        }
        if (len == 0) {
            if (b == 38) { kind = TK_OPERATOR; len = 1; }   # &
        }
        if (len == 0) {
            if (b == 60) { kind = TK_OPERATOR; len = 1; }   # <
        }
        if (len == 0) {
            if (b == 62) { kind = TK_OPERATOR; len = 1; }   # >
        }
        if (len == 0) {
            if (b == 43) { kind = TK_OPERATOR; len = 1; }   # +
        }
        if (len == 0) {
            if (b == 45) { kind = TK_OPERATOR; len = 1; }   # -
        }
        if (len == 0) {
            if (b == 42) { kind = TK_OPERATOR; len = 1; }   # *
        }
        if (len == 0) {
            if (b == 47) { kind = TK_OPERATOR; len = 1; }   # /
        }
        if (len == 0) {
            if (b == 37) { kind = TK_OPERATOR; len = 1; }   # %
        }
        if (len == 0) {
            if (b == 33) { kind = TK_OPERATOR; len = 1; }   # !
        }
        if (len == 0) {
            if (b == 126) { kind = TK_OPERATOR; len = 1; }  # ~
        }
        if (len == 0) {
            if (b == 63) { kind = TK_OPERATOR; len = 1; }   # ?
        }
        if (len == 0) {
            if (b == 64) { kind = TK_OPERATOR; len = 1; }   # @
        }
        if (len == 0) {
            if (b == 94) { kind = TK_OPERATOR; len = 1; }   # ^
        }
        if (len == 0) {
            if (b == 92) { kind = TK_OPERATOR; len = 1; }   # \
        }

        # 11. Single-char punctuation
        if (len == 0) {
            if (b == 40) { kind = TK_PUNCTUATION; len = 1; }   # (
        }
        if (len == 0) {
            if (b == 41) { kind = TK_PUNCTUATION; len = 1; }   # )
        }
        if (len == 0) {
            if (b == 123) { kind = TK_PUNCTUATION; len = 1; }  # {
        }
        if (len == 0) {
            if (b == 125) { kind = TK_PUNCTUATION; len = 1; }  # }
        }
        if (len == 0) {
            if (b == 91) { kind = TK_PUNCTUATION; len = 1; }   # [
        }
        if (len == 0) {
            if (b == 93) { kind = TK_PUNCTUATION; len = 1; }   # ]
        }
        if (len == 0) {
            if (b == 59) { kind = TK_PUNCTUATION; len = 1; }   # ;
        }
        if (len == 0) {
            if (b == 58) { kind = TK_PUNCTUATION; len = 1; }   # :
        }
        if (len == 0) {
            if (b == 44) { kind = TK_PUNCTUATION; len = 1; }   # ,
        }
        if (len == 0) {
            if (b == 46) { kind = TK_PUNCTUATION; len = 1; }   # .
        }

        # 12. Whitespace
        if (len == 0) {
            if (is_space(b) == 1) {
                kind = TK_WHITESPACE;
                len = _scan_whitespace(src, src_len, i);
            }
        }

        # 13. Fallback — unrecognized byte. Emit error of length 1 so
        # the coverage invariant still holds.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        i = i + len;
    }
    return tokenbuf_count(tb);
}

# --- tokenize.cyr ---

# vyakarana — Tokenize runtime
#
#   - `tokenize_source(src, lang)` looks up `lang` in the grammar
#     registry and dispatches to the data-driven default scanner.
#   - On first call, grammars are loaded from `grammars/<lang>.cyml`
#     (relative to cwd). A proper resolution strategy for installed
#     binaries is open work — content-based detection / install-path
#     resolution lands as part of the 1.11.0 external-integrations
#     wave (see `docs/development/roadmap.md`).
#   - `tokenize_source_handcoded(src, "shell")` is the hand-coded
#     M1 path, retained as a regression oracle for smoke.sh's
#     byte-identical diff check. Removal candidate for a future
#     closeout if the data-driven shell grammar stays green long
#     enough to retire the oracle.
#
# owl imports `tokenize_source`. Don't rename without a CHANGELOG
# entry — see `docs/architecture/overview.md` "Frozen public
# contracts."


var _grammars_bootstrapped = 0;

# Load every bundled grammar on first use. Idempotent. Callers that
# don't exercise tokenize_source / has_grammar (e.g. `vyk
# --list-languages`) should call this explicitly before reading the
# registry.
#
# This is a hardcoded list by design — the 14 bundled grammars are
# part of vyakarana's distribution shape and the order here defines
# `vyk --list-languages` output order. Adding a grammar means
# adding a `.cyml` file, a corpus snapshot, a probe in the test
# suite, an entry here, and a smoke-script line. A directory-scan
# variant could replace this if and when grammars become user-
# pluggable, but that's a future feature with its own ADR.
fn bootstrap_grammars() {
    if (_grammars_bootstrapped == 1) { return 0; }
    _grammars_bootstrapped = 1;
    var gs = grammar_load("grammars/shell.cyml");
    if (gs != 0) { registry_add(gs); }
    var gt = grammar_load("grammars/toml.cyml");
    if (gt != 0) { registry_add(gt); }
    var gj = grammar_load("grammars/json.cyml");
    if (gj != 0) { registry_add(gj); }
    var gc = grammar_load("grammars/cyrius.cyml");
    if (gc != 0) { registry_add(gc); }
    var gr = grammar_load("grammars/rust.cyml");
