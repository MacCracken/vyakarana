    if (gps != 0) { registry_add(gps); }
    var gcr = grammar_load("grammars/crystal.cyml");
    if (gcr != 0) { registry_add(gcr); }
    var gjul = grammar_load("grammars/julia.cyml");
    if (gjul != 0) { registry_add(gjul); }
    var gvue = grammar_load("grammars/vue.cyml");
    if (gvue != 0) { registry_add(gvue); }
    var gsvel = grammar_load("grammars/svelte.cyml");
    if (gsvel != 0) { registry_add(gsvel); }
    var gnix = grammar_load("grammars/nix.cyml");
    if (gnix != 0) { registry_add(gnix); }
    var gtf = grammar_load("grammars/terraform.cyml");
    if (gtf != 0) { registry_add(gtf); }
    var gqasm = grammar_load("grammars/openqasm.cyml");
    if (gqasm != 0) { registry_add(gqasm); }
    return 0;
}

fn has_grammar(lang) {
    bootstrap_grammars();
    if (registry_find_by_name(lang) == 0) { return 0; }
    return 1;
}

# ── Stream primitive (push-based) ──────────────

# Allocate a fresh stream tied to the named grammar. Returns 0
# if the grammar is unknown (caller should check has_grammar
# first if it cares to distinguish).
fn tokenize_stream_new(lang) {
    bootstrap_grammars();
    var g = registry_find_by_name(lang);
    if (g == 0) { return 0; }
    var s = alloc(STREAM_REC_SIZE);
    var buf = alloc(VYK_STREAM_INIT_CAP);
    store64(s,      buf);
    store64(s + 8,  0);
    store64(s + 16, VYK_STREAM_INIT_CAP);
    store64(s + 24, g);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, tokenbuf_new());   # staging_tb (pull adapter)
    store64(s + 64, 0);                # next_idx
    store64(s + 72, (0 - 1));          # pending_idx — none (2.0.3)
    store64(s + 80, 0);                # scan_resume
    return s;
}

# Grow `s.buf` to at least `needed` bytes. Doubles capacity until
# either >= needed or VYK_STREAM_CAP. Returns 1 on success, 0 if
# the cap would be exceeded.
fn _stream_grow(s, needed) {
    var cap = load64(s + 16);
    if (cap >= needed) { return 1; }
    # Defensive: a zero cap would loop forever in the doubling
    # below (0 * 2 = 0). Should only happen if a freed stream
    # is reused — `_free` zeroes every field. Treat as an
    # error path rather than infinite-looping. Per FINDING-008,
    # 2.0.4 audit.
    if (cap <= 0) { return 0; }
    var new_cap = cap;
    while (new_cap < needed) { new_cap = new_cap * 2; }
    if (new_cap > VYK_STREAM_CAP) { new_cap = VYK_STREAM_CAP; }
    if (new_cap < needed) { return 0; }
    var old_buf = load64(s);
    var new_buf = alloc(new_cap);
    # FINDING-002: `alloc` returns 0 on OOM. Report failure through
    # the existing channel (feed turns this into VYK_ERR_OVERFLOW)
    # rather than copying into a NULL buffer.
    if (new_buf == 0) { return 0; }
    var len = load64(s + 8);
    var i = 0;
    while (i < len) {
        store8(new_buf + i, load8(old_buf + i));
        i = i + 1;
    }
    store64(s,      new_buf);
    store64(s + 16, new_cap);
    return 1;
}

# Feed `n` bytes from `chunk` into the stream's internal buffer.
# Returns VYK_OK on success, VYK_ERR_FINISHED if finish() already
# ran, VYK_ERR_OVERFLOW if the buffer cap would be exceeded.
fn tokenize_stream_feed(s, chunk, n) {
    if (s == 0) { return VYK_ERR_OVERFLOW; }
    if (load64(s + 32) == 1) { return VYK_ERR_FINISHED; }
    if (n <= 0) { return VYK_OK; }
    var len = load64(s + 8);
    # Reject an `n` so large that `len + n + 1` wraps i64 negative.
    # A negative `needed` makes _stream_grow's `cap >= needed` test
    # trivially true, so it would return success WITHOUT growing and
    # the copy loop below would run off the end of `buf`. Only a
    # garbage length from the caller gets here, but the failure mode
    # is an unbounded OOB write, so it is worth one compare.
    if (n > VYK_STREAM_CAP) { return VYK_ERR_OVERFLOW; }
    # Refuse bytes that would push any future token's absolute
    # start past the u32 ceiling (see VYK_OFFSET_CAP). abs_offset
    # is the offset of buf[0]; abs_offset + len is the offset one
    # past the live window, so that plus `n` is the highest offset
    # this feed could produce.
    if (load64(s + 48) + len + n > VYK_OFFSET_CAP) {
        return VYK_ERR_OVERFLOW;
    }
    var needed = len + n + 1;   # +1 for trailing NUL
    if (_stream_grow(s, needed) == 0) { return VYK_ERR_OVERFLOW; }
    var buf = load64(s);
    var i = 0;
    while (i < n) {
        store8(buf + len + i, load8(chunk + i));
        i = i + 1;
    }
    store64(s + 8, len + n);
    return VYK_OK;
}

# Returns 1 if the token at index `idx` of `temp_tb` (with src
# bytes in `buf`) is definitively complete — i.e., its trailing
# bytes are at a hard boundary (closing pair-rule marker, line
# break, single-byte fallthrough) and so the token wouldn't
# extend if more bytes arrived. Used by drain to decide whether
# to commit the trailing token even though its end == buf_len.
# Longest marker in the grammar's operator + punctuation tables.
#
# Needed because those tables are matched LONGEST-FIRST, which makes
# the drain's "token ends before buf_len, so it is settled" rule
# false for them. `tests/corpus/concept.md` at chunk=7: a table rule
# `|---|` arriving as `|--` scans to `|`, `-`, `-` — `--` is not a
# markdown operator but `---` is. Both `-` tokens end strictly before
# buf_len, so both were committed, and the third `-` in the next feed
# became a fourth token. One 3-byte `---` came back as three 1-byte
# operators.
#
# An operator token starting at `p` can only grow into a marker that
# starts at `p`, so `p + max_marker <= buf_len` is exactly the point
# where the buffer is known to hold every candidate. Markers are 1-4
# bytes in practice, so this holds back almost nothing.
fn _stream_max_marker(g) {
    var best = 1;
    var ops = grammar_operators(g);
    var n = vec_len(ops);
    var i = 0;
    while (i < n) {
        var l = strlen(vec_get(ops, i));
        if (l > best) { best = l; }
        i = i + 1;
    }
    var pun = grammar_punctuation(g);
    var pn = vec_len(pun);
    var pi = 0;
    while (pi < pn) {
        var pl = strlen(vec_get(pun, pi));
        if (pl > best) { best = pl; }
        pi = pi + 1;
    }
    # Rule START markers count too, and for the same reason. A pair
    # opener arriving one byte short scans as ordinary operators:
    # `tests/corpus/concept.xml` at chunk=3 turned the 287-byte
    # `<!-- ... -->` comment into `<`, `!`, `-`, ... because the
    # buffer held `<!-` and `<!--` is 4 bytes. Committing those
    # operators made the comment unrecoverable — 451 tokens became
    # 689. Pair END markers are included as well: the close is what
    # terminates the span, so the same one-byte-short case applies.
    var prs = grammar_pair_rules(g);
    var rn = vec_len(prs);
    var ri = 0;
    while (ri < rn) {
        var r = vec_get(prs, ri);
        var sl = strlen(pair_rule_start(r));
        if (sl > best) { best = sl; }
        var el = strlen(pair_rule_end(r));
        if (el > best) { best = el; }
        ri = ri + 1;
    }
    var lrs = grammar_line_rules(g);
    var ln = vec_len(lrs);
    var li = 0;
    while (li < ln) {
        var ll = strlen(line_rule_start(vec_get(lrs, li)));
        if (ll > best) { best = ll; }
        li = li + 1;
    }
    var crs = grammar_compose_rules(g);
    var cn = vec_len(crs);
    var ci = 0;
    while (ci < cn) {
        var cl = strlen(compose_rule_start(vec_get(crs, ci)));
        if (cl > best) { best = cl; }
        ci = ci + 1;
    }
    var cfs = grammar_compose_fenced_rules(g);
    var fn2 = vec_len(cfs);
    var fi = 0;
    while (fi < fn2) {
        var fl = strlen(compose_fenced_rule_start(vec_get(cfs, fi)));
        if (fl > best) { best = fl; }
        fi = fi + 1;
    }
    var crr = grammar_compose_region_rules(g);
    var rrn = vec_len(crr);
    var rri = 0;
    while (rri < rrn) {
        var rl = strlen(compose_region_rule_start(vec_get(crr, rri)));
        if (rl > best) { best = rl; }
        rri = rri + 1;
    }
    return best;
}

# Is this pair-kind token still provisional — i.e. could a LONGER
# same-kind opener at the same offset explain it away once more
# bytes arrive?
#
# The scanner falls through when a pair rule opens but its close is
# not in the buffer, so a long opener that cannot close yet quietly
# becomes a short rule's token. Python declares `\"\"\"` ahead of
# `\"`; with the buffer holding exactly `\"\"\"`, the triple rule opens,
# finds no close, and the scanner falls back to `\"` — emitting a
# 2-byte EMPTY string plus a stray quote. That token ends before
# buf_len, so the "settled" rule in the drain committed it, and the
# docstring in `tests/corpus/python.py` came back as
# `""` + body + `""` (1790 tokens vs 1637 at chunk=3).
#
# Comparing min(opener, bytes-available) covers both shapes: an
# opener truncated by the boundary, and an opener fully present but
# unclosed. Only openers strictly LONGER than the token can explain
# it, so a genuine empty string `""` followed by a non-quote is not
# flagged.
fn _stream_pair_provisional(g, buf, buf_len, kind, t_start, t_len) {
    if ((kind != TK_STRING) && (kind != TK_COMMENT) && (kind != TK_PREPROCESSOR)) {
        return 0;
    }
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var avail = buf_len - t_start;
    var i = 0;
    var prov = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (pair_rule_kind(r) == kind) {
            var qstart = pair_rule_start(r);
            var qslen = strlen(qstart);
            if (qslen > t_len) {
                var cmp = qslen;
                if (cmp > avail) { cmp = avail; }
                if (cmp > 0) {
                    if (memeq(buf + t_start, qstart, cmp) == 1) { prov = 1; }
                }
            }
        }
        i = i + 1;
    }
    return prov;
}

fn _stream_is_trailing_complete(g, buf, buf_len, temp_tb, idx) {
    var kind    = tokenbuf_kind(temp_tb, idx);
    var t_start = tokenbuf_start(temp_tb, idx);
    var t_len   = tokenbuf_len(temp_tb, idx);
    # Only pair-rule kinds get the trailing-complete pass.
    # Everything else — operators / punctuation (longest-match
    # tables), idents / keywords / numbers (extending bytes
    # could change the token), whitespace (more whitespace
    # could follow) — must wait. The cost of being wrong on
    # an extending case is mis-tokenization at chunk boundaries,
    # so we err on the side of conservatism: only the pair-rule
    # case (close marker is at the tail; no further bytes can
    # change this token's extent) is safe to commit early.
    # Compose rules emit their END marker as a TK_PUNCTUATION
    # span whose length equals the marker length. If the
    # trailing token IS that close marker, the compose pair
    # just emitted atomically — commit it. Without this,
    # split-at-end-of-compose (e.g. chunk boundary right after
    # `</style>`) would drop the close-marker token, leaving
    # the body bytes already compacted but the compose pair
    # incomplete from streaming's view. 2.2.1 fix; surfaced by
    # the streaming.fcyr `html/compose-style` random-split
    # case at split=29.
    if (kind == TK_PUNCTUATION) {
        var crules = grammar_compose_rules(g);
        var cn = vec_len(crules);
        var ci = 0;
        while (ci < cn) {
            var cr = vec_get(crules, ci);
            var cendp = compose_rule_end(cr);
            var celen = strlen(cendp);
            if ((celen > 0) && (celen == t_len)) {
                if (memeq(buf + t_start, cendp, celen) == 1) {
                    return 1;
                }
            }
            ci = ci + 1;
        }
        # Also check compose_fenced end markers — markdown's
        # ` ``` ` close is emitted as TK_PUNCTUATION via the
        # compose_fenced helper, same shape as compose. Without
        # this, split-at-end-of-fenced-block would drop the
        # close marker, leaving the body already compacted.
        var cfrules = grammar_compose_fenced_rules(g);
        var cfn = vec_len(cfrules);
        var cfi = 0;
        while (cfi < cfn) {
            var cfr = vec_get(cfrules, cfi);
            var cfendp = compose_fenced_rule_end(cfr);
            var cfelen = strlen(cfendp);
            if ((cfelen > 0) && (cfelen == t_len)) {
                if (memeq(buf + t_start, cfendp, cfelen) == 1) {
                    return 1;
                }
            }
            cfi = cfi + 1;
        }
        return 0;
    }
    if ((kind == TK_STRING) || (kind == TK_COMMENT) || (kind == TK_PREPROCESSOR)) {
        var rules = grammar_pair_rules(g);
        var n = vec_len(rules);

        # Find the rule that actually OPENED this token — the first
        # same-kind pair rule whose start marker matches at t_start,
        # mirroring the scanner's own first-match-wins order.
        #
        # Checking every same-kind rule instead (as this did through
        # 2.3.5) lets a short rule vouch for a long rule's token.
        # Python declares `"""` ahead of `"`; a docstring arriving as
        # just its opener `"""` failed the triple-quote test
        # (t_len 3 < slen+elen 6) and then PASSED the single-quote
        # test — 3 >= 1+1, and the opener's last byte is `"`, which
        # is that rule's end marker. The bare `"""` was committed as a
        # finished string and the docstring body came back as idents:
        # `tests/corpus/python.py` at chunk=3, 1790 tokens vs 1637.
        var owner = 0;
        var oi = 0;
        while ((oi < n) && (owner == 0)) {
            var r = vec_get(rules, oi);
            if (pair_rule_kind(r) == kind) {
                var startm = pair_rule_start(r);
                var slen = strlen(startm);
                if ((slen > 0) && (slen <= t_len)) {
                    if (memeq(buf + t_start, startm, slen) == 1) { owner = r; }
                }
            }
            oi = oi + 1;
        }

        # Before trusting `owner`, make sure a LONGER same-kind
        # opener could not match at this same offset once more bytes
        # arrive. If the bytes we have are a proper prefix of some
        # longer opener, this tokenization is provisional.
        #
        # `tests/corpus/python.py`: at the drain whose buffer ends
        # `\n    ""`, the 3-byte `\"\"\"` opener cannot match on 2
        # bytes, so the scanner falls to the 1-byte `\"` rule and
        # emits a 2-byte EMPTY string. That token looks genuinely
        # closed — `2 >= 1+1`, last byte is its own close marker — so
        # it was committed and the docstring came back as
        # `""` + body + `""`. One more byte makes it a `\"\"\"`
        # opener instead.
        #
        # Testing exactly this (rather than a blanket "hold anything
        # near the tail") keeps the 2.2.1 compose-close case working:
        # that token is TK_PUNCTUATION and never reaches here.
        if (_stream_pair_provisional(g, buf, buf_len, kind, t_start, t_len) == 1) {
            return 0;
        }

        if (owner != 0) {
            var ostartm = pair_rule_start(owner);
            var oslen = strlen(ostartm);
            var oendp = pair_rule_end(owner);
            var oelen = strlen(oendp);
            # Minimum-complete length is start + end. Without this,
            # an opening `"` (slen=1) at a chunk boundary looks
            # complete because its tail trivially matches the closing
            # `"` (elen=1) — the same byte. Streaming would commit a
            # 1-byte string; the real close on the next feed would
            # then read as a SECOND opener. Caught by 2.1.4's
            # fuzz/streaming.fcyr c/string-with-escape case.
            if ((oelen > 0) && (t_len >= oslen + oelen)) {
                if (memeq(buf + t_start + t_len - oelen, oendp, oelen) == 1) {
                    return 1;
                }
            }
            # Owned by a pair rule but not closed — it can still grow.
            return 0;
        }

        # No pair rule owns it, so it came from a line rule (line
        # comment) or the shebang default. There the LF is the
        # unambiguous terminator: if the trailing token ends in LF,
        # more bytes cannot extend it.
        #
        # This must not fire for pair tokens that merely contain a
        # newline at the boundary — through 2.3.5 it did, and a block
        # comment split right after a newline committed early.
        # `tests/corpus/concept.css` at chunk=3 opens with `/*\n`:
        # the pair test declined, then the bare-LF test committed a
        # 3-byte "comment" and the remaining 341 bytes of the header
        # were re-tokenized as CSS. The `owner != 0` early return
        # above is what now keeps pair tokens out of this path.
        if ((t_len > 0) && (load8(buf + t_start + t_len - 1) == 10)) {
            return 1;
        }
    }
    return 0;
}

# Find which pair rule emitted a token at `[start, start+len)`
# in `buf`. Used to detect what to look for when the trailing
# token is a partial pair-rule open. Returns rule index, or -1
# if no pair rule's start marker matches the leading bytes.
# Returns the number of trailing buffer bytes to hold so that
# compose-rule routing isn't lost across chunk boundaries.
# Two cases covered:
#
# (a) **Trailing prefix of a compose START marker** — chunk
#     boundary lands INSIDE a marker (e.g. `<sty` of
#     `<style>`). Without holding, the leading byte (`<`)
#     commits as an ordinary token; on the next feed the
#     marker is no longer recognizable.
#
# (b) **Full start marker matched, no end marker yet** — open
#     fully present in the buffer, but the corresponding
#     close (`</style>`, etc.) hasn't arrived. Same hazard:
#     bytes inside the start marker would commit before
#     compose can route the body.
#
# Returns the count of trailing bytes that must be held back
# from commit. Caller compares each token's `start + len` to
# `buf_len - hold` and drops tokens whose extent overlaps the
# held region.
#
# Cost: O(rules × buf_len). Worst case is many compose rules
# (HTML has 2; Vue has 2; markdown has 1 compose_fenced); per-
# call cost is O(buf_len) per rule. Acceptable against the
# rescan-and-commit baseline which already pays O(buf_len).
# Filed as FINDING-011's fix in the 2.1.5 audit; surfaced by
# the 2.1.4 streaming.fcyr random-split cases.
# 2.2.1 — `temp_tb` is the just-scanned token sequence; we use
# it to recognize emitted compose markers and avoid treating
# them as "candidate openers". For markdown's `` ``` `` (open
# and close are the same string), case (b) would otherwise loop
# forever: every emitted close marker looks like a fresh open
# with no following close.
fn _stream_compose_prefix_hold(g, buf, buf_len, temp_tb, n_temp) {
    var max_hold = 0;

    var rules = grammar_compose_rules(g);
    var n = vec_len(rules);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        var startm = compose_rule_start(r);
        var slen = strlen(startm);
        var endp = compose_rule_end(r);
        var elen = strlen(endp);

        # Case (a): trailing prefix of start marker.
        var j = slen - 1;
        if (j > buf_len) { j = buf_len; }
        var found = 0;
        while ((j > 0) && (found == 0)) {
            if (memeq(buf + buf_len - j, startm, j) == 1) {
                found = 1;
                if (j > max_hold) { max_hold = j; }
            }
            if (found == 0) { j = j - 1; }
        }

        # Case (b): full start matched somewhere; no end after.
        # Skip positions that are the start of an emitted
        # TK_PUNCTUATION token (those bytes are claimed by an
        # already-emitted compose pair — opener or closer).
        if ((slen > 0) && (slen <= buf_len)) {
            var k = 0;
            var k_limit = buf_len - slen;
            while (k <= k_limit) {
                # Order matters for cost, not for meaning. Both
                # conditions must hold — "k is not inside an already
                # emitted TK_PUNCTUATION token" AND "the start marker
                # is at k" — but the emitted-check is O(n_temp) while
                # the memeq is O(slen) and fails on the first byte
                # almost everywhere. Testing memeq FIRST turns this
                # loop from O(buf_len x n_temp) into O(buf_len x slen)
                # plus O(matches x n_temp), with matches ~0.
                #
                # This loop runs per compose rule, twice per drain,
                # and the buffer does not compact while a compose
                # opener is held — so the old ordering compounded to
                # roughly O(N^2.9). Measured before this change:
                # 1,113 B of HTML with a <style> block took 196 ms at
                # chunk=64, 2,169 B took 1.49 s, 4,281 B took 11.4 s.
                if (memeq(buf + k, startm, slen) == 1) {
                    var k_emitted = 0;
                    var ti = 0;
                    while ((ti < n_temp) && (k_emitted == 0)) {
                        if (tokenbuf_kind(temp_tb, ti) == TK_PUNCTUATION) {
                            var ts = tokenbuf_start(temp_tb, ti);
                            var tl = tokenbuf_len(temp_tb, ti);
                            if ((k >= ts) && (k < ts + tl)) {
                                k_emitted = 1;
                            }
                        }
                        ti = ti + 1;
                    }
                    if (k_emitted == 0) {
                        var end_search_from = k + slen;
                        var end_pos = (0 - 1);
                        var ep = end_search_from;
                        while ((ep + elen <= buf_len) && (end_pos < 0)) {
                            if (memeq(buf + ep, endp, elen) == 1) {
                                end_pos = ep;
                            }
                            if (end_pos < 0) { ep = ep + 1; }
                        }
                        if (end_pos < 0) {
                            var hold_from_start = buf_len - k;
                            if (hold_from_start > max_hold) {
                                max_hold = hold_from_start;
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }

    var fenced = grammar_compose_fenced_rules(g);
    var nf = vec_len(fenced);
    var fi = 0;
    while (fi < nf) {
        var fr = vec_get(fenced, fi);
        var fstartm = compose_fenced_rule_start(fr);
        var fslen = strlen(fstartm);
        var fendp = compose_fenced_rule_end(fr);
        var felen = strlen(fendp);

        # (a) Trailing prefix of fenced start marker.
        var fj = fslen - 1;
        if (fj > buf_len) { fj = buf_len; }
        var ffound = 0;
        while ((fj > 0) && (ffound == 0)) {
            if (memeq(buf + buf_len - fj, fstartm, fj) == 1) {
                ffound = 1;
                if (fj > max_hold) { max_hold = fj; }
            }
            if (ffound == 0) { fj = fj - 1; }
        }

        # (b) Full fenced start matched; no end yet. Skip
        # positions inside emitted TK_PUNCTUATION tokens.
        if ((fslen > 0) && (fslen <= buf_len)) {
            var fk = 0;
            var fk_limit = buf_len - fslen;
            while (fk <= fk_limit) {
                var fk_emitted = 0;
                var fti = 0;
                while ((fti < n_temp) && (fk_emitted == 0)) {
                    if (tokenbuf_kind(temp_tb, fti) == TK_PUNCTUATION) {
                        var fts = tokenbuf_start(temp_tb, fti);
                        var ftl = tokenbuf_len(temp_tb, fti);
                        if ((fk >= fts) && (fk < fts + ftl)) {
                            fk_emitted = 1;
                        }
                    }
                    fti = fti + 1;
                }
                if (fk_emitted == 0) {
                    if (memeq(buf + fk, fstartm, fslen) == 1) {
                        var fend_search_from = fk + fslen;
                        var fend_pos = (0 - 1);
                        var fep = fend_search_from;
                        while ((fep + felen <= buf_len) && (fend_pos < 0)) {
                            if (memeq(buf + fep, fendp, felen) == 1) {
                                fend_pos = fep;
                            }
                            if (fend_pos < 0) { fep = fep + 1; }
                        }
                        if (fend_pos < 0) {
                            var fhold = buf_len - fk;
                            if (fhold > max_hold) { max_hold = fhold; }
                        }
                    }
                }
                fk = fk + 1;
            }
        }
        fi = fi + 1;
    }

    # Bound the hold — see VYK_COMPOSE_HOLD_MAX. Returning 0 rather
    # than a clamped value is deliberate: a partial hold would still
    # straddle the opener and keep the buffer pinned. Zero lets the
    # commit loop run normally, the buffer compacts, and the stream
    # keeps making progress.
    if (max_hold > VYK_COMPOSE_HOLD_MAX) { return 0; }
    return max_hold;
}

fn _stream_find_pair_rule(g, buf, start, len, kind) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (pair_rule_kind(r) == kind) {
            var startm = pair_rule_start(r);
            var slen = strlen(startm);
            if ((slen > 0) && (slen <= len)) {
                if (memeq(buf + start, startm, slen) == 1) { return i; }
            }
        }
        i = i + 1;
    }
    return (0 - 1);
}

# Look for `endp` in `buf[from..buf_len]`. Honours the pair
# rule's escape byte. Returns close-position offset or -1.
fn _stream_scan_close(buf, buf_len, from, endp, elen, escape) {
    # Defensive: `elen <= 0` (empty / null close marker) would
    # cause the memeq check to vacuously succeed at `from`,
    # producing a zero-length token. Pair-rule grammars
    # shouldn't emit empty markers but the loader doesn't
    # currently enforce it. Per FINDING-009, 2.0.4 audit.
    if (elen <= 0) { return (0 - 1); }
    var j = from;
    while (j + elen <= buf_len) {
        if ((escape != 0) && (load8(buf + j) == escape)) {
            j = j + 2;
            continue;
        }
        if (memeq(buf + j, endp, elen) == 1) { return j; }
        j = j + 1;
    }
    return (0 - 1);
}

# Drain tokens whose spans are fully present in the buffer.
# Re-scans the current buffer with `tokenize_with_grammar`,
# commits all tokens whose end < buf_len (in feed mode) or every
# token (in finish mode), then compacts the buffer by sliding
# unconsumed bytes to offset 0. Returns the count appended to
# `out_tb` by this call.
#
# Why rescan-and-commit? It reuses the existing scanner without
# requiring a state-machine refactor, at the cost of O(buf_len)
# per drain. The trailing partial token (string with no close,
# block comment without `*/`, etc.) is always dropped in feed
# mode — its bytes stay in the buffer, gets re-scanned next
# drain after more bytes arrive. finish() lifts this constraint
# and commits everything including the tail.
fn tokenize_stream_drain(s, out_tb) {
    if (s == 0) { return 0; }
    # 2.0.2: caller passes 0 to mean "use the internal staging
    # tokenbuf". Lets the pull-adapter use site
    # (`tokenize_stream_finish(s, 0)` followed by `_next`) work
    # without the caller having to fish the staging out.
    if (out_tb == 0) { out_tb = load64(s + 56); }
    var buf = load64(s);
    var buf_len = load64(s + 8);
    var g = load64(s + 24);
    var finishing = load64(s + 32);
    var abs_offset = load64(s + 48);
    var pending_idx = load64(s + 72);
    if (buf_len == 0) { return 0; }

    var emitted = 0;

    # 2.0.3 fast path — pending pair rule from a previous drain.
    # The buffer's first bytes are the open marker; the body has
    # been growing across feeds. Skip the full scanner and look
    # only for the close marker, advancing scan_resume so we
    # never re-scan body bytes already known not to contain it.
    # Drops the pathological "open span across many chunks" case
    # from O(N²) to O(N).
    if (pending_idx >= 0) {
        var rule = vec_get(grammar_pair_rules(g), pending_idx);
        var endp = pair_rule_end(rule);
        var elen = strlen(endp);
        var escape = pair_rule_escape(rule);
        var startm = pair_rule_start(rule);
        var slen = strlen(startm);
        var resume = load64(s + 80);
        if (resume < slen) { resume = slen; }
        var close_pos = _stream_scan_close(buf, buf_len, resume, endp, elen, escape);
        if (close_pos >= 0) {
            var pair_total = close_pos + elen;
            tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, pair_total);
            emitted = emitted + 1;
            store64(s + 72, (0 - 1));
            store64(s + 80, 0);
            var k0 = pair_total;
            var dst0 = 0;
            while (k0 < buf_len) {
                store8(buf + dst0, load8(buf + k0));
                dst0 = dst0 + 1;
                k0 = k0 + 1;
            }
            buf_len = buf_len - pair_total;
            abs_offset = abs_offset + pair_total;
            store64(s + 8, buf_len);
            store64(s + 48, abs_offset);
            if (buf_len == 0) { return emitted; }
        }
        if (close_pos < 0) {
            # Still pending. Cache new scan-resume — backing off
            # `elen - 1` so a close marker straddling this
            # buffer's tail and the next feed isn't missed.
            var new_resume = buf_len;
            if (elen > 0) {
                if (new_resume > elen - 1) { new_resume = new_resume - (elen - 1); }
            }
            # ...and back off over a trailing RUN of escape bytes, so
            # an escape pair split across the feed boundary is
            # re-scanned as a pair instead of half-seen.
            #
            # Without this, a single-byte close marker (JSON/most
            # string rules: endp = "\"", elen = 1) gets `elen - 1`
            # = 0 back-off, i.e. none. A buffer ending on `\` then
            # resumed at exactly buf_len sees the next feed's `"`
            # with its escaping backslash already behind the resume
            # point, closes the string on an ESCAPED quote, and
            # mis-tokenizes everything after it. Reproduced on
            # `tests/corpus/concept.json` at chunk=3: the string
            # `"Scanning until '\"' - breaks on escaped quotes"`
            # came back as a 19-byte token instead of 50.
            #
            # Backing off over the whole run (not just one byte) is
            # what makes it sound: `\\` is an escaped backslash, so
            # resuming one byte in would mis-pair it. The byte before
            # a maximal escape run is by definition not an escape, so
            # the run start always begins a fresh pair — scanning
            # from there matches scanning from the token start. Runs
            # are short, so this stays O(N).
            if (escape != 0) {
                while ((new_resume > slen) &&
                  (load8(buf + new_resume - 1) == escape)) {
                    new_resume = new_resume - 1;
                }
            }
            if (new_resume < slen) { new_resume = slen; }
            store64(s + 80, new_resume);
            if (finishing == 1) {
                tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, buf_len);
                store64(s + 72, (0 - 1));
                store64(s + 80, 0);
                store64(s + 8, 0);
                store64(s + 48, abs_offset + buf_len);
                return emitted + 1;
            }
            return emitted;
        }
    }

    # NUL-terminate the live buffer so the inner scanner's
    # strlen-shaped checks see the correct end.
    store8(buf + buf_len, 0);
    var temp_tb = tokenbuf_new();
    tokenize_with_grammar(g, buf, buf_len, temp_tb);
    var n_temp = tokenbuf_count(temp_tb);
    var commit_count = n_temp;
    # `_stream_compose_prefix_hold` is called from two sibling
    # blocks below with IDENTICAL arguments — `buf`, `buf_len`,
    # `temp_tb` and `n_temp` are all unchanged between them — so
    # the second call recomputed the first's answer. It is the most
    # expensive thing in the drain, so that was a flat 2x on every
    # drain of every compose grammar. Cache it here, at a scope
    # that encloses both uses. (0 - 1) means "not computed yet";
    # a real hold is always >= 0.
    var ph_cache = (0 - 1);
    if (finishing == 0) {
        commit_count = 0;
        # The marker window (below) is applied only to grammars with
        # NO compose rules of any kind.
        #
        # Why the carve-out: holding a token back from this drain's
        # commit list is safe on its own, but the compose machinery
        # reads the commit list as state. `skip_prefix_hold` asks
        # "was the last COMMITTED token a compose close marker?" to
        # stop prefix-hold case (a) mistaking a just-emitted ` ``` `
        # for the prefix of a fresh opener. Hold the marker back and
        # that guard misses, prefix-hold drops the close token, and
        # `fuzz/streaming.fcyr`'s markdown/fence-rust case loses a
        # token. Three attempts at reconciling the two (exempting
        # compose markers from the window; keying the guard to a
        # pre-window commit boundary) each broke something else, so
        # per CLAUDE.md §Refactoring policy this is scoped rather
        # than forced.
        #
        # The carve-out costs little: compose grammars are markdown,
        # html, vue, svelte and cyml. Every other grammar — rust, go,
        # python, c, java, … — gets the window and with it
        # chunk-invariance. The compose five remain divergent and are
        # tracked in `docs/development/state.md` §Next up.
        var has_compose = 0;
        if (vec_len(grammar_compose_rules(g)) > 0) { has_compose = 1; }
        if (vec_len(grammar_compose_fenced_rules(g)) > 0) { has_compose = 1; }
        if (vec_len(grammar_compose_region_rules(g)) > 0) { has_compose = 1; }
        var max_marker = 0;
        if (has_compose == 0) { max_marker = _stream_max_marker(g); }
        var i = 0;
        var stop = 0;
        while ((i < n_temp) && (stop == 0)) {
            var t_start = tokenbuf_start(temp_tb, i);
            var t_len   = tokenbuf_len(temp_tb, i);
            var t_kind  = tokenbuf_kind(temp_tb, i);
            var safe = 0;
            if (t_start + t_len < buf_len) { safe = 1; }
            # ...and the whole marker window has to be in the buffer,
            # for EVERY kind, not just the longest-match tables. Any
            # token within `max_marker` of the tail may turn out to
            # be the first bytes of a rule opener once more input
            # arrives — that is how xml's `<!--` comment was lost.
            # Holds back at most `max_marker` bytes per drain.
            if (t_start + max_marker > buf_len) { safe = 0; }
            # A pair token a longer opener could still claim is not
            # settled either, no matter where it ends — this is the
            # path that actually committed python's stray `""`.
            if (_stream_pair_provisional(g, buf, buf_len, t_kind, t_start, t_len) == 1) {
                safe = 0;
            }
            if (safe == 1) { commit_count = i + 1; }
            if (safe == 0) { stop = 1; }
            i = i + 1;
        }
        if ((commit_count < n_temp) && (n_temp > 0)) {
            if (_stream_is_trailing_complete(g, buf, buf_len, temp_tb, n_temp - 1) == 1) {
                commit_count = n_temp;
            }
        }
        # 2.2.1 (FINDING-011 fix): hold any trailing bytes that
        # match a prefix of a compose-rule START marker. Drop
        # tokens whose extent overlaps with the held region —
        # they'll be re-scanned next drain when the rest of the
        # marker arrives.
        #
        # Skip when the last *already-committed* token is a
        # TK_PUNCTUATION matching a compose end marker — those
        # bytes are claimed by the just-emitted compose pair,
        # not a partial upcoming open. Without this guard, the
        # prefix-hold case (a) sees a complete close marker
        # like `` ``` `` (markdown) as a "prefix of next
        # open" and drops the close-marker token. Test surfaced
        # this at the streaming.fcyr markdown/fence-rust
        # split=28 case.
        var skip_prefix_hold = 0;
        if (commit_count > 0) {
            var lct_kind  = tokenbuf_kind(temp_tb, commit_count - 1);
            var lct_start = tokenbuf_start(temp_tb, commit_count - 1);
            var lct_len   = tokenbuf_len(temp_tb, commit_count - 1);
            if (lct_kind == TK_PUNCTUATION) {
                # Compose end?
                var ccr = grammar_compose_rules(g);
                var ccn = vec_len(ccr);
                var cci = 0;
                while ((cci < ccn) && (skip_prefix_hold == 0)) {
                    var ccrule = vec_get(ccr, cci);
                    var cce = compose_rule_end(ccrule);
                    var ccl = strlen(cce);
                    if ((ccl > 0) && (ccl == lct_len)) {
                        if (memeq(buf + lct_start, cce, ccl) == 1) {
                            skip_prefix_hold = 1;
                        }
                    }
                    cci = cci + 1;
                }
                # Compose_fenced end?
                var cfr = grammar_compose_fenced_rules(g);
                var cfn = vec_len(cfr);
                var cfi = 0;
                while ((cfi < cfn) && (skip_prefix_hold == 0)) {
                    var cfrule = vec_get(cfr, cfi);
                    var cfe = compose_fenced_rule_end(cfrule);
                    var cfl = strlen(cfe);
                    if ((cfl > 0) && (cfl == lct_len)) {
                        if (memeq(buf + lct_start, cfe, cfl) == 1) {
                            skip_prefix_hold = 1;
                        }
                    }
                    cfi = cfi + 1;
                }
            }
        }
        if (skip_prefix_hold == 0) {
            if (ph_cache < 0) {
                ph_cache = _stream_compose_prefix_hold(g, buf, buf_len, temp_tb, n_temp);
            }
            var prefix_hold = ph_cache;
            if (prefix_hold > 0) {
                var safe_end = buf_len - prefix_hold;
                var ph_done = 0;
                while ((commit_count > 0) && (ph_done == 0)) {
                    var last = commit_count - 1;
                    var ts = tokenbuf_start(temp_tb, last);
                    var tl = tokenbuf_len(temp_tb, last);
                    if (ts + tl <= safe_end) { ph_done = 1; }
                    if (ph_done == 0) { commit_count = commit_count - 1; }
                }
            }
        }
    }
    # Count what actually landed, not what we attempted.
    # `tokenbuf_push` drops the token (rather than writing through a
    # NULL data pointer) when its buffer cannot grow — see
    # FINDING-002 in src/token.cyr. Incrementing `emitted`
    # unconditionally made drain over-report under that condition,
    # and `emitted` is what the caller uses to decide whether more
    # tokens are available. Comparing the count across the loop
    # keeps the return honest without giving `tokenbuf_push` a
    # status return it is not allowed to have (public surface).
    var before_push = tokenbuf_count(out_tb);
    var j = 0;
    while (j < commit_count) {
        tokenbuf_push(out_tb,
          tokenbuf_kind(temp_tb, j),
          abs_offset + tokenbuf_start(temp_tb, j),
          tokenbuf_len(temp_tb, j));
        j = j + 1;
    }
    emitted = emitted + (tokenbuf_count(out_tb) - before_push);
    # 2.0.3 — detect pending pair-rule state for the NEXT drain.
    # If a trailing partial pair-rule open is uncommitted, save
    # its rule index + how far we've already scanned the body.
    var new_pending = (0 - 1);
    var new_resume2 = 0;
    if ((finishing == 0) && (commit_count < n_temp) && (n_temp > 0)) {
        var partial = commit_count;
        var p_kind  = tokenbuf_kind(temp_tb, partial);
        var p_start = tokenbuf_start(temp_tb, partial);
        var p_len   = tokenbuf_len(temp_tb, partial);
        # 2.2.1: don't set pair-pending if prefix-hold has
        # already marked the trailing region for compose
        # recognition. Without this guard, a `\`` from a pair-
        # rule fallthrough at chunk boundary would set
        # pair-pending, and the pair fast path would beat
        # compose_fenced on subsequent drains (matching the
        # nearest backtick instead of waiting for the full
        # ` ``` ` open marker). Surfaced by streaming.fcyr's
        # markdown/fence-rust random-split case.
        var hold_overlaps = 0;
        if (ph_cache < 0) {
            ph_cache = _stream_compose_prefix_hold(g, buf, buf_len, temp_tb, n_temp);
        }
        var prefix_hold2 = ph_cache;
        if (prefix_hold2 > 0) {
            var hold_start = buf_len - prefix_hold2;
            if (p_start >= hold_start) { hold_overlaps = 1; }
        }
        # Don't pin a pending rule while a LONGER same-kind opener
        # could still claim these bytes. `_stream_find_pair_rule`
        # only considers rules whose start marker fits inside the
        # partial token, so a lone trailing `\"` matches Python's
        # 1-byte `\"` rule even when the real opener is `\"\"\"`. The
        # next drain then took the pending fast path, found a close
        # one byte later, and emitted a 2-byte EMPTY string —
        # `tests/corpus/python.py`'s docstring came back as
        # `""` + body + `""`. This is the path that actually did it;
        # the commit loop never got a say.
        #
        # Leaving pending unset just means the bytes stay buffered
        # and get re-tokenized next drain, which is what we want.
        var pending_ambiguous = _stream_pair_provisional(g, buf, buf_len, p_kind, p_start, p_len);
        # Never pend a pair token that is ALREADY CLOSED. The
        # marker window can hold a complete token back from this
        # drain's commit list; without this check the pending logic
        # read that complete token as a partial OPEN and set
        # `scan_resume` to its full length — i.e. past its own close
        # marker. The next drain then scanned from beyond the close
        # and matched the NEXT quote instead.
        #
        # `tests/corpus/concept.rb`: ruby's `=begin` block-comment
        # marker makes max_marker 6, so a complete `'+'` sitting
        # within 6 bytes of the tail was held; resume jumped to 3,
        # past the closing quote at index 2, and the string ran on to
        # the next `'` 45 bytes later — swallowing
        # `then @pos += 1; return Token.new(PLUS,   `.
        if (_stream_is_trailing_complete(g, buf, buf_len, temp_tb, partial) == 1) {
            pending_ambiguous = 1;
        }
        if ((hold_overlaps == 0) && (pending_ambiguous == 0) && ((p_kind == TK_STRING) || (p_kind == TK_COMMENT) || (p_kind == TK_PREPROCESSOR))) {
            var rule_idx = _stream_find_pair_rule(g, buf, p_start, p_len, p_kind);
            if (rule_idx >= 0) {
                new_pending = rule_idx;
                var rule_r = vec_get(grammar_pair_rules(g), rule_idx);
                var endp_r = pair_rule_end(rule_r);
                var elen_r = strlen(endp_r);
                var slen_r = strlen(pair_rule_start(rule_r));
                new_resume2 = p_len;
                if (elen_r > 0) {
                    if (new_resume2 > elen_r - 1) { new_resume2 = new_resume2 - (elen_r - 1); }
                }
                if (new_resume2 < slen_r) { new_resume2 = slen_r; }
            }
        }
    }
    store64(s + 72, new_pending);
    store64(s + 80, new_resume2);
    var consumed = 0;
    if (commit_count > 0) {
        var last = commit_count - 1;
        consumed = tokenbuf_start(temp_tb, last) + tokenbuf_len(temp_tb, last);
    }
    if (consumed > 0) {
        var k = consumed;
        var dst = 0;
        while (k < buf_len) {
            store8(buf + dst, load8(buf + k));
            dst = dst + 1;
            k = k + 1;
        }
        store64(s + 8,  buf_len - consumed);
        store64(s + 48, abs_offset + consumed);
    }
    return emitted;
}

# Mark the stream as finished and emit every remaining token
# into `out_tb`. After finish, feed returns VYK_ERR_FINISHED;
# drain becomes a no-op (cursor == buf_len after the final
# compaction).
fn tokenize_stream_finish(s, out_tb) {
    if (s == 0) { return 0; }
    if (load64(s + 32) == 1) { return 0; }
    store64(s + 32, 1);
    return tokenize_stream_drain(s, out_tb);
}

# ── Pull adapter (2.0.2+) ────────────────────
# Iterator-style wrapper over the push primitive. Each call to
# tokenize_stream_next(s) advances the internal cursor by one
# token, refilling the staging tokenbuf via `_drain` if
# exhausted. Read the just-advanced-to token with the trio of
# stream-level accessors.
#
# Typical use:
#
#     var s = tokenize_stream_new("rust");
#     # push bytes (one or more times)
#     tokenize_stream_feed(s, src, n);
#     tokenize_stream_finish(s, 0);   # drain happens internally
#     while (tokenize_stream_next(s) == 1) {
#         var k = tokenize_stream_kind(s);
#         var p = tokenize_stream_start(s);
#         var l = tokenize_stream_len(s);
#         # ... use the token ...
#     }
#     tokenize_stream_free(s);
#
# The `0` arg to `_finish` (and `_drain`) signals "no
# caller-supplied tokenbuf; drain to the staging tokenbuf".
# For interleaved feed + iterate flows, the caller can call
# `_next` between feeds without ever calling `_finish` until
# they're done with input.

# Advance to the next token. If the staging tokenbuf is
# exhausted, drains into it from the underlying push primitive.
# Returns 1 if a token is now current (use _kind / _start /
# _len to read it); returns 0 if no token is available right
# now — caller should feed more bytes (then retry) or call
# `_finish` and retry to consume any final tokens.
fn tokenize_stream_next(s) {
    if (s == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64);
    if (idx >= tokenbuf_count(staging)) {
        # Try to refill via drain. If finish has run, drain is a
        # no-op; the caller has reached EOF.
        tokenize_stream_drain(s, staging);
        if (idx >= tokenbuf_count(staging)) { return 0; }
    }
    store64(s + 64, idx + 1);
    return 1;
}

# Read the kind of the *current* token (the one most recently
# returned by `_next == 1`). Calling before the first successful
# `_next`, or after `_free`, is a caller error and yields 0 — it
# used to yield a crash.
#
# `_next` already guards `s == 0` and `_discard_consumed` already
# guards `staging == 0` (2.1.5 audit); these three accessors were
# the gap. Unguarded they did `load64(0 + 56)` on a NULL stream,
# `tokenbuf_kind(0, ...)` on a freed one, and — before the first
# `_next` — indexed `idx = -1`, reading 12 bytes BEFORE the
# tokenbuf allocation. Returning 0 cannot break a correct consumer,
# which by definition never reaches these paths.
fn _stream_cur_ok(s) {
    if (s == 0) { return 0; }
    if (load64(s + 56) == 0) { return 0; }
    if (load64(s + 64) <= 0) { return 0; }
    return 1;
}

fn tokenize_stream_kind(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_kind(staging, idx);
}

fn tokenize_stream_start(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_start(staging, idx);
}

fn tokenize_stream_len(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_len(staging, idx);
}

# Drop tokens already iterated past via `_next` from the
# pull-adapter's internal staging tokenbuf (2.1.4+). For long-
# running streams (millions of tokens), the staging grows
# monotonically by default — calling this periodically keeps
# the memory footprint bounded by "tokens iterated since last
# discard" instead of "all tokens since stream creation".
#
# After the call, `_next` continues from the (now-zero) cursor;
# subsequent `_next` calls drain into a smaller staging that's
# trimmed to just the un-iterated tail.
#
# No-op if no tokens have been iterated yet.
fn tokenize_stream_discard_consumed(s) {
    if (s == 0) { return 0; }
    var staging = load64(s + 56);
    # Defensive (2.1.5 audit recommendation): guard against
    # use-after-free where `_free` zeroed the staging field.
    # Without this `tokenbuf_drop_front(0, ...)` would crash on
    # `load64(tb + 8)`. Cheap one-line check; matches the null-
    # safety pattern in the rest of the streaming primitive.
    if (staging == 0) { return 0; }
    var consumed = load64(s + 64);
    if (consumed <= 0) { return 0; }
    tokenbuf_drop_front(staging, consumed);
    store64(s + 64, 0);
    return consumed;
}

# ── Internal: M1 hand-coded shell path ────────
# Retained as a regression oracle for `vyk --handcoded` and
# smoke.sh's byte-identical diff check. NOT part of the public
# 2.0+ API surface — diagnostics only.

fn tokenize_source_handcoded(src, lang) {
    if (streq(lang, "shell") == 1) {
        var tb = tokenbuf_new();
        tokenize_shell(src, strlen(src), tb);
        return tb;
    }
    return 0;
}

# Release the stream's internal buffer. The caller-owned tokenbuf
# (passed to drain/finish) is NOT freed — it's the caller's
# responsibility. Stream handle is invalid after free.
fn tokenize_stream_free(s) {
    if (s == 0) { return 0; }
    # No-op for the buffer alloc — Cyrius's bump allocator doesn't
    # free individual allocations. Future allocator backends can
    # free the buf here.
    store64(s,      0);
    store64(s + 8,  0);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);   # staging_tb (2.0.2)
    store64(s + 64, 0);   # next_idx
    # pending_idx's "none" sentinel is -1, NOT 0 — 0 is a valid
    # pair-rule index. Every other field here poisons safely to 0,
    # and two call sites lean on that ("_free zeroes every field"
    # in _stream_grow; the staging guard in _discard_consumed), so
    # this one must poison to its own inert value or the poison
    # contract is a half-truth. Currently unreachable — drain's
    # `buf_len == 0` early return and _stream_grow's `cap <= 0`
    # guard both fire first on a freed record — but relaxing
    # either would expose vec_get(pair_rules, 0) on a NULL grammar.
    store64(s + 72, (0 - 1));   # pending_idx (2.0.3)
    store64(s + 80, 0);   # scan_resume
    return 0;
}

# --- detect.cyr ---

# vyakarana — language detection (path-based + content-based)
#
# Three entry points:
#
#   detect_language(path)
#       Pure path dispatch — extension and basename matching.
#       Returns a language name (string literal) or 0. Same shape
#       as the function that lived in `src/main.cyr` through 1.11.1.
#
#   detect_language_from_content(src, src_len)
#       Pure content sniff — UTF-8 BOM strip, shebang interp
#       lookup, signature peek (`<?xml`, `<!DOCTYPE html>`).
#       Returns a language name or 0. Used by extensionless files
#       and by consumers that have bytes but no path.
#
#   detect_language_combined(path, src, src_len)
#       Path first; if path resolves to a known-ambiguous name
#       (today: `asm_x86_64` from a `.s`/`.S` extension) the
#       content sniff picks the actual flavor. If path returns 0,
#       falls through to the content sniff. Returns a language
#       name or 0. This is what `vyk` uses on the CLI.
#
# Public surface for downstream consumers (1.11.2+). Bundled in
# `dist/vyakarana.cyr` via `[lib] modules`. See ADR 0015 for the
# scope of what counts as "content sniffing" — deliberately narrow
# (a few well-known signatures + the asm flavor split). Anything
# heavier (Yara-style fingerprinting, full lexical voting) is out.

# ── Path dispatch ───────────────────────────
# Extension and basename matching. Pure cstr suffix tests; no I/O.

# Length-bucketed helpers — Cyrius caps each function at 64
# returns; splitting by suffix length keeps every helper well
# under the cap while preserving first-match-wins ordering.
# The dispatcher in `detect_language` calls them in length order
# matching the original sequence (longest extensions first
# would alter behaviour for `.markdown` vs `.md`, etc.).

fn _detect_short(path, n) {
    if (n >= 3) {
        if (memeq(path + n - 3, ".sh", 3) == 1) { return "shell"; }
    }
    if (n >= 2) {
        if (memeq(path + n - 2, ".c", 2) == 1) { return "c"; }
        if (memeq(path + n - 2, ".h", 2) == 1) { return "c"; }
        # `.s` / `.S` ambiguous between asm_x86_64 and asm_aarch64.
        # `detect_language_combined` resolves the ambiguity via
        # content sniff. Path-only callers default to x86_64.
        if (memeq(path + n - 2, ".s", 2) == 1) { return "asm_x86_64"; }
        if (memeq(path + n - 2, ".S", 2) == 1) { return "asm_x86_64"; }
    }
    if (n >= 3) {
        if (memeq(path + n - 3, ".hs", 3) == 1) { return "haskell"; }
        if (memeq(path + n - 3, ".ll", 3) == 1) { return "llvm_ir"; }
        if (memeq(path + n - 3, ".rs", 3) == 1) { return "rust"; }
        if (memeq(path + n - 3, ".md", 3) == 1) { return "markdown"; }
        if (memeq(path + n - 3, ".ts", 3) == 1) { return "typescript"; }
        if (memeq(path + n - 3, ".js", 3) == 1) { return "javascript"; }
        if (memeq(path + n - 3, ".py", 3) == 1) { return "python"; }
        if (memeq(path + n - 3, ".go", 3) == 1) { return "go"; }
        if (memeq(path + n - 3, ".kt", 3) == 1) { return "kotlin"; }
        if (memeq(path + n - 3, ".cs", 3) == 1) { return "csharp"; }
        if (memeq(path + n - 3, ".cc", 3) == 1) { return "cpp"; }
        if (memeq(path + n - 3, ".rb", 3) == 1) { return "ruby"; }
        if (memeq(path + n - 3, ".ex", 3) == 1) { return "elixir"; }
        if (memeq(path + n - 3, ".ml", 3) == 1) { return "ocaml"; }
    }
    return 0;
}

fn _detect_4byte(path, n) {
    if (n >= 4) {
        if (memeq(path + n - 4, ".exs", 4) == 1) { return "elixir"; }
        if (memeq(path + n - 4, ".mli", 4) == 1) { return "ocaml"; }
        if (memeq(path + n - 4, ".lhs", 4) == 1) { return "haskell"; }
        if (memeq(path + n - 4, ".nix", 4) == 1) { return "nix"; }
        if (memeq(path + n - 4, ".hcl", 4) == 1) { return "terraform"; }
        if (memeq(path + n - 4, ".htm", 4) == 1) { return "html"; }
        if (memeq(path + n - 4, ".css", 4) == 1) { return "css"; }
        if (memeq(path + n - 4, ".ini", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".cfg", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".xml", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsl", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsd", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".svg", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".sql", 4) == 1) { return "sql"; }
        if (memeq(path + n - 4, ".gql", 4) == 1) { return "graphql"; }
        if (memeq(path + n - 4, ".mjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".cxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".kts", 4) == 1) { return "kotlin"; }
        if (memeq(path + n - 4, ".php", 4) == 1) { return "php"; }
        if (memeq(path + n - 4, ".lua", 4) == 1) { return "lua"; }
        if (memeq(path + n - 4, ".yml", 4) == 1) { return "yaml"; }
        if (memeq(path + n - 4, ".cyr", 4) == 1) { return "cyrius"; }
        if (memeq(path + n - 4, ".zig", 4) == 1) { return "zig"; }
        if (memeq(path + n - 4, ".ps1", 4) == 1) { return "powershell"; }
        if (memeq(path + n - 4, ".vue", 4) == 1) { return "vue"; }
    }
    if (n >= 3) {
        if (memeq(path + n - 3, ".cr", 3) == 1) { return "crystal"; }
        if (memeq(path + n - 3, ".jl", 3) == 1) { return "julia"; }
        if (memeq(path + n - 3, ".tf", 3) == 1) { return "terraform"; }
    }
    return 0;
}

fn _detect_5plus(path, n) {
    if (n >= 5) {
        if (memeq(path + n - 5, ".html", 5) == 1) { return "html"; }
        if (memeq(path + n - 5, ".scss", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".sass", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".conf", 5) == 1) { return "ini"; }
        if (memeq(path + n - 5, ".bash", 5) == 1) { return "shell"; }
        if (memeq(path + n - 5, ".toml", 5) == 1) { return "toml"; }
        if (memeq(path + n - 5, ".json", 5) == 1) { return "json"; }
        if (memeq(path + n - 5, ".java", 5) == 1) { return "java"; }
        if (memeq(path + n - 5, ".cyml", 5) == 1) { return "cyml"; }
        if (memeq(path + n - 5, ".yaml", 5) == 1) { return "yaml"; }
        if (memeq(path + n - 5, ".psm1", 5) == 1) { return "powershell"; }
        if (memeq(path + n - 5, ".psd1", 5) == 1) { return "powershell"; }
        if (memeq(path + n - 5, ".qasm", 5) == 1) { return "openqasm"; }
    }
    if (n >= 6) {
        if (memeq(path + n - 6, ".swift", 6) == 1) { return "swift"; }
        if (memeq(path + n - 6, ".proto", 6) == 1) { return "protobuf"; }
    }
    if (n >= 7) {
        if (memeq(path + n - 7, ".svelte", 7) == 1) { return "svelte"; }
        if (memeq(path + n - 7, ".tfvars", 7) == 1) { return "terraform"; }
    }
    if (n >= 8) {
        if (memeq(path + n - 8, ".graphql", 8) == 1) { return "graphql"; }
    }
    if (n >= 9) {
        if (memeq(path + n - 9, ".markdown", 9) == 1) { return "markdown"; }
    }
    return 0;
}

fn _detect_basename(path, n) {
    if (n >= 10) {
        if (memeq(path + n - 10, "Dockerfile", 10) == 1) { return "dockerfile"; }
    }
    if (n >= 13) {
        if (memeq(path + n - 13, "Containerfile", 13) == 1) { return "dockerfile"; }
    }
    if (n >= 8) {
        if (memeq(path + n - 8, "Makefile", 8) == 1) { return "makefile"; }
        if (memeq(path + n - 8, "makefile", 8) == 1) { return "makefile"; }
    }
    if (n >= 11) {
        if (memeq(path + n - 11, "GNUmakefile", 11) == 1) { return "makefile"; }
    }
    return 0;
}

fn detect_language(path) {
    var n = strlen(path);
    var r = _detect_short(path, n);
    if (r != 0) { return r; }
    r = _detect_4byte(path, n);
    if (r != 0) { return r; }
    r = _detect_5plus(path, n);
    if (r != 0) { return r; }
    return _detect_basename(path, n);
}

# ── Content sniffing ────────────────────────
# Pure byte-pattern detection. Caller supplies `src` + `src_len`;
# we never look outside the buffer. Length-bounded prefix checks
# mean the worst case is a fixed scan over the first ~4KB.

# Strip a leading UTF-8 BOM (`EF BB BF`) — return offset of next
# byte. Some editors auto-prepend a BOM; without skipping it we'd
# miss every signature check.
fn _detect_skip_bom(src, src_len) {
    if (src_len < 3) { return 0; }
    if (load8(src) != 239)     { return 0; }   # 0xEF
    if (load8(src + 1) != 187) { return 0; }   # 0xBB
    if (load8(src + 2) != 191) { return 0; }   # 0xBF
    return 3;
}

# True if the bytes at `src + i` start with the cstr `needle`
# (length-bounded by `src_len`).
fn _detect_starts_with(src, src_len, i, needle) {
    var nl = strlen(needle);
    if (i + nl > src_len) { return 0; }
    return memeq(src + i, needle, nl);
}

# Find `needle` in `src[start..src_len]`. Returns offset of first
# match or (0 - 1) if not found. Length-bounded.
fn _detect_index_of(src, src_len, start, needle) {
    var nl = strlen(needle);
    if (nl == 0) { return start; }
    if (start + nl > src_len) { return (0 - 1); }
    var limit = src_len - nl;
    var i = start;
    while (i <= limit) {
        if (memeq(src + i, needle, nl) == 1) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}

# Shebang interp lookup. `src[0..2] == "#!"`. Walk the rest of the
# first line; the interp name is the *last* slash-separated
# component, with any trailing args/whitespace dropped (e.g.
# `#!/usr/bin/env python3` → `python3` → match `python` prefix).
# First whitespace at or after `from`, clamped to `line_end`.
fn _dsb_word_end(src, line_end, from) {
    var p = from;
    var done = 0;
    while ((p < line_end) && (done == 0)) {
        var b = load8(src + p);
        if ((b == 32) || (b == 9)) { done = 1; }
        if (done == 0) { p = p + 1; }
    }
    return p;
}

# Offset just past the last '/' in [from, word_end); `from` if none.
fn _dsb_basename(src, from, word_end) {
    var start = from;
    var p = from;
    while (p < word_end) {
        if (load8(src + p) == 47) { start = p + 1; }
        p = p + 1;
    }
    return start;
}

fn _detect_shebang(src, src_len) {
    if (src_len < 2) { return 0; }
    if (load8(src) != 35) { return 0; }      # '#'
    if (load8(src + 1) != 33) { return 0; }  # '!'

    # Find end of first line (LF, or src_len).
    var i = 2;
    var line_end = src_len;
    while (i < src_len) {
        var b = load8(src + i);
        if (b == 10) { line_end = i; i = src_len; }
        if (b != 10) { i = i + 1; }
    }

    # The interpreter is the FIRST word on the line, and within it
    # the basename. The previous implementation scanned the whole
    # line for the last '/' OR space, so any interpreter ARGUMENT
    # captured `word_start`: `#!/bin/bash -e` resolved the interp
    # word to `-e` and detection failed outright. `-e` / `-eu` /
    # `-u` are ordinary in real scripts, so extensionless shell and
    # python files were simply rejected. Fixed 2.3.4.
    #
    # `_dsb_word_end` = first whitespace at/after `from`, else
    # `line_end`. `_dsb_basename` = after the last '/' strictly
    # inside the word (never past its end).
    var path_end = _dsb_word_end(src, line_end, 2);
    var word_start = _dsb_basename(src, 2, path_end);
    var word_end = path_end;
    var wlen = word_end - word_start;

    # `env` — the real interpreter is the next word, skipping any
    # options `env` itself takes (`env -S python3 -u`, `env -i sh`).
    if ((wlen == 3) && (memeq(src + word_start, "env", 3) == 1)) {
        var j = word_end;
        var scanning = 1;
        while (scanning == 1) {
            # Skip whitespace.
            while ((j < line_end) &&
              ((load8(src + j) == 32) || (load8(src + j) == 9))) {
                j = j + 1;
            }
            if (j >= line_end) { return 0; }
            var w_end = _dsb_word_end(src, line_end, j);
            # An `env` option (`-S`, `-i`, `-u NAME`) is not the
            # interpreter — step over it and keep looking.
            # Latch the test BEFORE mutating `j`: reading
            # `load8(src + j)` again after `j = w_end` tests the
            # byte at the NEW position (the following space), so
            # both branches fired and the option was treated as the
            # interpreter. Same two-`if` hazard as `_ds_scan_tag`.
            var is_opt = 0;
            if (load8(src + j) == 45) { is_opt = 1; }
            if (is_opt == 1) { j = w_end; }
            if (is_opt == 0) {
                word_start = _dsb_basename(src, j, w_end);
                word_end = w_end;
                scanning = 0;
            }
        }
        wlen = word_end - word_start;
    }

    # Match interp prefix. Trailing version digits (`python3`,
    # `bash5`) are tolerated by checking prefix match.
    if ((wlen >= 4) && (memeq(src + word_start, "bash", 4) == 1)) { return "shell"; }
    if ((wlen >= 3) && (memeq(src + word_start, "zsh",  3) == 1)) { return "shell"; }
    if ((wlen >= 4) && (memeq(src + word_start, "dash", 4) == 1)) { return "shell"; }
    # `sh`, `ksh`-style short names: prefix match bounded to 3 so
    # `shellcheck` doesn't read as a shell interpreter. (Was two
    # overlapping checks, the first fully subsumed by the second.)
    if ((wlen >= 2) && (wlen <= 3) && (memeq(src + word_start, "sh", 2) == 1)) { return "shell"; }
    if ((wlen >= 6) && (memeq(src + word_start, "python", 6) == 1)) { return "python"; }
    if ((wlen >= 4) && (memeq(src + word_start, "node", 4) == 1)) { return "javascript"; }
    if ((wlen >= 4) && (memeq(src + word_start, "ruby", 4) == 1)) { return "ruby"; }
    if ((wlen >= 3) && (memeq(src + word_start, "lua",  3) == 1)) { return "lua"; }
    if ((wlen >= 3) && (memeq(src + word_start, "php",  3) == 1)) { return "php"; }
    return 0;
}

# Signature peek — well-known fixed prefixes after BOM strip.
# `<?xml` always wins for XML; `<!DOCTYPE html` is HTML; any other
# `<!DOCTYPE` falls through to xml (DocBook, RELAX NG, etc.).
fn _detect_signature(src, src_len, start) {
    if (_detect_starts_with(src, src_len, start, "<?xml") == 1) { return "xml"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE HTML") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE") == 1) { return "xml"; }
    if (_detect_starts_with(src, src_len, start, "<!doctype html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<HTML") == 1) { return "html"; }
    return 0;
}

# Asm flavor scoring — counts ARM-vs-x86_64 signal hits in the
# first 4KB (or src_len, whichever is smaller). Returns:
#   "asm_aarch64" — ARM signals dominate
#   "asm_x86_64"  — x86 signals dominate (or tied / no signals)
# Tied / no-signal case defaults to x86_64 because that's the
# legacy default for `.s` / `.S` extensions (preserves 1.0–1.11.1
# behaviour for unannotated asm).
fn _detect_asm_flavor(src, src_len) {
    var arm_score = 0;
    var x86_score = 0;
    var scan_end = src_len;
    if (scan_end > 4096) { scan_end = 4096; }

    # ARM signals.
    if (_detect_index_of(src, scan_end, 0, ".arch armv8") >= 0) { arm_score = arm_score + 5; }
    if (_detect_index_of(src, scan_end, 0, ".arch armv7") >= 0) { arm_score = arm_score + 5; }
    if (_detect_index_of(src, scan_end, 0, "b.eq") >= 0)        { arm_score = arm_score + 3; }
    if (_detect_index_of(src, scan_end, 0, "b.ne") >= 0)        { arm_score = arm_score + 3; }
    if (_detect_index_of(src, scan_end, 0, "ldp ") >= 0)        { arm_score = arm_score + 2; }
    if (_detect_index_of(src, scan_end, 0, "stp ") >= 0)        { arm_score = arm_score + 2; }
    if (_detect_index_of(src, scan_end, 0, " x0,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " x1,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " w0,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " w1,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "xzr") >= 0)         { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "wzr") >= 0)         { arm_score = arm_score + 1; }

    # x86_64 signals.
    if (_detect_index_of(src, scan_end, 0, ".intel_syntax") >= 0) { x86_score = x86_score + 5; }
    if (_detect_index_of(src, scan_end, 0, ".att_syntax") >= 0)   { x86_score = x86_score + 5; }
    if (_detect_index_of(src, scan_end, 0, " rax") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rdi") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rsi") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rsp") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rbp") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "syscall") >= 0)       { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "xmm0") >= 0)          { x86_score = x86_score + 1; }

    if (arm_score > x86_score) { return "asm_aarch64"; }
    return "asm_x86_64";
}

# Public byte-API content sniff. Strips BOM, then tries shebang →
# signature peek. Returns 0 if no sniff matches; callers can fall
# back to a default. Does NOT do asm flavor scoring on its own —
# the caller has to know it's asm first (see
# `detect_language_combined`).
fn detect_language_from_content(src, src_len) {
    if (src_len <= 0) { return 0; }
    var bom = _detect_skip_bom(src, src_len);

    var sb = _detect_shebang(src, src_len);
    if (sb != 0) { return sb; }

    var sig = _detect_signature(src, src_len, bom);
    if (sig != 0) { return sig; }

    return 0;
}

# Combined entry. Path first; refine via content for known-
# ambiguous extensions (today: asm flavour). When path returns 0,
# fall through to pure content sniff. Returns a language name or
# 0. This is the function the CLI calls.
fn detect_language_combined(path, src, src_len) {
    var path_lang = detect_language(path);

    # Asm flavour split — `.s` / `.S` extensions land on
    # `asm_x86_64` from path dispatch; let content vote.
    if (path_lang != 0) {
        if (streq(path_lang, "asm_x86_64") == 1) {
            return _detect_asm_flavor(src, src_len);
        }
        return path_lang;
    }

    return detect_language_from_content(src, src_len);
}

# --- lsp.cyr ---

# vyakarana — LSP semantic-tokens bridge
#
# Maps LSP standard `tokenType` values onto vyakarana's 10
# token kinds. Lets editor consumers (cyim, VS Code, future
# clients) surface vyakarana-quality colouring even when the
# underlying classification came from a Language Server (rust-
# analyzer, gopls, pyright, clangd, etc.) instead of vyakarana's
# own grammar set.
#
# Mapping decisions live in
# [docs/adr/0012-lsp-semantic-tokens-bridge.md](../docs/adr/0012-lsp-semantic-tokens-bridge.md).
#
# Scope:
#   - Two pure functions: `lsp_kind_from_token_type(name)` and
#     `lsp_kind_from_standard_index(idx)`. Both return one of
#     the 10 TK_* constants from src/token.cyr.
#   - No JSON-RPC, no semantic-tokens-stream decoding, no
#     line/column → byte-offset arithmetic. Those are LSP-wire
#     concerns the consumer handles. This module is pure name /
#     index → kind translation.
#   - The standard LSP 3.17 legend is hardcoded by index. Servers
#     that ship custom legends (a handful of token types beyond
#     the standard 22) should resolve the name themselves.
#
# Available via the distlib bundle (`[lib] modules` includes
# this module).

# Convert an LSP token-type NAME (e.g. "keyword", "function",
# "variable", "string") to a vyakarana TK_* kind.
#
# The 22 standard LSP token types map as follows:
#   "namespace"      → TK_IDENT
#   "type"           → TK_IDENT       (type names are idents)
#   "class"          → TK_IDENT
#   "enum"           → TK_IDENT
#   "interface"      → TK_IDENT
#   "struct"         → TK_IDENT
#   "typeParameter"  → TK_IDENT
#   "parameter"      → TK_IDENT
#   "variable"       → TK_IDENT
#   "property"       → TK_IDENT
#   "enumMember"     → TK_IDENT
#   "event"          → TK_IDENT
#   "function"       → TK_IDENT
#   "method"         → TK_IDENT
#   "modifier"       → TK_KEYWORD     (visibility / storage class)
#   "macro"          → TK_PREPROCESSOR
#   "decorator"      → TK_PREPROCESSOR (annotation-like)
#   "keyword"        → TK_KEYWORD
#   "comment"        → TK_COMMENT
#   "string"         → TK_STRING
#   "regexp"         → TK_STRING       (no separate regex kind)
#   "number"         → TK_NUMBER
#   "operator"       → TK_OPERATOR
#
# Unknown names → TK_IDENT (the safe default; servers can extend
# the legend, but vyakarana's palette is the contract).
fn lsp_kind_from_token_type(name) {
    if (name == 0) { return TK_IDENT; }

    # Direct hits — exact matches on standard names.
    if (streq(name, "keyword") == 1)   { return TK_KEYWORD; }
    if (streq(name, "comment") == 1)   { return TK_COMMENT; }
    if (streq(name, "string") == 1)    { return TK_STRING; }
    if (streq(name, "regexp") == 1)    { return TK_STRING; }
    if (streq(name, "number") == 1)    { return TK_NUMBER; }
    if (streq(name, "operator") == 1)  { return TK_OPERATOR; }
    if (streq(name, "modifier") == 1)  { return TK_KEYWORD; }
    if (streq(name, "macro") == 1)     { return TK_PREPROCESSOR; }
    if (streq(name, "decorator") == 1) { return TK_PREPROCESSOR; }

    # All ident-flavoured types collapse to TK_IDENT. Themes
    # that want to distinguish `function` from `variable` from
    # `class` apply secondary-palette rules per
    # [ADR 0004](../docs/adr/0004-shell-builtins-as-ident.md) /
    # [ADR 0007](../docs/adr/0007-rust-dollar-in-ident-start.md) —
    # they pass through with their LSP type name preserved on
    # the consumer side, vyakarana's kind palette stays at 10.
    if (streq(name, "namespace") == 1)     { return TK_IDENT; }
    if (streq(name, "type") == 1)          { return TK_IDENT; }
    if (streq(name, "class") == 1)         { return TK_IDENT; }
    if (streq(name, "enum") == 1)          { return TK_IDENT; }
    if (streq(name, "interface") == 1)     { return TK_IDENT; }
    if (streq(name, "struct") == 1)        { return TK_IDENT; }
    if (streq(name, "typeParameter") == 1) { return TK_IDENT; }
    if (streq(name, "parameter") == 1)     { return TK_IDENT; }
    if (streq(name, "variable") == 1)      { return TK_IDENT; }
    if (streq(name, "property") == 1)      { return TK_IDENT; }
    if (streq(name, "enumMember") == 1)    { return TK_IDENT; }
    if (streq(name, "event") == 1)         { return TK_IDENT; }
    if (streq(name, "function") == 1)      { return TK_IDENT; }
    if (streq(name, "method") == 1)        { return TK_IDENT; }

    # Unknown / extended legend names — safe default.
    return TK_IDENT;
}

# Convert an LSP token-type INDEX (0-based into the legend's
# `tokenTypes` array) to a vyakarana TK_* kind. Uses the
# standard LSP 3.17 legend order. Servers that ship a custom
# legend (with extra tokenTypes appended after the standard 22)
# should resolve the name first via their legend's `tokenTypes[idx]`
# and call `lsp_kind_from_token_type(name)` instead.
#
# Standard 3.17 order:
#   0  namespace      8  variable        16 macro
#   1  type           9  property        17 keyword
#   2  class         10  enumMember      18 modifier
#   3  enum          11  event           19 comment
#   4  interface     12  function        20 string
#   5  struct        13  method          21 number
#   6  typeParameter 14  decorator       22 regexp
#   7  parameter     15  (reserved)      23 operator
#
# The "reserved" slot at 15 is a quirk of the spec history; the
# common form has decorator at 14 and operator at 22. We follow
# the *current* (3.17) order, which lists decorator as the most
# recent addition at the end of the standard set. Out-of-range
# indices return TK_IDENT.
fn lsp_kind_from_standard_index(idx) {
    if (idx == 0)  { return TK_IDENT; }         # namespace
    if (idx == 1)  { return TK_IDENT; }         # type
    if (idx == 2)  { return TK_IDENT; }         # class
    if (idx == 3)  { return TK_IDENT; }         # enum
    if (idx == 4)  { return TK_IDENT; }         # interface
    if (idx == 5)  { return TK_IDENT; }         # struct
    if (idx == 6)  { return TK_IDENT; }         # typeParameter
    if (idx == 7)  { return TK_IDENT; }         # parameter
    if (idx == 8)  { return TK_IDENT; }         # variable
    if (idx == 9)  { return TK_IDENT; }         # property
    if (idx == 10) { return TK_IDENT; }         # enumMember
    if (idx == 11) { return TK_IDENT; }         # event
    if (idx == 12) { return TK_IDENT; }         # function
    if (idx == 13) { return TK_IDENT; }         # method
    if (idx == 14) { return TK_KEYWORD; }       # modifier
    if (idx == 15) { return TK_PREPROCESSOR; }  # macro
    if (idx == 16) { return TK_PREPROCESSOR; }  # decorator (LSP 3.17 addition)
    if (idx == 17) { return TK_KEYWORD; }       # keyword
    if (idx == 18) { return TK_COMMENT; }       # comment
    if (idx == 19) { return TK_STRING; }        # string
    if (idx == 20) { return TK_NUMBER; }        # number
    if (idx == 21) { return TK_STRING; }        # regexp
    if (idx == 22) { return TK_OPERATOR; }      # operator
    return TK_IDENT;
}
