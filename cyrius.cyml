# Configuration only. Why each block is shaped as it is:
# docs/development/distribution.md § The manifest.

[package]
name = "vyakarana"
version = "${file:VERSION}"
description = "Source-code grammar and tokenizer library for AGNOS / Cyrius"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/vyakarana"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "vyk"

[lib]
modules = [
    "src/token.cyr",
    "src/grammar_blobs.cyr",
    "src/grammar.cyr",
    "src/grammars/default_scanner.cyr",
    "src/grammars/shell.cyr",
    "src/tokenize.cyr",
    "src/tokenize_doc.cyr",
    "src/detect.cyr",
    "src/lsp.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
]

[test]
stdlib = ["assert"]
