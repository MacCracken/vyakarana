[package]
name = "vyakarana"
version = "${file:VERSION}"
description = "Source-code grammar and tokenizer library for AGNOS / Cyrius"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/vyakarana"
language = "cyrius"
cyrius = "6.5.32"

[build]
entry = "src/main.cyr"
output = "vyk"

# `[lib]` drives `cyrius distlib` — concatenates the listed modules
# into `dist/vyakarana.cyr` for downstream consumers (owl, cyim,
# vidya) to pull via `[deps.vyakarana] modules =
# ["dist/vyakarana.cyr"]`. Do NOT move these into `[build]` — that
# would prepend them before `src/main.cyr`, which re-includes them
# and bloats the binary.
#
# Order matters (Cyrius is single-pass): each module may only
# reference symbols defined earlier in the list.
#   token          — palette + tokenbuf (foundational, zero deps)
#   grammar_blobs  — auto-generated; inlines grammars/*.cyml as
#                    Cyrius string literals so the dist bundle is
#                    self-contained (downstream `cyrius deps` only
#                    vendors the bundle file). Generated by
#                    scripts/embed-grammars.sh; gitignored. Must be
#                    regenerated before `cyrius distlib`. See ADR 0014.
#   grammar        — Grammar record + CYML parser + registry (uses TK_*).
#                    grammar_load() consults grammar_blobs first.
#   default_scanner— data-driven tokenizer (uses grammar + token)
#   shell          — hand-coded M1 oracle, retained for the
#                    regression-diff path (`vyk --handcoded`).
#                    Consumer DCE builds strip it automatically.
#   tokenize       — public dispatch (uses all of the above).
[lib]
modules = [
    "src/token.cyr",
    "src/grammar_blobs.cyr",
    "src/grammar.cyr",
    "src/grammars/default_scanner.cyr",
    "src/grammars/shell.cyr",
    "src/tokenize.cyr",
    "src/detect.cyr",
    "src/lsp.cyr",
]

# Stdlib footprint chosen for the ROADMAP M0–M3 arc:
#   syscalls/alloc/fmt/io — required baseline
#   str/string/vec        — source buffers, token lists, grammar tables
#   args                  — `vyk` demo CLI
#   fs                    — reading files to tokenize
#   hashmap               — keyword tables, extension→grammar map
#   assert                — tests/vyakarana.tcyr
# `cyml` is NOT gone — it was folded into the `bayan` bundle at
# 6.1.24, which is where its 17 `cyml_*` symbols live now. There
# is just no standalone `lib/cyml.cyr` to resolve any more, so
# naming it here made `cyrius deps` fail on a fresh checkout from
# 2.2.3 onward. Removed rather than re-pointed at `bayan`: the
# grammar loader parses `grammars/*.cyml` with its own
# purpose-built scanner in `src/grammar.cyr` and has never called
# a `cyml_*` symbol, so declaring `bayan` would vendor an unused
# module. See the note in `src/grammar.cyr`'s header for why the
# scanner is hand-rolled.
# vyakarana is still first-party — no [deps.<name>] blocks yet.
[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "assert",
]
