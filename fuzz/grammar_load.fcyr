# vyakarana — fuzz harness for the CYML grammar parser
#
# `grammar_load(path)` either resolves to an embedded blob (the
# 38 bundled paths via _grammar_blob_data) or falls through to
# file_read_all. The blob path is hot — every consumer depends
# on it in bootstrap_grammars. This harness exercises the parser
# directly with corrupted inputs to confirm:
#
#   1. Empty / truncated / NUL-bombed CYML returns a non-null
#      grammar handle (parser is forgiving — missing fields stay
#      defaulted) or 0 (clean failure mode), never crashes.
#   2. Embedded blobs round-trip: every bundled grammar still
#      parses cleanly, names and extensions populate.
#   3. Pathological CYML shapes (deeply nested arrays, runaway
#      strings, headers without bodies) don't blow stack or
#      heap.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"

var _gl_state = 6364136223846793005;

fn _gl_rand() {
    var x = _gl_state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _gl_state = x;
    return x;
}

fn _gl_fill_printable(buf, n) {
    # Restrict to printable ASCII so the parser sees plausible-
    # looking input rather than control bytes that get rejected
    # at the tokenizer layer. Stresses parser logic, not lexer.
    var i = 0;
    while (i < n) {
        store8(buf + i, 32 + (_gl_rand() & 95));
        i = i + 1;
    }
    store8(buf + n, 0);
    return 0;
}

fn fuzz_main(data, n) {
    # 1. All 38 bundled blobs round-trip. Triggers
    # bootstrap_grammars via has_grammar.
    if (has_grammar("shell") == 0) {
        eprint("FAIL: shell didn't bootstrap\n", 30);
        return 1;
    }
    if (_grammar_blob_count() != 45) {
        eprint("FAIL: blob count drifted from 45\n", 34);
        return 1;
    }

    # Walk each known path and verify the grammar handle is
    # non-zero, has a name, and registers via has_grammar.
    var paths_buf = "grammars/shell.cyml\0grammars/rust.cyml\0grammars/python.cyml\0grammars/c.cyml\0grammars/html.cyml\0grammars/cyml.cyml\0grammars/asm_x86_64.cyml\0grammars/asm_aarch64.cyml\0";
    var p = paths_buf;
    var checks = 0;
    while (load8(p) != 0) {
        var g = grammar_load(p);
        if (g == 0) {
            eprint("FAIL: blob round-trip null for ", 32);
            eprint(p, strlen(p));
            eprint("\n", 1);
            return 1;
        }
        var name = grammar_name(g);
        if (name == 0) {
            eprint("FAIL: parsed grammar has null name\n", 36);
            return 1;
        }
        checks = checks + 1;
        p = p + strlen(p) + 1;
    }
    if (checks != 8) {
        eprint("FAIL: expected 8 round-trip checks\n", 36);
        return 1;
    }

    # 2. Random printable-ASCII blobs through the parser. The CYML
    # parser is tolerant of unknown keys; assertion is just "no
    # crash".
    var sizes_buf = alloc(48);
    store8(sizes_buf,      32);
    store8(sizes_buf + 8,  256);
    store8(sizes_buf + 16, 1024);
    var rbuf = alloc(8192);
    var s = 0;
    while (s < 3) {
        var sz = load8(sizes_buf + (s * 8));
        var iter = 0;
        while (iter < 8) {
            _gl_fill_printable(rbuf, sz);
            # _gp_parse mutates the buffer in place. Returns 0 or
            # a grammar handle; either is acceptable.
            var g = _gp_parse(rbuf, sz);
            # If non-null, name must be a valid cstr or 0.
            if (g != 0) {
                var nm = grammar_name(g);
                if (nm != 0) {
                    var nl = strlen(nm);
                    if (nl > 256) {
                        eprint("FAIL: parsed name longer than 256 bytes\n", 41);
                        return 1;
                    }
                }
            }
            iter = iter + 1;
        }
        s = s + 1;
    }

    # 3. Pathological CYML shapes.
    var path1 = alloc(256);
    # All `[grammar]` headers, no bodies.
    store8(path1 + 0,  91);  store8(path1 + 1,  103); store8(path1 + 2,  114);
    store8(path1 + 3,  97);  store8(path1 + 4,  109); store8(path1 + 5,  109);
    store8(path1 + 6,  97);  store8(path1 + 7,  114); store8(path1 + 8,  93);
    store8(path1 + 9,  10);
    store8(path1 + 10, 91);  store8(path1 + 11, 103); store8(path1 + 12, 114);
    store8(path1 + 13, 97);  store8(path1 + 14, 109); store8(path1 + 15, 109);
    store8(path1 + 16, 97);  store8(path1 + 17, 114); store8(path1 + 18, 93);
    store8(path1 + 19, 10);
    store8(path1 + 20, 0);
    var gp1 = _gp_parse(path1, 20);
    # Either null or a grammar with no name. Both fine.

    # Runaway open-quote — name = "...... no closing quote.
    var path2 = alloc(256);
    var pre = "[grammar]\nname = \"";
    var pl = strlen(pre);
    var k = 0;
    while (k < pl) {
        store8(path2 + k, load8(pre + k));
        k = k + 1;
    }
    while (k < 240) {
        store8(path2 + k, 65 + (k & 15));   # `A` ramp
        k = k + 1;
    }
    store8(path2 + k, 0);
    var gp2 = _gp_parse(path2, k);
    # No assertion on result; the test is "didn't crash".

    return 0;
}

fn _harness_main() {
    if (fuzz_main("x", 1) != 0) {
        eprint("grammar_load fuzz: FAIL\n", 25);
        return 1;
    }
    print("grammar_load fuzz: OK\n", 22);
    return 0;
}

var _ec = _harness_main();
syscall(60, _ec);
