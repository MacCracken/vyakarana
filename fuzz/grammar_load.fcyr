# vyakarana — fuzz harness for the CYML grammar parser
#
# `grammar_load(path)` either resolves to an embedded blob (the
# bundled paths via _grammar_blob_data, 49 as of 2.9.9) or falls through to
# file_read_all. The blob path is hot — every consumer depends
# on it in bootstrap_grammars. This harness exercises the parser
# directly with corrupted inputs to confirm:
#
#   1. Empty / truncated / NUL-bombed CYML returns a non-null
#      grammar handle (parser is forgiving — missing fields stay
#      defaulted) or 0 (clean failure mode), never crashes.
#   2. Embedded blobs round-trip: there are 49, and eight bundled
#      paths parse to a grammar with a name.
#   3. Pathological CYML shapes (deeply nested arrays, runaway
#      strings, headers without bodies) don't blow stack or
#      heap.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"

var _gl_state = 6364136223846793005;

fn _gl_rand() {
    var x = _gl_state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _gl_state = x;
    return x;
}

fn _gl_fill_printable(buf, n) {
    # Restrict to printable ASCII so the parser sees plausible-
    # looking input rather than control bytes that get rejected
    # at the tokenizer layer. Stresses parser logic, not lexer.
    var i = 0;
    while (i < n) {
        store8(buf + i, 32 + (_gl_rand() & 95));
        i = i + 1;
    }
    store8(buf + n, 0);
    return 0;
}

fn fuzz_main(data, n) {
    # 1. Bundled blobs round-trip (49; the count check below). Triggers
    # bootstrap_grammars via has_grammar.
    if (has_grammar("shell") == 0) {
        eprint("FAIL: shell didn't bootstrap\n", 29);
        return 1;
    }
    if (_grammar_blob_count() != 49) {
        eprint("FAIL: blob count drifted from 49\n", 33);
        return 1;
    }

    # Walk each known path and verify the grammar handle is
    # non-zero, has a name, and registers via has_grammar.
    var paths_buf = "grammars/shell.cyml\0grammars/rust.cyml\0grammars/python.cyml\0grammars/c.cyml\0grammars/html.cyml\0grammars/cyml.cyml\0grammars/asm_x86_64.cyml\0grammars/asm_aarch64.cyml\0";
    var p = paths_buf;
    var checks = 0;
    while (load8(p) != 0) {
        var g = grammar_load(p);
        if (g == 0) {
            eprint("FAIL: blob round-trip null for ", 31);
            eprint(p, strlen(p));
            eprint("\n", 1);
            return 1;
        }
        var name = grammar_name(g);
        if (name == 0) {
            eprint("FAIL: parsed grammar has null name\n", 35);
            return 1;
        }
        checks = checks + 1;
        p = p + strlen(p) + 1;
    }
    if (checks != 8) {
        eprint("FAIL: expected 8 round-trip checks\n", 35);
        return 1;
    }

    # 2. Random printable-ASCII blobs through the parser. The CYML
    # parser is tolerant of unknown keys; assertion is just "no
    # crash".
    # store64, not store8: through 2.5.1 these were byte stores, so
    # 256 and 1024 truncated to 0 and 16 of the 24 iterations parsed
    # an EMPTY buffer (2.5.2 audit P3-g).
    var sizes_buf = alloc(48);
    store64(sizes_buf,      32);
    store64(sizes_buf + 8,  256);
    store64(sizes_buf + 16, 1024);
    var rbuf = alloc(8192);
    var s = 0;
    while (s < 3) {
        var sz = load64(sizes_buf + (s * 8));
        var iter = 0;
        while (iter < 8) {
            _gl_fill_printable(rbuf, sz);
            # Returns 0 or a grammar handle; either is acceptable.
            # (The parser never writes to its input — this comment
            # used to say it "mutates the buffer in place".)
            var g = _gp_parse(rbuf, sz);
            # If non-null, name must be a valid cstr or 0.
            if (g != 0) {
                var nm = grammar_name(g);
                if (nm != 0) {
                    var nl = strlen(nm);
                    if (nl > 256) {
                        eprint("FAIL: parsed name longer than 256 bytes\n", 40);
                        return 1;
                    }
                }
            }
            iter = iter + 1;
        }
        s = s + 1;
    }

    # 3. Pathological CYML shapes.
    var path1 = alloc(256);
    # All `[grammar]` headers, no bodies.
    store8(path1 + 0,  91);  store8(path1 + 1,  103); store8(path1 + 2,  114);
    store8(path1 + 3,  97);  store8(path1 + 4,  109); store8(path1 + 5,  109);
    store8(path1 + 6,  97);  store8(path1 + 7,  114); store8(path1 + 8,  93);
    store8(path1 + 9,  10);
    store8(path1 + 10, 91);  store8(path1 + 11, 103); store8(path1 + 12, 114);
    store8(path1 + 13, 97);  store8(path1 + 14, 109); store8(path1 + 15, 109);
    store8(path1 + 16, 97);  store8(path1 + 17, 114); store8(path1 + 18, 93);
    store8(path1 + 19, 10);
    store8(path1 + 20, 0);
    var gp1 = _gp_parse(path1, 20);
    # Either null or a grammar with no name. Both fine.

    # Runaway open-quote — name = "...... no closing quote.
    var path2 = alloc(256);
    var pre = "[grammar]\nname = \"";
    var pl = strlen(pre);
    var k = 0;
    while (k < pl) {
        store8(path2 + k, load8(pre + k));
        k = k + 1;
    }
    while (k < 240) {
        store8(path2 + k, 65 + (k & 15));   # `A` ramp
        k = k + 1;
    }
    store8(path2 + k, 0);
    var gp2 = _gp_parse(path2, k);
    # No assertion on result; the test is "didn't crash".

    # 4. Structure-aware mutation (2.5.2). Delete one random line from
    # each bundled grammar's source, 12 times over, and parse it. That
    # is how the incomplete-rule shapes arise — a `pair` that lost its
    # `end`, a compose rule that lost its `inner`, an `ident_start`
    # without `ident_cont` — and through 2.5.1 they loaded fine and
    # crashed the SCANNER, which sections 1-3 never ran on a fuzzed
    # grammar. Any mutant that still loads must tokenize a mixed probe
    # with the coverage invariant intact.
    if (_gl_mutate_bundled() != 0) { return 1; }

    return 0;
}

var _gl_probe = "fn main() { x = 'a' + '\\n'; s = \"t\\\"u\"; /* c */ // c\n# h\n\xc3\xa9 \xe6\xbc\xa2 \xff <style>a</style> ```rs\nlet y;\n``` 0x1F 3.14 $x ${y} `z` }\n";

# Copy `blob` (n bytes) into `out` with line number `drop` removed.
# Returns the new length.
fn _gl_drop_line(blob, n, drop, out) {
    var line = 0;
    var o = 0;
    var i = 0;
    while (i < n) {
        var b = load8(blob + i);
        if (line != drop) { store8(out + o, b); o = o + 1; }
        if (b == 10) { line = line + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return o;
}

fn _gl_count_lines(blob, n) {
    var c = 1;
    var i = 0;
    while (i < n) {
        if (load8(blob + i) == 10) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn _gl_mutate_bundled() {
    var names = vec_new();
    list_languages_into(names);
    var pathbuf = alloc(128);
    var out = alloc(40000);
    var plen = strlen(_gl_probe);
    var ni = 0;
    var loaded = 0;
    var rejected = 0;
    while (ni < vec_len(names)) {
        var nm = vec_get(names, ni);
        var pre = "grammars/";
        var suf = ".cyml";
        var o = 0;
        memcpy(pathbuf, pre, 9); o = 9;
        memcpy(pathbuf + o, nm, strlen(nm)); o = o + strlen(nm);
        memcpy(pathbuf + o, suf, 5); o = o + 5;
        store8(pathbuf + o, 0);
        var blob = _grammar_blob_data(pathbuf);
        if (blob != 0) {
            var bn = strlen(blob);
            var lines = _gl_count_lines(blob, bn);
            var m = 0;
            while (m < 12) {
                var drop = _gl_rand() % lines;
                if (drop < 0) { drop = 0 - drop; }
                var mn = _gl_drop_line(blob, bn, drop, out);
                var g = _gp_parse(out, mn);
                if (g == 0) { rejected = rejected + 1; }
                if (g != 0) {
                    loaded = loaded + 1;
                    var tb = tokenbuf_new();
                    tokenize_with_grammar(g, _gl_probe, plen, tb);
                    var pos = 0;
                    var t = 0;
                    var bad = 0;
                    while (t < tokenbuf_count(tb)) {
                        if (tokenbuf_start(tb, t) != pos) { bad = 1; }
                        if (tokenbuf_len(tb, t) <= 0) { bad = 1; }
                        pos = tokenbuf_start(tb, t) + tokenbuf_len(tb, t);
                        t = t + 1;
                    }
                    if (pos != plen) { bad = 1; }
                    if (bad == 1) {
                        eprint("FAIL: mutated grammar broke coverage: ", 38);
                        eprint(nm, strlen(nm));
                        eprint("\n", 1);
                        return 1;
                    }
                }
                m = m + 1;
            }
        }
        ni = ni + 1;
    }
    if (loaded + rejected != 12 * vec_len(names)) {
        eprint("FAIL: mutation stage skipped grammars\n", 38);
        return 1;
    }
    return 0;
}

fn _harness_main() {
    if (fuzz_main("x", 1) != 0) {
        eprint("grammar_load fuzz: FAIL\n", 24);
        return 1;
    }
    print("grammar_load fuzz: OK\n", 22);
    return 0;
}

var _ec = _harness_main();
syscall(60, _ec);
