# vyakarana — chunk-invariance harness (2.4.0+)
#
# Asserts the contract `fuzz/streaming.fcyr` states in prose:
#
#   any chunking strategy produces the same (kind, start, len)
#   tokens as a single-shot feed of the same source.
#
# The difference from `streaming.fcyr` is the INPUT. That harness
# uses short synthetic strings and passes; the 2.3.4 audit found the
# contract violated on 13 of 20 real corpus files, so the inputs
# were the weak half, not the assertions. This harness runs the same
# check over `tests/corpus/` at eight chunk sizes — 1, 2, 3, 5, 7,
# 64, 512, 4096 — which is what surfaced every root cause fixed in
# 2.4.0:
#
#   - the LF fallback committing block comments early (css, sql)
#   - the longest-match window on operator tables (rust, go)
#   - rule START markers needing the same window (xml)
#   - a short pair rule vouching for a long rule's token (python)
#   - pending set on an already-closed token (ruby)
#
# Every corpus is here, the compose grammars too since 2.8.0 —
# markdown, html, vue, svelte and cyml were left out through 2.7.1,
# when their streaming rested on a prefix-hold heuristic and cyml
# failed at 90 % of split offsets. The scanner now reports unresolved
# compose openers and finished regions itself (src/tokenize.cyr,
# "Compose hold").
#
# Add a grammar here when adding a corpus entry: the cost is one
# line and it is the only gate that would catch a boundary
# regression.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"

var _CI_CAP = 1048576;
# How many corpora / every-offset shapes ran, for the summary line. It
# was a hand-written count, stale twice ("15 grammars" until 2.6.2, then
# "12 shapes" while 24 ran).
var _ci_n_corpora = 0;
var _ci_n_shapes = 0;

# Feed `src`/`n` in `chunk`-sized pieces, draining after each.
fn _ci_tok(lang, src, n, chunk) {
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    var tb = tokenbuf_new();
    var off = 0;
    while (off < n) {
        var take = chunk;
        if (take <= 0) { take = 1; }
        if (off + take > n) { take = n - off; }
        tokenize_stream_feed(s, src + off, take);
        tokenize_stream_drain(s, tb);
        off = off + take;
    }
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return tb;
}

# Feed `src`/`n` as TWO pieces split at `p` — drain after each — then
# finish. Fixed chunk sizes alone missed two 2.5.2 P1s: a char literal
# and an escaped quote split by the boundary only fail when the cut
# lands on one exact byte, and no chunk size in the list happened to
# put a boundary there.
fn _ci_split(lang, src, n, p) {
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    var tb = tokenbuf_new();
    tokenize_stream_feed(s, src, p);
    tokenize_stream_drain(s, tb);
    tokenize_stream_feed(s, src + p, n - p);
    tokenize_stream_drain(s, tb);
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return tb;
}

# Compare two tokenbufs for exact (kind, start, len) equality.
# Returns 1 on match, 0 on mismatch (and reports).
fn _ci_same(a, b, lang, chunk) {
    var na = tokenbuf_count(a);
    var nb = tokenbuf_count(b);
    if (na != nb) {
        eprint("FAIL: ", 6);
        eprint(lang, strlen(lang));
        eprint(" — token count differs vs single-feed at chunk ", 49);
        efmt_int(chunk);
        eprint(" (", 2); efmt_int(na);
        eprint(" vs ", 4); efmt_int(nb);
        eprint(")\n", 2);
        return 0;
    }
    var i = 0;
    var bad = (0 - 1);
    while (i < na) {
        if (bad < 0) {
            if ((tokenbuf_kind(a, i)  != tokenbuf_kind(b, i)) ||
                (tokenbuf_start(a, i) != tokenbuf_start(b, i)) ||
                (tokenbuf_len(a, i)   != tokenbuf_len(b, i))) { bad = i; }
        }
        i = i + 1;
    }
    if (bad >= 0) {
        eprint("FAIL: ", 6);
        eprint(lang, strlen(lang));
        eprint(" — token #", 12); efmt_int(bad);
        eprint(" differs at chunk ", 18); efmt_int(chunk);
        eprint("\n", 1);
        return 0;
    }
    return 1;
}

# Run every chunk size for one corpus file. Returns 0 on success.
fn _ci_one(path, lang) {
    _ci_n_corpora = _ci_n_corpora + 1;
    var buf = alloc(_CI_CAP);
    if (buf == 0) { return 1; }
    var n = file_read_all(path, buf, _CI_CAP - 1);
    if (n <= 0) {
        eprint("FAIL: cannot read ", 18);
        eprint(path, strlen(path));
        eprint("\n", 1);
        return 1;
    }
    store8(buf + n, 0);

    var whole = _ci_tok(lang, buf, n, n);
    if (whole == 0) {
        eprint("FAIL: no grammar for ", 21);
        eprint(lang, strlen(lang));
        eprint("\n", 1);
        return 1;
    }

    # Coverage must also hold for the single-feed baseline, else the
    # comparison below is against a broken reference.
    var cov = 0;
    var ci = 0;
    while (ci < tokenbuf_count(whole)) {
        cov = cov + tokenbuf_len(whole, ci);
        ci = ci + 1;
    }
    if (cov != n) {
        eprint("FAIL: ", 6);
        eprint(lang, strlen(lang));
        eprint(" — single-feed coverage broken\n", 33);
        return 1;
    }

    var sizes = alloc(64);
    if (sizes == 0) { return 1; }
    store64(sizes,      1);
    store64(sizes +  8, 2);
    store64(sizes + 16, 3);
    store64(sizes + 24, 5);
    store64(sizes + 32, 7);
    store64(sizes + 40, 64);
    store64(sizes + 48, 512);
    store64(sizes + 56, 4096);

    var k = 0;
    var rc = 0;
    while (k < 8) {
        var cs = load64(sizes + k * 8);
        var tb = _ci_tok(lang, buf, n, cs);
        if (tb == 0) { rc = 1; }
        if (tb != 0) {
            if (_ci_same(whole, tb, lang, cs) == 0) { rc = 1; }
        }
        k = k + 1;
    }
    # Two-feed splits every 37 bytes (prime, so the cuts drift through
    # every alignment the chunk sizes above repeat).
    var sp = 1;
    while (sp < n) {
        var stb = _ci_split(lang, buf, n, sp);
        if (stb == 0) { rc = 1; }
        if (stb != 0) {
            if (_ci_same(whole, stb, lang, sp) == 0) {
                eprint("  (two-feed split at the offset above)\n", 39);
                rc = 1;
            }
        }
        sp = sp + 37;
    }
    return rc;
}

# Every-offset two-feed split of a short literal input — the exact
# shapes the audits found, 2.5.2 onward. Returns 0 on success.
fn _ci_every(lang, src) {
    _ci_n_shapes = _ci_n_shapes + 1;
    var n = strlen(src);
    var whole = _ci_tok(lang, src, n, n);
    if (whole == 0) { return 1; }
    var rc = 0;
    var p = 1;
    while (p < n) {
        var tb = _ci_split(lang, src, n, p);
        if (tb == 0) { rc = 1; }
        if (tb != 0) {
            if (_ci_same(whole, tb, lang, p) == 0) {
                eprint("  (every-offset case, split above)\n", 35);
                rc = 1;
            }
        }
        p = p + 1;
    }
    # And fed 1, 2 and 3 bytes at a time, a drain after each (2.9.1). The
    # splits above drain twice in all; some states need several drains in
    # a row with almost nothing buffered: a prefixed triple-quoted string
    # whose body starts with quotes closed early only that way (2.9.1
    # audit, reviewer B, F1).
    var c = 1;
    while (c <= 3) {
        var ctb = _ci_tok(lang, src, n, c);
        if (ctb == 0) { rc = 1; }
        if (ctb != 0) {
            if (_ci_same(whole, ctb, lang, c) == 0) {
                eprint("  (small-chunk case, chunk size above)\n", 39);
                rc = 1;
            }
        }
        c = c + 1;
    }
    return rc;
}

# Every corpus: the 41 non-compose grammars since 2.5.2 (it was 15; 12
# of the other 26 failed the every-offset split until the 2.5.2
# streaming fixes), shell_modules.sh since 2.6.0, and the compose
# corpora since 2.8.0. Then the exact shapes the audits found, at every
# split offset.
fn _ci_main() {
    bootstrap_grammars();
    var rc = 0;

    if (_ci_one("tests/corpus/asm_aarch64.s", "asm_aarch64") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/asm_x86_64.s", "asm_x86_64") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/c.c", "c") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.cpp", "cpp") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.cr", "crystal") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.cs", "csharp") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.css", "css") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/cyrius.cyr", "cyrius") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/Dockerfile", "dockerfile") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.ex", "elixir") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/go.go", "go") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.graphql", "graphql") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.hs", "haskell") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.ini", "ini") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.java", "java") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.js", "javascript") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.json", "json") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.jl", "julia") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.kt", "kotlin") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.ll", "llvm_ir") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.lua", "lua") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/Makefile", "makefile") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.nix", "nix") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.ml", "ocaml") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/openqasm.qasm", "openqasm") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.php", "php") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.ps1", "powershell") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.proto", "protobuf") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/python.py", "python") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.rb", "ruby") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/rust.rs", "rust") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.scss", "scss") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/shell.sh", "shell") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/shell_modules.sh", "shell") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.sql", "sql") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.swift", "swift") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.tf", "terraform") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.toml", "toml") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/typescript.ts", "typescript") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.xml", "xml") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.yaml", "yaml") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/zig.zig", "zig") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.md", "markdown") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/README.md", "markdown") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.html", "html") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.vue", "vue") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.svelte", "svelte") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/dependencies.cyml", "cyml") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/phase_d.cyml", "cyml") != 0) { rc = 1; }
    # 2.9.9: NASM, MDX, Lean 4 stand-ins.
    if (_ci_one("tests/corpus/concept.asm", "nasm") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.mdx", "mdx") != 0) { rc = 1; }
    if (_ci_one("tests/corpus/concept.lean", "lean") != 0) { rc = 1; }
    if (_ci_every("json", "{\"a\":\"x\\\"y\"}") != 0) { rc = 1; }
    if (_ci_every("toml", "k = \"a \\\\\\\" b\"\n") != 0) { rc = 1; }
    if (_ci_every("c", "c = '\\n'; d = '\\033'; e = '\\\\';") != 0) { rc = 1; }
    if (_ci_every("rust", "let a = '\\u{2026}'; let b = 'x';") != 0) { rc = 1; }
    if (_ci_every("java", "char c = '\\u0041';") != 0) { rc = 1; }
    if (_ci_every("python", "x = 1\n#!foobar\ny = 2\n") != 0) { rc = 1; }
    if (_ci_every("shell", "echo a\n#!/bin/sh\necho b\n") != 0) { rc = 1; }
    # 2.6.0 (ADR 0022): `#` is a comment only at word start, decided by
    # the byte BEFORE it — which a mid-stream buffer gets from the drain.
    if (_ci_every("shell", "n=${#v} b=${p##*/} a#b #c\necho \\\" \\# $1;#d\n") != 0) { rc = 1; }
    # 2.6.0 (ADR 0023): heredocs are non-local — the body depends on an
    # opener committed before it and a terminator that arrives after —
    # so the drain holds from the line's first unresolved opener. Two
    # openers on one line, `<<-` with a tab-indented terminator, a quoted
    # delimiter, an arithmetic `<<`, a here-string, an unterminated one.
    if (_ci_every("shell", "cat <<EOF > o\nit's # x\nEOF\ny=$((1 << n))\nc <<'Q' <<-T\nq\nQ\n\tt\n\tT\nr <<< x\nd <<NOEND\nn # c\n") != 0) { rc = 1; }
    if (_ci_every("shell", "a <<A <<B <<C\n1\nA\n2\nB\n3\nC\nz <<X; y <<Y\nx\nX\ny\nY\necho e\n") != 0) { rc = 1; }
    # 2.6.x audit: each failed at some split offsets on 2.6.1 — an
    # arithmetic `<<` read as a heredoc once the `((` had committed; a
    # body whose opener was "resolved" by a terminator that belongs to
    # an earlier body, or sits inside a string spanning lines; a 1-byte
    # body held by the marker window while its opener line committed.
    if (_ci_every("shell", "y=$((1 << n))\necho a\nn\necho b # c\n") != 0) { rc = 1; }
    if (_ci_every("shell", "x=1\n(( v = a << b ))\necho a # c\nb\necho z\n") != 0) { rc = 1; }
    if (_ci_every("shell", "x=$(( a << b ))\nb\ncat <<EOF\nit's\nEOF\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<EOF \"a\nEOF\n\"\nbody # x\nEOF\necho end\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<EOF | awk '\nEOF\n'\nbody # x\nEOF\necho end\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<A <<B\nB\nA\nbody b # x\nB\necho end\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<E <<E\nx\nE\ny # c\nE\necho end\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<EOF >a; cat <<EOF >b\nx\nEOF\nit's\nEOF\necho z\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<E\nE\necho z\n") != 0) { rc = 1; }
    if (_ci_every("shell", "a <<E <<F\nE\nF\nz\n") != 0) { rc = 1; }
    if (_ci_every("shell", "sed 's/((a)/' <<EOF\nit's\nEOF\ncat <<END-OF-DATA\nb # c\nEND-OF-DATA\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<EOF\r\nx # y\r\nEOF\r\nb=${dir##*/}\r#c\n") != 0) { rc = 1; }
    # 2.7.0 number shapes (ADR 0026): a number the next bytes can extend
    # — `1` + `.5`, `1_` + `000`, `1979` + `-05-27` — must not commit early.
    if (_ci_every("python", "x = 1.5e-3 + 1_000 + 0x_FF + 1.max + 2E+10 + 7\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let r = 0..10; t.0.1; 1_000u32; 2.5e10_f64; 12345.678_9\n") != 0) { rc = 1; }
    if (_ci_every("cpp", "int x = 1'000'000; char c = 'a'; double d = 1.0e3f;\n") != 0) { rc = 1; }
    if (_ci_every("toml", "d = 1979-05-27T07:32:00.999-07:00\ne = 1979-05-27 07:32:00\nt = 07:32:00\nf = 6.626e-34\n") != 0) { rc = 1; }
    if (_ci_every("yaml", "date: 2001-12-14t21:59:43Z\nv: 1.2.3\nn: 12345\n") != 0) { rc = 1; }
    if (_ci_every("json", "{\"a\": -1.5E+10, \"b\": 0.25, \"c\": 123456789}") != 0) { rc = 1; }
    # 2.8.0: prefixed strings that span lines or end in escapes — the
    # streaming helpers judged them as line comments through 2.7.1.
    if (_ci_every("python", "x = f\"\"\"a\nb {c}\n\"\"\"\ny = rb'''p\\\nq'''\nz = F\"r\\\"s\"\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let x = r\"a\\\nb\";\nlet y = br\"c\\\nd\";\nlet z = b\"e\\\"f\";\n") != 0) { rc = 1; }
    if (_ci_every("c", "w = L\"wide\\\nline\"; v = u8\"a\\\"b\";\n") != 0) { rc = 1; }
    # 2.7.1 (ADR 0027): string prefixes, `ident_lead`, `followed_by` /
    # `not_followed_by`, makefile automatic variables, heredoc word forms.
    if (_ci_every("python", "x = f\"{a}\" + rb'\\d' + R\"\"\"y\"\"\" + u'z' + ab\"q\" + F''\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let a = b'\\n'; let r = r\"C:\\\"; let s = br\"x\"; let t = b\"hi\"; r;\n") != 0) { rc = 1; }
    if (_ci_every("c", "w = L\"wide\"; c = u8'x'; L = 1; u = U\"y\";\n") != 0) { rc = 1; }
    if (_ci_every("css", "a { width: calc(100% - 10px); margin: -2px; -webkit-x: --y; }\n") != 0) { rc = 1; }
    if (_ci_every("php", "<?php\n#[Route(\"/x\")]\nfunction f() {} # c\n#\n") != 0) { rc = 1; }
    if (_ci_every("cyrius", "#ifdef X\nfn f() {} # c\n    #endif\n# note\n#derive(Eq)\n") != 0) { rc = 1; }
    if (_ci_every("makefile", "a:\n\tcc $< $^ $% $+ $| $$x $(CC) $@\n") != 0) { rc = 1; }
    if (_ci_every("ruby", "@@count += @x + $y\n") != 0) { rc = 1; }
    if (_ci_every("shell", "cat <<\"E\"OF\nit's\nEOF\ncat <<''\nb's\n\ned f <<!\nq's\n!\ncat <<E\\OF\nr's\nEOF\n") != 0) { rc = 1; }
    if (_ci_every("php", "<?php $a === $b && $c !== $d;") != 0) { rc = 1; }
    if (_ci_every("ocaml", "let xs = 1 :: 2 :: [];;") != 0) { rc = 1; }
    # 2.8.0: compose shapes — a split inside a start marker, an end
    # marker, a fence's info line, a cyml region and its `\n[[`.
    if (_ci_every("markdown", "before\n```rust\nfn x() {}\n```\nafter ``code`` and `a` <!-- c -->\n# t\n\n```python\nx = 1  # c\n```\n") != 0) { rc = 1; }
    if (_ci_every("html", "<p>a</p><style>\na { b: c; }\n</style><script>\nlet x = \"</s\";\n</script><!-- d -->\n") != 0) { rc = 1; }
    if (_ci_every("vue", "<template><p>{{ a }}</p></template>\n<script>\nexport default {}\n</script>\n<style>\n.a { b: c }\n</style>\n") != 0) { rc = 1; }
    if (_ci_every("cyml", "[a]\nk = 1\n---\n# Title\n\ntext `code` *em*\n\n[[b]]\nz = \"q\"\n---\nmore\n") != 0) { rc = 1; }
    # 2.9.1: fences that close after `end_indent` bytes (a list item, a
    # blockquote), and fence tags that resolve by extension / interpreter.
    if (_ci_every("markdown", "1. Build:\n   ```sh\n   make all\n   ```\n2. Then.\n\n```python\nx = 1\n```\n") != 0) { rc = 1; }
    if (_ci_every("markdown", "> ```c\n> int a;\n> ```\n\n```bash\necho \"$x\" # c\n```\n") != 0) { rc = 1; }
    # Prefixed triple-quoted strings whose body starts with quotes (B, F1).
    if (_ci_every("python", "s = f\'\'\'\'\'hello\'\'\'\nt = b\"\"\"\"\"\"\nu = rb\'\'\'x\\\'\'\'\n") != 0) { rc = 1; }
    # 2.9.3: Swift tuple indexes — a split after `0.0...1` leaves `1.5` at
    # the buffer start with only `..` behind it, so the drain must carry
    # two bytes of look-behind — then block comments and string prefixes.
    if (_ci_every("swift", "let a = t.0.1; let b = 0.0...1.5; let c = t.0.1e5 + t.1.2.3; d = 0..<1.5\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let x = 1; /* a /* b */ c */ /** d */ /*! e */ x\n") != 0) { rc = 1; }
    if (_ci_every("javascript", "a /* b */ /= 2; /** @c */ d / e;\n") != 0) { rc = 1; }
    if (_ci_every("typescript", "let a: T /* b */ = c; /** @d */\n") != 0) { rc = 1; }
    if (_ci_every("python", "x = t\"{a}\" + tr'\\d' + RT\"q\" + tb\"n\" + r\"\\\"\"\n") != 0) { rc = 1; }
    if (_ci_every("sql", "SELECT N'a''b', n'x', M'y' FROM t;\n") != 0) { rc = 1; }
    if (_ci_every("julia", "x = raw\"a\\\"b\" * r\"\\d+\" * b\"hi\" * v\"1.2\" * html\"n\"\n") != 0) { rc = 1; }
    # 2.9.5 (ADR 0030): inline literals with computed closers — split
    # inside an opener, a run, a closer — and Ruby / PHP heredocs, with
    # unterminated literals that must hold to the end.
    if (_ci_every("rust", "let a = r#\"say \"hi\" \\ \"#; let b = br##\"x\"#y\"##; let t = r#type; let c = cr#\"z\"#; let d = r\"q\";\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let x = r##\"never \"# closed\nmore\n") != 0) { rc = 1; }
    if (_ci_every("swift", "let a = #\"a \"b\" \\(x)\"#\nlet m = #\"\"\"\nline \"q\"\n\"\"\"#\nlet h = ##\"x\"#y\"##\n#if X\n") != 0) { rc = 1; }
    if (_ci_every("lua", "local s = [==[a ]] ]=] b]==]\n--[=[ c\n]] ]=]\nlocal t = [[x]] -- d\nx = a[b] (--[==[ e ]==]) f\n") != 0) { rc = 1; }
    if (_ci_every("lua", "--[==[ open\n]=] ]]\n") != 0) { rc = 1; }
    if (_ci_every("cpp", "auto a = R\"(x \"y\" \\n)\";\nauto b = R\"d(a )\" b)d\";\nauto c = u8R\"(z)\"; auto R = 1;\n") != 0) { rc = 1; }
    if (_ci_every("ruby", "a = <<~EOS.strip\n  it\'s # not\n  EOS\nb = x << y\nclass << self\nend\nputs(<<-A, <<B)\n  one\n  A\ntwo\nB\nc = d <<e\n") != 0) { rc = 1; }
    if (_ci_every("php", "<?php\n$a = <<<EOT\n  it\'s $x\n  EOT;\n$b = <<<\'N\'\nraw\nN . \"z\";\n$c = 1 << 2;\n") != 0) { rc = 1; }
    # 2.9.7 (ADR 0026): leading / trailing dots and type suffixes — a
    # number the next bytes can still extend must not commit early.
    if (_ci_every("c", "x = .5 + 1. + 1.e5 + 10UL + 1.5f + .5f + 1.f + 0xFFu + a.b + t[0].5 + 1.x + 1..2;\n") != 0) { rc = 1; }
    if (_ci_every("rust", "let a = 1u32 + 1_u32 + 2.5f64 + 0xFFu8 + 1. + 0..10 + 1.max(2) + t.0.1 + 1usizex + 7usize;\n") != 0) { rc = 1; }
    if (_ci_every("python", "x = .5 + 1. + 2j + 1.5J + 1.j + x.real + 1if y else 2\n") != 0) { rc = 1; }
    if (_ci_every("javascript", "const b = 10n + .5 + 1. + 1.toFixed(2) + x.5;\n") != 0) { rc = 1; }
    if (_ci_every("css", "a { opacity: .5; margin: -.5em 1.5px; }\n.x5 { }\n") != 0) { rc = 1; }
    if (_ci_every("ocaml", "x = 1. +. 2.5 +. 1.e3 in let n = 10L and m = 3l\n") != 0) { rc = 1; }
    if (_ci_every("powershell", "$x = -.5 + (.25) * $y.5\n") != 0) { rc = 1; }
    # Python's marker window is 3 bytes (no char literals), so only the
    # number lookahead holds `1.` until `.e+5` has all arrived.
    if (_ci_every("python", "y = 1.e+5 + 2.E-3 + 3.j + 4.\n") != 0) { rc = 1; }
    # 2.9.6 (ADR 0027): symbol-shaped string prefixes — C#'s verbatim
    # strings end at their quote however they are split, a backslash
    # before a line break included.
    if (_ci_every("csharp", "var a = @\"C:\\dir\\\"; var b = $\"x {y}\\n\"; var c = $@\"p {q} \\\"; var d = @$\"r\"; var e = @class; var f = @\"say \"\"hi\"\"\"; var g = $ \"z\";\n") != 0) { rc = 1; }
    if (_ci_every("csharp", "var p = @\"a\\\nb\\\"; var q = $@\"{x}\\\n\\\"; var r = $\"s\\\"t\";\n") != 0) { rc = 1; }
    # Bodies longer than the drain's marker window, so a split inside takes
    # the pending-pair fast path: it must scan a raw prefix's body raw.
    if (_ci_every("csharp", "var p = @\"0123456789abcdefghij\\\n0123456789abcdefghij\\\"; var q = 1;\n") != 0) { rc = 1; }
    # Openers longer than the drain's marker window (12 bytes for rust,
    # swift and cpp, 4 for lua): only the scanner's cut-opener hold keeps
    # their first bytes from committing as an identifier or punctuation.
    if (_ci_every("rust", "let x = r##############\"a\"##############; y\n") != 0) { rc = 1; }
    if (_ci_every("swift", "let x = ##############\"a\"##############\n") != 0) { rc = 1; }
    if (_ci_every("lua", "x = [======[a]======] y\n") != 0) { rc = 1; }
    if (_ci_every("cpp", "auto x = R\"abcdefghijklmnop(a)abcdefghijklmnop\"; y\n") != 0) { rc = 1; }
    # 2.9.10 (ADR 0032): resumable regions. A split after an opener reads
    # the body with its inner grammar as a stream of its own: the end
    # marker split, "```" mid-line, a closer after `end_indent` bytes, a
    # partial `</sty` that is body after all, a `#!` at a body's start,
    # bodies with no end at all, a cyml `\n[[` and an mdx blank line.
    # (Fences hold for their closer since 2.9.12: the markdown shapes
    # now exercise that hold, not region mode.)
    if (_ci_every("markdown", "a\n\n```python\nx = 'a'  # c\ny = \"\"\"doc\n```\nz = 1.5\n```\nafter `x` ``y``\n") != 0) { rc = 1; }
    if (_ci_every("markdown", "x\n```python\ns = \"```\" + t\nu = 1 ```\n  v ```\n> ```\nw\n```\nend\n") != 0) { rc = 1; }
    if (_ci_every("markdown", "```python\n#!/usr/bin/env python\nprint('x')\n``` \n``` trailing\n````\n```\n") != 0) { rc = 1; }
    if (_ci_every("markdown", "text\n```rust\nfn main() { let r = r#\"x\"#; }\n// open comment") != 0) { rc = 1; }
    if (_ci_every("html", "<p>a</p><style>a{b:1.5em} /* c */ .x{}</style><script>let a = '</scr' + \"x\"; // c\n</script><p>z</p>") != 0) { rc = 1; }
    if (_ci_every("html", "<style>a { color: red; }</sty</style>x<style>open") != 0) { rc = 1; }
    if (_ci_every("cyml", "[a]\nb = 1\n---\n# H\n\n```py\nx = 1\n```\ntext `c`\n[[e]]\nq = 2\n---\nbody\n\n[[e]]\n---\nlast *x*\n") != 0) { rc = 1; }
    if (_ci_every("mdx", "import A from 'a'\nimport B from 'b'\n\n# T\n\n{1 + 2} and {open\n\nexport const x = 1\nexport default y\n") != 0) { rc = 1; }
    # 2.9.12 audit: a fence body whose last token commits through its line
    # break (reviewer B, G1); MDX ESM blocks ended by CRLF and blank-with-
    # spaces lines (A2); a regex's `\/*` (A5); C#'s doubled quote in a
    # verbatim string (A6); Lean projections (A8).
    if (_ci_every("markdown", "# Title\n\n```lua\nlocal x = 1 -- the answer\n```\n\nSome *text* after.\n```python\nx = \"abc\\\n\" ```\ny\n```\nz\n") != 0) { rc = 1; }
    if (_ci_every("mdx", "import {Chart} from \"./chart.js\"\r\n\r\n# Hello\r\n\r\nIt's a *test* `code`.\r\nexport const m = {a: 1}\n  \nIt's the \"intro\nover lines.\n") != 0) { rc = 1; }
    if (_ci_every("javascript", "url = url.replace(/^\\/*|\\/*$/g, \"\");\nlet x = 1; // c\nvar r = /a\\//.test(s);\n") != 0) { rc = 1; }
    if (_ci_every("csharp", "var p = @\"Path: \"\"C:\\dir\\\"\"\";\nvar q = 1;\nvar r = @\"a \"\"b\"\" c\" + $@\"x {y} \"\"z\"\"\";\nvar s = @\"\"\"\";\nvar t = @\"0123456789abcdefghij\"\"0123456789abcdefghij\"\"\";\n") != 0) { rc = 1; }
    if (_ci_every("lean", "example : p := h.2.2\ndef f := (p.1.2, x.10.3, 1.5)\n") != 0) { rc = 1; }

    return rc;
}

fn _harness_main() {
    if (_ci_main() != 0) {
        eprint("chunk-invariance fuzz: FAIL\n", 28);
        return 1;
    }
    print("chunk-invariance fuzz: OK (", 27);
    fmt_int(_ci_n_corpora);
    print(" corpora x 8 chunk sizes + 37-byte two-feed splits; ", 52);
    fmt_int(_ci_n_shapes);
    print(" every-offset shapes)\n", 22);
    return 0;
}

var _ec = _harness_main();
syscall(60, _ec);
