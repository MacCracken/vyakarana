# vyakarana — streaming-aware fuzz harness (2.1.4+)
#
# Random feed sequences that exercise the streaming primitive
# and the pending-pair fast path beyond what the corpus-based
# `fuzz/tokenize.fcyr` covers. The contract verified here is
# byte-equivalence: any chunking strategy produces the same
# (kind, start, len) tokens as a single-shot feed of the same
# source. Pre-2.0.1 this was an aspirational claim;
# 2.0.1's rolling buffer + 2.0.3's pending-pair tracking +
# 2.1.4's discard primitive all need it to hold for
# correctness.
#
# Invariants asserted per-iteration:
#
#   1. Random-split feed produces the same token *count* as
#      single-shot feed. (Coverage doesn't catch reordering;
#      counts differ only when a partial commit happens.)
#   2. Per-token (kind, start, len) matches single-shot
#      one-for-one. Catches abs_offset arithmetic bugs,
#      pending-pair scan_resume off-by-one, compaction
#      glitches.
#   3. Coverage invariant — sum(len) over all tokens equals
#      strlen(src).
#
# Inputs span the grammars where streaming complications are
# most likely:
#   - shell — line / pair rules + special_vars + shebang
#   - rust — multi-byte operators (`<<=`, `..=`)
#   - c — block comments straddling chunks (the 2.0.3 case)
#   - html — compose rules (script body routes through JS)
#   - python — line comments + indented strings (no triple-
#     quote here yet; covered by julia in 2.1.0)
#
# Pseudorandom split offsets via xorshift seeded from a fixed
# constant — same sequence every run; failures reproduce.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"

var _strm_state = 1442695040888963407;

fn _strm_rand() {
    var x = _strm_state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _strm_state = x;
    return x;
}

fn _strm_randint(lo, hi) {
    # Returns a value in [lo, hi).
    if (hi <= lo) { return lo; }
    var range = hi - lo;
    var r = _strm_rand();
    if (r < 0) { r = (0 - r) - 1; }
    return lo + (r % range);
}

# Tokenize `src` with a single feed; returns the populated
# tokenbuf. The "ground truth" against which random-split
# results are compared.
fn _strm_baseline(src, lang) {
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    var tb = tokenbuf_new();
    tokenize_stream_feed(s, src, strlen(src));
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return tb;
}

# Tokenize `src` with `n_splits` random splits. drain is
# called between feeds (push-style); returns the final
# tokenbuf.
fn _strm_random_split(src, lang, n_splits) {
    var n = strlen(src);
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    var tb = tokenbuf_new();
    var pos = 0;
    var i = 0;
    while (i < n_splits) {
        var remaining = n - pos;
        if (remaining <= 0) { i = n_splits; }
        if (remaining > 0) {
            var chunk_len = _strm_randint(1, remaining + 1);
            if ((i == n_splits - 1) && (pos + chunk_len < n)) {
                chunk_len = n - pos;
            }
            tokenize_stream_feed(s, src + pos, chunk_len);
            tokenize_stream_drain(s, tb);
            pos = pos + chunk_len;
            i = i + 1;
        }
    }
    if (pos < n) {
        tokenize_stream_feed(s, src + pos, n - pos);
    }
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return tb;
}

# Compare two tokenbufs token-by-token. Returns 0 if
# byte-equivalent, non-zero on the first mismatch (with stderr
# diagnostic).
fn _strm_compare(tb_a, tb_b, label) {
    var ca = tokenbuf_count(tb_a);
    var cb = tokenbuf_count(tb_b);
    if (ca != cb) {
        eprint("FAIL: ", 6); eprint(label, strlen(label));
        eprint(" — token count mismatch\n", 25);
        return 1;
    }
    var i = 0;
    while (i < ca) {
        if (tokenbuf_kind(tb_a, i)  != tokenbuf_kind(tb_b, i))  {
            eprint("FAIL: ", 6); eprint(label, strlen(label));
            eprint(" — kind mismatch\n", 18);
            return 1;
        }
        if (tokenbuf_start(tb_a, i) != tokenbuf_start(tb_b, i)) {
            eprint("FAIL: ", 6); eprint(label, strlen(label));
            eprint(" — start mismatch\n", 19);
            return 1;
        }
        if (tokenbuf_len(tb_a, i)   != tokenbuf_len(tb_b, i))   {
            eprint("FAIL: ", 6); eprint(label, strlen(label));
            eprint(" — len mismatch\n", 17);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Run one source × language across N split shapes (varying
# chunk counts).
fn _strm_one(src, lang, label) {
    if (has_grammar(lang) == 0) { return 0; }
    var baseline = _strm_baseline(src, lang);
    if (baseline == 0) { return 0; }
    var split_counts_buf = alloc(48);
    store64(split_counts_buf,      2);
    store64(split_counts_buf + 8,  4);
    store64(split_counts_buf + 16, 8);
    store64(split_counts_buf + 24, 16);
    store64(split_counts_buf + 32, 32);
    var s_i = 0;
    while (s_i < 5) {
        var n_splits = load64(split_counts_buf + s_i * 8);
        var split_tb = _strm_random_split(src, lang, n_splits);
        if (split_tb == 0) {
            eprint("FAIL: ", 6); eprint(label, strlen(label));
            eprint(" — split tokenbuf is null\n", 27);
            return 1;
        }
        if (_strm_compare(baseline, split_tb, label) != 0) { return 1; }
        s_i = s_i + 1;
    }
    return 0;
}

fn fuzz_main(data, n) {
    if (has_grammar("shell") == 0) {
        eprint("FAIL: shell grammar didn't load\n", 33);
        return 1;
    }

    # Shell — line + pair + special_vars.
    var sh1 = "if [ -d /tmp ]; then echo \"hi $USER\"; fi";
    if (_strm_one(sh1, "shell", "shell/conditional") != 0) { return 1; }
    var sh2 = "for i in 1 2 3; do echo $i; done\n# trailing comment";
    if (_strm_one(sh2, "shell", "shell/for-loop") != 0) { return 1; }

    # Rust — multi-byte operators, generics, lifetimes.
    var rs1 = "fn add<T: Copy>(x: T, y: T) -> T { x + y }";
    if (_strm_one(rs1, "rust", "rust/generic-fn") != 0) { return 1; }
    var rs2 = "let x = 1..=10; let y = x.iter().map(|n| n * 2);";
    if (_strm_one(rs2, "rust", "rust/range-iter") != 0) { return 1; }

    # C — block comment straddling chunks (2.0.3's pending-pair
    # case is the explicit target here).
    var c1 = "/* multi-line\n * block comment\n * with stars\n */ int x = 1;";
    if (_strm_one(c1, "c", "c/block-comment") != 0) { return 1; }
    var c2 = "char *s = \"hello\\nworld\"; // line comment";
    if (_strm_one(c2, "c", "c/string-with-escape") != 0) { return 1; }

    # HTML — compose rules for `<script>` → JS and `<style>` →
    # CSS. Pre-2.2.1 these random-split cases were disabled
    # because compose-rule START markers split across chunk
    # boundaries lost the route (FINDING-011). 2.2.1's
    # `_stream_compose_prefix_hold` fixes the gap; cases now
    # re-enabled.
    var h1 = "<style>.x{color:red;}</style><div>hi</div>";
    if (_strm_one(h1, "html", "html/compose-style") != 0) { return 1; }
    var h2 = "<script>const x = 42;</script>";
    if (_strm_one(h2, "html", "html/compose-script") != 0) { return 1; }

    # Vue SFC — outer Vue tokenizer with compose for <script>
    # and <style>. Verifies the prefix-hold works for grammars
    # with multiple compose rules.
    var v1 = "<script>let x = 1;</script><style>.x{}</style>";
    if (_strm_one(v1, "vue", "vue/script-and-style") != 0) { return 1; }

    # Markdown — compose_fenced rule with captured language
    # tag. The prefix-hold helper covers compose_fenced rules
    # too; chunk-boundary in ` ``` ` opener should hold cleanly.
    var md1 = "before\n```rust\nfn x() {}\n```\nafter";
    if (_strm_one(md1, "markdown", "markdown/fence-rust") != 0) { return 1; }

    # Python — indented blocks, f-string-ish.
    var py1 = "def f(x):\n    return x + 1\n\nf(42)";
    if (_strm_one(py1, "python", "python/def") != 0) { return 1; }

    return 0;
}

fn _harness_main() {
    if (fuzz_main("x", 1) != 0) {
        eprint("streaming fuzz: FAIL\n", 22);
        return 1;
    }
    print("streaming fuzz: OK\n", 19);
    return 0;
}

var _ec = _harness_main();
syscall(60, _ec);
