# vyakarana — data-driven default scanner
#
# Consumes a loaded grammar record (see src/grammar.cyr) and tokenizes
# source bytes into a tokenbuf. Scanner dispatch follows ADR 0005:
#
#   H. queued here-document bodies (ADR 0023), at the
#      line start after their opener line            → kind, 1 per body
#   0. [[rules]] match="compose" (ADR 0013)           → recursive
#      (start marker + inner-grammar body + end marker)
#   0b. [[rules]] match="compose_fenced" (ADR 0016)   → recursive
#      (inner grammar captured per-fence from the info string)
#   0c. [[rules]] match="compose_region" (ADR 0019)   → recursive
#      (start marker + inner-grammar body; ends BEFORE an
#       unconsumed lookahead terminator, or at EOF)
#   1. shebang (#! on line 0, column 0)              → preprocessor
#   2. [[rules]] match="line"                         → kind
#   3. [[rules]] match="pair"                         → kind
#   4. defaults.special_vars ($X, X = #?@!*$-)        → operator, 2 bytes
#   5. defaults.special_vars lone $                   → operator, 1 byte
#   6. defaults.ident_start/ident_cont                → ident, or keyword
#      via [[rules]] match="words" lookup, or — with a declared
#      string prefix (ADR 0027) — one string: prefix + literal
#   7. defaults.number_decimal/_0x/_0b/_0o            → number
#      (shaped by number_float / _separator / _datetime, ADR 0026)
#   7b. defaults.char_literal `'C'`/`'\C'`/`'\xHH'`   → string
#   7c. [[rules]] match="heredoc" opener (ADR 0023)   → consumes nothing;
#      queues the body for step H on the next line
#   8. defaults.operators (first match, longest-first) → operator
#   9. defaults.punctuation (first match, longest-first) → punctuation
#  10. defaults.whitespace (run)                      → whitespace
#  11. fallthrough                                    → error (1 byte)
#
# Coverage invariant holds at every step — the main loop advances by
# `len` on each iteration and a fallback error emits 1 byte when no
# rule matched.
#
# Known optimization, not taken: the operators / punctuation lists
# are scanned linearly longest-first; a trie or length-indexed
# bucket scan would cut the per-token constant. Deliberately still
# open — the tokenize rows in `docs/development/performance.md` are
# dominated by streaming call overhead, not this scan, so it is not
# the profitable lever yet. (This used to say "an easy speedup at
# M5 benchmark time"; M5 landed in 2.0.0-2.0.2, so that framing
# was stale — the work was never the milestone's.)

include "src/token.cyr"
include "src/grammar.cyr"

# ── Scanner helpers (mirror the hand-coded shell.cyr shape) ─────────

fn _ds_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

fn _ds_is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn _ds_is_hex_digit(b) {
    if (_ds_is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }
    if ((b >= 65) && (b <= 70))  { return 1; }
    return 0;
}

fn _ds_is_bin_digit(b) {
    if (b == 48) { return 1; }
    if (b == 49) { return 1; }
    return 0;
}

fn _ds_is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }
    return 1;
}

# Since 2.6.0 the digits too: `$0`..`$9` are positional parameters,
# and splitting them into `$` + number broke `$1x` style words apart
# differently from every other `$X`. Shared by every special_vars
# grammar (shell, makefile — where `$1` is make's `$(1)`).
fn _ds_is_special_var_char(b) {
    if ((b >= 48) && (b <= 57)) { return 1; }   # 0-9
    if (b == 35) { return 1; }   # #
    if (b == 63) { return 1; }   # ?
    if (b == 64) { return 1; }   # @
    if (b == 33) { return 1; }   # !
    if (b == 42) { return 1; }   # *
    if (b == 36) { return 1; }   # $
    if (b == 45) { return 1; }   # -
    return 0;
}

# ── Per-rule try-match functions ────────────
# Each returns a length > 0 if it matched at src[i], else 0.

fn _ds_try_shebang(g, src, src_len, i) {
    if (grammar_shebang_on(g) == 0) { return 0; }
    if (i != 0) { return 0; }
    if (src_len < 2) { return 0; }
    if (load8(src) != 35) { return 0; }      # #
    if (load8(src + 1) != 33) { return 0; }  # !
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Is `b` one of the bytes of cstr `set`?
fn _ds_byte_in(set, b) {
    var k = 0;
    var c = load8(set);
    while (c != 0) {
        if (c == b) { return 1; }
        k = k + 1;
        c = load8(set + k);
    }
    return 0;
}

# Try each [[rules]] match="line" in order. Returns kind packed into
# high 8 bits and len in low 56 bits — 0 if none matched. (This is
# the cheapest multi-return I could find without tuples.)
# `prev0` is the byte before `src[0]` — the streaming drain's last
# committed byte — or -1 when `src` starts the input. A rule with
# `start_after` (ADR 0022) matches only at input start or right after
# one of its bytes: shell's `#` opens a comment only at the start of a
# word, so `${#arr[@]}`, `${x#p}` and `a#b` are not comments. Through
# 2.5.2 the `#` rule fired anywhere and swallowed the rest of the line.
fn _ds_try_line_rules(g, src, src_len, i, prev0) {
    var rules = grammar_line_rules(g);
    var n = vec_len(rules);
    var b0 = load8(src + i);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var marker = line_rule_start(r);
        # First byte inline — it fails almost everywhere, and cyrius has
        # 17 `#word` rules (2.7.1) — then the full marker, then the
        # `start_after` boundary only on a match.
        var boundary_ok = 0;
        var mlen = 0;
        if (load8(marker) == b0) { mlen = strlen(marker); }
        if ((mlen > 0) && (i + mlen <= src_len) && (memeq(src + i, marker, mlen) == 1)) {
            boundary_ok = 1;
            var after = line_rule_after(r);
            if (after != 0) {
                var pb = prev0;
                if (i > 0) { pb = load8(src + i - 1); }
                if (pb >= 0) { boundary_ok = _ds_byte_in(after, pb); }
            }
        }
        # The byte after the marker (ADR 0027): none at the end of input.
        if (boundary_ok == 1) {
            var fb = line_rule_followed(r);
            var nfb = line_rule_not_followed(r);
            if ((fb != 0) || (nfb != 0)) {
                var nb = (0 - 1);
                if (i + mlen < src_len) { nb = load8(src + i + mlen); }
                if (fb != 0) {
                    if (nb < 0) { boundary_ok = 0; }
                    if ((nb >= 0) && (char_class_match(fb, nb) == 0)) { boundary_ok = 0; }
                }
                if ((nfb != 0) && (nb >= 0)) {
                    if (char_class_match(nfb, nb) == 1) { boundary_ok = 0; }
                }
            }
        }
        if (boundary_ok == 1) {
            var j = i;
            while (j < src_len) {
                if (load8(src + j) == 10) { break; }
                j = j + 1;
            }
            var len = j - i;
            return (line_rule_kind(r) << 56) | len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# ── Per-call scanner state (2.5.2) ─────────────────────────────────
# `_ds_cur_gen` names the `tokenize_with_grammar` call in progress:
# every call takes a fresh number on entry and restores its caller's
# on exit, so a compose body tokenized recursively has its own. The
# no-closer watermarks below are trusted only when stamped with the
# CURRENT generation — never across calls, where the same buffer
# pointer can hold different bytes (the streaming drain re-scans one
# rolling buffer that compacts between calls).
var _ds_gen_counter = 0;
var _ds_cur_gen = 0;
var _ds_depth = 0;
var _ds_inner_pool = 0;
var _ds_nolf_gen = 0;
var _ds_nolf_from = 0;

# Compose nesting cap (2.9.1). Two grammars whose compose_region rules
# route into each other (a consumer's own `.cyml`; `_gp_validate` only
# refuses a grammar composing itself) recursed once per region —
# `--- ` x 20,000 (80 KB) overflowed the stack (2.9.1 audit, reviewer C).
# Past this depth a body degrades to one string span, as for a missing
# inner grammar. The bundled grammars nest three deep at most (cyml →
# markdown → html → css).
var DS_MAX_DEPTH = 32;

# Scratch tokenbuf for a compose body's inner tokens at the current
# nesting depth, emptied for reuse; 0 if it cannot be allocated, or
# when the body would nest past DS_MAX_DEPTH — every caller then emits
# the body as one string span.
# Each compose match used to allocate a fresh one, and the bump
# allocator never frees: `<style>a</style>` x 65,000 (1 MB) took
# 57.8 MB of heap (2.5.2 audit P3-e). Safe to reuse because every
# caller copies the inner tokens out before returning, and a nested
# call runs one depth deeper, on its own slot.
fn _ds_inner_tb() {
    if (_ds_depth >= DS_MAX_DEPTH) { return 0; }
    if (_ds_inner_pool == 0) {
        _ds_inner_pool = vec_new();
        if (_ds_inner_pool == 0) { return 0; }
    }
    while (vec_len(_ds_inner_pool) <= _ds_depth) {
        var t = tokenbuf_new();
        if (t == 0) { return 0; }
        vec_push(_ds_inner_pool, t);
    }
    var itb = vec_get(_ds_inner_pool, _ds_depth);
    _tokenbuf_reset(itb);
    return itb;
}

# Try each [[rules]] match="compose" at the cursor.
#
# A compose rule routes the body between `start` and `end`
# markers through a *different* grammar (looked up by name in
# the registry). When matched:
#   - emits `start` bytes as one TK_PUNCTUATION token,
#   - tokenizes the body via the inner grammar (recursively),
#     adjusting offsets so they're absolute in the outer src,
#   - emits `end` bytes as one TK_PUNCTUATION token,
#   - returns the total bytes consumed.
#
# When the inner grammar isn't found in the registry (e.g.
# bootstrap order, or the embedded language was never bundled),
# the body falls back to one TK_STRING token — coverage holds.
#
# Unlike the pair / line / words rule helpers, this one writes
# directly to `tb` and returns the advance length. Returns 0
# when no compose rule matched at this cursor.
#
# Recursion: `tokenize_with_grammar` itself runs compose-rule
# step (step 0 below), so embedded grammars that themselves
# have compose rules nest correctly, up to DS_MAX_DEPTH (2.9.1).
#
# See ADR 0013 for the design.
fn _ds_try_compose_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = compose_rule_end(r);
            var elen = strlen(endp);
            var body_start = i + slen;
            # A search from an earlier body already found no closer
            # anywhere after it in this buffer, so none exists after
            # this one either. Through 2.5.1 every opener re-scanned
            # to EOF: `<style>` x 150k with no `</style>` (1 MiB html)
            # ran past 300 s (2.5.2 audit P2-5).
            if ((load64(r + 24) == _ds_cur_gen) && (body_start >= load64(r + 32))) {
                _ds_cp_hold(i, 3, endp, 0);
                return 0;
            }
            var j = body_start;
            while (j < src_len) {
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    # Found end marker. Emit start, body, end.
                    tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
                    var body_len = j - body_start;
                    if (body_len > 0) {
                        var inner_name = compose_rule_inner(r);
                        var inner_g = registry_find_by_name(inner_name);
                        var inner_tb = 0;
                        if (inner_g != 0) { inner_tb = _ds_inner_tb(); }
                        if (inner_tb != 0) {
                            # Inner grammar found — tokenize body
                            # in the depth's scratch buf, copy with
                            # shifted offsets.
                            tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                var ik = tokenbuf_kind(inner_tb, k);
                                var is = tokenbuf_start(inner_tb, k);
                                var il = tokenbuf_len(inner_tb, k);
                                tokenbuf_push(tb, ik, is + body_start, il);
                                k = k + 1;
                            }
                        } else {
                            # Inner grammar missing (or no scratch
                            # tokenbuf — out of memory; was a NULL
                            # write through 2.5.1) — graceful degrade:
                            # body is one string span.
                            tokenbuf_push(tb, TK_STRING, body_start, body_len);
                        }
                    }
                    tokenbuf_push(tb, TK_PUNCTUATION, j, elen);
                    _ds_grp_add(i, j + elen);
                    return slen + body_len + elen;
                }
                j = j + 1;
            }
            # End marker not found. Record it for this call, then hand
            # the opener back to the normal pipeline. NOTE: this
            # returns from the whole compose step — later compose
            # rules are not tried at this cursor. The comment here
            # used to say "fall through (next compose rule …)"; it
            # never did, and it only matters for two rules whose
            # starts share a prefix (no bundled grammar).
            store64(r + 24, _ds_cur_gen);
            store64(r + 32, body_start);
            _ds_cp_hold(i, 3, endp, 0);
            return 0;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="compose_region" at the cursor.
#
# Same routing as `compose`, with the two differences CYML needs
# (ADR 0019). `end_before` is a LOOKAHEAD terminator: the region
# stops just before it and those bytes are left for the outer
# grammar, so the `[[entries]]` that opens CYML's next TOML header
# survives as TOML. And running out of input is success, not
# failure — the region simply ends at EOF, which is how every
# CYML file's last body terminates.
#
# Emits the start marker plus the routed body. There is no end
# token: the terminator was never ours to consume.
fn _ds_try_compose_region_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_region_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_region_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endb = compose_region_rule_end_before(r);
            var elen = 0;
            if (endb != 0) { elen = strlen(endb); }
            var body_start = i + slen;
            # Scan for the terminator. Falling off the end is the
            # EOF case, and body_end is already correct for it.
            var body_end = src_len;
            var found = 0;
            if (elen > 0) {
                var j = body_start;
                while ((j < src_len) && (found == 0)) {
                    if ((j + elen <= src_len) && (memeq(src + j, endb, elen) == 1)) {
                        body_end = j;
                        found = 1;
                    }
                    j = j + 1;
                }
            }
            # Running into the buffer's end is not the EOF case until the
            # stream finishes: hold it (2.8.0).
            if (found == 0) {
                if (elen > 0) { _ds_cp_hold(i, 3, endb, 0); }
                if (elen == 0) { _ds_cp_hold(i, 4, 0, 0); }
            }
            if (found == 1) { _ds_grp_add(i, body_end); }
            tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
            var body_len = body_end - body_start;
            if (body_len > 0) {
                var inner_name = compose_region_rule_inner(r);
                var inner_g = registry_find_by_name(inner_name);
                var rinner_tb = 0;
                if (inner_g != 0) { rinner_tb = _ds_inner_tb(); }
                if (rinner_tb != 0) {
                    var inner_tb = rinner_tb;
                    tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                    var k = 0;
                    var nk = tokenbuf_count(inner_tb);
                    while (k < nk) {
                        var ik = tokenbuf_kind(inner_tb, k);
                        var is = tokenbuf_start(inner_tb, k);
                        var il = tokenbuf_len(inner_tb, k);
                        tokenbuf_push(tb, ik, is + body_start, il);
                        k = k + 1;
                    }
                } else {
                    # Inner grammar missing (or out of memory) — same
                    # graceful degrade as `compose`: one string span.
                    tokenbuf_push(tb, TK_STRING, body_start, body_len);
                }
            }
            return slen + body_len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# True if `b` is a tag-character (alphanumeric / `+` / `-` / `_`).
# CommonMark info-string is liberal but for grammar-name lookup
# we only care about the closed set [A-Za-z0-9_+-].
fn _ds_is_tag_byte(b) {
    if ((b >= 65) && (b <= 90))  { return 1; }     # A-Z
    if ((b >= 97) && (b <= 122)) { return 1; }     # a-z
    if ((b >= 48) && (b <= 57))  { return 1; }     # 0-9
    if (b == 95) { return 1; }                     # _
    if (b == 43) { return 1; }                     # +
    if (b == 45) { return 1; }                     # -
    return 0;
}

# Walk forward from `start` while bytes are tag-characters.
# Returns the offset just past the last tag byte (or `start` if
# none). Bounded by `src_len`.
fn _ds_scan_tag(src, src_len, start) {
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        # Read ONCE per iteration and advance only if the byte was
        # a tag byte. The previous shape incremented `p` in the
        # first `if` and then re-read `load8(src + p)` in the
        # second WITHOUT re-testing `p < src_len`, so a tag running
        # to the end of the buffer read `src[src_len]` — one byte
        # past the caller's allocation.
        #
        # `vyk` hid it: the CLI NUL-terminates at `buf[n]`, so the
        # stray byte was its own terminator. `tokenize_with_grammar`
        # is public surface though, and a consumer handing over an
        # exactly-sized buffer whose last page ends at src_len takes
        # a SIGSEGV. `_ds_scan_to_lf` below looks like the same
        # pattern but is safe — it increments last, so the loop
        # condition catches `p == src_len` before the next read.
        if (_ds_is_tag_byte(load8(src + p)) == 0) { done = 1; }
        if (done == 0) { p = p + 1; }
    }
    return p;
}

# Walk forward from `start` until LF or end-of-buffer. Returns
# the LF offset, or `src_len` if no LF before EOF.
#
# Watermarked per scanner call (2.5.2 audit P2-5): once a scan from
# `start` reaches EOF with no LF, any later `start` must too. Without
# it, a final line full of fence openers re-scanned to EOF per opener.
fn _ds_scan_to_lf(src, src_len, start) {
    if ((_ds_nolf_gen == _ds_cur_gen) && (start >= _ds_nolf_from)) {
        return src_len;
    }
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        if (load8(src + p) == 10) { done = 1; }
        if (load8(src + p) != 10) { p = p + 1; }
    }
    if (p >= src_len) {
        _ds_nolf_gen = _ds_cur_gen;
        _ds_nolf_from = start;
    }
    return p;
}

# Find the closing fence — earliest offset in [body_start, src_len)
# where the end marker starts a line (body_start counts: it follows the
# open line's LF), or follows a run of the rule's `end_indent` bytes
# from the line start. Returns the offset, or (0 - 1) if no match.
#
# markdown's `end_indent` is space, tab and `>` (2.9.1): a fence in a
# list item (`   ```sh` … `   ````) or a blockquote (`> ```c` … `> ````)
# closes at its own closer. Through 2.9.0 the closer had to be in column
# 0, so such a fence ran on to the next column-0 fence and took its
# opener as the close, pairing every later fence in the document one
# off. The candidates depend only on position — a line start plus such
# a run — never on the opener, so the no-closer watermark's subset
# argument still holds.
fn _ds_find_fenced_close(src, src_len, body_start, endp, elen, ind) {
    var j = body_start;
    var at_start = 1;
    while (j + elen <= src_len) {
        if (at_start == 1) {
            if (memeq(src + j, endp, elen) == 1) { return j; }
        }
        var b = load8(src + j);
        if (b == 10) { at_start = 1; }
        if (b != 10) {
            if (ind == 0) { at_start = 0; }
            if (ind != 0) {
                if (_ds_byte_in(ind, b) == 0) { at_start = 0; }
            }
        }
        j = j + 1;
    }
    return 0 - 1;
}

# Try each [[rules]] match="compose_fenced" at the cursor. Same
# shape as compose, but the inner grammar is captured per-fence
# from the bytes between `start` and the next newline (the
# "info string" in CommonMark terms; we take the first
# tag-character run as the language tag).
#
# Layout of a fence we recognize:
#
#     <start><tag><info-tail>\n<body>\n<end>
#
#   <start>      literal, e.g. "```"
#   <tag>        [A-Za-z0-9_+-]+ (captured language identifier)
#   <info-tail>  ignored bytes up to first \n
#   <body>       routed through grammar named by <tag>
#                (`registry_find_fence_tag`: a name, an extension,
#                or an interpreter — 2.9.1)
#   <end>        literal, e.g. "```"; matches at start-of-line,
#                or after the rule's `end_indent` bytes (2.9.1)
#
# Pipeline placement: same step 0 region as compose, executed
# before the regular pair / line / words steps so the outer
# grammar's tokenizer doesn't eat the fence markers byte-by-byte.
# See ADR 0016.
fn _ds_try_compose_fenced_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_fenced_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    var result = 0;
    while ((r_i < n) && (result == 0)) {
        var r = vec_get(rules, r_i);
        var start = compose_fenced_rule_start(r);
        var slen = strlen(start);
        var match_here = 0;
        if (i + slen <= src_len) {
            if (memeq(src + i, start, slen) == 1) { match_here = 1; }
        }
        if (match_here == 1) {
            var tag_start = i + slen;
            var tag_end = _ds_scan_tag(src, src_len, tag_start);
            var nl_pos  = _ds_scan_to_lf(src, src_len, tag_end);
            if (nl_pos >= src_len) { _ds_cp_hold(i, 2, 0, 0); }

            if (nl_pos < src_len) {
                # Real fence: has a closing LF on the open line.
                var body_start = nl_pos + 1;
                var endp = compose_fenced_rule_end(r);
                var elen = strlen(endp);
                # Same no-closer watermark as `compose` (2.5.2 audit
                # P2-5): every body starts just after an LF, so a later
                # body's line-start candidates are a subset of an
                # earlier failed body's. `x```a` lines x 175k (1 MiB
                # markdown) took 282 s through 2.5.1.
                var close_pos = (0 - 1);
                var fen_known_none = 0;
                if ((load64(r + 16) == _ds_cur_gen) && (body_start >= load64(r + 24))) {
                    fen_known_none = 1;
                }
                if (fen_known_none == 0) {
                    close_pos = _ds_find_fenced_close(src, src_len,
                      body_start, endp, elen,
                      compose_fenced_rule_end_indent(r));
                    if (close_pos < 0) {
                        store64(r + 16, _ds_cur_gen);
                        store64(r + 24, body_start);
                    }
                }
                if (close_pos < 0) {
                    var flead = compose_fenced_rule_end_indent(r);
                    if (flead == 0) { flead = 1; }
                    _ds_cp_hold(i, 3, endp, flead);
                }
                if (close_pos >= 0) {
                    # Resolve inner grammar from captured tag.
                    var tag_len = tag_end - tag_start;
                    var inner_g = 0;
                    if (tag_len > 0) {
                        var tag_buf = alloc(tag_len + 1);
                        var tk = 0;
                        if (tag_buf == 0) { tk = tag_len; }   # OOM: no lookup (2.5.2)
                        while (tk < tag_len) {
                            store8(tag_buf + tk,
                              load8(src + tag_start + tk));
                            tk = tk + 1;
                        }
                        if (tag_buf != 0) {
                            store8(tag_buf + tag_len, 0);
                            inner_g = registry_find_fence_tag(tag_buf);
                        }
                    }

                    # Emit: open-marker (incl. info + LF), body,
                    # close-marker.
                    var open_len = body_start - i;
                    tokenbuf_push(tb, TK_PUNCTUATION, i, open_len);

                    var body_len = close_pos - body_start;
                    if (body_len > 0) {
                        var finner_tb = 0;
                        if (inner_g != 0) { finner_tb = _ds_inner_tb(); }
                        if (finner_tb == 0) { inner_g = 0; }   # OOM degrade
                        if (inner_g != 0) {
                            var inner_tb = finner_tb;
                            tokenize_with_grammar(inner_g,
                              src + body_start,
                              body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                tokenbuf_push(tb,
                                  tokenbuf_kind(inner_tb, k),
                                  tokenbuf_start(inner_tb, k) + body_start,
                                  tokenbuf_len(inner_tb, k));
                                k = k + 1;
                            }
                        }
                        if (inner_g == 0) {
                            # No tag, or tag didn't resolve.
                            tokenbuf_push(tb, TK_STRING,
                              body_start, body_len);
                        }
                    }

                    tokenbuf_push(tb, TK_PUNCTUATION, close_pos, elen);
                    _ds_grp_add(i, close_pos + elen);
                    result = open_len + body_len + elen;
                }
            }
        }
        if (result == 0) { r_i = r_i + 1; }
    }
    return result;
}

# 1 if `src[i..i+n)` is one of the cstrs in `v`.
fn _ds_in_word_list(v, src, i, n) {
    var k = 0;
    while (k < vec_len(v)) {
        var w = vec_get(v, k);
        if (strlen(w) == n) {
            if (memeq(src + i, w, n) == 1) { return 1; }
        }
        k = k + 1;
    }
    return 0;
}

# A string prefix (ADR 0027): when the identifier src[i..i+ilen) is one
# of the grammar's `string_prefixes` / `raw_string_prefixes` and a
# string — or, for a plain prefix, a char literal — starts right after
# it, the length of prefix + literal as ONE string token; else 0.
# `f"{x}"`, `rb'\d'`, Rust `b'\n'` / `r"C:\"`, C `L"wide"`. Through 2.7.0
# the prefix was an identifier before the string.
fn _ds_prefixed_string(g, src, src_len, i, ilen) {
    if (i + ilen >= src_len) { return 0; }
    var q = load8(src + i + ilen);
    if ((q != 34) && (q != 39) && (q != 96)) { return 0; }      # " ' `
    var raw = _ds_in_word_list(grammar_raw_string_prefixes(g), src, i, ilen);
    var plain = 0;
    if (raw == 0) { plain = _ds_in_word_list(grammar_string_prefixes(g), src, i, ilen); }
    if ((raw == 0) && (plain == 0)) { return 0; }
    var packed = _ds_try_pair_rules_x(g, src, src_len, i + ilen, raw);
    if (packed != 0) {
        if ((packed >> 56) == TK_STRING) { return ilen + (packed & 0x00FFFFFFFFFFFFFF); }
    }
    if ((plain == 1) && (grammar_char_literal(g) == 1)) {
        var cl = _ds_try_char_literal(g, src, src_len, i + ilen);
        if (cl > 0) { return ilen + cl; }
    }
    return 0;
}

# `ident_lead` check (ADR 0027): the byte after a lead byte must be able
# to both start and continue an identifier — `--x`, `-webkit`, not `-2`
# or `-$x` — or be a non-ASCII byte under `unicode_ident`.
fn _ds_ident_lead_ok(g, src, src_len, i) {
    if (i + 1 >= src_len) { return 0; }
    var nb = load8(src + i + 1);
    if ((nb >= 128) && (grammar_unicode_ident(g) == 1)) { return 1; }
    var st = grammar_ident_start(g);
    var ct = grammar_ident_cont(g);
    if ((st == 0) || (ct == 0)) { return 0; }
    if ((char_class_match(st, nb) == 1) && (char_class_match(ct, nb) == 1)) { return 1; }
    return 0;
}

# Try each [[rules]] match="pair". Returns packed (kind << 56) | len.
fn _ds_try_pair_rules(g, src, src_len, i) {
    return _ds_try_pair_rules_x(g, src, src_len, i, 0);
}

# The end marker of the last pair this scan ran to the end of the
# buffer, stamped with the scan's generation (2.8.0).
var _ds_pair_eof_gen = 0;
var _ds_pair_eof_end = 0;
var _ds_pair_eof_esc = 0;   # that string's escape byte, 0 = none (2.9.1)

# As `_ds_try_pair_rules`; `noesc` = 1 ignores the rule's escape byte
# (a raw-string prefix, ADR 0027: Rust's `r"C:\"` ends at its quote).
fn _ds_try_pair_rules_x(g, src, src_len, i, noesc) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = pair_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = pair_rule_end(r);
            var elen = strlen(endp);
            var esc = pair_rule_escape(r);
            if (noesc == 1) { esc = 0; }
            var j = i + slen;
            while (j < src_len) {
                var b = load8(src + j);
                if ((esc != 0) && (b == esc)) {
                    j = j + 2;
                    continue;
                }
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    var len = j - i + elen;
                    return (pair_rule_kind(r) << 56) | len;
                }
                j = j + 1;
            }
            # Unterminated — consume to EOF. Noted for the end-of-scan
            # heredoc hold (2.8.0): that string's close is what it waits for.
            var len_eof = src_len - i;
            _ds_pair_eof_gen = _ds_cur_gen;
            _ds_pair_eof_end = endp;
            _ds_pair_eof_esc = esc;
            return (pair_rule_kind(r) << 56) | len_eof;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Longest char literal `_ds_try_char_literal` accepts, quotes
# included: `'\u{10FFFF}'` / `'\U0001F600'` are 12 bytes. The
# streaming drain's marker window (`_stream_max_marker`) holds back
# at least this many bytes for a char_literal grammar, so a literal
# split by a feed boundary is never committed half-seen.
var DS_CHAR_LITERAL_MAX = 12;

# Char literal at the cursor when `[defaults] char_literal = true`.
# Recognises:
#   'C'       → 3 bytes  (any non-`\`, non-`'` byte)
#   '\…'      → 4..12 bytes: `\` plus the escaped byte, then up to
#               the closing quote within DS_CHAR_LITERAL_MAX — so
#               `'\n'`, `'\''`, `'\\'`, `'\xHH'`, `'\033'` (octal),
#               `'\uXXXX'`, `'\UXXXXXXXX'` and `'\u{H…H}'`. Escape
#               digits are not validated; the closing quote is trusted.
#               A newline or a second `\` before the quote means no
#               literal. (Through 2.5.1 only `'\C'` and `'\xHH'` were
#               accepted: C's ubiquitous `'\033'` split into
#               operators + a number, and Rust's `'\u{2026}'` emitted
#               TK_ERROR. 2.5.2 audit P3-c; recorded as ADR 0024.)
#   '<UTF-8>' → 4/5/6 bytes for 2/3/4-byte UTF-8 leading byte ranges
#
# Returns the matched length, or 0 if no shape fits. A 0 return lets
# the leading `'` fall through to the operator step — that's how
# Rust lifetimes (`'a`, `'static`, `'_`) keep working: no closing
# quote at the right offset means "not a char literal."
#
# See ADR 0010.
fn _ds_try_char_literal(g, src, src_len, i) {
    if (grammar_char_literal(g) == 0) { return 0; }
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != 39) { return 0; }   # opening `'`

    var b1 = load8(src + i + 1);
    if (b1 == 39) { return 0; }                # `''` — never valid
    if (b1 == 92) {                            # `\` escape forms
        # src[i+2] is the escaped byte — always part of the escape, so
        # `'\''` and `'\\'` close at i+3. Search on from there.
        var j = i + 3;
        var lim = i + DS_CHAR_LITERAL_MAX;
        var found = 0;
        while ((j < src_len) && (j < lim) && (found == 0)) {
            var c = load8(src + j);
            if (c == 39) { found = j - i + 1; }
            if ((c == 10) || (c == 13) || (c == 92)) { j = lim; }
            if (found == 0) { j = j + 1; }
        }
        return found;
    }

    # `'C'` — 3-byte ASCII body
    if (load8(src + i + 2) == 39) { return 3; }

    # UTF-8 multi-byte body. Leading-byte ranges per RFC 3629:
    #   0xC2..0xDF → 2-byte sequence (4 bytes total incl. quotes)
    #   0xE0..0xEF → 3-byte sequence (5 bytes total)
    #   0xF0..0xF4 → 4-byte sequence (6 bytes total)
    if (b1 >= 194) {
        if (b1 < 224) {
            if (i + 3 < src_len) {
                if (load8(src + i + 3) == 39) { return 4; }
            }
            return 0;
        }
        if (b1 < 240) {
            if (i + 4 < src_len) {
                if (load8(src + i + 4) == 39) { return 5; }
            }
            return 0;
        }
        if (b1 < 245) {
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
    }
    return 0;
}

# Exact-match longest-first list (operators or punctuation). Returns
# the matched length, or 0 if nothing matched.
# The first-byte test runs before `strlen` / `memeq`: nearly every entry
# fails on its first byte, and each call cost more than the comparison
# (2.6.0 — shell's eight new escape / `#` entries made the per-token
# scan measurably slower before this). Equivalent to the plain loop
# because empty entries are rejected at load (2.5.2), and the main loop
# only calls this with `i < src_len`.
fn _ds_try_exact_list(list_vec, src, src_len, i) {
    var n = vec_len(list_vec);
    var b0 = load8(src + i);
    var li = 0;
    while (li < n) {
        var s = vec_get(list_vec, li);
        if (load8(s) == b0) {
            var slen = strlen(s);
            if ((i + slen <= src_len) && (memeq(src + i, s, slen) == 1)) {
                return slen;
            }
        }
        li = li + 1;
    }
    return 0;
}

# Identifier run. Caller has already confirmed the first byte is in
# ident_start (or is a UTF-8 byte ≥0x80 with unicode_ident=true).
# Returns len.
#
# When `unicode_ident = true`, any byte ≥0x80 is also accepted as
# ident-cont so multi-byte UTF-8 sequences (em-dashes, smart
# quotes, accented letters) coalesce into a single TK_IDENT instead
# of fragmenting into per-byte TK_ERROR tokens. See
# [ADR 0009](../../docs/adr/0009-unicode-ident-default.md).
fn _ds_scan_ident(g, src, src_len, i) {
    var cont_tbl = grammar_ident_cont(g);
    var unicode_on = grammar_unicode_ident(g);
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        var ok = char_class_match(cont_tbl, b);
        if ((ok == 0) && (unicode_on == 1) && (b >= 128)) { ok = 1; }
        if (ok == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Case-fold A-Z (0x41–0x5A) to a-z (0x61–0x7A). Other bytes
# pass through unchanged. Used by `_ds_lookup_keyword` when
# `[defaults] case_insensitive_keywords = true`. See ADR 0011.
fn _ds_to_lower(b) {
    if (b >= 65) {
        if (b <= 90) {
            return b + 32;
        }
    }
    return b;
}

# Compare an ident span against a keyword string with optional
# case folding. Returns 1 on match, 0 otherwise. Same byte-by-
# byte cost as `memeq` plus one branch per byte; no allocation.
fn _ds_word_match(src, start, w, wlen, fold) {
    if (fold == 0) {
        return memeq(src + start, w, wlen);
    }
    var i = 0;
    while (i < wlen) {
        var a = _ds_to_lower(load8(src + start + i));
        var b = _ds_to_lower(load8(w + i));
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# If the byte span [start, start+len) matches a word in any words
# rule, returns that rule's kind (an i64). Returns -1 when no match.
# No out-param, no per-call allocation — this runs once per ident
# in the hot path and ADR 0002 forbids per-token allocation.
#
# When `[defaults] case_insensitive_keywords = true`, the match
# folds A-Z to a-z on both sides. ADR 0011 — needed by SQL
# (and PostgreSQL/Oracle/T-SQL dialects) where `SELECT` /
# `select` / `Select` are the same reserved word.
fn _ds_lookup_keyword(g, src, start, len) {
    var rules = grammar_words_rules(g);
    var n = vec_len(rules);
    var fold = grammar_case_insensitive_kw(g);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var words = words_rule_words(r);
        var wn = vec_len(words);
        var w_i = 0;
        while (w_i < wn) {
            var w = vec_get(words, w_i);
            var wlen = strlen(w);
            if (wlen == len) {
                if (_ds_word_match(src, start, w, wlen, fold) == 1) {
                    return words_rule_kind(r);
                }
            }
            w_i = w_i + 1;
        }
        r_i = r_i + 1;
    }
    return 0 - 1;
}

# Number with optional 0x/0b/0o prefix. Returns length; 0 if not a
# number. Caller has already checked is_digit on src[i].
fn _ds_scan_number(g, src, src_len, i) {
    var sep = grammar_number_sep(g);
    if (load8(src + i) == 48) {                # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((grammar_number_0x(g) == 1) && ((p == 120) || (p == 88))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 16) - i;
            }
            if ((grammar_number_0b(g) == 1) && ((p == 98) || (p == 66))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 2) - i;
            }
            if ((grammar_number_0o(g) == 1) && ((p == 111) || (p == 79))) {
                return _ds_digit_run(src, src_len, i + 2, sep, 8) - i;
            }
        }
    }
    if (grammar_number_decimal(g) == 0) { return 0; }
    if (grammar_number_datetime(g) == 1) {
        var dt = _ds_scan_datetime(src, src_len, i);
        if (dt > 0) { return dt; }
    }
    var j = _ds_digit_run(src, src_len, i + 1, sep, 10);
    if (grammar_number_float(g) == 1) {
        # Fraction: `.` then a digit. A digit is required — `1..2` (a
        # range), `1.max()` and `t.0.x` stay split — so a trailing-dot
        # `1.` and a leading-dot `.5` are not floats (ADR 0026).
        if (j + 1 < src_len) {
            if ((load8(src + j) == 46) && (_ds_is_digit(load8(src + j + 1)) == 1)) {
                j = _ds_digit_run(src, src_len, j + 2, sep, 10);
            }
        }
        # Exponent: `e` / `E`, an optional sign, then a digit.
        if (j < src_len) {
            var eb = load8(src + j);
            if ((eb == 101) || (eb == 69)) {
                var k = j + 1;
                if (k < src_len) {
                    if ((load8(src + k) == 43) || (load8(src + k) == 45)) { k = k + 1; }
                }
                if (k < src_len) {
                    if (_ds_is_digit(load8(src + k)) == 1) {
                        j = _ds_digit_run(src, src_len, k + 1, sep, 10);
                    }
                }
            }
        }
    }
    return j - i;
}

# Offset just past the run of base-`base` digits starting at `j`. With a
# digit separator `sep` (`[defaults] number_separator`, ADR 0026), a
# `sep` byte joins the run only when a digit follows it: `1_000` is one
# number, `1_u32` is `1` + `_u32`, `1__0` is `1` + `__0`.
fn _ds_digit_run(src, src_len, j, sep, base) {
    while (j < src_len) {
        var b = load8(src + j);
        var ok = 0;
        if (base == 10) { ok = _ds_is_digit(b); }
        if (base == 16) { ok = _ds_is_hex_digit(b); }
        if (base == 2) { ok = _ds_is_bin_digit(b); }
        if (base == 8) { ok = _ds_is_oct_digit(b); }
        if ((ok == 0) && (sep > 0) && (b == sep) && (j + 1 < src_len)) {
            var nb = load8(src + j + 1);
            if (base == 10) { ok = _ds_is_digit(nb); }
            if (base == 16) { ok = _ds_is_hex_digit(nb); }
            if (base == 2) { ok = _ds_is_bin_digit(nb); }
            if (base == 8) { ok = _ds_is_oct_digit(nb); }
        }
        if (ok == 0) { return j; }
        j = j + 1;
    }
    return src_len;
}

# 1 if src[p..p+n) is n ASCII digits (all inside the buffer).
fn _ds_digits_at(src, src_len, p, n) {
    if (p + n > src_len) { return 0; }
    var k = 0;
    while (k < n) {
        if (_ds_is_digit(load8(src + p + k)) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# Length of the `HH:MM` time at `p`, extended by `:SS`, `.fraction` and
# an offset (`Z` / `z` / `+HH:MM` / `-HH:MM`) when present; 0 if there
# is no `HH:MM` there. TOML 1.1 and YAML make the seconds optional.
fn _ds_scan_time(src, src_len, p) {
    if (_ds_digits_at(src, src_len, p, 2) == 0) { return 0; }
    if (p + 5 > src_len) { return 0; }
    if (load8(src + p + 2) != 58) { return 0; }   # :
    if (_ds_digits_at(src, src_len, p + 3, 2) == 0) { return 0; }
    var q = p + 5;
    if ((q + 3 <= src_len) && (load8(src + q) == 58) && (_ds_digits_at(src, src_len, q + 1, 2) == 1)) {
        q = q + 3;
        if ((q + 1 < src_len) && (load8(src + q) == 46) && (_ds_is_digit(load8(src + q + 1)) == 1)) {
            q = _ds_digit_run(src, src_len, q + 2, 0, 10);
        }
    }
    if (q < src_len) {
        var z = load8(src + q);
        if ((z == 90) || (z == 122)) { return q + 1 - p; }   # Z z
        if ((z == 43) || (z == 45)) {                        # + -
            if ((_ds_digits_at(src, src_len, q + 1, 2) == 1) && (q + 6 <= src_len)) {
                if ((load8(src + q + 3) == 58) && (_ds_digits_at(src, src_len, q + 4, 2) == 1)) {
                    return q + 6 - p;
                }
            }
        }
    }
    return q - p;
}

# RFC 3339 / TOML date-times as one token (`[defaults] number_datetime`,
# ADR 0026): `1979-05-27`, `1979-05-27T07:32:00Z`, `1979-05-27 07:32:00`
# (TOML allows the space), `07:32:00.999` (a local time needs its
# seconds, so `1:20` and `10:30` in prose are not times). 0 if src[i]
# starts none of them; the caller then scans a plain number.
fn _ds_scan_datetime(src, src_len, i) {
    if ((_ds_digits_at(src, src_len, i, 4) == 1) && (i + 10 <= src_len)) {
        if ((load8(src + i + 4) == 45) && (load8(src + i + 7) == 45)) {
            if ((_ds_digits_at(src, src_len, i + 5, 2) == 1) && (_ds_digits_at(src, src_len, i + 8, 2) == 1)) {
                var p = i + 10;
                if (p < src_len) {
                    var tb = load8(src + p);
                    if ((tb == 84) || (tb == 116) || (tb == 32)) {   # T t space
                        var tl = _ds_scan_time(src, src_len, p + 1);
                        if (tl > 0) { return p + 1 + tl - i; }
                    }
                }
                return p - i;
            }
        }
    }
    if ((_ds_digits_at(src, src_len, i, 2) == 1) && (i + 8 <= src_len)) {
        if ((load8(src + i + 2) == 58) && (load8(src + i + 5) == 58)) {
            if ((_ds_digits_at(src, src_len, i + 3, 2) == 1) && (_ds_digits_at(src, src_len, i + 6, 2) == 1)) {
                return _ds_scan_time(src, src_len, i);
            }
        }
    }
    return 0;
}

# Whitespace run.
fn _ds_scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (_ds_is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# ── Here-documents (ADR 0023, 2.6.0) ───────────────────────────────
# A heredoc body is non-local: `cat <<EOF` opens it, the body starts on
# the NEXT line, and a line holding exactly the delimiter ends it. The
# scanner queues each opener whose terminator line exists (up to
# DS_HEREDOC_QUEUE per line), tokenizes the rest of the opener line as
# usual — the `<<` itself stays an operator, the delimiter its own
# token — and at the next top-level line break emits each queued body
# plus its terminator as one `kind` token.
var DS_HEREDOC_QUEUE = 4;
var _ds_hd_pool = 0;

# Lowest `<<` offset in the outer scan whose heredoc was not resolved —
# delimiter valid, but no terminator line yet, or one with no LF after
# it yet. Read (and reset) by the streaming drain, which then commits
# nothing from there on until more input arrives (or finish). -1: none.
var _ds_hd_hold_from = (0 - 1);
# When the hold at `_ds_hd_hold_from` is a plain "terminator line not
# arrived yet" (opener line complete, delimiter known), its details, so
# the drain can watch only NEW lines for the terminator instead of
# re-tokenizing the whole held buffer every feed. 0 = no fast path (the
# hold is an undecided opener, or a terminator missing only its LF).
var _ds_hd_hold_fast = 0;
var _ds_hd_hold_dpos = 0;
var _ds_hd_hold_dlen = 0;
var _ds_hd_hold_ind = 0;
var _ds_hd_hold_body = 0;
# With _ds_hd_hold_dpos = -1: the delimiter's bytes, which quote removal
# rewrote into the scratch slot (valid until this depth's next scan; the
# drain copies them at once). 2.9.1.
var _ds_hd_hold_dptr = 0;
var _ds_hd_hold_marker = 0;   # with _ds_hd_hold_fast = 3: the close to wait for (2.8.0)
var _ds_hd_hold_esc = 0;      #   and its escape byte: an escaped close is no close (2.9.1)

# Through 2.7.1 the scanner reported only the last depth-1 heredoc GROUP
# fully emitted — the opener line's first `<<` through the end of its
# last body token. Every token in it is final (the opener line ended,
# each terminator line has its LF), so the drain commits the group whole
# instead of letting its tail-of-buffer checks split it: a 1-byte body
# (`cat <<E\nE`) sat inside shell's 3-byte marker window and was held
# while its opener line committed — the next drain read the body as code
# (2.6.x audit P2-2).
# Groups (2.8.0): every depth-1 run of tokens that is final as a unit —
# a heredoc opener line through its last body, a compose region from
# its start marker through its end (or up to its `end_before`). The
# drain commits a group whole: none of its tail-of-buffer checks may
# split one, because the next scan would start inside it and read the
# rest with the wrong grammar. Collected only for a drain's scan
# (`_ds_grp_collect`, one-shot like `_ds_buf_prev`), as (from, to)
# pairs in input order.
var _ds_grp_collect = 0;
var _ds_grp_active = 0;
var _ds_grp_buf = 0;
var _ds_grp_cap = 0;
var _ds_grp_n = 0;

fn _ds_grp_add(from, to) {
    if ((_ds_grp_active == 0) || (_ds_depth != 1)) { return 0; }
    if (_ds_grp_n >= _ds_grp_cap) {
        var nc = _ds_grp_cap * 2;
        if (nc < 64) { nc = 64; }
        var nb = alloc(nc * 16);
        if (nb == 0) { return 0; }
        var k = 0;
        while (k < _ds_grp_n * 16) { store8(nb + k, load8(_ds_grp_buf + k)); k = k + 1; }
        _ds_grp_buf = nb;
        _ds_grp_cap = nc;
    }
    store64(_ds_grp_buf + _ds_grp_n * 16, from);
    store64(_ds_grp_buf + _ds_grp_n * 16 + 8, to);
    _ds_grp_n = _ds_grp_n + 1;
    return 0;
}

# Compose hold (2.8.0): the lowest depth-1 compose opener this scan could
# not resolve — a `compose` or `compose_fenced` start with no close in
# the buffer (the scanner then tokenizes it as outer text, but more
# input may close it), or a `compose_region` running into the buffer's
# end. The drain commits nothing from there until it resolves, with a
# watch on `_ds_cp_hold_marker`: mode 2 waits for a line break, 3 for
# the marker (a cstr) anywhere in the new bytes, 4 for finish. Through
# 2.7.1 the drain guessed at this from outside (`prefix_hold`), and the
# compose grammars were not chunk-invariant: cyml failed at 90 % of
# split offsets.
var _ds_cp_hold_from = (0 - 1);
var _ds_cp_hold_mode = 0;
var _ds_cp_hold_marker = 0;
# Where a mode-3 marker counts (2.9.1): 0 anywhere (`</style>`, a cyml
# region's `\n[[`); 1 only at a line start; else a cstr of the bytes
# that may come between the line start and it (a fence's `end_indent`).
# Through 2.9.0 a fence's watch fired on every mid-line "```" and
# re-scanned the whole held fence each time: 1 MB of `s = "```" + x`
# lines in 4 KB chunks took 36 s (2.9.1 audit, reviewer B, F3).
var _ds_cp_hold_lead = 0;

fn _ds_cp_hold(i, mode, marker, lead) {
    if (_ds_depth != 1) { return 0; }
    if ((_ds_cp_hold_from < 0) || (i < _ds_cp_hold_from)) {
        _ds_cp_hold_from = i;
        _ds_cp_hold_mode = mode;
        _ds_cp_hold_marker = marker;
        _ds_cp_hold_lead = lead;
    }
    return 0;
}

# Terminator lookup (2.8.0). Through 2.7.1 each search walked the lines
# after the opener, under a per-call budget of 4 bytes per input byte
# plus 64 KiB (N distinct unterminated openers would otherwise be
# O(N^2)), with a one-entry cache of the last failed delimiter. The
# budget scaled with the BUFFER, so a stream that had compacted earlier
# bytes away gave up sooner than a single feed and a later heredoc came
# back as code (2.6.x audit). Now the first search in a scan indexes
# every line of the buffer once — content (exact, and after leading
# tabs for `<<-`, one trailing CR dropped) hashed into buckets of line
# numbers in input order — and a search is a walk of one bucket from a
# forward-only cursor: searches within a scan never move backwards
# (each opener searches from its line's end, each body from where the
# previous one ended). Linear, no budget, the same verdict however the
# input is chunked.
var _ds_hdi_pool = 0;

# Decoded-delimiter scratch for the current depth: one 256-byte slot
# per queue entry plus one for an opener the full queue cannot take.
# Only a delimiter that quote removal rewrote (`"E"OF`, `E\OF`) lives
# here; a plain or singly-quoted one points into `src`.
var DS_HD_DELIM_MAX = 255;
var _ds_hd_dpool = 0;

# 1 if queue entry `e`'s delimiter lies inside src[0..src_len) — the
# drain's terminator watch takes it as an offset into its buffer. A
# delimiter that quote removal rewrote (`<<"E"OF`, `<<E\OF`) lives in
# the per-depth scratch slot instead, a separate allocation; the opener
# path already gated its fast path on that (`dcontig`), the body step
# did not, and handed the drain a heap address minus `src` as an offset:
# the watch then compared new lines against bytes outside its buffer —
# never firing, or faulting (2.9.1 audit, reviewers A and B). Such a
# delimiter is now reported as offset -1 plus its address
# (`_ds_hd_hold_dptr`), and the drain watches a copy of it.
fn _ds_hd_in_src(e, src, src_len) {
    var d = load64(e);
    if (d < src) { return 0; }
    if (d + load64(e + 8) > src + src_len) { return 0; }
    return 1;
}

fn _ds_hd_dscratch() {
    if (_ds_hd_dpool == 0) {
        _ds_hd_dpool = vec_new();
        if (_ds_hd_dpool == 0) { return 0; }
    }
    while (vec_len(_ds_hd_dpool) <= _ds_depth) {
        var d = alloc((DS_HEREDOC_QUEUE + 1) * 256);
        if (d == 0) { return 0; }
        vec_push(_ds_hd_dpool, d);
    }
    return vec_get(_ds_hd_dpool, _ds_depth);
}

# `_ds_hd_parse_delim` results.
var _ds_hdd_ptr = 0;      # delimiter bytes (into src, or a scratch slot)
var _ds_hdd_len = 0;
var _ds_hdd_end = 0;      # src offset just past the word
var _ds_hdd_pos = (0 - 1);  # src offset of the bytes when contiguous, else -1

# The heredoc delimiter at src[p] as bash reads it: a word of bare
# bytes, `'…'` and `"…"` segments and `\X` escapes, ended by a blank,
# a newline or one of `;&|()<>`, the quotes removed — `EOF`, `'EOF'`,
# `\EOF`, `"E"OF` and `E\OF` all mean `EOF`; `''` is the empty
# delimiter (its terminator is an empty line); `!` and `END-OF-DATA`
# are words. Through 2.7.0 a delimiter was one quoted run or a bare
# `[A-Za-z_][A-Za-z0-9_.-]*`, so the mixed forms read as `E` and `<<!`
# / `<<''` were no heredoc at all. A bare word may not start with a
# digit (`1 << 2` outside `((`…`))` stays a shift). Returns 0 with the
# word in `_ds_hdd_*`, 1 if the buffer ends inside it (undecided), 2
# if there is no delimiter here.
fn _ds_hd_parse_delim(src, src_len, p, slot) {
    var start = p;
    var n = 0;
    var segs = 0;
    var first = (0 - 1);      # src offset of the first delimiter byte
    var contig = 1;           # every byte so far at src[first + its index]
    var quoted = 0;
    var go = 1;
    var rc = 0;
    while ((go == 1) && (p < src_len)) {
        var b = load8(src + p);
        var bare = 1;
        if ((b == 32) || (b == 9) || (b == 10) || (b == 13)) { go = 0; bare = 0; }
        if ((b == 59) || (b == 38) || (b == 124) || (b == 40) || (b == 41) || (b == 60) || (b == 62) || (b == 96)) {
            go = 0;
            bare = 0;
        }
        if ((go == 1) && ((b == 39) || (b == 34))) {
            bare = 0;
            quoted = 1;
            segs = segs + 1;
            var q = p + 1;
            var closed = 0;
            while ((q < src_len) && (closed == 0)) {
                var c = load8(src + q);
                if (c == 10) { closed = 2; }
                if ((closed == 0) && (c == b)) { closed = 1; }
                if ((closed == 0) && (b == 34) && (c == 92) && (q + 1 < src_len)) {
                    var e = load8(src + q + 1);
                    if ((e == 34) || (e == 92) || (e == 36) || (e == 96)) {
                        q = q + 1;
                        c = e;
                    }
                }
                if (closed == 0) {
                    if (first < 0) { first = q; }
                    if (first + n != q) { contig = 0; }
                    if (n < DS_HD_DELIM_MAX) { store8(slot + n, c); }
                    n = n + 1;
                    q = q + 1;
                }
            }
            if (closed == 0) { return 1; }            # quote still open
            if (closed == 2) { return 2; }            # a newline inside it
            p = q + 1;
        }
        if ((go == 1) && (b == 92)) {
            bare = 0;
            segs = segs + 1;
            if (p + 1 >= src_len) { return 1; }
            var x = load8(src + p + 1);
            if (x == 10) { go = 0; }
            if (x != 10) {
                if (first < 0) { first = p + 1; }
                if (first + n != p + 1) { contig = 0; }
                if (n < DS_HD_DELIM_MAX) { store8(slot + n, x); }
                n = n + 1;
                p = p + 2;
            }
        }
        if ((go == 1) && (bare == 1)) {
            if ((n == 0) && (quoted == 0) && (b >= 48) && (b <= 57)) { return 2; }
            if ((n == 0) || (load8(src + p - 1) == 39) || (load8(src + p - 1) == 34)) { segs = segs + 1; }
            if (first < 0) { first = p; }
            if (first + n != p) { contig = 0; }
            if (n < DS_HD_DELIM_MAX) { store8(slot + n, b); }
            n = n + 1;
            p = p + 1;
        }
    }
    if ((n == 0) && (quoted == 0)) { return 2; }
    # Only a delimiter quote removal rewrote needs the slot, so only it is
    # capped. Through 2.9.0 every delimiter was (contiguity was judged by
    # comparing against the capped slot): a 300-byte `<<AAA…` stopped
    # being a heredoc in 2.7.1 (2.9.1 audit, reviewer A, F2).
    if ((n > DS_HD_DELIM_MAX) && (contig == 0)) { return 2; }
    _ds_hdd_len = n;
    _ds_hdd_end = p;
    _ds_hdd_ptr = slot;
    _ds_hdd_pos = (0 - 1);
    # The common forms keep pointing into `src` (the drain's terminator
    # watch needs an offset): the decoded bytes are one contiguous run.
    if ((first >= 0) && (contig == 1)) {
        _ds_hdd_ptr = src + first;
        _ds_hdd_pos = first;
    }
    if (n == 0) {
        _ds_hdd_ptr = src + start;
        _ds_hdd_pos = start;
    }
    if (p >= src_len) { rc = 1; }
    return rc;
}

# Queue buffer for the current nesting depth (entries of 40 bytes:
# delim ptr, delim len, indent flag, kind, opener offset), allocated
# once per depth.
fn _ds_hd_queue() {
    if (_ds_hd_pool == 0) {
        _ds_hd_pool = vec_new();
        if (_ds_hd_pool == 0) { return 0; }
    }
    while (vec_len(_ds_hd_pool) <= _ds_depth) {
        var q = alloc(DS_HEREDOC_QUEUE * 40);
        if (q == 0) { return 0; }
        vec_push(_ds_hd_pool, q);
    }
    return vec_get(_ds_hd_pool, _ds_depth);
}

# Offset just past the delimiter on the first line at or after `from`
# that is exactly `dptr[0..dlen)` — after leading tabs when `ind` is 1,
# ignoring one trailing CR — or -1 if no such line exists. Linear: for
# the drain's terminator watch, which only ever searches new lines.
fn _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind) {
    var ls = from;
    var found = (0 - 1);
    while ((ls < src_len) && (found == (0 - 1))) {
        var p = ls;
        if (ind == 1) {
            while ((p < src_len) && (load8(src + p) == 9)) { p = p + 1; }
        }
        var le = _ds_scan_to_lf(src, src_len, p);
        var ce = le;
        if ((ce > p) && (load8(src + ce - 1) == 13)) { ce = ce - 1; }
        if ((ce - p == dlen) && (memeq(src + p, dptr, dlen) == 1)) { found = p + dlen; }
        ls = le + 1;
    }
    return found;
}

# FNV-1a over src[p..p+n).
fn _ds_hdi_hash(src, p, n) {
    var h = 0xcbf29ce484222325;
    var k = 0;
    while (k < n) {
        h = (h ^ load8(src + p + k)) * 0x100000001b3;
        k = k + 1;
    }
    return h;
}

# The line index for the current depth (struct, 128 bytes):
#    0 gen          8 src         16 cap (lines)   24 n (lines)
#   32 B (buckets, a power of 2)   40 bcap        48 last_from
#   56 ls  u32[cap]  line start         64 le  u32[cap]  line end (LF or end)
#   72 tb  u32[cap]  after leading tabs 80 nx  u32[cap]  next line, exact bucket (+1; 0 = end)
#   88 tnx u32[cap]  next line, tab-stripped bucket
#   96 hb / 104 thb  u32[bcap] bucket heads   112 hc / 120 thc u32[bcap] cursors
fn _ds_hdi_get() {
    if (_ds_hdi_pool == 0) {
        _ds_hdi_pool = vec_new();
        if (_ds_hdi_pool == 0) { return 0; }
    }
    while (vec_len(_ds_hdi_pool) <= _ds_depth) {
        var x = alloc(128);
        if (x == 0) { return 0; }
        var z = 0;
        while (z < 128) { store8(x + z, 0); z = z + 1; }
        vec_push(_ds_hdi_pool, x);
    }
    return vec_get(_ds_hdi_pool, _ds_depth);
}

# Content [cs, ce) of line k for the exact (ind 0) or tab-stripped key.
fn _ds_hdi_ce(src, x, k, cs) {
    var le = load32(load64(x + 64) + k * 4);
    if ((le > cs) && (load8(src + le - 1) == 13)) { le = le - 1; }
    return le;
}

# Build the index over src[0..src_len) for this scan. 0 on allocation
# failure (the caller then falls back to the linear search).
fn _ds_hdi_build(x, src, src_len) {
    var n = 0;
    var p = 0;
    while (p < src_len) {
        n = n + 1;
        p = _ds_scan_to_lf(src, src_len, p) + 1;
    }
    if (n > load64(x + 16)) {
        var cap = load64(x + 16);
        if (cap < 64) { cap = 64; }
        while (cap < n) { cap = cap * 2; }
        var k = 56;
        while (k <= 88) {
            var a = alloc(cap * 4);
            if (a == 0) { return 0; }
            store64(x + k, a);
            k = k + 8;
        }
        store64(x + 16, cap);
    }
    # Buckets: the next power of two at or above the line count (load
    # factor <= 1). 2.8.0 doubled that: four u32 arrays of 2n made the
    # index 52 bytes a line, so a 1 MiB newline flood after one opener
    # held 60 MB, a 16 MiB one about 0.9 GB (2.9.1 audit). Now 36.
    var b = 16;
    while (b < n) { b = b * 2; }
    if (b > load64(x + 40)) {
        var hk = 96;
        while (hk <= 120) {
            var ha = alloc(b * 4);
            if (ha == 0) { return 0; }
            store64(x + hk, ha);
            hk = hk + 8;
        }
        store64(x + 40, b);
    }
    var hb = load64(x + 96);
    var thb = load64(x + 104);
    var hc = load64(x + 112);
    var thc = load64(x + 120);
    var zi = 0;
    while (zi < b) {
        store32(hb + zi * 4, 0); store32(thb + zi * 4, 0);
        store32(hc + zi * 4, 0); store32(thc + zi * 4, 0);
        zi = zi + 1;
    }
    var lsa = load64(x + 56);
    var lea = load64(x + 64);
    var tba = load64(x + 72);
    var nxa = load64(x + 80);
    var tnxa = load64(x + 88);
    var li = 0;
    p = 0;
    while (p < src_len) {
        var le = _ds_scan_to_lf(src, src_len, p);
        var t = p;
        while ((t < le) && (load8(src + t) == 9)) { t = t + 1; }
        store32(lsa + li * 4, p);
        store32(lea + li * 4, le);
        store32(tba + li * 4, t);
        li = li + 1;
        p = le + 1;
    }
    store64(x + 24, n);
    store64(x + 32, b);
    # Insert last line first, so each bucket chain runs in input order.
    var r = n - 1;
    while (r >= 0) {
        var rs = load32(lsa + r * 4);
        var re = _ds_hdi_ce(src, x, r, rs);
        var h1 = _ds_hdi_hash(src, rs, re - rs) & (b - 1);
        store32(nxa + r * 4, load32(hb + h1 * 4));
        store32(hb + h1 * 4, r + 1);
        var rt = load32(tba + r * 4);
        var rte = _ds_hdi_ce(src, x, r, rt);
        var h2 = _ds_hdi_hash(src, rt, rte - rt) & (b - 1);
        store32(tnxa + r * 4, load32(thb + h2 * 4));
        store32(thb + h2 * 4, r + 1);
        r = r - 1;
    }
    store64(x + 48, 0);
    return 1;
}

# Offset just past the delimiter on the first line at or after `from`
# whose content is exactly `dptr[0..dlen)` (after leading tabs when
# `ind` is 1, one trailing CR ignored), or -1. Uses the scan's line
# index (built on first use); see the note above `_ds_hdi_pool`.
fn _ds_hd_find_term(src, src_len, from, dptr, dlen, ind) {
    var x = _ds_hdi_get();
    if (x == 0) { return _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind); }
    if ((load64(x) != _ds_cur_gen) || (load64(x + 8) != src)) {
        if (_ds_hdi_build(x, src, src_len) == 0) {
            store64(x, 0);
            return _ds_hd_find_term_linear(src, src_len, from, dptr, dlen, ind);
        }
        store64(x, _ds_cur_gen);
        store64(x + 8, src);
    }
    var b = load64(x + 32);
    var h = _ds_hdi_hash(dptr, 0, dlen) & (b - 1);
    var heads = load64(x + 96);
    var curs = load64(x + 112);
    var nxt = load64(x + 80);
    if (ind == 1) {
        heads = load64(x + 104);
        curs = load64(x + 120);
        nxt = load64(x + 88);
    }
    var lsa = load64(x + 56);
    var k = load32(curs + h * 4);
    if ((k == 0) || (from < load64(x + 48))) { k = load32(heads + h * 4); }
    if (from > load64(x + 48)) { store64(x + 48, from); }
    while ((k != 0) && (load32(lsa + (k - 1) * 4) < from)) { k = load32(nxt + (k - 1) * 4); }
    if (from >= load64(x + 48)) { store32(curs + h * 4, k); }
    var found = (0 - 1);
    while ((k != 0) && (found < 0)) {
        var cs = load32(lsa + (k - 1) * 4);
        if (ind == 1) { cs = load32(load64(x + 72) + (k - 1) * 4); }
        var ce = _ds_hdi_ce(src, x, k - 1, cs);
        if ((ce - cs == dlen) && (memeq(src + cs, dptr, dlen) == 1)) { found = cs + dlen; }
        if (found < 0) { k = load32(nxt + (k - 1) * 4); }
    }
    return found;
}

# Arithmetic `((` … `))` state for the opener check — inside it `<<`
# is always a shift, never a heredoc. Through 2.6.1 `_ds_hd_in_arith`
# re-counted `((` against `))` from the line start at every `<<`: O(line)
# per opener (a 100 KB line of `x<<y` took 10 s), it counted parens
# inside quotes (`sed 's/((a)/' <<EOF` lost its heredoc), and once a
# streaming drain had committed the `((` it scanned only to the buffer
# start, so `$(( 1 << n ))` became a heredoc at some splits (2.6.x
# audit). `tokenize_with_grammar` now keeps the count as it pushes
# operator / punctuation tokens — greedy adjacent-pair matching as
# before, strings and comments skipped, reset at every line break —
# and passes the verdict in. At the end of a depth-1 scan it reports a
# hold from the outermost still-open `((` (see `_ds_hd_hold_from`), so
# a drain never commits into one: the next buffer always starts with
# the `((` in view, or at a point where none is open.

# One-entry cache for the line break after a delimiter: every opener on
# one line ends at the same LF, and re-scanning to it per opener was the
# other O(line)-per-opener cost.
var _ds_hd_lf_gen = 0;
var _ds_hd_lf_src = 0;
var _ds_hd_lf_from = 0;
var _ds_hd_lf_at = 0;

fn _ds_hd_lf_after(src, src_len, from) {
    if ((_ds_hd_lf_gen == _ds_cur_gen) && (_ds_hd_lf_src == src)) {
        if ((from >= _ds_hd_lf_from) && (from <= _ds_hd_lf_at)) { return _ds_hd_lf_at; }
    }
    var lf = _ds_scan_to_lf(src, src_len, from);
    _ds_hd_lf_gen = _ds_cur_gen;
    _ds_hd_lf_src = src;
    _ds_hd_lf_from = from;
    _ds_hd_lf_at = lf;
    return lf;
}

# At src[i]: if a heredoc rule's opener starts here (and is not the
# start of a longer run of its last byte — `<<<` is a here-string),
# parse the delimiter and, when its terminator line exists, queue it.
# Returns the new queue length. Consumes nothing: the `<<` is tokenized
# by the operator step exactly as before 2.6.0.
fn _ds_heredoc_open(g, src, src_len, i, hdq, hd_n, in_arith) {
    var rules = grammar_heredoc_rules(g);
    var n = vec_len(rules);
    var res = hd_n;
    var r_i = 0;
    var decided = 0;
    while ((r_i < n) && (decided == 0)) {
        var r = vec_get(rules, r_i);
        var st = heredoc_rule_start(r);
        var sl = strlen(st);
        var opens = 0;
        # `undecided`: the buffer ends before the opener can be judged —
        # `<<` at the very end, blanks up to the end, a quoted delimiter
        # whose closing quote has not arrived. A streaming drain must not
        # commit past it: the next feed may make it a heredoc, and once
        # the `<<` is committed the body would be re-scanned as code.
        var undecided = 0;
        var fast_ok = 0;
        var f_dpos = 0;
        var f_dptr = 0;
        var f_dlen = 0;
        var f_ind = 0;
        var f_body = 0;
        if ((i + sl <= src_len) && (memeq(src + i, st, sl) == 1)) {
            if (i + sl == src_len) { undecided = 1; }
            if (i + sl < src_len) {
                if (load8(src + i + sl) != load8(st + sl - 1)) { opens = 1; }
            }
        }
        if ((opens == 1) || (undecided == 1)) {
            if (in_arith == 1) {
                opens = 0;
                undecided = 0;
                decided = 1;
            }
        }
        if (opens == 1) {
            decided = 1;
            var p = i + sl;
            var ind = 0;
            var im = heredoc_rule_indent(r);
            if ((im != 0) && (load8(src + p) == load8(im))) { ind = 1; p = p + 1; }
            while ((p < src_len) && ((load8(src + p) == 32) || (load8(src + p) == 9))) { p = p + 1; }
            if (p >= src_len) { undecided = 1; }
            var ds = (0 - 1);
            var dl = 0;
            var dend = 0;
            var dptr = 0;
            var dcontig = 0;
            if (p < src_len) {
                var dslot = _ds_hd_dscratch();
                if (dslot != 0) {
                    var qslot = res;
                    if (qslot > DS_HEREDOC_QUEUE) { qslot = DS_HEREDOC_QUEUE; }
                    var dst = _ds_hd_parse_delim(src, src_len, p, dslot + qslot * 256);
                    if (dst == 1) { undecided = 1; }
                    if (dst != 2) {
                        dptr = _ds_hdd_ptr;
                        dl = _ds_hdd_len;
                        dend = _ds_hdd_end;
                        ds = 0;
                        if (_ds_hdd_pos >= 0) {
                            ds = _ds_hdd_pos;
                            dcontig = 1;
                        }
                    }
                }
            }
            if (ds >= 0) {
                var lf = _ds_hd_lf_after(src, src_len, dend);
                var term = (0 - 1);
                if (lf < src_len) {
                    term = _ds_hd_find_term(src, src_len, lf + 1, dptr, dl, ind);
                }
                # Resolved = terminator line present AND its line break
                # seen; only then can a streaming drain commit past `<<`.
                var complete = 0;
                if ((term >= 0) && (term < src_len)) {
                    var tb0 = load8(src + term);
                    if (tb0 == 10) { complete = 1; }
                    if ((tb0 == 13) && (term + 1 < src_len)) {
                        if (load8(src + term + 1) == 10) { complete = 1; }
                    }
                }
                if ((term >= 0) && (res < DS_HEREDOC_QUEUE) && (hdq != 0)) {
                    var e = hdq + res * 40;
                    store64(e,      dptr);
                    store64(e + 8,  dl);
                    store64(e + 16, ind);
                    store64(e + 24, heredoc_rule_kind(r));
                    store64(e + 32, i);
                    res = res + 1;
                }
                if (complete == 0) {
                    undecided = 1;
                    if ((term < 0) && (lf < src_len)) {
                        fast_ok = 1;
                        f_dpos = ds;
                        if (dcontig == 0) { f_dpos = (0 - 1); }
                        f_dptr = dptr;
                        f_dlen = dl;
                        f_ind = ind;
                        f_body = lf + 1;
                    }
                }
            }
        }
        if ((undecided == 1) && (_ds_depth == 1)) {
            decided = 1;
            # Heredocs opened on one line take their bodies in order, so
            # they hold as a unit: from the line's FIRST queued opener.
            # Holding from this one alone let `cat <<'Q' <<-T` commit
            # `<<'Q'`, and the next drain read Q's body as T's.
            var hfrom = i;
            if ((res > 0) && (hdq != 0)) {
                var q0pos = load64(hdq + 32);
                if (q0pos < hfrom) { hfrom = q0pos; }
            }
            if ((_ds_hd_hold_from < 0) || (hfrom < _ds_hd_hold_from)) {
                _ds_hd_hold_from = hfrom;
                _ds_hd_hold_fast = fast_ok;
                _ds_hd_hold_dpos = f_dpos;
                _ds_hd_hold_dptr = f_dptr;
                _ds_hd_hold_dlen = f_dlen;
                _ds_hd_hold_ind = f_ind;
                _ds_hd_hold_body = f_body;
            }
        }
        r_i = r_i + 1;
    }
    return res;
}

# ── Entry point ─────────────────────────────

# Set by the streaming drain (src/tokenize.cyr) when the buffer it is
# about to scan does NOT start at stream offset 0. Read and cleared on
# entry, so it covers this one call — not compose bodies tokenized
# recursively inside it. A shebang is a property of a file's first
# line; after the rolling buffer compacts, the buffer's offset 0 is
# just wherever the last commit stopped, and a `#!...` comment line
# landing there came back TK_PREPROCESSOR where a single feed gives
# TK_COMMENT (python / shell / ruby; 2.5.2 audit P2-6).
var _ds_not_file_start = 0;

# Also set by the drain for a mid-stream buffer: the byte just before
# `src[0]` (its last committed byte), for `start_after` boundaries
# (ADR 0022). -1 means `src` starts the input. One-shot, like the flag
# above, so compose bodies tokenized inside see their own start.
var _ds_buf_prev = (0 - 1);

fn tokenize_with_grammar(g, src, src_len, tb) {
    var not_file_start = _ds_not_file_start;
    _ds_not_file_start = 0;
    var prev0 = _ds_buf_prev;
    _ds_buf_prev = (0 - 1);
    var grp_on = _ds_grp_collect;
    _ds_grp_collect = 0;
    _ds_gen_counter = _ds_gen_counter + 1;
    var saved_gen = _ds_cur_gen;
    _ds_cur_gen = _ds_gen_counter;
    _ds_depth = _ds_depth + 1;
    if (_ds_depth == 1) {
        _ds_grp_active = grp_on;
        _ds_grp_n = 0;
    }
    var hd_rules = vec_len(grammar_heredoc_rules(g));
    var hdq = 0;
    # First byte of the (single, in practice) heredoc start marker, so the
    # per-token opener check is one compare; -1 = several rules, always
    # check.
    var hd_b0 = (0 - 1);
    if (hd_rules > 0) {
        hdq = _ds_hd_queue();
        if (hd_rules == 1) { hd_b0 = load8(heredoc_rule_start(vec_get(grammar_heredoc_rules(g), 0))); }
    }
    var hd_n = 0;
    # Arithmetic state for the opener check (grammars with heredoc rules
    # only): open `((` on this line, the offset of the outermost, and the
    # last unpaired paren byte (`ar_pend`, at `ar_pend_at`) so `(` `(`
    # split over two tokens still pairs.
    var ar_depth = 0;
    var ar_open = (0 - 1);
    var ar_pend = 0;
    var ar_pend_at = (0 - 2);
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var kind = TK_ERROR;
        var len  = 0;

        # H. Queued here-document bodies (ADR 0023) start right after the
        # first top-level line break following their opener. Each body,
        # with its terminator line, is one token; a whitespace token for
        # the line break between consecutive bodies.
        if ((hd_n > 0) && (i > 0) && (load8(src + i - 1) == 10)) {
            var cur = i;
            var qi = 0;
            var hd_stop = 0;
            # Not every queued body may be emittable from this buffer: the
            # opener's own check searched from ITS line's end, but bodies
            # run in order from here — after a string spanning lines, after
            # an earlier body. Then (and when a terminator's line break has
            # not arrived) the group is unresolved and the drain must hold
            # from the line's first opener, or it commits the opener line
            # and the next drain reads the body as code (2.6.x audit P2-1).
            var h_hold = 0;
            var h_fast = 0;
            var h_dpos = 0;
            var h_dptr = 0;
            var h_dlen = 0;
            var h_ind = 0;
            var h_body = 0;
            while ((qi < hd_n) && (hd_stop == 0)) {
                var e = hdq + qi * 40;
                var te = _ds_hd_find_term(src, src_len, cur, load64(e), load64(e + 8), load64(e + 16));
                if (te < 0) {
                    hd_stop = 1;
                    h_hold = 1;
                    if (te == (0 - 1)) {
                        h_fast = 1;
                        h_dpos = load64(e) - src;
                        if (_ds_hd_in_src(e, src, src_len) == 0) { h_dpos = (0 - 1); }
                        h_dptr = load64(e);
                        h_dlen = load64(e + 8);
                        h_ind = load64(e + 16);
                        h_body = cur;
                    }
                }
                if (te >= 0) {
                    # An empty `<<''` body ends at once (its terminator is
                    # the empty line): no token — a zero-length one broke
                    # the coverage contract (2.9.1 audit, reviewer B, F6).
                    if (te > cur) { tokenbuf_push(tb, load64(e + 24), cur, te - cur); }
                    var tdone = 0;
                    if (te < src_len) {
                        if (load8(src + te) == 10) { tdone = 1; }
                        if ((load8(src + te) == 13) && (te + 1 < src_len)) {
                            if (load8(src + te + 1) == 10) { tdone = 1; }
                        }
                    }
                    if (tdone == 0) {
                        h_hold = 1;
                        h_fast = 1;
                        h_dpos = load64(e) - src;
                        if (_ds_hd_in_src(e, src, src_len) == 0) { h_dpos = (0 - 1); }
                        h_dptr = load64(e);
                        h_dlen = load64(e + 8);
                        h_ind = load64(e + 16);
                        h_body = cur;
                    }
                    cur = te;
                    if (qi + 1 < hd_n) {
                        var lf2 = _ds_scan_to_lf(src, src_len, cur);
                        if (lf2 >= src_len) {
                            hd_stop = 1;
                            if (h_hold == 0) { h_hold = 1; }
                        }
                        if (lf2 < src_len) {
                            tokenbuf_push(tb, TK_WHITESPACE, cur, lf2 + 1 - cur);
                            cur = lf2 + 1;
                        }
                    }
                    qi = qi + 1;
                }
            }
            if (_ds_depth == 1) {
                var g_from = load64(hdq + 32);
                if (h_hold == 1) {
                    if ((_ds_hd_hold_from < 0) || (g_from < _ds_hd_hold_from)) {
                        _ds_hd_hold_from = g_from;
                        _ds_hd_hold_fast = h_fast;
                        _ds_hd_hold_dpos = h_dpos;
                        _ds_hd_hold_dptr = h_dptr;
                        _ds_hd_hold_dlen = h_dlen;
                        _ds_hd_hold_ind = h_ind;
                        _ds_hd_hold_body = h_body;
                    }
                }
                if (h_hold == 0) { _ds_grp_add(g_from, cur); }
            }
            hd_n = 0;
            ar_depth = 0;
            ar_open = (0 - 1);
            ar_pend = 0;
            i = cur;
            continue;
        }

        # 0. Compose rules (ADR 0013). Push their own tokens
        # (start marker + recursively-tokenized body + end
        # marker) and advance the cursor by the matched length.
        # Runs before any other step because compose markers
        # like `<style>` would otherwise be eaten by the outer
        # grammar's normal `<` op + `style` ident + `>` op
        # tokenization.
        var clen = _ds_try_compose_rules(g, src, src_len, i, tb);
        if (clen > 0) {
            i = i + clen;
            continue;
        }

        # 0b. Compose-fenced rules (ADR 0016). Same shape but the
        # inner grammar is captured per-fence from the bytes
        # between the start marker and the next LF (the
        # CommonMark "info string"). Markdown's ` ```rust ` →
        # rust grammar; ` ```python ` → python.
        var cflen = _ds_try_compose_fenced_rules(g, src, src_len, i, tb);
        if (cflen > 0) {
            i = i + cflen;
            continue;
        }

        # 0c. Compose-region rules (ADR 0019). Open-ended regions:
        # the body runs to a lookahead terminator (left unconsumed)
        # or to EOF. CYML's `---` opens a markdown body that ends
        # before the next TOML header, or at end of input.
        var crlen = _ds_try_compose_region_rules(g, src, src_len, i, tb);
        if (crlen > 0) {
            i = i + crlen;
            continue;
        }

        # 1. Shebang — only where the buffer starts the file.
        if ((len == 0) && (not_file_start == 0)) {
            len = _ds_try_shebang(g, src, src_len, i);
            if (len > 0) { kind = TK_PREPROCESSOR; }
        }

        # 2. Line rules
        if (len == 0) {
            var packed = _ds_try_line_rules(g, src, src_len, i, prev0);
            if (packed != 0) {
                kind = packed >> 56;
                len  = packed & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 3. Pair rules
        if (len == 0) {
            var packed2 = _ds_try_pair_rules(g, src, src_len, i);
            if (packed2 != 0) {
                kind = packed2 >> 56;
                len  = packed2 & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 4. Special var `$X`
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                if (i + 1 < src_len) {
                    if (_ds_is_special_var_char(load8(src + i + 1)) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 5. Lone `$` as operator (only if special_vars is on; otherwise
        # `$` will be caught by the operators list or fall through).
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 6. Identifier / keyword. With `unicode_ident = true`, any
        # byte ≥0x80 also enters the ident scan (see ADR 0009).
        if (len == 0) {
            var start_tbl = grammar_ident_start(g);
            var ident_ok = 0;
            if ((start_tbl != 0) && (char_class_match(start_tbl, b) == 1)) {
                ident_ok = 1;
            }
            if ((ident_ok == 0) && (grammar_unicode_ident(g) == 1) && (b >= 128)) {
                ident_ok = 1;
            }
            # `ident_lead` (ADR 0027): css's `-` starts `-webkit-x` and
            # `--var`, but alone (`100% - 10px`) or before a digit
            # (`-2px`) it is the operator.
            var lead_tbl = grammar_ident_lead(g);
            if ((ident_ok == 1) && (lead_tbl != 0)) {
                if (char_class_match(lead_tbl, b) == 1) {
                    if (_ds_ident_lead_ok(g, src, src_len, i) == 0) { ident_ok = 0; }
                }
            }
            if (ident_ok == 1) {
                len = _ds_scan_ident(g, src, src_len, i);
                var pre_len = _ds_prefixed_string(g, src, src_len, i, len);
                if (pre_len > 0) {
                    kind = TK_STRING;
                    len = pre_len;
                }
                if (pre_len == 0) {
                    var kw_kind = _ds_lookup_keyword(g, src, i, len);
                    if (kw_kind >= 0) {
                        kind = kw_kind;
                    } else {
                        kind = TK_IDENT;
                    }
                }
            }
        }

        # 7. Number
        if (len == 0) {
            if (_ds_is_digit(b) == 1) {
                var nlen = _ds_scan_number(g, src, src_len, i);
                if (nlen > 0) {
                    kind = TK_NUMBER;
                    len = nlen;
                }
            }
        }

        # 7b. Char literal. Runs only when `[defaults] char_literal
        # = true`; before the operator step so the leading `'`
        # doesn't fall through to a 1-char operator. Rust-style
        # lifetimes (no closing quote at the right offset) still
        # tokenize as `'` + ident via steps 8 + 6 on subsequent
        # cursor positions. See ADR 0010.
        if (len == 0) {
            var clen = _ds_try_char_literal(g, src, src_len, i);
            if (clen > 0) {
                kind = TK_STRING;
                len = clen;
            }
        }

        # 7c. Here-document opener (ADR 0023): queue the body, consume
        # nothing — the `<<` is still the operator step's token.
        if ((len == 0) && (hd_rules > 0)) {
            if ((hd_b0 < 0) || (b == hd_b0)) {
                var in_ar = 0;
                if (ar_depth > 0) { in_ar = 1; }
                hd_n = _ds_heredoc_open(g, src, src_len, i, hdq, hd_n, in_ar);
            }
        }

        # 8. Operator (first match in a longest-first list: a test holds
        #    every grammar to that order, 2.5.2)
        if (len == 0) {
            var olen = _ds_try_exact_list(grammar_operators(g), src, src_len, i);
            if (olen > 0) {
                kind = TK_OPERATOR;
                len = olen;
            }
        }

        # 9. Punctuation (first match, the same order)
        if (len == 0) {
            var plen = _ds_try_exact_list(grammar_punctuation(g), src, src_len, i);
            if (plen > 0) {
                kind = TK_PUNCTUATION;
                len = plen;
            }
        }

        # 10. Whitespace
        if (len == 0) {
            if ((grammar_whitespace_on(g) == 1) && (_ds_is_space(b) == 1)) {
                kind = TK_WHITESPACE;
                len = _ds_scan_whitespace(src, src_len, i);
                # With a heredoc queued, the run stops after its first LF —
                # the body begins on the very next byte (ADR 0023).
                if (hd_n > 0) {
                    var wl = 0;
                    var wdone = 0;
                    while ((wl < len) && (wdone == 0)) {
                        if (load8(src + i + wl) == 10) { wdone = 1; }
                        wl = wl + 1;
                    }
                    if (wdone == 1) { len = wl; }
                }
            }
        }

        # 11. Fallback — keep coverage invariant by advancing 1 byte.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        # Arithmetic state (see `_ds_hd_lf_after`'s header). Parens only
        # ever sit in operator / punctuation tokens; a line break in any
        # token ends the line.
        if (hd_rules > 0) {
            if ((kind == TK_OPERATOR) || (kind == TK_PUNCTUATION)) {
                var ak = 0;
                while (ak < len) {
                    var ab = load8(src + i + ak);
                    var ap = i + ak;
                    var apaired = 0;
                    if ((ab == 40) || (ab == 41)) {
                        if ((ar_pend == ab) && (ar_pend_at == ap - 1)) {
                            apaired = 1;
                            if (ab == 40) {
                                if (ar_depth == 0) { ar_open = ap - 1; }
                                ar_depth = ar_depth + 1;
                            }
                            if (ab == 41) {
                                if (ar_depth > 0) { ar_depth = ar_depth - 1; }
                                if (ar_depth == 0) { ar_open = (0 - 1); }
                            }
                            ar_pend = 0;
                        }
                        if (apaired == 0) {
                            ar_pend = ab;
                            ar_pend_at = ap;
                        }
                    }
                    if ((ab != 40) && (ab != 41)) { ar_pend = 0; }
                    ak = ak + 1;
                }
            }
            if ((kind != TK_OPERATOR) && (kind != TK_PUNCTUATION)) {
                ar_pend = 0;
                if ((ar_depth > 0) && (_ds_index_byte(src, i, i + len, 10) >= 0)) {
                    ar_depth = 0;
                    ar_open = (0 - 1);
                }
            }
        }
        i = i + len;
    }
    # Bodies still queued at the end: the line break that starts them
    # never came (`cat <<EOF "a` with the string still open). Same as an
    # unemittable group in the H step — hold from the line's first opener.
    # When what keeps the line open is a string still running at the end,
    # the drain waits for that string's close marker (`_ds_hd_hold_fast`
    # = 3) rather than re-scanning at every line break inside it (2.8.0).
    if ((hd_n > 0) && (_ds_depth == 1) && (hdq != 0)) {
        var q_from = load64(hdq + 32);
        if ((_ds_hd_hold_from < 0) || (q_from < _ds_hd_hold_from)) {
            _ds_hd_hold_from = q_from;
            _ds_hd_hold_fast = 0;
            var qn = tokenbuf_count(tb);
            if (qn > 0) {
                if ((tokenbuf_start(tb, qn - 1) + tokenbuf_len(tb, qn - 1) == src_len) &&
                  (_ds_pair_eof_gen == _ds_cur_gen) && (_ds_pair_eof_end != 0)) {
                    _ds_hd_hold_fast = 3;
                    _ds_hd_hold_marker = _ds_pair_eof_end;
                    _ds_hd_hold_esc = _ds_pair_eof_esc;
                }
            }
        }
    }
    # The buffer ends inside an arithmetic `((` opened on its last line:
    # hold from it, so the next drain still sees the `((` (2.6.x audit P1-2).
    if ((hd_rules > 0) && (_ds_depth == 1) && (ar_depth > 0) && (ar_open >= 0)) {
        if ((_ds_hd_hold_from < 0) || (ar_open < _ds_hd_hold_from)) {
            _ds_hd_hold_from = ar_open;
            _ds_hd_hold_fast = 0;
        }
    }
    if (_ds_depth == 1) { _ds_grp_active = 0; }
    _ds_depth = _ds_depth - 1;
    _ds_cur_gen = saved_gen;
    return tokenbuf_count(tb);
}

# Offset of the first byte == `b` in src[from..to), or -1.
fn _ds_index_byte(src, from, to, b) {
    var p = from;
    while (p < to) {
        if (load8(src + p) == b) { return p; }
        p = p + 1;
    }
    return (0 - 1);
}
