# vyakarana — data-driven default scanner
#
# Consumes a loaded grammar record (see src/grammar.cyr) and tokenizes
# source bytes into a tokenbuf. Scanner dispatch follows ADR 0005:
#
#   0. [[rules]] match="compose" (ADR 0013)           → recursive
#      (start marker + inner-grammar body + end marker)
#   0b. [[rules]] match="compose_fenced" (ADR 0016)   → recursive
#      (inner grammar captured per-fence from the info string)
#   0c. [[rules]] match="compose_region" (ADR 0019)   → recursive
#      (start marker + inner-grammar body; ends BEFORE an
#       unconsumed lookahead terminator, or at EOF)
#   1. shebang (#! on line 0, column 0)              → preprocessor
#   2. [[rules]] match="line"                         → kind
#   3. [[rules]] match="pair"                         → kind
#   4. defaults.special_vars ($X, X = #?@!*$-)        → operator, 2 bytes
#   5. defaults.special_vars lone $                   → operator, 1 byte
#   6. defaults.ident_start/ident_cont                → ident, or keyword
#      via [[rules]] match="words" lookup
#   7. defaults.number_decimal/_0x/_0b/_0o            → number
#   7b. defaults.char_literal `'C'`/`'\C'`/`'\xHH'`   → string
#   8. defaults.operators (longest match)             → operator
#   9. defaults.punctuation (longest match)           → punctuation
#  10. defaults.whitespace (run)                      → whitespace
#  11. fallthrough                                    → error (1 byte)
#
# Coverage invariant holds at every step — the main loop advances by
# `len` on each iteration and a fallback error emits 1 byte when no
# rule matched.
#
# Known optimization, not taken: the operators / punctuation lists
# are scanned linearly longest-first; a trie or length-indexed
# bucket scan would cut the per-token constant. Deliberately still
# open — the tokenize rows in `docs/development/performance.md` are
# dominated by streaming call overhead, not this scan, so it is not
# the profitable lever yet. (This used to say "an easy speedup at
# M5 benchmark time"; M5 landed in 2.0.0-2.0.2, so that framing
# was stale — the work was never the milestone's.)

include "src/token.cyr"
include "src/grammar.cyr"

# ── Scanner helpers (mirror the hand-coded shell.cyr shape) ─────────

fn _ds_is_space(b) {
    if (b == 32) { return 1; }
    if (b == 9)  { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    return 0;
}

fn _ds_is_digit(b) {
    if (b < 48) { return 0; }
    if (b > 57) { return 0; }
    return 1;
}

fn _ds_is_hex_digit(b) {
    if (_ds_is_digit(b) == 1) { return 1; }
    if ((b >= 97) && (b <= 102)) { return 1; }
    if ((b >= 65) && (b <= 70))  { return 1; }
    return 0;
}

fn _ds_is_bin_digit(b) {
    if (b == 48) { return 1; }
    if (b == 49) { return 1; }
    return 0;
}

fn _ds_is_oct_digit(b) {
    if (b < 48) { return 0; }
    if (b > 55) { return 0; }
    return 1;
}

fn _ds_is_special_var_char(b) {
    if (b == 35) { return 1; }   # #
    if (b == 63) { return 1; }   # ?
    if (b == 64) { return 1; }   # @
    if (b == 33) { return 1; }   # !
    if (b == 42) { return 1; }   # *
    if (b == 36) { return 1; }   # $
    if (b == 45) { return 1; }   # -
    return 0;
}

# ── Per-rule try-match functions ────────────
# Each returns a length > 0 if it matched at src[i], else 0.

fn _ds_try_shebang(g, src, src_len, i) {
    if (grammar_shebang_on(g) == 0) { return 0; }
    if (i != 0) { return 0; }
    if (src_len < 2) { return 0; }
    if (load8(src) != 35) { return 0; }      # #
    if (load8(src + 1) != 33) { return 0; }  # !
    var j = i;
    while (j < src_len) {
        if (load8(src + j) == 10) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Try each [[rules]] match="line" in order. Returns kind packed into
# high 8 bits and len in low 56 bits — 0 if none matched. (This is
# the cheapest multi-return I could find without tuples.)
fn _ds_try_line_rules(g, src, src_len, i) {
    var rules = grammar_line_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var marker = line_rule_start(r);
        var mlen = strlen(marker);
        if ((i + mlen <= src_len) && (memeq(src + i, marker, mlen) == 1)) {
            var j = i;
            while (j < src_len) {
                if (load8(src + j) == 10) { break; }
                j = j + 1;
            }
            var len = j - i;
            return (line_rule_kind(r) << 56) | len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="compose" at the cursor.
#
# A compose rule routes the body between `start` and `end`
# markers through a *different* grammar (looked up by name in
# the registry). When matched:
#   - emits `start` bytes as one TK_PUNCTUATION token,
#   - tokenizes the body via the inner grammar (recursively),
#     adjusting offsets so they're absolute in the outer src,
#   - emits `end` bytes as one TK_PUNCTUATION token,
#   - returns the total bytes consumed.
#
# When the inner grammar isn't found in the registry (e.g.
# bootstrap order, or the embedded language was never bundled),
# the body falls back to one TK_STRING token — coverage holds.
#
# Unlike the pair / line / words rule helpers, this one writes
# directly to `tb` and returns the advance length. Returns 0
# when no compose rule matched at this cursor.
#
# Recursion: `tokenize_with_grammar` itself runs compose-rule
# step (step 0 below), so embedded grammars that themselves
# have compose rules nest correctly. Real-world depth is ≤2
# (HTML <script> with a JS template literal containing CSS, say).
#
# See ADR 0013 for the design.
fn _ds_try_compose_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = compose_rule_end(r);
            var elen = strlen(endp);
            var body_start = i + slen;
            var j = body_start;
            while (j < src_len) {
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    # Found end marker. Emit start, body, end.
                    tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
                    var body_len = j - body_start;
                    if (body_len > 0) {
                        var inner_name = compose_rule_inner(r);
                        var inner_g = registry_find_by_name(inner_name);
                        if (inner_g != 0) {
                            # Inner grammar found — tokenize body
                            # in a fresh buf, copy with shifted
                            # offsets.
                            var inner_tb = tokenbuf_new();
                            tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                var ik = tokenbuf_kind(inner_tb, k);
                                var is = tokenbuf_start(inner_tb, k);
                                var il = tokenbuf_len(inner_tb, k);
                                tokenbuf_push(tb, ik, is + body_start, il);
                                k = k + 1;
                            }
                        } else {
                            # Inner grammar missing — graceful
                            # degrade: body is one string span.
                            tokenbuf_push(tb, TK_STRING, body_start, body_len);
                        }
                    }
                    tokenbuf_push(tb, TK_PUNCTUATION, j, elen);
                    return slen + body_len + elen;
                }
                j = j + 1;
            }
            # End marker not found — fall through (next compose
            # rule, or normal pipeline). Don't half-consume.
            return 0;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Try each [[rules]] match="compose_region" at the cursor.
#
# Same routing as `compose`, with the two differences CYML needs
# (ADR 0019). `end_before` is a LOOKAHEAD terminator: the region
# stops just before it and those bytes are left for the outer
# grammar, so the `[[entries]]` that opens CYML's next TOML header
# survives as TOML. And running out of input is success, not
# failure — the region simply ends at EOF, which is how every
# CYML file's last body terminates.
#
# Emits the start marker plus the routed body. There is no end
# token: the terminator was never ours to consume.
fn _ds_try_compose_region_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_region_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = compose_region_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endb = compose_region_rule_end_before(r);
            var elen = 0;
            if (endb != 0) { elen = strlen(endb); }
            var body_start = i + slen;
            # Scan for the terminator. Falling off the end is the
            # EOF case, and body_end is already correct for it.
            var body_end = src_len;
            if (elen > 0) {
                var j = body_start;
                var found = 0;
                while ((j < src_len) && (found == 0)) {
                    if ((j + elen <= src_len) && (memeq(src + j, endb, elen) == 1)) {
                        body_end = j;
                        found = 1;
                    }
                    j = j + 1;
                }
            }
            tokenbuf_push(tb, TK_PUNCTUATION, i, slen);
            var body_len = body_end - body_start;
            if (body_len > 0) {
                var inner_name = compose_region_rule_inner(r);
                var inner_g = registry_find_by_name(inner_name);
                if (inner_g != 0) {
                    var inner_tb = tokenbuf_new();
                    tokenize_with_grammar(inner_g, src + body_start, body_len, inner_tb);
                    var k = 0;
                    var nk = tokenbuf_count(inner_tb);
                    while (k < nk) {
                        var ik = tokenbuf_kind(inner_tb, k);
                        var is = tokenbuf_start(inner_tb, k);
                        var il = tokenbuf_len(inner_tb, k);
                        tokenbuf_push(tb, ik, is + body_start, il);
                        k = k + 1;
                    }
                } else {
                    # Inner grammar missing — same graceful degrade
                    # as `compose`: body becomes one string span.
                    tokenbuf_push(tb, TK_STRING, body_start, body_len);
                }
            }
            return slen + body_len;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# True if `b` is a tag-character (alphanumeric / `+` / `-` / `_`).
# CommonMark info-string is liberal but for grammar-name lookup
# we only care about the closed set [A-Za-z0-9_+-].
fn _ds_is_tag_byte(b) {
    if ((b >= 65) && (b <= 90))  { return 1; }     # A-Z
    if ((b >= 97) && (b <= 122)) { return 1; }     # a-z
    if ((b >= 48) && (b <= 57))  { return 1; }     # 0-9
    if (b == 95) { return 1; }                     # _
    if (b == 43) { return 1; }                     # +
    if (b == 45) { return 1; }                     # -
    return 0;
}

# Try each [[rules]] match="compose_fenced" at the cursor. Same
# shape as compose, but the inner grammar is captured per-fence
# from the bytes between `start` and the next newline (the
# "info string" in CommonMark terms; we take the first
# tag-character run as the language tag).
#
# Layout of a fence we recognize:
#
#     <start><tag><info-tail>\n<body>\n<end>
#
#   <start>      literal, e.g. "```"
#   <tag>        [A-Za-z0-9_+-]+ (captured language identifier)
#   <info-tail>  ignored bytes up to first \n
#   <body>       routed through grammar named by <tag>
#   <end>        literal, e.g. "```"; matches at start-of-line
#                or end-of-buffer
#
# Pipeline placement: same step 0 region as compose, executed
# before the regular pair / line / words steps so the outer
# grammar's tokenizer doesn't eat the fence markers byte-by-byte.
# See ADR 0016.
# Walk forward from `start` while bytes are tag-characters.
# Returns the offset just past the last tag byte (or `start` if
# none). Bounded by `src_len`.
fn _ds_scan_tag(src, src_len, start) {
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        # Read ONCE per iteration and advance only if the byte was
        # a tag byte. The previous shape incremented `p` in the
        # first `if` and then re-read `load8(src + p)` in the
        # second WITHOUT re-testing `p < src_len`, so a tag running
        # to the end of the buffer read `src[src_len]` — one byte
        # past the caller's allocation.
        #
        # `vyk` hid it: the CLI NUL-terminates at `buf[n]`, so the
        # stray byte was its own terminator. `tokenize_with_grammar`
        # is public surface though, and a consumer handing over an
        # exactly-sized buffer whose last page ends at src_len takes
        # a SIGSEGV. `_ds_scan_to_lf` below looks like the same
        # pattern but is safe — it increments last, so the loop
        # condition catches `p == src_len` before the next read.
        if (_ds_is_tag_byte(load8(src + p)) == 0) { done = 1; }
        if (done == 0) { p = p + 1; }
    }
    return p;
}

# Walk forward from `start` until LF or end-of-buffer. Returns
# the LF offset, or `src_len` if no LF before EOF.
fn _ds_scan_to_lf(src, src_len, start) {
    var p = start;
    var done = 0;
    while ((p < src_len) && (done == 0)) {
        if (load8(src + p) == 10) { done = 1; }
        if (load8(src + p) != 10) { p = p + 1; }
    }
    return p;
}

# Find the closing fence — earliest offset in [body_start, src_len)
# where the end marker appears at start-of-line (or == body_start
# for an empty-body fence). Returns the offset, or (0 - 1) if no
# match.
fn _ds_find_fenced_close(src, src_len, body_start, endp, elen) {
    var close_pos = (0 - 1);
    var j = body_start;
    while ((j + elen <= src_len) && (close_pos < 0)) {
        var line_start = 0;
        if (j == body_start) { line_start = 1; }
        if ((j > 0) && (load8(src + j - 1) == 10)) { line_start = 1; }
        if ((line_start == 1) && (memeq(src + j, endp, elen) == 1)) {
            close_pos = j;
        }
        if (close_pos < 0) { j = j + 1; }
    }
    return close_pos;
}

fn _ds_try_compose_fenced_rules(g, src, src_len, i, tb) {
    var rules = grammar_compose_fenced_rules(g);
    if (rules == 0) { return 0; }
    var n = vec_len(rules);
    var r_i = 0;
    var result = 0;
    while ((r_i < n) && (result == 0)) {
        var r = vec_get(rules, r_i);
        var start = compose_fenced_rule_start(r);
        var slen = strlen(start);
        var match_here = 0;
        if (i + slen <= src_len) {
            if (memeq(src + i, start, slen) == 1) { match_here = 1; }
        }
        if (match_here == 1) {
            var tag_start = i + slen;
            var tag_end = _ds_scan_tag(src, src_len, tag_start);
            var nl_pos  = _ds_scan_to_lf(src, src_len, tag_end);

            if (nl_pos < src_len) {
                # Real fence: has a closing LF on the open line.
                var body_start = nl_pos + 1;
                var endp = compose_fenced_rule_end(r);
                var elen = strlen(endp);
                var close_pos = _ds_find_fenced_close(src, src_len,
                  body_start, endp, elen);
                if (close_pos >= 0) {
                    # Resolve inner grammar from captured tag.
                    var tag_len = tag_end - tag_start;
                    var inner_g = 0;
                    if (tag_len > 0) {
                        var tag_buf = alloc(tag_len + 1);
                        var tk = 0;
                        while (tk < tag_len) {
                            store8(tag_buf + tk,
                              load8(src + tag_start + tk));
                            tk = tk + 1;
                        }
                        store8(tag_buf + tag_len, 0);
                        inner_g = registry_find_by_name(tag_buf);
                    }

                    # Emit: open-marker (incl. info + LF), body,
                    # close-marker.
                    var open_len = body_start - i;
                    tokenbuf_push(tb, TK_PUNCTUATION, i, open_len);

                    var body_len = close_pos - body_start;
                    if (body_len > 0) {
                        if (inner_g != 0) {
                            var inner_tb = tokenbuf_new();
                            tokenize_with_grammar(inner_g,
                              src + body_start,
                              body_len, inner_tb);
                            var k = 0;
                            var nk = tokenbuf_count(inner_tb);
                            while (k < nk) {
                                tokenbuf_push(tb,
                                  tokenbuf_kind(inner_tb, k),
                                  tokenbuf_start(inner_tb, k) + body_start,
                                  tokenbuf_len(inner_tb, k));
                                k = k + 1;
                            }
                        }
                        if (inner_g == 0) {
                            # No tag, or tag didn't resolve.
                            tokenbuf_push(tb, TK_STRING,
                              body_start, body_len);
                        }
                    }

                    tokenbuf_push(tb, TK_PUNCTUATION, close_pos, elen);
                    result = open_len + body_len + elen;
                }
            }
        }
        if (result == 0) { r_i = r_i + 1; }
    }
    return result;
}

# Try each [[rules]] match="pair". Returns packed (kind << 56) | len.
fn _ds_try_pair_rules(g, src, src_len, i) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var start = pair_rule_start(r);
        var slen = strlen(start);
        if ((i + slen <= src_len) && (memeq(src + i, start, slen) == 1)) {
            var endp = pair_rule_end(r);
            var elen = strlen(endp);
            var esc = pair_rule_escape(r);
            var j = i + slen;
            while (j < src_len) {
                var b = load8(src + j);
                if ((esc != 0) && (b == esc)) {
                    j = j + 2;
                    continue;
                }
                if ((j + elen <= src_len) && (memeq(src + j, endp, elen) == 1)) {
                    var len = j - i + elen;
                    return (pair_rule_kind(r) << 56) | len;
                }
                j = j + 1;
            }
            # Unterminated — consume to EOF.
            var len_eof = src_len - i;
            return (pair_rule_kind(r) << 56) | len_eof;
        }
        r_i = r_i + 1;
    }
    return 0;
}

# Char literal at the cursor when `[defaults] char_literal = true`.
# Recognises four shapes:
#   'C'      → 3 bytes  (any non-`\`, non-`'` byte)
#   '\C'     → 4 bytes  (any single-byte escape — \n, \0, \\, \', etc.)
#   '\xHH'   → 6 bytes  (hex escape; we don't validate the hex digits
#                        — the scanner trusts the closing quote)
#   '<UTF-8>'→ 4/5/6 bytes for 2/3/4-byte UTF-8 leading byte ranges
#
# Returns the matched length, or 0 if no shape fits. A 0 return lets
# the leading `'` fall through to the operator step — that's how
# Rust lifetimes (`'a`, `'static`, `'_`) keep working: no closing
# quote at the right offset means "not a char literal."
#
# See ADR 0010.
fn _ds_try_char_literal(g, src, src_len, i) {
    if (grammar_char_literal(g) == 0) { return 0; }
    if (i + 2 >= src_len) { return 0; }
    if (load8(src + i) != 39) { return 0; }   # opening `'`

    var b1 = load8(src + i + 1);
    if (b1 == 39) { return 0; }                # `''` — never valid
    if (b1 == 92) {                            # `\` escape forms
        if (i + 3 >= src_len) { return 0; }
        # `'\xHH'` — 6 bytes
        if (load8(src + i + 2) == 120) {       # `x`
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
        # `'\C'` — 4 bytes
        if (load8(src + i + 3) == 39) { return 4; }
        return 0;
    }

    # `'C'` — 3-byte ASCII body
    if (load8(src + i + 2) == 39) { return 3; }

    # UTF-8 multi-byte body. Leading-byte ranges per RFC 3629:
    #   0xC2..0xDF → 2-byte sequence (4 bytes total incl. quotes)
    #   0xE0..0xEF → 3-byte sequence (5 bytes total)
    #   0xF0..0xF4 → 4-byte sequence (6 bytes total)
    if (b1 >= 194) {
        if (b1 < 224) {
            if (i + 3 < src_len) {
                if (load8(src + i + 3) == 39) { return 4; }
            }
            return 0;
        }
        if (b1 < 240) {
            if (i + 4 < src_len) {
                if (load8(src + i + 4) == 39) { return 5; }
            }
            return 0;
        }
        if (b1 < 245) {
            if (i + 5 < src_len) {
                if (load8(src + i + 5) == 39) { return 6; }
            }
        }
    }
    return 0;
}

# Exact-match longest-first list (operators or punctuation). Returns
# the matched length, or 0 if nothing matched.
fn _ds_try_exact_list(list_vec, src, src_len, i) {
    var n = vec_len(list_vec);
    var li = 0;
    while (li < n) {
        var s = vec_get(list_vec, li);
        var slen = strlen(s);
        if ((i + slen <= src_len) && (memeq(src + i, s, slen) == 1)) {
            return slen;
        }
        li = li + 1;
    }
    return 0;
}

# Identifier run. Caller has already confirmed the first byte is in
# ident_start (or is a UTF-8 byte ≥0x80 with unicode_ident=true).
# Returns len.
#
# When `unicode_ident = true`, any byte ≥0x80 is also accepted as
# ident-cont so multi-byte UTF-8 sequences (em-dashes, smart
# quotes, accented letters) coalesce into a single TK_IDENT instead
# of fragmenting into per-byte TK_ERROR tokens. See
# [ADR 0009](../docs/adr/0009-unicode-ident-default.md).
fn _ds_scan_ident(g, src, src_len, i) {
    var cont_tbl = grammar_ident_cont(g);
    var unicode_on = grammar_unicode_ident(g);
    var j = i + 1;
    while (j < src_len) {
        var b = load8(src + j);
        var ok = char_class_match(cont_tbl, b);
        if ((ok == 0) && (unicode_on == 1) && (b >= 128)) { ok = 1; }
        if (ok == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Case-fold A-Z (0x41–0x5A) to a-z (0x61–0x7A). Other bytes
# pass through unchanged. Used by `_ds_lookup_keyword` when
# `[defaults] case_insensitive_keywords = true`. See ADR 0011.
fn _ds_to_lower(b) {
    if (b >= 65) {
        if (b <= 90) {
            return b + 32;
        }
    }
    return b;
}

# Compare an ident span against a keyword string with optional
# case folding. Returns 1 on match, 0 otherwise. Same byte-by-
# byte cost as `memeq` plus one branch per byte; no allocation.
fn _ds_word_match(src, start, w, wlen, fold) {
    if (fold == 0) {
        return memeq(src + start, w, wlen);
    }
    var i = 0;
    while (i < wlen) {
        var a = _ds_to_lower(load8(src + start + i));
        var b = _ds_to_lower(load8(w + i));
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# If the byte span [start, start+len) matches a word in any words
# rule, returns that rule's kind (an i64). Returns -1 when no match.
# No out-param, no per-call allocation — this runs once per ident
# in the hot path and ADR 0002 forbids per-token allocation.
#
# When `[defaults] case_insensitive_keywords = true`, the match
# folds A-Z to a-z on both sides. ADR 0011 — needed by SQL
# (and PostgreSQL/Oracle/T-SQL dialects) where `SELECT` /
# `select` / `Select` are the same reserved word.
fn _ds_lookup_keyword(g, src, start, len) {
    var rules = grammar_words_rules(g);
    var n = vec_len(rules);
    var fold = grammar_case_insensitive_kw(g);
    var r_i = 0;
    while (r_i < n) {
        var r = vec_get(rules, r_i);
        var words = words_rule_words(r);
        var wn = vec_len(words);
        var w_i = 0;
        while (w_i < wn) {
            var w = vec_get(words, w_i);
            var wlen = strlen(w);
            if (wlen == len) {
                if (_ds_word_match(src, start, w, wlen, fold) == 1) {
                    return words_rule_kind(r);
                }
            }
            w_i = w_i + 1;
        }
        r_i = r_i + 1;
    }
    return 0 - 1;
}

# Number with optional 0x/0b/0o prefix. Returns length; 0 if not a
# number. Caller has already checked is_digit on src[i].
fn _ds_scan_number(g, src, src_len, i) {
    if (load8(src + i) == 48) {                # leading 0
        if (i + 1 < src_len) {
            var p = load8(src + i + 1);
            if ((grammar_number_0x(g) == 1) && ((p == 120) || (p == 88))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_hex_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((grammar_number_0b(g) == 1) && ((p == 98) || (p == 66))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_bin_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
            if ((grammar_number_0o(g) == 1) && ((p == 111) || (p == 79))) {
                var j = i + 2;
                while (j < src_len) {
                    if (_ds_is_oct_digit(load8(src + j)) == 0) { return j - i; }
                    j = j + 1;
                }
                return src_len - i;
            }
        }
    }
    if (grammar_number_decimal(g) == 0) { return 0; }
    var j = i + 1;
    while (j < src_len) {
        if (_ds_is_digit(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# Whitespace run.
fn _ds_scan_whitespace(src, src_len, i) {
    var j = i;
    while (j < src_len) {
        if (_ds_is_space(load8(src + j)) == 0) { return j - i; }
        j = j + 1;
    }
    return src_len - i;
}

# ── Entry point ─────────────────────────────

fn tokenize_with_grammar(g, src, src_len, tb) {
    var i = 0;
    while (i < src_len) {
        var b = load8(src + i);
        var kind = TK_ERROR;
        var len  = 0;

        # 0. Compose rules (ADR 0013). Push their own tokens
        # (start marker + recursively-tokenized body + end
        # marker) and advance the cursor by the matched length.
        # Runs before any other step because compose markers
        # like `<style>` would otherwise be eaten by the outer
        # grammar's normal `<` op + `style` ident + `>` op
        # tokenization.
        var clen = _ds_try_compose_rules(g, src, src_len, i, tb);
        if (clen > 0) {
            i = i + clen;
            continue;
        }

        # 0b. Compose-fenced rules (ADR 0016). Same shape but the
        # inner grammar is captured per-fence from the bytes
        # between the start marker and the next LF (the
        # CommonMark "info string"). Markdown's ` ```rust ` →
        # rust grammar; ` ```python ` → python.
        var cflen = _ds_try_compose_fenced_rules(g, src, src_len, i, tb);
        if (cflen > 0) {
            i = i + cflen;
            continue;
        }

        # 0c. Compose-region rules (ADR 0019). Open-ended regions:
        # the body runs to a lookahead terminator (left unconsumed)
        # or to EOF. CYML's `---` opens a markdown body that ends
        # before the next TOML header, or at end of input.
        var crlen = _ds_try_compose_region_rules(g, src, src_len, i, tb);
        if (crlen > 0) {
            i = i + crlen;
            continue;
        }

        # 1. Shebang
        if (len == 0) {
            len = _ds_try_shebang(g, src, src_len, i);
            if (len > 0) { kind = TK_PREPROCESSOR; }
        }

        # 2. Line rules
        if (len == 0) {
            var packed = _ds_try_line_rules(g, src, src_len, i);
            if (packed != 0) {
                kind = packed >> 56;
                len  = packed & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 3. Pair rules
        if (len == 0) {
            var packed2 = _ds_try_pair_rules(g, src, src_len, i);
            if (packed2 != 0) {
                kind = packed2 >> 56;
                len  = packed2 & 0x00FFFFFFFFFFFFFF;
            }
        }

        # 4. Special var `$X`
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                if (i + 1 < src_len) {
                    if (_ds_is_special_var_char(load8(src + i + 1)) == 1) {
                        kind = TK_OPERATOR;
                        len = 2;
                    }
                }
            }
        }

        # 5. Lone `$` as operator (only if special_vars is on; otherwise
        # `$` will be caught by the operators list or fall through).
        if (len == 0) {
            if ((grammar_special_vars(g) == 1) && (b == 36)) {
                kind = TK_OPERATOR;
                len = 1;
            }
        }

        # 6. Identifier / keyword. With `unicode_ident = true`, any
        # byte ≥0x80 also enters the ident scan (see ADR 0009).
        if (len == 0) {
            var start_tbl = grammar_ident_start(g);
            var ident_ok = 0;
            if ((start_tbl != 0) && (char_class_match(start_tbl, b) == 1)) {
                ident_ok = 1;
            }
            if ((ident_ok == 0) && (grammar_unicode_ident(g) == 1) && (b >= 128)) {
                ident_ok = 1;
            }
            if (ident_ok == 1) {
                len = _ds_scan_ident(g, src, src_len, i);
                var kw_kind = _ds_lookup_keyword(g, src, i, len);
                if (kw_kind >= 0) {
                    kind = kw_kind;
                } else {
                    kind = TK_IDENT;
                }
            }
        }

        # 7. Number
        if (len == 0) {
            if (_ds_is_digit(b) == 1) {
                var nlen = _ds_scan_number(g, src, src_len, i);
                if (nlen > 0) {
                    kind = TK_NUMBER;
                    len = nlen;
                }
            }
        }

        # 7b. Char literal. Runs only when `[defaults] char_literal
        # = true`; before the operator step so the leading `'`
        # doesn't fall through to a 1-char operator. Rust-style
        # lifetimes (no closing quote at the right offset) still
        # tokenize as `'` + ident via steps 8 + 6 on subsequent
        # cursor positions. See ADR 0010.
        if (len == 0) {
            var clen = _ds_try_char_literal(g, src, src_len, i);
            if (clen > 0) {
                kind = TK_STRING;
                len = clen;
            }
        }

        # 8. Operator (longest match)
        if (len == 0) {
            var olen = _ds_try_exact_list(grammar_operators(g), src, src_len, i);
            if (olen > 0) {
                kind = TK_OPERATOR;
                len = olen;
            }
        }

        # 9. Punctuation (longest match)
        if (len == 0) {
            var plen = _ds_try_exact_list(grammar_punctuation(g), src, src_len, i);
            if (plen > 0) {
                kind = TK_PUNCTUATION;
                len = plen;
            }
        }

        # 10. Whitespace
        if (len == 0) {
            if ((grammar_whitespace_on(g) == 1) && (_ds_is_space(b) == 1)) {
                kind = TK_WHITESPACE;
                len = _ds_scan_whitespace(src, src_len, i);
            }
        }

        # 11. Fallback — keep coverage invariant by advancing 1 byte.
        if (len == 0) {
            kind = TK_ERROR;
            len = 1;
        }

        tokenbuf_push(tb, kind, i, len);
        i = i + len;
    }
    return tokenbuf_count(tb);
}
