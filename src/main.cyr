# vyakarana — `vyk` demo entry point
#
# Stdlib auto-included via cyrius.cyml.
#
# Scope:
#   vyk --version
#   vyk --help / -h
#   vyk --list-kinds        prints the ten token kinds
#   vyk --list-languages    prints loaded grammars (11 starter set)
#   vyk <file>              tokenize a file, NDJSON on stdout
#   vyk --language=<lang>   override detection (M1: only `shell`)

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"
include "src/theme.cyr"
include "src/theme_export.cyr"
include "src/version_str.cyr"

# Exit codes per design spec §9
var EXIT_OK           = 0;
var EXIT_GRAMMAR_FAIL = 1;
var EXIT_USAGE        = 2;
var EXIT_IO           = 3;
var EXIT_NO_GRAMMAR   = 4;

# Source-buffer cap for `vyk <file>`. M1 reads up to 1 MB; M5's
# streaming tokenizer will remove this ceiling.
var VYK_SRC_CAP = 1048576;

fn print_version() {
    println(VYK_VERSION);
    return 0;
}

fn print_help() {
    println("vyk — vyakarana demo CLI");
    println("");
    println("Usage: vyk [OPTIONS] [FILE]");
    println("");
    println("Options:");
    println("  -h, --help             Print this help and exit");
    println("  -V, --version          Print version and exit");
    println("      --list-kinds       Print the ten token kinds");
    println("      --list-languages   Print loaded grammars");
    println("      --language=<lang>  Override language detection");
    println("      --theme=<name>     Render ANSI-coloured source instead");
    println("                         of NDJSON. Themes: default, dark, none.");
    println("                         See docs/architecture/004-theme-palette-contract.md.");
    println("      --export-theme=<format>  Emit a theme file for the named");
    println("                         editor format and exit. Formats: vscode.");
    println("                         Pair with --theme=<name> to pick the");
    println("                         palette (default: default).");
    println("");
    println("If FILE is given without --theme, tokens are printed as NDJSON:");
    println("  {\"kind\":\"keyword\",\"start\":0,\"len\":2}");
    return 0;
}

fn print_list_kinds() {
    var i = 0;
    while (i < TK_COUNT) {
        println(kind_name(i));
        i = i + 1;
    }
    return 0;
}

fn print_list_languages() {
    # Enumerate loaded grammars via the registry (src/grammar.cyr).
    # bootstrap_grammars ensures the bundled grammars are loaded —
    # this path doesn't go through tokenize_source / has_grammar so
    # it needs to trigger the load explicitly.
    bootstrap_grammars();
    var names = vec_new();
    list_languages_into(names);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        println(vec_get(names, i));
        i = i + 1;
    }
    return 0;
}

# Sanitize an externally-supplied cstr for echo on stderr: replace
# bytes < 0x20 (including the 0x1B ESC that anchors every ANSI
# escape sequence) and 0x7F DEL with `?`. UTF-8 bytes (>= 0x80)
# pass through so non-ASCII paths still echo legibly.
# See docs/audit/2026-04-23-audit.md FINDING-006.
fn _sanitize_for_stderr(s) {
    var n = strlen(s);
    var out = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var b = load8(s + i);
        var c = b;
        if (b < 32)   { c = 63; }   # ? replaces C0 controls (incl. ESC)
        if (b == 127) { c = 63; }   # ? replaces DEL
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

fn usage_error(flag) {
    var msg1 = "vyk: unknown option: ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(flag);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: try --help for a list of options\n";
    eprint(msg2, strlen(msg2));
    return 0;
}

fn io_error(path) {
    var m1 = "vyk: cannot read ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    return 0;
}

fn no_grammar_error(path) {
    var m1 = "vyk: no grammar matched for ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = " (try --language=shell)\n";
    eprint(m2, strlen(m2));
    return 0;
}

# Extension-based detection. Returns a language name (string literal)
# or 0 when nothing matches.
fn detect_language(path) {
    var n = strlen(path);
    if (n >= 3) {
        if (memeq(path + n - 3, ".sh", 3) == 1) { return "shell"; }
    }
    if (n >= 2) {
        if (memeq(path + n - 2, ".c", 2) == 1) { return "c"; }
        if (memeq(path + n - 2, ".h", 2) == 1) { return "c"; }
        # `.s` / `.S` ambiguous between asm_x86_64 and asm_aarch64.
        # Default to x86_64 (more common); ARM users pass
        # --language=asm_aarch64 explicitly.
        if (memeq(path + n - 2, ".s", 2) == 1) { return "asm_x86_64"; }
        if (memeq(path + n - 2, ".S", 2) == 1) { return "asm_x86_64"; }
    }
    if (n >= 3) {
        if (memeq(path + n - 3, ".hs", 3) == 1) { return "haskell"; }
        if (memeq(path + n - 3, ".ll", 3) == 1) { return "llvm_ir"; }
        if (memeq(path + n - 3, ".rs", 3) == 1) { return "rust"; }
        if (memeq(path + n - 3, ".md", 3) == 1) { return "markdown"; }
        if (memeq(path + n - 3, ".ts", 3) == 1) { return "typescript"; }
        if (memeq(path + n - 3, ".js", 3) == 1) { return "javascript"; }
        if (memeq(path + n - 3, ".py", 3) == 1) { return "python"; }
        if (memeq(path + n - 3, ".go", 3) == 1) { return "go"; }
        if (memeq(path + n - 3, ".kt", 3) == 1) { return "kotlin"; }
        if (memeq(path + n - 3, ".cs", 3) == 1) { return "csharp"; }
        if (memeq(path + n - 3, ".cc", 3) == 1) { return "cpp"; }
        if (memeq(path + n - 3, ".rb", 3) == 1) { return "ruby"; }
        if (memeq(path + n - 3, ".ex", 3) == 1) { return "elixir"; }
        if (memeq(path + n - 3, ".ml", 3) == 1) { return "ocaml"; }
    }
    if (n >= 4) {
        if (memeq(path + n - 4, ".exs", 4) == 1) { return "elixir"; }
        if (memeq(path + n - 4, ".mli", 4) == 1) { return "ocaml"; }
        if (memeq(path + n - 4, ".lhs", 4) == 1) { return "haskell"; }
    }
    if (n >= 4) {
        if (memeq(path + n - 4, ".htm", 4) == 1) { return "html"; }
        if (memeq(path + n - 4, ".css", 4) == 1) { return "css"; }
        if (memeq(path + n - 4, ".ini", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".cfg", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".xml", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsl", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsd", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".svg", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".sql", 4) == 1) { return "sql"; }
        if (memeq(path + n - 4, ".gql", 4) == 1) { return "graphql"; }
        if (memeq(path + n - 4, ".mjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".cxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".kts", 4) == 1) { return "kotlin"; }
        if (memeq(path + n - 4, ".php", 4) == 1) { return "php"; }
        if (memeq(path + n - 4, ".lua", 4) == 1) { return "lua"; }
    }
    if (n >= 4) {
        if (memeq(path + n - 4, ".yml", 4) == 1) { return "yaml"; }
    }
    if (n >= 8) {
        if (memeq(path + n - 8, ".graphql", 8) == 1) { return "graphql"; }
    }
    if (n >= 9) {
        if (memeq(path + n - 9, ".markdown", 9) == 1) { return "markdown"; }
    }
    if (n >= 5) {
        if (memeq(path + n - 5, ".yaml", 5) == 1) { return "yaml"; }
    }
    if (n >= 4) {
        if (memeq(path + n - 4, ".cyr", 4) == 1) { return "cyrius"; }
        if (memeq(path + n - 4, ".zig", 4) == 1) { return "zig"; }
    }
    if (n >= 5) {
        if (memeq(path + n - 5, ".html", 5) == 1) { return "html"; }
        if (memeq(path + n - 5, ".scss", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".sass", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".conf", 5) == 1) { return "ini"; }
        if (memeq(path + n - 5, ".bash", 5) == 1) { return "shell"; }
        if (memeq(path + n - 5, ".toml", 5) == 1) { return "toml"; }
        if (memeq(path + n - 5, ".json", 5) == 1) { return "json"; }
        if (memeq(path + n - 5, ".java", 5) == 1) { return "java"; }
        # `.cyml` is vyakarana's own format — TOML-shaped header
        # plus optional `---`/markdown body. The cyml.cyml grammar
        # (1.9.0+) handles both halves; before that, .cyml routed
        # to the toml grammar.
        if (memeq(path + n - 5, ".cyml", 5) == 1) { return "cyml"; }
    }
    if (n >= 6) {
        if (memeq(path + n - 6, ".swift", 6) == 1) { return "swift"; }
        if (memeq(path + n - 6, ".proto", 6) == 1) { return "protobuf"; }
    }
    # Dockerfile is matched by basename (canonical filename has
    # no extension). Suffix `Dockerfile` covers `./Dockerfile`,
    # `/path/to/Dockerfile`, and `name.Dockerfile`. The
    # `Dockerfile.<variant>` form (e.g. `Dockerfile.dev`)
    # would need basename-and-prefix matching; today users with
    # those names pass `--language=dockerfile` explicitly.
    if (n >= 10) {
        if (memeq(path + n - 10, "Dockerfile", 10) == 1) { return "dockerfile"; }
    }
    if (n >= 13) {
        if (memeq(path + n - 13, "Containerfile", 13) == 1) { return "dockerfile"; }
    }
    # Makefile is matched by basename. Standard names are
    # `Makefile`, `makefile`, `GNUmakefile`. Variant suffixes
    # like `Makefile.am` (autotools) need explicit
    # `--language=makefile`.
    if (n >= 8) {
        if (memeq(path + n - 8, "Makefile", 8) == 1) { return "makefile"; }
        if (memeq(path + n - 8, "makefile", 8) == 1) { return "makefile"; }
    }
    if (n >= 11) {
        if (memeq(path + n - 11, "GNUmakefile", 11) == 1) { return "makefile"; }
    }
    return 0;
}

# Emit ANSI-themed source bytes per the chosen theme (see
# src/theme.cyr). Walks the tokenbuf in order; for each token,
# writes the theme's ANSI prefix (if non-empty), then the source
# bytes from `[start, start+len)`, then the reset escape.
# Returns 1 if any TK_ERROR token was emitted, else 0 — same
# convention as emit_ndjson so the exit-code path is shared.
fn emit_themed(tb, src, theme) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var reset = theme_reset();
    var rlen = strlen(reset);
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var color = theme_color(theme, k);
        var clen = strlen(color);
        if (clen > 0) {
            print(color, clen);
        }
        print(src + s, l);
        if (clen > 0) {
            print(reset, rlen);
        }
        i = i + 1;
    }
    return any_error;
}

# Emit one NDJSON line per token. Returns 1 if any TK_ERROR token
# was emitted, else 0.
fn emit_ndjson(tb) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var s_open  = "{\"kind\":\"";
    var s_mid1  = "\",\"start\":";
    var s_mid2  = ",\"len\":";
    var s_close = "}\n";
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var name = kind_name(k);
        print(s_open, strlen(s_open));
        print(name, strlen(name));
        print(s_mid1, strlen(s_mid1));
        fmt_int(s);
        print(s_mid2, strlen(s_mid2));
        fmt_int(l);
        print(s_close, strlen(s_close));
        i = i + 1;
    }
    return any_error;
}

# Read file, tokenize with the given language, emit either
# NDJSON (default) or ANSI-themed source bytes (when `theme >=
# 0`). Returns an exit code. `handcoded = 1` routes through the
# M1 oracle path (see src/tokenize.cyr) for the M2 regression
# diff.
#
# `theme` is the theme tag from `theme_resolve()`, or -1 if
# `--theme=` was not passed (NDJSON output).
fn tokenize_file(path, lang, handcoded, theme) {
    var buf = alloc(VYK_SRC_CAP);
    var n = file_read_all(path, buf, VYK_SRC_CAP - 1);
    if (n < 0) {
        io_error(path);
        return EXIT_IO;
    }
    # NUL-terminate so strlen inside tokenize_source returns n.
    store8(buf + n, 0);
    var tb = 0;
    if (handcoded == 1) {
        tb = tokenize_source_handcoded(buf, lang);
    } else {
        tb = tokenize_source(buf, lang);
    }
    if (tb == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    var had_error = 0;
    if (theme >= 0) {
        had_error = emit_themed(tb, buf, theme);
    } else {
        had_error = emit_ndjson(tb);
    }
    if (had_error == 1) { return EXIT_GRAMMAR_FAIL; }
    return EXIT_OK;
}

# Parse --language=<val>; returns pointer to value or 0 if arg isn't
# a --language=... form.
fn parse_language_arg(a) {
    var prefix = "--language=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

# Parse --theme=<val>; returns pointer to value or 0 if arg isn't
# a --theme=... form.
fn parse_theme_arg(a) {
    var prefix = "--theme=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

# Parse --export-theme=<val>; returns pointer to value or 0 if
# arg isn't a --export-theme=... form.
fn parse_export_theme_arg(a) {
    var prefix = "--export-theme=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

fn main() {
    alloc_init();
    args_init();

    var ac = argc();
    if (ac < 2) {
        print_help();
        return EXIT_OK;
    }

    # Two-pass: collect an optional --language= override, an optional
    # --handcoded flag (regression oracle — see src/tokenize.cyr),
    # and the first non-flag arg (the file path). Flags may appear
    # in any order.
    var lang_override = 0;
    var path = 0;
    var handcoded = 0;
    # theme = -1 means "no --theme passed; emit NDJSON". 0 / 1 / 2
    # are valid theme tags from theme_resolve().
    var theme = 0 - 1;

    var i = 1;
    while (i < ac) {
        var a = argv(i);
        if (streq(a, "-h") == 1) { print_help(); return EXIT_OK; }
        if (streq(a, "--help") == 1) { print_help(); return EXIT_OK; }
        if (streq(a, "-V") == 1) { print_version(); return EXIT_OK; }
        if (streq(a, "--version") == 1) { print_version(); return EXIT_OK; }
        if (streq(a, "--list-kinds") == 1) { print_list_kinds(); return EXIT_OK; }
        if (streq(a, "--list-languages") == 1) { print_list_languages(); return EXIT_OK; }
        if (streq(a, "--handcoded") == 1) {
            handcoded = 1;
            i = i + 1;
            continue;
        }

        var langv = parse_language_arg(a);
        if (langv != 0) {
            lang_override = langv;
            i = i + 1;
            continue;
        }

        var themev = parse_theme_arg(a);
        if (themev != 0) {
            theme = theme_resolve(themev);
            if (theme < 0) {
                usage_error(a);
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }

        var exportv = parse_export_theme_arg(a);
        if (exportv != 0) {
            # Only `vscode` for 1.11.1; helix and iTerm
            # deferred. Selects which theme via the `--theme=`
            # flag if it appeared earlier; otherwise default.
            if (streq(exportv, "vscode") == 0) {
                usage_error(a);
                return EXIT_USAGE;
            }
            var which = theme;
            if (which < 0) { which = THEME_DEFAULT; }
            theme_export_vscode(which);
            return EXIT_OK;
        }

        # First non-flag: treat as a file path. Reject anything else
        # starting with `-` as an unknown option.
        if (load8(a) == 45) {   # `-`
            usage_error(a);
            return EXIT_USAGE;
        }
        if (path == 0) {
            path = a;
            i = i + 1;
            continue;
        }
        # Second positional — treat as a usage error.
        usage_error(a);
        return EXIT_USAGE;
    }

    if (path == 0) {
        print_help();
        return EXIT_OK;
    }

    var lang = lang_override;
    if (lang == 0) { lang = detect_language(path); }
    if (lang == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    if (has_grammar(lang) == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }

    return tokenize_file(path, lang, handcoded, theme);
}

var exit_code = main();
syscall(60, exit_code);
