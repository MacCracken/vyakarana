# vyakarana — `vyk` demo entry point
#
# Stdlib auto-included via cyrius.cyml.
#
# Scope:
#   vyk --version
#   vyk --help / -h
#   vyk --list-kinds        prints the ten token kinds
#   vyk --list-languages    prints loaded grammars (11 starter set)
#   vyk <file>              tokenize a file, NDJSON on stdout
#   vyk --language=<lang>   override detection (M1: only `shell`)

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"
include "src/detect.cyr"
include "src/theme.cyr"
include "src/theme_export.cyr"
include "src/version_str.cyr"

# Exit codes per design spec §9
var EXIT_OK           = 0;
var EXIT_GRAMMAR_FAIL = 1;
var EXIT_USAGE        = 2;
var EXIT_IO           = 3;
var EXIT_NO_GRAMMAR   = 4;

# Source-buffer cap for `vyk <file>`. M1 reads up to 1 MB; M5's
# streaming tokenizer will remove this ceiling.
var VYK_SRC_CAP = 1048576;

fn print_version() {
    println(VYK_VERSION);
    return 0;
}

fn print_help() {
    println("vyk — vyakarana source-code tokenizer (demo CLI)");
    println("");
    println("Usage: vyk [OPTIONS] [FILE]");
    println("");
    println("Tokenize FILE and print one NDJSON record per token, or");
    println("emit ANSI-coloured source bytes when --theme= is set.");
    println("Without FILE, exits with --help text.");
    println("");
    println("Options:");
    println("  -h, --help             Print this help and exit");
    println("  -V, --version          Print version and exit");
    println("      --list-kinds       Print the ten token kinds and exit");
    println("      --list-languages   Print loaded grammars and exit");
    println("      --language=<lang>  Override extension/content detection");
    println("                         (run --list-languages for valid names)");
    println("      --theme=<name>     Render ANSI-coloured source instead");
    println("                         of NDJSON. Names: default, dark, none.");
    println("                         See docs/architecture/004-theme-palette-contract.md.");
    println("      --export-theme=<format>  Emit a theme file for the named");
    println("                         editor format and exit. Formats:");
    println("                         vscode (theme.json), helix (theme.toml),");
    println("                         iterm (.itermcolors plist).");
    println("                         Pair with --theme=<name> to pick the");
    println("                         palette (default: default).");
    println("      --handcoded        Use the M1 hand-coded shell oracle");
    println("                         (regression diagnostic; shell only)");
    println("");
    println("Exit codes:");
    println("  0  success");
    println("  1  tokenization produced an `error` token kind");
    println("  2  bad command-line usage (run --help)");
    println("  3  cannot read FILE (not found or not readable)");
    println("  4  no grammar matched FILE");
    println("");
    println("Examples:");
    println("  vyk script.sh                    # NDJSON tokens to stdout");
    println("  vyk --theme=dark file.rs         # ANSI-coloured render");
    println("  vyk --language=python script     # extensionless file");
    println("  vyk --export-theme=vscode > theme.json   # editor theme");
    println("  vyk --list-languages | grep ml   # discover grammar names");
    println("");
    println("NDJSON output shape:");
    println("  {\"kind\":\"keyword\",\"start\":0,\"len\":2}");
    println("  Kinds: ident, keyword, string, number, comment,");
    println("         operator, punctuation, whitespace,");
    println("         preprocessor, error.");
    return 0;
}

fn print_list_kinds() {
    var i = 0;
    while (i < TK_COUNT) {
        println(kind_name(i));
        i = i + 1;
    }
    return 0;
}

fn print_list_languages() {
    # Enumerate loaded grammars via the registry (src/grammar.cyr).
    # bootstrap_grammars ensures the bundled grammars are loaded —
    # this path doesn't go through tokenize_source / has_grammar so
    # it needs to trigger the load explicitly.
    bootstrap_grammars();
    var names = vec_new();
    list_languages_into(names);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        println(vec_get(names, i));
        i = i + 1;
    }
    return 0;
}

# Sanitize an externally-supplied cstr for echo on stderr: replace
# bytes < 0x20 (including the 0x1B ESC that anchors every ANSI
# escape sequence) and 0x7F DEL with `?`. UTF-8 bytes (>= 0x80)
# pass through so non-ASCII paths still echo legibly.
# See docs/audit/2026-04-23-audit.md FINDING-006.
fn _sanitize_for_stderr(s) {
    var n = strlen(s);
    var out = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var b = load8(s + i);
        var c = b;
        if (b < 32)   { c = 63; }   # ? replaces C0 controls (incl. ESC)
        if (b == 127) { c = 63; }   # ? replaces DEL
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# Error functions split by failure class (1.13.1):
#   - unknown_option_error(flag)        — `--bogus` style
#   - bad_value_error(flag, allowed)    — `--theme=nope`
#   - extra_arg_error(arg)              — second positional file
#   - io_error(path)                    — file read failed
#   - no_grammar_error(path)            — extension/content didn't match
# Each one tells the user *what* the problem is and *what* to do
# next. The `try --help` reference is consistent across all.

fn unknown_option_error(flag) {
    var msg1 = "vyk: unknown option: ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(flag);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: try --help for a list of options\n";
    eprint(msg2, strlen(msg2));
    return 0;
}

# `flag` is the offending argv (e.g. `--theme=nope`); `allowed`
# is a comma-separated list of valid values for the user to
# scan ("default, dark, none").
fn bad_value_error(flag, allowed) {
    var msg1 = "vyk: invalid value for ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(flag);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: allowed values: ";
    eprint(msg2, strlen(msg2));
    eprint(allowed, strlen(allowed));
    eprint("\n", 1);
    return 0;
}

fn extra_arg_error(arg) {
    var msg1 = "vyk: extra argument: ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(arg);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: only one FILE may be given (try --help)\n";
    eprint(msg2, strlen(msg2));
    return 0;
}

fn io_error(path) {
    var m1 = "vyk: cannot read ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = ": file not found or not readable\n";
    eprint(m2, strlen(m2));
    return 0;
}

fn no_grammar_error(path) {
    var m1 = "vyk: no grammar matched for ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = "\nvyk: try --language=<name> (run --list-languages to see all)\n";
    eprint(m2, strlen(m2));
    return 0;
}

# Emit ANSI-themed source bytes per the chosen theme (see
# src/theme.cyr). Walks the tokenbuf in order; for each token,
# writes the theme's ANSI prefix (if non-empty), then the source
# bytes from `[start, start+len)`, then the reset escape.
# Returns 1 if any TK_ERROR token was emitted, else 0 — same
# convention as emit_ndjson so the exit-code path is shared.
fn emit_themed(tb, src, theme) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var reset = theme_reset();
    var rlen = strlen(reset);
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var color = theme_color(theme, k);
        var clen = strlen(color);
        if (clen > 0) {
            print(color, clen);
        }
        print(src + s, l);
        if (clen > 0) {
            print(reset, rlen);
        }
        i = i + 1;
    }
    return any_error;
}

# Emit one NDJSON line per token. Returns 1 if any TK_ERROR token
# was emitted, else 0.
fn emit_ndjson(tb) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var s_open  = "{\"kind\":\"";
    var s_mid1  = "\",\"start\":";
    var s_mid2  = ",\"len\":";
    var s_close = "}\n";
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var name = kind_name(k);
        print(s_open, strlen(s_open));
        print(name, strlen(name));
        print(s_mid1, strlen(s_mid1));
        fmt_int(s);
        print(s_mid2, strlen(s_mid2));
        fmt_int(l);
        print(s_close, strlen(s_close));
        i = i + 1;
    }
    return any_error;
}

# Read file, tokenize with the given language, emit either
# NDJSON (default) or ANSI-themed source bytes (when `theme >=
# 0`). Returns an exit code. `handcoded = 1` routes through the
# M1 oracle path (see src/tokenize.cyr) for the M2 regression
# diff.
#
# `theme` is the theme tag from `theme_resolve()`, or -1 if
# `--theme=` was not passed (NDJSON output).
# Tokenize an already-read buffer. `buf` is a NUL-terminated cstr;
# `n` is its length. Detection happens upstream so the same buffer
# can be sniffed and tokenized without a second file read (1.11.2).
fn tokenize_buf(buf, n, path, lang, handcoded, theme) {
    var tb = 0;
    if (handcoded == 1) {
        tb = tokenize_source_handcoded(buf, lang);
    }
    if (handcoded != 1) {
        # 2.0+ streaming entry: feed the whole buffer in one shot
        # then finish. The CLI's pre-read flow always has the full
        # source available, so a single feed() is the natural use.
        var s = tokenize_stream_new(lang);
        if (s != 0) {
            tb = tokenbuf_new();
            tokenize_stream_feed(s, buf, n);
            tokenize_stream_finish(s, tb);
            tokenize_stream_free(s);
        }
    }
    if (tb == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    var had_error = 0;
    if (theme >= 0) {
        had_error = emit_themed(tb, buf, theme);
    } else {
        had_error = emit_ndjson(tb);
    }
    if (had_error == 1) { return EXIT_GRAMMAR_FAIL; }
    return EXIT_OK;
}

# Parse --language=<val>; returns pointer to value or 0 if arg isn't
# a --language=... form.
fn parse_language_arg(a) {
    var prefix = "--language=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

# Parse --theme=<val>; returns pointer to value or 0 if arg isn't
# a --theme=... form.
fn parse_theme_arg(a) {
    var prefix = "--theme=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

# Parse --export-theme=<val>; returns pointer to value or 0 if
# arg isn't a --export-theme=... form.
fn parse_export_theme_arg(a) {
    var prefix = "--export-theme=";
    var plen = strlen(prefix);
    if (strlen(a) <= plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

fn main() {
    alloc_init();
    args_init();

    var ac = argc();
    if (ac < 2) {
        print_help();
        return EXIT_OK;
    }

    # Two-pass: collect an optional --language= override, an optional
    # --handcoded flag (regression oracle — see src/tokenize.cyr),
    # and the first non-flag arg (the file path). Flags may appear
    # in any order.
    var lang_override = 0;
    var path = 0;
    var handcoded = 0;
    # theme = -1 means "no --theme passed; emit NDJSON". 0 / 1 / 2
    # are valid theme tags from theme_resolve().
    var theme = 0 - 1;

    var i = 1;
    while (i < ac) {
        var a = argv(i);
        if (streq(a, "-h") == 1) { print_help(); return EXIT_OK; }
        if (streq(a, "--help") == 1) { print_help(); return EXIT_OK; }
        if (streq(a, "-V") == 1) { print_version(); return EXIT_OK; }
        if (streq(a, "--version") == 1) { print_version(); return EXIT_OK; }
        if (streq(a, "--list-kinds") == 1) { print_list_kinds(); return EXIT_OK; }
        if (streq(a, "--list-languages") == 1) { print_list_languages(); return EXIT_OK; }
        if (streq(a, "--handcoded") == 1) {
            handcoded = 1;
            i = i + 1;
            continue;
        }

        var langv = parse_language_arg(a);
        if (langv != 0) {
            lang_override = langv;
            i = i + 1;
            continue;
        }

        var themev = parse_theme_arg(a);
        if (themev != 0) {
            theme = theme_resolve(themev);
            if (theme < 0) {
                bad_value_error(a, "default, dark, none");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }

        var exportv = parse_export_theme_arg(a);
        if (exportv != 0) {
            # 1.11.1 added `vscode`; 1.12.1 adds `helix` and
            # `iterm`. Selects which theme via the `--theme=`
            # flag if it appeared earlier; otherwise default.
            var which = theme;
            if (which < 0) { which = THEME_DEFAULT; }
            if (streq(exportv, "vscode") == 1) {
                theme_export_vscode(which);
                return EXIT_OK;
            }
            if (streq(exportv, "helix") == 1) {
                theme_export_helix(which);
                return EXIT_OK;
            }
            if (streq(exportv, "iterm") == 1) {
                theme_export_iterm(which);
                return EXIT_OK;
            }
            bad_value_error(a, "vscode, helix, iterm");
            return EXIT_USAGE;
        }

        # First non-flag: treat as a file path. Reject anything else
        # starting with `-` as an unknown option.
        if (load8(a) == 45) {   # `-`
            unknown_option_error(a);
            return EXIT_USAGE;
        }
        if (path == 0) {
            path = a;
            i = i + 1;
            continue;
        }
        # Second positional — too many file args.
        extra_arg_error(a);
        return EXIT_USAGE;
    }

    if (path == 0) {
        print_help();
        return EXIT_OK;
    }

    # Read the source file once, then run detection + tokenization
    # against the same buffer. Lets detect_language_combined sniff
    # bytes (shebang, signature, asm flavour) without a second
    # read.
    var buf = alloc(VYK_SRC_CAP);
    var n = file_read_all(path, buf, VYK_SRC_CAP - 1);
    if (n < 0) {
        io_error(path);
        return EXIT_IO;
    }
    store8(buf + n, 0);

    var lang = lang_override;
    if (lang == 0) { lang = detect_language_combined(path, buf, n); }
    if (lang == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    if (has_grammar(lang) == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }

    return tokenize_buf(buf, n, path, lang, handcoded, theme);
}

var exit_code = main();
syscall(60, exit_code);
