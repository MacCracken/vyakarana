# vyakarana — `vyk` demo entry point
#
# Stdlib auto-included via cyrius.cyml.
#
# Scope:
#   vyk --version
#   vyk --help / -h
#   vyk --list-kinds        prints the ten token kinds
#   vyk --list-languages    prints the bundled grammars (49)
#   vyk <file>              tokenize a file, NDJSON on stdout
#   vyk --language=<lang>   override detection (any listed grammar)
#   vyk --theme=<name>      ANSI-coloured source; control bytes in the
#                           source are escaped (`_tty_print_safe`)
#   vyk --export-theme=<f>  emit a theme file and exit
#   vyk --handcoded         shell only: the M1 hand-coded oracle

include "src/token.cyr"
include "src/grammar.cyr"
include "src/tokenize.cyr"
include "src/detect.cyr"
include "src/out.cyr"
include "src/theme.cyr"
include "src/theme_export.cyr"
include "src/version_str.cyr"

# Exit codes per design spec §9
var EXIT_OK           = 0;
var EXIT_GRAMMAR_FAIL = 1;
var EXIT_USAGE        = 2;
var EXIT_IO           = 3;
var EXIT_NO_GRAMMAR   = 4;

# Source-buffer cap for `vyk <file>`. The CLI slurps the whole
# file into one buffer, so this is a hard ceiling on what `vyk`
# will tokenize.
#
# It is NOT a library limit: `tokenize_stream_*` has no 1 MiB
# ceiling — VYK_STREAM_CAP bounds the undrained window, and total
# input stops at 4 GiB - 1 (VYK_OFFSET_CAP, ADR 0021) — so
# consumers are unaffected. Routing the CLI through the stream
# would lift this — tracked in CHANGELOG 2.3.4 §Notes, not done
# here because detection and themed output both want the whole
# buffer addressable.
#
# Exceeding it is a hard error, never a silent truncation: through
# 2.3.3 `vyk` on a 1.5 MB file exited 0 with ~450 KB dropped and
# nothing on stderr. The largest file `vyk` accepts is therefore
# VYK_SRC_CAP - 2 = 1,048,574 bytes: `file_read_all` stops at
# `maxlen`, so a read of exactly `maxlen` cannot be told apart
# from a truncated one and is refused too.
var VYK_SRC_CAP = 1048576;

fn print_version() {
    out_line(VYK_VERSION);
    return 0;
}

fn print_help() {
    out_line("vyk — vyakarana source-code tokenizer (demo CLI)");
    out_line("");
    out_line("Usage: vyk [OPTIONS] [--] [FILE | -]");
    out_line("");
    out_line("Tokenize FILE and print one NDJSON record per token, or");
    out_line("emit ANSI-coloured source bytes when --theme= is set.");
    out_line("FILE `-` reads standard input. Without FILE, prints this help.");
    out_line("");
    out_line("Options:");
    out_line("  -h, --help             Print this help and exit");
    out_line("  -V, --version          Print version and exit");
    out_line("      --list-kinds       Print the ten token kinds and exit");
    out_line("      --list-languages   Print loaded grammars and exit");
    out_line("      --language=<lang>  Override extension/content detection");
    out_line("                         (run --list-languages for valid names)");
    out_line("      --theme=<name>     Render ANSI-coloured source instead");
    out_line("                         of NDJSON. Names: default, dark, none.");
    out_line("                         See docs/architecture/004-theme-palette-contract.md.");
    out_line("      --export-theme=<format>  Emit a theme file for the named");
    out_line("                         editor format and exit. Formats:");
    out_line("                         vscode (theme.json), helix (theme.toml),");
    out_line("                         iterm (.itermcolors plist).");
    out_line("                         Pair with --theme=<name> (either side)");
    out_line("                         to pick the palette (default: default).");
    out_line("                         Takes no FILE.");
    out_line("      --handcoded        Use the M1 hand-coded shell oracle");
    out_line("                         (regression diagnostic; shell only)");
    out_line("      --                 End of options; later args are FILEs");
    out_line("");
    out_line("Exit codes:");
    out_line("  0  success");
    out_line("  1  tokenization produced an `error` token kind");
    out_line("  2  bad usage: unknown option, missing or invalid value, extra FILE");
    out_line("  3  I/O error: cannot read FILE (or it is over 1 MiB),");
    out_line("     or cannot write output");
    out_line("  4  no grammar matched FILE");
    out_line("");
    out_line("Examples:");
    out_line("  vyk script.sh                    # NDJSON tokens to stdout");
    out_line("  vyk --theme=dark file.rs         # ANSI-coloured render");
    out_line("  vyk --language=python script     # extensionless file");
    out_line("  git show HEAD:a.py | vyk --language=python -   # stdin");
    out_line("  vyk --export-theme=vscode > theme.json   # editor theme");
    out_line("  vyk --list-languages | grep ml   # discover grammar names");
    out_line("");
    out_line("NDJSON output shape:");
    out_line("  {\"kind\":\"keyword\",\"start\":0,\"len\":2}");
    out_line("  Kinds: ident, keyword, string, number, comment,");
    out_line("         operator, punctuation, whitespace,");
    out_line("         preprocessor, error.");
    return 0;
}

fn print_list_kinds() {
    var i = 0;
    while (i < TK_COUNT) {
        out_line(kind_name(i));
        i = i + 1;
    }
    return 0;
}

fn print_list_languages() {
    # Enumerate loaded grammars via the registry (src/grammar.cyr).
    # bootstrap_grammars ensures the bundled grammars are loaded —
    # this path doesn't go through tokenize_stream_new / has_grammar
    # so it needs to trigger the load explicitly.
    bootstrap_grammars();
    var names = vec_new();
    list_languages_into(names);
    var n = vec_len(names);
    var i = 0;
    # vec_get is `: i64`-typed as of cyrius 6.0.x, so an unannotated
    # `println(vec_get(...))` dispatches to println_int and prints the
    # pointer. Bind through a `: cstring` local to land on the string
    # overload. (Was masked pre-2.2.2 by the vendored 5.10.5 stdlib,
    # whose vec_get was untyped.)
    var name: cstring = 0;
    while (i < n) {
        name = vec_get(names, i);
        out_line(name);
        i = i + 1;
    }
    return 0;
}

# Terminal-safety classifier for one byte unit of `src[p..n)`.
# Returns `(len << 1) | unsafe`: `len` (1..4) is how many bytes the
# unit spans, `unsafe` is 1 when a terminal would act on it rather
# than print it. Unsafe: C0 controls other than TAB / LF, a CR not
# followed by LF (a bare CR rewrites the line; CRLF stays intact),
# DEL, and C1 controls in either form — UTF-8 `C2 80`..`C2 9F`
# (U+0080..U+009F; xterm-class terminals act on them) or a stray
# raw byte 0x80..0x9F (CSI 0x9B in 8-bit mode). A valid multi-byte
# UTF-8 sequence is one safe unit, so continuation bytes in
# 0x80..0x9F (`€` is E2 82 AC) are never mistaken for C1. Overlong
# E0 / F0 forms are not treated as sequences, so an overlong C1
# falls apart into stray bytes and is caught. 2.5.2 audit P1-1.
fn _tty_unit(src, n, p) {
    var b = load8(src + p);
    if (b < 128) {
        if ((b == 9) || (b == 10)) { return 2; }
        if (b == 13) {
            if ((p + 1 < n) && (load8(src + p + 1) == 10)) { return 2; }
            return 3;
        }
        if ((b < 32) || (b == 127)) { return 3; }
        return 2;
    }
    var need = 0;
    if ((b >= 194) && (b <= 223)) { need = 1; }
    if ((b >= 224) && (b <= 239)) { need = 2; }
    if ((b >= 240) && (b <= 244)) { need = 3; }
    if (need == 0) {
        # Stray continuation byte or invalid lead (0x80..0xC1, 0xF5..).
        if (b <= 159) { return 3; }
        return 2;
    }
    if (p + need >= n) { return 2; }       # truncated: lead alone
    var k = 1;
    var ok = 1;
    while ((k <= need) && (ok == 1)) {
        var c = load8(src + p + k);
        if ((c < 128) || (c > 191)) { ok = 0; }
        k = k + 1;
    }
    if (ok == 0) { return 2; }
    var c1 = load8(src + p + 1);
    if ((b == 224) && (c1 < 160)) { return 2; }   # overlong 3-byte
    if ((b == 240) && (c1 < 144)) { return 2; }   # overlong 4-byte
    if ((b == 194) && (c1 <= 159)) { return 5; }  # C1 control, 2 bytes
    return (need + 1) * 2;
}

var _tty_hex = "0123456789abcdef";
var _tty_esc_buf = 0;

# Write the visible stand-in for an unsafe unit at `src + p` of
# `len` bytes: caret notation for C0 / DEL (`^[`, `^M`, `^?`), and
# `\xHH` (the code point) for a C1 control. One 4-byte buffer,
# allocated once — the bump allocator never frees, and a file can
# hold a million control bytes.
fn _tty_put_escape(src, p, len) {
    var b = load8(src + p);
    var cp = b;
    if (len == 2) { cp = load8(src + p + 1); }    # C2 xx → U+00xx
    if (_tty_esc_buf == 0) { _tty_esc_buf = alloc(4); }
    var out = _tty_esc_buf;
    if (cp < 32) {
        store8(out, 94); store8(out + 1, cp + 64);
        out_write(out, 2);
        return 0;
    }
    if (cp == 127) {
        store8(out, 94); store8(out + 1, 63);
        out_write(out, 2);
        return 0;
    }
    store8(out, 92); store8(out + 1, 120);
    store8(out + 2, load8(_tty_hex + (cp >> 4)));
    store8(out + 3, load8(_tty_hex + (cp & 15)));
    out_write(out, 4);
    return 0;
}

# Bytes of a unit that ran past the end of the previous token. The
# next token must not re-judge them: a valid UTF-8 tail is written
# unchanged (`_tty_carry_drop == 0`), and the tail of a C1 pair that
# was already escaped is dropped (`== 1`). Reset per render.
var _tty_carry = 0;
var _tty_carry_drop = 0;

# Write `src[s..s+l)` to the terminal, replacing every unsafe unit
# (see `_tty_unit`) with a visible escape. Safe runs go out in one
# `print`. `src_len` lets a UTF-8 sequence that straddles the token
# end be validated against the bytes that follow.
fn _tty_print_safe(src, src_len, s, l) {
    var end = s + l;
    var p = s;
    var run = s;
    if (_tty_carry > 0) {
        var take = _tty_carry;
        if (take > l) { take = l; }
        p = p + take;
        _tty_carry = _tty_carry - take;
        if (_tty_carry_drop == 1) { run = p; }
    }
    while (p < end) {
        var u = _tty_unit(src, src_len, p);
        var ulen = u >> 1;
        if ((u & 1) == 1) {
            if (p > run) { out_write(src + run, p - run); }
            _tty_put_escape(src, p, ulen);
            # A `C2 9B` split across two tokens is escaped once, here;
            # the next token must skip the `9B` it starts with.
            if (p + ulen > end) {
                _tty_carry = p + ulen - end;
                _tty_carry_drop = 1;
            }
            p = p + ulen;
            run = p;
        }
        if ((u & 1) == 0) {
            if (p + ulen > end) {
                _tty_carry = p + ulen - end;
                _tty_carry_drop = 0;
            }
            p = p + ulen;
        }
    }
    if (p > end) { p = end; }
    if (p > run) { out_write(src + run, p - run); }
    return 0;
}

# Sanitize an externally-supplied cstr for echo on stderr: replace
# bytes < 0x20 (including the 0x1B ESC that anchors every ANSI
# escape sequence) and 0x7F DEL with `?`, and — since 2.5.2 — C1
# controls in either form (`C2 80`..`C2 9F`, or a stray raw
# 0x80..0x9F) too, judged by `_tty_unit` so valid UTF-8 paths still
# echo legibly. See docs/audit/2026-04-23-audit.md FINDING-006 and
# the 2.5.2 audit P2-2.
fn _sanitize_for_stderr(s) {
    var n = strlen(s);
    var out = alloc(n + 1);
    var i = 0;
    var o = 0;
    while (i < n) {
        var b = load8(s + i);
        var step = 1;
        var bad = 0;
        if ((b < 32) || (b == 127)) { bad = 1; }   # every C0 + DEL
        if (b >= 128) {
            var u = _tty_unit(s, n, i);
            step = u >> 1;
            bad = u & 1;
        }
        if (bad == 1) {
            store8(out + o, 63);
            o = o + 1;
        }
        if (bad == 0) {
            memcpy(out + o, s + i, step);
            o = o + step;
        }
        i = i + step;
    }
    store8(out + o, 0);
    return out;
}

# Error functions split by failure class (1.13.1; the list was
# missing the 2.3.4 and 2.6.1 additions until the 2.6.x audit):
#   - unknown_option_error(flag)        — `--bogus` style
#   - missing_value_error(flag)         — `--language=` with nothing after
#   - bad_value_error(flag, allowed)    — `--theme=nope`
#   - usage_error(msg)                  — any other bad combination
#   - extra_arg_error(arg)              — second positional file
#   - io_error(path) / stdin_error()    — the input could not be read
#   - too_large_error(path)             — input over VYK_SRC_CAP
#   - no_grammar_error(path)            — extension/content didn't match
# Each one tells the user *what* the problem is and *what* to do
# next. The `try --help` reference is consistent across all.

fn unknown_option_error(flag) {
    var msg1 = "vyk: unknown option: ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(flag);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: try --help for a list of options\n";
    eprint(msg2, strlen(msg2));
    return 0;
}

# `flag` is the offending argv (e.g. `--theme=nope`); `allowed`
# is a comma-separated list of valid values for the user to
# scan ("default, dark, none").
fn bad_value_error(flag, allowed) {
    var msg1 = "vyk: invalid value for ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(flag);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: allowed values: ";
    eprint(msg2, strlen(msg2));
    eprint(allowed, strlen(allowed));
    eprint("\n", 1);
    return 0;
}

# `--language=` / `--theme=` / `--export-theme=` with nothing after the
# `=`. Through 2.6.0 these fell through to "unknown option" (2.6.1).
fn missing_value_error(flag) {
    var m1 = "vyk: missing value for ";
    eprint(m1, strlen(m1));
    eprint(flag, strlen(flag));
    var m2 = "\nvyk: try --help for the accepted values\n";
    eprint(m2, strlen(m2));
    return 0;
}

# A usage error with a fixed message (2.6.1).
fn usage_error(msg) {
    eprint(msg, strlen(msg));
    var m2 = "vyk: try --help\n";
    eprint(m2, strlen(m2));
    return 0;
}

fn extra_arg_error(arg) {
    var msg1 = "vyk: extra argument: ";
    eprint(msg1, strlen(msg1));
    var safe = _sanitize_for_stderr(arg);
    eprint(safe, strlen(safe));
    eprint("\n", 1);
    var msg2 = "vyk: only one FILE may be given (try --help)\n";
    eprint(msg2, strlen(msg2));
    return 0;
}

fn io_error(path) {
    var m1 = "vyk: cannot read ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = ": file not found or not readable\n";
    eprint(m2, strlen(m2));
    return 0;
}

# `-` could not be read: stdin closed (`<&-`), a directory, EIO.
fn stdin_error() {
    var m = "vyk: cannot read standard input\n";
    eprint(m, strlen(m));
    return 0;
}

fn no_grammar_error(path) {
    var m1 = "vyk: no grammar matched for ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = "\nvyk: try --language=<name> (run --list-languages to see all)\n";
    eprint(m2, strlen(m2));
    return 0;
}

# `vyk` slurps the source into one VYK_SRC_CAP buffer. A file at
# or over the cap would tokenize only its prefix, and every
# consumer contract we publish — the coverage invariant above
# all — silently stops holding at the cut point. Refuse loudly
# instead. Exit code is EXIT_IO: the read is what failed.
fn too_large_error(path) {
    var m1 = "vyk: file too large: ";
    eprint(m1, strlen(m1));
    var safe = _sanitize_for_stderr(path);
    eprint(safe, strlen(safe));
    var m2 = "\nvyk: the CLI tokenizes at most 1048574 bytes in one buffer\n";
    eprint(m2, strlen(m2));
    var m3 = "vyk: (the tokenize_stream_* library API has no such limit)\n";
    eprint(m3, strlen(m3));
    return 0;
}

# Emit ANSI-themed source bytes per the chosen theme (see
# src/theme.cyr). Walks the tokenbuf in order; for each token,
# writes the theme's ANSI prefix (if non-empty), then the source
# bytes from `[start, start+len)` through `_tty_print_safe`, then
# the reset escape. The source is untrusted: through 2.5.1 its
# bytes went out raw, so a file holding `ESC ] 0 ; … BEL` retitled
# the window and `ESC [ 2 J` cleared the screen, under every theme
# including `none` (2.5.2 audit P1-1). Control bytes now render as
# visible escapes (`^[`, `\x9b`); every other byte is unchanged.
# Returns 1 if any TK_ERROR token was emitted, else 0 — same
# convention as emit_ndjson so the exit-code path is shared.
fn emit_themed(tb, src, src_len, theme) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var reset = theme_reset();
    var rlen = strlen(reset);
    _tty_carry = 0;
    _tty_carry_drop = 0;
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var color = theme_color(theme, k);
        var clen = strlen(color);
        if (clen > 0) {
            out_write(color, clen);
        }
        _tty_print_safe(src, src_len, s, l);
        if (clen > 0) {
            out_write(reset, rlen);
        }
        i = i + 1;
    }
    return any_error;
}

# Emit one NDJSON line per token. Returns 1 if any TK_ERROR token
# was emitted, else 0.
fn emit_ndjson(tb) {
    var count = tokenbuf_count(tb);
    var i = 0;
    var any_error = 0;
    var s_open  = "{\"kind\":\"";
    var s_mid1  = "\",\"start\":";
    var s_mid2  = ",\"len\":";
    var s_close = "}\n";
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var s = tokenbuf_start(tb, i);
        var l = tokenbuf_len(tb, i);
        if (k == TK_ERROR) { any_error = 1; }
        var name = kind_name(k);
        out_write(s_open, strlen(s_open));
        out_write(name, strlen(name));
        out_write(s_mid1, strlen(s_mid1));
        out_num(s);
        out_write(s_mid2, strlen(s_mid2));
        out_num(l);
        out_write(s_close, strlen(s_close));
        i = i + 1;
    }
    return any_error;
}

# Tokenize with the given language and emit either
# NDJSON (default) or ANSI-themed source bytes (when `theme >=
# 0`). Returns an exit code. `handcoded = 1` routes through the
# M1 oracle path (see src/tokenize.cyr) for the M2 regression
# diff.
#
# `theme` is the theme tag from `theme_resolve()`, or -1 if
# `--theme=` was not passed (NDJSON output).
# Tokenize an already-read buffer. `buf` is a NUL-terminated cstr;
# `n` is its length. Detection happens upstream so the same buffer
# can be sniffed and tokenized without a second file read (1.11.2).
fn tokenize_buf(buf, n, path, lang, handcoded, theme) {
    var tb = 0;
    if (handcoded == 1) {
        tb = _vyk_handcoded(buf, n, lang);
    }
    if (handcoded != 1) {
        # 2.0+ streaming entry: feed the whole buffer in one shot
        # then finish. The CLI's pre-read flow always has the full
        # source available, so a single feed() is the natural use.
        var s = tokenize_stream_new(lang);
        if (s != 0) {
            tb = tokenbuf_new();
            tokenize_stream_feed(s, buf, n);
            tokenize_stream_finish(s, tb);
            tokenize_stream_free(s);
        }
    }
    if (tb == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    var had_error = 0;
    if (theme >= 0) {
        had_error = emit_themed(tb, buf, n, theme);
    } else {
        had_error = emit_ndjson(tb);
    }
    if (had_error == 1) { return EXIT_GRAMMAR_FAIL; }
    return EXIT_OK;
}

# `a` starts with `prefix`: the value after it (possibly empty — check
# `load8(v) == 0`). Otherwise 0. Replaces 2.6.0's `parse_*_arg` trio,
# which treated an empty value as "not this flag" — so `--language=`
# fell through to "unknown option" (2.6.1).
fn _flag_value(a, prefix) {
    var plen = strlen(prefix);
    if (strlen(a) < plen) { return 0; }
    if (memeq(a, prefix, plen) == 0) { return 0; }
    return a + plen;
}

# Read all of stdin into `buf` (at most `cap` bytes). Returns the byte
# count, or -1 on a read error. Same contract as `file_read_all`: a
# result of `cap` means "possibly more", which the caller refuses as too
# large (2.6.1: `vyk -` reads stdin).
fn _read_stdin(buf, cap) {
    var n = 0;
    var done = 0;
    while ((n < cap) && (done == 0)) {
        var r = syscall(0, 0, buf + n, cap - n);
        if (r > 0) { n = n + r; }
        if (r == 0) { done = 1; }
        if ((r < 0) && (r != (0 - 4))) { return (0 - 1); }   # -4: EINTR, retry
    }
    return n;
}

fn main() {
    alloc_init();
    args_init();

    var ac = argc();
    if (ac < 2) {
        print_help();
        return EXIT_OK;
    }

    # One pass over argv: an optional --language= override, an
    # optional --handcoded flag (regression oracle — see
    # src/tokenize.cyr), --theme= / --export-theme=, and at most one
    # FILE (a second is a usage error). Flags may appear in any order;
    # `--` ends them. (This said "two-pass … the first non-flag arg"
    # through 2.6.1.)
    var lang_override = 0;
    var path = 0;
    var handcoded = 0;
    # theme = -1 means "no --theme passed; emit NDJSON". 0 / 1 / 2
    # are valid theme tags from theme_resolve().
    var theme = 0 - 1;

    # `--export-theme=` is applied after the whole argv is read, so
    # `--theme=` works on either side of it (through 2.6.0 only an
    # EARLIER `--theme=` counted: `--export-theme=vscode --theme=dark`
    # exported `default`). 0 = no export; 1 vscode, 2 helix, 3 iterm.
    var export_fmt = 0;
    var opts_done = 0;   # set by `--`: every later arg is a FILE

    var i = 1;
    while (i < ac) {
        var a = argv(i);
        var handled = 0;
        if (opts_done == 0) {
            if (streq(a, "-h") == 1) { print_help(); return EXIT_OK; }
            if (streq(a, "--help") == 1) { print_help(); return EXIT_OK; }
            if (streq(a, "-V") == 1) { print_version(); return EXIT_OK; }
            if (streq(a, "--version") == 1) { print_version(); return EXIT_OK; }
            if (streq(a, "--list-kinds") == 1) { print_list_kinds(); return EXIT_OK; }
            if (streq(a, "--list-languages") == 1) { print_list_languages(); return EXIT_OK; }
            if (streq(a, "--") == 1) { opts_done = 1; handled = 1; }
            if (streq(a, "--handcoded") == 1) { handcoded = 1; handled = 1; }
        }

        if ((opts_done == 0) && (handled == 0)) {
            var langv = _flag_value(a, "--language=");
            if (langv != 0) {
                if (load8(langv) == 0) {
                    missing_value_error("--language=");
                    return EXIT_USAGE;
                }
                # Validate now: an unknown name is a usage error (2), not
                # "no grammar matched FILE" (4) — 2.6.1.
                if (has_grammar(langv) == 0) {
                    bad_value_error(a, "any name from --list-languages");
                    return EXIT_USAGE;
                }
                lang_override = langv;
                handled = 1;
            }
        }

        if ((opts_done == 0) && (handled == 0)) {
            var themev = _flag_value(a, "--theme=");
            if (themev != 0) {
                if (load8(themev) == 0) {
                    missing_value_error("--theme=");
                    return EXIT_USAGE;
                }
                theme = theme_resolve(themev);
                if (theme < 0) {
                    bad_value_error(a, "default, dark, none");
                    return EXIT_USAGE;
                }
                handled = 1;
            }
        }

        if ((opts_done == 0) && (handled == 0)) {
            var exportv = _flag_value(a, "--export-theme=");
            if (exportv != 0) {
                if (load8(exportv) == 0) {
                    missing_value_error("--export-theme=");
                    return EXIT_USAGE;
                }
                # 1.11.1 added `vscode`; 1.12.1 `helix` and `iterm`.
                export_fmt = 0;
                if (streq(exportv, "vscode") == 1) { export_fmt = 1; }
                if (streq(exportv, "helix") == 1)  { export_fmt = 2; }
                if (streq(exportv, "iterm") == 1)  { export_fmt = 3; }
                if (export_fmt == 0) {
                    bad_value_error(a, "vscode, helix, iterm");
                    return EXIT_USAGE;
                }
                handled = 1;
            }
        }

        if ((opts_done == 0) && (handled == 0)) {
            # `--language shell` — a space instead of `=`. Name the form
            # that is wanted instead of "unknown option" (2.6.x audit).
            if (streq(a, "--language") == 1) { missing_value_error("--language="); return EXIT_USAGE; }
            if (streq(a, "--theme") == 1) { missing_value_error("--theme="); return EXIT_USAGE; }
            if (streq(a, "--export-theme") == 1) { missing_value_error("--export-theme="); return EXIT_USAGE; }
        }

        if (handled == 0) {
            # Not a known flag. Before `--`, anything else starting with
            # `-` is an unknown option — except `-` alone, which is
            # standard input (2.6.1).
            if ((opts_done == 0) && (load8(a) == 45) && (streq(a, "-") == 0)) {
                unknown_option_error(a);
                return EXIT_USAGE;
            }
            if (path != 0) {
                # Second positional — too many file args.
                extra_arg_error(a);
                return EXIT_USAGE;
            }
            path = a;
        }
        i = i + 1;
    }

    if (export_fmt != 0) {
        if (path != 0) {
            usage_error("vyk: --export-theme writes a theme file and takes no FILE\n");
            return EXIT_USAGE;
        }
        var which = theme;
        if (which < 0) { which = THEME_DEFAULT; }
        if (export_fmt == 1) { theme_export_vscode(which); }
        if (export_fmt == 2) { theme_export_helix(which); }
        if (export_fmt == 3) { theme_export_iterm(which); }
        return EXIT_OK;
    }

    if (path == 0) {
        print_help();
        return EXIT_OK;
    }

    # Read the source file once, then run detection + tokenization
    # against the same buffer. Lets detect_language_combined sniff
    # bytes (shebang, signature, asm flavour) without a second
    # read.
    var buf = alloc(VYK_SRC_CAP);
    if (buf == 0) {
        io_error(path);
        return EXIT_IO;
    }
    var n = 0;
    # `-` is standard input; messages call it `<stdin>`, and detection
    # falls to the content sniff (no extension to go on). The flag, not
    # the name, decides how to read: 2.6.1 tested the name, so a real
    # file called `<stdin>` was never read — exit 0, no tokens (2.6.x
    # audit).
    var is_stdin = 0;
    if (streq(path, "-") == 1) {
        is_stdin = 1;
        path = "<stdin>";
        n = _read_stdin(buf, VYK_SRC_CAP - 1);
    }
    if (is_stdin == 0) { n = file_read_all(path, buf, VYK_SRC_CAP - 1); }
    if (n < 0) {
        if (is_stdin == 1) { stdin_error(); }
        if (is_stdin == 0) { io_error(path); }
        return EXIT_IO;
    }
    # `file_read_all` stops once it has filled `maxlen`, so hitting
    # the cap exactly is indistinguishable from "there was more".
    # Treat both as too-large rather than emitting a prefix that
    # violates the coverage invariant without saying so.
    if (n >= VYK_SRC_CAP - 1) {
        too_large_error(path);
        return EXIT_IO;
    }
    store8(buf + n, 0);

    var lang = lang_override;
    if (lang == 0) { lang = detect_language_combined(path, buf, n); }
    if (lang == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    if (has_grammar(lang) == 0) {
        no_grammar_error(path);
        return EXIT_NO_GRAMMAR;
    }
    # The hand-coded oracle is shell-only. Through 2.6.0 any other
    # language reported "no grammar matched", which was untrue (2.6.1).
    if ((handcoded == 1) && (streq(lang, "shell") == 0)) {
        var hc_msg = "vyk: --handcoded is the shell oracle; the file is not shell";
        eprint(hc_msg, strlen(hc_msg));
        usage_error(" (pass --language=shell to force it)\n");
        return EXIT_USAGE;
    }

    return tokenize_buf(buf, n, path, lang, handcoded, theme);
}

# Flush buffered stdout and report a write failure (2.6.1, src/out.cyr):
# a run whose output did not reach its destination exits 3, whatever
# else it would have returned.
fn _vyk_exit(rc) {
    out_flush();
    if (out_failed() == 1) {
        var m = "vyk: write error on standard output\n";
        eprint(m, strlen(m));
        return EXIT_IO;
    }
    return rc;
}

var exit_code = _vyk_exit(main());
syscall(60, exit_code);
