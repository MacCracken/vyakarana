# vyakarana — language detection (path-based + content-based)
#
# Four entry points:
#
#   detect_language(path)
#       Pure path dispatch — extension and basename matching.
#       Returns a language name (string literal) or 0. Same shape
#       as the function that lived in `src/main.cyr` through 1.11.1.
#
#   detect_language_from_content(src, src_len)
#       Pure content sniff — UTF-8 BOM strip, shebang interp
#       lookup, signature peek (`<?xml`, `<!DOCTYPE html>`).
#       Returns a language name or 0. Used by extensionless files
#       and by consumers that have bytes but no path.
#
#   detect_language_registered(path, src, src_len)        (2.9.8)
#       Routes by the registry's DECLARED `extensions`, `filenames`
#       and `shebangs` — so a consumer's own grammars route too —
#       ties to the first registered. Not pure: it reads the registry
#       and bootstraps the bundled grammars. ADR 0031; at the bottom
#       of this file.
#
#   detect_language_combined(path, src, src_len)
#       Path first; if path resolves to a known-ambiguous name
#       (`asm_x86_64` from a `.s`/`.S` extension, `nasm` from `.asm`
#       since 2.9.9) the content sniff picks the actual flavor. If path returns 0,
#       falls through to the content sniff. Returns a language
#       name or 0. This is what `vyk` uses on the CLI.
#
# Public surface for downstream consumers (1.11.2+). Bundled in
# `dist/vyakarana.cyr` via `[lib] modules`. See ADR 0015 for the
# scope of what counts as "content sniffing" — deliberately narrow
# (a few well-known signatures + the asm flavor split). Anything
# heavier (Yara-style fingerprinting, full lexical voting) is out.
#
# Routing is compiled here, and each grammar DECLARES its routes:
# `extensions`, `filenames` and `shebangs` in its `[grammar]`
# table (ADR 0025). Both must change together — tests/vyakarana.tcyr
# checks every declared entry routes to its grammar, and
# scripts/check-detect.sh (run by smoke) checks every path and
# interpreter route in this file is declared, that each `memeq`
# length matches its literal, and that the read is guarded (`n >=` /
# `wlen >=`). Keep route lines in the one-line
# `memeq(...) == 1) { return "lang"; }` / `_detect_fname(...)` shape:
# the check reports any other line that could be a route as
# unrecognised. The content sniff (`_detect_signature`, the asm vote)
# is ADR 0015's and declares nothing.
# (Through 2.6.1 the arrays were documentation only and had drifted:
# nine entries never routed, six routes were undeclared.)

include "src/token.cyr"
# The registry and `bootstrap_grammars`, for `detect_language_registered`
# (2.9.8); the compiled functions use neither.
include "src/tokenize.cyr"

# ── Path dispatch ───────────────────────────
# Extension and basename matching. Pure cstr suffix tests; no I/O.

# Length-bucketed helpers — Cyrius caps each function at 64
# returns; splitting by suffix length keeps every helper well
# under the cap while preserving first-match-wins ordering.
# The dispatcher in `detect_language` calls them in length order
# matching the original sequence (longest extensions first
# would alter behaviour for `.markdown` vs `.md`, etc.).

fn _detect_short(path, n) {
    if (n >= 3) {
        if (memeq(path + n - 3, ".sh", 3) == 1) { return "shell"; }
    }
    if (n >= 2) {
        if (memeq(path + n - 2, ".c", 2) == 1) { return "c"; }
        if (memeq(path + n - 2, ".h", 2) == 1) { return "c"; }
        # `.s` / `.S` ambiguous between asm_x86_64 and asm_aarch64.
        # `detect_language_combined` resolves the ambiguity via
        # content sniff. Path-only callers default to x86_64.
        if (memeq(path + n - 2, ".s", 2) == 1) { return "asm_x86_64"; }
        if (memeq(path + n - 2, ".S", 2) == 1) { return "asm_x86_64"; }
    }
    if (n >= 3) {
        if (memeq(path + n - 3, ".hs", 3) == 1) { return "haskell"; }
        if (memeq(path + n - 3, ".ll", 3) == 1) { return "llvm_ir"; }
        if (memeq(path + n - 3, ".rs", 3) == 1) { return "rust"; }
        if (memeq(path + n - 3, ".md", 3) == 1) { return "markdown"; }
        if (memeq(path + n - 3, ".ts", 3) == 1) { return "typescript"; }
        if (memeq(path + n - 3, ".js", 3) == 1) { return "javascript"; }
        if (memeq(path + n - 3, ".py", 3) == 1) { return "python"; }
        if (memeq(path + n - 3, ".go", 3) == 1) { return "go"; }
        if (memeq(path + n - 3, ".kt", 3) == 1) { return "kotlin"; }
        if (memeq(path + n - 3, ".cs", 3) == 1) { return "csharp"; }
        if (memeq(path + n - 3, ".cc", 3) == 1) { return "cpp"; }
        if (memeq(path + n - 3, ".rb", 3) == 1) { return "ruby"; }
        if (memeq(path + n - 3, ".ex", 3) == 1) { return "elixir"; }
        if (memeq(path + n - 3, ".ml", 3) == 1) { return "ocaml"; }
        if (memeq(path + n - 3, ".hh", 3) == 1) { return "cpp"; }
        if (memeq(path + n - 3, ".mk", 3) == 1) { return "makefile"; }
    }
    return 0;
}

fn _detect_4byte(path, n) {
    if (n >= 4) {
        # `.zsh` — shebang detection knew `zsh`, the path table did not,
        # so zsh dotfiles and completion scripts (no shebang) exited 4
        # "no grammar matched" through 2.5.1 (2.5.2 audit P3-b: 6 of 6
        # `.zsh` files in the real-file sweep).
        if (memeq(path + n - 4, ".zsh", 4) == 1) { return "shell"; }
        if (memeq(path + n - 4, ".exs", 4) == 1) { return "elixir"; }
        if (memeq(path + n - 4, ".mli", 4) == 1) { return "ocaml"; }
        if (memeq(path + n - 4, ".lhs", 4) == 1) { return "haskell"; }
        if (memeq(path + n - 4, ".nix", 4) == 1) { return "nix"; }
        if (memeq(path + n - 4, ".hcl", 4) == 1) { return "terraform"; }
        if (memeq(path + n - 4, ".htm", 4) == 1) { return "html"; }
        # `.asm` is NASM's again (2.9.9) — MASM and armasm share it, and
        # `detect_language_combined` votes GAS back to the asm grammars.
        if (memeq(path + n - 4, ".asm", 4) == 1) { return "nasm"; }
        if (memeq(path + n - 4, ".mdx", 4) == 1) { return "mdx"; }
        if (memeq(path + n - 4, ".css", 4) == 1) { return "css"; }
        if (memeq(path + n - 4, ".ini", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".cfg", 4) == 1) { return "ini"; }
        if (memeq(path + n - 4, ".xml", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsl", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".xsd", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".svg", 4) == 1) { return "xml"; }
        if (memeq(path + n - 4, ".sql", 4) == 1) { return "sql"; }
        if (memeq(path + n - 4, ".gql", 4) == 1) { return "graphql"; }
        if (memeq(path + n - 4, ".mjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cjs", 4) == 1) { return "javascript"; }
        if (memeq(path + n - 4, ".cpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".cxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hpp", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".hxx", 4) == 1) { return "cpp"; }
        if (memeq(path + n - 4, ".kts", 4) == 1) { return "kotlin"; }
        if (memeq(path + n - 4, ".php", 4) == 1) { return "php"; }
        if (memeq(path + n - 4, ".lua", 4) == 1) { return "lua"; }
        if (memeq(path + n - 4, ".yml", 4) == 1) { return "yaml"; }
        if (memeq(path + n - 4, ".cyr", 4) == 1) { return "cyrius"; }
        if (memeq(path + n - 4, ".zig", 4) == 1) { return "zig"; }
        if (memeq(path + n - 4, ".ps1", 4) == 1) { return "powershell"; }
        if (memeq(path + n - 4, ".vue", 4) == 1) { return "vue"; }
        if (memeq(path + n - 4, ".csx", 4) == 1) { return "csharp"; }
    }
    if (n >= 3) {
        if (memeq(path + n - 3, ".cr", 3) == 1) { return "crystal"; }
        if (memeq(path + n - 3, ".jl", 3) == 1) { return "julia"; }
        if (memeq(path + n - 3, ".tf", 3) == 1) { return "terraform"; }
    }
    return 0;
}

fn _detect_5plus(path, n) {
    if (n >= 5) {
        if (memeq(path + n - 5, ".html", 5) == 1) { return "html"; }
        if (memeq(path + n - 5, ".nasm", 5) == 1) { return "nasm"; }
        if (memeq(path + n - 5, ".lean", 5) == 1) { return "lean"; }
        if (memeq(path + n - 5, ".scss", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".sass", 5) == 1) { return "scss"; }
        if (memeq(path + n - 5, ".conf", 5) == 1) { return "ini"; }
        if (memeq(path + n - 5, ".bash", 5) == 1) { return "shell"; }
        if (memeq(path + n - 5, ".toml", 5) == 1) { return "toml"; }
        if (memeq(path + n - 5, ".json", 5) == 1) { return "json"; }
        if (memeq(path + n - 5, ".java", 5) == 1) { return "java"; }
        if (memeq(path + n - 5, ".cyml", 5) == 1) { return "cyml"; }
        if (memeq(path + n - 5, ".yaml", 5) == 1) { return "yaml"; }
        if (memeq(path + n - 5, ".psm1", 5) == 1) { return "powershell"; }
        if (memeq(path + n - 5, ".psd1", 5) == 1) { return "powershell"; }
        if (memeq(path + n - 5, ".qasm", 5) == 1) { return "openqasm"; }
    }
    if (n >= 6) {
        if (memeq(path + n - 6, ".swift", 6) == 1) { return "swift"; }
        if (memeq(path + n - 6, ".proto", 6) == 1) { return "protobuf"; }
        if (memeq(path + n - 6, ".phtml", 6) == 1) { return "php"; }
    }
    if (n >= 7) {
        if (memeq(path + n - 7, ".svelte", 7) == 1) { return "svelte"; }
        if (memeq(path + n - 7, ".tfvars", 7) == 1) { return "terraform"; }
    }
    if (n >= 8) {
        if (memeq(path + n - 8, ".graphql", 8) == 1) { return "graphql"; }
    }
    if (n >= 9) {
        if (memeq(path + n - 9, ".markdown", 9) == 1) { return "markdown"; }
    }
    if (n >= 11) {
        if (memeq(path + n - 11, ".properties", 11) == 1) { return "ini"; }
    }
    return 0;
}

# A grammar `filenames` entry `name` matches (ADR 0025):
#   - a path that ends in it, where it starts the path or follows `/`,
#     `.`, `-` or `_` (`Dockerfile`, `ci/app.Dockerfile`,
#     `prod-Dockerfile`). Through 2.9.0 any ending matched, so
#     `notaMakefile` was a makefile;
#   - a basename `name.` + a suffix that starts with a letter and whose
#     last dot component is not a tool's (`_detect_tool_suffix`):
#     `Dockerfile.dev`, `Makefile.am`, `Makefile.in.in`, `Makefile.orig`
#     — but not `Dockerfile.5.gz` (a man page), `Makefile.rej`,
#     `Dockerfile.dockerignore` or `Makefile.cmake`. 2.6.2 took any
#     suffix; on one machine that misrouted 3 of 124 files (2.9.1 audit).
# Only reached when no extension matched, so `Makefile.py` is python.
fn _detect_fname(path, n, name) {
    var nl = strlen(name);
    if (n >= nl) {
        if (memeq(path + n - nl, name, nl) == 1) {
            if (n == nl) { return 1; }
            var pb = load8(path + n - nl - 1);
            if ((pb == 47) || (pb == 46) || (pb == 45) || (pb == 95)) { return 1; }
        }
    }
    var b = n;
    var looking = 1;
    while ((b > 0) && (looking == 1)) {
        if (load8(path + b - 1) == 47) { looking = 0; }   # '/'
        if (looking == 1) { b = b - 1; }
    }
    if (b + nl + 1 >= n) { return 0; }
    if (memeq(path + b, name, nl) == 0) { return 0; }
    if (load8(path + b + nl) != 46) { return 0; }         # '.'
    var c = load8(path + b + nl + 1) | 32;                # ASCII lower
    if ((c < 97) || (c > 122)) { return 0; }              # `.5`, `.1`, `._x`
    var d = n;
    while (load8(path + d - 1) != 46) { d = d - 1; }      # stops at b + nl + 1
    if (_detect_tool_suffix(path + d, n - d) == 1) { return 0; }
    return 1;
}

# 1 if the `len` bytes at `s` (no dot) name a compressed, patch or tool
# file rather than a variant of a build file, ignoring ASCII case.
fn _detect_tool_suffix(s, len) {
    if (_detect_ieq(s, len, "gz") == 1) { return 1; }
    if (_detect_ieq(s, len, "bz2") == 1) { return 1; }
    if (_detect_ieq(s, len, "xz") == 1) { return 1; }
    if (_detect_ieq(s, len, "zst") == 1) { return 1; }
    if (_detect_ieq(s, len, "lz") == 1) { return 1; }
    if (_detect_ieq(s, len, "lz4") == 1) { return 1; }
    if (_detect_ieq(s, len, "lzma") == 1) { return 1; }
    if (_detect_ieq(s, len, "z") == 1) { return 1; }
    if (_detect_ieq(s, len, "br") == 1) { return 1; }
    if (_detect_ieq(s, len, "zip") == 1) { return 1; }
    if (_detect_ieq(s, len, "7z") == 1) { return 1; }
    if (_detect_ieq(s, len, "tar") == 1) { return 1; }
    if (_detect_ieq(s, len, "tgz") == 1) { return 1; }
    if (_detect_ieq(s, len, "rej") == 1) { return 1; }
    if (_detect_ieq(s, len, "patch") == 1) { return 1; }
    if (_detect_ieq(s, len, "diff") == 1) { return 1; }
    if (_detect_ieq(s, len, "dockerignore") == 1) { return 1; }   # BuildKit's per-Dockerfile ignore file
    if (_detect_ieq(s, len, "cmake") == 1) { return 1; }          # CMake's generated Makefile.cmake
    return 0;
}

# 1 if the `len` bytes at `s` are cstr `w` (lower case), ignoring ASCII case.
fn _detect_ieq(s, len, w) {
    if (len != strlen(w)) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if ((c >= 65) && (c <= 90)) { c = c + 32; }
        if (c != load8(w + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _detect_basename(path, n) {
    if (_detect_fname(path, n, "Dockerfile") == 1) { return "dockerfile"; }
    if (_detect_fname(path, n, "Containerfile") == 1) { return "dockerfile"; }
    if (_detect_fname(path, n, "Makefile") == 1) { return "makefile"; }
    if (_detect_fname(path, n, "makefile") == 1) { return "makefile"; }
    if (_detect_fname(path, n, "GNUmakefile") == 1) { return "makefile"; }
    return 0;
}

fn detect_language(path) {
    # No path: no route — through 2.9.11 a 0 here crashed, though
    # `detect_language_registered` takes one (2.9.12 audit, reviewer D).
    if (path == 0) { return 0; }
    var n = strlen(path);
    var r = _detect_short(path, n);
    if (r != 0) { return r; }
    r = _detect_4byte(path, n);
    if (r != 0) { return r; }
    r = _detect_5plus(path, n);
    if (r != 0) { return r; }
    return _detect_basename(path, n);
}

# ── Content sniffing ────────────────────────
# Pure byte-pattern detection. Caller supplies `src` + `src_len`;
# we never look outside the buffer. Length-bounded prefix checks
# mean the worst case is a fixed scan over the first ~4KB.

# Strip a leading UTF-8 BOM (`EF BB BF`) — return offset of next
# byte. Some editors auto-prepend a BOM; without skipping it we'd
# miss every signature check.
fn _detect_skip_bom(src, src_len) {
    if (src_len < 3) { return 0; }
    if (load8(src) != 239)     { return 0; }   # 0xEF
    if (load8(src + 1) != 187) { return 0; }   # 0xBB
    if (load8(src + 2) != 191) { return 0; }   # 0xBF
    return 3;
}

# True if the bytes at `src + i` start with the cstr `needle`
# (length-bounded by `src_len`).
fn _detect_starts_with(src, src_len, i, needle) {
    var nl = strlen(needle);
    if (i + nl > src_len) { return 0; }
    return memeq(src + i, needle, nl);
}

# Find `needle` in `src[start..src_len]`. Returns offset of first
# match or (0 - 1) if not found. Length-bounded.
fn _detect_index_of(src, src_len, start, needle) {
    var nl = strlen(needle);
    if (nl == 0) { return start; }
    if (start + nl > src_len) { return (0 - 1); }
    var limit = src_len - nl;
    var i = start;
    while (i <= limit) {
        if (memeq(src + i, needle, nl) == 1) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}

# Shebang interp lookup. `src[0..2] == "#!"`. The interpreter is
# the FIRST word of the first line, and within it the basename (the
# part after its last '/'): `#!/usr/bin/python3 -u` → `python3`.
# `env` defers to the next word that is not an `env` option
# (`#!/usr/bin/env -S python3 -u` → `python3`). The name is then
# prefix-matched, so trailing version digits (`python3`, `bash5`)
# still land.
#
# 2.3.4 fixed the interpreter rule — the pre-2.3.4 scan took the
# last '/' OR space on the whole line, so any interpreter ARGUMENT
# won: `#!/bin/bash -e` resolved to `-e` and detection failed. That
# fix walked each word three times (line end, word end, basename)
# through two helper calls apiece, and cost ~30% on the
# `detect/content-python` bench row. 2.5.1 keeps the 2.3.4 answers
# exactly and walks each word ONCE: a single loop stops at the first
# space / tab / LF (or `src_len`) and records the last '/' on the
# way, so the separate first-line scan is gone too — LF is just
# another word terminator. Whitespace is space and tab only; a CR
# stays part of the word, as before. 2.5.1 also accepts whitespace
# between `#!` and the interpreter (`#! /bin/sh`), see below.
# The interpreter a `#!` line names: the offset of its basename — past
# any directory, and past `env` and its options — with its length in
# `_detect_iw_len`; -1 when there is none. Shared by `_detect_shebang`
# and `detect_language_registered` (2.9.8), so both read a line alike.
var _detect_iw_len = 0;
fn _detect_interp(src, src_len) {
    _detect_iw_len = 0;
    if (src_len < 2) { return (0 - 1); }
    if (load8(src) != 35) { return (0 - 1); }      # '#'
    if (load8(src + 1) != 33) { return (0 - 1); }  # '!'

    # Spaces / tabs between `#!` and the interpreter are allowed —
    # the kernel skips them (`#! /bin/sh`). 2.3.4 took the empty
    # word before the space and detection failed; the pre-2.3.4 scan
    # had handled it by accident. Fixed 2.5.1.
    var p = 2;
    var lead_ws = 1;
    while ((p < src_len) && (lead_ws == 1)) {
        var w = load8(src + p);
        if ((w != 32) && (w != 9)) { lead_ws = 0; }
        if (lead_ws == 1) { p = p + 1; }
    }

    # First word: [p, word_end); word_start just past its last '/'.
    var word_start = p;
    var in_word = 1;
    while ((p < src_len) && (in_word == 1)) {
        var b = load8(src + p);
        if ((b == 32) || (b == 9) || (b == 10)) { in_word = 0; }
        if (in_word == 1) {
            if (b == 47) { word_start = p + 1; }
            p = p + 1;
        }
    }
    var word_end = p;
    var wlen = word_end - word_start;

    # `env` — the real interpreter is the next word, skipping any
    # options `env` itself takes (`env -S python3 -u`, `env -i sh`).
    # Reaching LF or the end of input first means there is none.
    if ((wlen == 3) && (memeq(src + word_start, "env", 3) == 1)) {
        var j = word_end;
        var looking = 1;
        while (looking == 1) {
            var in_ws = 1;
            while ((j < src_len) && (in_ws == 1)) {
                var c = load8(src + j);
                if ((c != 32) && (c != 9)) { in_ws = 0; }
                if (in_ws == 1) { j = j + 1; }
            }
            if (j >= src_len) { return (0 - 1); }
            # Latch the option test BEFORE `j` moves: re-reading
            # `load8(src + j)` after `j = q` would test the byte at
            # the new position. Same two-`if` hazard as
            # `_ds_scan_tag`.
            var lead = load8(src + j);
            if (lead == 10) { return (0 - 1); }
            var base = j;
            var q = j;
            var in_w = 1;
            while ((q < src_len) && (in_w == 1)) {
                var d = load8(src + q);
                if ((d == 32) || (d == 9) || (d == 10)) { in_w = 0; }
                if (in_w == 1) {
                    if (d == 47) { base = q + 1; }
                    q = q + 1;
                }
            }
            if (lead == 45) { j = q; }               # '-' option
            if (lead != 45) {
                word_start = base;
                word_end = q;
                looking = 0;
            }
        }
        wlen = word_end - word_start;
    }
    _detect_iw_len = wlen;
    return word_start;
}

fn _detect_shebang(src, src_len) {
    var word_start = _detect_interp(src, src_len);
    if (word_start < 0) { return 0; }
    var wlen = _detect_iw_len;

    # Match the interpreter name. Dispatch on its first byte so only
    # the patterns that can match are tried — every pattern's first
    # byte is distinct except the `p` group (`python`, `php`, `pwsh`,
    # `powershell`; none is a prefix of another, so order only
    # matters for speed — python first). Every pattern needs
    # `wlen >= 2`, which also keeps the first-byte read inside the
    # word. Each name is a grammar's `shebangs` entry (ADR 0025).
    if (wlen < 2) { return 0; }
    var c0 = load8(src + word_start);
    if (c0 == 98) {                                    # b
        if ((wlen >= 4) && (memeq(src + word_start, "bash", 4) == 1)) { return "shell"; }
        return 0;
    }
    if (c0 == 122) {                                   # z
        if ((wlen >= 3) && (memeq(src + word_start, "zsh", 3) == 1)) { return "shell"; }
        return 0;
    }
    if (c0 == 100) {                                   # d
        if ((wlen >= 4) && (memeq(src + word_start, "dash", 4) == 1)) { return "shell"; }
        return 0;
    }
    if (c0 == 115) {                                   # s
        # `sh` and `sh`-prefixed names up to 3 bytes (`sh5`):
        # bounded so `shellcheck` doesn't read as a shell
        # interpreter. (`ksh` is NOT matched — it starts with `k`.
        # The pre-2.5.1 comment here claimed it was.)
        if ((wlen <= 3) && (memeq(src + word_start, "sh", 2) == 1)) { return "shell"; }
        return 0;
    }
    if (c0 == 112) {                                   # p
        if ((wlen >= 6) && (memeq(src + word_start, "python", 6) == 1)) { return "python"; }
        if ((wlen >= 3) && (memeq(src + word_start, "php", 3) == 1)) { return "php"; }
        # PowerShell on Unix — `#!/usr/bin/env pwsh`. Declared in
        # powershell.cyml since M3 but never routed until 2.6.2.
        if ((wlen >= 4) && (memeq(src + word_start, "pwsh", 4) == 1)) { return "powershell"; }
        if ((wlen >= 10) && (memeq(src + word_start, "powershell", 10) == 1)) { return "powershell"; }
        return 0;
    }
    if (c0 == 106) {                                   # j
        if ((wlen >= 5) && (memeq(src + word_start, "julia", 5) == 1)) { return "julia"; }
        return 0;
    }
    if (c0 == 110) {                                   # n
        if ((wlen >= 4) && (memeq(src + word_start, "node", 4) == 1)) { return "javascript"; }
        return 0;
    }
    if (c0 == 114) {                                   # r
        if ((wlen >= 4) && (memeq(src + word_start, "ruby", 4) == 1)) { return "ruby"; }
        return 0;
    }
    if (c0 == 108) {                                   # l
        if ((wlen >= 3) && (memeq(src + word_start, "lua", 3) == 1)) { return "lua"; }
        return 0;
    }
    return 0;
}

# Signature peek — well-known fixed prefixes after BOM strip.
# `<?xml` always wins for XML; `<!DOCTYPE html` is HTML; any other
# `<!DOCTYPE` falls through to xml (DocBook, RELAX NG, etc.).
fn _detect_signature(src, src_len, start) {
    if (_detect_starts_with(src, src_len, start, "<?xml") == 1) { return "xml"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE HTML") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<!DOCTYPE") == 1) { return "xml"; }
    if (_detect_starts_with(src, src_len, start, "<!doctype html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<html") == 1) { return "html"; }
    if (_detect_starts_with(src, src_len, start, "<HTML") == 1) { return "html"; }
    return 0;
}

# Asm flavor scoring — counts ARM-vs-x86_64 signal hits in the
# first 4KB (or src_len, whichever is smaller). Returns:
#   "asm_aarch64" — ARM signals dominate
#   "asm_x86_64"  — x86 signals dominate (or tied / no signals)
# Tied / no-signal case defaults to x86_64 because that's the
# legacy default for `.s` / `.S` extensions (preserves 1.0–1.11.1
# behaviour for unannotated asm).
fn _detect_asm_flavor(src, src_len) {
    var arm_score = 0;
    var x86_score = 0;
    var scan_end = src_len;
    if (scan_end > 4096) { scan_end = 4096; }

    # ARM signals.
    if (_detect_index_of(src, scan_end, 0, ".arch armv8") >= 0) { arm_score = arm_score + 5; }
    if (_detect_index_of(src, scan_end, 0, ".arch armv7") >= 0) { arm_score = arm_score + 5; }
    if (_detect_index_of(src, scan_end, 0, "b.eq") >= 0)        { arm_score = arm_score + 3; }
    if (_detect_index_of(src, scan_end, 0, "b.ne") >= 0)        { arm_score = arm_score + 3; }
    if (_detect_index_of(src, scan_end, 0, "ldp ") >= 0)        { arm_score = arm_score + 2; }
    if (_detect_index_of(src, scan_end, 0, "stp ") >= 0)        { arm_score = arm_score + 2; }
    if (_detect_index_of(src, scan_end, 0, " x0,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " x1,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " w0,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " w1,") >= 0)        { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "xzr") >= 0)         { arm_score = arm_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "wzr") >= 0)         { arm_score = arm_score + 1; }

    # x86_64 signals.
    if (_detect_index_of(src, scan_end, 0, ".intel_syntax") >= 0) { x86_score = x86_score + 5; }
    if (_detect_index_of(src, scan_end, 0, ".att_syntax") >= 0)   { x86_score = x86_score + 5; }
    if (_detect_index_of(src, scan_end, 0, " rax") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rdi") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rsi") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rsp") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, " rbp") >= 0)          { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "syscall") >= 0)       { x86_score = x86_score + 1; }
    if (_detect_index_of(src, scan_end, 0, "xmm0") >= 0)          { x86_score = x86_score + 1; }

    if (arm_score > x86_score) { return "asm_aarch64"; }
    return "asm_x86_64";
}

# NASM or GNU as, for a file that path dispatch called `nasm` (ADR 0015,
# amended 2.9.9): GAS's `.directives` and AT&T `%`-registers against
# NASM's bare directives, `%` preprocessor and `;` comments, in the first
# 4 KB. GAS must win outright — `.asm` is NASM's by default — and then
# the asm flavour vote picks x86-64 or AArch64. A `.nasm` file votes
# too: NASM signals keep it NASM.
fn _detect_gas_or_nasm(src, src_len) {
    var gas = 0;
    var nasm = 0;
    var e = src_len;
    if (e > 4096) { e = 4096; }
    if (_detect_index_of(src, e, 0, ".intel_syntax") >= 0) { gas = gas + 5; }
    if (_detect_index_of(src, e, 0, ".att_syntax") >= 0)   { gas = gas + 5; }
    if (_detect_index_of(src, e, 0, ".arch armv8") >= 0)   { gas = gas + 5; }
    if (_detect_index_of(src, e, 0, "%rax") >= 0)          { gas = gas + 2; }
    if (_detect_index_of(src, e, 0, "%rsp") >= 0)          { gas = gas + 2; }
    if (_detect_index_of(src, e, 0, "%eax") >= 0)          { gas = gas + 2; }
    if (_detect_index_of(src, e, 0, "%define") >= 0)       { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, "%include") >= 0)      { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, "%macro") >= 0)        { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, "bits 64") >= 0)       { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, "BITS 64") >= 0)       { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, "default rel") >= 0)   { nasm = nasm + 3; }
    if (_detect_index_of(src, e, 0, " resb ") >= 0)        { nasm = nasm + 2; }
    if (_detect_index_of(src, e, 0, " db ") >= 0)          { nasm = nasm + 1; }
    if (_detect_index_of(src, e, 0, "\n;") >= 0)           { nasm = nasm + 1; }
    # Line starts (2.9.12 audit, reviewer D): a GAS directive line —
    # `.text`, `.globl`, `.align`, `.quad` — against NASM's `section`,
    # `global`, `extern`, `bits`, `default`, `align` and `%` lines.
    # Through 2.9.11 NASM's `section .` was searched anywhere, so GAS's own
    # `.section .text` scored it, and `.global` counted for nothing: 503 of
    # one machine's 1,417 GAS files voted NASM as `.asm`.
    _detect_asm_lines(src, e);
    gas = gas + _da_gas_lines;
    nasm = nasm + _da_nasm_lines;
    if (gas > nasm) { return _detect_asm_flavor(src, src_len); }
    return "nasm";
}

# Lines of src[0, e) that start, after blanks, with a GAS directive (a
# `.` word not followed by `:` — `.loop:` is a NASM local label) or a NASM
# one; each count capped at 20.
var _da_gas_lines = 0;
var _da_nasm_lines = 0;

fn _detect_asm_lines(src, e) {
    _da_gas_lines = 0;
    _da_nasm_lines = 0;
    var p = 0;
    while (p < e) {
        while ((p < e) && ((load8(src + p) == 32) || (load8(src + p) == 9))) { p = p + 1; }
        if (p < e) {
            var b = load8(src + p);
            if ((b == 46) && (p + 1 < e)) {
                var w = p + 1;
                while ((w < e) && (_detect_is_lower(load8(src + w)) == 1)) { w = w + 1; }
                if ((w > p + 1) && ((w >= e) || (load8(src + w) != 58))) {
                    if (_da_gas_lines < 20) { _da_gas_lines = _da_gas_lines + 1; }
                }
            }
            if (b == 37) {
                if ((p + 1 < e) && (_detect_is_lower(load8(src + p + 1)) == 1)) {
                    if (_da_nasm_lines < 20) { _da_nasm_lines = _da_nasm_lines + 1; }
                }
            }
            if (_detect_nasm_word(src, e, p) == 1) {
                if (_da_nasm_lines < 20) { _da_nasm_lines = _da_nasm_lines + 1; }
            }
        }
        while ((p < e) && (load8(src + p) != 10)) { p = p + 1; }
        p = p + 1;
    }
    return 0;
}

fn _detect_is_lower(b) {
    if ((b >= 97) && (b <= 122)) { return 1; }
    return 0;
}

# 1 if src[p] starts a NASM directive word, any case, then a blank.
fn _detect_nasm_word(src, e, p) {
    var q = p;
    if ((q < e) && (load8(src + q) == 91)) { q = q + 1; }   # `[bits 64]`, `[section …]`
    var w = q;
    var go = 1;
    while ((go == 1) && (w < e) && (w - q < 8)) {
        var c = load8(src + w);
        if ((c >= 65) && (c <= 90)) { c = c + 32; }
        if (_detect_is_lower(c) == 0) { go = 0; }
        if (go == 1) { w = w + 1; }
    }
    if ((w >= e) || (w == q)) { return 0; }
    var nb = load8(src + w);
    if ((nb != 32) && (nb != 9)) { return 0; }
    var n = w - q;
    if (_detect_word_ci(src + q, n, "section") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "segment") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "global") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "extern") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "bits") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "default") == 1) { return 1; }
    if (_detect_word_ci(src + q, n, "align") == 1) { return 1; }
    return 0;
}

# 1 if the n bytes at p spell `w`, ASCII case ignored.
fn _detect_word_ci(p, n, w) {
    if (strlen(w) != n) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if ((c >= 65) && (c <= 90)) { c = c + 32; }
        if (c != load8(w + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Public byte-API content sniff. Tries shebang → signature peek; the
# BOM is skipped for the SIGNATURE peek only. A BOM before `#!` is not
# a shebang — the kernel would not honour it either — so `_detect_shebang`
# gets the raw `src` on purpose. (The header used to imply the BOM is
# stripped for every sniff; 2.5.2 audit.) Returns 0 if no sniff matches; callers can fall
# back to a default. Does NOT do asm flavor scoring on its own —
# the caller has to know it's asm first (see
# `detect_language_combined`).
fn detect_language_from_content(src, src_len) {
    if ((src == 0) || (src_len <= 0)) { return 0; }
    var bom = _detect_skip_bom(src, src_len);

    var sb = _detect_shebang(src, src_len);
    if (sb != 0) { return sb; }

    var sig = _detect_signature(src, src_len, bom);
    if (sig != 0) { return sig; }

    return 0;
}

# Combined entry. Path first; refine via content for known-
# ambiguous extensions (today: asm flavour). When path returns 0,
# fall through to pure content sniff. Returns a language name or
# 0. This is the function the CLI calls.
fn detect_language_combined(path, src, src_len) {
    var path_lang = detect_language(path);

    # Asm flavour split — `.s` / `.S` extensions land on
    # `asm_x86_64` from path dispatch; let content vote. An `.asm` lands
    # on `nasm`, and content votes GAS back (2.9.9).
    if (path_lang != 0) {
        if (streq(path_lang, "asm_x86_64") == 1) {
            return _detect_asm_flavor(src, src_len);
        }
        if (streq(path_lang, "nasm") == 1) {
            return _detect_gas_or_nasm(src, src_len);
        }
        return path_lang;
    }

    return detect_language_from_content(src, src_len);
}

# ── Registered detection (ADR 0031, 2.9.8) ──
# Routes by what the REGISTRY's grammars declare — a consumer's own,
# registered with `grammar_load` + `registry_add`, as well as the
# bundled ones — instead of the compiled table above. Additive: the
# three functions above are unchanged and stay pure. Ties go to the
# first registered grammar, as `registry_find_by_name` resolves names.
# (Variable names here are not the compiled routes' `path` / `n` /
# `word_start`, so scripts/check-detect.sh's route shapes do not match
# these lines.)

# The first registered grammar with the longest declared extension the
# `pn` bytes at `p` end with, or 0.
fn _detect_reg_ext(p, pn) {
    var reg = registry_init();
    var best = 0;
    var best_len = 0;
    var i = 0;
    while (i < vec_len(reg)) {
        var g = vec_get(reg, i);
        var v = grammar_extensions(g);
        var e = 0;
        while (e < vec_len(v)) {
            var w = vec_get(v, e);
            var wl = strlen(w);
            if ((wl > best_len) && (wl <= pn)) {
                if (memeq(p + pn - wl, w, wl) == 1) {
                    best = g;
                    best_len = wl;
                }
            }
            e = e + 1;
        }
        i = i + 1;
    }
    return best;
}

# The first registered grammar a declared filename routes the path to,
# by ADR 0025's rules (the compiled table's own `_detect_fname`), or 0.
fn _detect_reg_fname(p, pn) {
    var reg = registry_init();
    var i = 0;
    while (i < vec_len(reg)) {
        var g = vec_get(reg, i);
        var v = grammar_filenames(g);
        var e = 0;
        while (e < vec_len(v)) {
            if (_detect_fname(p, pn, vec_get(v, e)) == 1) { return g; }
            e = e + 1;
        }
        i = i + 1;
    }
    return 0;
}

# The first registered grammar with the longest declared shebang that
# the `#!` line's interpreter starts with (prefix-matched, ADR 0025),
# or 0.
fn _detect_reg_shebang(s, sl) {
    var ws = _detect_interp(s, sl);
    if (ws < 0) { return 0; }
    var wl = _detect_iw_len;
    var reg = registry_init();
    var best = 0;
    var best_len = 0;
    var i = 0;
    while (i < vec_len(reg)) {
        var g = vec_get(reg, i);
        var v = grammar_shebangs(g);
        var e = 0;
        while (e < vec_len(v)) {
            var w = vec_get(v, e);
            var el = strlen(w);
            if ((el > best_len) && (el <= wl)) {
                if (memeq(s + ws, w, el) == 1) {
                    best = g;
                    best_len = el;
                }
            }
            e = e + 1;
        }
        i = i + 1;
    }
    return best;
}

# Public (2.9.8): the name of the grammar the registry's declarations
# route to — by the path's longest declared extension, else a declared
# filename, else (with `src`) a `#!` interpreter — or 0. Bootstraps the
# bundled grammars first, as `has_grammar` does. `src` may be 0 for a
# path-only answer. ADR 0031.
fn detect_language_registered(path, src, src_len) {
    bootstrap_grammars();
    if (path != 0) {
        var pn = strlen(path);
        if (pn > 0) {
            var g = _detect_reg_ext(path, pn);
            if (g == 0) { g = _detect_reg_fname(path, pn); }
            if (g != 0) { return grammar_name(g); }
        }
    }
    if ((src != 0) && (src_len > 0)) {
        var gs = _detect_reg_shebang(src, src_len);
        if (gs != 0) { return grammar_name(gs); }
    }
    return 0;
}
