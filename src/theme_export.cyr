# vyakarana — theme export to external editor formats
#
# Emits theme files for external editors based on vyakarana's
# bundled themes (`src/theme.cyr`). Lets a user grab a starting
# point for a personal theme without writing one from scratch.
#
# 1.11.1 shipped **VS Code** (`theme.json`) export.
# 1.12.1 adds **Helix** (`theme.toml`) and **iTerm**
# (`.itermcolors` plist) emitters — same kind→hex mapping
# (and same bundled-theme palettes), different output format.
# Each emitter is a separate function; the CLI dispatches on
# `--export-theme=<format>`.
#
# The vyakarana → VS Code scope mapping is hardcoded here:
#
#   TK_IDENT         → "variable"                    (low-key default)
#   TK_KEYWORD       → "keyword"
#   TK_STRING        → "string"
#   TK_NUMBER        → "constant.numeric"
#   TK_COMMENT       → "comment"
#   TK_OPERATOR      → "keyword.operator"
#   TK_PUNCTUATION   → "punctuation"
#   TK_WHITESPACE    → (omitted; no theme should style whitespace)
#   TK_PREPROCESSOR  → "keyword.control.directive"
#   TK_ERROR         → "invalid"
#
# These are TextMate-style scopes that VS Code (and friends)
# understand. They're a strict subset of the much larger TM
# scope vocabulary; consumers are free to extend the resulting
# JSON with finer-grained scopes if they want.

include "src/token.cyr"
include "src/theme.cyr"

# Print one `tokenColors` entry. Skips when `color_hex` is the
# empty string (the kind has no colour in this theme; we don't
# emit an empty `foreground`).
fn _te_emit_entry(scope, color_hex, is_first) {
    if (strlen(color_hex) == 0) { return is_first; }
    if (is_first == 0) {
        var c1 = ",\n";
        out_write(c1, strlen(c1));
    }
    var open_brace = "    { \"scope\": \"";
    out_write(open_brace, strlen(open_brace));
    out_write(scope, strlen(scope));
    var middle = "\", \"settings\": { \"foreground\": \"";
    out_write(middle, strlen(middle));
    out_write(color_hex, strlen(color_hex));
    var close_brace = "\" } }";
    out_write(close_brace, strlen(close_brace));
    return 0;
}

# Default-theme palette as 6-digit hex strings. Returns "" for
# unstyled kinds (the rendering theme uses ANSI 8-color codes;
# we map those to canonical hex equivalents).
fn _te_default_hex(kind) {
    if (kind == TK_KEYWORD)      { return "#cd00cd"; }   # magenta
    if (kind == TK_STRING)       { return "#00cd00"; }   # green
    if (kind == TK_NUMBER)       { return "#00cdcd"; }   # cyan
    if (kind == TK_COMMENT)      { return "#7f7f7f"; }   # bright black (grey)
    if (kind == TK_PREPROCESSOR) { return "#cdcd00"; }   # yellow
    if (kind == TK_ERROR)        { return "#cd0000"; }   # red
    return "";
}

# Dark-theme palette. Follows the HUES of `theme_dark_color` in
# src/theme.cyr (bright variants of the default set) but not its exact
# colours: terminal ANSI codes have no fixed RGB, so these are chosen
# for an editor background. Comment `#a8a8a8` (ANSI 37 is #e5e5e5 in
# xterm), error `#ff5555` (91 → #ff0000), operator / punctuation
# `#e0e0e0` (97 → #ffffff). This comment used to say "Mirrors"
# (2.5.2 audit). Changing the values would change every exported
# theme file, so they stay.
fn _te_dark_hex(kind) {
    if (kind == TK_KEYWORD)      { return "#ff00ff"; }   # bright magenta
    if (kind == TK_STRING)       { return "#00ff00"; }   # bright green
    if (kind == TK_NUMBER)       { return "#00ffff"; }   # bright cyan
    if (kind == TK_COMMENT)      { return "#a8a8a8"; }   # light grey
    if (kind == TK_PREPROCESSOR) { return "#ffff00"; }   # bright yellow
    if (kind == TK_ERROR)        { return "#ff5555"; }   # bright red
    if (kind == TK_OPERATOR)     { return "#e0e0e0"; }   # bright white
    if (kind == TK_PUNCTUATION)  { return "#e0e0e0"; }   # bright white
    return "";
}

# Look up the hex for `kind` under `theme`. Returns "" for
# unstyled kinds (THEME_NONE always returns "").
fn _te_hex(theme, kind) {
    if (theme == THEME_DEFAULT) { return _te_default_hex(kind); }
    if (theme == THEME_DARK)    { return _te_dark_hex(kind); }
    return "";
}

# Emit a VS Code `theme.json` to stdout for the given theme tag.
# `theme` is the integer tag from `theme_resolve()` (THEME_DEFAULT
# / THEME_DARK / THEME_NONE).
fn theme_export_vscode(theme) {
    var name_str = "default";
    var type_str = "light";
    if (theme == THEME_DARK) {
        name_str = "dark";
        type_str = "dark";
    }
    if (theme == THEME_NONE) {
        name_str = "none";
        type_str = "light";
    }

    # Header.
    var l1 = "{\n";
    out_write(l1, strlen(l1));
    var l2 = "    \"name\": \"vyakarana-";
    out_write(l2, strlen(l2));
    out_write(name_str, strlen(name_str));
    var l3 = "\",\n";
    out_write(l3, strlen(l3));
    var l4 = "    \"type\": \"";
    out_write(l4, strlen(l4));
    out_write(type_str, strlen(type_str));
    var l5 = "\",\n";
    out_write(l5, strlen(l5));
    var l6 = "    \"tokenColors\": [\n";
    out_write(l6, strlen(l6));

    # Per-kind entries. Order matches src/token.cyr's TK_*
    # listing for readability; whitespace and ident are omitted
    # when their hex is "" (the common case for default theme).
    var first = 1;
    first = _te_emit_entry("variable",                  _te_hex(theme, TK_IDENT),        first);
    first = _te_emit_entry("keyword",                   _te_hex(theme, TK_KEYWORD),      first);
    first = _te_emit_entry("string",                    _te_hex(theme, TK_STRING),       first);
    first = _te_emit_entry("constant.numeric",          _te_hex(theme, TK_NUMBER),       first);
    first = _te_emit_entry("comment",                   _te_hex(theme, TK_COMMENT),      first);
    first = _te_emit_entry("keyword.operator",          _te_hex(theme, TK_OPERATOR),     first);
    first = _te_emit_entry("punctuation",               _te_hex(theme, TK_PUNCTUATION),  first);
    first = _te_emit_entry("keyword.control.directive", _te_hex(theme, TK_PREPROCESSOR), first);
    first = _te_emit_entry("invalid",                   _te_hex(theme, TK_ERROR),        first);

    # Trailer.
    var nl = "\n";
    out_write(nl, strlen(nl));
    var l7 = "    ]\n";
    out_write(l7, strlen(l7));
    var l8 = "}\n";
    out_write(l8, strlen(l8));

    return 0;
}

# ── Helix (theme.toml) ───────────────────────
# Helix theme files are flat TOML — `"<scope>" = "<hex>"` per
# line, optionally `"<scope>" = { fg = "<hex>", modifiers = [...]}`
# for richer entries. We emit the simple `fg = "<hex>"` form for
# every kind that has a hex value under the chosen theme.
#
# Helix scope vocabulary differs slightly from VS Code's TextMate
# names. Closest equivalents:
#   TK_KEYWORD       → "keyword"
#   TK_STRING        → "string"
#   TK_NUMBER        → "constant.numeric"
#   TK_COMMENT       → "comment"
#   TK_OPERATOR      → "operator"            (no `keyword.` prefix)
#   TK_PUNCTUATION   → "punctuation"
#   TK_PREPROCESSOR  → "keyword.directive"   (Helix's name for #include / @import)
#   TK_ERROR         → "error"               (not "invalid")
#   TK_IDENT         → "variable"            (when explicit hex set)

# Emit one Helix scope assignment. Skip when the kind has no hex
# under the chosen theme.
fn _te_emit_helix_entry(scope, color_hex) {
    if (strlen(color_hex) == 0) { return 0; }
    var open_quote = "\"";
    out_write(open_quote, 1);
    out_write(scope, strlen(scope));
    var middle = "\" = \"";
    out_write(middle, strlen(middle));
    out_write(color_hex, strlen(color_hex));
    var close = "\"\n";
    out_write(close, 2);
    return 0;
}

fn theme_export_helix(theme) {
    var name_str = "default";
    if (theme == THEME_DARK) { name_str = "dark"; }
    if (theme == THEME_NONE) { name_str = "none"; }

    # Header comment — TOML files can carry it.
    var h1 = "# vyakarana-";
    out_write(h1, strlen(h1));
    out_write(name_str, strlen(name_str));
    var h2 = " — Helix theme exported by `vyk --export-theme=helix`\n";
    out_write(h2, strlen(h2));
    var h3 = "# Pair with `theme = \"vyakarana-";
    out_write(h3, strlen(h3));
    out_write(name_str, strlen(name_str));
    var h4 = "\"` in your Helix `config.toml`.\n\n";
    out_write(h4, strlen(h4));

    _te_emit_helix_entry("variable",          _te_hex(theme, TK_IDENT));
    _te_emit_helix_entry("keyword",           _te_hex(theme, TK_KEYWORD));
    _te_emit_helix_entry("string",            _te_hex(theme, TK_STRING));
    _te_emit_helix_entry("constant.numeric",  _te_hex(theme, TK_NUMBER));
    _te_emit_helix_entry("comment",           _te_hex(theme, TK_COMMENT));
    _te_emit_helix_entry("operator",          _te_hex(theme, TK_OPERATOR));
    _te_emit_helix_entry("punctuation",       _te_hex(theme, TK_PUNCTUATION));
    _te_emit_helix_entry("keyword.directive", _te_hex(theme, TK_PREPROCESSOR));
    _te_emit_helix_entry("error",             _te_hex(theme, TK_ERROR));

    return 0;
}

# ── iTerm (.itermcolors plist) ────────────────
# iTerm color schemes are an Apple plist (XML) listing the 16
# ANSI colors plus a few terminal-level entries (background,
# foreground, cursor, selection). Each color is a `<dict>` with
# Color Space (sRGB), Red/Green/Blue Component as `<real>` 0..1.
#
# Unlike VS Code / Helix where we emit per-kind theme rules,
# iTerm wants a *terminal palette* — the 16 ANSI codes that the
# shell uses for colour output. The bundled vyakarana themes are
# already structured as ANSI-code mappings (theme.cyr's
# theme_default_color / theme_dark_color emit `\e[3X` / `\e[9X`
# escapes), so the export here writes the canonical 16 ANSI
# colour values that match.
#
# Default theme → standard ANSI palette (0..7 standard, 8..15
# bright). Dark theme → same 16 entries plus a darker background
# so the bright kinds (which the dark theme uses) read clearly.
#
# Float strings are precomputed: each ANSI channel value is one
# of {0, 92, 205, 229, 238, 255} → fixed strings to avoid having
# to print floats from Cyrius (no float runtime).

# Float-string for one byte channel value.
fn _te_iterm_chan(byte_value) {
    if (byte_value == 0)   { return "0.0"; }
    if (byte_value == 92)  { return "0.3607843137"; }    # 0x5c
    if (byte_value == 127) { return "0.4980392157"; }    # 0x7f
    if (byte_value == 205) { return "0.8039215686"; }    # 0xcd
    if (byte_value == 229) { return "0.8980392157"; }    # 0xe5
    if (byte_value == 238) { return "0.9333333333"; }    # 0xee
    if (byte_value == 255) { return "1.0"; }
    # Fall-through "0.5" — only hit if the palette acquires a
    # non-canonical channel value (none today).
    return "0.5";
}

# One `Ansi N Color` plist dict. r/g/b are byte values.
fn _te_iterm_emit_color(slot_name, r, g, b) {
    var k1 = "\t<key>";
    out_write(k1, strlen(k1));
    out_write(slot_name, strlen(slot_name));
    var k2 = "</key>\n\t<dict>\n";
    out_write(k2, strlen(k2));
    var space = "\t\t<key>Color Space</key>\n\t\t<string>sRGB</string>\n";
    out_write(space, strlen(space));
    var rk = "\t\t<key>Red Component</key>\n\t\t<real>";
    out_write(rk, strlen(rk));
    var rs = _te_iterm_chan(r);
    out_write(rs, strlen(rs));
    var rkc = "</real>\n";
    out_write(rkc, strlen(rkc));
    var gk = "\t\t<key>Green Component</key>\n\t\t<real>";
    out_write(gk, strlen(gk));
    var gs = _te_iterm_chan(g);
    out_write(gs, strlen(gs));
    out_write(rkc, strlen(rkc));
    var bk = "\t\t<key>Blue Component</key>\n\t\t<real>";
    out_write(bk, strlen(bk));
    var bs = _te_iterm_chan(b);
    out_write(bs, strlen(bs));
    out_write(rkc, strlen(rkc));
    var close = "\t</dict>\n";
    out_write(close, strlen(close));
    return 0;
}

fn theme_export_iterm(theme) {
    var hdr = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
    out_write(hdr, strlen(hdr));
    # Doctype split into two prints to keep source under 120
    # chars per line (cyrius lint convention).
    var dt1 = "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" ";
    out_write(dt1, strlen(dt1));
    var dt2 = "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n";
    out_write(dt2, strlen(dt2));
    var pl = "<plist version=\"1.0\">\n<dict>\n";
    out_write(pl, strlen(pl));

    # Standard 16 ANSI colours. Default and dark themes share the
    # palette; what changes between them is which kinds map to
    # which slots (see theme.cyr). The .itermcolors file is the
    # palette only — the user keeps using `vyk --theme=<name>` to
    # pick the kind→ANSI mapping.
    _te_iterm_emit_color("Ansi 0 Color",    0,   0,   0);     # black
    _te_iterm_emit_color("Ansi 1 Color",    205, 0,   0);     # red
    _te_iterm_emit_color("Ansi 2 Color",    0,   205, 0);     # green
    _te_iterm_emit_color("Ansi 3 Color",    205, 205, 0);     # yellow
    _te_iterm_emit_color("Ansi 4 Color",    0,   0,   238);   # blue
    _te_iterm_emit_color("Ansi 5 Color",    205, 0,   205);   # magenta
    _te_iterm_emit_color("Ansi 6 Color",    0,   205, 205);   # cyan
    _te_iterm_emit_color("Ansi 7 Color",    229, 229, 229);   # white
    _te_iterm_emit_color("Ansi 8 Color",    127, 127, 127);   # bright black
    _te_iterm_emit_color("Ansi 9 Color",    255, 0,   0);     # bright red
    _te_iterm_emit_color("Ansi 10 Color",   0,   255, 0);     # bright green
    _te_iterm_emit_color("Ansi 11 Color",   255, 255, 0);     # bright yellow
    _te_iterm_emit_color("Ansi 12 Color",   92,  92,  255);   # bright blue
    _te_iterm_emit_color("Ansi 13 Color",   255, 0,   255);   # bright magenta
    _te_iterm_emit_color("Ansi 14 Color",   0,   255, 255);   # bright cyan
    _te_iterm_emit_color("Ansi 15 Color",   255, 255, 255);   # bright white

    # Foreground / background — dark theme inverts them.
    if (theme == THEME_DARK) {
        _te_iterm_emit_color("Background Color", 0,   0,   0);
        _te_iterm_emit_color("Foreground Color", 229, 229, 229);
    }
    if (theme != THEME_DARK) {
        _te_iterm_emit_color("Background Color", 255, 255, 255);
        _te_iterm_emit_color("Foreground Color", 0,   0,   0);
    }
    _te_iterm_emit_color("Cursor Color",      127, 127, 127);
    _te_iterm_emit_color("Selection Color",   205, 205, 205);

    var trail = "</dict>\n</plist>\n";
    out_write(trail, strlen(trail));

    return 0;
}
