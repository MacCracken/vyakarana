# vyakarana — token kind palette + Token record
#
# The ten-kind palette is a stable contract. Grammar authors and theme
# palettes both depend on the set; do not add a kind without a design
# review and a CHANGELOG entry.
#
# Token layout (kind: u8, start: u32, len: u32 — 12 bytes) is
# load-bearing for downstream consumers (owl M3b). Pre-1.0 changes
# must be CHANGELOG-flagged.

# ── Token kinds ─────────────────────────────
var TK_IDENT        = 0;
var TK_KEYWORD      = 1;
var TK_STRING       = 2;
var TK_NUMBER       = 3;
var TK_COMMENT      = 4;
var TK_OPERATOR     = 5;
var TK_PUNCTUATION  = 6;
var TK_WHITESPACE   = 7;
var TK_PREPROCESSOR = 8;
var TK_ERROR        = 9;

var TK_COUNT = 10;

# Kind → name. Parallel to the TK_* constants.
# M2+ grammars reference these names; M0 just exposes them via vyk.
fn kind_name(kind) {
    if (kind == TK_IDENT)        { return "ident"; }
    if (kind == TK_KEYWORD)      { return "keyword"; }
    if (kind == TK_STRING)       { return "string"; }
    if (kind == TK_NUMBER)       { return "number"; }
    if (kind == TK_COMMENT)      { return "comment"; }
    if (kind == TK_OPERATOR)     { return "operator"; }
    if (kind == TK_PUNCTUATION)  { return "punctuation"; }
    if (kind == TK_WHITESPACE)   { return "whitespace"; }
    if (kind == TK_PREPROCESSOR) { return "preprocessor"; }
    if (kind == TK_ERROR)        { return "error"; }
    return "<invalid>";
}

# Coverage check helper — exported in `[lib] modules` so downstream
# consumers can validate `kind` values they receive from
# `tokenize_stream_kind` / `tokenbuf_kind`. (Read
# `tokenize_source` before 2.3.4; that entry point was removed in
# 2.0.0 — ADR 0017.)
fn kind_is_valid(kind) {
    if (kind < 0) { return 0; }
    if (kind >= TK_COUNT) { return 0; }
    return 1;
}

# ── Token record ────────────────────────────
#
# Layout: (kind: u8 @ 0, start: u32 @ 4, len: u32 @ 8) — 12 bytes.
# Bytes 1..3 are padding so start is 4-byte aligned.
# See design-spec §4. This layout is the consumer contract for owl M3b
# and subsequent consumers; do not shuffle fields without a CHANGELOG
# entry and a minor-version bump.
var TOKEN_SIZE = 12;

# ── tokenbuf — contiguous growable array of 12-byte Token records ───
#
# Design-spec §6 requires "no allocations per token." Stdlib Vec stores
# 8-byte slots, which doesn't fit the 12-byte Token layout, so this is
# a purpose-built buffer: three i64 fields (data_ptr, count, byte_cap)
# at the handle, 12 bytes per record in `data`.
#
# Accessors (tokenbuf_kind/start/len) are the shape owl M3b imports.
# Keep the surface stable — the internal growth policy can evolve.

var _TB_INIT_CAP = 64;   # initial record capacity (768 bytes)

# Returns 0 if either allocation failed. Every caller in-tree
# already treats a 0 tokenbuf as "no grammar / give up" (see
# `tokenize_buf` in src/main.cyr), so propagating 0 is the
# existing contract rather than a new one. Last of the
# FINDING-002 family — `_tokenbuf_grow` and `_stream_grow` are
# guarded above.
fn tokenbuf_new() {
    var tb = alloc(24);
    if (tb == 0) { return 0; }
    var bytes = _TB_INIT_CAP * TOKEN_SIZE;
    var data = alloc(bytes);
    if (data == 0) { return 0; }
    store64(tb, data);
    store64(tb + 8, 0);        # count
    store64(tb + 16, bytes);   # byte_cap
    return tb;
}

fn tokenbuf_count(tb) {
    return load64(tb + 8);
}

# Returns 1 on success, 0 if the buffer could not be grown.
# `alloc` returns 0 on OOM, on a negative size, and on anything over
# ALLOC_MAX (2 GiB) — FINDING-002 (2026-04-23 audit) flagged that
# vyakarana never checked it. Unchecked, a failed grow stored a NULL
# data pointer and the next push wrote through it. Doubling from 768
# bytes reaches ALLOC_MAX at ~178M tokens, so this is an
# out-of-memory path rather than an everyday one, but a tokenizer
# library must not take its host process down with a NULL write.
fn _tokenbuf_grow(tb) {
    var old_data = load64(tb);
    var old_bytes = load64(tb + 16);
    var new_bytes = old_bytes * 2;
    # A zero byte_cap makes the doubling above make no progress.
    # Only reachable on a zeroed/reused handle; same guard shape as
    # `_stream_grow`'s cap check (FINDING-008).
    if (old_bytes <= 0) { return 0; }
    var new_data = alloc(new_bytes);
    if (new_data == 0) { return 0; }
    var i = 0;
    while (i < old_bytes) {
        store8(new_data + i, load8(old_data + i));
        i = i + 1;
    }
    store64(tb, new_data);
    store64(tb + 16, new_bytes);
    return 1;
}

# Always returns 0 — the return value is NOT a status code, and must
# stay that way: `tokenbuf_push` ships in `dist/vyakarana.cyr`, so
# giving it a success/failure return would silently change meaning
# for any consumer that tests it (CLAUDE.md §Do not — public API
# changes need an ADR).
#
# If the buffer cannot grow (`alloc` returned 0 — OOM or past
# ALLOC_MAX), the token is DROPPED rather than written through a
# NULL data pointer. Dropping breaks the coverage invariant, which
# is bad; writing to NULL takes down the host process, which is
# worse. Callers that need to detect it compare `tokenbuf_count`
# across the call. See FINDING-002.
fn tokenbuf_push(tb, kind, start, len) {
    var count = load64(tb + 8);
    var byte_cap = load64(tb + 16);
    var used = count * TOKEN_SIZE;
    if (used >= byte_cap) {
        if (_tokenbuf_grow(tb) == 0) { return 0; }   # drop, don't corrupt
    }
    var data = load64(tb);
    var slot = data + count * TOKEN_SIZE;
    store8(slot, kind);
    store32(slot + 4, start);
    store32(slot + 8, len);
    store64(tb + 8, count + 1);
    return 0;
}

# Accessors by index (bounds-unchecked — caller must compare to
# tokenbuf_count). Kept small so the hot path stays inline-friendly
# for the streaming-tokenizer work scheduled for 2.0.0 (see
# `docs/development/roadmap.md`).
fn _tokenbuf_slot(tb, i) {
    var data = load64(tb);
    return data + i * TOKEN_SIZE;
}

fn tokenbuf_kind(tb, i) {
    return load8(_tokenbuf_slot(tb, i));
}

fn tokenbuf_start(tb, i) {
    return load32(_tokenbuf_slot(tb, i) + 4);
}

fn tokenbuf_len(tb, i) {
    return load32(_tokenbuf_slot(tb, i) + 8);
}

# Drop the first `n` records — shift entries [n, count) to
# [0, count - n) and update count. Used by 2.1.4's
# `tokenize_stream_discard_consumed` to reclaim staging memory
# in long-running pull-adapter streams. No-op when `n <= 0`;
# clamps to count when `n >= count`. Source and destination
# regions can overlap (src > dst), so a forward byte copy is
# safe.
fn tokenbuf_drop_front(tb, n) {
    if (n <= 0) { return 0; }
    var count = load64(tb + 8);
    if (n >= count) {
        store64(tb + 8, 0);
        return 0;
    }
    var keep = count - n;
    var data = load64(tb);
    var src = data + n * TOKEN_SIZE;
    var bytes = keep * TOKEN_SIZE;
    var i = 0;
    while (i < bytes) {
        store8(data + i, load8(src + i));
        i = i + 1;
    }
    store64(tb + 8, keep);
    return 0;
}
