# vyakarana — public tokenizer entry (streaming, 2.0+)
#
# 2.0.0 broke the 1.x `tokenize_source(src, lang)` synchronous
# entry. The new contract is push-based: the consumer creates a
# stream tied to a grammar, feeds chunks of bytes, and drains
# tokens as they're available.
#
# 2.0.1 implementation: rolling-buffer streaming via the
# rescan-and-commit pattern. Each drain re-runs the existing
# scanner over the current buffer, commits every token whose
# extent is fully present (those whose end < buf_len plus any
# trailing pair-rule token whose close marker is at its tail),
# and compacts the buffer by sliding unconsumed bytes to offset
# 0. abs_offset tracks how many bytes have already been
# committed so token starts emit absolute. finish() lifts the
# "drop trailing partial" rule and commits everything to EOF.
#
# Cost: O(buf_len) scan per drain. For many small chunks that's
# O(N²) total work over an N-byte stream — accept for 2.0.1's
# minimal-state-machine implementation. The watches since (2.0.3's
# pending pair, 2.6.0's heredoc watch, 2.8.0's run and compose
# watches — ADR 0028) skip that re-scan while the buffer's tail is
# still waiting; a resumable scanner was considered there and
# rejected. 2.9.10 made one piece resumable: an open compose region's
# body streams as its inner grammar's own (ADR 0032).
#
# The pull adapter (`tokenize_stream_next` + the `_kind` / `_start`
# / `_len` accessors) shipped in 2.0.2 and lives at the bottom of
# this file; `tokenize_stream_discard_consumed` joined it in 2.1.4.
#
# Stream layout (heap-allocated; opaque to callers):
#
#    0  buf_ptr     ptr to growable byte buffer
#    8  buf_len     i64 — bytes written so far (relative to buf_ptr[0])
#   16  buf_cap     i64 — current allocation size
#   24  grammar     ptr to grammar record (looked up at _new)
#   32  finished    i64  (0 / 1) — set by tokenize_stream_finish
#   40  cursor      i64 — buffer-relative position of next byte to scan
#                          (always 0 in 2.0.1 because compaction follows
#                          every commit, but kept distinct for clarity)
#   48  abs_offset  i64 — absolute offset of buf_ptr[0] in the original
#                          stream. Increments by `consumed` after each
#                          drain compaction. Tokens emit with
#                          start = abs_offset + relative_start.
#   56  staging_tb  ptr — internal tokenbuf used by the pull adapter
#                          (`tokenize_stream_next`). Drains land here
#                          when the consumer iterates instead of
#                          providing an out_tb to drain/finish.
#   64  next_idx    i64 — pull-adapter cursor: index of the *current*
#                          staging token + 1 (i.e., the next one to
#                          return). After advance(), use _kind / _start
#                          / _len to read the just-advanced-to token.
#   72  pending_idx i64 — index of the open pair rule whose close we're
#                          waiting for. `-1` when no pending pair. After
#                          a drain detects a trailing partial pair, this
#                          is set; subsequent drains skip directly to
#                          the close-marker scan instead of re-running
#                          the full scanner over the open-pair body.
#                          See 2.0.3 §Pending pair-rule tracking.
#   80  scan_resume i64 — buffer offset to resume close-marker scanning
#                          from. Advances each drain so we never re-
#                          scan body bytes already known not to contain
#                          the close marker — drops O(N²) → O(N) for
#                          big-partial cases.
#   88  scratch_tb  ptr — the drain's scan tokenbuf, reused (2.5.2)
#   96  last_byte   i64 — last committed byte, -1 = none; the
#                          `start_after` boundary at the buffer start
#                          (ADR 0022, 2.6.0)
#  104  watch_mode  i64 — heredoc hold watch (ADR 0023): 0 off,
#                          1 terminator search, 2 next line break
#                          (2.6.0; mode 2 in 2.6.2)
#  112  watch_dpos  i64 —   mode 1: delimiter offset in buf
#  120  watch_dlen  i64 —   mode 1: delimiter length
#  128  watch_ind   i64 —   mode 1: the terminator's key kind — 0 exact, 1
#                          tabs, 2 blanks, 3 leading identifier (ADR 0030)
#  136  watch_from  i64 —   where the next search resumes in buf
#  144  hold_start  i64 —   the held region's start in buf, for the
#                          VYK_HEREDOC_HOLD_MAX bound (2.6.2)
#  152  run_class   i64 — run watch (2.8.0): 0 off, else the class of
#                          the long token at the buffer's tail
#                          (`_stream_run_cont`)
#  160  run_from    i64 —   where the run watch resumes in buf
#  168  pend_raw    i64 — 1 when the pending pair string has a raw prefix
#                          (`r"…"`, ADR 0027): its close scan ignores
#                          escapes (2.8.0)
#  176  watch_scan  i64 —   mode 1: how far the line at +136 has been
#                          searched for its LF (2.8.0)
#  184  hold_max    i64 —   the held region's bound: VYK_HEREDOC_HOLD_MAX
#                          or VYK_COMPOSE_HOLD_MAX (2.8.0; modes 3 / 4
#                          and +112 as a marker cstr are compose holds)
#  192  watch_dcopy ptr —   512 bytes: mode 1's copy of a delimiter quote
#                          removal rewrote, when +112 is -1 (2.9.1), or
#                          mode 3's copy of an inline literal's closer
#                          (ADR 0030, 2.9.5)
#  200  watch_lead  i64 —   mode 3: where the marker counts — 0 anywhere,
#                          1 at a line start, else a cstr of the bytes
#                          allowed before it on its line (2.9.1)
#  208  watch_esc   i64 —   mode 3: escape byte; an escaped marker is no
#                          close (2.9.1)
#  216  last_byte2  i64 — the committed byte before last_byte, -1 = none;
#                          `number_tuple_index` looks two bytes back
#                          (ADR 0026, 2.9.3)
#  224  rg_kind     i64 — resumable region (ADR 0032, 2.9.10): 0 none,
#                          else the body being read with its inner
#                          grammar — 1 compose, 3 compose_region with
#                          `end_before`, 4 one to the end of the input, 5
#                          one with `end_blank` (2.9.12); 2, compose_fenced,
#                          through 2.9.11 only.
#                          buf[0] is in the body.
#  232  rg_inner    ptr —   the inner grammar
#  240  rg_end      ptr —   the end marker (cstr, the outer grammar's), 0
#                          for kind 4
#  248  —           i64 —   unused (2.9.10 – 2.9.11: a fence's end_indent)
#  256  rg_from     i64 —   where the end-marker search resumes in buf
#  264  —           i64 —   unused (2.9.10 – 2.9.11: a fence's line state)
#  272  rg_off      i64 —   body bytes committed; 0 = the scan starts at
#                          the body's start, as a single feed's nested
#                          scan does
#  280  hold_gave   i64 — 1 once a compose or heredoc hold passed its
#                          bound and its bytes committed as read: from there
#                          the tokens may differ from one feed's (2.9.12; a
#                          document then tokenizes the text in one feed)
#  288  stage_dead  i64 — pull adapter: staging tokens before the cursor that
#                          `_discard_consumed` has reported dropped and that
#                          are still to be moved out (2.9.12)
#   -----
#  296 bytes total (STREAM_REC_SIZE). This table stopped at offset 80
#  — "88 bytes total" — from 2.5.2 until the 2.6.x audit.
#
# Bundled into `dist/vyakarana.cyr`. Public symbols — this list is
# what CLAUDE.md's frozen-API rule points at, so keep it accurate:
#
#   push API      tokenize_stream_new
#                 tokenize_stream_feed
#                 tokenize_stream_drain
#                 tokenize_stream_finish
#                 tokenize_stream_free
#   pull adapter  tokenize_stream_next        (2.0.2)
#                 tokenize_stream_kind
#                 tokenize_stream_start
#                 tokenize_stream_len
#                 tokenize_stream_discard_consumed  (2.1.4)
#   registry      has_grammar
#                 list_languages_into
#                 bootstrap_grammars
#                 grammar_load, registry_add, registry_find_by_name
#                 (a consumer's own grammars; src/grammar.cyr)
#   detection     detect_language, detect_language_from_content,
#                 detect_language_combined, detect_language_registered
#                 (2.9.8; src/detect.cyr, ADRs 0015, 0025, 0031)
#   documents     tokenize_doc_new / _set / _edit / _tokens / _free,
#                 tokenize_doc_changed_first / _old / _new
#                 (2.9.11, src/tokenize_doc.cyr, ADR 0033)
#   tokens        tokenbuf_new / _count / _kind / _start / _len / _push,
#                 the TK_* kinds (src/token.cyr, ADR 0002)
# (The detection, registry and token lines were missing until 2.9.12,
# though every doc pointed here — 2.9.12 audit, reviewer D.)
#
# Removed in 2.0.0 (no compat shim):
#   tokenize_source
#
# NOT public, but still present: `tokenize_source_handcoded` — the
# `vyk --handcoded` regression oracle. It is defined at the bottom
# of this file and ships in the bundle, so listing it as "removed"
# (as this header did through 2.3.4) was simply wrong; consumer DCE
# builds strip it.
#
# See `docs/adr/0017-streaming-api.md` for the design rationale
# and the migration recipe for 1.x consumers.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/grammars/shell.cyr"
include "src/grammars/default_scanner.cyr"

# Initial buffer allocation; grows as needed.
var VYK_STREAM_INIT_CAP = 4096;
# Hard upper bound on the *live* (unconsumed) buffer at any one
# point. 2.0.1's rolling buffer compacts after every drain, so
# the cap effectively bounds the longest in-progress span (block
# comment, multi-line string, fence body) rather than the total
# input size. Total input can exceed this freely. One byte of the cap
# is the NUL terminator the drain writes, so the largest live window
# — and the largest single feed into an empty stream — is
# `VYK_STREAM_CAP - 1` bytes (a feed of exactly the cap returns
# VYK_ERR_OVERFLOW; 2.5.2 audit, documentation only).
var VYK_STREAM_CAP = 16777216;

# Hard ceiling on a stream's TOTAL input, distinct from the live-
# window cap above. `Token.start` / `Token.len` are u32 (ADR 0002's
# 12-byte layout), but `abs_offset` is an i64 that accumulates over
# every byte ever fed. Past 2^32 the `store32` in `tokenbuf_push`
# wraps silently: a token at absolute offset 4294967301 reads back
# as 5, so a consumer indexing `src[start .. start+len)` gets
# unrelated bytes and the coverage invariant stops holding with no
# error anywhere.
#
# FINDING-005 (2026-04-23 audit) rated this LOW as "theoretical",
# correctly — back then the only entry point was `tokenize_source`,
# bounded by VYK_SRC_CAP at 1 MiB. 2.0.0 replaced it with this
# streaming API, whose own header advertises "Total input can
# exceed this freely", and the LOW rating was never revisited.
# Widening Token is a layout change (ADR + minor bump), so 2.3.4
# does the patch-safe half: refuse the input rather than corrupt
# the output. See CHANGELOG 2.3.4.
var VYK_OFFSET_CAP = 4294967295;

# Largest region a single unresolved compose opener may pin.
#
# While a compose opener is held, the drain commits nothing from it
# and the rolling buffer cannot compact — the live window degenerates
# from "longest in-progress span" to "everything since the opener". Two
# consequences, both measured in the 2.3.4 audit: cost grows
# superlinearly, and VYK_STREAM_CAP turns into a TOTAL-INPUT ceiling,
# so an unterminated `<style>` eventually made every
# `tokenize_stream_feed` return VYK_ERR_OVERFLOW forever. That directly
# contradicts this file's own "Total input can exceed this freely".
#
# Since 2.9.10 a region open at the buffer's end whose body has an inner
# grammar is not held at all: its body streams as that grammar's own
# (ADR 0032). Still held: a body that is one token (an untagged fence, a
# region whose inner grammar is not loaded), a fence's info line, an
# inline literal (ADR 0030), and a region open inside one being
# streamed. So bound it: past this many bytes, stop holding and commit
# the bytes as that drain's scan read them — a body running to the
# buffer's end. Coverage and the zero-error bar still hold; what is lost
# is agreement with a single feed from there on. (Through 2.9.9 a
# `compose` or `compose_fenced` opener with no end in the buffer read as
# OUTER text here.)
#
# 8 MiB is deliberately generous: every real embedded stylesheet or
# fenced block is orders of magnitude smaller, so this only fires on
# input that is malformed or adversarial — exactly the case that
# used to wedge the stream permanently.
var VYK_COMPOSE_HOLD_MAX = 8388608;

# Bound on how far a streaming drain holds back commits behind an
# unresolved here-document group (ADR 0023) — from its line's first
# `<<WORD` to the buffer's end, while a terminator line has not
# arrived. Past it the bytes commit as ordinary code, so only a group
# longer than this, split across feeds, can tokenize differently from
# a single feed. (Measured from the group's first opener, not from the
# body still open: `cat <<A <<B` with a 1.0 MB body for A and 120 KB
# for B trips it — this comment said "a heredoc body" until 2.9.1.) Enforced on both the
# full-scan path and the watch (through 2.6.1 the watch skipped it, and
# an armed hold grew to VYK_STREAM_CAP, after which every feed failed).
# Smaller than the compose bound because a mode-2 watch still re-scans
# the held bytes at each new line break.
var VYK_HEREDOC_HOLD_MAX = 1048576;

# Layout in the table at the top of this file.
var STREAM_REC_SIZE = 296;

# Error codes returned by tokenize_stream_feed.
var VYK_OK            = 0;
var VYK_ERR_OVERFLOW  = (0 - 1);   # cap exceeded
var VYK_ERR_FINISHED  = (0 - 2);   # feed after finish

var _grammars_bootstrapped = 0;

# Load every bundled grammar on first use. Idempotent.
fn bootstrap_grammars() {
    if (_grammars_bootstrapped == 1) { return 0; }
    _grammars_bootstrapped = 1;
    var gs = grammar_load("grammars/shell.cyml");
    if (gs != 0) { registry_add(gs); }
    var gt = grammar_load("grammars/toml.cyml");
    if (gt != 0) { registry_add(gt); }
    var gj = grammar_load("grammars/json.cyml");
    if (gj != 0) { registry_add(gj); }
    var gc = grammar_load("grammars/cyrius.cyml");
    if (gc != 0) { registry_add(gc); }
    var gr = grammar_load("grammars/rust.cyml");
    if (gr != 0) { registry_add(gr); }
    var gy = grammar_load("grammars/yaml.cyml");
    if (gy != 0) { registry_add(gy); }
    var gm = grammar_load("grammars/markdown.cyml");
    if (gm != 0) { registry_add(gm); }
    var gcc = grammar_load("grammars/c.cyml");
    if (gcc != 0) { registry_add(gcc); }
    var gts = grammar_load("grammars/typescript.cyml");
    if (gts != 0) { registry_add(gts); }
    var gjs = grammar_load("grammars/javascript.cyml");
    if (gjs != 0) { registry_add(gjs); }
    var gpy = grammar_load("grammars/python.cyml");
    if (gpy != 0) { registry_add(gpy); }
    var ggo = grammar_load("grammars/go.cyml");
    if (ggo != 0) { registry_add(ggo); }
    var gzig = grammar_load("grammars/zig.cyml");
    if (gzig != 0) { registry_add(gzig); }
    var gasm86 = grammar_load("grammars/asm_x86_64.cyml");
    if (gasm86 != 0) { registry_add(gasm86); }
    var gasmarm = grammar_load("grammars/asm_aarch64.cyml");
    if (gasmarm != 0) { registry_add(gasmarm); }
    var gjava = grammar_load("grammars/java.cyml");
    if (gjava != 0) { registry_add(gjava); }
    var gkt = grammar_load("grammars/kotlin.cyml");
    if (gkt != 0) { registry_add(gkt); }
    var gcpp = grammar_load("grammars/cpp.cyml");
    if (gcpp != 0) { registry_add(gcpp); }
    var gcs = grammar_load("grammars/csharp.cyml");
    if (gcs != 0) { registry_add(gcs); }
    var gphp = grammar_load("grammars/php.cyml");
    if (gphp != 0) { registry_add(gphp); }
    var grb = grammar_load("grammars/ruby.cyml");
    if (grb != 0) { registry_add(grb); }
    var glua = grammar_load("grammars/lua.cyml");
    if (glua != 0) { registry_add(glua); }
    var gswift = grammar_load("grammars/swift.cyml");
    if (gswift != 0) { registry_add(gswift); }
    var gex = grammar_load("grammars/elixir.cyml");
    if (gex != 0) { registry_add(gex); }
    var gml = grammar_load("grammars/ocaml.cyml");
    if (gml != 0) { registry_add(gml); }
    var ghs = grammar_load("grammars/haskell.cyml");
    if (ghs != 0) { registry_add(ghs); }
    var gsql = grammar_load("grammars/sql.cyml");
    if (gsql != 0) { registry_add(gsql); }
    var ggql = grammar_load("grammars/graphql.cyml");
    if (ggql != 0) { registry_add(ggql); }
    var gpb = grammar_load("grammars/protobuf.cyml");
    if (gpb != 0) { registry_add(gpb); }
    var ghtml = grammar_load("grammars/html.cyml");
    if (ghtml != 0) { registry_add(ghtml); }
    var gxml = grammar_load("grammars/xml.cyml");
    if (gxml != 0) { registry_add(gxml); }
    var gcss = grammar_load("grammars/css.cyml");
    if (gcss != 0) { registry_add(gcss); }
    var gscss = grammar_load("grammars/scss.cyml");
    if (gscss != 0) { registry_add(gscss); }
    var gdf = grammar_load("grammars/dockerfile.cyml");
    if (gdf != 0) { registry_add(gdf); }
    var gmk = grammar_load("grammars/makefile.cyml");
    if (gmk != 0) { registry_add(gmk); }
    var gini = grammar_load("grammars/ini.cyml");
    if (gini != 0) { registry_add(gini); }
    var gcyml = grammar_load("grammars/cyml.cyml");
    if (gcyml != 0) { registry_add(gcyml); }
    var gll = grammar_load("grammars/llvm_ir.cyml");
    if (gll != 0) { registry_add(gll); }
    var gps = grammar_load("grammars/powershell.cyml");
    if (gps != 0) { registry_add(gps); }
    var gcr = grammar_load("grammars/crystal.cyml");
    if (gcr != 0) { registry_add(gcr); }
    var gjul = grammar_load("grammars/julia.cyml");
    if (gjul != 0) { registry_add(gjul); }
    var gvue = grammar_load("grammars/vue.cyml");
    if (gvue != 0) { registry_add(gvue); }
    var gsvel = grammar_load("grammars/svelte.cyml");
    if (gsvel != 0) { registry_add(gsvel); }
    var gnix = grammar_load("grammars/nix.cyml");
    if (gnix != 0) { registry_add(gnix); }
    var gtf = grammar_load("grammars/terraform.cyml");
    if (gtf != 0) { registry_add(gtf); }
    var gqasm = grammar_load("grammars/openqasm.cyml");
    if (gqasm != 0) { registry_add(gqasm); }
    # 2.9.9: NASM, MDX, Lean 4.
    var gnasm = grammar_load("grammars/nasm.cyml");
    if (gnasm != 0) { registry_add(gnasm); }
    var gmdx = grammar_load("grammars/mdx.cyml");
    if (gmdx != 0) { registry_add(gmdx); }
    var glean = grammar_load("grammars/lean.cyml");
    if (glean != 0) { registry_add(glean); }
    return 0;
}

fn has_grammar(lang) {
    bootstrap_grammars();
    if (registry_find_by_name(lang) == 0) { return 0; }
    return 1;
}

# ── Stream primitive (push-based) ──────────────

# Allocate a fresh stream tied to the named grammar. Returns 0
# if the grammar is unknown (caller should check has_grammar
# first if it cares to distinguish).
fn tokenize_stream_new(lang) {
    bootstrap_grammars();
    var g = registry_find_by_name(lang);
    if (g == 0) { return 0; }
    # Every allocation is checked (2.5.2 audit P3): unchecked, a failed
    # `alloc` stored NULL and the first feed / drain / `_next` wrote
    # or read through it. A 0 return is already this function's
    # "could not create" answer.
    var s = alloc(STREAM_REC_SIZE);
    if (s == 0) { return 0; }
    var buf = alloc(VYK_STREAM_INIT_CAP);
    if (buf == 0) { return 0; }
    var staging = tokenbuf_new();
    if (staging == 0) { return 0; }
    var scratch = tokenbuf_new();
    if (scratch == 0) { return 0; }
    store64(s,      buf);
    store64(s + 8,  0);
    store64(s + 16, VYK_STREAM_INIT_CAP);
    store64(s + 24, g);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, staging);          # staging_tb (pull adapter)
    store64(s + 64, 0);                # next_idx
    store64(s + 72, (0 - 1));          # pending_idx — none (2.0.3)
    store64(s + 80, 0);                # scan_resume
    store64(s + 88, scratch);          # scratch_tb, reused per drain (2.5.2)
    store64(s + 96, (0 - 1));          # last committed byte, -1 = none (2.6.0)
    store64(s + 104, 0);               # watch mode, 0 = off (2.6.0)
    store64(s + 112, 0);               #   delimiter offset in buf
    store64(s + 120, 0);               #   delimiter length
    store64(s + 128, 0);               #   indent (tab-stripped terminator) flag
    store64(s + 136, 0);               #   resume offset (terminator / LF search)
    store64(s + 144, 0);               #   held region's start in buf (2.6.2)
    store64(s + 152, 0);               # run watch: class (2.8.0)
    store64(s + 160, 0);               #   resume offset
    store64(s + 168, 0);               # pending string is raw-prefixed (2.8.0)
    store64(s + 176, 0);               # heredoc watch: LF search position (2.8.0)
    store64(s + 184, 0);               # held region's bound (2.8.0)
    store64(s + 192, 0);               # heredoc watch: delimiter copy buffer (2.9.1)
    store64(s + 200, 0);               # mode 3: where the marker counts (2.9.1)
    store64(s + 208, 0);               # mode 3: escape byte, 0 = none (2.9.1)
    store64(s + 216, (0 - 1));         # the committed byte before that, -1 = none (2.9.3)
    store64(s + 224, 0);               # resumable region: kind, 0 = none (2.9.10)
    store64(s + 232, 0);               #   inner grammar
    store64(s + 240, 0);               #   end marker
    store64(s + 248, 0);               #   a fence's end_indent
    store64(s + 256, 0);               #   end-marker search resume
    store64(s + 264, 0);               #   a fence closer's line-start state there
    store64(s + 272, 0);               #   body bytes committed
    store64(s + 280, 0);               # a hold gave up at its bound (2.9.12)
    store64(s + 288, 0);               # pull adapter: staging tokens dropped behind the cursor (2.9.12)
    return s;
}

# Grow `s.buf` to at least `needed` bytes. Doubles capacity until
# either >= needed or VYK_STREAM_CAP. Returns 1 on success, 0 if
# the cap would be exceeded.
fn _vyk_stream_grow(s, needed) {
    var cap = load64(s + 16);
    if (cap >= needed) { return 1; }
    # Defensive: a zero cap would loop forever in the doubling
    # below (0 * 2 = 0). Should only happen if a freed stream
    # is reused — `_free` zeroes every field. Treat as an
    # error path rather than infinite-looping. Per FINDING-008,
    # 2.0.4 audit.
    if (cap <= 0) { return 0; }
    var new_cap = cap;
    while (new_cap < needed) { new_cap = new_cap * 2; }
    if (new_cap > VYK_STREAM_CAP) { new_cap = VYK_STREAM_CAP; }
    if (new_cap < needed) { return 0; }
    var old_buf = load64(s);
    var new_buf = alloc(new_cap);
    # FINDING-002: `alloc` returns 0 on OOM. Report failure through
    # the existing channel (feed turns this into VYK_ERR_OVERFLOW)
    # rather than copying into a NULL buffer.
    if (new_buf == 0) { return 0; }
    var len = load64(s + 8);
    var i = 0;
    while (i < len) {
        store8(new_buf + i, load8(old_buf + i));
        i = i + 1;
    }
    store64(s,      new_buf);
    store64(s + 16, new_cap);
    return 1;
}

# Feed `n` bytes from `chunk` into the stream's internal buffer.
# Returns VYK_OK on success, VYK_ERR_FINISHED if finish() already
# ran, VYK_ERR_OVERFLOW if the buffer cap would be exceeded.
fn tokenize_stream_feed(s, chunk, n) {
    if (s == 0) { return VYK_ERR_OVERFLOW; }
    if (load64(s + 32) == 1) { return VYK_ERR_FINISHED; }
    if (n <= 0) { return VYK_OK; }
    var len = load64(s + 8);
    # Reject an `n` so large that `len + n + 1` wraps i64 negative.
    # A negative `needed` makes _vyk_stream_grow's `cap >= needed` test
    # trivially true, so it would return success WITHOUT growing and
    # the copy loop below would run off the end of `buf`. Only a
    # garbage length from the caller gets here, but the failure mode
    # is an unbounded OOB write, so it is worth one compare.
    if (n > VYK_STREAM_CAP) { return VYK_ERR_OVERFLOW; }
    # Refuse bytes that would push any future token's absolute
    # start past the u32 ceiling (see VYK_OFFSET_CAP). abs_offset
    # is the offset of buf[0]; abs_offset + len is the offset one
    # past the live window, so that plus `n` is the highest offset
    # this feed could produce.
    if (load64(s + 48) + len + n > VYK_OFFSET_CAP) {
        return VYK_ERR_OVERFLOW;
    }
    var needed = len + n + 1;   # +1 for trailing NUL
    if (_vyk_stream_grow(s, needed) == 0) { return VYK_ERR_OVERFLOW; }
    var buf = load64(s);
    var i = 0;
    while (i < n) {
        store8(buf + len + i, load8(chunk + i));
        i = i + 1;
    }
    store64(s + 8, len + n);
    return VYK_OK;
}

# Mode-3 marker checks (2.9.1). 1 if the marker at buf[p] starts a line
# — `lead` 1 — or follows only bytes of cstr `lead` since one: the
# byte before that run is a line break. Reaching the buffer's start is
# no line start: a held region begins at its opener, before any close.
fn _stream_at_line_lead(buf, p, lead) {
    var k = p;
    if (lead != 1) {
        while ((k > 0) && (_ds_byte_in(lead, load8(buf + k - 1)) == 1)) { k = k - 1; }
    }
    if (k == 0) { return 0; }
    if (load8(buf + k - 1) == 10) { return 1; }
    return 0;
}

# 1 if buf[p] follows an odd run of escape bytes — `\"` is no close.
fn _stream_escaped(buf, p, esc) {
    var k = p;
    while ((k > 0) && (load8(buf + k - 1) == esc)) { k = k - 1; }
    if (((p - k) % 2) == 1) { return 1; }
    return 0;
}

# ── Run watch (2.8.0) ──────────────────────
# A drain re-scans its whole buffer from the last commit. When the one
# uncommitted token is long and still running into the buffer's end —
# a line comment with no LF yet, a long identifier, a whitespace or
# digit run — every drain re-scanned it to reach the same "not settled"
# verdict: a 512 KB comment fed in 64-byte chunks took 3.3 s, an
# identifier 10 s, a number 14 s. The watch records the token's class;
# later drains look only at the NEW bytes and return at once while each
# continues the run, then fall through to one full scan when a byte that
# could end it arrives (or at finish). It only ever skips a scan that
# would have committed nothing — holding is always safe — so it cannot
# change a token. Classes: 1 line rule (until LF), 2 identifier, 3
# whitespace, 4 decimal digits, 5 hex digits (separators continue both).
var VYK_RUN_WATCH_MIN = 256;

fn _stream_run_cont(g, cls, b) {
    if (cls == 1) {
        if (b != 10) { return 1; }
        return 0;
    }
    if (cls == 2) {
        if (char_class_match(grammar_ident_cont(g), b) == 1) { return 1; }
        if ((b >= 128) && (grammar_unicode_ident(g) == 1)) { return 1; }
        return 0;
    }
    if (cls == 3) { return _ds_is_space(b); }
    if ((cls == 4) || (cls == 5)) {
        if ((grammar_number_sep(g) > 0) && (b == grammar_number_sep(g))) { return 1; }
        if (cls == 4) { return _ds_is_digit(b); }
        return _ds_is_hex_digit(b);
    }
    return 0;
}

# The run-watch class for token (kind, start, len) at the buffer's end,
# or 0 when no watch applies.
fn _stream_run_class(g, buf, t_kind, t_start, t_len) {
    if (t_len < VYK_RUN_WATCH_MIN) { return 0; }
    # A line rule's token, of whatever kind it emits: a token that starts
    # with the start marker of a line rule of its own kind. Through 2.9.0
    # only comment and preprocessor kinds counted, so Zig's `\\` string
    # lines re-scanned per drain (512 KB in 64-byte chunks, 3.4 s; 2.9.1
    # audit, reviewer B, F4). A pair token sharing the marker only waits
    # for a line break it does not need — a delay, never a change.
    var lr = grammar_line_rules(g);
    var k = 0;
    while (k < vec_len(lr)) {
        var lrr = vec_get(lr, k);
        if (line_rule_kind(lrr) == t_kind) {
            var m = line_rule_start(lrr);
            var ml = strlen(m);
            if ((ml > 0) && (ml <= t_len)) {
                if (memeq(buf + t_start, m, ml) == 1) { return 1; }
            }
        }
        k = k + 1;
    }
    if ((t_kind == TK_COMMENT) || (t_kind == TK_PREPROCESSOR)) { return 0; }
    if ((t_kind == TK_IDENT) || (t_kind == TK_KEYWORD)) { return 2; }
    # Whitespace in every grammar (2.9.1). 2.8.0 left heredoc grammars out;
    # a heredoc's body only begins after an opener, and then the heredoc
    # hold applies and this watch is not armed — so a 1 MiB blank run in
    # shell, fed in 64-byte chunks, re-scanned for 29.8 s (reviewer B, F4).
    if (t_kind == TK_WHITESPACE) { return 3; }
    if (t_kind == TK_NUMBER) {
        var b1 = load8(buf + t_start + 1);
        if ((load8(buf + t_start) == 48) && ((b1 == 120) || (b1 == 88))) { return 5; }
        if (_ds_is_digit(load8(buf + t_start + t_len - 1)) == 1) { return 4; }
        return 0;
    }
    return 0;
}

# Bytes past a NUMBER token's end that can still extend it (ADR 0026):
# a separator + digit (2), `e` + sign + digit (3), and for datetimes the
# longest step — `-MM-DD` after `YYYY`, `THH:MM` after a date, an
# `+HH:MM` offset (6); since 2.9.7 a trailing dot's `.e+5` (4) and a
# type suffix (below). Zero for a grammar with none of these, which
# keeps every pre-2.7.0 grammar's drain unchanged. Without it, `1.` at
# the end of a feed committed `1` and the next feed's `5` became a
# second number — a plain number token ends before the buffer does, so
# the "ends before buf_len" rule called it settled.
fn _stream_num_lookahead(g) {
    var la = 0;
    if (grammar_number_sep(g) > 0) { la = 2; }
    if (grammar_number_float(g) == 1) { la = 3; }
    # A trailing dot and its exponent, `.e+5` (2.9.7).
    if (grammar_number_trail_dot(g) == 1) { la = 4; }
    if (grammar_number_datetime(g) == 1) { la = 6; }
    # A suffix (2.9.7): a separator, the longest suffix, and the byte that
    # shows it ends there (`1_u32` vs `1_u32x`) — after a trailing dot, one
    # more.
    var sv = grammar_number_suffixes(g);
    var sk = 0;
    while (sk < vec_len(sv)) {
        var sl = strlen(vec_get(sv, sk)) + 2;
        if (grammar_number_trail_dot(g) == 1) { sl = sl + 1; }
        if (sl > la) { la = sl; }
        sk = sk + 1;
    }
    return la;
}

# Longest marker in the grammar's operator + punctuation tables.
#
# Needed because those tables are matched LONGEST-FIRST, which makes
# the drain's "token ends before buf_len, so it is settled" rule
# false for them. `tests/corpus/concept.md` at chunk=7: a table rule
# `|---|` arriving as `|--` scans to `|`, `-`, `-` — `--` is not a
# markdown operator but `---` is. Both `-` tokens end strictly before
# buf_len, so both were committed, and the third `-` in the next feed
# became a fourth token. One 3-byte `---` came back as three 1-byte
# operators.
#
# An operator token starting at `p` can only grow into a marker that
# starts at `p`, so `p + max_marker <= buf_len` is exactly the point
# where the buffer is known to hold every candidate. Operators are 1-4
# bytes in practice; the rule markers and char literals measured below
# reach 12 (`<![CDATA[`, `</script>`, DS_CHAR_LITERAL_MAX), so this
# holds back at most a few bytes per drain.
fn _stream_max_marker(g) {
    var best = 1;
    var ops = grammar_operators(g);
    var n = vec_len(ops);
    var i = 0;
    while (i < n) {
        var l = strlen(vec_get(ops, i));
        if (l > best) { best = l; }
        i = i + 1;
    }
    var pun = grammar_punctuation(g);
    var pn = vec_len(pun);
    var pi = 0;
    while (pi < pn) {
        var pl = strlen(vec_get(pun, pi));
        if (pl > best) { best = pl; }
        pi = pi + 1;
    }
    # Rule START markers count too, and for the same reason. A pair
    # opener arriving one byte short scans as ordinary operators:
    # `tests/corpus/concept.xml` at chunk=3 turned the 287-byte
    # `<!-- ... -->` comment into `<`, `!`, `-`, ... because the
    # buffer held `<!-` and `<!--` is 4 bytes. Committing those
    # operators made the comment unrecoverable — 451 tokens became
    # 689. Pair END markers are included as well: the close is what
    # terminates the span, so the same one-byte-short case applies.
    var prs = grammar_pair_rules(g);
    var rn = vec_len(prs);
    var ri = 0;
    while (ri < rn) {
        var r = vec_get(prs, ri);
        var sl = strlen(pair_rule_start(r));
        if (sl > best) { best = sl; }
        var el = strlen(pair_rule_end(r));
        if (el > best) { best = el; }
        ri = ri + 1;
    }
    var lrs = grammar_line_rules(g);
    var ln = vec_len(lrs);
    var li = 0;
    while (li < ln) {
        var lrr = vec_get(lrs, li);
        var ll = strlen(line_rule_start(lrr));
        # A next-byte condition (ADR 0027) decides on the byte after the
        # start: `--` with `followed_by = " "` committed as operators when a
        # feed ended after `--` (2.9.12 audit, reviewer D).
        if ((line_rule_followed(lrr) != 0) || (line_rule_not_followed(lrr) != 0)) { ll = ll + 1; }
        if (ll > best) { best = ll; }
        li = li + 1;
    }
    var crs = grammar_compose_rules(g);
    var cn = vec_len(crs);
    var ci = 0;
    while (ci < cn) {
        var cl = strlen(compose_rule_start(vec_get(crs, ci)));
        if (cl > best) { best = cl; }
        ci = ci + 1;
    }
    var cfs = grammar_compose_fenced_rules(g);
    var fn2 = vec_len(cfs);
    var fi = 0;
    while (fi < fn2) {
        var fl = strlen(compose_fenced_rule_start(vec_get(cfs, fi)));
        if (fl > best) { best = fl; }
        fi = fi + 1;
    }
    var crr = grammar_compose_region_rules(g);
    var rrn = vec_len(crr);
    var rri = 0;
    while (rri < rrn) {
        var rl = strlen(compose_region_rule_start(vec_get(crr, rri)));
        if (rl > best) { best = rl; }
        rri = rri + 1;
    }
    # Char literals are markers too: up to DS_CHAR_LITERAL_MAX bytes.
    # A `'\n'` whose feed ended after `'\n` failed the literal shape,
    # fell through to the `'` operator, and that operator — shorter
    # than every other marker — was committed as settled. Broke
    # chunk invariance on c, ocaml, julia, crystal and both asm
    # corpora; through 2.5.1 this function measured only operators
    # and rule markers. 2.5.2 audit P1-2.
    if (grammar_char_literal(g) == 1) {
        if (DS_CHAR_LITERAL_MAX > best) { best = DS_CHAR_LITERAL_MAX; }
    }
    # A symbol-shaped string prefix and its quote (2.9.6): `$@` arriving
    # without its `"` is two operators, which must not commit.
    var slt = grammar_sym_prefix_lead(g);
    if (slt != 0) {
        best = _stream_sym_marker(slt, grammar_string_prefixes(g), best);
        best = _stream_sym_marker(slt, grammar_raw_string_prefixes(g), best);
    }
    return best;
}

# `best`, raised to cover each symbol-shaped prefix in `v` plus its quote.
# (No allocation: this runs on every drain.)
fn _stream_sym_marker(slt, v, best) {
    var k = 0;
    while (k < vec_len(v)) {
        var w = vec_get(v, k);
        if (char_class_match(slt, load8(w)) == 1) {
            if (strlen(w) + 1 > best) { best = strlen(w) + 1; }
        }
        k = k + 1;
    }
    return best;
}

# A STRING token that starts with a declared prefix (`f`, `rb`, `L` …,
# ADR 0027): the prefix length, with `_stream_pre_raw` = 1 for a raw
# prefix (escapes off); else 0. The pair-rule helpers below look at the
# token from after its prefix — through 2.7.1 they matched start markers
# at the prefix, found no owning rule, and a multi-line `f"""…` split
# at a line break was committed as a finished line comment would be.
var _stream_pre_raw = 0;

fn _stream_str_prefix(g, buf, t_start, t_len) {
    _stream_pre_raw = 0;
    var rawv = grammar_raw_string_prefixes(g);
    var plv = grammar_string_prefixes(g);
    if ((vec_len(rawv) == 0) && (vec_len(plv) == 0)) { return 0; }
    # A symbol-shaped prefix (C#'s `@"…"`, 2.9.6).
    var spl = _ds_sym_prefix(g, buf, t_start + t_len, t_start);
    if (spl > 0) {
        _stream_pre_raw = _ds_sym_raw;
        return spl;
    }
    var st = grammar_ident_start(g);
    var ct = grammar_ident_cont(g);
    if ((st == 0) || (ct == 0) || (t_len < 2)) { return 0; }
    if (char_class_match(st, load8(buf + t_start)) == 0) { return 0; }
    var k = 1;
    while ((k < t_len) && (char_class_match(ct, load8(buf + t_start + k)) == 1)) { k = k + 1; }
    if (k >= t_len) { return 0; }
    var q = load8(buf + t_start + k);
    if ((q != 34) && (q != 39) && (q != 96)) { return 0; }
    if (_ds_in_word_list(rawv, buf, t_start, k) == 1) {
        _stream_pre_raw = 1;
        return k;
    }
    if (_ds_in_word_list(plv, buf, t_start, k) == 1) { return k; }
    return 0;
}

# Is this pair-kind token still provisional — could a LONGER same-kind
# opener at the same offset explain it away once more bytes arrive? A
# buffer ending in `""` holds an empty string for the `"` rule, but the
# next byte may be the third quote of a `"""` opener: comparing
# min(opener, bytes available) catches an opener cut by the boundary.
# Only openers strictly LONGER than the token count, so a genuine empty
# string followed by a non-quote is settled. An opener fully present
# but unclosed needs no help here: an unterminated pair runs to the end
# of the buffer, and a token that reaches it is never settled. (Through
# 2.5.1 the scanner fell back to the shorter rule — `""` plus a stray
# quote — and the docstring in tests/corpus/python.py split, 1790
# tokens vs 1637 at chunk 3. This comment described that fallback until
# 2.9.1, and sat above the prefix helper rather than this function.)
fn _stream_pair_provisional(g, buf, buf_len, kind, t_start, t_len) {
    if ((kind != TK_STRING) && (kind != TK_COMMENT) && (kind != TK_PREPROCESSOR)) {
        return 0;
    }
    if (kind == TK_STRING) {
        var ppl = _stream_str_prefix(g, buf, t_start, t_len);
        t_start = t_start + ppl;
        t_len = t_len - ppl;
    }
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var avail = buf_len - t_start;
    var i = 0;
    var prov = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (pair_rule_kind(r) == kind) {
            var qstart = pair_rule_start(r);
            var qslen = strlen(qstart);
            if (qslen > t_len) {
                var cmp = qslen;
                if (cmp > avail) { cmp = avail; }
                if (cmp > 0) {
                    if (memeq(buf + t_start, qstart, cmp) == 1) { prov = 1; }
                }
            }
        }
        i = i + 1;
    }
    return prov;
}

# Returns 1 if the token at index `idx` of `temp_tb` (with src
# bytes in `buf`) is definitively complete — i.e., its trailing
# bytes are at a hard boundary (closing pair-rule marker, line
# break, single-byte fallthrough) and so the token wouldn't
# extend if more bytes arrived. Used by drain to decide whether
# to commit the trailing token even though its end == buf_len.
fn _stream_is_trailing_complete(g, buf, buf_len, temp_tb, idx) {
    var kind    = tokenbuf_kind(temp_tb, idx);
    var t_start = tokenbuf_start(temp_tb, idx);
    var t_len   = tokenbuf_len(temp_tb, idx);
    # Only pair-rule kinds get the trailing-complete pass.
    # Everything else — operators / punctuation (longest-match
    # tables), idents / keywords / numbers (extending bytes
    # could change the token), whitespace (more whitespace
    # could follow) — must wait. The cost of being wrong on
    # an extending case is mis-tokenization at chunk boundaries,
    # so we err on the side of conservatism: only the pair-rule
    # case (close marker is at the tail; no further bytes can
    # change this token's extent) is safe to commit early.
    # Compose rules emit their END marker as a TK_PUNCTUATION
    # span whose length equals the marker length. If the
    # trailing token IS that close marker, the compose pair
    # just emitted atomically — commit it. Without this,
    # split-at-end-of-compose (e.g. chunk boundary right after
    # `</style>`) would drop the close-marker token, leaving
    # the body bytes already compacted but the compose pair
    # incomplete from streaming's view. 2.2.1 fix; surfaced by
    # the streaming.fcyr `html/compose-style` random-split
    # case at split=29.
    if (kind == TK_PUNCTUATION) {
        var crules = grammar_compose_rules(g);
        var cn = vec_len(crules);
        var ci = 0;
        while (ci < cn) {
            var cr = vec_get(crules, ci);
            var cendp = compose_rule_end(cr);
            var celen = strlen(cendp);
            if ((celen > 0) && (celen == t_len)) {
                if (memeq(buf + t_start, cendp, celen) == 1) {
                    return 1;
                }
            }
            ci = ci + 1;
        }
        # Also check compose_fenced end markers — markdown's
        # ` ``` ` close is emitted as TK_PUNCTUATION via the
        # compose_fenced helper, same shape as compose. Without
        # this, split-at-end-of-fenced-block would drop the
        # close marker, leaving the body already compacted.
        var cfrules = grammar_compose_fenced_rules(g);
        var cfn = vec_len(cfrules);
        var cfi = 0;
        while (cfi < cfn) {
            var cfr = vec_get(cfrules, cfi);
            var cfendp = compose_fenced_rule_end(cfr);
            var cfelen = strlen(cfendp);
            if ((cfelen > 0) && (cfelen == t_len)) {
                if (memeq(buf + t_start, cfendp, cfelen) == 1) {
                    return 1;
                }
            }
            cfi = cfi + 1;
        }
        return 0;
    }
    if ((kind == TK_STRING) || (kind == TK_COMMENT) || (kind == TK_PREPROCESSOR)) {
        var rules = grammar_pair_rules(g);
        var n = vec_len(rules);
        # A prefixed string (`f"""…`): judge its pair-rule part (2.8.0).
        var tpl = 0;
        var traw = 0;
        if (kind == TK_STRING) {
            tpl = _stream_str_prefix(g, buf, t_start, t_len);
            traw = _stream_pre_raw;
        }
        var t_start0 = t_start;
        var t_len0 = t_len;
        # A verbatim string (a raw symbol prefix, C#'s `@"…"`) closed on the
        # buffer's last byte is not settled: a `"` next would double that
        # quote and carry the string on (2.9.12).
        if ((tpl > 0) && (traw == 1) && (t_start0 + t_len0 == buf_len)) {
            if (_ds_sym_prefix(g, buf, buf_len, t_start0) > 0) { return 0; }
        }
        t_start = t_start + tpl;
        t_len = t_len - tpl;

        # Find the rule that actually OPENED this token — the first
        # same-kind pair rule whose start marker matches at t_start,
        # mirroring the scanner's own first-match-wins order.
        #
        # Checking every same-kind rule instead (as this did through
        # 2.3.5) lets a short rule vouch for a long rule's token.
        # Python declares `"""` ahead of `"`; a docstring arriving as
        # just its opener `"""` failed the triple-quote test
        # (t_len 3 < slen+elen 6) and then PASSED the single-quote
        # test — 3 >= 1+1, and the opener's last byte is `"`, which
        # is that rule's end marker. The bare `"""` was committed as a
        # finished string and the docstring body came back as idents:
        # `tests/corpus/python.py` at chunk=3, 1790 tokens vs 1637.
        var owner = 0;
        var oi = 0;
        while ((oi < n) && (owner == 0)) {
            var r = vec_get(rules, oi);
            if (pair_rule_kind(r) == kind) {
                var startm = pair_rule_start(r);
                var slen = strlen(startm);
                if ((slen > 0) && (slen <= t_len)) {
                    if (memeq(buf + t_start, startm, slen) == 1) { owner = r; }
                }
            }
            oi = oi + 1;
        }

        # Before trusting `owner`, make sure a LONGER same-kind
        # opener could not match at this same offset once more bytes
        # arrive. If the bytes we have are a proper prefix of some
        # longer opener, this tokenization is provisional.
        #
        # `tests/corpus/python.py`: at the drain whose buffer ends
        # `\n    ""`, the 3-byte `\"\"\"` opener cannot match on 2
        # bytes, so the scanner falls to the 1-byte `\"` rule and
        # emits a 2-byte EMPTY string. That token looks genuinely
        # closed — `2 >= 1+1`, last byte is its own close marker — so
        # it was committed and the docstring came back as
        # `""` + body + `""`. One more byte makes it a `\"\"\"`
        # opener instead.
        #
        # Testing exactly this (rather than a blanket "hold anything
        # near the tail") keeps the 2.2.1 compose-close case working:
        # that token is TK_PUNCTUATION and never reaches here.
        if (_stream_pair_provisional(g, buf, buf_len, kind, t_start0, t_len0) == 1) {
            return 0;
        }

        if (owner != 0) {
            var ostartm = pair_rule_start(owner);
            var oslen = strlen(ostartm);
            var oendp = pair_rule_end(owner);
            var oelen = strlen(oendp);
            # Minimum-complete length is start + end. Without this,
            # an opening `"` (slen=1) at a chunk boundary looks
            # complete because its tail trivially matches the closing
            # `"` (elen=1) — the same byte. Streaming would commit a
            # 1-byte string; the real close on the next feed would
            # then read as a SECOND opener. Caught by 2.1.4's
            # fuzz/streaming.fcyr c/string-with-escape case.
            if ((oelen > 0) && (t_len >= oslen + oelen)) {
                if (memeq(buf + t_start + t_len - oelen, oendp, oelen) == 1) {
                    # ...and the close marker must not itself be
                    # ESCAPED. A buffer ending `"…\"` holds a string
                    # the scanner left unterminated (the `\` eats the
                    # `"`), yet its tail matches the close marker, so
                    # through 2.5.1 it was committed as a finished
                    # 19-byte string and the rest of the stream had
                    # its quotes inverted — json / toml / csharp /
                    # kotlin / php / swift corpora at the split right
                    # after `\"`. The scanner applies escapes left to
                    # right, so the marker is escaped exactly when an
                    # ODD run of escape bytes sits before it inside
                    # the body. 2.5.2 audit P1-3.
                    var oesc = pair_rule_escape(owner);
                    if (traw == 1) { oesc = 0; }
                    var escaped = 0;
                    if (oesc != 0) {
                        var q = t_start + t_len - oelen;
                        var body_lo = t_start + oslen;
                        var erun = 0;
                        while ((q > body_lo) && (load8(buf + q - 1) == oesc)) {
                            erun = erun + 1;
                            q = q - 1;
                        }
                        if ((erun & 1) == 1) { escaped = 1; }
                    }
                    if (escaped == 0) { return 1; }
                }
            }
            # Owned by a pair rule but not closed — it can still grow.
            return 0;
        }

        # No pair rule owns it, so it came from a line rule (line
        # comment) or the shebang default. There the LF is the
        # unambiguous terminator: if the trailing token ends in LF,
        # more bytes cannot extend it.
        #
        # This must not fire for pair tokens that merely contain a
        # newline at the boundary — through 2.3.5 it did, and a block
        # comment split right after a newline committed early.
        # `tests/corpus/concept.css` at chunk=3 opens with `/*\n`:
        # the pair test declined, then the bare-LF test committed a
        # 3-byte "comment" and the remaining 341 bytes of the header
        # were re-tokenized as CSS. The `owner != 0` early return
        # above is what now keeps pair tokens out of this path.
        if ((tpl == 0) && (t_len > 0) && (load8(buf + t_start + t_len - 1) == 10)) {
            return 1;
        }
    }
    return 0;
}

# Find which pair rule emitted a token at `[start, start+len)`
# in `buf`. Used to detect what to look for when the trailing
# token is a partial pair-rule open. Returns rule index, or -1
# if no pair rule's start marker matches the leading bytes.
fn _stream_find_pair_rule(g, buf, start, len, kind) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (pair_rule_kind(r) == kind) {
            var startm = pair_rule_start(r);
            var slen = strlen(startm);
            if ((slen > 0) && (slen <= len)) {
                if (memeq(buf + start, startm, slen) == 1) { return i; }
            }
        }
        i = i + 1;
    }
    return (0 - 1);
}

# Record the last two of the `n` bytes about to leave `buf` (n >= 1):
# the scanner's look-behind at the next buffer start. With one byte
# leaving, the byte before it is the previous last byte.
fn _stream_save_prev(s, buf, n) {
    var b2 = load64(s + 96);
    if (n >= 2) { b2 = load8(buf + n - 2); }
    store64(s + 216, b2);
    store64(s + 96, load8(buf + n - 1));
    return 0;
}

# Look for `endp` in `buf[from..buf_len]`. Honours the pair
# rule's escape byte. Returns close-position offset or -1.
var _stream_scan_stop = 0;

fn _stream_scan_close(buf, buf_len, from, endp, elen, escape) {
    # Where the search stopped without a close (2.9.12): always on an escape
    # pair's boundary, so the next search resumes there.
    _stream_scan_stop = from;
    # Defensive: `elen <= 0` (empty / null close marker) would
    # cause the memeq check to vacuously succeed at `from`,
    # producing a zero-length token. Pair-rule grammars
    # shouldn't emit empty markers but the loader doesn't
    # currently enforce it. Per FINDING-009, 2.0.4 audit.
    if (elen <= 0) { return (0 - 1); }
    var j = from;
    while (j + elen <= buf_len) {
        if ((escape != 0) && (load8(buf + j) == escape)) {
            j = j + 2;
            continue;
        }
        if (memeq(buf + j, endp, elen) == 1) { return j; }
        j = j + 1;
    }
    _stream_scan_stop = j;
    return (0 - 1);
}

# Drain tokens whose spans are fully present in the buffer.
# Re-scans the current buffer with `tokenize_with_grammar`,
# commits all tokens whose end < buf_len (in feed mode) or every
# token (in finish mode), then compacts the buffer by sliding
# unconsumed bytes to offset 0. Returns the count appended to
# `out_tb` by this call.
#
# Why rescan-and-commit? It reuses the existing scanner without
# requiring a state-machine refactor, at the cost of O(buf_len)
# per drain. The trailing partial token (string with no close,
# block comment without `*/`, etc.) is always dropped in feed
# mode — its bytes stay in the buffer, gets re-scanned next
# drain after more bytes arrive. finish() lifts this constraint
# and commits everything including the tail.
fn tokenize_stream_drain(s, out_tb) {
    if (s == 0) { return 0; }
    # 2.0.2: caller passes 0 to mean "use the internal staging
    # tokenbuf". Lets the pull-adapter use site
    # (`tokenize_stream_finish(s, 0)` followed by `_next`) work
    # without the caller having to fish the staging out.
    if (out_tb == 0) { out_tb = load64(s + 56); }
    # A freed stream has a 0 staging tokenbuf; pushing into it wrote
    # through NULL (2.5.2 audit P3).
    if (out_tb == 0) { return 0; }
    if (load64(s + 224) != 0) { return _stream_region_drain(s, out_tb); }
    return _stream_drain_g(s, out_tb, load64(s + 24), load64(s + 8), load64(s + 32), 0);
}

# The drain proper, with grammar `g` over the first `lim` bytes of the
# buffer — the stream's own grammar over all of it, or a resumable
# region's inner grammar over its body (`in_rg` 1, 2.9.10): bytes past
# `lim` stay in the buffer untouched, and the body's start is the scan's
# file start, as a single feed's nested scan of it sees.
fn _stream_drain_g(s, out_tb, g, lim, finishing, in_rg) {
    var buf = load64(s);
    var buf_len = lim;
    var abs_offset = load64(s + 48);
    var pending_idx = load64(s + 72);
    if (buf_len == 0) { return 0; }

    var emitted = 0;

    # 2.6.0 heredoc fast path (ADR 0023). A previous drain held back
    # everything from an unresolved `<<WORD` whose terminator line had
    # not arrived. Until it does, re-tokenizing the whole held buffer
    # each feed is O(N^2) — a 1 MB heredoc fed in 4 KB chunks took 48 s
    # — and can only reach the same "hold" verdict. So look for the
    # terminator in the NEW lines only; return with nothing committed
    # while it is absent; fall through to the full scan once it is
    # present with its line break, or at finish.
    # Mode 2 (2.6.x audit) watches for ANY new line break instead: the
    # hold is one no new byte can resolve before the next LF (an opener
    # line still arriving, a terminator line without its LF, an open
    # arithmetic `((`), and re-scanning the held bytes per feed until
    # then was O(N^2) — 1 MiB of CR-only lines in 4 KB chunks, 37 s.
    # Both modes give up at VYK_HEREDOC_HOLD_MAX, like the full-scan
    # path: through 2.6.1 the watch returned before that check ran, so
    # an armed hold grew to VYK_STREAM_CAP and every later feed failed.
    var wmode = load64(s + 104);
    if (wmode != 0) {
        if (finishing == 1) {
            store64(s + 104, 0);
            wmode = 0;
        }
        if ((wmode != 0) && (buf_len - load64(s + 144) > load64(s + 184))) {
            store64(s + 104, 0);
            wmode = 0;
        }
    }
    if (wmode == 3) {
        var mk = load64(s + 112);
        var ml = strlen(mk);
        var mq = load64(s + 136);
        if (mq < 0) { mq = 0; }
        var mfound = 0;
        var mlead = load64(s + 200);
        var mesc = load64(s + 208);
        while ((mq + ml <= buf_len) && (mfound == 0)) {
            if (load8(buf + mq) == load8(mk)) {
                if (memeq(buf + mq, mk, ml) == 1) { mfound = 1; }
                # A candidate that cannot be the close is passed for
                # good: everything before it is in the buffer (2.9.1).
                if ((mfound == 1) && (mlead != 0)) {
                    if (_stream_at_line_lead(buf, mq, mlead) == 0) { mfound = 0; }
                }
                if ((mfound == 1) && (mesc != 0)) {
                    if (_stream_escaped(buf, mq, mesc) == 1) { mfound = 0; }
                }
            }
            if (mfound == 0) { mq = mq + 1; }
        }
        if (mfound == 0) {
            if (mq > load64(s + 136)) { store64(s + 136, mq); }
            return 0;
        }
        store64(s + 104, 0);
    }
    if (wmode == 4) { return 0; }
    if (wmode == 2) {
        var lres = load64(s + 136);
        if (lres < 0) { lres = 0; }
        if (_ds_index_byte(buf, lres, buf_len, 10) < 0) {
            store64(s + 136, buf_len);
            return 0;
        }
        store64(s + 104, 0);
    }
    # Mode 1 is incremental (2.8.0): +136 is the start of the line being
    # read, +176 how far that line has been searched for its LF. A line
    # is compared with the delimiter once, when its LF arrives — through
    # 2.7.1 every drain re-read the last partial line from its start (and
    # scanned back to find it), so a 1 MiB one-line body in 512-byte
    # chunks took 5.5 s.
    if (wmode == 1) {
        if (finishing == 0) {
            var hls = load64(s + 136);
            var hsc = load64(s + 176);
            if (hsc < hls) { hsc = hls; }
            # +112 is -1 for a delimiter quote removal rewrote: compare
            # against the stream's copy of it (+192, 2.9.1).
            var hdp = load64(s + 192);
            if (load64(s + 112) >= 0) { hdp = buf + load64(s + 112); }
            var hdl = load64(s + 120);
            var hind = load64(s + 128);
            var hdone = 0;
            var hgo = 1;
            while (hgo == 1) {
                var hf = _ds_index_byte(buf, hsc, buf_len, 10);
                if (hf < 0) {
                    hgo = 0;
                    hsc = buf_len;
                }
                if (hf >= 0) {
                    # The line's key, as the scanner's lookup reads it
                    # (exact, tabs, blanks, leading identifier; ADR 0030).
                    var hce = _ds_hd_key(buf, hls, hf, hind);
                    var hcp = _ds_hk_cs;
                    if ((hce - hcp == hdl) && (memeq(buf + hcp, hdp, hdl) == 1)) {
                        hdone = 1;
                        hgo = 0;
                    }
                    if (hdone == 0) {
                        hls = hf + 1;
                        hsc = hls;
                    }
                }
            }
            if (hdone == 0) {
                store64(s + 136, hls);
                store64(s + 176, hsc);
                return 0;
            }
            store64(s + 104, 0);
        }
    }

    # 2.8.0 run watch (see `_stream_run_cont`).
    var rwc = load64(s + 152);
    if (rwc != 0) {
        if (finishing == 1) { store64(s + 152, 0); }
        if (finishing == 0) {
            var rr = load64(s + 160);
            if (rr < 0) { rr = 0; }
            var rgo = 1;
            while ((rr < buf_len) && (rgo == 1)) {
                if (_stream_run_cont(g, rwc, load8(buf + rr)) == 0) { rgo = 0; }
                if (rgo == 1) { rr = rr + 1; }
            }
            if (rgo == 1) {
                store64(s + 160, buf_len);
                return 0;
            }
            store64(s + 152, 0);
        }
    }

    # 2.0.3 fast path — pending pair rule from a previous drain.
    # The buffer's first bytes are the open marker; the body has
    # been growing across feeds. Skip the full scanner and look
    # only for the close marker, advancing scan_resume so we
    # never re-scan body bytes already known not to contain it.
    # Drops the pathological "open span across many chunks" case
    # from O(N²) to O(N).
    if (pending_idx >= 0) {
        var rule = vec_get(grammar_pair_rules(g), pending_idx);
        var endp = pair_rule_end(rule);
        var elen = strlen(endp);
        var escape = pair_rule_escape(rule);
        if (load64(s + 168) == 1) { escape = 0; }      # raw-prefixed string (2.8.0)
        var startm = pair_rule_start(rule);
        var slen = strlen(startm);
        # Where the body starts: after the start marker AND a declared
        # prefix (`f'''`, `b"""`). The clamps below used the marker alone,
        # so with at most one body byte buffered `buf_len - (elen - 1)`
        # fell inside the opener and the next scan matched the opener's
        # own last quotes as the close: `f'''''hello'''` fed a byte at a
        # time came back closed at 6 bytes (2.9.1 audit, reviewer B, F1).
        var pbody = slen + _stream_str_prefix(g, buf, 0, buf_len);
        var resume = load64(s + 80);
        if (resume < pbody) { resume = pbody; }
        var close_pos = _stream_scan_close(buf, buf_len, resume, endp, elen, escape);
        # A verbatim string goes on past a doubled quote (C#'s `""`, 2.9.12):
        # search on after it; a close on the buffer's last byte waits for the
        # next byte, unless the stream is finishing.
        var vbt = 0;
        if ((load64(s + 168) == 1) && (_ds_sym_prefix(g, buf, buf_len, 0) > 0)) { vbt = 1; }
        while ((vbt == 1) && (close_pos >= 0)) {
            var vce = close_pos + elen;
            vbt = 0;
            if ((vce >= buf_len) && (finishing == 0)) {
                _stream_scan_stop = close_pos;
                close_pos = (0 - 1);
            }
            if ((vce < buf_len) && (close_pos >= 0)) {
                if (load8(buf + vce) == 34) {
                    close_pos = _stream_scan_close(buf, buf_len, vce + 1, endp, elen, escape);
                    vbt = 1;
                }
            }
        }
        if (close_pos >= 0) {
            var pair_total = close_pos + elen;
            # Count the token only if the push landed — a push the
            # tokenbuf could not grow for is dropped (FINDING-002).
            # The P2-6 fix (2.3.4) covered the main commit loop only.
            var fp_before = tokenbuf_count(out_tb);
            tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, pair_total);
            emitted = emitted + (tokenbuf_count(out_tb) - fp_before);
            store64(s + 72, (0 - 1));
            store64(s + 80, 0);
            # Remember the last two bytes leaving the buffer — a
            # `start_after` boundary at the new buffer start needs the
            # last (ADR 0022), `number_tuple_index` both (2.9.3).
            _stream_compact(s, buf, pair_total);
            buf_len = buf_len - pair_total;
            abs_offset = abs_offset + pair_total;
            if (buf_len == 0) { return emitted; }
        }
        if (close_pos < 0) {
            # Still pending. Resume where the search stopped: it has passed
            # every position a close could start at with all its bytes in
            # the buffer, and it stops on an escape pair's boundary, so an
            # escape split across the feed boundary is read as a pair.
            # Through 2.9.11 it backed off by the close's length less one
            # and then over a trailing RUN of escape bytes — the run was
            # re-scanned on every drain: `x = "` + 1 MB of `\` in 64-byte
            # chunks took 31 s (2.9.12 audit, reviewer B). (The back-off
            # was the 2.5.2 fix for a split `\"`; the stop point keeps it.)
            var new_resume = _stream_scan_stop;
            if (new_resume < pbody) { new_resume = pbody; }
            store64(s + 80, new_resume);
            if (finishing == 1) {
                var fin_before = tokenbuf_count(out_tb);
                tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, buf_len);
                store64(s + 72, (0 - 1));
                store64(s + 80, 0);
                _stream_compact(s, buf, buf_len);
                return emitted + (tokenbuf_count(out_tb) - fin_before);
            }
            return emitted;
        }
    }

    # NUL-terminate the live buffer so the inner scanner's
    # strlen-shaped checks see the correct end.
    store8(buf + buf_len, 0);
    # One scratch tokenbuf per stream, emptied and reused each drain.
    # Through 2.5.1 every drain allocated a fresh one, and the bump
    # allocator never frees, so a stream's heap grew with every byte
    # ever fed — 12-24x the input (rust 23.8x, json 11.8x, 8 MB fed in
    # 4 KB or 64 KB chunks alike) — which made ADR 0021's 4 GiB-per-
    # stream contract unreachable in practice. 2.5.2 audit P1-4.
    var temp_tb = load64(s + 88);
    if (temp_tb == 0) { return 0; }
    _tokenbuf_reset(temp_tb);
    var mid_stream = abs_offset;
    if (in_rg == 1) { mid_stream = load64(s + 272); }
    if (mid_stream > 0) {
        _ds_not_file_start = 1;
        _ds_buf_prev = load64(s + 96);
        _ds_buf_prev2 = load64(s + 216);
    }
    _ds_hd_hold_from = (0 - 1);
    _ds_hd_hold_fast = 0;
    _ds_cp_hold_from = (0 - 1);
    _ds_cp_hold_mode = 0;
    _ds_cp_hold_marker = 0;
    _ds_cp_hold_scratch = 0;
    _ds_inl_last_start = (0 - 1);
    _ds_rg_from = (0 - 1);
    _ds_grp_collect = 1;
    _ds_rg_bias = in_rg;
    tokenize_with_grammar(g, buf, buf_len, temp_tb);
    _ds_rg_bias = 0;
    _ds_grp_collect = 0;
    var hd_hold = _ds_hd_hold_from;
    var hd_fast = _ds_hd_hold_fast;
    var hd_dpos = _ds_hd_hold_dpos;
    var hd_dlen = _ds_hd_hold_dlen;
    var hd_ind = _ds_hd_hold_ind;
    var hd_body = _ds_hd_hold_body;
    var cp_hold = _ds_cp_hold_from;
    var cp_mode = _ds_cp_hold_mode;
    var cp_marker = _ds_cp_hold_marker;
    var cp_lead = _ds_cp_hold_lead;
    var cp_scratch = _ds_cp_hold_scratch;
    var inl_closed = _ds_inl_last_start;
    var rg_from = _ds_rg_from;
    var rg_body = _ds_rg_body;
    var rg_kind = _ds_rg_kind;
    var rg_inner = _ds_rg_inner;
    var rg_end = _ds_rg_end;
    _ds_hd_hold_from = (0 - 1);
    _ds_cp_hold_from = (0 - 1);
    _ds_rg_from = (0 - 1);
    var hd_applied = 0;
    var cp_applied = 0;
    var n_temp = tokenbuf_count(temp_tb);
    var commit_count = n_temp;
    if (finishing == 0) {
        commit_count = 0;
        # The marker window applies to every grammar (2.8.0). Through
        # 2.7.1 the compose grammars were carved out: their streaming
        # rested on `prefix_hold`, which re-derived compose state from
        # outside the scanner and read the commit list as state, so
        # holding a token back broke it (three attempts in 2.4.0 each
        # regressed). Now the scanner itself reports unresolved compose
        # openers (`_ds_cp_hold_from`) and every finished compose region
        # as a group, and there is nothing left for the window to break.
        var max_marker = _stream_max_marker(g);
        var num_la = _stream_num_lookahead(g);
        var grp_i = 0;
        var i = 0;
        var stop = 0;
        while ((i < n_temp) && (stop == 0)) {
            var t_start = tokenbuf_start(temp_tb, i);
            var t_len   = tokenbuf_len(temp_tb, i);
            var t_kind  = tokenbuf_kind(temp_tb, i);
            var safe = 0;
            if (t_start + t_len < buf_len) { safe = 1; }
            # A token inside a group — a heredoc opener line through its
            # last body, a closed compose region (`_ds_grp_add`) — is
            # final, even at the buffer's end: the tail checks below
            # must not split a group, or the next scan would start
            # inside it and read the rest with the wrong grammar.
            while ((grp_i < _ds_grp_n) && (load64(_ds_grp_buf + grp_i * 16 + 8) <= t_start)) {
                grp_i = grp_i + 1;
            }
            var in_grp = 0;
            if (grp_i < _ds_grp_n) {
                var g_lo = load64(_ds_grp_buf + grp_i * 16);
                var g_hi = load64(_ds_grp_buf + grp_i * 16 + 8);
                if ((t_start >= g_lo) && (t_start + t_len <= g_hi)) {
                    in_grp = 1;
                    safe = 1;
                }
            }
            # ...and the whole marker window has to be in the buffer,
            # for EVERY kind, not just the longest-match tables. Any
            # token within `max_marker` of the tail may turn out to
            # be the first bytes of a rule opener once more input
            # arrives — that is how xml's `<!--` comment was lost.
            # Holds back at most `max_marker` bytes per drain.
            if ((in_grp == 0) && (t_start + max_marker > buf_len)) { safe = 0; }
            # A number the next bytes could still extend (`1` + `.5`).
            if ((in_grp == 0) && (t_kind == TK_NUMBER) && (t_start + t_len + num_la > buf_len)) { safe = 0; }
            # A pair token a longer opener could still claim is not
            # settled either, no matter where it ends — this is the
            # path that actually committed python's stray `""`.
            if ((in_grp == 0) && (_stream_pair_provisional(g, buf, buf_len, t_kind, t_start, t_len) == 1)) {
                safe = 0;
            }
            if (safe == 1) { commit_count = i + 1; }
            if (safe == 0) { stop = 1; }
            i = i + 1;
        }
        # A closed trailing token commits early — unless it starts inside
        # the marker window, where a longer opener may still claim it:
        # markdown's `` `` `` is a closed empty code span until a third
        # backtick makes it a fence (2.8.0; `prefix_hold` used to undo it).
        if ((commit_count < n_temp) && (n_temp > 0)) {
            if (tokenbuf_start(temp_tb, n_temp - 1) + max_marker <= buf_len) {
                if (_stream_is_trailing_complete(g, buf, buf_len, temp_tb, n_temp - 1) == 1) {
                    commit_count = n_temp;
                }
            }
        }
    }
    # Compose hold (2.8.0): nothing from an unresolved compose opener on
    # commits until it resolves, finish, or VYK_COMPOSE_HOLD_MAX — or,
    # for a region with an inner grammar, region mode takes it (below).
    if ((finishing == 0) && (cp_hold >= 0)) {
        if (buf_len - cp_hold > VYK_COMPOSE_HOLD_MAX) { store64(s + 280, 1); }
        if (buf_len - cp_hold <= VYK_COMPOSE_HOLD_MAX) {
            cp_applied = 1;
            var cp_done = 0;
            while ((commit_count > 0) && (cp_done == 0)) {
                var cplast = commit_count - 1;
                if (tokenbuf_start(temp_tb, cplast) + tokenbuf_len(temp_tb, cplast) <= cp_hold) { cp_done = 1; }
                if (cp_done == 0) { commit_count = commit_count - 1; }
            }
        }
    }
    # Here-document hold (ADR 0023). The scanner reports the lowest `<<`
    # whose heredoc it could not resolve in this buffer. Whether those
    # bytes are a heredoc body or code depends on input that has not
    # arrived — and once the opener line commits, the next drain re-scans
    # the body with no memory of the opener. So nothing from the `<<` on
    # commits until the terminator line (and its LF) is in the buffer,
    # or finish, or the hold passes VYK_HEREDOC_HOLD_MAX.
    if ((finishing == 0) && (hd_hold >= 0)) {
        if (buf_len - hd_hold > VYK_HEREDOC_HOLD_MAX) { store64(s + 280, 1); }
        if (buf_len - hd_hold <= VYK_HEREDOC_HOLD_MAX) {
            hd_applied = 1;
            var hd_done = 0;
            while ((commit_count > 0) && (hd_done == 0)) {
                var hlast = commit_count - 1;
                if (tokenbuf_start(temp_tb, hlast) + tokenbuf_len(temp_tb, hlast) <= hd_hold) { hd_done = 1; }
                if (hd_done == 0) { commit_count = commit_count - 1; }
            }
        }
    }
    # A resumable region (2.9.10, ADR 0032): the hold is a region still
    # open at the buffer's end whose body has an inner grammar. Commit
    # through its opener and read the body as that grammar's own stream,
    # rather than hold all of it until the end marker arrives. One level:
    # a region opened inside the body is held as before.
    var rg_enter = 0;
    if ((in_rg == 0) && (cp_applied == 1) && (hd_applied == 0) && (rg_from == cp_hold)) {
        # The opener is final once every marker that could claim its first
        # byte instead is in the buffer, as for any token (the window).
        var rg_mm = _stream_max_marker(g);
        if ((commit_count < n_temp) && (cp_hold + rg_mm <= buf_len)) {
            if (tokenbuf_start(temp_tb, commit_count) == cp_hold) {
                rg_enter = 1;
                if (rg_body > cp_hold) {
                    rg_enter = 0;
                    if (cp_hold + tokenbuf_len(temp_tb, commit_count) == rg_body) {
                        rg_enter = 1;
                        commit_count = commit_count + 1;
                    }
                }
            }
        }
        # While a token before the opener may still be waiting on bytes
        # past it (the window, a number's lookahead), entry waits: re-scan
        # at the next drain, a few bytes on. The end-marker watch would
        # hold the whole body again.
        var rg_la = _stream_num_lookahead(g);
        if (rg_mm > rg_la) { rg_la = rg_mm; }
        if ((rg_enter == 0) && (cp_hold + rg_la > buf_len)) { cp_mode = 0; }
    }
    # Count what actually landed, not what we attempted.
    # `tokenbuf_push` drops the token (rather than writing through a
    # NULL data pointer) when its buffer cannot grow — see
    # FINDING-002 in src/token.cyr. Incrementing `emitted`
    # unconditionally made drain over-report under that condition,
    # and `emitted` is what the caller uses to decide whether more
    # tokens are available. Comparing the count across the loop
    # keeps the return honest without giving `tokenbuf_push` a
    # status return it is not allowed to have (public surface).
    var before_push = tokenbuf_count(out_tb);
    var j = 0;
    while (j < commit_count) {
        tokenbuf_push(out_tb,
          tokenbuf_kind(temp_tb, j),
          abs_offset + tokenbuf_start(temp_tb, j),
          tokenbuf_len(temp_tb, j));
        j = j + 1;
    }
    emitted = emitted + (tokenbuf_count(out_tb) - before_push);
    if (rg_enter == 1) {
        _stream_region_end(s);
        _stream_compact(s, buf, rg_body);
        store64(s + 224, rg_kind);
        store64(s + 232, rg_inner);
        store64(s + 240, rg_end);
        return emitted + _stream_region_drain(s, out_tb);
    }
    # 2.0.3 — detect pending pair-rule state for the NEXT drain.
    # If a trailing partial pair-rule open is uncommitted, save
    # its rule index + how far we've already scanned the body.
    var new_pending = (0 - 1);
    var new_raw = 0;
    var new_resume2 = 0;
    if ((finishing == 0) && (commit_count < n_temp) && (n_temp > 0)) {
        var partial = commit_count;
        var p_kind  = tokenbuf_kind(temp_tb, partial);
        var p_start = tokenbuf_start(temp_tb, partial);
        var p_len   = tokenbuf_len(temp_tb, partial);
        # Under a compose hold the token at the hold point may be the
        # outer grammar's reading of an undecided opener (a fence read
        # as inline code): never pend it, or the pending fast path would
        # bypass the compose decision.
        var hold_overlaps = cp_applied;
        # Don't pin a pending rule while a LONGER same-kind opener
        # could still claim these bytes. `_stream_find_pair_rule`
        # only considers rules whose start marker fits inside the
        # partial token, so a lone trailing `\"` matches Python's
        # 1-byte `\"` rule even when the real opener is `\"\"\"`. The
        # next drain then took the pending fast path, found a close
        # one byte later, and emitted a 2-byte EMPTY string —
        # `tests/corpus/python.py`'s docstring came back as
        # `""` + body + `""`. This is the path that actually did it;
        # the commit loop never got a say.
        #
        # Leaving pending unset just means the bytes stay buffered
        # and get re-tokenized next drain, which is what we want.
        var pending_ambiguous = _stream_pair_provisional(g, buf, buf_len, p_kind, p_start, p_len);
        # Never pend a pair token that is ALREADY CLOSED. The
        # marker window can hold a complete token back from this
        # drain's commit list; without this check the pending logic
        # read that complete token as a partial OPEN and set
        # `scan_resume` to its full length — i.e. past its own close
        # marker. The next drain then scanned from beyond the close
        # and matched the NEXT quote instead.
        #
        # `tests/corpus/concept.rb`: ruby's `=begin` block-comment
        # marker makes max_marker 6, so a complete `'+'` sitting
        # within 6 bytes of the tail was held; resume jumped to 3,
        # past the closing quote at index 2, and the string ran on to
        # the next `'` 45 bytes later — swallowing
        # `then @pos += 1; return Token.new(PLUS,   `.
        if (_stream_is_trailing_complete(g, buf, buf_len, temp_tb, partial) == 1) {
            pending_ambiguous = 1;
        }
        # Nor a token that starts inside the marker window: its opener is
        # not settled — markdown's `` `` `` at a feed's end is inline code
        # until a third backtick makes it a fence (2.8.0; `prefix_hold`
        # used to cover this one case for compose grammars).
        if (p_start + _stream_max_marker(g) > buf_len) {
            pending_ambiguous = 1;
        }
        # Nor an inline literal (ADR 0030) the scan has closed: its first
        # bytes may be a pair's start — Lua's `--[==[…]==]` read as an
        # open `--` comment pended to the end of its line.
        if (p_start == inl_closed) { pending_ambiguous = 1; }
        # Nor a verbatim string closed on the buffer's last byte (2.9.12): it
        # is closed, and whether it goes on is the next byte's to say — a
        # re-scan, not a search for a close. Closed when its quotes, after
        # the prefix, are even in number: the opener, each `""`, the close.
        if ((pending_ambiguous == 0) && (p_kind == TK_STRING) && (p_start + p_len == buf_len)) {
            var vpl = _ds_sym_prefix(g, buf, buf_len, p_start);
            if ((vpl > 0) && (_ds_sym_raw == 1)) {
                var vq = 0;
                var vk = p_start + vpl;
                while (vk < p_start + p_len) {
                    if (load8(buf + vk) == 34) { vq = vq + 1; }
                    vk = vk + 1;
                }
                if ((vq % 2) == 0) { pending_ambiguous = 1; }
            }
        }
        # Nor a line rule's token: line rules run before pairs (note 002),
        # so a `--` comment whose text begins `--[[` is no open `--[[`
        # pair — pending it ran the comment on to `]]` (2.9.12 audit,
        # reviewer D).
        if (pending_ambiguous == 0) {
            var lprev = (0 - 1);
            if (p_start > 0) { lprev = load8(buf + p_start - 1); }
            if ((p_start == 0) && (mid_stream > 0)) { lprev = load64(s + 96); }
            if (_ds_try_line_rules(g, buf, buf_len, p_start, lprev) != 0) { pending_ambiguous = 1; }
        }
        if ((hold_overlaps == 0) && (pending_ambiguous == 0) &&
          ((p_kind == TK_STRING) || (p_kind == TK_COMMENT) || (p_kind == TK_PREPROCESSOR))) {
            var rule_idx = _stream_find_pair_rule(g, buf, p_start, p_len, p_kind);
            var p_pl = 0;
            if ((rule_idx < 0) && (p_kind == TK_STRING)) {
                p_pl = _stream_str_prefix(g, buf, p_start, p_len);
                if (p_pl > 0) {
                    new_raw = _stream_pre_raw;
                    rule_idx = _stream_find_pair_rule(g, buf, p_start + p_pl, p_len - p_pl, p_kind);
                }
            }
            if (rule_idx >= 0) {
                new_pending = rule_idx;
                var rule_r = vec_get(grammar_pair_rules(g), rule_idx);
                var endp_r = pair_rule_end(rule_r);
                var elen_r = strlen(endp_r);
                var slen_r = strlen(pair_rule_start(rule_r));
                new_resume2 = p_len;
                if (elen_r > 0) {
                    if (new_resume2 > elen_r - 1) { new_resume2 = new_resume2 - (elen_r - 1); }
                }
                # Same escape-run back-off as the still-pending branch
                # above. Through 2.5.1 only that branch had it, so a
                # string whose FIRST pending drain ended on `\` resumed
                # past the backslash and closed on the escaped quote:
                # json `{"a":"x\"y"}` split after the `\` came back as
                # `"x\"` + `y` + a string running to EOF. 2.3.4's
                # P1-3 fix by a second path; 2.5.2 audit P1-3.
                var esc_r = pair_rule_escape(rule_r);
                if (new_raw == 1) { esc_r = 0; }
                if (esc_r != 0) {
                    while ((new_resume2 > p_pl + slen_r) &&
                      (load8(buf + p_start + new_resume2 - 1) == esc_r)) {
                        new_resume2 = new_resume2 - 1;
                    }
                }
                if (new_resume2 < p_pl + slen_r) { new_resume2 = p_pl + slen_r; }
            }
        }
    }
    store64(s + 72, new_pending);
    store64(s + 168, new_raw);
    store64(s + 80, new_resume2);
    var consumed = 0;
    if (commit_count > 0) {
        var last = commit_count - 1;
        consumed = tokenbuf_start(temp_tb, last) + tokenbuf_len(temp_tb, last);
    }
    # Arm the heredoc watch (fast path at the top of this function) when
    # this drain held for a terminator that has not arrived. Offsets are
    # rebased past the bytes about to be compacted away.
    if (hd_applied == 1) {
        # A delimiter that quote removal rewrote (`<<"E"OF`, `<<E\OF`) is
        # not in the buffer: copy it — at most DS_HD_DELIM_MAX bytes —
        # so it gets the terminator watch too. Through 2.9.0 such a hold
        # got either a garbage offset (a watch reading outside the
        # buffer) or no watch at all, and every later drain re-scanned:
        # 960 KB in 4 KB chunks took 10.8 s (2.9.1 audit, reviewers A, B).
        var hd_copied = 0;
        if ((hd_fast == 1) && (hd_dpos < 0) && (hd_dlen < 256) && (_ds_hd_hold_dptr != 0)) {
            if (load64(s + 192) == 0) { store64(s + 192, alloc(512)); }
            if (load64(s + 192) != 0) {
                memcpy(load64(s + 192), _ds_hd_hold_dptr, hd_dlen);
                hd_copied = 1;
            }
        }
        var hd_armed = 0;
        if ((hd_fast == 1) && ((hd_dpos >= consumed) || (hd_copied == 1)) && (hd_body >= consumed)) {
            hd_armed = 1;
            store64(s + 104, 1);
            store64(s + 112, hd_dpos - consumed);
            if (hd_copied == 1) { store64(s + 112, (0 - 1)); }
            store64(s + 120, hd_dlen);
            store64(s + 128, hd_ind);
            store64(s + 136, hd_body - consumed);
            store64(s + 176, hd_body - consumed);
        }
        if ((hd_armed == 0) && (hd_fast != 3)) {
            # Mode 2: only a line break after the bytes already seen can
            # change the verdict. (Also when a mode-1 watch could not be
            # armed: through 2.9.0 that hold got no watch at all.)
            store64(s + 104, 2);
            store64(s + 136, buf_len - consumed);
        }
        if (hd_fast == 3) {
            # A string spanning lines keeps the opener line open: wait for
            # its close marker, not for each line break inside it.
            store64(s + 104, 3);
            store64(s + 112, _ds_hd_hold_marker);
            store64(s + 200, 0);
            store64(s + 208, _ds_hd_hold_esc);
            var hmr = (buf_len - consumed) - (strlen(_ds_hd_hold_marker) - 1);
            if (hmr < hd_hold - consumed) { hmr = hd_hold - consumed; }
            store64(s + 136, hmr);
        }
        store64(s + 144, hd_hold - consumed);
        store64(s + 184, VYK_HEREDOC_HOLD_MAX);
    }
    if ((cp_applied == 1) && (hd_applied == 0)) {
        # Compose hold watch (2.8.0): mode 2 waits for a line break (a
        # fence's info line), 3 for the closing marker anywhere in the new
        # bytes — backed off by its length less one, in case it straddles
        # this feed's end — 4 for finish (a region with no `end_before`).
        var cpl = buf_len - consumed;
        store64(s + 104, cp_mode);
        if (cp_mode == 2) { store64(s + 136, cpl); }
        # An inline literal's closer (ADR 0030) is scanner scratch: watch
        # the stream's own copy of it (+192, shared with mode 1's
        # delimiter copy — one watch at a time), or not at all.
        if ((cp_mode == 3) && (cp_scratch == 1)) {
            var cpc = 0;
            if (strlen(cp_marker) < 512) {
                if (load64(s + 192) == 0) { store64(s + 192, alloc(512)); }
                cpc = load64(s + 192);
            }
            if (cpc == 0) {
                cp_mode = 0;
                store64(s + 104, 0);
            }
            if (cpc != 0) {
                memcpy(cpc, cp_marker, strlen(cp_marker) + 1);
                cp_marker = cpc;
            }
        }
        if (cp_mode == 3) {
            store64(s + 112, cp_marker);
            store64(s + 200, cp_lead);
            store64(s + 208, 0);
            var cpr = cpl - (strlen(cp_marker) - 1);
            if (cpr < cp_hold - consumed) { cpr = cp_hold - consumed; }
            store64(s + 136, cpr);
        }
        store64(s + 144, cp_hold - consumed);
        store64(s + 184, VYK_COMPOSE_HOLD_MAX);
    }
    # Arm the run watch: exactly one token is left, it reaches the end of
    # the buffer, and nothing else is watching.
    if ((finishing == 0) && (hd_applied == 0) && (cp_applied == 0) && (new_pending < 0) && (load64(s + 104) == 0)) {
        # A long number whose last byte so far is a separator (`…1_`): the
        # separator is a token of its own until a digit follows, so two are
        # left. Watch the number's run from the separator on (2.9.12 audit,
        # reviewer B: `1` + `_1` x 256K in 64-byte chunks, 23 s).
        if ((n_temp > 1) && (commit_count == n_temp - 2) && (grammar_number_sep(g) > 0)) {
            var ns_s = tokenbuf_start(temp_tb, n_temp - 1);
            var nn_s = tokenbuf_start(temp_tb, n_temp - 2);
            var nn_l = tokenbuf_len(temp_tb, n_temp - 2);
            if ((ns_s == buf_len - 1) && (nn_s + nn_l == ns_s) && (load8(buf + ns_s) == grammar_number_sep(g))) {
                if (tokenbuf_kind(temp_tb, n_temp - 2) == TK_NUMBER) {
                    var nrc = _stream_run_class(g, buf, TK_NUMBER, nn_s, nn_l);
                    if ((nrc == 4) || (nrc == 5)) {
                        store64(s + 152, nrc);
                        store64(s + 160, buf_len - consumed);
                    }
                }
            }
        }
        if ((n_temp > 0) && (commit_count == n_temp - 1)) {
            var lt_s = tokenbuf_start(temp_tb, n_temp - 1);
            var lt_l = tokenbuf_len(temp_tb, n_temp - 1);
            if (lt_s + lt_l == buf_len) {
                var rcls = _stream_run_class(g, buf, tokenbuf_kind(temp_tb, n_temp - 1), lt_s, lt_l);
                # A shebang line runs to its line break as a line rule does
                # (2.9.12 audit, reviewer B: `#!` + 1 MB in 64-byte chunks
                # took 11 s).
                if ((rcls == 0) && (mid_stream == 0) && (lt_s == 0) && (lt_l >= VYK_RUN_WATCH_MIN)) {
                    if ((tokenbuf_kind(temp_tb, n_temp - 1) == TK_PREPROCESSOR) && (grammar_shebang_on(g) == 1)) {
                        if ((load8(buf) == 35) && (load8(buf + 1) == 33)) { rcls = 1; }
                    }
                }
                if (rcls != 0) {
                    store64(s + 152, rcls);
                    store64(s + 160, buf_len - consumed);
                }
            }
        }
    }
    _stream_compact(s, buf, consumed);
    return emitted;
}

# Drop the buffer's first `n` bytes: committed. Remembers the last two
# for the next scan's look-behind (ADR 0022, 2.9.3) and rebases a
# resumable region's search (2.9.10).
fn _stream_compact(s, buf, n) {
    if (n <= 0) { return 0; }
    if (load64(s + 224) != 0) {
        # A region's first body commit: the body has no bytes before it, as
        # a single feed's nested scan of it sees — not the opener's (2.9.12
        # audit, reviewer B).
        if (load64(s + 272) == 0) { store64(s + 96, (0 - 1)); }
    }
    _stream_save_prev(s, buf, n);
    var len = load64(s + 8);
    var k = n;
    var dst = 0;
    while (k < len) {
        store8(buf + dst, load8(buf + k));
        dst = dst + 1;
        k = k + 1;
    }
    store64(s + 8, len - n);
    store64(s + 48, load64(s + 48) + n);
    if (load64(s + 224) != 0) {
        store64(s + 256, load64(s + 256) - n);
        store64(s + 272, load64(s + 272) + n);
    }
    return 0;
}

# ── Resumable regions (2.9.10, ADR 0032) ─────
# A compose body still open at the buffer's end is read as its inner
# grammar's own stream: `_stream_drain_g` with that grammar over the
# body, so the live buffer and the work per feed are the inner
# grammar's, not the region's. Each drain looks for the end marker in
# the new bytes FIRST — once it is in, the body ends there whatever the
# inner grammar was waiting for: the body commits as that grammar's
# finish over it, then the marker, and the rest drains with the outer
# grammar. Until then the body drains no further than the earliest
# place the marker could still start: those bytes may not be body.

# Leave region mode, and the inner grammar's watches and pending pair.
fn _stream_region_end(s) {
    store64(s + 72, (0 - 1));
    store64(s + 80, 0);
    store64(s + 168, 0);
    store64(s + 104, 0);
    store64(s + 152, 0);
    store64(s + 224, 0);
    store64(s + 232, 0);
    store64(s + 240, 0);
    store64(s + 248, 0);
    store64(s + 256, 0);
    store64(s + 264, 0);
    store64(s + 272, 0);
    return 0;
}

# Drain the body's first `lim` bytes with the inner grammar. The scan
# NUL-terminates at `lim`; the byte there is still input, so put it back.
fn _stream_region_body(s, out_tb, inner, lim, fin) {
    var buf = load64(s);
    var save = load8(buf + lim);
    var a0 = load64(s + 48);
    var em = _stream_drain_g(s, out_tb, inner, lim, fin, 1);
    store8(buf + lim - (load64(s + 48) - a0), save);
    return em;
}

fn _stream_region_drain(s, out_tb) {
    var buf = load64(s);
    var len = load64(s + 8);
    var rk = load64(s + 224);
    var inner = load64(s + 232);
    var endp = load64(s + 240);
    var elen = 0;
    if (endp != 0) { elen = strlen(endp); }
    var q = load64(s + 256);
    if (q < 0) { q = 0; }
    var found = (0 - 1);
    # Kind 5 (`end_blank`, 2.9.12): a line break that a line of only blanks
    # and its own line break follow. `bl` is where one could still be: a
    # line break whose blank line the buffer cuts short.
    var bl = len;
    if (rk == 5) {
        var bgo = 1;
        while ((bgo == 1) && (q < len)) {
            if (load8(buf + q) == 10) {
                var bk = q + 1;
                while ((bk < len) && (_ds_is_blank_cr(load8(buf + bk)) == 1)) { bk = bk + 1; }
                if ((bk < len) && (load8(buf + bk) == 10)) {
                    found = q;
                    bgo = 0;
                }
                if (bk >= len) {
                    bl = q;
                    bgo = 0;
                }
            }
            if (bgo == 1) { q = q + 1; }
        }
        store64(s + 256, q);
    }
    if ((rk != 4) && (rk != 5)) {
        while ((found < 0) && (q + elen <= len)) {
            if (memeq(buf + q, endp, elen) == 1) { found = q; }
            if (found < 0) { q = q + 1; }
        }
        store64(s + 256, q);
    }
    if (found >= 0) {
        var em = _stream_region_body(s, out_tb, inner, found, 1);
        # A `compose_region` leaves its `end_before` (or blank line) to the
        # outer grammar.
        if ((rk != 3) && (rk != 5)) {
            var pb = tokenbuf_count(out_tb);
            tokenbuf_push(out_tb, TK_PUNCTUATION, load64(s + 48), elen);
            em = em + (tokenbuf_count(out_tb) - pb);
        }
        _stream_region_end(s);
        if ((rk != 3) && (rk != 5)) { _stream_compact(s, buf, elen); }
        return em + tokenize_stream_drain(s, out_tb);
    }
    if (load64(s + 32) == 1) {
        # No end marker: the body runs to the end of the input.
        var fe = _stream_region_body(s, out_tb, inner, len, 1);
        _stream_region_end(s);
        return fe;
    }
    # Where the marker could still start: the earliest tail of the buffer
    # that begins it.
    var lim = len;
    if (rk == 5) { lim = bl; }
    if ((rk != 4) && (rk != 5)) {
        var p = q;
        while ((p < len) && (lim == len)) {
            if (memeq(buf + p, endp, len - p) == 1) { lim = p; }
            if (lim == len) { p = p + 1; }
        }
    }
    return _stream_region_body(s, out_tb, inner, lim, 0);
}

# Mark the stream as finished and emit every remaining token
# into `out_tb`. After finish, feed returns VYK_ERR_FINISHED;
# drain becomes a no-op (cursor == buf_len after the final
# compaction).
fn tokenize_stream_finish(s, out_tb) {
    if (s == 0) { return 0; }
    if (load64(s + 32) == 1) { return 0; }
    store64(s + 32, 1);
    return tokenize_stream_drain(s, out_tb);
}

# ── Stream state, saved and compared (2.9.11, ADR 0033) ──
# A document (src/tokenize_doc.cyr) restarts a stream from a state it
# saved and stops when a later state equals a saved one. The state is
# the fields +72 … +272 (STREAM_STATE_SIZE bytes, copied as laid out),
# the live buffer — input bytes, from abs_offset for buf_len bytes — and
# whether abs_offset is past 0. The stream's own buffers (+88 scratch,
# +192 copy) are not state; a state that keeps a string in +192 (a
# rewritten heredoc delimiter, an inline literal's closer) is not saved.
var STREAM_STATE_SIZE = 208;

# A freshly made stream's fields, keeping its buffers and grammar.
fn _stream_reset(s) {
    store64(s + 8, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 64, 0);
    var off = 72;
    while (off <= 272) {
        if ((off != 88) && (off != 192)) { store64(s + off, 0); }
        off = off + 8;
    }
    store64(s + 72, (0 - 1));
    store64(s + 96, (0 - 1));
    store64(s + 216, (0 - 1));
    store64(s + 280, 0);
    store64(s + 288, 0);
    _tokenbuf_reset(load64(s + 56));
    return 0;
}

# 1 if the state can be saved: nothing in it lives in the +192 buffer.
fn _stream_state_ok(s) {
    var wm = load64(s + 104);
    if ((wm == 1) && (load64(s + 112) < 0)) { return 0; }
    if ((wm == 3) && (load64(s + 192) != 0) && (load64(s + 112) == load64(s + 192))) { return 0; }
    return 1;
}

fn _stream_state_save(s, dst) {
    var off = 72;
    while (off <= 272) {
        store64(dst + off - 72, load64(s + off));
        off = off + 8;
    }
    return 0;
}

fn _stream_state_load(s, src) {
    var off = 72;
    while (off <= 272) {
        if ((off != 88) && (off != 192)) { store64(s + off, load64(src + off - 72)); }
        off = off + 8;
    }
    return 0;
}

# 1 if `s`'s fields equal a saved state's, in every field a drain reads:
# the look-behind always; the pending pair, the watch, the run watch and
# the region only while each is on (a field left over from an earlier
# one is never read); a region's committed-body count only as zero or
# not. The caller compares where the buffer sits.
fn _stream_state_same(s, st) {
    if (load64(s + 96) != load64(st + 24)) { return 0; }
    if (load64(s + 216) != load64(st + 144)) { return 0; }
    var pend = load64(s + 72);
    if (pend != load64(st)) { return 0; }
    if (pend >= 0) {
        if (load64(s + 80) != load64(st + 8)) { return 0; }
        if (load64(s + 168) != load64(st + 96)) { return 0; }
    }
    var wm = load64(s + 104);
    if (wm != load64(st + 32)) { return 0; }
    if (wm != 0) {
        var off = 112;
        while (off <= 208) {
            if ((off <= 144) || (off == 176) || (off == 184) || (off == 200) || (off == 208)) {
                if (load64(s + off) != load64(st + off - 72)) { return 0; }
            }
            off = off + 8;
        }
    }
    var rc = load64(s + 152);
    if (rc != load64(st + 80)) { return 0; }
    if ((rc != 0) && (load64(s + 160) != load64(st + 88))) { return 0; }
    var rk = load64(s + 224);
    if (rk != load64(st + 152)) { return 0; }
    if (rk != 0) {
        var ro = 232;
        while (ro <= 264) {
            if (load64(s + ro) != load64(st + ro - 72)) { return 0; }
            ro = ro + 8;
        }
        var ra = 0;
        if (load64(s + 272) > 0) { ra = 1; }
        var rb = 0;
        if (load64(st + 200) > 0) { rb = 1; }
        if (ra != rb) { return 0; }
    }
    return 1;
}

# ── Pull adapter (2.0.2+) ────────────────────
# Iterator-style wrapper over the push primitive. Each call to
# tokenize_stream_next(s) advances the internal cursor by one
# token, refilling the staging tokenbuf via `_drain` if
# exhausted. Read the just-advanced-to token with the trio of
# stream-level accessors.
#
# Typical use:
#
#     var s = tokenize_stream_new("rust");
#     # push bytes (one or more times)
#     tokenize_stream_feed(s, src, n);
#     tokenize_stream_finish(s, 0);   # drain happens internally
#     while (tokenize_stream_next(s) == 1) {
#         var k = tokenize_stream_kind(s);
#         var p = tokenize_stream_start(s);
#         var l = tokenize_stream_len(s);
#         # ... use the token ...
#     }
#     tokenize_stream_free(s);
#
# The `0` arg to `_finish` (and `_drain`) signals "no
# caller-supplied tokenbuf; drain to the staging tokenbuf".
# For interleaved feed + iterate flows, the caller can call
# `_next` between feeds without ever calling `_finish` until
# they're done with input.

# Advance to the next token. If the staging tokenbuf is
# exhausted, drains into it from the underlying push primitive.
# Returns 1 if a token is now current (use _kind / _start /
# _len to read it); returns 0 if no token is available right
# now — caller should feed more bytes (then retry) or call
# `_finish` and retry to consume any final tokens.
fn tokenize_stream_next(s) {
    if (s == 0) { return 0; }
    var staging = load64(s + 56);
    # After `_free` the staging tokenbuf is 0; this read it (2.5.2
    # audit P3 — the `_stream_cur_ok` note below said `_next` was
    # already guarded; it guarded `s` only).
    if (staging == 0) { return 0; }
    var idx = load64(s + 64);
    if (idx >= tokenbuf_count(staging)) {
        # Try to refill via drain. If finish has run, drain is a
        # no-op; the caller has reached EOF.
        tokenize_stream_drain(s, staging);
        if (idx >= tokenbuf_count(staging)) { return 0; }
    }
    store64(s + 64, idx + 1);
    return 1;
}

# Read the kind of the *current* token (the one most recently
# returned by `_next == 1`). Calling before the first successful
# `_next`, or after `_free`, is a caller error and yields 0 — it
# used to yield a crash.
#
# `_next` already guards `s == 0` and `_discard_consumed` already
# guards `staging == 0` (2.1.5 audit); these three accessors were
# the gap. Unguarded they did `load64(0 + 56)` on a NULL stream,
# `tokenbuf_kind(0, ...)` on a freed one, and — before the first
# `_next` — indexed `idx = -1`, reading 12 bytes BEFORE the
# tokenbuf allocation. Returning 0 cannot break a correct consumer,
# which by definition never reaches these paths.
fn _stream_cur_ok(s) {
    if (s == 0) { return 0; }
    if (load64(s + 56) == 0) { return 0; }
    if (load64(s + 64) <= 0) { return 0; }
    return 1;
}

fn tokenize_stream_kind(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_kind(staging, idx);
}

fn tokenize_stream_start(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_start(staging, idx);
}

fn tokenize_stream_len(s) {
    if (_stream_cur_ok(s) == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_len(staging, idx);
}

# Drop tokens already iterated past via `_next` from the
# pull-adapter's internal staging tokenbuf (2.1.4+). For long-
# running streams (millions of tokens), the staging grows
# monotonically by default — calling this periodically keeps
# the memory footprint bounded by "tokens iterated since last
# discard" instead of "all tokens since stream creation".
#
# After the call, `_next` continues from the (now-zero) cursor;
# subsequent `_next` calls drain into a smaller staging that's
# trimmed to just the un-iterated tail.
#
# No-op if no tokens have been iterated yet.
fn tokenize_stream_discard_consumed(s) {
    if (s == 0) { return 0; }
    var staging = load64(s + 56);
    # Defensive (2.1.5 audit recommendation): guard against
    # use-after-free where `_free` zeroed the staging field.
    # Without this `tokenbuf_drop_front(0, ...)` would crash on
    # `load64(tb + 8)`. Cheap one-line check; matches the null-
    # safety pattern in the rest of the streaming primitive.
    if (staging == 0) { return 0; }
    var cur = load64(s + 64);
    var consumed = cur - load64(s + 288);
    if (consumed <= 0) { return 0; }
    # Dropped at once, moved lazily: the tokens behind the cursor are
    # counted as dropped (+288) and the rest is moved down only once they
    # are half the staging — through 2.9.11 every call moved all of it, so
    # a call after each `_next` was quadratic: 256 KB of python, 15.8 s
    # (2.9.12 audit, reviewer B).
    if (cur * 2 >= tokenbuf_count(staging)) {
        tokenbuf_drop_front(staging, cur);
        store64(s + 64, 0);
        store64(s + 288, 0);
        return consumed;
    }
    store64(s + 288, cur);
    return consumed;
}

# ── Internal: M1 hand-coded shell path ────────
# Retained as a regression oracle for `vyk --handcoded` and
# smoke.sh's byte-identical diff check. NOT part of the public
# 2.0+ API surface — diagnostics only.

fn tokenize_source_handcoded(src, lang) {
    return _vyk_handcoded(src, strlen(src), lang);
}

# Length-taking form for callers that hold the byte count. The CLI
# uses this: `tokenize_source_handcoded` measures with `strlen`, so
# `vyk --handcoded` on a file with a NUL byte covered only the bytes
# before it and still exited 0 — 6 of 11 bytes for `echo a\0b c\n`
# (2.5.2 audit P3-d). The 2-arg form keeps its signature: it ships in
# the bundle, diagnostics-only or not.
fn _vyk_handcoded(src, n, lang) {
    if (lang == 0) { return 0; }
    if (streq(lang, "shell") == 1) {
        var tb = tokenbuf_new();
        if (tb == 0) { return 0; }
        tokenize_shell(src, n, tb);
        return tb;
    }
    return 0;
}

# Release the stream's internal buffer. The caller-owned tokenbuf
# (passed to drain/finish) is NOT freed — it's the caller's
# responsibility. Stream handle is invalid after free.
fn tokenize_stream_free(s) {
    if (s == 0) { return 0; }
    # No-op for the buffer alloc — Cyrius's bump allocator doesn't
    # free individual allocations. Future allocator backends can
    # free the buf here.
    store64(s,      0);
    store64(s + 8,  0);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);   # staging_tb (2.0.2)
    store64(s + 64, 0);   # next_idx
    store64(s + 88, 0);   # scratch_tb (2.5.2)
    store64(s + 96, 0);   # last committed byte (2.6.0)
    store64(s + 104, 0);  # watch mode (2.6.0)
    store64(s + 112, 0);
    store64(s + 120, 0);
    store64(s + 128, 0);
    store64(s + 136, 0);
    store64(s + 144, 0);  # hold start (2.6.2)
    store64(s + 152, 0);  # run watch (2.8.0)
    store64(s + 160, 0);
    store64(s + 168, 0);
    store64(s + 176, 0);
    store64(s + 184, 0);
    store64(s + 192, 0);  # delimiter copy (2.9.1)
    store64(s + 200, 0);  # mode-3 lead (2.9.1)
    store64(s + 208, 0);  # mode-3 escape (2.9.1)
    store64(s + 216, 0);  # byte before the last committed one (2.9.3)
    store64(s + 224, 0);  # resumable region (2.9.10)
    store64(s + 232, 0);
    store64(s + 240, 0);
    store64(s + 248, 0);
    store64(s + 256, 0);
    store64(s + 264, 0);
    store64(s + 272, 0);
    store64(s + 280, 0);  # hold bound passed (2.9.12)
    store64(s + 288, 0);  # staging dropped (2.9.12)
    # pending_idx's "none" sentinel is -1, NOT 0 — 0 is a valid
    # pair-rule index. Every other field here poisons safely to 0,
    # and two call sites lean on that ("_free zeroes every field"
    # in _vyk_stream_grow; the staging guard in _discard_consumed), so
    # this one must poison to its own inert value or the poison
    # contract is a half-truth. Currently unreachable — drain's
    # `buf_len == 0` early return and _vyk_stream_grow's `cap <= 0`
    # guard both fire first on a freed record — but relaxing
    # either would expose vec_get(pair_rules, 0) on a NULL grammar.
    store64(s + 72, (0 - 1));   # pending_idx (2.0.3)
    store64(s + 80, 0);   # scan_resume
    return 0;
}
