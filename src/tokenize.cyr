# vyakarana — public tokenizer entry (streaming, 2.0+)
#
# 2.0.0 broke the 1.x `tokenize_source(src, lang)` synchronous
# entry. The new contract is push-based: the consumer creates a
# stream tied to a grammar, feeds chunks of bytes, and drains
# tokens as they're available.
#
# 2.0.1 implementation: rolling-buffer streaming via the
# rescan-and-commit pattern. Each drain re-runs the existing
# scanner over the current buffer, commits every token whose
# extent is fully present (those whose end < buf_len plus any
# trailing pair-rule token whose close marker is at its tail),
# and compacts the buffer by sliding unconsumed bytes to offset
# 0. abs_offset tracks how many bytes have already been
# committed so token starts emit absolute. finish() lifts the
# "drop trailing partial" rule and commits everything to EOF.
#
# Cost: O(buf_len) scan per drain. For many small chunks that's
# O(N²) total work over an N-byte stream — accept for 2.0.1's
# minimal-state-machine implementation. A future optimization
# would track scanner state explicitly so drain only scans new
# bytes since the previous commit.
#
# A pull adapter (`tokenize_stream_next`) is queued for 2.0.2.
#
# Stream layout (heap-allocated; opaque to callers):
#
#    0  buf_ptr     ptr to growable byte buffer
#    8  buf_len     i64 — bytes written so far (relative to buf_ptr[0])
#   16  buf_cap     i64 — current allocation size
#   24  grammar     ptr to grammar record (looked up at _new)
#   32  finished    i64  (0 / 1) — set by tokenize_stream_finish
#   40  cursor      i64 — buffer-relative position of next byte to scan
#                          (always 0 in 2.0.1 because compaction follows
#                          every commit, but kept distinct for clarity)
#   48  abs_offset  i64 — absolute offset of buf_ptr[0] in the original
#                          stream. Increments by `consumed` after each
#                          drain compaction. Tokens emit with
#                          start = abs_offset + relative_start.
#   56  staging_tb  ptr — internal tokenbuf used by the pull adapter
#                          (`tokenize_stream_next`). Drains land here
#                          when the consumer iterates instead of
#                          providing an out_tb to drain/finish.
#   64  next_idx    i64 — pull-adapter cursor: index of the *current*
#                          staging token + 1 (i.e., the next one to
#                          return). After advance(), use _kind / _start
#                          / _len to read the just-advanced-to token.
#   72  pending_idx i64 — index of the open pair rule whose close we're
#                          waiting for. `-1` when no pending pair. After
#                          a drain detects a trailing partial pair, this
#                          is set; subsequent drains skip directly to
#                          the close-marker scan instead of re-running
#                          the full scanner over the open-pair body.
#                          See 2.0.3 §Pending pair-rule tracking.
#   80  scan_resume i64 — buffer offset to resume close-marker scanning
#                          from. Advances each drain so we never re-
#                          scan body bytes already known not to contain
#                          the close marker — drops O(N²) → O(N) for
#                          big-partial cases.
#   -----
#   88 bytes total
#
# Bundled into `dist/vyakarana.cyr`. Public symbols:
#   tokenize_stream_new
#   tokenize_stream_feed
#   tokenize_stream_drain
#   tokenize_stream_finish
#   tokenize_stream_free
#   has_grammar
#   list_languages_into
#   bootstrap_grammars
#
# Removed in 2.0.0 (no compat shim):
#   tokenize_source
#   tokenize_source_handcoded
#
# See `docs/adr/0017-streaming-api.md` for the design rationale
# and the migration recipe for 1.x consumers.

include "src/token.cyr"
include "src/grammar.cyr"
include "src/grammars/shell.cyr"
include "src/grammars/default_scanner.cyr"

# Initial buffer allocation; grows as needed.
var VYK_STREAM_INIT_CAP = 4096;
# Hard upper bound on the *live* (unconsumed) buffer at any one
# point. 2.0.1's rolling buffer compacts after every drain, so
# the cap effectively bounds the longest in-progress span (block
# comment, multi-line string, fence body) rather than the total
# input size. Total input can exceed this freely.
var VYK_STREAM_CAP = 16777216;

var STREAM_REC_SIZE = 88;

# Error codes returned by tokenize_stream_feed.
var VYK_OK            = 0;
var VYK_ERR_OVERFLOW  = (0 - 1);   # cap exceeded
var VYK_ERR_FINISHED  = (0 - 2);   # feed after finish

var _grammars_bootstrapped = 0;

# Load every bundled grammar on first use. Idempotent.
fn bootstrap_grammars() {
    if (_grammars_bootstrapped == 1) { return 0; }
    _grammars_bootstrapped = 1;
    var gs = grammar_load("grammars/shell.cyml");
    if (gs != 0) { registry_add(gs); }
    var gt = grammar_load("grammars/toml.cyml");
    if (gt != 0) { registry_add(gt); }
    var gj = grammar_load("grammars/json.cyml");
    if (gj != 0) { registry_add(gj); }
    var gc = grammar_load("grammars/cyrius.cyml");
    if (gc != 0) { registry_add(gc); }
    var gr = grammar_load("grammars/rust.cyml");
    if (gr != 0) { registry_add(gr); }
    var gy = grammar_load("grammars/yaml.cyml");
    if (gy != 0) { registry_add(gy); }
    var gm = grammar_load("grammars/markdown.cyml");
    if (gm != 0) { registry_add(gm); }
    var gcc = grammar_load("grammars/c.cyml");
    if (gcc != 0) { registry_add(gcc); }
    var gts = grammar_load("grammars/typescript.cyml");
    if (gts != 0) { registry_add(gts); }
    var gjs = grammar_load("grammars/javascript.cyml");
    if (gjs != 0) { registry_add(gjs); }
    var gpy = grammar_load("grammars/python.cyml");
    if (gpy != 0) { registry_add(gpy); }
    var ggo = grammar_load("grammars/go.cyml");
    if (ggo != 0) { registry_add(ggo); }
    var gzig = grammar_load("grammars/zig.cyml");
    if (gzig != 0) { registry_add(gzig); }
    var gasm86 = grammar_load("grammars/asm_x86_64.cyml");
    if (gasm86 != 0) { registry_add(gasm86); }
    var gasmarm = grammar_load("grammars/asm_aarch64.cyml");
    if (gasmarm != 0) { registry_add(gasmarm); }
    var gjava = grammar_load("grammars/java.cyml");
    if (gjava != 0) { registry_add(gjava); }
    var gkt = grammar_load("grammars/kotlin.cyml");
    if (gkt != 0) { registry_add(gkt); }
    var gcpp = grammar_load("grammars/cpp.cyml");
    if (gcpp != 0) { registry_add(gcpp); }
    var gcs = grammar_load("grammars/csharp.cyml");
    if (gcs != 0) { registry_add(gcs); }
    var gphp = grammar_load("grammars/php.cyml");
    if (gphp != 0) { registry_add(gphp); }
    var grb = grammar_load("grammars/ruby.cyml");
    if (grb != 0) { registry_add(grb); }
    var glua = grammar_load("grammars/lua.cyml");
    if (glua != 0) { registry_add(glua); }
    var gswift = grammar_load("grammars/swift.cyml");
    if (gswift != 0) { registry_add(gswift); }
    var gex = grammar_load("grammars/elixir.cyml");
    if (gex != 0) { registry_add(gex); }
    var gml = grammar_load("grammars/ocaml.cyml");
    if (gml != 0) { registry_add(gml); }
    var ghs = grammar_load("grammars/haskell.cyml");
    if (ghs != 0) { registry_add(ghs); }
    var gsql = grammar_load("grammars/sql.cyml");
    if (gsql != 0) { registry_add(gsql); }
    var ggql = grammar_load("grammars/graphql.cyml");
    if (ggql != 0) { registry_add(ggql); }
    var gpb = grammar_load("grammars/protobuf.cyml");
    if (gpb != 0) { registry_add(gpb); }
    var ghtml = grammar_load("grammars/html.cyml");
    if (ghtml != 0) { registry_add(ghtml); }
    var gxml = grammar_load("grammars/xml.cyml");
    if (gxml != 0) { registry_add(gxml); }
    var gcss = grammar_load("grammars/css.cyml");
    if (gcss != 0) { registry_add(gcss); }
    var gscss = grammar_load("grammars/scss.cyml");
    if (gscss != 0) { registry_add(gscss); }
    var gdf = grammar_load("grammars/dockerfile.cyml");
    if (gdf != 0) { registry_add(gdf); }
    var gmk = grammar_load("grammars/makefile.cyml");
    if (gmk != 0) { registry_add(gmk); }
    var gini = grammar_load("grammars/ini.cyml");
    if (gini != 0) { registry_add(gini); }
    var gcyml = grammar_load("grammars/cyml.cyml");
    if (gcyml != 0) { registry_add(gcyml); }
    var gll = grammar_load("grammars/llvm_ir.cyml");
    if (gll != 0) { registry_add(gll); }
    var gps = grammar_load("grammars/powershell.cyml");
    if (gps != 0) { registry_add(gps); }
    var gcr = grammar_load("grammars/crystal.cyml");
    if (gcr != 0) { registry_add(gcr); }
    var gjul = grammar_load("grammars/julia.cyml");
    if (gjul != 0) { registry_add(gjul); }
    return 0;
}

fn has_grammar(lang) {
    bootstrap_grammars();
    if (registry_find_by_name(lang) == 0) { return 0; }
    return 1;
}

# ── Stream primitive (push-based) ──────────────

# Allocate a fresh stream tied to the named grammar. Returns 0
# if the grammar is unknown (caller should check has_grammar
# first if it cares to distinguish).
fn tokenize_stream_new(lang) {
    bootstrap_grammars();
    var g = registry_find_by_name(lang);
    if (g == 0) { return 0; }
    var s = alloc(STREAM_REC_SIZE);
    var buf = alloc(VYK_STREAM_INIT_CAP);
    store64(s,      buf);
    store64(s + 8,  0);
    store64(s + 16, VYK_STREAM_INIT_CAP);
    store64(s + 24, g);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, tokenbuf_new());   # staging_tb (pull adapter)
    store64(s + 64, 0);                # next_idx
    store64(s + 72, (0 - 1));          # pending_idx — none (2.0.3)
    store64(s + 80, 0);                # scan_resume
    return s;
}

# Grow `s.buf` to at least `needed` bytes. Doubles capacity until
# either >= needed or VYK_STREAM_CAP. Returns 1 on success, 0 if
# the cap would be exceeded.
fn _stream_grow(s, needed) {
    var cap = load64(s + 16);
    if (cap >= needed) { return 1; }
    # Defensive: a zero cap would loop forever in the doubling
    # below (0 * 2 = 0). Should only happen if a freed stream
    # is reused — `_free` zeroes every field. Treat as an
    # error path rather than infinite-looping. Per FINDING-008,
    # 2.0.4 audit.
    if (cap <= 0) { return 0; }
    var new_cap = cap;
    while (new_cap < needed) { new_cap = new_cap * 2; }
    if (new_cap > VYK_STREAM_CAP) { new_cap = VYK_STREAM_CAP; }
    if (new_cap < needed) { return 0; }
    var old_buf = load64(s);
    var new_buf = alloc(new_cap);
    var len = load64(s + 8);
    var i = 0;
    while (i < len) {
        store8(new_buf + i, load8(old_buf + i));
        i = i + 1;
    }
    store64(s,      new_buf);
    store64(s + 16, new_cap);
    return 1;
}

# Feed `n` bytes from `chunk` into the stream's internal buffer.
# Returns VYK_OK on success, VYK_ERR_FINISHED if finish() already
# ran, VYK_ERR_OVERFLOW if the buffer cap would be exceeded.
fn tokenize_stream_feed(s, chunk, n) {
    if (s == 0) { return VYK_ERR_OVERFLOW; }
    if (load64(s + 32) == 1) { return VYK_ERR_FINISHED; }
    if (n <= 0) { return VYK_OK; }
    var len = load64(s + 8);
    var needed = len + n + 1;   # +1 for trailing NUL
    if (_stream_grow(s, needed) == 0) { return VYK_ERR_OVERFLOW; }
    var buf = load64(s);
    var i = 0;
    while (i < n) {
        store8(buf + len + i, load8(chunk + i));
        i = i + 1;
    }
    store64(s + 8, len + n);
    return VYK_OK;
}

# Returns 1 if the token at index `idx` of `temp_tb` (with src
# bytes in `buf`) is definitively complete — i.e., its trailing
# bytes are at a hard boundary (closing pair-rule marker, line
# break, single-byte fallthrough) and so the token wouldn't
# extend if more bytes arrived. Used by drain to decide whether
# to commit the trailing token even though its end == buf_len.
fn _stream_is_trailing_complete(g, buf, temp_tb, idx) {
    var kind    = tokenbuf_kind(temp_tb, idx);
    var t_start = tokenbuf_start(temp_tb, idx);
    var t_len   = tokenbuf_len(temp_tb, idx);
    # Only pair-rule kinds get the trailing-complete pass.
    # Everything else — operators / punctuation (longest-match
    # tables), idents / keywords / numbers (extending bytes
    # could change the token), whitespace (more whitespace
    # could follow) — must wait. The cost of being wrong on
    # an extending case is mis-tokenization at chunk boundaries,
    # so we err on the side of conservatism: only the pair-rule
    # case (close marker is at the tail; no further bytes can
    # change this token's extent) is safe to commit early.
    if ((kind == TK_STRING) || (kind == TK_COMMENT) || (kind == TK_PREPROCESSOR)) {
        var rules = grammar_pair_rules(g);
        var n = vec_len(rules);
        var i = 0;
        while (i < n) {
            var r = vec_get(rules, i);
            if (pair_rule_kind(r) == kind) {
                var endp = pair_rule_end(r);
                var elen = strlen(endp);
                if ((elen > 0) && (elen <= t_len)) {
                    if (memeq(buf + t_start + t_len - elen, endp, elen) == 1) {
                        return 1;
                    }
                }
            }
            i = i + 1;
        }
        # Line-rule kinds (line comments, shebang preprocessor):
        # the LF is the unambiguous terminator. If the trailing
        # token ends in LF, more bytes can't extend it.
        if ((t_len > 0) && (load8(buf + t_start + t_len - 1) == 10)) {
            return 1;
        }
    }
    return 0;
}

# Find which pair rule emitted a token at `[start, start+len)`
# in `buf`. Used to detect what to look for when the trailing
# token is a partial pair-rule open. Returns rule index, or -1
# if no pair rule's start marker matches the leading bytes.
fn _stream_find_pair_rule(g, buf, start, len, kind) {
    var rules = grammar_pair_rules(g);
    var n = vec_len(rules);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (pair_rule_kind(r) == kind) {
            var startm = pair_rule_start(r);
            var slen = strlen(startm);
            if ((slen > 0) && (slen <= len)) {
                if (memeq(buf + start, startm, slen) == 1) { return i; }
            }
        }
        i = i + 1;
    }
    return (0 - 1);
}

# Look for `endp` in `buf[from..buf_len]`. Honours the pair
# rule's escape byte. Returns close-position offset or -1.
fn _stream_scan_close(buf, buf_len, from, endp, elen, escape) {
    # Defensive: `elen <= 0` (empty / null close marker) would
    # cause the memeq check to vacuously succeed at `from`,
    # producing a zero-length token. Pair-rule grammars
    # shouldn't emit empty markers but the loader doesn't
    # currently enforce it. Per FINDING-009, 2.0.4 audit.
    if (elen <= 0) { return (0 - 1); }
    var j = from;
    while (j + elen <= buf_len) {
        if ((escape != 0) && (load8(buf + j) == escape)) {
            j = j + 2;
            continue;
        }
        if (memeq(buf + j, endp, elen) == 1) { return j; }
        j = j + 1;
    }
    return (0 - 1);
}

# Drain tokens whose spans are fully present in the buffer.
# Re-scans the current buffer with `tokenize_with_grammar`,
# commits all tokens whose end < buf_len (in feed mode) or every
# token (in finish mode), then compacts the buffer by sliding
# unconsumed bytes to offset 0. Returns the count appended to
# `out_tb` by this call.
#
# Why rescan-and-commit? It reuses the existing scanner without
# requiring a state-machine refactor, at the cost of O(buf_len)
# per drain. The trailing partial token (string with no close,
# block comment without `*/`, etc.) is always dropped in feed
# mode — its bytes stay in the buffer, gets re-scanned next
# drain after more bytes arrive. finish() lifts this constraint
# and commits everything including the tail.
fn tokenize_stream_drain(s, out_tb) {
    if (s == 0) { return 0; }
    # 2.0.2: caller passes 0 to mean "use the internal staging
    # tokenbuf". Lets the pull-adapter use site
    # (`tokenize_stream_finish(s, 0)` followed by `_next`) work
    # without the caller having to fish the staging out.
    if (out_tb == 0) { out_tb = load64(s + 56); }
    var buf = load64(s);
    var buf_len = load64(s + 8);
    var g = load64(s + 24);
    var finishing = load64(s + 32);
    var abs_offset = load64(s + 48);
    var pending_idx = load64(s + 72);
    if (buf_len == 0) { return 0; }

    var emitted = 0;

    # 2.0.3 fast path — pending pair rule from a previous drain.
    # The buffer's first bytes are the open marker; the body has
    # been growing across feeds. Skip the full scanner and look
    # only for the close marker, advancing scan_resume so we
    # never re-scan body bytes already known not to contain it.
    # Drops the pathological "open span across many chunks" case
    # from O(N²) to O(N).
    if (pending_idx >= 0) {
        var rule = vec_get(grammar_pair_rules(g), pending_idx);
        var endp = pair_rule_end(rule);
        var elen = strlen(endp);
        var escape = pair_rule_escape(rule);
        var startm = pair_rule_start(rule);
        var slen = strlen(startm);
        var resume = load64(s + 80);
        if (resume < slen) { resume = slen; }
        var close_pos = _stream_scan_close(buf, buf_len, resume, endp, elen, escape);
        if (close_pos >= 0) {
            var pair_total = close_pos + elen;
            tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, pair_total);
            emitted = emitted + 1;
            store64(s + 72, (0 - 1));
            store64(s + 80, 0);
            var k0 = pair_total;
            var dst0 = 0;
            while (k0 < buf_len) {
                store8(buf + dst0, load8(buf + k0));
                dst0 = dst0 + 1;
                k0 = k0 + 1;
            }
            buf_len = buf_len - pair_total;
            abs_offset = abs_offset + pair_total;
            store64(s + 8, buf_len);
            store64(s + 48, abs_offset);
            if (buf_len == 0) { return emitted; }
        }
        if (close_pos < 0) {
            # Still pending. Cache new scan-resume — backing off
            # `elen - 1` so a close marker straddling this
            # buffer's tail and the next feed isn't missed.
            var new_resume = buf_len;
            if (elen > 0) {
                if (new_resume > elen - 1) { new_resume = new_resume - (elen - 1); }
            }
            if (new_resume < slen) { new_resume = slen; }
            store64(s + 80, new_resume);
            if (finishing == 1) {
                tokenbuf_push(out_tb, pair_rule_kind(rule), abs_offset, buf_len);
                store64(s + 72, (0 - 1));
                store64(s + 80, 0);
                store64(s + 8, 0);
                store64(s + 48, abs_offset + buf_len);
                return emitted + 1;
            }
            return emitted;
        }
    }

    # NUL-terminate the live buffer so the inner scanner's
    # strlen-shaped checks see the correct end.
    store8(buf + buf_len, 0);
    var temp_tb = tokenbuf_new();
    tokenize_with_grammar(g, buf, buf_len, temp_tb);
    var n_temp = tokenbuf_count(temp_tb);
    var commit_count = n_temp;
    if (finishing == 0) {
        commit_count = 0;
        var i = 0;
        while (i < n_temp) {
            var t_start = tokenbuf_start(temp_tb, i);
            var t_len   = tokenbuf_len(temp_tb, i);
            if (t_start + t_len < buf_len) { commit_count = i + 1; }
            i = i + 1;
        }
        if ((commit_count < n_temp) && (n_temp > 0)) {
            if (_stream_is_trailing_complete(g, buf, temp_tb, n_temp - 1) == 1) {
                commit_count = n_temp;
            }
        }
    }
    var j = 0;
    while (j < commit_count) {
        tokenbuf_push(out_tb,
        tokenbuf_kind(temp_tb, j),
        abs_offset + tokenbuf_start(temp_tb, j),
        tokenbuf_len(temp_tb, j));
        emitted = emitted + 1;
        j = j + 1;
    }
    # 2.0.3 — detect pending pair-rule state for the NEXT drain.
    # If a trailing partial pair-rule open is uncommitted, save
    # its rule index + how far we've already scanned the body.
    var new_pending = (0 - 1);
    var new_resume2 = 0;
    if ((finishing == 0) && (commit_count < n_temp) && (n_temp > 0)) {
        var partial = commit_count;
        var p_kind  = tokenbuf_kind(temp_tb, partial);
        var p_start = tokenbuf_start(temp_tb, partial);
        var p_len   = tokenbuf_len(temp_tb, partial);
        if ((p_kind == TK_STRING) || (p_kind == TK_COMMENT) || (p_kind == TK_PREPROCESSOR)) {
            var rule_idx = _stream_find_pair_rule(g, buf, p_start, p_len, p_kind);
            if (rule_idx >= 0) {
                new_pending = rule_idx;
                var rule_r = vec_get(grammar_pair_rules(g), rule_idx);
                var endp_r = pair_rule_end(rule_r);
                var elen_r = strlen(endp_r);
                var slen_r = strlen(pair_rule_start(rule_r));
                new_resume2 = p_len;
                if (elen_r > 0) {
                    if (new_resume2 > elen_r - 1) { new_resume2 = new_resume2 - (elen_r - 1); }
                }
                if (new_resume2 < slen_r) { new_resume2 = slen_r; }
            }
        }
    }
    store64(s + 72, new_pending);
    store64(s + 80, new_resume2);
    var consumed = 0;
    if (commit_count > 0) {
        var last = commit_count - 1;
        consumed = tokenbuf_start(temp_tb, last) + tokenbuf_len(temp_tb, last);
    }
    if (consumed > 0) {
        var k = consumed;
        var dst = 0;
        while (k < buf_len) {
            store8(buf + dst, load8(buf + k));
            dst = dst + 1;
            k = k + 1;
        }
        store64(s + 8,  buf_len - consumed);
        store64(s + 48, abs_offset + consumed);
    }
    return emitted;
}

# Mark the stream as finished and emit every remaining token
# into `out_tb`. After finish, feed returns VYK_ERR_FINISHED;
# drain becomes a no-op (cursor == buf_len after the final
# compaction).
fn tokenize_stream_finish(s, out_tb) {
    if (s == 0) { return 0; }
    if (load64(s + 32) == 1) { return 0; }
    store64(s + 32, 1);
    return tokenize_stream_drain(s, out_tb);
}

# ── Pull adapter (2.0.2+) ────────────────────
# Iterator-style wrapper over the push primitive. Each call to
# tokenize_stream_next(s) advances the internal cursor by one
# token, refilling the staging tokenbuf via `_drain` if
# exhausted. Read the just-advanced-to token with the trio of
# stream-level accessors.
#
# Typical use:
#
#     var s = tokenize_stream_new("rust");
#     # push bytes (one or more times)
#     tokenize_stream_feed(s, src, n);
#     tokenize_stream_finish(s, 0);   # drain happens internally
#     while (tokenize_stream_next(s) == 1) {
#         var k = tokenize_stream_kind(s);
#         var p = tokenize_stream_start(s);
#         var l = tokenize_stream_len(s);
#         # ... use the token ...
#     }
#     tokenize_stream_free(s);
#
# The `0` arg to `_finish` (and `_drain`) signals "no
# caller-supplied tokenbuf; drain to the staging tokenbuf".
# For interleaved feed + iterate flows, the caller can call
# `_next` between feeds without ever calling `_finish` until
# they're done with input.

# Advance to the next token. If the staging tokenbuf is
# exhausted, drains into it from the underlying push primitive.
# Returns 1 if a token is now current (use _kind / _start /
# _len to read it); returns 0 if no token is available right
# now — caller should feed more bytes (then retry) or call
# `_finish` and retry to consume any final tokens.
fn tokenize_stream_next(s) {
    if (s == 0) { return 0; }
    var staging = load64(s + 56);
    var idx = load64(s + 64);
    if (idx >= tokenbuf_count(staging)) {
        # Try to refill via drain. If finish has run, drain is a
        # no-op; the caller has reached EOF.
        tokenize_stream_drain(s, staging);
        if (idx >= tokenbuf_count(staging)) { return 0; }
    }
    store64(s + 64, idx + 1);
    return 1;
}

# Read the kind of the *current* token (the one most recently
# returned by `_next == 1`). Behaviour is undefined if called
# before the first successful `_next`.
fn tokenize_stream_kind(s) {
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_kind(staging, idx);
}

fn tokenize_stream_start(s) {
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_start(staging, idx);
}

fn tokenize_stream_len(s) {
    var staging = load64(s + 56);
    var idx = load64(s + 64) - 1;
    return tokenbuf_len(staging, idx);
}

# ── Internal: M1 hand-coded shell path ────────
# Retained as a regression oracle for `vyk --handcoded` and
# smoke.sh's byte-identical diff check. NOT part of the public
# 2.0+ API surface — diagnostics only.

fn tokenize_source_handcoded(src, lang) {
    if (streq(lang, "shell") == 1) {
        var tb = tokenbuf_new();
        tokenize_shell(src, strlen(src), tb);
        return tb;
    }
    return 0;
}

# Release the stream's internal buffer. The caller-owned tokenbuf
# (passed to drain/finish) is NOT freed — it's the caller's
# responsibility. Stream handle is invalid after free.
fn tokenize_stream_free(s) {
    if (s == 0) { return 0; }
    # No-op for the buffer alloc — Cyrius's bump allocator doesn't
    # free individual allocations. Future allocator backends can
    # free the buf here.
    store64(s,      0);
    store64(s + 8,  0);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);   # staging_tb (2.0.2)
    store64(s + 64, 0);   # next_idx
    store64(s + 72, 0);   # pending_idx (2.0.3)
    store64(s + 80, 0);   # scan_resume
    return 0;
}
